rid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n  }\n\n  .cw-card {\n    border: 0.5px solid var(--border);\n    border-radius: 10px;\n    overflow: hidden;\n    cursor: pointer;\n    transition: border-color 0.2s, transform 0.2s;\n    text-decoration: none;\n    color: inherit;\n    display: block;\n  }\n\n  .cw-card:hover {\n    border-color: #bbb;\n    transform: translateY(-2px);\n  }\n\n  .cw-card-img {\n    background: var(--light-bg);\n    padding: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 180px;\n    overflow: hidden;\n  }\n\n  .cw-card-img img {\n    max-height: 100%;\n    object-fit: contain;\n    transition: transform 0.4s ease;\n  }\n\n  .cw-card:hover .cw-card-img img { transform: scale(1.05); }\n\n  .cw-card-info {\n    padding: 14px 16px;\n    border-top: 0.5px solid var(--border);\n  }\n\n  .cw-card-name { font-size: 12px; color: #666; margin-bottom: 3px; }\n\n  .cw-card-price {\n    font-family: var(--display);\n    font-weight: 700;\n    font-size: 16px;\n    color: var(--black);\n  }\n\n  /* ── TRUST BAR ── */\n  .trust-bar {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    border-top: 0.5px solid var(--border);\n  }\n\n  .trust-item {\n    padding: 16px 20px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    border-right: 0.5px solid var(--border);\n    font-size: 12px;\n    color: #555;\n    line-height: 1.4;\n  }\n\n  .trust-item:last-child { border-right: none; }\n\n  .trust-icon {\n    flex-shrink: 0;\n    width: 18px;\n    height: 18px;\n    color: var(--accent);\n  }\n\n  /* ── CTA BAND ── */\n  .cta-band {\n    background: var(--black);\n    padding: 48px;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: center;\n    gap: 32px;\n  }\n\n  .cta-eyebrow {\n    font-size: 10px;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 10px;\n  }\n\n  .cta-title 