opy { padding: 28px 24px; }\n    .specs-strip { grid-template-columns: repeat(2, 1fr); }\n    .specs-strip .spec-item:nth-child(2) { border-right: none; }\n    .specs-strip .spec-item:nth-child(3) { border-top: 0.5px solid var(--border); }\n    .colorway-section { padding: 32px 24px; }\n    .colorway-grid { grid-template-columns: 1fr 1fr; }\n    .colorway-grid .cw-card:last-child { grid-column: 1 / -1; }\n    .trust-bar { grid-template-columns: 1fr 1fr; }\n    .trust-item:nth-child(2) { border-right: none; }\n    .trust-item:nth-child(3) { border-top: 0.5px solid var(--border); }\n    .trust-item:nth-child(4) { border-top: 0.5px solid var(--border); border-right: none; }\n    .cta-band { grid-template-columns: 1fr; padding: 36px 24px; }\n    .cta-btns { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }\n    .cta-title { font-size: 28px; }\n  }\n</style>\n</head>\n<body>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"hero-copy\">\n    <div class=\"hero-eyebrow\">New launch &mdash; Badminton shoes</div>\n    <h1 class=\"hero-title\">RAZE<br><em>PRO II</em></h1>\n    <p class=\"hero-desc\">X-Cushion sole. HexaFoam Pro midsole. Extended heel lock. Built for intermediate players who push hard every session.</p>\n    <div class=\"hero-price\">\n      <span class=\"price-main\">&#8377;2,190</span>\n      <span class=\"price-mrp\">&#8377;2,790</span>\n      <span class=\"price-off\">21% off</span>\n    </div>\n    <div class=\"hero-cta\">\n      <a href=\"https://in.hndrd.co/products/raze-pro-ii\" target=\"_blank\"><button class=\"btn-primary\">Shop now</button></a>\n      <a href=\"https://in.hndrd.co/products/raze-pro-ii\" target=\"_blank\"><button class=\"btn-ghost\">3 colors available</button></a>\n    </div>\n  </div>\n  <div class=\"hero-img\">\n    <img id=\"hero-shoe\" src=\"https://in.hndrd.co/cdn/shop/files/Artboard1_8e94bbf0-4afc-4185-9113-8d2fe0a7e940.png?v=1780399330&width=650\" alt=\"Raze Pro II - White/Red\" />\n  </div>\n</section>