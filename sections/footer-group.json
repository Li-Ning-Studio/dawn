      "settings": {
        "custom_liquid": "<style>\n/* All rules scoped to .rp2-lp - safe to paste as Custom Liquid in Shopify */\n\n.rp2-lp, .rp2-lp *, .rp2-lp *::before, .rp2-lp *::after {\n  box-sizing: border-box;\n}\n\n.rp2-lp {\n  --rp2-accent:    #ffaa00;\n  --rp2-accent-h:  #e69900;\n  --rp2-black:     #0a0a0a;\n  --rp2-white:     #ffffff;\n  --rp2-off-white: #f7f6f2;\n  --rp2-light-bg:  #f0efe9;\n  --rp2-border:    #e5e4df;\n  --rp2-muted:     #888888;\n  --rp2-font:      'Figtree', sans-serif;\n  font-family: var(--rp2-font);\n  color: var(--rp2-black);\n  overflow-x: hidden;\n}\n\n.rp2-lp img { display: block; max-width: 100%; }\n.rp2-lp a  { text-decoration: none; color: inherit; }\n\n/* HERO */\n.rp2-hero {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  min-height: 480px;\n  background: var(--rp2-off-white);\n  overflow: hidden;\n}\n.rp2-hero-copy {\n  padding: 60px 48px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 14px;\n}\n.rp2-eyebrow {\n  font-size: 10px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--rp2-accent);\n  font-weight: 600;\n}\n.rp2-title {\n  font-family: var(--rp2-font);\n  font-weight: 900;\n  font-size: 64px;\n  line-height: 0.92;\n  color: var(--rp2-black);\n  text-transform: uppercase;\n  letter-spacing: -0.03em;\n  margin: 0;\n  animation: rp2FadeUp 0.7s ease both;\n}\n.rp2-title em { font-style: italic; color: var(--rp2-accent); }\n.rp2-desc {\n  font-size: 14px;\n  color: #555;\n  line-height: 1.65;\n  max-width: 300px;\n  margin: 0;\n  animation: rp2FadeUp 0.7s 0.1s ease both;\n}\n.rp2-price {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  margin-top: 4px;\n  animation: rp2FadeUp 0.7s 0.2s ease both;\n}\n.rp2-price-main { font-family: var(--rp2-font); font-weight: 700; font-size: 32px; color: var(--rp2-black); }\n.rp2-price-mrp  { font-size: 14px; color: #aaa; text-decoration: line-through; }\n.rp2-price-off  { font-size: 11px; background: #dcfce7; color: #15803d; padding: 3px 9px; border-radius: 20px; font-weight: 600; }\n.rp2-cta {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  margin-top: 10px;\n  animation: rp2FadeUp 0.7s 0.3s ease both;\n}\n.rp2-btn-primary {\n  background: var(--rp2-accent);\n  color: var(--rp2-black);\n  border: none;\n  height: 50px;\n  padding: 0 32px;\n  border-radius: 6px;\n  font-family: var(--rp2-font);\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: background 0.2s;\n  display: inline-flex;\n  align-items: center;\n}\n.rp2-btn-primary:hover { background: var(--rp2-accent-h); }\n.rp2-btn-ghost {\n  height: 50px;\n  padding: 0 24px;\n  border-radius: 6px;\n  border: 1.5px solid var(--rp2-black);\n  background: transparent;\n  color: var(--rp2-black);\n  font-family: var(--rp2-font);\n  font-size: 13px;\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n  display: inline-flex;\n  align-items: center;\n}\n.rp2-btn-ghost:hover { background: var(--rp2-black); color: var(--rp2-white); }\n.rp2-hero-img {\n  background: var(--rp2-light-bg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 32px;\n  animation: rp2FadeIn 0.9s ease both;\n}\n.rp2-hero-img img {\n  width: 100%;\n  max-width: 380px;\n  object-fit: contain;\n  transition: transform 0.4s ease;\n}\n.rp2-hero-img img:hover { transform: scale(1.03); }\n\n/* HERO INLINE COLOR OPTS */\n.rp2-hero-color-opts {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n/* COLOR BAR */\n.rp2-color-bar {\n  padding: 18px 48px;\n  border-bottom: 0.5px solid var(--rp2-border);\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  background: var(--rp2-white);\n  flex-wrap: wrap;\n}\n.rp2-color-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--rp2-muted); }\n.rp2-color-opts  { display: flex; gap: 10px; }\n.rp2-color-opt   { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; }\n.rp2-color-dot   { width: 36px; height: 36px; border-radius: 50%; border: 2px solid transparent; overflow: hidden; transition: border-color 0.2s; }\n.rp2-color-dot img { width: 100%; height: 100%; object-fit: cover; }\n.rp2-color-opt:hover .rp2-color-dot,\n.rp2-color-opt.rp2-active .rp2-color-dot { border-color: var(--rp2-black); }\n.rp2-color-name { font-size: 10px; color: var(--rp2-muted); transition: color 0.2s; }\n.rp2-color-opt.rp2-active .rp2-color-name { color: var(--rp2-black); font-weight: 500; }\n.rp2-spec-pills  { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }\n.rp2-spec-pill   { font-size: 10px; padding: 4px 12px; border-radius: 20px; background: #f5f5f0; color: #555; border: 0.5px solid var(--rp2-border); font-weight: 500; }\n\n/* FEATURES */\n.rp2-features { display: flex; flex-direction: column; }\n.rp2-feat {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  min-height: 280px;\n  border-top: 0.5px solid var(--rp2-border);\n}\n.rp2-feat:nth-child(even) .rp2-feat-img  { order: 2; }\n.rp2-feat:nth-child(even) .rp2-feat-copy { order: 1; }\n.rp2-feat-img {\n  background: var(--rp2-light-bg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 28px;\n  overflow: hidden;\n}\n.rp2-feat-img img { width: 100%; max-width: 300px; object-fit: contain; transition: transform 0.5s ease; }\n.rp2-feat:hover .rp2-feat-img img { transform: scale(1.04); }\n.rp2-feat-copy { padding: 40px 48px; display: flex; flex-direction: column; justify-content: center; gap: 10px; }\n.rp2-feat-num  { font-family: var(--rp2-font); font-weight: 700; font-size: 11px; color: #ccc; letter-spacing: 0.08em; }\n.rp2-feat-tag  { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rp2-accent); font-weight: 600; }\n.rp2-feat-title {\n  font-family: var(--rp2-font);\n  font-weight: 800;\n  font-size: 26px;\n  color: var(--rp2-black);\n  line-height: 1.15;\n  letter-spacing: -0.02em;\n  margin: 0;\n}\n.rp2-feat-body { font-size: 14px; color: #666; line-height: 1.7; max-width: 300px; margin: 0; }\n\n/* SPECS */\n.rp2-specs {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  border-top: 0.5px solid var(--rp2-border);\n  border-bottom: 0.5px solid var(--rp2-border);\n}\n.rp2-spec-item { padding: 22px 24px; border-right: 0.5px solid var(--rp2-border); }\n.rp2-spec-item:last-child { border-right: none; }\n.rp2-spec-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: #bbb; margin-bottom: 5px; }\n.rp2-spec-val   { font-size: 14px; font-weight: 500; color: var(--rp2-black); }\n\n/* COLORWAYS */\n.rp2-colorways { padding: 48px; }\n.rp2-section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }\n.rp2-section-title {\n  font-family: var(--rp2-font);\n  font-weight: 800;\n  font-size: 20px;\n  color: var(--rp2-black);\n  text-transform: uppercase;\n  letter-spacing: -0.01em;\n  margin: 0;\n}\n.rp2-section-link { font-size: 12px; color: var(--rp2-accent); text-decoration: underline; cursor: pointer; }\n.rp2-cw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }\n.rp2-cw-card {\n  border: 0.5px solid var(--rp2-border);\n  border-radius: 10px;\n  overflow: hidden;\n  cursor: pointer;\n  transition: border-color 0.2s, transform 0.2s;\n  text-decoration: none;\n  color: inherit;\n  display: block;\n}\n.rp2-cw-card:hover { border-color: #bbb; transform: translateY(-2px); }\n.rp2-cw-img {\n  background: var(--rp2-light-bg);\n  padding: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 180px;\n  overflow: hidden;\n}\n.rp2-cw-img img { max-height: 100%; object-fit: contain; transition: transform 0.4s ease; }\n.rp2-cw-card:hover .rp2-cw-img img { transform: scale(1.05); }\n.rp2-cw-info  { padding: 14px 16px; border-top: 0.5px solid var(--rp2-border); }\n.rp2-cw-name  { font-size: 12px; color: #666; margin-bottom: 3px; }\n.rp2-cw-price { font-family: var(--rp2-font); font-weight: 700; font-size: 16px; color: var(--rp2-black); }\n\n/* TRUST BAR */\n.rp2-trust { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 0.5px solid var(--rp2-border); }\n.rp2-trust-item {\n  padding: 16px 20px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border-right: 0.5px solid var(--rp2-border);\n  font-size: 12px;\n  color: #555;\n  line-height: 1.4;\n}\n.rp2-trust-item:last-child { border-right: none; }\n.rp2-trust-icon { flex-shrink: 0; width: 18px; height: 18px; color: var(--rp2-accent); }\n\n/* CTA BAND */\n.rp2-cta-band {\n  background: var(--rp2-black);\n  padding: 48px;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  align-items: center;\n  gap: 32px;\n}\n.rp2-cta-eyebrow { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rp2-accent); margin-bottom: 10px; }\n.rp2-cta-title {\n  font-family: var(--rp2-font);\n  font-weight: 900;\n  font-size: 40px;\n  color: var(--rp2-white);\n  line-height: 0.95;\n  text-transform: uppercase;\n  letter-spacing: -0.03em;\n  margin: 0;\n}\n.rp2-cta-title em { font-style: italic; color: var(--rp2-accent); }\n.rp2-cta-sub { font-size: 13px; color: #666; margin-top: 10px; margin-bottom: 0; }\n.rp2-cta-btns { display: flex; flex-direction: column; gap: 10px; align-items: flex-end; }\n.rp2-btn-white {\n  background: var(--rp2-white);\n  color: var(--rp2-black);\n  border: none;\n  height: 50px;\n  padding: 0 32px;\n  border-radius: 6px;\n  font-family: var(--rp2-font);\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: background 0.2s;\n  display: inline-flex;\n  align-items: center;\n}\n.rp2-btn-white:hover { background: #f0f0f0; }\n.rp2-btn-ghost-white {\n  background: transparent;\n  color: var(--rp2-white);\n  border: 1px solid #333;\n  height: 50px;\n  padding: 0 24px;\n  border-radius: 6px;\n  font-size: 12px;\n  cursor: pointer;\n  white-space: nowrap;\n  font-family: var(--rp2-font);\n  transition: border-color 0.2s;\n  display: inline-flex;\n  align-items: center;\n}\n.rp2-btn-ghost-white:hover { border-color: #666; }\n\n/* ANIMATIONS */\n@keyframes rp2FadeUp {\n  from { opacity: 0; transform: translateY(20px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n@keyframes rp2FadeIn {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\n\n/* RESPONSIVE */\n@media (max-width: 768px) {\n  .rp2-hero { grid-template-columns: 1fr; }\n  .rp2-hero-copy { padding: 40px 24px 24px; }\n  .rp2-title { font-size: 48px; }\n  .rp2-hero-img { order: -1; min-height: 260px; }\n  .rp2-color-bar { padding: 14px 24px; }\n  .rp2-spec-pills { margin-left: 0; margin-top: 8px; }\n  .rp2-feat { grid-template-columns: 1fr; }\n  .rp2-feat:nth-child(even) .rp2-feat-img  { order: unset; }\n  .rp2-feat:nth-child(even) .rp2-feat-copy { order: unset; }\n  .rp2-feat-copy { padding: 28px 24px; }\n  .rp2-specs { grid-template-columns: repeat(2, 1fr); }\n  .rp2-specs .rp2-spec-item:nth-child(2) { border-right: none; }\n  .rp2-specs .rp2-spec-item:nth-child(3) { border-top: 0.5px solid var(--rp2-border); }\n  .rp2-colorways { padding: 32px 24px; }\n  .rp2-cw-grid { grid-template-columns: 1fr 1fr; }\n  .rp2-cw-grid .rp2-cw-card:last-child { grid-column: 1 / -1; }\n  .rp2-trust { grid-template-columns: 1fr 1fr; }\n  .rp2-trust-item:nth-child(2) { border-right: none; }\n  .rp2-trust-item:nth-child(3) { border-top: 0.5px solid var(--rp2-border); }\n  .rp2-trust-item:nth-child(4) { border-top: 0.5px solid var(--rp2-border); border-right: none; }\n  .rp2-cta-band { grid-template-columns: 1fr; padding: 36px 24px; }\n  .rp2-cta-btns { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }\n  .rp2-cta-title { font-size: 28px; }\n}\n</style>\n\n<div class=\"rp2-lp\">\n\n  <!-- HERO -->\n  <section class=\"rp2-hero\">\n    <div class=\"rp2-hero-copy\">\n      <div class=\"rp2-eyebrow\">New launch &mdash; Badminton shoes</div>\n      <div class=\"rp2-hero-color-opts\">\n        <div class=\"rp2-color-opt rp2-active\"\n             data-img=\"https://in.hndrd.co/cdn/shop/files/Artboard1_8e94bbf0-4afc-4185-9113-8d2fe0a7e940.png?v=1780399330&width=650\"\n             data-name=\"White / Red\"\n             onclick=\"rp2SelectColor(this)\">\n          <div class=\"rp2-color-dot\"><img src=\"https://in.hndrd.co/cdn/shop/files/Artboard1_8e94bbf0-4afc-4185-9113-8d2fe0a7e940.png?v=1780399330&width=100\" alt=\"White/Red\" /></div>\n          <span class=\"rp2-color-name\">White/Red</span>\n        </div>\n        <div class=\"rp2-color-opt\"\n             data-img=\"https://in.hndrd.co/cdn/shop/files/Artboard_1_41af61bf-ebe0-4ba4-9498-81ed3eed0e8a.png?v=1780399351&width=650\"\n             data-name=\"White / Turquoise / Red\"\n             onclick=\"rp2SelectColor(this)\">\n          <div class=\"rp2-color-dot\"><img src=\"https://in.hndrd.co/cdn/shop/files/Artboard_1_41af61bf-ebe0-4ba4-9498-81ed3eed0e8a.png?v=1780399351&width=100\" alt=\"White/Turquoise/Red\" /></div>\n          <span class=\"rp2-color-name\">White/Turq</span>\n        </div>\n        <div class=\"rp2-color-opt\"\n             data-img=\"https://in.hndrd.co/cdn/shop/files/Artboard_1_d98626cc-0c39-4801-908d-1b48fe047b1f.png?v=1780399359&width=650\"\n             data-name=\"White / Blue\"\n             onclick=\"rp2SelectColor(this)\">\n          <div class=\"rp2-color-dot\"><img src=\"https://in.hndrd.co/cdn/shop/files/Artboard_1_d98626cc-0c39-4801-908d-1b48fe047b1f.png?v=1780399359&width=100\" alt=\"White/Blue\" /></div>\n          <span class=\"rp2-color-name\">White/Blue</span>\n        </div>\n      </div>\n      <h1 class=\"rp2-title\">RAZE<br><em>PRO II</em></h1>\n      <p class=\"rp2-desc\">X-Cushion sole. HexaFoam Pro midsole. Extended heel lock. Built for players who push hard every session.</p>\n      <div class=\"rp2-price\">\n        <span class=\"rp2-price-main\">&#8377;2,190</span>\n        <span class=\"rp2-price-mrp\">&#8377;2,790</span>\n        <span class=\"rp2-price-off\">21% off</span>\n      </div>\n      <div class=\"rp2-cta\">\n        <a href=\"https://in.hndrd.co/products/raze-pro-ii\"><button class=\"rp2-btn-primary\">Shop now</button></a>\n        <a href=\"https://in.hndrd.co/products/raze-pro-ii\"><button class=\"rp2-btn-ghost\">3 colors available</button></a>\n      </div>\n    </div>\n    <div class=\"rp2-hero-img\">\n      <img id=\"rp2-hero-shoe\"\n           src=\"https://in.hndrd.co/cdn/shop/files/Artboard1_8e94bbf0-4afc-4185-9113-8d2fe0a7e940.png?v=1780399330&width=650\"\n           alt=\"Raze Pro II - White/Red\" />\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section class=\"rp2-features\">\n    <div class=\"rp2-feat\">\n      <div class=\"rp2-feat-img\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/Artboard2_4d617455-69a0-4f50-a618-b28fabb11aac.png?v=1780399331&width=650\" alt=\"Airflow Upper\" />\n      </div>\n      <div class=\"rp2-feat-copy\">\n        <h2 class=\"rp2-feat-title\">Airflow Upper</h2>\n        <p class=\"rp2-feat-body\">PU and mesh combined to circulate air through every rally. Keeps feet cool, dry, and locked in - without sacrificing flexibility mid-game.</p>\n      </div>\n    </div>\n    <div class=\"rp2-feat\">\n      <div class=\"rp2-feat-img\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/Artboard3_53a1c466-4256-43ea-8a51-31ace5cafe7b.png?v=1780399330&width=650\" alt=\"Extended Heel Lock\" />\n      </div>\n      <div class=\"rp2-feat-copy\">\n        <h2 class=\"rp2-feat-title\">Extended Heel Lock</h2>\n        <p class=\"rp2-feat-body\">Reinforced rearfoot structure keeps you stable on sharp cuts and lateral dives. Your heel stays planted when your body turns fast.</p>\n      </div>\n    </div>\n    <div class=\"rp2-feat\">\n      <div class=\"rp2-feat-img\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/Artboard4_b8a96387-0b66-4af8-b492-17a93efcbfd1.png?v=1780399331&width=650\" alt=\"HexaFoam Pro Midsole\" />\n      </div>\n      <div class=\"rp2-feat-copy\">\n        <h2 class=\"rp2-feat-title\">HexaFoam Pro Midsole</h2>\n        <p class=\"rp2-feat-body\">Dense foam geometry absorbs impact on every landing. Stays responsive across long training sessions - not just the first game of the day.</p>\n      </div>\n    </div>\n    <div class=\"rp2-feat\">\n      <div class=\"rp2-feat-img\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/Artboard5_e2d1a5d4-bb80-4004-b4a0-540182fec0fa.png?v=1780399330&width=650\" alt=\"X-Cushion Sole\" />\n      </div>\n      <div class=\"rp2-feat-copy\">\n        <h2 class=\"rp2-feat-title\">X-Cushion Sole</h2>\n        <p class=\"rp2-feat-body\">Multi-layered non-marking rubber with Active Grip patterning. Confident traction on every court surface - no slip on fast transitions.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- SPECS STRIP -->\n  <div class=\"rp2-specs\">\n    <div class=\"rp2-spec-item\"><div class=\"rp2-spec-label\">Weight</div><div class=\"rp2-spec-val\">330g</div></div>\n    <div class=\"rp2-spec-item\"><div class=\"rp2-spec-label\">Midsole</div><div class=\"rp2-spec-val\">HexaFoam Pro</div></div>\n    <div class=\"rp2-spec-item\"><div class=\"rp2-spec-label\">Outsole</div><div class=\"rp2-spec-val\">X-Cushion</div></div>\n    <div class=\"rp2-spec-item\"><div class=\"rp2-spec-label\">Player level</div><div class=\"rp2-spec-val\">Intermediate</div></div>\n  </div>\n\n  <!-- TRUST BAR -->\n  <div class=\"rp2-trust\">\n    <div class=\"rp2-trust-item\">\n      <svg class=\"rp2-trust-icon\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00