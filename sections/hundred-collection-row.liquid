{%- comment -%}
  HUNDRED – More from the collection
  Viser produkter fra samme kollektion som produktet på række, med pile.
  Hvert kort har flere kvadratiske billeder, man kan bladre i med små pile.
  Kollektion vælges automatisk (den mest specifikke kollektion produktet ligger i),
  eller fra metafeltet custom.related_collection, hvis det er udfyldt.
  Priser følger kundens katalog automatisk (B2B ser B2B-priser).
{%- endcomment -%}

{%- liquid
  assign current = product
  assign coll = blank

  assign mf = current.metafields.custom.related_collection.value
  if mf != blank
    assign coll = mf
  endif

  if coll == blank
    assign exclude = section.settings.exclude | downcase | split: ','
    assign best_count = 999999
    for c in current.collections
      assign skip = false
      for ex in exclude
        assign exs = ex | strip
        if exs != blank and c.handle == exs
          assign skip = true
        endif
      endfor
      if skip == false and c.all_products_count > 1 and c.all_products_count < best_count
        assign coll = c
        assign best_count = c.all_products_count
      endif
    endfor
  endif
-%}

{%- if coll != blank -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">

<style>
  .hcr{--ink:#0a0a0b;--soft:#5d584f;--muted:#8c867b;--line:#e7e3dc;--panel:#f5f3ef;--gold:#f2a81d;--ember:#e5701a;
    --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;--body:"Barlow","Helvetica Neue",Arial,sans-serif;
    background:#fff;color:var(--ink);font-family:var(--body);letter-spacing:0;padding-block:clamp(40px,6vw,80px)}
  .hcr *{box-sizing:border-box}
  .hcr-wrap{max-width:var(--page-width,1440px);margin-inline:auto;padding-inline:clamp(16px,4.4vw,64px)}
  .hcr-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:22px}
  .hcr .hcr-title{margin:0;font:italic 900 clamp(32px,3.4vw,46px)/1 var(--display);text-transform:uppercase;letter-spacing:-.005em;color:var(--ink)}
  .hcr-title em{font-style:inherit;color:var(--ember)}
  .hcr-nav{display:flex;gap:8px;flex:none}
  .hcr .hcr-arrow{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;padding:0;transition:border-color .2s,opacity .2s}
  .hcr .hcr-arrow:hover{border-color:var(--ink)}
  .hcr .hcr-arrow[disabled]{opacity:.35;cursor:default}
  .hcr-arrow svg{width:18px;height:18px}

  .hcr-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 3 * 20px) / 4);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;
    scrollbar-width:none;margin:0;padding:0;list-style:none}
  .hcr-track::-webkit-scrollbar{display:none}
  .hcr-card{scroll-snap-align:start;min-width:0}
  .hcr-card a{color:inherit;text-decoration:none}

  .hcr-media{position:relative;aspect-ratio:1;border-radius:12px;background:var(--panel);overflow:hidden}
  .hcr-imgs{display:flex;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
  .hcr-imgs::-webkit-scrollbar{display:none}
  .hcr-imgs a{flex:0 0 100%;height:100%;scroll-snap-align:start;display:grid;place-items:center}
  .hcr-imgs img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;padding:8%}
  .hcr .hcr-mini{position:absolute;top:50%;translate:0 -50%;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.92);
    display:grid;place-items:center;cursor:pointer;padding:0;color:var(--ink);opacity:0;transition:opacity .2s}
  .hcr-mini svg{width:14px;height:14px}
  .hcr-mini--prev{left:10px}.hcr-mini--next{right:10px}
  .hcr-media:hover .hcr-mini,.hcr-mini:focus-visible{opacity:1}
  .hcr-dots{position:absolute;left:50%;bottom:12px;translate:-50% 0;display:flex;gap:5px}
  .hcr-dots i{width:6px;height:6px;border-radius:50%;background:#d6d1c8;transition:background .2s}
  .hcr-dots i.on{background:var(--ink)}
  .hcr-badge{position:absolute;left:12px;top:12px;z-index:1;background:var(--ink);color:#fff;font-size:10px;font-weight:700;letter-spacing:.16em;padding:6px 10px;border-radius:999px;text-transform:uppercase}

  .hcr-info{padding-top:12px;display:grid;gap:2px}
  .hcr-name{font-weight:700;font-size:16px;line-height:1.3}
  .hcr-type{font-size:13px;color:var(--muted)}
  .hcr-price{font-weight:600;font-size:15px;margin-top:2px;font-variant-numeric:tabular-nums}
  .hcr-price s{color:var(--muted);font-weight:500;margin-left:6px}
  .hcr .hcr-arrow:focus-visible,.hcr a:focus-visible{outline:2px solid var(--ink);outline-offset:3px}

  @media (max-width:989px){.hcr-track{grid-auto-columns:calc((100% - 2 * 16px) / 3);gap:16px}}
  @media (max-width:749px){
    .hcr-track{grid-auto-columns:72%;gap:12px}
    .hcr-mini{opacity:1}
    .hcr-nav{display:none}
  }
</style>

<div class="hcr" id="hcr-{{ section.id }}">
  <div class="hcr-wrap">
    <div class="hcr-head">
      <h2 class="hcr-title">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
      <div class="hcr-nav">
        <button type="button" class="hcr-arrow" data-dir="-1" aria-label="Previous products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="hcr-arrow" data-dir="1" aria-label="Next products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </div>

    <ul class="hcr-track" role="list">
      {%- assign shown = 0 -%}
      {%- for p in coll.products -%}
        {%- if p.id == current.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <li class="hcr-card">
          <div class="hcr-media">
            {%- if p.available == false -%}<span class="hcr-badge">Sold out</span>{%- endif -%}
            <div class="hcr-imgs">
              {%- for img in p.images limit: section.settings.images_per_card -%}
                <a href="{{ p.url }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
                  {{ img | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 72vw', loading: 'lazy', alt: p.title }}
                </a>
              {%- else -%}
                <a href="{{ p.url }}">{{ 'product-1' | placeholder_svg_tag }}</a>
              {%- endfor -%}
            </div>
            {%- if p.images.size > 1 -%}
              <button type="button" class="hcr-mini hcr-mini--prev" aria-label="Previous image of {{ p.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
              <button type="button" class="hcr-mini hcr-mini--next" aria-label="Next image of {{ p.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
              <div class="hcr-dots" aria-hidden="true">
                {%- for img in p.images limit: section.settings.images_per_card -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <a class="hcr-info" href="{{ p.url }}">
            <span class="hcr-name">{{ p.title | escape }}</span>
            {%- if p.type != blank -%}<span class="hcr-type">{{ p.type | escape }}</span>{%- endif -%}
            <span class="hcr-price">
              {%- if p.price_varies -%}From {% endif -%}{{ p.price | money }}
              {%- if p.compare_at_price > p.price and customer.b2b? != true -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('hcr-{{ section.id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var track = root.querySelector('.hcr-track');
  var arrows = root.querySelectorAll('.hcr-arrow');
  if (!track.children.length) { root.hidden = true; return; }

  function update(){
    var max = track.scrollWidth - track.clientWidth - 2;
    arrows[0].disabled = track.scrollLeft <= 2;
    arrows[1].disabled = track.scrollLeft >= max;
  }
  arrows.forEach(function(a){
    a.addEventListener('click', function(){
      var card = track.children[0];
      var step = card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 20) : track.clientWidth;
      track.scrollBy({ left: step * parseInt(a.dataset.dir, 10), behavior: 'smooth' });
    });
  });
  track.addEventListener('scroll', function(){ window.requestAnimationFrame(update); }, { passive: true });
  window.addEventListener('resize', update);
  update();

  // Billeder i hvert kort
  root.querySelectorAll('.hcr-media').forEach(function(m){
    var imgs = m.querySelector('.hcr-imgs');
    var dots = m.querySelectorAll('.hcr-dots i');
    var links = imgs.querySelectorAll('a');
    function idx(){ return Math.round(imgs.scrollLeft / imgs.clientWidth); }
    function go(n){ n = Math.max(0, Math.min(links.length - 1, n)); imgs.scrollTo({ left: n * imgs.clientWidth, behavior: 'smooth' }); }
    var prev = m.querySelector('.hcr-mini--prev'), next = m.querySelector('.hcr-mini--next');
    if (prev) prev.addEventListener('click', function(){ var i = idx(); go(i === 0 ? links.length - 1 : i - 1); });
    if (next) next.addEventListener('click', function(){ var i = idx(); go(i === links.length - 1 ? 0 : i + 1); });
    imgs.addEventListener('scroll', function(){
      var i = idx();
      dots.forEach(function(d, k){ d.classList.toggle('on', k === i); });
    }, { passive: true });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "HUNDRED Fra kollektionen",
  "tag": "section",
  "class": "section-hundred-collection-row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift (sort)", "default": "More from" },
    { "type": "text", "id": "heading_accent", "label": "Overskrift (orange)", "default": "the collection" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 4, "max": 16, "step": 1, "default": 12 },
    { "type": "range", "id": "images_per_card", "label": "Billeder pr. kort", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "text", "id": "exclude", "label": "Brug aldrig disse kollektioner (handles, adskil med komma)", "default": "all, frontpage, new, new-arrivals, sale, bestsellers",
      "info": "Sektionen vælger selv den mest specifikke kollektion, produktet ligger i. Vil du styre det på et produkt, så udfyld metafeltet custom.related_collection." }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "HUNDRED Fra kollektionen" }]
}
{% endschema %}
