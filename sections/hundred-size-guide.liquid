{%- comment -%}
  HUNDRED – Size guide
  3 faner (sko, t-shirts, nederdele) med størrelsesberegner, måletegning og tabel.
  Tabellerne redigeres i Tilpas (én linje pr. række: Navn|værdi,værdi,...).
  Link direkte til en fane: /pages/size-guide#shoes, #tshirts eller #skirts
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700;800&display=swap">

<style>
  .hsg{--bg:#0a0a0b;--panel:#131315;--panel2:#1a1917;--line:#2a2722;--text:#f3efe7;--soft:#cfc9be;--muted:#8c867b;--gold:#f2a81d;--ember:#e5701a;--ok:#7bc47f;
    --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;--body:"Barlow","Helvetica Neue",Arial,sans-serif;
    background:var(--bg);color:var(--text);font:16px/1.5 var(--body);letter-spacing:0;padding-block:clamp(40px,6vw,72px)}
  .hsg *{box-sizing:border-box}
  .hsg-wrap{max-width:1240px;margin-inline:auto;padding-inline:clamp(16px,3vw,32px)}
  .hsg-over{margin:0;font-size:12px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}
  .hsg .hsg-title{margin:8px 0 12px;font:italic 900 clamp(48px,7vw,80px)/.9 var(--display);text-transform:uppercase;letter-spacing:-.005em;
    background:linear-gradient(180deg,#ffc94a,var(--gold) 45%,var(--ember));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:var(--gold)}
  .hsg-title em{font-style:inherit}
  .hsg-lead{margin:0;color:var(--soft);max-width:60ch}

  .hsg-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:28px 0 24px}
  .hsg .hsg-tab{padding:12px 22px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--text);cursor:pointer;
    font:700 14px/1 var(--body);letter-spacing:.12em;text-transform:uppercase;transition:background .2s,color .2s,border-color .2s}
  .hsg .hsg-tab:hover{border-color:var(--gold)}
  .hsg .hsg-tab[aria-selected="true"]{background:var(--gold);color:#000;border-color:var(--gold)}

  .hsg-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:24px;align-items:start}
  .hsg-panel[hidden]{display:none}

  /* Beregner */
  .hsg-calc{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:clamp(20px,3vw,28px);display:grid;gap:18px}
  .hsg .hsg-h{margin:0;font:italic 900 34px/1 var(--display);text-transform:uppercase;color:var(--text)}
  .hsg-h em{font-style:inherit;color:var(--gold)}
  .hsg-intro{margin:0;color:var(--soft);font-size:14px}
  .hsg-lbl{display:block;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
  .hsg-chips{display:flex;flex-wrap:wrap;gap:8px}
  .hsg .hsg-chip{padding:9px 14px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--text);cursor:pointer;font:600 13px/1.2 var(--body)}
  .hsg .hsg-chip[aria-pressed="true"]{background:var(--gold);color:#000;border-color:var(--gold)}
  .hsg-fields{display:grid;gap:10px}
  .hsg-f{display:grid;grid-template-columns:28px minmax(0,1fr) 116px;align-items:center;gap:12px}
  .hsg-n{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--ember);color:#fff;font:800 13px/1 var(--body);flex:none}
  .hsg-f label{font-weight:600;font-size:15px;line-height:1.3;color:var(--text)}
  .hsg-f label small{display:block;color:var(--muted);font-weight:500;font-size:12px}
  .hsg-in{position:relative}
  .hsg .hsg-in input{width:100%;height:48px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--text);padding:0 40px 0 14px;margin:0;
    font:700 18px/1 var(--body);font-variant-numeric:tabular-nums;-moz-appearance:textfield;appearance:textfield;box-shadow:none}
  .hsg .hsg-in input::-webkit-outer-spin-button,.hsg .hsg-in input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .hsg .hsg-in input:focus{outline:none;border-color:var(--gold)}
  .hsg .hsg-in input::placeholder{color:#4a463f}
  .hsg-in span{position:absolute;right:14px;top:50%;translate:0 -50%;color:var(--muted);font-size:14px;font-weight:600;pointer-events:none}

  .hsg-res{background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:18px;display:grid;gap:6px}
  .hsg-big{font:italic 900 56px/.9 var(--display);color:var(--gold);text-transform:uppercase}
  .hsg-big.is-empty{color:#3a3732}
  .hsg-fit{display:grid}
  .hsg-fit div{display:flex;justify-content:space-between;gap:12px;font-size:14px;color:var(--soft);border-top:1px solid var(--line);padding:7px 0}
  .hsg-fit b{color:var(--text);font-weight:700}.hsg-fit b.ok{color:var(--ok)}.hsg-fit b.up{color:var(--gold)}
  .hsg-sum{margin:4px 0 0;color:var(--text);font-weight:600;font-size:14px}
  .hsg-note{margin:0;color:var(--soft);font-size:14px}

  /* Tegning + tabel */
  .hsg-card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:clamp(18px,3vw,24px);display:grid;gap:16px;min-width:0}
  .hsg .hsg-card h3{margin:0;font:700 18px/1.3 var(--body);color:var(--text);letter-spacing:0}
  .hsg-dia{background:var(--panel2);border-radius:14px;padding:18px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;align-items:center}
  .hsg-dia.one{grid-template-columns:1fr}
  .hsg-dia svg{width:100%;max-height:300px;height:auto;display:block;margin:0 auto}
  .hsg-steps{margin:0;padding:0;list-style:none;display:grid;gap:10px;font-size:14px;color:var(--soft)}
  .hsg-steps b{color:var(--gold)}
  .hsg-cap{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-align:center;margin:0}

  .hsg-tw{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:10px}
  .hsg .hsg-tw table{border-collapse:collapse !important;border:0 !important;width:100%;table-layout:auto;font-variant-numeric:tabular-nums;margin:0;background:transparent}
  .hsg .hsg-tw th,.hsg .hsg-tw td{padding:12px 10px !important;text-align:center;border:0 !important;border-bottom:1px solid var(--line) !important;
    font-size:14px;line-height:1.2;white-space:nowrap;background:var(--panel);color:var(--soft);vertical-align:middle}
  .hsg .hsg-tw thead th{font-weight:800;color:var(--text);font-size:14px;letter-spacing:.04em}
  .hsg .hsg-tw tbody th,.hsg .hsg-tw thead th:first-child{text-align:left;color:var(--muted);font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    position:sticky;left:0;z-index:2;min-width:132px;padding-right:16px !important;box-shadow:1px 0 0 var(--line)}
  .hsg .hsg-tw tbody th .hsg-n{width:20px;height:20px;font-size:11px;margin-right:8px;vertical-align:middle}
  .hsg .hsg-tw .is-hit{background:#2a2110 !important;color:var(--gold) !important;font-weight:800;box-shadow:inset 1px 0 0 var(--gold),inset -1px 0 0 var(--gold)}
  .hsg .hsg-tw thead .is-hit{box-shadow:inset 1px 0 0 var(--gold),inset -1px 0 0 var(--gold),inset 0 2px 0 var(--gold)}
  .hsg .hsg-tw tbody tr:last-child .is-hit{box-shadow:inset 1px 0 0 var(--gold),inset -1px 0 0 var(--gold),inset 0 -2px 0 var(--gold)}
  .hsg .hsg-tab:focus-visible,.hsg .hsg-chip:focus-visible{outline:2px solid var(--gold);outline-offset:3px}

  @media (max-width:989px){.hsg-panel{grid-template-columns:1fr}}
  @media (max-width:560px){
    .hsg-f{grid-template-columns:28px minmax(0,1fr) 96px}
    .hsg-dia{grid-template-columns:1fr}
    .hsg-big{font-size:48px}
    .hsg .hsg-tw tbody th,.hsg .hsg-tw thead th:first-child{min-width:112px}
  }
</style>

{%- liquid
  assign s = section.settings
  assign cats = 'shoes,tshirts,skirts' | split: ','
-%}

<div class="hsg" id="hsg-{{ section.id }}" data-default="{{ s.default_tab }}">
  <div class="hsg-wrap">
    {%- if s.overline != blank -%}<p class="hsg-over">{{ s.overline | escape }}</p>{%- endif -%}
    <h1 class="hsg-title">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h1>
    {%- if s.lead != blank -%}<p class="hsg-lead">{{ s.lead | escape }}</p>{%- endif -%}

    <div class="hsg-tabs" role="tablist" aria-label="Size guide categories">
      {%- for c in cats -%}
        {%- capture lab -%}{%- case c -%}{%- when 'shoes' -%}{{ s.shoes_tab }}{%- when 'tshirts' -%}{{ s.tee_tab }}{%- else -%}{{ s.skirt_tab }}{%- endcase -%}{%- endcapture -%}
        <button type="button" class="hsg-tab" role="tab" id="hsg-tab-{{ c }}-{{ section.id }}" data-cat="{{ c }}"
          aria-controls="hsg-panel-{{ c }}-{{ section.id }}" aria-selected="false">{{ lab | escape }}</button>
      {%- endfor -%}
    </div>

    {%- for c in cats -%}
      {%- liquid
        case c
          when 'shoes'
            assign chart = s.shoes_chart
            assign hints = s.shoes_hints
            assign note = s.shoes_note
            assign intro = s.shoes_intro
            assign ctitle = s.shoes_chart_title
          when 'tshirts'
            assign chart = s.tee_chart
            assign hints = s.tee_hints
            assign note = s.tee_note
            assign intro = s.tee_intro
            assign ctitle = s.tee_chart_title
          else
            assign chart = s.skirt_chart
            assign hints = s.skirt_hints
            assign note = s.skirt_note
            assign intro = s.skirt_intro
            assign ctitle = s.skirt_chart_title
        endcase
        assign lines = chart | strip | newline_to_br | split: '<br />'
        assign hint_lines = hints | strip | newline_to_br | split: '<br />'
        assign head = lines.first | strip | split: '|'
        assign cols = head.last | split: ','
      -%}
      <div class="hsg-panel" role="tabpanel" id="hsg-panel-{{ c }}-{{ section.id }}" aria-labelledby="hsg-tab-{{ c }}-{{ section.id }}" data-cat="{{ c }}" hidden>
        <div class="hsg-calc">
          <h2 class="hsg-h">Size <em>finder</em></h2>
          {%- if intro != blank -%}<p class="hsg-intro">{{ intro | escape }}</p>{%- endif -%}

          {%- if c == 'shoes' -%}
            <div>
              <span class="hsg-lbl">Foot shape</span>
              <div class="hsg-chips" role="group" aria-label="Foot shape">
                <button type="button" class="hsg-chip" data-up="0" aria-pressed="true">Standard</button>
                <button type="button" class="hsg-chip" data-up="1" aria-pressed="false">Tapered big toe</button>
                <button type="button" class="hsg-chip" data-up="0" aria-pressed="false">Protruding long toe</button>
                <button type="button" class="hsg-chip" data-up="1" aria-pressed="false">Wide</button>
                <button type="button" class="hsg-chip" data-up="0" aria-pressed="false">Narrow</button>
                <button type="button" class="hsg-chip" data-up="0" aria-pressed="false">High instep</button>
              </div>
            </div>
            <div class="hsg-fields">
              <div class="hsg-f">
                <span class="hsg-n">1</span>
                <label for="hsg-in-{{ c }}-1-{{ section.id }}">Foot length<small>{{ hint_lines.first | strip | escape }}</small></label>
                <div class="hsg-in"><input type="number" inputmode="decimal" step="0.1" min="0" id="hsg-in-{{ c }}-1-{{ section.id }}" data-row="cm" placeholder="–"><span>cm</span></div>
              </div>
            </div>
          {%- else -%}
            <div class="hsg-fields">
              {%- for line in lines offset: 1 -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- assign hi = forloop.index0 -%}
                <div class="hsg-f">
                  <span class="hsg-n">{{ forloop.index }}</span>
                  <label for="hsg-in-{{ c }}-{{ forloop.index }}-{{ section.id }}">{{ parts.first | escape }}{%- if hint_lines[hi] != blank -%}<small>{{ hint_lines[hi] | strip | escape }}</small>{%- endif -%}</label>
                  <div class="hsg-in"><input type="number" inputmode="decimal" step="0.1" min="0" id="hsg-in-{{ c }}-{{ forloop.index }}-{{ section.id }}" data-row="{{ forloop.index }}" placeholder="–"><span>cm</span></div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="hsg-res" aria-live="polite">
            <span class="hsg-lbl" style="margin:0">Your size</span>
            <div class="hsg-big is-empty">–</div>
            <div class="hsg-fit"></div>
            <p class="hsg-sum" hidden></p>
            {%- if note != blank -%}<p class="hsg-note">{{ note | escape }}</p>{%- endif -%}
          </div>
        </div>

        <div class="hsg-card">
          <h3>How to measure</h3>
          {%- case c -%}
            {%- when 'shoes' -%}
              <div class="hsg-dia">
                <svg viewBox="0 0 300 400" role="img" aria-label="How to measure your foot"><defs><marker id="hsgA" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#e5701a"/></marker></defs><rect x="34" y="8" width="236" height="350" rx="4" fill="#26241f" stroke="#3a3732"/><g transform="translate(66 -6) scale(.92)"><g>
<path fill="#f3efe7" d="M100 392 C66 392 50 368 50 338 C50 302 44 272 35 242 C24 206 18 178 21 148 C24 112 46 92 78 86 C112 80 156 82 172 100 C186 116 184 150 176 182 C168 214 160 244 160 282 C160 322 154 354 140 374 C131 386 117 392 100 392 Z"/>
<g fill="#f3efe7" stroke="#26241f" stroke-width="3">
<ellipse cx="44" cy="114" rx="13" ry="18" transform="rotate(-24 44 100)"/>
<ellipse cx="64" cy="90" rx="14" ry="21" transform="rotate(-14 64 76)"/>
<ellipse cx="89" cy="74" rx="15" ry="24" transform="rotate(-6 89 60)"/>
<ellipse cx="117" cy="66" rx="16" ry="26"/>
<ellipse cx="153" cy="72" rx="26" ry="36" transform="rotate(6 153 58)"/>
</g>
<g fill="none" stroke="#26241f" stroke-width="2" opacity=".5" transform="translate(0 14)">
<path d="M40 92 q4 -7 9 -2"/><path d="M59 66 q5 -8 11 -2"/><path d="M84 48 q6 -9 12 -2"/><path d="M111 38 q6 -9 13 -1"/><path d="M142 40 q10 -12 22 0"/>
</g>
<path fill="#26241f" d="M100 372 C80 372 72 354 72 332 C72 300 66 272 58 244 C50 214 44 188 46 164 C48 140 62 128 82 126 C98 116 120 112 138 118 C156 116 164 132 160 160 C156 190 144 218 140 252 C136 286 138 320 130 344 C125 362 115 372 100 372 Z"/>
</g></g><line x1="14" y1="358" x2="290" y2="358" stroke="#f3efe7" stroke-width="5" stroke-linecap="round"/><text x="152" y="388" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-size="12" letter-spacing="2" fill="#8c867b" font-weight="700">WALL</text><line x1="40" y1="27" x2="250" y2="27" stroke="#e5701a" stroke-width="2" stroke-dasharray="5 4"/><line x1="48" y1="31" x2="48" y2="354" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="48" cy="190" r="14" fill="#e5701a"/><text x="48" y="195" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#fff">1</text></svg>
                <ol class="hsg-steps">
                  {%- for h in hint_lines offset: 1 -%}<li><b>{{ forloop.index }}.</b> {{ h | strip | escape }}</li>{%- endfor -%}
                </ol>
              </div>
            {%- when 'tshirts' -%}
              <div class="hsg-dia one"><svg viewBox="40 10 320 340" role="img" aria-label="How to measure a T-shirt"><defs><marker id="hsgA" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#e5701a"/></marker></defs><path d="M120 40 L165 28 Q200 52 235 28 L280 40 L345 88 L318 140 L285 122 L285 330 L115 330 L115 122 L82 140 L55 88 Z" fill="#1f1e1b" stroke="#f3efe7" stroke-width="2.5" stroke-linejoin="round"/><path d="M165 28 Q200 70 235 28" fill="none" stroke="#f3efe7" stroke-width="2.5"/><line x1="118" y1="150" x2="282" y2="150" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="200" cy="138" r="14" fill="#e5701a"/><text x="200" y="143" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">1</text><line x1="140" y1="40" x2="140" y2="326" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="152" cy="240" r="14" fill="#e5701a"/><text x="152" y="245" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">2</text><line x1="120" y1="46" x2="280" y2="46" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="252" cy="64" r="14" fill="#e5701a"/><text x="252" y="69" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">3</text><line x1="118" y1="312" x2="282" y2="312" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="200" cy="298" r="14" fill="#e5701a"/><text x="200" y="303" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">4</text></svg><p class="hsg-cap">Lay the garment flat · measure in cm</p></div>
            {%- else -%}
              <div class="hsg-dia one"><svg viewBox="0 0 360 330" role="img" aria-label="How to measure a skirt"><defs><marker id="hsgA" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#e5701a"/></marker></defs><path d="M110 40 L250 40 L258 80 L102 80 Z" fill="#1f1e1b" stroke="#f3efe7" stroke-width="2.5"/><path d="M102 80 L258 80 L320 290 Q180 320 40 290 Z" fill="#1f1e1b" stroke="#f3efe7" stroke-width="2.5" stroke-linejoin="round"/><line x1="120" y1="80" x2="80" y2="296" stroke="#f3efe7" stroke-width="1.5"/><line x1="140" y1="80" x2="120" y2="303" stroke="#f3efe7" stroke-width="1.5"/><line x1="240" y1="80" x2="280" y2="296" stroke="#f3efe7" stroke-width="1.5"/><line x1="220" y1="80" x2="240" y2="303" stroke="#f3efe7" stroke-width="1.5"/><line x1="112" y1="28" x2="248" y2="28" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="180" cy="16" r="14" fill="#e5701a"/><text x="180" y="21" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">1</text><line x1="180" y1="44" x2="180" y2="306" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="194" cy="230" r="14" fill="#e5701a"/><text x="194" y="235" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">2</text><line x1="92" y1="128" x2="268" y2="128" stroke="#e5701a" stroke-width="2.5" stroke-dasharray="7 5" marker-start="url(#hsgA)" marker-end="url(#hsgA)"/><circle cx="180" cy="116" r="14" fill="#e5701a"/><text x="180" y="121" text-anchor="middle" font-family="Barlow,Arial,sans-serif" font-weight="800" font-size="15" fill="#1f1e1b">3</text><line x1="62" y1="80" x2="62" y2="128" stroke="#8c867b" stroke-width="1.5"/><text x="26" y="109" font-family="Barlow,Arial,sans-serif" font-size="12" fill="#8c867b" font-weight="700">18 cm</text></svg><p class="hsg-cap">Lay the skirt flat · measure in cm</p></div>
          {%- endcase -%}

          {%- if ctitle != blank -%}<h3>{{ ctitle | escape }}</h3>{%- endif -%}
          <div class="hsg-tw">
            <table data-chart="{{ c }}">
              <thead><tr><th scope="col">{{ head.first | escape }}</th>{%- for col in cols -%}<th scope="col" data-i="{{ forloop.index0 }}">{{ col | strip | escape }}</th>{%- endfor -%}</tr></thead>
              <tbody>
                {%- for line in lines offset: 1 -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- assign vals = parts.last | split: ',' -%}
                  {%- assign key = parts.first | strip | downcase -%}
                  <tr data-row="{% if c == 'shoes' %}{{ key }}{% else %}{{ forloop.index }}{% endif %}">
                    <th scope="row">{%- if c != 'shoes' -%}<span class="hsg-n">{{ forloop.index }}</span>{%- elsif key == 'cm' -%}<span class="hsg-n">1</span>{%- endif -%}{{ parts.first | strip | escape }}</th>
                    {%- for v in vals -%}<td data-i="{{ forloop.index0 }}">{{ v | strip }}</td>{%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('hsg-{{ section.id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var tabs = root.querySelectorAll('.hsg-tab');
  var panels = root.querySelectorAll('.hsg-panel');
  var names = { shoes: 'shoes', sko: 'shoes', tshirts: 'tshirts', 't-shirts': 'tshirts', tshirt: 'tshirts', tops: 'tshirts', skirts: 'skirts', skirt: 'skirts' };

  function show(cat, focus){
    tabs.forEach(function(t){ var on = t.dataset.cat === cat; t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
    panels.forEach(function(p){ p.hidden = p.dataset.cat !== cat; });
  }
  tabs.forEach(function(t, k){
    t.addEventListener('click', function(){ show(t.dataset.cat); if (history.replaceState) history.replaceState(null, '', '#' + t.dataset.cat); });
    t.addEventListener('keydown', function(e){
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var n = (k + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      show(tabs[n].dataset.cat, true);
    });
  });
  var h = (location.hash || '').replace('#', '').toLowerCase();
  show(names[h] || root.dataset.default || 'shoes');
  window.addEventListener('hashchange', function(){ var x = names[location.hash.replace('#','').toLowerCase()]; if (x) show(x); });

  function num(v){ v = String(v).replace(',', '.'); var n = parseFloat(v); return isNaN(n) ? null : n; }

  panels.forEach(function(p){
    var cat = p.dataset.cat;
    var table = p.querySelector('table');
    var cols = Array.prototype.map.call(table.querySelectorAll('thead th[data-i]'), function(th){ return th.textContent.trim(); });
    var rows = {};
    table.querySelectorAll('tbody tr').forEach(function(tr){
      rows[tr.dataset.row] = { label: tr.querySelector('th').textContent.replace(/^\d+/, '').trim(), vals: Array.prototype.map.call(tr.querySelectorAll('td'), function(td){ return num(td.textContent); }) };
    });
    var inputs = p.querySelectorAll('input[data-row]');
    var big = p.querySelector('.hsg-big'), fit = p.querySelector('.hsg-fit'), sum = p.querySelector('.hsg-sum');
    var chips = p.querySelectorAll('.hsg-chip');
    var up = 0;

    function mark(i){
      table.querySelectorAll('.is-hit').forEach(function(el){ el.classList.remove('is-hit'); });
      if (i == null) return;
      table.querySelectorAll('[data-i="' + i + '"]').forEach(function(el){ el.classList.add('is-hit'); });
      var cell = table.querySelector('thead [data-i="' + i + '"]'), wrap = table.parentNode;
      if (cell && wrap.scrollWidth > wrap.clientWidth) wrap.scrollTo({ left: Math.max(0, cell.offsetLeft - wrap.clientWidth / 2 + cell.offsetWidth / 2), behavior: 'smooth' });
    }
    function empty(){ big.textContent = '–'; big.classList.add('is-empty'); fit.innerHTML = ''; sum.hidden = true; mark(null); }
    function line(a, b, cls){ var d = document.createElement('div'); var s1 = document.createElement('span'); s1.textContent = a; var s2 = document.createElement('b'); s2.textContent = b; if (cls) s2.className = cls; d.appendChild(s1); d.appendChild(s2); fit.appendChild(d); }

    function calc(){
      fit.innerHTML = '';
      if (cat === 'shoes') {
        var v = num(inputs[0].value), cm = rows.cm;
        if (v == null || !cm) return empty();
        var i = cm.vals.length - 1;
        for (var k = 0; k < cm.vals.length; k++) { if (cm.vals[k] != null && cm.vals[k] >= v - 0.001) { i = k; break; } }
        i = Math.min(cm.vals.length - 1, i + up);
        big.textContent = cols[0] !== undefined ? (table.querySelector('thead th').textContent.trim() + ' ' + cols[i]) : cols[i];
        big.classList.remove('is-empty');
        Object.keys(rows).forEach(function(r){ if (r !== 'cm') line(rows[r].label, rows[r].vals[i]); });
        line('Foot length', v + ' cm');
        sum.hidden = true;
        if (v > cm.vals[cm.vals.length - 1]) { sum.textContent = 'Your foot is longer than our largest size.'; sum.hidden = false; }
        mark(i); return;
      }
      var used = [];
      inputs.forEach(function(inp){ var v = num(inp.value); if (v != null && rows[inp.dataset.row]) used.push({ r: rows[inp.dataset.row], v: v }); });
      if (!used.length) return empty();
      var best = 0, bestScore = Infinity;
      for (var i2 = 0; i2 < cols.length; i2++) {
        var sc = 0;
        used.forEach(function(u){ var vs = u.r.vals; var step = Math.abs((vs[vs.length-1] - vs[0]) / Math.max(1, vs.length - 1)) || 1; sc += Math.abs(u.v - vs[i2]) / step; });
        if (sc <= bestScore + 1e-9) { bestScore = sc; best = i2; }
      }
      var okCount = 0;
      used.forEach(function(u){
        var vs = u.r.vals, step = Math.abs((vs[vs.length-1] - vs[0]) / Math.max(1, vs.length - 1)) || 1, d = u.v - vs[best];
        var txt, cls;
        if (Math.abs(d) <= step * 0.35) { txt = cols[best] + ' ✓'; cls = 'ok'; okCount++; }
        else {
          var near = 0, nd = Infinity; vs.forEach(function(x, k){ var dd = Math.abs(u.v - x); if (dd < nd) { nd = dd; near = k; } });
          var lo = Math.min(best, near), hi = Math.max(best, near);
          if (lo === hi) { lo = d < 0 ? Math.max(0, best - 1) : best; hi = d < 0 ? best : Math.min(cols.length - 1, best + 1); }
          txt = lo === hi ? cols[lo] : cols[lo] + '–' + cols[hi]; cls = 'up';
        }
        line(u.r.label + ' ' + u.v, txt, cls);
      });
      big.textContent = cols[best]; big.classList.remove('is-empty');
      sum.textContent = okCount + ' of ' + used.length + ' measurement' + (used.length > 1 ? 's' : '') + ' fit ' + cols[best] + '.';
      sum.hidden = false;
      mark(best);
    }
    inputs.forEach(function(inp){ inp.addEventListener('input', calc); });
    chips.forEach(function(ch){
      ch.addEventListener('click', function(){
        chips.forEach(function(x){ x.setAttribute('aria-pressed', x === ch); });
        up = parseInt(ch.dataset.up, 10) || 0; calc();
      });
    });
  });
})();
</script>

