    { "type": "textarea", "id": "tee_chart", "label": "Tabel", "info": "Rækkefølgen skal passe til numrene på tegningen: 1 Chest, 2 Length, 3 Shoulder, 4 Bottom.",
      "default": "Size|5XS,4XS,3XS,2XS,XS,S,M,L,XL,2XL,3XL\nChest|39,41,43,45,47,49,51,53,55,57,59\nLength|55,57,59,61,63,65,68,71,73,75,77\nShoulder|38.6,39.8,41,42.2,43.4,44.6,45.8,47,48.2,49.4,50.8\nBottom|39,41,43,45,47,49,51,53,55,57,59" },
    { "type": "textarea", "id": "tee_hints", "label": "Hjælpetekst pr. felt (én linje pr. række)",
      "default": "1\" below the armhole, side to side\nFrom shoulder to hem\nShoulder seam to seam\nAcross the hem" },
    { "type": "text", "id": "tee_note", "label": "Råd under resultatet", "default": "We recommend measuring your T-shirt flat and comparing it with our size chart for the best fit." },
