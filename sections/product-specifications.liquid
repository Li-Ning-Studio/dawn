{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'section-product-specifications.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_custom_specs = false
  assign specification_hook = product.metafields.custom_but_hidden.specification_hook
  assign hidden_weight = product.metafields.custom_but_hidden.weight

  for spec in product.metafields.custom
    assign spec_field = spec[1]
    if spec_field and spec_field.value != blank
      assign has_custom_specs = true
      break
    endif
  endfor

  if hidden_weight.value != blank
    assign has_custom_specs = true
  endif
-%}

{%- if has_custom_specs -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <section class="product-specifications section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="product__accordion accordion">
        <details
          id="Details-product-specifications-{{ section.id }}"
          {% if section.settings.open_by_default %}
            open
          {% endif %}
        >
          <summary>
            <div class="summary__title">
              <h2 class="h4 accordion__title inline-richtext s3_subtitle">{{ section.settings.heading | escape }}</h2>
            </div>
            <span class="accordion__toggle-icons" aria-hidden="true">
              <span class="accordion__toggle-icon accordion__toggle-icon--plus">
                {{- 'icon-accordion-plus.svg' | inline_asset_content -}}
              </span>
              <span class="accordion__toggle-icon accordion__toggle-icon--minus">
                {{- 'icon-accordion-minus.svg' | inline_asset_content -}}
              </span>
            </span>
          </summary>
          <div class="accordion__content" id="ProductSpecifications-{{ section.id }}">
            {% comment %} <h3 class="product-specifications__heading">{{ section.settings.heading | escape }}</h3> {% endcomment %}
            {%- if specification_hook.value != blank -%}
              <div class="product-specifications__hook s3_subheading rte">
                {{ specification_hook | metafield_tag }}
              </div>
            {%- endif -%}
            <div class="product-specifications__grid" role="list">
              {%- for spec in product.metafields.custom -%}
                {%- liquid
                  assign spec_key = spec[0]
                  assign spec_field = spec[1]
                -%}
                {%- if spec_field and spec_field.value != blank -%}
                  {%- liquid
                    # Use the metafield definition label when available; fallback to a readable key.
                    assign spec_label = spec_field.definition.name
                    if spec_label == blank
                      assign spec_key_readable = spec_key | replace: '_', ' ' | replace: '-', ' ' | strip
                      assign spec_key_words = spec_key_readable | split: ' '
                      capture spec_label
                        for word in spec_key_words
                          echo word | capitalize
                          unless forloop.last
                            echo ' '
                          endunless
                        endfor
                      endcapture
                      assign spec_label = spec_label | strip
                    endif
                  -%}
                  <div class="product-specifications__item" role="listitem">
                    <p class="product-specifications__label">{{ spec_label }}</p>
                    <div class="product-specifications__value s3_paragraph">
                      {{ spec_field | metafield_text }}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- if hidden_weight.value != blank -%}
                <div class="product-specifications__item" role="listitem">
                  <p class="product-specifications__label">Weight</p>
                  <div class="product-specifications__value s3_paragraph">
                    {{ hidden_weight.value }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </details>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product-specifications.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.product-specifications.settings.heading.label",
      "default": "t:sections.product-specifications.settings.heading.default"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:sections.product-specifications.settings.open_by_default.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-specifications.name"
    }
  ]
}
{% endschema %}
