<ul data-label="{{ 'templates.search.products' | t }}">{%- if search.performed -%}{%- assign hs_n = 0 -%}{%- for hs_p in search.results -%}{%- if hs_p.object_type == 'product' and hs_n < 4 -%}{%- assign hs_n = hs_n | plus: 1 -%}<li id="predictive-search-option-product-{{ hs_n }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_p.url }}" class="predictive-search__item hs-prod" tabindex="-1"><span class="hs-thumb">{%- if hs_p.featured_media -%}{{ hs_p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: hs_p.title }}{%- endif -%}</span><span class="hs-info"><span class="hs-title">{{ hs_p.title | escape }}</span></span><span class="hs-price">{{ hs_p.price_min | money }}</span></a></li>{%- endif -%}{%- endfor -%}{%- endif -%}</ul>