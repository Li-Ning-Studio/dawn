{%- comment -%}
  HUNDRED – Produktside-design
  Kun CSS. Ændrer udseendet af den eksisterende produktsektion (main-product)
  for både B2C og B2B. Ingen funktioner ændres: priser, B2B-katalog,
  bulk-bestilling (quick order list), stringing/grip/remix osv. virker som før.
  Læg sektionen på produktskabelonen i Tilpas (placeringen er ligegyldig).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">

<style>
  product-info{
    --hp-ink:#0a0a0b;--hp-soft:#5d584f;--hp-muted:#8c867b;--hp-line:#e7e3dc;--hp-panel:#f5f3ef;
    --hp-gold:#f2a81d;--hp-ember:#e5701a;--hp-ok:#3aa76d;
    --hp-display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;
    --hp-body:"Barlow","Helvetica Neue",Arial,sans-serif;
  }

  /* ---------- Billeder: altid kvadratiske, lys flade ---------- */
  {%- if section.settings.square_media -%}
  product-info .product__media-wrapper .product__media-item .media,
  product-info .product__media-wrapper .product-media-container .media{
    padding-top:100% !important;background:var(--hp-panel);border-radius:14px;overflow:hidden;
  }
  product-info .product__media-wrapper .product-media-container{--ratio:1 !important;--preview-ratio:1 !important}
  product-info .product__media-wrapper .media img{object-fit:contain !important;mix-blend-mode:multiply}
  product-info .thumbnail-list .thumbnail{border-radius:8px;overflow:hidden;background:var(--hp-panel);border:0 !important}
  product-info .thumbnail-list .thumbnail img{object-fit:contain;mix-blend-mode:multiply}
  product-info .thumbnail-list .thumbnail[aria-current]{box-shadow:0 0 0 2px var(--hp-ink) !important}
  {%- endif -%}
  /* Pilene skal ligge øverst, så de kan trykkes på mobil (ellers dækker zoom-knappen dem) */
  product-info .product__media-wrapper{isolation:isolate}
  product-info .product__media-wrapper .slider-buttons{z-index:3}
  product-info .product__media-wrapper .slider-button,
  product-info .product__media-wrapper button[name="previous"],
  product-info .product__media-wrapper button[name="next"]{position:relative;z-index:3;pointer-events:auto;touch-action:manipulation}
  product-info .slider-button,
  product-info .product__media-wrapper button[name="previous"],
  product-info .product__media-wrapper button[name="next"]{
    border-radius:50% !important;background:#fff !important;border:1px solid var(--hp-line) !important;color:var(--hp-ink) !important;
  }

  /* ---------- Titel ---------- */
  product-info .product__main-title{
    font:italic 900 clamp(32px,3.3vw,50px)/.92 var(--hp-display) !important;text-transform:uppercase;letter-spacing:-.005em !important;
    color:var(--hp-ink);margin:6px 0 0 !important;text-wrap:balance;
  }
  product-info .product__eyebrow-row,
  product-info .product__eyebrow-row *{
    font-family:var(--hp-body) !important;font-size:12px !important;font-weight:700 !important;letter-spacing:.2em !important;
    text-transform:uppercase;color:var(--hp-ember) !important;
  }

  /* ---------- Pris (B2C) ---------- */
  product-info .price--large .price-item{font:700 28px/1.2 var(--hp-body) !important;letter-spacing:0 !important;color:var(--hp-ink)}
  product-info .price--large .price__sale .price-item--regular{font-size:18px !important;color:var(--hp-muted)}
  product-info .product__tax,product-info .price .tax-note{font-size:13px;color:var(--hp-muted)}

  /* ---------- Vejledende udsalgspris (kun B2B) ---------- */
  product-info .product__rrp{
    display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 16px;
    margin:18px 0 6px !important;padding:14px 18px;border:1px solid var(--hp-line);border-radius:10px;background:var(--hp-panel);
    font:700 20px/1.3 var(--hp-body);color:var(--hp-ink);letter-spacing:0;
  }
  product-info .product__rrp strong,
  product-info .product__rrp .hp-rrp-label{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--hp-soft)}

  /* ---------- Størrelser / varianter (B2C) ---------- */
  product-info .product-form__input--pill{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  product-info .product-form__input--pill > legend,
  product-info .product-form__input--pill > .form__label{grid-column:1 / -1}
  product-info .product-form__input--pill input[type=radio]+label{width:100%;text-align:center;justify-content:center}
  product-info .product-form__input .form__label{width:100%;font:700 12px/1 var(--hp-body);letter-spacing:.16em;text-transform:uppercase;color:var(--hp-ink);margin-bottom:6px}
  product-info .product-form__input--pill input[type=radio]+label{
    margin:0 !important;border-radius:8px !important;border:1px solid var(--hp-line) !important;background:#fff !important;color:var(--hp-ink) !important;
    padding:13px 8px !important;font:600 14px/1.25 var(--hp-body) !important;letter-spacing:0 !important;transition:border-color .15s,box-shadow .15s;
  }
  product-info .product-form__input--pill input[type=radio]+label:hover{border-color:var(--hp-ink) !important}
  product-info .product-form__input--pill input[type=radio]:checked+label{
    background:#fff !important;color:var(--hp-ink) !important;border-color:var(--hp-ink) !important;box-shadow:inset 0 0 0 1px var(--hp-ink);
  }
  product-info .product-form__input--pill input[type=radio].disabled+label,
  product-info .product-form__input--pill input[type=radio]:disabled+label{
    color:#c9c4bb !important;background:repeating-linear-gradient(135deg,#fff 0 6px,#f3f1ec 6px 7px) !important;text-decoration:line-through;
  }

  /* ---------- Antal + Læg i kurv (B2C) ---------- */
  product-info .quantity{border-radius:999px;min-height:56px}
  product-info .quantity:after,product-info .quantity:before{border-radius:999px !important;box-shadow:0 0 0 1px var(--hp-line) !important}
  product-info .product-form__submit,
  product-info .product-form__buttons .button--primary{
    min-height:58px;border-radius:999px !important;background:var(--hp-ink) !important;color:#fff !important;
    font:700 14px/1 var(--hp-body) !important;letter-spacing:.16em !important;text-transform:uppercase;
    position:relative;overflow:hidden;
  }
  product-info .product-form__submit::before,
  product-info .product-form__buttons .button--primary::before{
    content:"";position:absolute;left:0;right:0;bottom:0;height:3px;top:auto !important;box-shadow:none !important;border-radius:0 !important;
    background:linear-gradient(90deg,var(--hp-gold),var(--hp-ember)) !important;
  }
  product-info .product-form__submit:hover{background:#222 !important}
  product-info .shopify-payment-button__button{border-radius:999px !important;min-height:52px}

  /* ---------- Bulk-bestilling (kun B2B) ----------
     Bevidst let: kun skrift og farver. Layout, kolonner og total-boksen
     er Shopifys egne og røres ikke, så tabellen altid passer. */
  product-info .quick-order-list__table thead th{
    font:700 11px/1.2 var(--hp-body) !important;letter-spacing:.16em !important;text-transform:uppercase;color:var(--hp-soft) !important;
  }
  product-info .variant-item__name{font-family:var(--hp-body) !important;font-weight:700 !important;letter-spacing:0 !important;color:var(--hp-ink)}
  product-info .variant-item__sku{color:var(--hp-muted) !important}
  product-info .variant-item__totals,product-info .variant-item__price{font-variant-numeric:tabular-nums}
  product-info .quick-order-list .quantity__input{font-weight:700}

  /* ---------- Faner (Details osv.) ---------- */
  product-info .product__accordion{border-color:var(--hp-line) !important}
  product-info .product__accordion summary{padding:18px 0 !important}
  product-info .product__accordion .accordion__title{font:700 17px/1.2 var(--hp-body) !important;letter-spacing:.02em !important;color:var(--hp-ink)}
  product-info .accordion__toggle-icon{color:var(--hp-gold)}
  product-info .accordion__content{color:var(--hp-soft);font-size:15px;line-height:1.65}

  @media (max-width:749px){
    product-info .product-form__input--pill{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
</style>

{% schema %}
{
  "name": "HUNDRED Produktdesign",
  "tag": "div",
  "class": "hundred-product-style",
  "settings": [
    { "type": "paragraph", "content": "Ændrer kun udseendet af produktsiden. B2B-priser, bulk-bestilling og alle funktioner virker som før." },
    { "type": "checkbox", "id": "square_media", "label": "Kvadratiske produktbilleder (1:1)", "default": true }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "HUNDRED Produktdesign" }]
}
{% endschema %}
