{%- comment -%}
  HUNDRED – The story behind (about-side)
  Sektion med tidslinje, THINK BIG-bånd, EUROPE-effekt og streg-effekt.
  Indhold redigeres i temaeditoren. Rækkefølgen på blokkene styrer siden.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">

<style>
  .hs{
    --hs-bg:#0a0a0b;--hs-bg-2:#131315;--hs-line:#26241f;--hs-text:#f3efe7;--hs-soft:#cfc9be;--hs-muted:#8c867b;
    --hs-gold:#f2a81d;--hs-ember:#e5701a;
    --hs-display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;
    --hs-body:"Barlow","Helvetica Neue",Arial,sans-serif;
    --hs-gutter:clamp(16px,4vw,56px);
    background:var(--hs-bg);color:var(--hs-text);font-family:var(--hs-body);font-size:18px;line-height:1.6;letter-spacing:0;
    overflow-x:clip;
  }
  .hs *{box-sizing:border-box}
  .hs ::selection{background:var(--hs-gold);color:#000}
  .hs-wrap{padding-inline:var(--hs-gutter);max-width:1360px;margin-inline:auto}
  .hs-progress{position:fixed;left:0;top:0;height:3px;width:100%;transform-origin:0 50%;transform:scaleX(var(--p,0));background:linear-gradient(90deg,var(--hs-ember),var(--hs-gold));z-index:1000;pointer-events:none}
  .hs-eyebrow{display:block;font:700 13px/1 var(--hs-body);letter-spacing:.42em;text-transform:uppercase;color:var(--hs-gold)}

  /* billeder */
  .hs-media{position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--hs-line);background:#141414}
  .hs-media img{display:block;width:100%;height:100%;object-fit:cover}
  .hs-media--ph{background:repeating-linear-gradient(135deg,rgba(255,255,255,.035) 0 2px,transparent 2px 14px),linear-gradient(160deg,#1d1c1a,#0f0f10)}
  .hs-media--ph::after{content:attr(data-label);position:absolute;left:14px;bottom:12px;right:14px;font:600 11px/1.3 var(--hs-body);letter-spacing:.14em;text-transform:uppercase;color:var(--hs-muted)}

  /* hero */
  .hs-hero{padding-block:clamp(80px,12vh,140px) 0;display:grid;gap:clamp(40px,7vh,70px)}
  .hs-hero-text{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:24px clamp(32px,5vw,80px);align-items:end}  .hs-hero-text .hs-eyebrow{grid-column:1/-1}
  .hs .hs-wordmark{font:italic 900 clamp(84px,16vw,250px)/.8 var(--hs-display);letter-spacing:-.02em;text-transform:uppercase;margin:0;color:var(--hs-gold)}
  .hs-wordmark span{display:inline-block;padding-right:.02em;
    background:linear-gradient(180deg,#ffc94a,var(--hs-gold) 45%,var(--hs-ember));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    animation:hs-rise .9s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i)*60ms)}
  @keyframes hs-rise{from{transform:translateY(.35em) skewX(-8deg);opacity:.15}to{transform:none;opacity:1}}
  .hs .hs-hero-sub{font:500 clamp(20px,2vw,26px)/1.35 var(--hs-body);margin:0 0 .6em;color:var(--hs-text);text-wrap:balance}
  .hs-hero-media{aspect-ratio:21/9;max-width:100%}
  .hs-hero-media .hs-parallax{position:absolute;left:0;right:0;top:-14%;height:128%;will-change:transform}
  .hs-hero-media .hs-parallax img{height:100%}

  /* rejse-kort */
  .hs-map{position:relative;aspect-ratio:21/9;max-width:100%}
  .hs-map canvas{position:absolute;inset:0;width:100%;height:100%;display:block;
    -webkit-mask-image:radial-gradient(ellipse 75% 80% at 50% 50%,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 75% 80% at 50% 50%,#000 55%,transparent 100%)}
  .hs-map-label{position:absolute;left:0;top:0;display:grid;gap:4px;pointer-events:none;opacity:0;transition:opacity .6s,translate .6s;translate:0 8px;white-space:nowrap}
  .hs-map-label.is-on{opacity:1;translate:0 0}
  .hs-map-label b{font:italic 900 clamp(30px,3.4vw,52px)/.9 var(--hs-display);color:var(--hs-gold)}
  .hs-map-label span{font:700 12px/1.2 var(--hs-body);letter-spacing:.24em;text-transform:uppercase;color:var(--hs-text)}
  .hs-map-label--to{text-align:right}

  /* kapitler med tidslinje */
  .hs-chapter{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(24px,5vw,80px);padding-block:clamp(70px,12vh,130px)}
  .hs-year-sticky{position:sticky;top:calc(var(--hs-header,0px) + 40px);display:grid;gap:16px}
  .hs-year{font:italic 900 clamp(110px,15vw,230px)/1 var(--hs-display);letter-spacing:-.03em;color:transparent;-webkit-text-stroke:2px var(--hs-gold);height:1em;overflow:hidden}
  .hs-digits{display:block;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .hs-digits span{display:block;height:1em;line-height:1;padding-left:.04em}
  .hs-year-label{font:700 14px/1.3 var(--hs-body);letter-spacing:.24em;text-transform:uppercase;color:var(--hs-muted);min-height:1.3em}
  .hs-track{position:relative;height:2px;background:var(--hs-line);max-width:320px}
  .hs-track i{position:absolute;inset:0;transform-origin:0;transform:scaleX(var(--tp,0));background:var(--hs-gold);transition:transform .3s}
  .hs-steps{display:grid;gap:clamp(70px,16vh,150px);padding-top:4vh}
  .hs-step{max-width:56ch;opacity:.3;transform:translateY(10px);transition:opacity .5s,transform .5s;display:grid;gap:14px}
  .hs-step.is-active{opacity:1;transform:none}
  .hs .hs-step-title{font:italic 800 clamp(32px,3.8vw,52px)/1 var(--hs-display);letter-spacing:0;text-transform:uppercase;margin:0 0 4px;color:var(--hs-text);text-wrap:balance}
  .hs .hs-big-line{font:italic 800 clamp(26px,3vw,40px)/1.08 var(--hs-display);text-transform:uppercase;color:var(--hs-gold);margin:0}
  .hs-text{color:var(--hs-soft)}
  .hs-text p{margin:0 0 .8em}
  .hs-text p:last-child{margin-bottom:0}
  .hs-text--callout{border-left:2px solid var(--hs-gold);padding-left:18px;color:var(--hs-text);font-weight:500;font-size:1.08em}
  .hs-text--strong{color:var(--hs-text);font-weight:600}
  .hs-step .hs-media{margin-top:10px;aspect-ratio:16/9}

  /* streg over ordet */
  .hs .hs-strike{font:italic 900 clamp(34px,4.6vw,64px)/.98 var(--hs-display);text-transform:uppercase;color:var(--hs-text);margin:10px 0 0;text-wrap:balance}
  .hs-strike-word{position:relative;color:var(--hs-muted);white-space:nowrap}
  .hs-strike-word::after{content:"";position:absolute;left:-3%;right:-3%;top:52%;height:.09em;background:var(--hs-ember);transform-origin:0;transform:scaleX(var(--k,0)) rotate(-2deg)}
  .hs-strike-built{color:var(--hs-gold)}

  /* THINK BIG */
  .hs-think{padding-block:clamp(60px,10vh,110px);overflow:hidden;border-block:1px solid var(--hs-line);background:var(--hs-bg-2)}
  .hs-marquee{white-space:nowrap;font:italic 900 clamp(64px,12vw,180px)/.9 var(--hs-display);text-transform:uppercase;will-change:transform}
  .hs-marquee--a{color:var(--hs-text)}
  .hs-marquee--b{color:transparent;-webkit-text-stroke:2px var(--hs-gold)}
  .hs-think-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:clamp(28px,5vw,72px);margin-top:clamp(44px,7vh,80px);align-items:start}
  .hs-think-body .hs-text{max-width:50ch}
  .hs .hs-lead{font:500 clamp(22px,2.2vw,28px)/1.35 var(--hs-body);color:var(--hs-text);margin:0 0 14px}
  .hs .hs-foundation-title{font:italic 900 clamp(40px,5vw,76px)/.92 var(--hs-display);letter-spacing:0;text-transform:uppercase;margin:0 0 18px;color:var(--hs-text)}
  .hs-foundation-title em{font-style:inherit;color:var(--hs-gold)}
  .hs-foundation .hs-media{aspect-ratio:16/10;margin-bottom:22px}

  /* EUROPE */
  .hs-europe{height:140vh;position:relative}
  .hs-europe-pin{position:sticky;top:0;height:100vh;display:grid;place-items:center;overflow:hidden}
  .hs-europe canvas{position:absolute;inset:0;width:100%;height:100%}
  .hs-europe-word{position:relative;font:italic 900 clamp(90px,21vw,360px)/.8 var(--hs-display);text-transform:uppercase;letter-spacing:-.02em;color:transparent;-webkit-text-stroke:2px var(--hs-gold);transform:scale(calc(.75 + var(--e,0)*.35))}
  .hs-europe-word::after{content:attr(data-word);position:absolute;inset:0;color:var(--hs-gold);-webkit-text-stroke:0;clip-path:inset(calc(100% - var(--e,0)*100%) 0 0 0)}
  .hs .hs-europe-pre{position:absolute;top:18vh;left:0;right:0;text-align:center;padding-inline:var(--hs-gutter);font:500 clamp(18px,2vw,24px)/1.4 var(--hs-body);color:var(--hs-soft);text-wrap:balance;max-width:34ch;margin:0 auto}

  /* finale */
  .hs-finale{padding-block:clamp(80px,12vh,140px) clamp(110px,14vh,170px);text-align:center;border-top:1px solid var(--hs-line)}
  .hs .hs-finale-title{font:italic 900 clamp(64px,13vw,210px)/.85 var(--hs-display);text-transform:uppercase;margin:0;letter-spacing:-.01em;color:var(--hs-text)}
  .hs-pct{background:linear-gradient(90deg,var(--hs-ember),var(--hs-gold),#ffd36a,var(--hs-gold),var(--hs-ember));background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:hs-sheen 5s linear infinite}
  @keyframes hs-sheen{to{background-position:-200% 0}}
  .hs .hs-cta{display:inline-flex;align-items:center;gap:12px;margin-top:44px;padding:18px 34px;border-radius:999px;background:var(--hs-gold);color:#000;font:700 13px/1 var(--hs-body);letter-spacing:.24em;text-transform:uppercase;text-decoration:none}
  .hs-cta:focus-visible{outline:2px solid var(--hs-text);outline-offset:3px}

  @media (max-width:820px){
    .hs{font-size:17px}
    .hs-hero-text,.hs-chapter{grid-template-columns:minmax(0,1fr)}
    .hs-hero-media{aspect-ratio:4/3}
    .hs-map{aspect-ratio:3/2}
    .hs-map-label b{font-size:26px}
    .hs-map-label span{font-size:10px;letter-spacing:.18em}
    .hs-year-sticky{top:var(--hs-header,0px);padding-block:14px;background:linear-gradient(var(--hs-bg) 82%,transparent);z-index:2}
    .hs-year{font-size:92px}
    .hs-steps{padding-top:0;gap:72px}
    .hs-europe{height:120vh}
  }
  @media (prefers-reduced-motion:reduce){
    .hs *,.hs *::before,.hs *::after{animation:none!important;transition:none!important}
    .hs-marquee,.hs-parallax{transform:none!important}
  }
</style>

{%- capture ph_open -%}<div class="hs-media hs-media--ph" data-label="{%- endcapture -%}

<div class="hs" id="hs-{{ section.id }}">
  <div class="hs-progress" aria-hidden="true"></div>

  {%- comment -%} HERO {%- endcomment -%}
  <header class="hs-wrap hs-hero">
    <div class="hs-hero-text">
      <span class="hs-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- assign title_chars = section.settings.title | split: '' -%}
      <h1 class="hs-wordmark" aria-label="{{ section.settings.title | escape }}">
        {%- for c in title_chars -%}<span style="--i:{{ forloop.index0 }}" aria-hidden="true">{{ c }}</span>{%- endfor -%}
      </h1>
      <p class="hs-hero-sub">{{ section.settings.subtitle | escape }}</p>
    </div>
    {%- if section.settings.hero_mode == 'map' -%}
      <div class="hs-map" data-map aria-label="{{ section.settings.map_from_label | escape }} → {{ section.settings.map_to_label | escape }}" role="img">
        <canvas aria-hidden="true"></canvas>
        <div class="hs-map-label hs-map-label--from" data-from><b>{{ section.settings.map_from_year | escape }}</b><span>{{ section.settings.map_from_label | escape }}</span></div>
        <div class="hs-map-label hs-map-label--to" data-to><b>{{ section.settings.map_to_year | escape }}</b><span>{{ section.settings.map_to_label | escape }}</span></div>
      </div>
    {%- elsif section.settings.hero_image != blank -%}
      <div class="hs-media hs-hero-media">
        <div class="hs-parallax">
          {{ section.settings.hero_image | image_url: width: 2400 | image_tag: widths: '800,1200,1600,2000,2400', sizes: '100vw', fetchpriority: 'high', alt: section.settings.hero_image.alt }}
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <div class="hs-media hs-media--ph hs-hero-media" data-label="Vælg et stort billede (bredformat)"><div class="hs-parallax"></div></div>
    {%- endif -%}
  </header>

  {%- assign in_chapter = false -%}
  {%- assign in_step = false -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'chapter' -%}
        {%- if in_step -%}</article>{%- assign in_step = false -%}{%- endif -%}
        {%- if in_chapter -%}</div></section>{%- endif -%}
        <section class="hs-wrap hs-chapter" data-chapter {{ block.shopify_attributes }}>
          <div>
            <div class="hs-year-sticky">
              <span class="hs-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              <div class="hs-year" aria-hidden="true"><span class="hs-digits"></span></div>
              <div class="hs-year-label" aria-hidden="true"></div>
              <div class="hs-track" aria-hidden="true"><i></i></div>
            </div>
          </div>
          <div class="hs-steps">
        {%- assign in_chapter = true -%}

      {%- when 'step' -%}
        {%- if in_step -%}</article>{%- endif -%}
        <article class="hs-step" data-year="{{ block.settings.year | escape }}" data-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
        {%- assign in_step = true -%}

      {%- when 'heading' -%}
        <h3 class="hs-step-title" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h3>

      {%- when 'big_line' -%}
        <p class="hs-big-line" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>

      {%- when 'text' -%}
        <div class="hs-text hs-text--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

      {%- when 'strike' -%}
        <p class="hs-strike" {{ block.shopify_attributes }}>
          {{ block.settings.before | escape }} <span class="hs-strike-word">{{ block.settings.word | escape }}</span> {{ block.settings.after | escape }}
          <span class="hs-strike-built">{{ block.settings.built | escape }}</span>
        </p>

      {%- when 'image' -%}
        {%- if block.settings.image != blank -%}
          <div class="hs-media" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 820px) 50vw, 100vw', alt: block.settings.image.alt }}
          </div>
        {%- elsif request.design_mode -%}
          {{ ph_open }}{{ block.settings.hint | escape }}" {{ block.shopify_attributes }}></div>
        {%- endif -%}

      {%- when 'think_big' -%}
        {%- if in_step -%}</article>{%- assign in_step = false -%}{%- endif -%}
        {%- if in_chapter -%}</div></section>{%- assign in_chapter = false -%}{%- endif -%}
        <section class="hs-think" {{ block.shopify_attributes }}>
          {%- capture line_a -%}{{ block.settings.line_1 | escape }} {%- endcapture -%}
          {%- capture line_b -%}{{ block.settings.line_2 | escape }} {%- endcapture -%}
          <div class="hs-marquee hs-marquee--a" data-marquee="-1" aria-hidden="true">{% for i in (1..6) %}{{ line_a }} {% endfor %}</div>
          <div class="hs-marquee hs-marquee--b" data-marquee="1" aria-hidden="true">{% for i in (1..5) %}{{ line_b }} {% endfor %}</div>
          <h2 class="visually-hidden">{{ block.settings.line_1 | escape }} {{ block.settings.line_2 | escape }}</h2>
          <div class="hs-wrap hs-think-body">
            <div>
              <p class="hs-lead">{{ block.settings.lead | escape }}</p>
              <div class="hs-text">{{ block.settings.text }}</div>
            </div>
            <div class="hs-foundation">
              {%- if block.settings.image != blank -%}
                <div class="hs-media">{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 820px) 50vw, 100vw', alt: block.settings.image.alt }}</div>
              {%- elsif request.design_mode -%}
                <div class="hs-media hs-media--ph" data-label="Vælg billede: badminton"></div>
              {%- endif -%}
              <h3 class="hs-foundation-title">{{ block.settings.foundation_title | escape }} <em>{{ block.settings.foundation_highlight | escape }}</em></h3>
              <div class="hs-text">{{ block.settings.foundation_text }}</div>
            </div>
          </div>
        </section>

      {%- when 'europe' -%}
        {%- if in_step -%}</article>{%- assign in_step = false -%}{%- endif -%}
        {%- if in_chapter -%}</div></section>{%- assign in_chapter = false -%}{%- endif -%}
        <section class="hs-europe" data-europe {{ block.shopify_attributes }}>
          <div class="hs-europe-pin">
            <canvas aria-hidden="true"></canvas>
            <p class="hs-europe-pre">{{ block.settings.pre | escape }}</p>
            <h2 class="hs-europe-word" data-word="{{ block.settings.word | escape }}">{{ block.settings.word | escape }}</h2>
          </div>
        </section>

    {%- endcase -%}
  {%- endfor -%}
  {%- if in_step -%}</article>{%- endif -%}
  {%- if in_chapter -%}</div></section>{%- endif -%}

  {%- comment -%} FINALE {%- endcomment -%}
  <section class="hs-wrap hs-finale">
    <h2 class="hs-finale-title">{{ section.settings.finale_1 | escape }}<br><span class="hs-pct">{{ section.settings.finale_2 | escape }}</span></h2>
    {%- if section.settings.button_label != blank -%}
      <a class="hs-cta" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label | escape }} →</a>
    {%- endif -%}
  </section>
</div>

<script>
  (function () {
    function initHundredStory(root) {
      if (!root) return;
      window.__hsCtrl = window.__hsCtrl || {};
      if (window.__hsCtrl[root.id]) window.__hsCtrl[root.id].abort();
      var ctrl = new AbortController();
      window.__hsCtrl[root.id] = ctrl;

      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var $ = function (s) { return root.querySelector(s); };
      var $$ = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
      var clamp = function (v) { return Math.min(1, Math.max(0, v)); };
      var vh = function () { return window.innerHeight; };

      function setHeader() {
        var h = document.querySelector('.section-header');
        var sticky = h && getComputedStyle(h).position === 'sticky';
        root.style.setProperty('--hs-header', (sticky ? h.offsetHeight : 0) + 'px');
      }

      var chapters = $$('[data-chapter]').map(function (ch) {
        var steps = Array.prototype.slice.call(ch.querySelectorAll('.hs-step'));
        var years = [];
        steps.forEach(function (s) { if (years.indexOf(s.dataset.year) < 0) years.push(s.dataset.year); });
        var digits = ch.querySelector('.hs-digits');
        digits.innerHTML = years.map(function (y) { return '<span>' + y + '</span>'; }).join('');
        return { ch: ch, steps: steps, years: years, digits: digits, label: ch.querySelector('.hs-year-label'), track: ch.querySelector('.hs-track'), cur: -1 };
      });

      var europes = $$('[data-europe]').map(function (el) {
        var cv = el.querySelector('canvas');
        return { el: el, word: el.querySelector('.hs-europe-word'), cv: cv, ctx: cv.getContext('2d'), dots: [] };
      });
      function sizeCanvas(e) {
        var r = e.cv.getBoundingClientRect(), d = window.devicePixelRatio || 1;
        e.cv.width = r.width * d; e.cv.height = r.height * d; e.ctx.setTransform(d, 0, 0, d, 0, 0);
        e.dots = [];
        var gap = r.width < 600 ? 22 : 30;
        for (var y = gap / 2; y < r.height; y += gap)
          for (var x = gap / 2; x < r.width; x += gap) e.dots.push({ x: x, y: y, t: Math.random() });
        e.w = r.width; e.h = r.height;
      }
      function drawDots(e, p) {
        e.ctx.clearRect(0, 0, e.w, e.h);
        e.dots.forEach(function (d) {
          var lit = d.t < p * 0.55;
          e.ctx.fillStyle = lit ? 'rgba(242,168,29,.85)' : 'rgba(255,255,255,.07)';
          e.ctx.beginPath(); e.ctx.arc(d.x, d.y, lit ? 1.8 : 1.2, 0, 7); e.ctx.fill();
        });
      }

      var prog = function (el) { var r = el.getBoundingClientRect(); return clamp((vh() - r.top) / (r.height + vh())); };
      var pinProg = function (el) { var r = el.getBoundingClientRect(); return clamp(-r.top / (r.height - vh())); };

      var bar = $('.hs-progress');
      var heroMedia = $('.hs-hero-media'), heroPar = $('.hs-parallax');
      var marquees = $$('[data-marquee]');
      var strikes = $$('.hs-strike-word');
      var ticking = false;

      function frame() {
        var rr = root.getBoundingClientRect();
        bar.style.setProperty('--p', clamp(-rr.top / (rr.height - vh())));

        if (!reduce) {
          if (heroMedia && heroPar) heroPar.style.transform = 'translate3d(0,' + (heroMedia.getBoundingClientRect().top * -0.15) + 'px,0)';
          marquees.forEach(function (m) {
            m.style.transform = 'translate3d(' + ((prog(m) - 0.5) * 40 * m.dataset.marquee - 10) + '%,0,0)';
          });
        }

        chapters.forEach(function (c) {
          if (!c.steps.length) return;
          var active = 0;
          c.steps.forEach(function (s, i) { if (s.getBoundingClientRect().top < vh() * 0.6) active = i; });
          c.steps.forEach(function (s, i) { s.classList.toggle('is-active', i === active); });
          if (active !== c.cur) {
            c.cur = active;
            var s = c.steps[active];
            c.digits.style.transform = 'translateY(' + (-c.years.indexOf(s.dataset.year)) + 'em)';
            c.label.textContent = s.dataset.label;
          }
          var r = c.ch.getBoundingClientRect();
          c.track.style.setProperty('--tp', clamp((vh() * 0.6 - r.top) / r.height));
        });

        europes.forEach(function (e) {
          var p = reduce ? 1 : pinProg(e.el);
          e.word.style.setProperty('--e', clamp(p * 1.4));
          drawDots(e, clamp(p * 1.2));
        });

        strikes.forEach(function (s) {
          var r = s.getBoundingClientRect();
          s.style.setProperty('--k', reduce ? 1 : clamp((vh() * 0.7 - r.top) / (vh() * 0.25)));
        });

        ticking = false;
      }

      var mapEl = $('[data-map]');
      if (mapEl) initMap(mapEl, reduce, ctrl.signal);

      function req() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
      window.addEventListener('scroll', req, { passive: true, signal: ctrl.signal });
      window.addEventListener('resize', function () { setHeader(); europes.forEach(sizeCanvas); req(); }, { signal: ctrl.signal });
      setHeader();
      europes.forEach(sizeCanvas);
      frame();
    }

    /* ---------- Rejse-kort: Indonesien → Europa ---------- */
    var MAP = {
      lon0: -30, lat0: 72, step: 1, cols: 200, rows: 87,
      data: '',
      from: [106.8, -6.2],   // Jakarta
      to: [12.35, 55.73]     // Herlev
    };

    function initMap(el, reduce, signal) {
      var cv = el.querySelector('canvas'), ctx = cv.getContext('2d');
      var lblFrom = el.querySelector('[data-from]'), lblTo = el.querySelector('[data-to]');
      if (!MAP.bits) {
        var raw = atob(MAP.data), bits = new Uint8Array(MAP.cols * MAP.rows);
        for (var i = 0; i < bits.length; i++) bits[i] = (raw.charCodeAt(i >> 3) >> (7 - (i & 7))) & 1;
        MAP.bits = bits;
      }
      var W, H, s, ox, oy, dots, base, pts, p0, p2, N = 140;
      var start = null, DUR = 2600, DELAY = 700, raf = 0, visible = true, t = reduce ? 1 : 0;

      function proj(lon, lat) {
        return [ox + ((lon - MAP.lon0) / MAP.step) * s, oy + ((MAP.lat0 - lat) / MAP.step) * s];
      }

      function layout() {
        var r = el.getBoundingClientRect(), d = window.devicePixelRatio || 1;
        W = r.width; H = r.height;
        cv.width = W * d; cv.height = H * d; ctx.setTransform(d, 0, 0, d, 0, 0);
        s = Math.max(W / MAP.cols, H / MAP.rows);
        var fx = ((60 - MAP.lon0) / MAP.step) * s, fy = ((MAP.lat0 - 26) / MAP.step) * s;
        ox = Math.min(0, Math.max(W - MAP.cols * s, W / 2 - fx));
        oy = Math.min(0, Math.max(H - MAP.rows * s, H / 2 - fy));

        p0 = proj(MAP.from[0], MAP.from[1]);
        p2 = proj(MAP.to[0], MAP.to[1]);
        var mx = (p0[0] + p2[0]) / 2, my = (p0[1] + p2[1]) / 2;
        var dx = p2[0] - p0[0], dy = p2[1] - p0[1], len = Math.hypot(dx, dy);
        var nx = dy / len, ny = -dx / len;
        if (ny > 0) { nx = -nx; ny = -ny; }
        var c = [mx + nx * len * 0.28, my + ny * len * 0.28];
        pts = [];
        for (var k = 0; k <= N; k++) {
          var u = k / N, a = (1 - u) * (1 - u), b = 2 * (1 - u) * u, e = u * u;
          pts.push([a * p0[0] + b * c[0] + e * p2[0], a * p0[1] + b * c[1] + e * p2[1]]);
        }

        base = document.createElement('canvas');
        base.width = cv.width; base.height = cv.height;
        var bx = base.getContext('2d'); bx.setTransform(d, 0, 0, d, 0, 0);
        bx.fillStyle = 'rgba(243,239,231,.24)';
        var rad = Math.max(0.9, s * 0.2), reach = s * 3.2;
        dots = [];
        for (var row = 0; row < MAP.rows; row++) {
          for (var col = 0; col < MAP.cols; col++) {
            if (!MAP.bits[row * MAP.cols + col]) continue;
            var x = ox + (col + 0.5) * s, y = oy + (row + 0.5) * s;
            if (x < -s || y < -s || x > W + s || y > H + s) continue;
            bx.beginPath(); bx.arc(x, y, rad, 0, 7); bx.fill();
            var best = 1e9, at = 0;
            for (var q = 0; q <= N; q += 2) {
              var dd = Math.hypot(pts[q][0] - x, pts[q][1] - y);
              if (dd < best) { best = dd; at = q / N; }
            }
            var d0 = Math.hypot(p0[0] - x, p0[1] - y), d2 = Math.hypot(p2[0] - x, p2[1] - y);
            if (best < reach || d0 < s * 7 || d2 < s * 7) dots.push({ x: x, y: y, d: best, at: at, d0: d0, d2: d2 });
          }
        }
        MAP.rad = rad; MAP.reach = reach;

        var lw = lblFrom.offsetWidth;
        lblFrom.style.transform = 'translate(' + Math.min(p0[0] + 18, W - lw - 4) + 'px,' + (p0[1] + 14) + 'px)';
        lblTo.style.transform = 'translate(' + Math.max(4, p2[0] - lblTo.offsetWidth - 18) + 'px,' + (p2[1] - lblTo.offsetHeight - 10) + 'px)';
      }

      function ease(x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; }

      function ring(p, now, phase) {
        var k = ((now / 1800) + phase) % 1;
        ctx.strokeStyle = 'rgba(242,168,29,' + (0.7 * (1 - k)) + ')';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(p[0], p[1], 4 + k * s * 3.5, 0, 7); ctx.stroke();
        ctx.fillStyle = '#ffc94a';
        ctx.beginPath(); ctx.arc(p[0], p[1], 4, 0, 7); ctx.fill();
      }

      function draw(now) {
        if (!reduce) {
          if (start === null) start = now;
          t = ease(Math.min(1, Math.max(0, (now - start - DELAY) / DUR)));
        }
        ctx.clearRect(0, 0, W, H);
        ctx.drawImage(base, 0, 0, W, H);

        // tændte prikker langs ruten og ved start/slut
        var arrived = t >= 0.999;
        dots.forEach(function (p) {
          var a = 0;
          if (p.at <= t && p.d < MAP.reach) a = Math.max(a, 1 - p.d / MAP.reach);
          if (t > 0) a = Math.max(a, (1 - p.d0 / (s * 7)) * 0.9);
          if (arrived) a = Math.max(a, 1 - p.d2 / (s * 7));
          if (a <= 0) return;
          ctx.fillStyle = 'rgba(242,168,29,' + (a * 0.9) + ')';
          ctx.beginPath(); ctx.arc(p.x, p.y, MAP.rad * (1 + a * 0.5), 0, 7); ctx.fill();
        });

        // guldlinjen
        var n = Math.round(t * N);
        if (n > 0) {
          var g = ctx.createLinearGradient(p0[0], p0[1], p2[0], p2[1]);
          g.addColorStop(0, '#e5701a'); g.addColorStop(1, '#ffc94a');
          ctx.save();
          ctx.strokeStyle = g; ctx.lineWidth = 2.5; ctx.lineCap = 'round';
          ctx.shadowColor = 'rgba(242,168,29,.8)'; ctx.shadowBlur = 14;
          ctx.beginPath(); ctx.moveTo(pts[0][0], pts[0][1]);
          for (var i = 1; i <= n; i++) ctx.lineTo(pts[i][0], pts[i][1]);
          ctx.stroke();
          ctx.restore();
          if (!arrived) {
            var h = pts[n], rg = ctx.createRadialGradient(h[0], h[1], 0, h[0], h[1], 22);
            rg.addColorStop(0, 'rgba(255,214,110,.95)'); rg.addColorStop(1, 'rgba(242,168,29,0)');
            ctx.fillStyle = rg; ctx.beginPath(); ctx.arc(h[0], h[1], 22, 0, 7); ctx.fill();
          }
        }

        if (t > 0 || reduce) ring(p0, now, 0);
        if (arrived) ring(p2, now, 0.5);
        lblFrom.classList.toggle('is-on', t > 0.02);
        lblTo.classList.toggle('is-on', arrived);

        if (visible && !signal.aborted && !reduce) raf = requestAnimationFrame(draw);
      }

      layout();
      if (reduce) { draw(0); return; }
      var io = new IntersectionObserver(function (en) {
        visible = en[0].isIntersecting;
        cancelAnimationFrame(raf);
        if (visible) raf = requestAnimationFrame(draw);
      });
      io.observe(el);
      window.addEventListener('resize', function () { layout(); }, { signal: signal });
      signal.addEventListener('abort', function () { io.disconnect(); cancelAnimationFrame(raf); });
    }

    initHundredStory(document.getElementById('hs-{{ section.id }}'));

    if (!window.__hsEditorBound) {
      window.__hsEditorBound = true;
      document.addEventListener('shopify:section:load', function (e) {
        initHundredStory(e.target.querySelector('.hs'));
      });
    }
  })();
</script>

