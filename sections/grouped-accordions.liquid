{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'grouped-accordions.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="grouped-accordions color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="grouped-accordions__layout">
      <div class="grouped-accordions__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="grouped-accordions__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
        {%- endif -%}
      </div>

      <div class="grouped-accordions__items">
        {%- for block in section.blocks -%}
          <div class="grouped-accordions__item accordion" {{ block.shopify_attributes }}>
            <details
              id="Details-{{ block.id }}-{{ section.id }}"
              {% if block.settings.open_by_default %}
                open
              {% endif %}
            >
              <summary id="Summary-{{ block.id }}-{{ section.id }}">
                <div class="summary__title">
                  <h3 class="accordion__title inline-richtext s3_subtitle">
                    {{ block.settings.heading | escape }}
                  </h3>
                </div>
                <span class="accordion__toggle-icons" aria-hidden="true">
                  <span class="accordion__toggle-icon accordion__toggle-icon--plus">
                    {{- 'icon-accordion-plus.svg' | inline_asset_content -}}
                  </span>
                  <span class="accordion__toggle-icon accordion__toggle-icon--minus">
                    {{- 'icon-accordion-minus.svg' | inline_asset_content -}}
                  </span>
                </span>
              </summary>
              <div
                class="accordion__content s3_paragraph rte"
                id="GroupedAccordion-{{ block.id }}-{{ section.id }}"
                role="region"
                aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
              >
                {{ block.settings.content }}
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.grouped-accordions.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.grouped-accordions.settings.heading.label",
      "default": "t:sections.grouped-accordions.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "accordion_row",
      "name": "t:sections.grouped-accordions.blocks.accordion_row.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.grouped-accordions.blocks.accordion_row.settings.heading.label",
          "default": "t:sections.grouped-accordions.blocks.accordion_row.settings.heading.default"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:sections.grouped-accordions.blocks.accordion_row.settings.open_by_default.label",
          "default": false
        },
        {
          "type": "liquid",
          "id": "content",
          "label": "t:sections.grouped-accordions.blocks.accordion_row.settings.content.label",
          "info": "t:sections.grouped-accordions.blocks.accordion_row.settings.content.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.grouped-accordions.presets.name",
      "blocks": [
        {
          "type": "accordion_row"
        },
        {
          "type": "accordion_row"
        },
        {
          "type": "accordion_row"
        },
        {
          "type": "accordion_row"
        }
      ]
    }
  ]
}
{% endschema %}
