>
  <div class="rf-intro" data-finder-intro>
    <div class="rf-hero-image">
      <video
        data-finder-hero-video
        src="https://cdn.shopify.com/videos/c/o/v/eb3279b865394a5abf202ef189be460e.mp4"
        width="1080"
        height="1080"
        aria-label="{{ 'racket_finder.hero_video_label' | t }}"
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
    <div class="rf-intro-copy">
      <h1 class="s3_title" data-finder-heading>
        {% if section.settings.heading != blank -%}
          {{- section.settings.heading | escape -}}
        {%- else -%}
          {{- 'racket_finder.heading' | t -}}
        {%- endif %}
      </h1>
      <p class="s3_paragraph" data-finder-description>
        {% if section.settings.intro != blank -%}
          {{- section.settings.intro | escape -}}
        {%- else -%}
          {{- 'racket_finder.intro' | t -}}
        {%- endif %}
      </p>
      <button type="button" class="button button--primary button--large rf-action" data-finder-start disabled>
        {{ 'racket_finder.start' | t }}
        <span class="rf-icon rf-icon--arrow" aria-hidden="true"></span>
      </button>
      <p class="rf-scope s3_caption">
        {% if section.settings.scope != blank -%}
          {{- section.settings.scope | escape -}}
        {%- else -%}
          {{- 'racket_finder.scope' | t -}}
        {%- endif %}
      </p>
      <p data-finder-error role="alert" hidden>{{ 'racket_finder.error' | t }}</p>
      <noscript>
        <p>{{ 'racket_finder.error' | t }}</p>
      </noscript>
    </div>
  </div>
  <div data-finder-app hidden></div>
  <script type="application/json" data-finder-config>
    {% render 'racket-finder-config', finder_settings: section.settings %}
  </script>
</section>

{% schema %}
{
  "name": "t:racket_finder.name",
  "tag": "section",
  "class": "section-racket-finder",
  "limit": 1,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:racket_finder.heading",
      "default": "t:racket_finder.heading_default"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:racket_finder.intro",
      "default": "t:racket_finder.intro_default"
    },
    {
      "type": "textarea",
      "id": "scope",
      "label": "t:racket_finder.scope",
      "default": "t:racket_finder.scope_default"
    },
    {
      "type": "collection",
      "id": "browse_collection",
      "label": "t:racket_finder.browse_collection",
      "info": "t:racket_finder.browse_collection_info"
    },
    {
      "type": "range",
      "id": "result_limit",
      "label": "t:racket_finder.result_limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "shortlist_reveal",
      "label": "t:racket_finder.shortlist_reveal",
      "info": "t:racket_finder.shortlist_reveal_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:racket_finder.personality_images"
    },
    {
      "type": "url",
      "id": "smash_merchant_image_url",
      "label": "t:racket_finder.smash_merchant_image_url",
      "info": "t:racket_finder.personality_image_info"
    },
    {
      "type": "url",
      "id": "speed_demon_image_url",
      "label": "t:racket_finder.speed_demon_image_url",
      "info": "t:racket_finder.personality_image_info"
    },
    {
      "type": "url",
      "id": "court_chessmaster_image_url",
      "label": "t:racket_finder.court_chessmaster_image_url",
      "info": "t:racket_finder.personality_image_info"
    },
    {
      "type": "url",
      "id": "comeback_kid_image_url",
      "label": "t:racket_finder.comeback_kid_image_url",
      "info": "t:racket_finder.personality_image_info"
    },
    {
      "type": "url",
      "id": "wild_card_image_url",
      "label": "t:racket_finder.wild_card_image_url",
      "info": "t:racket_finder.personality_image_info"
    }
  ],
  "presets": [
    {
      "name": "t:racket_finder.name"
    }
  ]
}
{% endschema %}
