{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign autorotate_delay = section.settings.autorotate_speed | times: 1000
  assign video_autoplay = section.settings.video_autoplay
  assign video_controls = section.settings.video_controls

  assign is_b2b = false
  if customer
    if customer.b2b?
      assign is_b2b = true
    endif
    assign b2b_tag = section.settings.b2b_tag | downcase | strip
    if b2b_tag != blank
      assign customer_tags = customer.tags | join: ',' | downcase
      if customer_tags contains b2b_tag
        assign is_b2b = true
      endif
    endif
  endif

  assign visible_count = 0
  for block in section.blocks
    assign vis = false
    if is_b2b
      if block.settings.show_b2b
        assign vis = true
      endif
    else
      if block.settings.show_b2c
        assign vis = true
      endif
    endif
    if vis
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #ResponsiveSlideshow-{{ section.id }} {
    position: relative;
    display: block;
  }

  #Slider-{{ section.id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #Slider-{{ section.id }}::-webkit-scrollbar {
    height: 0;
    display: none;
  }

  #Slider-{{ section.id }} > .responsive-slideshow__slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    position: relative;
    margin: 0;
    padding: 0;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.aspect_ratio_desktop }};
    overflow: hidden;
    background: {{ section.settings.media_background }};
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media--desktop,
  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media--mobile,
  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__image,
  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media img,
  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media video,
  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_fit }};
    display: block;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media {
      aspect-ratio: {{ section.settings.aspect_ratio_mobile }};
    }

    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media--mobile {
      display: block;
    }

    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__media--desktop.has-mobile-alt {
      display: none;
    }
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 4rem 2.4rem 8rem;
    pointer-events: none;
    z-index: 2;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__heading {
    margin: 0;
    color: inherit;
    line-height: 1.02;
    text-shadow: 0 0.1rem 2rem rgba(0, 0, 0, 0.35);
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__subheading {
    margin: 1rem 0 0;
    color: inherit;
    max-width: 46ch;
    line-height: 1.55;
    text-shadow: 0 0.1rem 1.6rem rgba(0, 0, 0, 0.35);
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__button:hover {
    opacity: 0.85;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__controls {
    position: absolute;
    right: 2.4rem;
    bottom: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 3;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__counter {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    border: 0.1rem solid {{ section.settings.controls_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: {{ section.settings.controls_color }};
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: {{ section.settings.controls_background }};
    color: {{ section.settings.controls_arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow:hover {
    opacity: 0.8;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow--prev svg {
    transform: rotate(90deg);
  }

  #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow--next svg {
    transform: rotate(-90deg);
  }

  @media screen and (max-width: 749px) {
    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__content {
      padding: 3rem 2rem 9rem;
    }

    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__controls {
      right: 1.6rem;
      bottom: 1.6rem;
      gap: 0.8rem;
    }

    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__counter,
    #ResponsiveSlideshow-{{ section.id }} .responsive-slideshow__arrow {
      width: 3.8rem;
      height: 3.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #Slider-{{ section.id }} {
      scroll-behavior: auto;
    }
  }

  {%- for block in section.blocks -%}
    {%- liquid
      assign i = forloop.index

      case block.settings.content_position_vertical
        when 'top'
          assign justify = 'flex-start'
        when 'bottom'
          assign justify = 'flex-end'
        else
          assign justify = 'center'
      endcase

      case block.settings.content_position_horizontal
        when 'left'
          assign align = 'flex-start'
          assign text_align = 'left'
        when 'right'
          assign align = 'flex-end'
          assign text_align = 'right'
        else
          assign align = 'center'
          assign text_align = 'center'
      endcase

      case block.settings.content_position_vertical_mobile
        when 'top'
          assign justify_m = 'flex-start'
        when 'bottom'
          assign justify_m = 'flex-end'
        else
          assign justify_m = 'center'
      endcase

      case block.settings.content_position_horizontal_mobile
        when 'left'
          assign align_m = 'flex-start'
          assign text_align_m = 'left'
        when 'right'
          assign align_m = 'flex-end'
          assign text_align_m = 'right'
        else
          assign align_m = 'center'
          assign text_align_m = 'center'
      endcase
    -%}

    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__content {
      justify-content: {{ justify }};
      align-items: {{ align }};
      text-align: {{ text_align }};
      color: {{ block.settings.text_color }};
    }

    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__heading {
      font-size: {{ block.settings.heading_size_mobile }}px;
      font-weight: {{ block.settings.heading_weight }};
      letter-spacing: {{ block.settings.heading_spacing }}px;
      {% if block.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
      {% if block.settings.heading_italic %}font-style: italic;{% endif %}
      max-width: {{ block.settings.heading_width }}ch;
    }

    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__subheading {
      font-size: {{ block.settings.subheading_size_mobile }}px;
      font-weight: {{ block.settings.subheading_weight }};
      margin-top: {{ block.settings.subheading_space }}px;
    }

    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__button {
      margin-top: {{ block.settings.button_space }}px;
      padding: {{ block.settings.button_padding_y_mobile }}px {{ block.settings.button_padding_x_mobile }}px;
      font-size: {{ block.settings.button_size_mobile }}px;
      font-weight: {{ block.settings.button_weight }};
      letter-spacing: {{ block.settings.button_spacing }}em;
      border-radius: {{ block.settings.button_radius }}px;
      background: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
      border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    }

    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__media img,
    #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__media video {
      object-position: {{ block.settings.focus }};
      transform: scale({{ block.settings.zoom | divided_by: 100.0 }});
    }

    @media screen and (min-width: 750px) {
      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__heading {
        font-size: {{ block.settings.heading_size }}px;
      }

      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__subheading {
        font-size: {{ block.settings.subheading_size }}px;
      }

      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__button {
        padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
        font-size: {{ block.settings.button_size }}px;
      }
    }

    @media screen and (max-width: 749px) {
      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__content {
        justify-content: {{ justify_m }};
        align-items: {{ align_m }};
        text-align: {{ text_align_m }};
      }

      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__media img,
      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__media video {
        object-position: {{ block.settings.focus_mobile }};
        transform: scale({{ block.settings.zoom_mobile | divided_by: 100.0 }});
      }
    }

    {%- if block.settings.overlay_opacity > 0 -%}
      #Slide-{{ section.id }}-{{ i }} .responsive-slideshow__media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
        pointer-events: none;
        z-index: 1;
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div id="ResponsiveSlideshow-{{ section.id }}" class="responsive-slideshow">
  <div class="slider" id="Slider-{{ section.id }}">
    {%- assign rendered = 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign show_slide = false
        if is_b2b
          if block.settings.show_b2b
            assign show_slide = true
          endif
        else
          if block.settings.show_b2c
            assign show_slide = true
          endif
        endif

        if request.design_mode
          assign show_slide = true
        endif
      -%}

      {%- unless show_slide -%}
        {%- continue -%}
      {%- endunless -%}

      {%- assign rendered = rendered | plus: 1 -%}

      <div
        class="responsive-slideshow__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        data-duration="{{ block.settings.duration }}"
        {{ block.shopify_attributes }}
      >
        <div class="responsive-slideshow__media">
          {%- liquid
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image
            assign fallback_image = desktop_image | default: mobile_image
            assign loading = 'lazy'
            assign fetch_priority = 'auto'
            if rendered == 1 and section.index == 1
              assign loading = 'eager'
              assign fetch_priority = 'high'
            endif
          -%}

          {%- if block.settings.video != blank -%}
            <div class="responsive-slideshow__video responsive-slideshow__media--desktop{% if block.settings.mobile_video != blank %} has-mobile-alt{% endif %}">
              {{ block.settings.video | video_tag: image_size: '1100x', autoplay: video_autoplay, loop: true, muted: true, controls: video_controls }}
            </div>
            {%- if block.settings.mobile_video != blank -%}
              <div class="responsive-slideshow__video responsive-slideshow__media--mobile">
                {{ block.settings.mobile_video | video_tag: image_size: '750x', autoplay: video_autoplay, loop: true, muted: true, controls: video_controls }}
              </div>
            {%- endif -%}

          {%- elsif fallback_image -%}
            <picture>
              {%- if mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1500 }} 1500w" sizes="100vw">
              {%- endif -%}
              {{ fallback_image | image_url: width: 3840 | image_tag: class: 'responsive-slideshow__image', loading: loading, fetchpriority: fetch_priority, sizes: '100vw' }}
            </picture>

          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="responsive-slideshow__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="responsive-slideshow__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="responsive-slideshow__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="responsive-slideshow__button">{{ block.settings.button_label | escape }}</a>
            {%- else -%}
              <span class="responsive-slideshow__button" role="link" aria-disabled="true">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if visible_count > 1 or request.design_mode -%}
    <div class="responsive-slideshow__controls">
      {%- if section.settings.show_counter -%}
        <div class="responsive-slideshow__counter">
          <span class="responsive-slideshow__counter-current">1</span>/<span class="responsive-slideshow__counter-total">{{ visible_count }}</span>
        </div>
      {%- endif -%}
      <button type="button" class="responsive-slideshow__arrow responsive-slideshow__arrow--prev" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
      <button type="button" class="responsive-slideshow__arrow responsive-slideshow__arrow--next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var defaultDelay = {{ autorotate_delay }};
    var autorotate = {{ section.settings.autorotate | json }};

    window.responsiveSlideshowTimers = window.responsiveSlideshowTimers || {};

    function initSlideshow() {
      var wrapper = document.getElementById('ResponsiveSlideshow-' + sectionId);
      if (!wrapper) return;

      var slider = document.getElementById('Slider-' + sectionId);
      if (!slider) return;

      var slides = Array.prototype.slice.call(slider.querySelectorAll('.responsive-slideshow__slide'));

      var total = wrapper.querySelector('.responsive-slideshow__counter-total');
      if (total) total.textContent = slides.length;

      if (slides.length < 2) return;

      var prev = wrapper.querySelector('.responsive-slideshow__arrow--prev');
      var next = wrapper.querySelector('.responsive-slideshow__arrow--next');
      var counter = wrapper.querySelector('.responsive-slideshow__counter-current');

      var index = 0;
      var paused = false;
      var syncTimer;

      clearTimeout(window.responsiveSlideshowTimers[sectionId]);

      function goTo(i) {
        index = (i + slides.length) % slides.length;
        slider.scrollTo({ left: slides[index].offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
        if (counter) counter.textContent = index + 1;
      }

      function delayFor(i) {
        var custom = parseFloat(slides[i].dataset.duration);
        return custom > 0 ? custom * 1000 : defaultDelay;
      }

      function schedule() {
        if (!autorotate) return;
        clearTimeout(window.responsiveSlideshowTimers[sectionId]);
        window.responsiveSlideshowTimers[sectionId] = setTimeout(function () {
          if (!paused) goTo(index + 1);
          schedule();
        }, delayFor(index));
      }

      if (prev) prev.addEventListener('click', function () { goTo(index - 1); schedule(); });
      if (next) next.addEventListener('click', function () { goTo(index + 1); schedule(); });

      slider.addEventListener('scroll', function () {
        clearTimeout(syncTimer);
        syncTimer = setTimeout(function () {
          var position = slider.scrollLeft;
          var nearest = 0;
          var best = Infinity;
          slides.forEach(function (slide, i) {
            var distance = Math.abs(slide.offsetLeft - slides[0].offsetLeft - position);
            if (distance < best) { best = distance; nearest = i; }
          });
          index = nearest;
          if (counter) counter.textContent = index + 1;
        }, 120);
      });

      wrapper.addEventListener('mouseenter', function () { paused = true; });
      wrapper.addEventListener('mouseleave', function () { paused = false; });
      wrapper.addEventListener('focusin', function () { paused = true; });
      wrapper.addEventListener('focusout', function () { paused = false; });
      document.addEventListener('visibilitychange', function () { paused = document.hidden; });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) schedule();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlideshow);
    } else {
      initSlideshow();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) initSlideshow();
    });
  })();
</script>

{% schema %}
{
  "name": "Responsive Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "B2B", "info": "Bestemmer hvornår en kunde regnes som B2B. Slides vælges enkeltvis længere nede." },
    { "type": "text", "id": "b2b_tag", "label": "Kundetag for B2B", "default": "B2B", "info": "Kunder med dette tag ser B2B-slides. Bruger du Shopifys indbyggede B2B, virker det også uden tag." },

    { "type": "header", "content": "Format" },
    { "type": "select", "id": "aspect_ratio_desktop", "label": "Format på computer", "options": [{ "value": "21 / 9", "label": "Meget bredt (21:9)" }, { "value": "2 / 1", "label": "Bredt (2:1)" }, { "value": "16 / 9", "label": "Bredformat (16:9)" }, { "value": "3 / 2", "label": "Klassisk (3:2)" }, { "value": "4 / 3", "label": "Liggende (4:3)" }, { "value": "1 / 1", "label": "Kvadratisk (1:1)" }], "default": "16 / 9" },
    { "type": "select", "id": "aspect_ratio_mobile", "label": "Format på mobil", "options": [{ "value": "16 / 9", "label": "Bredformat (16:9)" }, { "value": "4 / 3", "label": "Liggende (4:3)" }, { "value": "1 / 1", "label": "Kvadratisk (1:1)" }, { "value": "4 / 5", "label": "Højformat (4:5)" }, { "value": "3 / 4", "label": "Højformat (3:4)" }, { "value": "9 / 16", "label": "Fuld højde (9:16)" }], "default": "4 / 5" },
    { "type": "select", "id": "media_fit", "label": "Sådan tilpasses billede og video", "options": [{ "value": "cover", "label": "Fyld rammen ud (beskærer kanterne)" }, { "value": "contain", "label": "Vis det hele (kan give kanter)" }], "default": "cover" },
    { "type": "color", "id": "media_background", "label": "Baggrund bag mediet", "default": "#000000", "info": "Ses kun hvis du vælger 'Vis det hele'." },

    { "type": "header", "content": "Automatisk skift" },
    { "type": "checkbox", "id": "autorotate", "label": "Skift slide automatisk", "default": true },
    { "type": "range", "id": "autorotate_speed", "min": 3, "max": 20, "step": 1, "unit": "s", "label": "Sekunder pr. slide", "default": 5 },

    { "type": "header", "content": "Pile og tæller" },
    { "type": "checkbox", "id": "show_counter", "default": true, "label": "Vis tæller" },
    { "type": "color", "id": "controls_color", "default": "#ffffff", "label": "Tællerfarve" },
    { "type": "color", "id": "controls_background", "default": "#ffffff", "label": "Pileknappens baggrund" },
    { "type": "color", "id": "controls_arrow_color", "default": "#000000", "label": "Pilens farve" },

    { "type": "header", "content": "Video" },
    { "type": "checkbox", "id": "video_autoplay", "label": "Afspil videoer automatisk", "info": "Videoer afspilles altid uden lyd. Det er et krav i browsere.", "default": true },
    { "type": "checkbox", "id": "video_controls", "label": "Vis afspilningsknapper", "default": false }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 8,
      "settings": [
        { "type": "header", "content": "Vis denne slide for", "info": "Slå begge til hvis den skal vises for alle. Slår du begge fra, vises den ikke." },
        { "type": "checkbox", "id": "show_b2c", "label": "B2C — almindelige kunder og ikke-loggede", "default": true },
        { "type": "checkbox", "id": "show_b2b", "label": "B2B — kunder med B2B-tag", "default": true },

        { "type": "header", "content": "Billede" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "image_picker", "id": "mobile_image", "label": "Billede til mobil", "info": "Erstatter hovedbilledet på små skærme." },

        { "type": "header", "content": "Video", "info": "Video vises i stedet for billedet, hvis du vælger en." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "video", "id": "mobile_video", "label": "Video til mobil", "info": "Valgfri. Bruges kun på skærme under 750px." },

        { "type": "header", "content": "Beskæring" },
        { "type": "select", "id": "focus", "label": "Fokuspunkt på computer", "options": [{ "value": "center center", "label": "Midten" }, { "value": "center top", "label": "Toppen" }, { "value": "center bottom", "label": "Bunden" }, { "value": "left center", "label": "Venstre" }, { "value": "right center", "label": "Højre" }], "default": "center center" },
        { "type": "select", "id": "focus_mobile", "label": "Fokuspunkt på mobil", "options": [{ "value": "center center", "label": "Midten" }, { "value": "center top", "label": "Toppen" }, { "value": "center bottom", "label": "Bunden" }, { "value": "left center", "label": "Venstre" }, { "value": "right center", "label": "Højre" }], "default": "center center" },
