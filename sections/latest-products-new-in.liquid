{% style %}
  #shopify-section-{{ section.id }} .latest-products-new-in {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    min-height: {{ section.settings.section_height }}px;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__inner {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1;
    font-weight: 800;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__link {
    color: {{ section.settings.heading_color }};
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__link:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__grid {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat({{ section.settings.products_per_row }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__product {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__watermark {
    position: absolute;
    z-index: 1;
    left: {{ section.settings.watermark_left }}px;
    bottom: {{ section.settings.watermark_bottom }}px;

    margin: 0;

    color: {{ section.settings.watermark_color }};
    opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};

    font-size: clamp(
      100px,
      {{ section.settings.watermark_size }}vw,
      300px
    );

    line-height: 0.72;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.07em;
    text-transform: uppercase;

    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .latest-products-new-in__empty {
    position: relative;
    z-index: 3;
    color: {{ section.settings.heading_color }};
    padding: 30px 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .latest-products-new-in {
      min-height: {{ section.settings.section_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__watermark {
      left: {{ section.settings.watermark_left_mobile }}px;
      bottom: {{ section.settings.watermark_bottom_mobile }}px;
      font-size: clamp(75px, {{ section.settings.watermark_size_mobile }}vw, 190px);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .latest-products-new-in {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__inner {
      padding-left: 14px;
      padding-right: 14px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__header {
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .latest-products-new-in__link {
      font-size: 12px;
    }
  }
{% endstyle %}

<section class="latest-products-new-in">

  <div class="latest-products-new-in__watermark">
    {{ section.settings.watermark_text }}
  </div>

  <div class="latest-products-new-in__inner">

    {% if section.settings.heading != blank %}
      <div class="latest-products-new-in__header">

        <h2 class="latest-products-new-in__heading">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.show_collection_link
          and section.settings.collection != blank
        %}
          <a
            href="{{ section.settings.collection.url }}"
            class="latest-products-new-in__link"
          >
            {{ section.settings.collection_link_text }}
          </a>
        {% endif %}

      </div>
    {% endif %}

    {% if section.settings.collection != blank %}

      <div class="latest-products-new-in__grid">

        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}

          <div class="latest-products-new-in__product">

            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: 'default',
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              lazy_load: true,
              section_id: section.id,
              quick_add: section.settings.quick_add
            %}

          </div>

        {% endfor %}

      </div>

    {% else %}

      <div class="latest-products-new-in__empty">
        Vælg en kollektion i sektionens indstillinger.
      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Latest Products – New In",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Produkter"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Vælg produktkollektion"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Antal produkter"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Produkter pr. række – desktop"
    },

    {
      "type": "header",
      "content": "Overskrift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "LATEST PRODUCTS"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 38,
      "label": "Overskrift størrelse – desktop"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 45,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Overskrift størrelse – mobil"
    },
    {
      "type": "checkbox",
      "id": "show_collection_link",
      "default": true,
      "label": "Vis link til hele kollektionen"
    },
    {
      "type": "text",
      "id": "collection_link_text",
      "default": "SHOP ALL",
      "label": "Tekst på kollektionslink"
    },

    {
      "type": "header",
      "content": "NEW IN baggrundstekst"
    },
    {
      "type": "text",
      "id": "watermark_text",
      "default": "NEW IN",
      "label": "Stor baggrundstekst"
    },
    {
      "type": "range",
      "id": "watermark_size",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "vw",
      "default": 20,
      "label": "Størrelse – desktop"
    },
    {
      "type": "range",
      "id": "watermark_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "vw",
      "default": 40,
      "label": "Størrelse – mobil"
    },
    {
      "type": "range",
      "id": "watermark_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20,
      "label": "Gennemsigtighed"
    },
    {
      "type": "range",
      "id": "watermark_left",
      "min": -200,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": -40,
      "label": "Placering fra venstre – desktop"
    },
    {
      "type": "range",
      "id": "watermark_bottom",
      "min": -100,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 0,
      "label": "Placering fra bunden – desktop"
    },
    {
      "type": "range",
      "id": "watermark_left_mobile",
      "min": -150,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": -30,
      "label": "Placering fra venstre – mobil"
    },
    {
      "type": "range",
      "id": "watermark_bottom_mobile",
      "min": -100,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 0,
      "label": "Placering fra bunden – mobil"
    },

    {
      "type": "header",
      "content": "Farver"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "default": "#F26616"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Tekstfarve",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "watermark_color",
      "label": "NEW IN farve",
      "default": "#A94716"
    },

    {
      "type": "header",
      "content": "Højde og afstand"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 600,
      "label": "Minimum højde – desktop"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "min": 250,
      "max": 900,
      "step": 25,
      "unit": "px",
      "default": 500,
      "label": "Minimum højde – mobil"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50,
      "label": "Afstand øverst – desktop"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80,
      "label": "Afstand nederst – desktop"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35,
      "label": "Afstand øverst – mobil"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60,
      "label": "Afstand nederst – mobil"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Afstand mellem produkter"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400,
      "label": "Maksimal bredde"
    },

    {
      "type": "header",
      "content": "Produktkort"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Tilpas til billede"
        },
        {
          "value": "portrait",
          "label": "Portræt"
        },
        {
          "value": "square",
          "label": "Kvadrat"
        }
      ],
      "default": "adapt",
      "label": "Billedformat"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Vis andet billede ved hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Vis brand"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Vis rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick add",
      "options": [
        {
          "value": "none",
          "label": "Fra"
        },
        {
          "value": "standard",
          "label": "Til"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Latest Products – New In"
    }
  ]
}
{% endschema %}