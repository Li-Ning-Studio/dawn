{% style %}
  #shopify-section-{{ section.id }} .bold-newin {
    --bg: {{ section.settings.background_color }};
    --text: {{ section.settings.text_color }};
    --accent: {{ section.settings.accent_color }};
    --card-radius: {{ section.settings.card_radius }}px;

    position: relative;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .bold-newin__inner {
    width: min({{ section.settings.max_width }}px, calc(100% - 40px));
    margin: 0 auto;

    display: grid;
    grid-template-columns:
      {{ section.settings.hero_width }}fr
      {{ 100 | minus: section.settings.hero_width }}fr;

    gap: {{ section.settings.column_gap }}px;
    align-items: center;
  }


  /* =========================
     LEFT HERO
  ========================== */

  #shopify-section-{{ section.id }} .bold-newin__hero {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .bold-newin__eyebrow {
    margin: 0 0 8px;

    color: var(--text);

    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.2;

    text-transform: uppercase;
  }


  #shopify-section-{{ section.id }} .bold-newin__title {
    margin: 0;

    color: var(--text);

    font-size: clamp(
      64px,
      {{ section.settings.title_size }}vw,
      170px
    );

    line-height: 0.78;
    letter-spacing: -0.07em;

    font-weight: 900;
    font-style: italic;

    text-transform: uppercase;
  }


  #shopify-section-{{ section.id }} .bold-newin__title span {
    display: block;
    color: var(--accent);
  }


  #shopify-section-{{ section.id }} .bold-newin__subtitle {
    max-width: 300px;

    margin-top: 24px;
    margin-bottom: 0;

    color: var(--text);

    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.35;
  }


  #shopify-section-{{ section.id }} .bold-newin__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    margin-top: 28px;

    padding: 14px 22px;

    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};

    border-radius: 999px;

    text-decoration: none;
    text-transform: uppercase;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .bold-newin__button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }


  #shopify-section-{{ section.id }} .bold-newin__button-arrow {
    font-size: 18px;
    line-height: 1;
  }


  /* =========================
     PRODUCTS
  ========================== */

  #shopify-section-{{ section.id }} .bold-newin__products-wrap {
    min-width: 0;
  }


  #shopify-section-{{ section.id }} .bold-newin__top {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    margin-bottom: 16px;
  }


  #shopify-section-{{ section.id }} .bold-newin__shop-all {
    color: var(--text);
    text-decoration: none;

    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;

    text-transform: uppercase;
  }


  #shopify-section-{{ section.id }} .bold-newin__shop-all:hover {
    text-decoration: underline;
  }


  #shopify-section-{{ section.id }} .bold-newin__products {
    display: grid;

    grid-template-columns:
      repeat({{ section.settings.products_per_row }}, minmax(0, 1fr));

    gap: {{ section.settings.product_gap }}px;
  }


  #shopify-section-{{ section.id }} .bold-newin__item {
    min-width: 0;
  }


  /* Image container */
  #shopify-section-{{ section.id }} .bold-newin__image-box {
    position: relative;

    overflow: hidden;

    background: {{ section.settings.product_image_background }};
    border-radius: var(--card-radius);

    aspect-ratio: {{ section.settings.image_ratio }};
  }


  #shopify-section-{{ section.id }} .bold-newin__image-box img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    transition: transform 0.35s ease;
  }


  #shopify-section-{{ section.id }} .bold-newin__item:hover
  .bold-newin__image-box img {
    transform: scale(1.035);
  }


  /* optional badge */
  #shopify-section-{{ section.id }} .bold-newin__badge {
    position: absolute;

    top: 12px;
    left: 12px;

    z-index: 2;

    padding: 7px 10px;

    background: var(--accent);
    color: #ffffff;

    border-radius: 999px;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;

    text-transform: uppercase;
  }


  #shopify-section-{{ section.id }} .bold-newin__product-info {
    padding-top: 14px;
  }


  #shopify-section-{{ section.id }} .bold-newin__product-title {
    margin: 0;

    color: var(--text);

    font-size: {{ section.settings.product_title_size }}px;
    font-weight: 500;
    line-height: 1.25;
  }


  #shopify-section-{{ section.id }} .bold-newin__product-title a {
    color: inherit;
    text-decoration: none;
  }


  #shopify-section-{{ section.id }} .bold-newin__price {
    margin-top: 7px;

    color: var(--text);

    font-size: {{ section.settings.price_size }}px;
    font-weight: 600;
  }


  #shopify-section-{{ section.id }} .bold-newin__compare-price {
    margin-left: 7px;

    opacity: 0.5;

    text-decoration: line-through;

    font-weight: 400;
  }


  /* =========================
     DECORATIVE GLOW
  ========================== */

#shopify-section-{{ section.id }} .bold-newin__glow {
  position: absolute;
  pointer-events: none;
  z-index: 0;

  width: 900px;
  height: 600px;

  left: -180px;
  top: 50%;
  transform: translateY(-50%);

  background: radial-gradient(
    ellipse at center,
    {{ section.settings.glow_color }} 0%,
    {{ section.settings.glow_color }} 10%,
    rgba(255, 160, 1, 0.55) 28%,
    rgba(255, 120, 0, 0.28) 45%,
    rgba(255, 90, 0, 0.10) 58%,
    transparent 75%
  );

  opacity: {{ section.settings.glow_opacity | divided_by: 100.0 }};
  filter: blur(55px);
}


  /* =========================
     TABLET
  ========================== */

  @media screen and (max-width: 1100px) {

    #shopify-section-{{ section.id }} .bold-newin__inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    #shopify-section-{{ section.id }} .bold-newin__hero {
      max-width: 620px;
    }

    #shopify-section-{{ section.id }} .bold-newin__title {
      font-size: clamp(70px, 14vw, 140px);
    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .bold-newin {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }


    #shopify-section-{{ section.id }} .bold-newin__inner {
      width: calc(100% - 28px);

      gap: 32px;
    }


    #shopify-section-{{ section.id }} .bold-newin__eyebrow {
      font-size: 11px;
    }


    #shopify-section-{{ section.id }} .bold-newin__title {
      font-size: clamp(62px, 22vw, 105px);
    }


    #shopify-section-{{ section.id }} .bold-newin__subtitle {
      margin-top: 18px;
    }


    #shopify-section-{{ section.id }} .bold-newin__button {
      margin-top: 20px;
    }


    #shopify-section-{{ section.id }} .bold-newin__top {
      display: none;
    }


    #shopify-section-{{ section.id }} .bold-newin__products {
      display: flex;

      overflow-x: auto;

      gap: 12px;

      scroll-snap-type: x mandatory;

      padding-bottom: 8px;

      scrollbar-width: none;
    }


    #shopify-section-{{ section.id }} .bold-newin__products::-webkit-scrollbar {
      display: none;
    }


    #shopify-section-{{ section.id }} .bold-newin__item {
      flex: 0 0 72%;

      scroll-snap-align: start;
    }


    #shopify-section-{{ section.id }} .bold-newin__image-box {
      border-radius: 8px;
    }

  }
{% endstyle %}


<section class="bold-newin">

  <div class="bold-newin__glow"></div>


  <div class="bold-newin__inner">


    <!-- LEFT -->
    <div class="bold-newin__hero">

      {% if section.settings.eyebrow != blank %}
        <p class="bold-newin__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      <h2 class="bold-newin__title">

        {{ section.settings.title_line_1 }}

        {% if section.settings.title_line_2 != blank %}
          <span>
            {{ section.settings.title_line_2 }}
          </span>
        {% endif %}

      </h2>


      {% if section.settings.subtitle != blank %}

        <div class="bold-newin__subtitle">
          {{ section.settings.subtitle }}
        </div>

      {% endif %}


      {% if section.settings.collection != blank %}

        <a
          href="{{ section.settings.collection.url }}"
          class="bold-newin__button"
        >

          {{ section.settings.button_text_label }}

          <span class="bold-newin__button-arrow">
            →
          </span>

        </a>

      {% endif %}

    </div>



    <!-- RIGHT PRODUCTS -->
    <div class="bold-newin__products-wrap">

      {% if section.settings.show_shop_all %}
        <div class="bold-newin__top">

          {% if section.settings.collection != blank %}
            <a
              href="{{ section.settings.collection.url }}"
              class="bold-newin__shop-all"
            >
              {{ section.settings.shop_all_text }} →
            </a>
          {% endif %}

        </div>
      {% endif %}


      <div class="bold-newin__products">

        {% if section.settings.collection != blank %}

          {% for product in section.settings.collection.products
            limit: section.settings.products_to_show
          %}

            <article class="bold-newin__item">

              <a href="{{ product.url }}">

                <div class="bold-newin__image-box">

                  {% if section.settings.show_new_badge %}
                    <span class="bold-newin__badge">
                      New
                    </span>
                  {% endif %}


                  {% if product.featured_image %}

                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 400, 500, 600, 800',
                        sizes: '(min-width: 1100px) 18vw, 70vw'
                    }}

                  {% endif %}

                </div>

              </a>


              <div class="bold-newin__product-info">

                <h3 class="bold-newin__product-title">

                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>

                </h3>


                <div class="bold-newin__price">

                  {{ product.price | money }}

                  {% if product.compare_at_price > product.price %}

                    <span class="bold-newin__compare-price">
                      {{ product.compare_at_price | money }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </article>

          {% endfor %}


        {% else %}

          {% for i in (1..4) %}

            <div class="bold-newin__item">

              <div class="bold-newin__image-box">
                {{ 'product-' | append: i | placeholder_svg_tag }}
              </div>

              <div class="bold-newin__product-info">

                <p class="bold-newin__product-title">
                  Product name
                </p>

                <div class="bold-newin__price">
                  €40,00 EUR
                </div>

              </div>

            </div>

          {% endfor %}

        {% endif %}

      </div>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Latest - Bold Hero",
  "tag": "section",
  "class": "section",
  "settings": [

    {
      "type": "header",
      "content": "Products"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },

    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Products per row"
    },

    {
      "type": "range",
      "id": "product_gap",
      "min": 5,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Space between products"
    },


    {
      "type": "header",
      "content": "Hero text"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "LATEST PRODUCTS"
    },

    {
      "type": "text",
      "id": "title_line_1",
      "label": "Big heading line 1",
      "default": "NEW"
    },

    {
      "type": "text",
      "id": "title_line_2",
      "label": "Big heading line 2",
      "default": "IN"
    },

    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Text",
      "default": "Fresh gear.\nHigher performance."
    },

    {
      "type": "text",
      "id": "button_text_label",
      "label": "Button text",
      "default": "SHOP ALL"
    },


    {
      "type": "header",
      "content": "Text sizes"
    },

    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Small heading size"
    },

    {
      "type": "range",
      "id": "title_size",
      "min": 5,
      "max": 12,
      "step": 0.5,
      "unit": "vw",
      "default": 8,
      "label": "NEW IN size"
    },

    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Description size"
    },

    {
      "type": "range",
      "id": "product_title_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "Product title size"
    },

    {
      "type": "range",
      "id": "price_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Price size"
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#080808"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF5A00"
    },

    {
      "type": "color",
      "id": "product_image_background",
      "label": "Product image background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#FF5A00"
    },


    {
      "type": "header",
      "content": "Design"
    },

    {
      "type": "range",
      "id": "hero_width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 28,
      "label": "Hero width"
    },

    {
      "type": "range",
      "id": "column_gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40,
      "label": "Space between hero and products"
    },

    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "Product image corners"
    },

    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "default": "1 / 1.15",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "1 / 1.15",
          "label": "Slight portrait"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        }
      ]
    },

    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "Show NEW badge",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop all above products",
      "default": true
    },

    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop all text",
      "default": "SHOP ALL"
    },


    {
      "type": "header",
      "content": "Orange glow"
    },

    {
      "type": "range",
      "id": "glow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25,
      "label": "Glow strength"
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1600,
      "label": "Maximum width"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70,
      "label": "Top spacing"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70,
      "label": "Bottom spacing"
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45,
      "label": "Mobile top spacing"
    },

    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45,
      "label": "Mobile bottom spacing"
    }

  ],

  "presets": [
    {
      "name": "Latest - Bold Hero"
    }
  ]
}
{% endschema %}