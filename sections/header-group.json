    "custom_liquid_KgqgwG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"nn-bar\" id=\"nnBar\" data-phase=\"pre\" data-urgent=\"false\">\n\n  <div class=\"nn-bar__texture\"></div>\n  <div class=\"nn-bar__glow\"></div>\n\n  <div class=\"nn-bar__inner\">\n\n    <!-- SALE NAME + STATUS -->\n    <div class=\"nn-bar__head\">\n      <div class=\"nn-bar__event\">\n        <span class=\"nn-bar__title\" id=\"nnTitle\">NOW OR NEVER</span>\n        <span class=\"nn-bar__spark\">✦</span>\n      </div>\n      <div class=\"nn-bar__status\">\n        <span class=\"nn-bar__dot\"></span>\n        <span class=\"nn-bar__status-text\" id=\"nnStatus\">STARTS IN</span>\n      </div>\n    </div>\n\n    <!-- TIMER -->\n    <div class=\"nn-bar__timer\" id=\"nnTimer\" aria-hidden=\"true\">\n      <div class=\"nn-bar__unit\" id=\"nnDaysWrap\">\n        <div class=\"nn-bar__box\"><strong id=\"nnDays\">00</strong></div>\n        <span>DAYS</span>\n      </div>\n      <div class=\"nn-bar__colon\" id=\"nnDaysColon\">:</div>\n\n      <div class=\"nn-bar__unit\">\n        <div class=\"nn-bar__box\"><strong id=\"nnHours\">00</strong></div>\n        <span>HOURS</span>\n      </div>\n      <div class=\"nn-bar__colon\">:</div>\n\n      <div class=\"nn-bar__unit\">\n        <div class=\"nn-bar__box\"><strong id=\"nnMinutes\">00</strong></div>\n        <span>MINUTES</span>\n      </div>\n      <div class=\"nn-bar__colon\">:</div>\n\n      <div class=\"nn-bar__unit\">\n        <div class=\"nn-bar__box\"><strong id=\"nnSeconds\">00</strong></div>\n        <span>SECONDS</span>\n      </div>\n    </div>\n\n    <!-- CTA -->\n    <a href=\"https://in.hndrd.co/pages/now-or-never-pre-sale\" class=\"nn-cta\" id=\"nnCta\">\n      <span class=\"nn-cta__shine\"></span>\n      <span class=\"nn-cta__text\" id=\"nnCtaText\">GET EARLY ACCESS</span>\n      <span class=\"nn-cta__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M5 12h13M13 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </span>\n    </a>\n\n  </div>\n\n  <!-- SALE PROGRESS RAIL (live only) -->\n  <div class=\"nn-bar__rail\"><span id=\"nnRail\"></span></div>\n\n</section>\n\n\n<style>\n/* ========================================================\n   TOKENS\n======================================================== */\n.nn-bar {\n  --nn-yellow: #fff500;\n  --nn-ink: #2a003d;\n  --nn-white: #ffffff;\n  --nn-ease: cubic-bezier(.2,.8,.2,1);\n\n  width: 100%;\n  min-height: 92px;\n  position: relative;\n  overflow: hidden;\n  color: var(--nn-white);\n  background:\n    radial-gradient(circle at 50% -110%, rgba(255,255,255,.24) 0%, rgba(255,255,255,0) 55%),\n    linear-gradient(105deg, #8500d7 0%, #a800ee 30%, #cf00fc 63%, #ed00ff 100%);\n}\n\n.nn-bar *,\n.nn-bar *::before,\n.nn-bar *::after { box-sizing: border-box; }\n\n.nn-bar::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 1px;\n  background: rgba(255,255,255,.35);\n}\n\n.nn-bar__texture {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: .10;\n  background-image: radial-gradient(circle, rgba(255,255,255,.6) 1px, transparent 1px);\n  background-size: 24px 24px;\n  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 72%, transparent 100%);\n  mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 72%, transparent 100%);\n}\n\n.nn-bar__glow {\n  position: absolute;\n  top: -60%;\n  right: 8%;\n  width: 380px;\n  height: 220%;\n  pointer-events: none;\n  opacity: 0;\n  background: radial-gradient(closest-side, rgba(255,245,0,.22), transparent);\n  transition: opacity .6s ease;\n}\n.nn-bar[data-phase=\"live\"] .nn-bar__glow { opacity: 1; }\n\n/* ========================================================\n   LAYOUT\n======================================================== */\n.nn-bar__inner {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  max-width: 1180px;\n  min-height: 92px;\n  margin: 0 auto;\n  padding: 12px 22px 14px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 40px;\n}\n\n/* ========================================================\n   HEAD: NAME + STATUS\n======================================================== */\n.nn-bar__head {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 9px;\n  flex-shrink: 0;\n  padding-right: 20px; /* room for the star on desktop */\n}\n\n.nn-bar__event {\n  position: relative;\n  display: flex;\n  align-items: center;\n  white-space: nowrap;\n  font-family: inherit;\n  font-size: 18px;\n  line-height: 1;\n  font-weight: 800;\n  letter-spacing: .08em;\n  color: var(--nn-yellow);\n}\n\n/* cancels the trailing letter-spacing so text sits truly centered */\n.nn-bar__title { margin-right: -.08em; }\n\n/* star sits outside the text so it never pushes the title off-center */\n.nn-bar__spark {\n  position: absolute;\n  left: 100%;\n  top: 50%;\n  margin-left: 8px;\n  font-size: 13px;\n  line-height: 1;\n  letter-spacing: 0;\n  transform: translateY(-50%);\n  animation: nnSpark 2.3s ease-in-out infinite;\n}\n@keyframes nnSpark {\n  0%, 100% { opacity: .55; transform: translateY(-50%) scale(.85) rotate(0deg); }\n  50%      { opacity: 1;   transform: translateY(-50%) scale(1.15) rotate(45deg); }\n}\n\n.nn-bar__status {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 11px 5px 9px;\n  border-radius: 999px;\n  background: rgba(42,0,61,.28);\n  border: 1px solid rgba(255,255,255,.16);\n  font-family: inherit;\n  font-size: 9px;\n  line-height: 1;\n  font-weight: 750;\n  letter-spacing: .16em;\n  white-space: nowrap;\n  color: var(--nn-white);\n}\n.nn-bar__status-text { margin-right: -.16em; }\n\n.nn-bar__dot {\n  position: relative;\n  flex-shrink: 0;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: rgba(255,255,255,.75);\n}\n\n.nn-bar[data-phase=\"live\"] .nn-bar__dot { background: var(--nn-yellow); }\n.nn-bar[data-phase=\"live\"] .nn-bar__dot::after {\n  content: \"\";\n  position: absolute;\n  inset: -4px;\n  border-radius: 50%;\n  border: 1.5px solid var(--nn-yellow);\n  animation: nnPing 1.6s var(--nn-ease) infinite;\n}\n.nn-bar[data-urgent=\"true\"] .nn-bar__dot::after { animation-duration: .9s; }\n\n@keyframes nnPing {\n  0%   { transform: scale(.6); opacity: .9; }\n  100% { transform: scale(2);  opacity: 0; }\n}\n\n/* ========================================================\n   TIMER\n======================================================== */\n.nn-bar__timer {\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 11px;\n  flex-shrink: 0;\n}\n\n.nn-bar__unit {\n  width: 82px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.nn-bar__box {\n  position: relative;\n  width: 100%;\n  height: 52px;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 13px;\n  background: linear-gradient(145deg, rgba(255,255,255,.23), rgba(255,255,255,.13));\n  border: 1px solid rgba(255,255,255,.10);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.17), 0 7px 20px rgba(60,0,100,.10);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  transition: border-color .4s ease, box-shadow .4s ease;\n}\n\n.nn-bar__box::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 12%; right: 12%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.52), transparent);\n}\n\n.nn-bar__unit strong {\n  position: relative;\n  z-index: 2;\n  display: block;\n  font-family: inherit;\n  font-size: 30px;\n  line-height: 1;\n  font-weight: 750;\n  color: var(--nn-white);\n  font-variant-numeric: tabular-nums;\n  transition: opacity .16s ease, transform .16s var(--nn-ease), color .4s ease;\n}\n\n.nn-bar__unit strong.nn-tick {\n  opacity: .3;\n  transform: translateY(-4px);\n}\n\n.nn-bar__unit > span {\n  display: block;\n  width: 100%;\n  margin-top: 7px;\n  text-align: center;\n  font-family: inherit;\n  font-size: 8px;\n  line-height: 1;\n  font-weight: 550;\n  letter-spacing: .09em;\n  padding-left: .09em; /* balances trailing letter-spacing */\n  white-space: nowrap;\n  color: rgba(255,255,255,.9);\n}\n\n.nn-bar__colon {\n  min-width: 7px;\n  height: 52px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding-bottom: 3px; /* colon glyph sits low in most fonts */\n  font-family: inherit;\n  font-size: 24px;\n  line-height: 1;\n  font-weight: 700;\n  color: var(--nn-white);\n}\n\n.nn-bar[data-urgent=\"true\"] .nn-bar__box {\n  border-color: rgba(255,245,0,.55);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.17), 0 0 18px rgba(255,245,0,.18);\n}\n.nn-bar[data-urgent=\"true\"] .nn-bar__unit strong { color: var(--nn-yellow); }\n\n.nn-bar__unit.nn-hide,\n.nn-bar__colon.nn-hide { display: none; }\n\n/* ========================================================\n   CTA\n======================================================== */\n.nn-cta {\n  position: relative;\n  min-height: 46px;\n  padding: 0 6px 0 24px;\n  display: inline-flex;\n  align-items: center;\n  gap: 14px;\n  flex-shrink: 0;\n  border-radius: 999px;\n  background: var(--nn-yellow);\n  color: var(--nn-ink);\n  text-decoration: none;\n  white-space: nowrap;\n  font-family: inherit;\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 900;\n  letter-spacing: .12em;\n  box-shadow:\n    inset 0 -2px 0 rgba(42,0,61,.14),\n    0 8px 22px rgba(56,0,90,.22);\n  transition: transform .35s var(--nn-ease), box-shadow .35s ease, background .35s ease;\n}\n\n.nn-cta::before {\n  content: \"\";\n  position: absolute;\n  inset: -5px;\n  border-radius: inherit;\n  border: 1.5px solid rgba(255,245,0,.7);\n  opacity: 0;\n  pointer-events: none;\n}\n.nn-bar[data-phase=\"live\"] .nn-cta::before {\n  animation: nnRing 2.4s var(--nn-ease) infinite;\n}\n@keyframes nnRing {\n  0%   { transform: scale(.96); opacity: .8; }\n  100% { transform: scale(1.14, 1.4); opacity: 0; }\n}\n\n.nn-cta__shine {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  overflow: hidden;\n  pointer-events: none;\n}\n.nn-cta__shine::before {\n  content: \"\";\n  position: absolute;\n  top: 0; bottom: 0;\n  left: -40%;\n  width: 30%;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.85), transparent);\n  transform: skewX(-20deg);\n  animation: nnSweep 3.6s var(--nn-ease) infinite;\n}\n@keyframes nnSweep {\n  0%, 55% { left: -40%; }\n  100%    { left: 130%; }\n}\n\n.nn-cta__text {\n  position: relative;\n  z-index: 2;\n  margin-right: -.12em; /* balances trailing letter-spacing */\n}\n\n.nn-cta__icon {\n  position: relative;\n  z-index: 2;\n  flex-shrink: 0;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  background: var(--nn-ink);\n  color: var(--nn-yellow);\n  transition: transform .35s var(--nn-ease), background .35s ease;\n}\n.nn-cta__icon svg {\n  display: block;\n  width: 15px;\n  height: 15px;\n}\n\n.nn-cta:hover {\n  background: var(--nn-white);\n  transform: translateY(-2px);\n  box-shadow:\n    inset 0 -2px 0 rgba(42,0,61,.10),\n    0 12px 32px rgba(255,245,0,.38);\n}\n.nn-cta:hover .nn-cta__icon { transform: scale(1.06); background: #8500d7; color: var(--nn-white); }\n.nn-cta:hover .nn-cta__icon svg { animation: nnArrow .55s var(--nn-ease); }\n@keyframes nnArrow {\n  0%   { transform: translateX(0); }\n  45%  { transform: translateX(20px); }\n  46%  { transform: translateX(-20px); }\n  100% { transform: translateX(0); }\n}\n\n.nn-cta:active { transform: translateY(0) scale(.98); }\n\n.nn-cta:focus-visible {\n  outline: 2px solid var(--nn-white);\n  outline-offset: 4px;\n}\n\n/* ========================================================\n   PROGRESS RAIL\n======================================================== */\n.nn-bar__rail {\n  position: absolute;\n  left: 0; right: 0; bottom: 0;\n  height: 3px;\n  z-index: 3;\n  background: rgba(42,0,61,.25);\n  display: none;\n}\n.nn-bar__rail span {\n  display: block;\n  height: 100%;\n  width: 100%;\n  transform-origin: left center;\n  background: linear-gradient(90deg, var(--nn-yellow), #ffffff);\n  box-shadow: 0 0 10px rgba(255,245,0,.6);\n  transition: transform 1s linear;\n}\n.nn-bar[data-phase=\"live\"] .nn-bar__rail { display: block; }\n\n/* ========================================================\n   ENDED\n======================================================== */\n.nn-bar[data-phase=\"ended\"] .nn-bar__timer,\n.nn-bar[data-phase=\"ended\"] .nn-cta { display: none; }\n.nn-bar[data-phase=\"ended\"] .nn-bar__head { align-items: center; }\n\n/* ========================================================\n   TABLET\n======================================================== */\n@media (max-width: 950px) and (min-width: 651px) {\n  .nn-bar__inner { gap: 20px; padding-left: 12px; padding-right: 12px; }\n  .nn-bar__event { font-size: 13px; }\n  .nn-bar__spark { font-size: 10px; margin-left: 6px; }\n  .nn-bar__head { padding-right: 16px; }\n  .nn-bar__status { font-size: 8px; }\n  .nn-bar__timer { gap: 7px; }\n  .nn-bar__unit { width: 62px; }\n  .nn-bar__box { height: 45px; }\n  .nn-bar__unit strong { font-size: 24px; }\n  .nn-bar__colon { height: 45px; font-size: 19px; }\n  .nn-cta { min-height: 40px; padding: 0 5px 0 16px; gap: 10px; font-size: 9px; }\n  .nn-cta__icon { width: 30px; height: 30px; }\n}\n\n/* ========================================================\n   MOBILE: name+status / timer / CTA  (all on one centre line)\n======================================================== */\n@media (max-width: 650px) {\n  .nn-bar { min-height: 196px; }\n\n  .nn-bar__inner {\n    min-height: 196px;\n    padding: 16px 10px 18px;\n    flex-direction: column;\n    gap: 14px;\n  }\n\n  .nn-bar__head { align-items: center; gap: 9px; padding-right: 0; }\n  .nn-bar__event { font-size: 15px; letter-spacing: .12em; }\n  .nn-bar__title { margin-right: -.12em; }\n  .nn-bar__spark { font-size: 10px; margin-left: 7px; }\n  .nn-bar__status { font-size: 8px; padding: 4px 10px 4px 8px; }\n\n  .nn-bar__timer { gap: 7px; }\n  .nn-bar__unit { width: 60px; }\n  .nn-bar__box { height: 46px; border-radius: 11px; }\n  .nn-bar__unit strong { font-size: 24px; }\n  .nn-bar__unit > span { margin-top: 6px; font-size: 6.5px; letter-spacing: .07em; padding-left: .07em; }\n  .nn-bar__colon { min-width: 5px; height: 46px; font-size: 19px; }\n\n  /* CTA: same width as the timer, text dead-centre, arrow pinned right */\n  .nn-cta {\n    width: 100%;\n    max-width: 218px;\n    min-height: 44px;\n    justify-content: center;\n    padding: 0 44px;\n    font-size: 10px;\n  }\n  .nn-cta__icon {\n    position: absolute;\n    right: 5px;\n    top: 50%;\n    width: 34px;\n    height: 34px;\n    transform: translateY(-50%);\n  }\n  .nn-cta:hover .nn-cta__icon { transform: translateY(-50%) scale(1.06); }\n\n  .nn-bar__glow { right: 50%; transform: translateX(50%); top: 40%; height: 120%; }\n\n  .nn-bar[data-phase=\"ended\"] { min-height: 70px; }\n  .nn-bar[data-phase=\"ended\"] .nn-bar__inner { min-height: 70px; padding: 12px 10px; }\n}\n\n@media (max-width: 400px) {\n  .nn-bar, .nn-bar__inner { min-height: 186px; }\n  .nn-bar__inner { padding: 14px 6px 16px; gap: 12px; }\n  .nn-bar__event { font-size: 13px; letter-spacing: .10em; }\n  .nn-bar__title { margin-right: -.10em; }\n  .nn-bar__timer { gap: 5px; }\n  .nn-bar__unit { width: 54px; }\n  .nn-bar__box { height: 42px; border-radius: 9px; }\n  .nn-bar__unit strong { font-size: 22px; }\n  .nn-bar__unit > span { margin-top: 5px; font-size: 6px; }\n  .nn-bar__colon { min-width: 4px; height: 42px; font-size: 17px; }\n  .nn-cta { max-width: 200px; min-height: 42px; padding: 0 40px; font-size: 9.5px; }\n  .nn-cta__icon { width: 32px; height: 32px; }\n}\n\n@media (max-width: 350px) {\n  .nn-bar, .nn-bar__inner { min-height: 178px; }\n  .nn-bar__inner { padding-left: 4px; padding-right: 4px; }\n  .nn-bar__event { font-size: 11px; letter-spacing: .08em; }\n  .nn-bar__title { margin-right: -.08em; }\n  .nn-bar__timer { gap: 3px; }\n  .nn-bar__unit { width: 48px; }\n  .nn-bar__box { height: 39px; }\n  .nn-bar__unit strong { font-size: 19px; }\n  .nn-bar__unit > span { font-size: 5.5px; }\n  .nn-bar__colon { min-width: 3px; height: 39px; font-size: 15px; }\n  .nn-cta { max-width: 184px; padding: 0 38px; font-size: 9px; }\n  .nn-cta__icon { width: 30px; height: 30px; }\n}\n\n/* ========================================================\n   REDUCED MOTION\n======================================================== */\n@media (prefers-reduced-motion: reduce) {\n  .nn-bar__spark,\n  .nn-cta::before,\n  .nn-cta__shine::before,\n  .nn-bar__dot::after,\n  .nn-cta:hover .nn-cta__icon svg { animation: none !important; }\n  .nn-bar__unit strong,\n  .nn-cta,\n  .nn-cta__icon,\n  .nn-bar__rail span { transition: none; }\n}\n</style>\n\n\n<script>\n(function () {\n\n  /* =====================================================\n     SETTINGS — edit these\n  ===================================================== */\n\n  // Sale starts: 3 Oct 2026, 12:00:00 AM IST\n  var SALE_START = new Date(\"2026-10-03T00:00:00+05:30\").getTime();\n\n  // Sale ends: 4 Oct 2026, 11:59:59 PM IST\n  var SALE_END = new Date(\"2026-10-04T23:59:59+05:30\").getTime();\n\n  // Where the button goes in each phase\n  var LINK_PRE  = \"https://in.hndrd.co/pages/now-or-never-pre-sale\";\n  var LINK_LIVE = \"https://in.hndrd.co/pages/now-or-never-flash-sale\"; // <-- change to your sale collection\n\n  // Last-hour urgency mode (yellow digits, faster pulse)\n  var URGENT_MS = 60 * 60 * 1000;\n\n  // true = hide the whole bar after the sale ends\n  var HIDE_WHEN_ENDED = false;\n\n  var COPY = {\n    pre:    { title: \"NOW OR NEVER\",           status: \"STARTS IN\",         cta: \"GET EARLY ACCESS\" },\n    live:   { title: \"NOW OR NEVER\",           status: \"ENDS IN\",           cta: \"MAKE YOUR MOVE\" },\n    urgent: { title: \"NOW OR NEVER\",           status: \"FINAL HOUR\",        cta: \"GRAB IT NOW\" },\n    ended:  { title: \"NOW OR NEVER HAS ENDED\", status: \"SEE YOU NEXT DROP\", cta: \"\" }\n  };\n\n\n  /* =====================================================\n     ELEMENTS\n  ===================================================== */\n\n  var bar = document.getElementById(\"nnBar\");\n  if (!bar) return;\n\n  var titleEl   = document.getElementById(\"nnTitle\");\n  var statusEl  = document.getElementById(\"nnStatus\");\n  var ctaEl     = document.getElementById(\"nnCta\");\n  var ctaTextEl = document.getElementById(\"nnCtaText\");\n  var railEl    = document.getElementById(\"nnRail\");\n  var daysWrap  = document.getElementById(\"nnDaysWrap\");\n  var daysColon = document.getElementById(\"nnDaysColon\");\n\n  var els = {\n    days:    document.getElementById(\"nnDays\"),\n    hours:   document.getElementById(\"nnHours\"),\n    minutes: document.getElementById(\"nnMinutes\"),\n    seconds: document.getElementById(\"nnSeconds\")\n  };\n\n  var previous = { days: null, hours: null, minutes: null, seconds: null };\n  var currentState = null;\n  var timer = null;\n\n\n  /* =====================================================\n     HELPERS\n  ===================================================== */\n\n  function pad(v) { return String(v).padStart(2, \"0\"); }\n\n  function updateNumber(key, value) {\n    if (previous[key] === value) return;\n    var el = els[key];\n    el.classList.add(\"nn-tick\");\n    setTimeout(function () {\n      el.textContent = pad(value);\n      el.classList.remove(\"nn-tick\");\n    }, 90);\n    previous[key] = value;\n  }\n\n  function applyState(state) {\n    if (state === currentState) return;\n    currentState = state;\n\n    var copy = COPY[state];\n    bar.setAttribute(\"data-phase\", state === \"urgent\" ? \"live\" : state);\n    bar.setAttribute(\"data-urgent\", state === \"urgent\" ? \"true\" : \"false\");\n\n    titleEl.textContent  = copy.title;\n    statusEl.textContent = copy.status;\n\n    if (copy.cta) {\n      ctaTextEl.textContent = copy.cta;\n      ctaEl.setAttribute(\"href\", state === \"pre\" ? LINK_PRE : LINK_LIVE);\n    }\n\n    if (state === \"ended\" && HIDE_WHEN_ENDED) {\n      bar.style.display = \"none\";\n    }\n  }\n\n\n  /* =====================================================\n     COUNTDOWN\n  ===================================================== */\n\n  function tick() {\n    var now = Date.now();\n    var target, state;\n\n    if (now < SALE_START) {\n      target = SALE_START;\n      state = \"pre\";\n    } else if (now < SALE_END) {\n      target = SALE_END;\n      state = (SALE_END - now) <= URGENT_MS ? \"urgent\" : \"live\";\n    } else {\n      applyState(\"ended\");\n      if (timer) clearInterval(timer);\n      return;\n    }\n\n    applyState(state);\n\n    var total   = Math.floor((target - now) / 1000);\n    var days    = Math.floor(total / 86400);\n    var hours   = Math.floor((total % 86400) / 3600);\n    var minutes = Math.floor((total % 3600) / 60);\n    var seconds = total % 60;\n\n    var hideDays = days <= 0;\n    daysWrap.classList.toggle(\"nn-hide\", hideDays);\n    daysColon.classList.toggle(\"nn-hide\", hideDays);\n\n    updateNumber(\"days\", days);\n    updateNumber(\"hours\", hours);\n    updateNumber(\"minutes\", minutes);\n    updateNumber(\"seconds\", seconds);\n\n    if (state !== \"pre\") {\n      var left = (SALE_END - now) / (SALE_END - SALE_START);\n      railEl.style.transform = \"scaleX(\" + Math.max(0, Math.min(1, left)) + \")\";\n    }\n  }\n\n  tick();\n  timer = setInterval(tick, 1000);\n\n  document.addEventListener(\"visibilitychange\", function () {\n    if (!document.hidden) tick();\n  });\n\n})();\n</script>",
