      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — COUNTDOWN ANNOUNCEMENT BAR\n\n  TARGET:\n  3 OCTOBER 2026\n  12:00 AM IST\n\n  NO SCHEMA\n{% endcomment %}\n\n<section\n  id=\"non-countdown-{{ section.id }}\"\n  class=\"non-countdown\"\n  data-target=\"2026-10-03T00:00:00+05:30\"\n>\n\n  <!-- BACKGROUND MOTION -->\n  <div class=\"non-bg-motion\" aria-hidden=\"true\">\n    <span class=\"non-bg-light non-bg-light--1\"></span>\n    <span class=\"non-bg-light non-bg-light--2\"></span>\n  </div>\n\n\n  <!-- LEFT POPPER -->\n  <div class=\"non-party non-party--left\" aria-hidden=\"true\">\n\n    <div class=\"non-popper\">\n      <span class=\"non-popper__body\"></span>\n      <span class=\"non-popper__top\"></span>\n    </div>\n\n    <span class=\"non-confetti non-confetti--1\"></span>\n    <span class=\"non-confetti non-confetti--2\"></span>\n    <span class=\"non-confetti non-confetti--3\"></span>\n    <span class=\"non-confetti non-confetti--4\"></span>\n    <span class=\"non-confetti non-confetti--5\"></span>\n    <span class=\"non-confetti non-confetti--6\"></span>\n\n  </div>\n\n\n  <!-- CONTENT -->\n  <div class=\"non-countdown__content\">\n\n    <div\n      class=\"non-countdown__title\"\n      data-countdown-title\n    >\n      NOW OR NEVER SALE STARTS IN\n    </div>\n\n\n    <div\n      class=\"non-timer\"\n      data-countdown-timer\n    >\n\n      <!-- HOURS -->\n      <div class=\"non-time\">\n\n        <div class=\"non-time__box\">\n          <span data-hours>000</span>\n        </div>\n\n        <span class=\"non-time__label\">\n          HOURS\n        </span>\n\n      </div>\n\n\n      <span class=\"non-separator\">:</span>\n\n\n      <!-- MINUTES -->\n      <div class=\"non-time\">\n\n        <div class=\"non-time__box\">\n          <span data-minutes>00</span>\n        </div>\n\n        <span class=\"non-time__label\">\n          MINUTES\n        </span>\n\n      </div>\n\n\n      <span class=\"non-separator\">:</span>\n\n\n      <!-- SECONDS -->\n      <div class=\"non-time\">\n\n        <div class=\"non-time__box\">\n          <span data-seconds>00</span>\n        </div>\n\n        <span class=\"non-time__label\">\n          SECONDS\n        </span>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <!-- RIGHT POPPER -->\n  <div class=\"non-party non-party--right\" aria-hidden=\"true\">\n\n    <div class=\"non-popper\">\n      <span class=\"non-popper__body\"></span>\n      <span class=\"non-popper__top\"></span>\n    </div>\n\n    <span class=\"non-confetti non-confetti--1\"></span>\n    <span class=\"non-confetti non-confetti--2\"></span>\n    <span class=\"non-confetti non-confetti--3\"></span>\n    <span class=\"non-confetti non-confetti--4\"></span>\n    <span class=\"non-confetti non-confetti--5\"></span>\n    <span class=\"non-confetti non-confetti--6\"></span>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =====================================================\n   MAIN BAR\n===================================================== */\n\n#non-countdown-{{ section.id }} {\n\n  position: relative;\n\n  width: 100%;\n\n  min-height: 92px;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  padding: 9px 95px 8px;\n\n  color: #fff;\n\n  background:\n    linear-gradient(\n      115deg,\n      #6114db 0%,\n      #ad00f1 48%,\n      #ed00dc 100%\n    );\n\n  background-size: 220% 220%;\n\n  animation:\n    nonGradientFlow\n    7s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n/* soft premium edge */\n\n#non-countdown-{{ section.id }}::before {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0 0 auto 0;\n\n  height: 1px;\n\n  z-index: 8;\n\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.7),\n      transparent\n    );\n\n  opacity: .6;\n\n}\n\n\n/* subtle lower depth */\n\n#non-countdown-{{ section.id }}::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  left: 0;\n\n  right: 0;\n\n  bottom: 0;\n\n  height: 18px;\n\n  z-index: -1;\n\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      to bottom,\n      transparent,\n      rgba(48,0,75,.11)\n    );\n\n}\n\n\n\n/* =====================================================\n   MOVING BACKGROUND LIGHT\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-bg-motion {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n}\n\n\n#non-countdown-{{ section.id }} .non-bg-light {\n\n  position: absolute;\n\n  border-radius: 999px;\n\n  filter: blur(42px);\n\n  will-change: transform;\n\n}\n\n\n#non-countdown-{{ section.id }} .non-bg-light--1 {\n\n  width: 280px;\n\n  height: 120px;\n\n  top: -65px;\n\n  left: 14%;\n\n  background:\n    rgba(255,255,255,.15);\n\n  animation:\n    nonLightMove1\n    8s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n#non-countdown-{{ section.id }} .non-bg-light--2 {\n\n  width: 310px;\n\n  height: 120px;\n\n  right: 8%;\n\n  bottom: -75px;\n\n  background:\n    rgba(74,0,194,.3);\n\n  animation:\n    nonLightMove2\n    10s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n\n/* =====================================================\n   CONTENT\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-countdown__content {\n\n  position: relative;\n\n  z-index: 5;\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n\n  justify-content: center;\n\n}\n\n\n\n/* =====================================================\n   TITLE\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-countdown__title {\n\n  margin-bottom: 8px;\n\n  text-align: center;\n\n  color: #fff;\n\n  font-size: 11px;\n\n  line-height: 1;\n\n  font-weight: 800;\n\n  letter-spacing: .18em;\n\n  text-transform: uppercase;\n\n  text-shadow:\n    0 2px 10px\n    rgba(42,0,70,.18);\n\n}\n\n\n\n/* =====================================================\n   TIMER\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-timer {\n\n  display: flex;\n\n  align-items: flex-start;\n\n  justify-content: center;\n\n  gap: 9px;\n\n}\n\n\n\n/* =====================================================\n   TIME BLOCK\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-time {\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n\n  min-width: 61px;\n\n}\n\n\n\n/* NUMBER BOX */\n\n#non-countdown-{{ section.id }} .non-time__box {\n\n  position: relative;\n\n  min-width: 61px;\n\n  height: 30px;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  padding: 0 10px;\n\n  overflow: hidden;\n\n  border-radius: 7px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.12);\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.21),\n      rgba(255,255,255,.11)\n    );\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.15),\n    0 6px 18px rgba(54,0,100,.10);\n\n  backdrop-filter:\n    blur(9px);\n\n  -webkit-backdrop-filter:\n    blur(9px);\n\n}\n\n\n/* glass reflection */\n\n#non-countdown-{{ section.id }} .non-time__box::before {\n\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n\n  left: 7%;\n\n  width: 86%;\n\n  height: 46%;\n\n  background:\n    linear-gradient(\n      to bottom,\n      rgba(255,255,255,.10),\n      transparent\n    );\n\n  border-radius:\n    0 0 50% 50%;\n\n  pointer-events: none;\n\n}\n\n\n\n/* NUMBER */\n\n#non-countdown-{{ section.id }} .non-time__box span {\n\n  position: relative;\n\n  z-index: 2;\n\n  color: #fff;\n\n  font-size: 17px;\n\n  line-height: 1;\n\n  font-weight: 750;\n\n  letter-spacing: -.02em;\n\n  font-variant-numeric:\n    tabular-nums;\n\n}\n\n\n\n/* changing number motion */\n\n#non-countdown-{{ section.id }}\n.non-time__box span.non-number-change {\n\n  animation:\n    nonNumberUpdate\n    .35s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =====================================================\n   LABEL\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-time__label {\n\n  margin-top: 5px;\n\n  color:\n    rgba(255,255,255,.88);\n\n  font-size: 6px;\n\n  line-height: 1;\n\n  font-weight: 600;\n\n  letter-spacing: .09em;\n\n}\n\n\n\n/* =====================================================\n   COLON\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-separator {\n\n  margin-top: 5px;\n\n  color:\n    rgba(255,255,255,.9);\n\n  font-size: 17px;\n\n  line-height: 20px;\n\n  font-weight: 700;\n\n  animation:\n    nonColonPulse\n    1s\n    ease-in-out\n    infinite;\n\n}\n\n\n\n/* =====================================================\n   PARTY WRAPPERS\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-party {\n\n  position: absolute;\n\n  top: 50%;\n\n  z-index: 4;\n\n  width: 76px;\n\n  height: 70px;\n\n  transform:\n    translateY(-50%);\n\n  pointer-events: none;\n\n}\n\n\n#non-countdown-{{ section.id }} .non-party--left {\n\n  left:\n    max(\n      24px,\n      calc(50% - 315px)\n    );\n\n}\n\n\n#non-countdown-{{ section.id }} .non-party--right {\n\n  right:\n    max(\n      24px,\n      calc(50% - 315px)\n    );\n\n  transform:\n    translateY(-50%)\n    scaleX(-1);\n\n}\n\n\n\n/* =====================================================\n   POPPER\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-popper {\n\n  position: absolute;\n\n  left: 14px;\n\n  bottom: 7px;\n\n  width: 34px;\n\n  height: 42px;\n\n  transform:\n    rotate(-34deg);\n\n  transform-origin:\n    bottom center;\n\n  animation:\n    nonPopperBounce\n    2.8s\n    cubic-bezier(.16,1,.3,1)\n    infinite;\n\n}\n\n\n\n/* POPPER BODY */\n\n#non-countdown-{{ section.id }} .non-popper__body {\n\n  position: absolute;\n\n  left: 8px;\n\n  bottom: 0;\n\n  width: 20px;\n\n  height: 33px;\n\n  overflow: hidden;\n\n  clip-path:\n    polygon(\n      10% 0,\n      90% 0,\n      65% 100%,\n      35% 100%\n    );\n\n  background:\n    linear-gradient(\n      135deg,\n      #f4ef38 0%,\n      #ffbd34 50%,\n      #f16d39 100%\n    );\n\n  filter:\n    drop-shadow(\n      0 5px 7px\n      rgba(37,0,60,.22)\n    );\n\n}\n\n\n\n/* stripes */\n\n#non-countdown-{{ section.id }} .non-popper__body::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0;\n\n  background:\n    repeating-linear-gradient(\n      145deg,\n      transparent 0,\n      transparent 6px,\n      rgba(112,29,201,.58) 6px,\n      rgba(112,29,201,.58) 9px\n    );\n\n}\n\n\n\n/* POPPER TOP */\n\n#non-countdown-{{ section.id }} .non-popper__top {\n\n  position: absolute;\n\n  top: 1px;\n\n  left: 7px;\n\n  width: 22px;\n\n  height: 7px;\n\n  border-radius: 50%;\n\n  background:\n    #ffdc45;\n\n  box-shadow:\n    0 0 12px\n    rgba(255,220,69,.42);\n\n}\n\n\n\n/* =====================================================\n   CONFETTI\n===================================================== */\n\n#non-countdown-{{ section.id }} .non-confetti {\n\n  position: absolute;\n\n  left: 29px;\n\n  top: 18px;\n\n  width: 5px;\n\n  height: 10px;\n\n  border-radius: 2px;\n\n  opacity: 0;\n\n  transform-origin: center;\n\n  animation:\n    nonConfettiBurst\n    2.8s\n    cubic-bezier(.16,1,.3,1)\n    infinite;\n\n}\n\n\n\n/* 1 */\n\n#non-countdown-{{ section.id }} .non-confetti--1 {\n\n  background: #f5ef3d;\n\n  --x: -22px;\n  --y: -24px;\n  --r: 130deg;\n\n  animation-delay: 0s;\n\n}\n\n\n\n/* 2 */\n\n#non-countdown-{{ section.id }} .non-confetti--2 {\n\n  background: #fff;\n\n  --x: -5px;\n  --y: -37px;\n  --r: 230deg;\n\n  animation-delay: .06s;\n\n}\n\n\n\n/* 3 */\n\n#non-countdown-{{ section.id }} .non-confetti--3 {\n\n  background: #6fc5ff;\n\n  --x: 17px;\n  