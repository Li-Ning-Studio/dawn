ges/now-or-never-pre-sale\"\n      class=\"non-sale-bar__cta\"\n    >\n\n      <span class=\"non-sale-bar__cta-text\">\n        GET EARLY ACCESS\n      </span>\n\n      <span class=\"non-sale-bar__cta-arrow\">\n        →\n      </span>\n\n    </a>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ========================================================\n   MAIN BAR\n======================================================== */\n\n.non-sale-bar {\n  width: 100%;\n  min-height: 90px;\n\n  position: relative;\n  overflow: hidden;\n\n  color: #fff;\n\n  background:\n    radial-gradient(\n      circle at 50% -110%,\n      rgba(255,255,255,.24) 0%,\n      rgba(255,255,255,0) 55%\n    ),\n    linear-gradient(\n      105deg,\n      #8500d7 0%,\n      #a800ee 30%,\n      #cf00fc 63%,\n      #ed00ff 100%\n    );\n}\n\n\n/* TOP HIGHLIGHT */\n\n.non-sale-bar::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n  right: 0;\n\n  height: 1px;\n\n  background:\n    rgba(255,255,255,.35);\n}\n\n\n/* ========================================================\n   BACKGROUND TEXTURE\n======================================================== */\n\n.non-sale-bar__texture {\n  position: absolute;\n\n  inset: 0;\n\n  pointer-events: none;\n\n  opacity: .10;\n\n  background-image:\n    radial-gradient(\n      circle,\n      rgba(255,255,255,.60) 1px,\n      transparent 1px\n    );\n\n  background-size:\n    24px 24px;\n\n  -webkit-mask-image:\n    linear-gradient(\n      90deg,\n      transparent 0%,\n      #000 28%,\n      #000 72%,\n      transparent 100%\n    );\n\n  mask-image:\n    linear-gradient(\n      90deg,\n      transparent 0%,\n      #000 28%,\n      #000 72%,\n      transparent 100%\n    );\n}\n\n\n/* ========================================================\n   DESKTOP INNER\n======================================================== */\n\n.non-sale-bar__inner {\n  position: relative;\n\n  z-index: 2;\n\n  width: 100%;\n  max-width: 1180px;\n\n  min-height: 90px;\n\n  margin: 0 auto;\n\n  padding:\n    9px\n    22px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 36px;\n}\n\n\n/* ========================================================\n   NOW OR NEVER\n======================================================== */\n\n.non-sale-bar__event {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 7px;\n\n  flex-shrink: 0;\n\n  white-space: nowrap;\n\n  font-family: inherit;\n\n  font-size: 16px;\n\n  line-height: 1;\n\n  font-weight: 800;\n\n  letter-spacing: .08em;\n\n  color: #fff500;\n}\n\n\n/* STAR */\n\n.non-sale-bar__spark {\n  display: inline-block;\n\n  font-size: 13px;\n\n  color: #fff500;\n\n  animation:\n    nonSpark\n    2.3s\n    ease-in-out\n    infinite;\n}\n\n\n@keyframes nonSpark {\n\n  0%,\n  100% {\n    opacity: .55;\n\n    transform:\n      scale(.85)\n      rotate(0deg);\n  }\n\n  50% {\n    opacity: 1;\n\n    transform:\n      scale(1.15)\n      rotate(45deg);\n  }\n\n}\n\n\n/* ========================================================\n   TIMER\n======================================================== */\n\n.non-sale-bar__timer {\n  display: flex;\n\n  align-items: flex-start;\n  justify-content: center;\n\n  gap: 11px;\n\n  flex-shrink: 0;\n}\n\n\n/* ========================================================\n   TIMER UNIT\n======================================================== */\n\n.non-sale-bar__time {\n  width: 82px;\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n  justify-content: flex-start;\n}\n\n\n/* ========================================================\n   TIMER BOX\n======================================================== */\n\n.non-sale-bar__number-box {\n  position: relative;\n\n  width: 82px;\n  height: 50px;\n\n  overflow: hidden;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 13px;\n\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.23),\n      rgba(255,255,255,.13)\n    );\n\n  border:\n    1px solid\n    rgba(255,255,255,.10);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.17),\n    0 7px 20px rgba(60,0,100,.10);\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n}\n\n\n/* TIMER BOX HIGHLIGHT */\n\n.non-sale-bar__number-box::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n\n  left: 12%;\n  right: 12%;\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.52),\n      transparent\n    );\n}\n\n\n/* ========================================================\n   TIMER NUMBER\n======================================================== */\n\n.non-sale-bar__time strong {\n  position: relative;\n\n  z-index: 2;\n\n  font-family: inherit;\n\n  font-size: 30px;\n\n  line-height: 1;\n\n  font-weight: 750;\n\n  letter-spacing: 0;\n\n  color: #fff;\n\n  font-variant-numeric:\n    tabular-nums;\n\n  transition:\n    opacity .16s ease,\n    transform .16s\n    cubic-bezier(.2,.8,.2,1);\n}\n\n\n/* NUMBER TICK */\n\n.non-sale-bar__time strong.non-tick {\n  opacity: .3;\n\n  transform:\n    translateY(-4px);\n}\n\n\n/* ========================================================\n   TIMER LABEL\n======================================================== */\n\n.non-sale-bar__time > span {\n  margin-top: 7px;\n\n  font-family: inherit;\n\n  font-size: 8px;\n\n  line-height: 1;\n\n  font-weight: 550;\n\n  letter-spacing: .09em;\n\n  text-transform: uppercase;\n\n  white-space: nowrap;\n\n  color:\n    rgba(255,255,255,.90);\n}\n\n\n/* ========================================================\n   COLONS\n======================================================== */\n\n.non-sale-bar__colon {\n  min-width: 7px;\n\n  height: 50px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  font-family: inherit;\n\n  font-size: 24px;\n\n  line-height: 1;\n\n  font-weight: 700;\n\n  color: #fff;\n}\n\n\n/* ========================================================\n   CTA\n======================================================== */\n\n.non-sale-bar__cta {\n  position: relative;\n\n  min-height: 37px;\n\n  padding:\n    0\n    18px;\n\n  overflow: hidden;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 8px;\n\n  flex-shrink: 0;\n\n  border-radius: 6px;\n\n  background: #fff500;\n\n  color: #36004d;\n\n  text-decoration: none;\n\n  white-space: nowrap;\n\n  font-family: inherit;\n\n  font-size: 9px;\n\n  line-height: 1;\n\n  font-weight: 850;\n\n  letter-spacing: .06em;\n\n  box-shadow:\n    0 6px 18px\n    rgba(56,0,90,.15);\n\n  transition:\n    transform .3s\n    cubic-bezier(.2,.8,.2,1),\n    background .3s ease,\n    box-shadow .3s ease;\n}\n\n\n/* CTA SHINE */\n\n.non-sale-bar__cta::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  bottom: 0;\n\n  left: -45%;\n\n  width: 35%;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.7),\n      transparent\n    );\n\n  transform:\n    skewX(-20deg);\n\n  transition:\n    left .6s\n    cubic-bezier(.2,.8,.2,1);\n}\n\n\n.non-sale-bar__cta-text,\n.non-sale-bar__cta-arrow {\n  position: relative;\n\n  z-index: 2;\n}\n\n\n.non-sale-bar__cta-arrow {\n  font-size: 14px;\n\n  transition:\n    transform .3s\n    cubic-bezier(.2,.8,.2,1);\n}\n\n\n/* CTA HOVER */\n\n.non-sale-bar__cta:hover {\n  background: #fff;\n\n  transform:\n    translateY(-2px);\n\n  box-shadow:\n    0 8px 22px\n    rgba(56,0,90,.20);\n}\n\n\n.non-sale-bar__cta:hover::before {\n  left: 120%;\n}\n\n\n.non-sale-bar__cta:hover\n.non-sale-bar__cta-arrow {\n  transform:\n    translateX(3px);\n}\n\n\n/* ========================================================\n   HIDE DAYS\n======================================================== */\n\n.non-sale-bar__time.non-hide,\n.non-sale-bar__colon.non-hide {\n  display: none;\n}\n\n\n/* ========================================================\n   TABLET\n======================================================== */\n\n@media (max-width: 950px) and (min-width: 651px) {\n\n  .non-sale-bar__inner {\n    gap: 20px;\n\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n\n\n  .non-sale-bar__event {\n    font-size: 12px;\n  }\n\n\n  .non-sale-bar__timer {\n    gap: 8px;\n  }\n\n\n  .non-sale-bar__time {\n    width: 67px;\n  }\n\n\n  .non-sale-bar__number-box {\n    width: 67px;\n    height: 45px;\n  }\n\n\n  .non-sale-bar__time strong {\n    font-size: 26px;\n  }\n\n\n  .non-sale-bar__colon {\n    height: 45px;\n\n    font-size: 20px;\n  }\n\n\n  .non-sale-bar__cta {\n    min-height: 34px;\n\n    padding:\n      0\n      13px;\n\n    font-size: 8px;\n  }\n\n}\n\n\n/* ========================================================\n   MOBILE\n\n   ROW 1 = NOW OR NEVER\n   ROW 2 = TIMER\n   ROW 3 = CTA\n======================================================== */\n\n@media (max-width: 650px) {\n\n  .non-sale-bar {\n    min-height: 171px;\n  }\n\n\n  .non-sale-bar__inner {\n    width: 100%;\n\n    min-height: 171px;\n\n    padding:\n      14px\n      10px\n      13px;\n\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: center;\n    justify-content: center;\n\n    gap: 12px;\n  }\n\n\n  /* =========================================\n     ROW 1\n  ========================================= */\n\n  .non-sale-bar__event {\n    width: 100%;\n\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    gap: 6px;\n\n    flex-shrink: 0;\n\n    white-space: nowrap;\n\n    font-size: 14px;\n\n    line-height: 1;\n\n    font-weight: 800;\n\n    letter-spacing: .12em;\n\n    text-align: center;\n\n    color: #fff500;\n  }\n\n\n  .non-sale-bar__spark {\n    display: inline-block;\n\n    font-size: 10px;\n  }\n\n\n  /* =========================================\n     ROW 2 - TIMER\n  ========================================= */\n\n  .non-sale-bar__timer {\n    width: 100%;\n\n    display: flex;\n\n    align-items: flex-start;\n    justify-content: center;\n\n    gap: 7px;\n\n    flex-shrink: 0;\n  }\n\n\n  .non-sale-bar__time {\n    width: 60px;\n  }\n\n\n  .non-sale-bar__number-box {\n    width: 60px;\n\n    height: 44px;\n\n    border-radius: 11px;\n  }\n\n\n  .non-sale-bar__time strong {\n    font-size: 20px;\n  }\n\n\n  .non-sale-bar__time > span {\n    margin-top: 6px;\n\n    font-size: 6.5px;\n\n    font-weight: 550;\n\n    letter-spacing: .07em;\n  }\n\n\n  .non-sale-bar__colon {\n    min-width: 5px;\n\n    height: 44px;\n\n    font-size: 19px;\n  }\n\n\n  /* =========================================\n     ROW 3 - CTA\n  ========================================= */\n\n  .non-sale-bar__cta {\n    min-width: 158px;\n\n    min-height: 33px;\n\n    padding:\n      0\n      18px;\n\n    border-radius: 6px;\n\n    gap: 7px;\n\n    font-size: 8px;\n\n    font-weight: 850;\n\n    letter-spacing: .07em;\n  }\n\n\n  .non-sale-bar__cta-arrow {\n    display: inline-block;\n\n    font-size: 12px;\n  }\n\n}\n\n\n/* ========================================================\n   SMALL MOBILE\n======================================================== */\n\n@media (max-width: 400px) {\n\n  .non-sale-bar {\n    min-height: 165px;\n  }\n\n\n  .non-sale-bar__inner {\n    min-height: 165px;\n\n    padding:\n      12px\n      6px\n      11px;\n\n    gap: 10px;\n  }\n\n\n  /* NEVER HIDE THIS */\n\n  .non-sale-bar__event {\n    display: flex;\n\n    font-size: 13px;\n\n    letter-spacing: .10em;\n  }\n\n\n  /* TIMER */\n\n  .non-sale-bar__timer {\n    gap: 5px;\n  }\n\n\n  .non-sale-bar__time {\n    width: 54px;\n  }\n\n\n  .non-sale-bar__number-box {\n    width: 54px;\n\n    height: 41px;\n\n    border-radius: 9px;\n  }\n\n\n  .non-sale-bar__time strong {\n    font-size: 24px;\n  }\n\n\n  .non-sale-bar__time > span {\n    margin-top: 5px;\n\n    font-size: 6px;\n  }\n\n\n  .non-sale-bar__colon {\n    min-width: 4px;\n\n    height: 41px;\n\n    font-size: 17px;\n  }\n\n\n  /* CTA */\n\n  .non-sale-bar__cta {\n    min-width: 150px;\n\n    min-height: 31px;\n\n    font-size: 7.5px;\n  }\n\n}\n\n\n/* ========================================================\n   VERY SMALL MOBILE\n======================================================== */\n\n@media (max-width: 350px) {\n\n  .non-sale-bar {\n    min-height: 160px;\n  }\n\n\n  .non-sale-bar__inner {\n    min-height: 160px;\n\n    padding-left: 4px;\n    padding-right: 4px;\n  }\n\n\n  .non-sale-bar__event {\n    display: flex;\n\n    font-size: 10px;\n\n    letter-spacing: .08em;\n  }\n\n\n  .non-sale-bar__timer {\n    gap: 3px;\n  }\n\n\n  .non-sale-bar__time {\n    width: 30px;\n  }\n\n\n  .non-sale-bar__number-box {\n    width: 49px;\n\n    height: 39px;\n  }\n\n\n  .non-sale-bar__time strong {\n    font-size: 22px;\n  }\n\n\n  .non-sale-bar__time > span {\n    font-size: 5.5px;\n  }\n\n\n  .non-sale-bar__colon {\n    min-width: 3px;\n\n    height: 39px;\n\n    font-size: 15px;\n  }\n\n\n  .non-sale-bar__cta {\n    min-width: 145px;\n\n    font-size: 7px;\n  }\n\n}\n\n\n/* ========================================================\n   SALE LIVE\n======================================================== */\n\n.non-sale-bar.non-live\n.non-sale-bar__timer {\n  display: none;\n}\n\n\n.non-sale-bar.non-live\n.non-sale-bar__cta {\n  display: none;\n}\n\n\n.non-sale-bar.non-live\n.non-sale-bar__event {\n  font-size: 17px;\n}\n\n\n/* MOBILE LIVE */\n\n@media (max-width: 650px) {\n\n  .non-sale-bar.non-live {\n    min-height: 62px;\n  }\n\n\n  .non-sale-bar.non-live\n  .non-sale-bar__inner {\n    min-height: 62px;\n\n    padding:\n      12px\n      10px;\n  }\n\n\n  .non-sale-bar.non-live\n  .non-sale-bar__event {\n    font-size: 14px;\n  }\n\n}\n\n\n/* ========================================================\n   REDUCED MOTION\n======================================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .non-sale-bar__spark {\n    animation: none;\n  }\n\n\n  .non-sale-bar__time strong,\n  .non-sale-bar__cta,\n  .non-sale-bar__cta-arrow {\n    transition: none;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  /* =====================================================\n     SALE START\n\n     3 OCTOBER 2026\n     12:00 AM IST\n  ===================================================== */\n\n  const saleStart =\n    new Date(\n      \"2026-10-03T00:00:00+05:30\"\n    ).getTime();\n\n\n  /* =====================================================\n     ELEMENTS\n  ===================================================== */\n\n  const bar =\n    document.getElementById(\n      \"nonSaleBar\"\n    );\n\n\n  const saleTitle =\n    document.getElementById(\n      \"nonSaleTitle\"\n    );\n\n\n  const daysWrap =\n    document.getElementById(\n      \"nonDaysWrap\"\n    );\n\n\n  const daysColon =\n    document.getElementById(\n      \"nonDaysColon\"\n    );\n\n\n  const dayEl =\n    document.getElementById(\n      \"nonDays\"\n    );\n\n\n  const hourEl =\n    document.getElementById(\n      \"nonHours\"\n    );\n\n\n  const minuteEl =\n    document.getElementById(\n      \"nonMinutes\"\n    );\n\n\n  const secondEl =\n    document.getElementById(\n      \"nonSeconds\"\n    );\n\n\n  let timerInterval = null;\n\n\n  const previous = {\n\n    days: null,\n\n    hours: null,\n\n    minutes: null,\n\n    seconds: null\n\n  };\n\n\n  /* =====================================================\n     TWO DIGIT FORMAT\n  ===================================================== */\n\n  function pad(value) {\n\n    return String(value)\n      .padStart(2, \"0\");\n\n  }\n\n\n  /* =====================================================\n     NUMBER CHANGE ANIMATION\n  ===================================================== */\n\n  function updateNumber(\n    element,\n    value,\n    key\n  ) {\n\n    if (\n      previous[key] === value\n    ) {\n\n      return;\n\n    }\n\n\n    element.classList.add(\n      \"non-tick\"\n    );\n\n\n    setTimeout(function () {\n\n      element.textContent =\n        pad(value);\n\n\n      element.classList.remove(\n        \"non-tick\"\n      );\n\n    }, 90);\n\n\n    previous[key] =\n      value;\n\n  }\n\n\n  /* =====================================================\n     COUNTDOWN\n  ===================================================== */\n\n  function updateCountdown() {\n\n    const now =\n      Date.now();\n\n\n    const distance =\n      saleStart - now;\n\n\n    /* ===================================================\n       SALE STARTED\n    =================================================== */\n\n    if (\n      distance <= 0\n    ) {\n\n      bar.classList.add(\n        \"non-live\"\n      );\n\n\n      saleTitle.textContent =\n        \"NOW OR NEVER IS LIVE\";\n\n\n      if (\n        timerInterval !== null\n      ) {\n\n        clearInterval(\n          timerInterval\n        );\n\n      }\n\n\n      return;\n\n    }\n\n\n    /* ===================================================\n       TIME CALCULATIONS\n    =================================================== */\n\n    const totalSeconds =\n      Math.floor(\n        distance / 1000\n      );\n\n\n    const days =\n      Math.floor(\n        totalSeconds / 86400\n      );\n\n\n    const hours =\n      Math.floor(\n        (\n          totalSeconds % 86400\n        ) / 3600\n      );\n\n\n    const minutes =\n      Math.floor(\n        (\n          totalSeconds % 3600\n        ) / 60\n      );\n\n\n    const seconds =\n      totalSeconds % 60;\n\n\n    /* ===================================================\n       REMOVE DAYS WHEN IT REACHES ZERO\n\n       Example:\n\n       01 DAYS : 04 HOURS : 30 MINUTES\n\n       becomes:\n\n       23 HOURS : 59 MINUTES : 59 SECONDS\n    =================================================== */\n\n    if (\n      days <= 0\n    ) {\n\n      daysWrap.classList.add(\n        \"non-hide\"\n      );\n\n\n      daysColon.classList.add(\n        \"non-hide\"\n      );\n\n    }\n\n    else {\n\n      daysWrap.classList.remove(\n        \"non-hide\"\n      );\n\n\n      daysColon.classList.remove(\n        \"non-hide\"\n      );\n\n    }\n\n\n    /* ===================================================\n       UPDATE DISPLAY\n    =================================================== */\n\n    updateNumber(\n      dayEl,\n      days,\n      \"days\"\n    );\n\n\n    updateNumber(\n      hourEl,\n      hours,\n      \"hours\"\n    );\n\n\n    updateNumber(\n      minuteEl,\n      minutes,\n      \"minutes\"\n    );\n\n\n    updateNumber(\n      secondEl,\n      seconds,\n      \"seconds\"\n    );\n\n  }\n\n\n  /* =====================================================\n     INITIAL LOAD\n  ===================================================== */\n\n  updateCountdown();\n\n\n  /* =====================================================\n     UPDATE EVERY SECOND\n  ===================================================== */\n\n  timerInterval =\n    setInterval(\n      updateCountdown,\n      1000\n    );\n\n})();\n\n</script>",
