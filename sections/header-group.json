    "custom_liquid_4pYF3x": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 2b: Sticky bottom countdown bar. Paste into a Shopify \"Custom Liquid\" section. -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link\n  href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@600;700;800&display=swap\"\n  rel=\"stylesheet\"\n>\n\n<style>\n  /* ---------- variables & reset ---------- */\n  .hb-sticky-bar {\n    --orange-1: #ff5a1f;\n    --orange-2: #ff8a1f;\n    --blue-1: #0a3fb0;\n    --blue-2: #1f6bff;\n    --ink: #0b0b0c;\n    --white: #ffffff;\n  }\n\n  .hb-sticky-bar,\n  .hb-sticky-bar * {\n    box-sizing: border-box;\n  }\n\n  /* ---------- bar container ---------- */\n  .hb-sticky-bar {\n    position: fixed;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 999;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-wrap: nowrap;\n    gap: 16px;\n\n    padding: 10px 16px;\n    overflow-x: auto;\n\n    background: linear-gradient(90deg, var(--ink) 0%, #1a1a1d 100%);\n    border-top: 3px solid var(--orange-1);\n    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.35);\n\n    font-family: 'Inter', sans-serif;\n\n    transform: translateY(0);\n    transition: transform 0.3s ease;\n  }\n\n  .hb-sticky-bar.hb-hide {\n    transform: translateY(100%);\n  }\n\n  /* ---------- \"Sale Ends In\" message ---------- */\n  .hb-sb-msg {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex-shrink: 0;\n  }\n\n  .hb-sb-msg span {\n    font-size: 12.5px;\n    font-weight: 800;\n    letter-spacing: 0.2px;\n    text-transform: uppercase;\n    color: var(--white);\n    white-space: nowrap;\n  }\n\n  .hb-sb-dot {\n    width: 7px;\n    height: 7px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: var(--orange-1);\n    box-shadow: 0 0 0 3px rgba(255, 90, 31, 0.25);\n    animation: hb-pulse 1.4s ease-in-out infinite;\n  }\n\n  @keyframes hb-pulse {\n    0%, 100% { box-shadow: 0 0 0 3px rgba(255, 90, 31, 0.25); }\n    50%      { box-shadow: 0 0 0 6px rgba(255, 90, 31, 0.08); }\n  }\n\n  /* ---------- timer ---------- */\n  .hb-sb-timer {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    flex-shrink: 0;\n  }\n\n  .hb-sb-seg {\n    min-width: 30px;\n    padding: 6px 10px;\n    line-height: 1;\n    text-align: center;\n    border-radius: 6px;\n    background: linear-gradient(160deg, var(--blue-2), var(--blue-1));\n  }\n\n  .hb-sb-seg .hb-n {\n    display: block;\n    font-family: 'Anton', sans-serif;\n    font-size: 13px;\n    line-height: 1;\n    color: var(--white);\n    letter-spacing: 1px;\n  }\n\n  .hb-sb-seg .hb-u {\n    display: none;\n    margin-top: 1px;\n    font-size: 6.5px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n    color: #cfe0ff;\n  }\n\n  .hb-sb-colon {\n    flex-shrink: 0;\n    font-family: 'Anton', sans-serif;\n    font-size: 12px;\n    color: #555;\n  }\n\n  /* ---------- CTA ---------- */\n  .hb-sb-cta {\n    flex-shrink: 0;\n    padding: 8px 16px;\n    border-radius: 30px;\n    background: var(--orange-1);\n    color: var(--white);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.3px;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  /* ---------- page offset ---------- */\n  body {\n    padding-bottom: 56px; /* keeps content clear of the fixed bar */\n  }\n\n  /* ---------- mobile ---------- */\n  @media (max-width: 640px) {\n    .hb-sticky-bar { gap: 8px; padding: 8px 10px; }\n    .hb-sb-msg span { font-size: 10.5px; }\n    .hb-sb-timer { gap: 3px; }\n    .hb-sb-seg { min-width: 24px; padding: 6px 6px; }\n    .hb-sb-seg .hb-n { font-size: 15px; }\n    .hb-sb-seg .hb-u { font-size: 5.5px; }\n    .hb-sb-cta { padding: 7px 12px; font-size: 10.5px; }\n  }\n</style>\n\n<div class=\"hb-sticky-bar\" id=\"hb-sticky-bar\">\n  <div class=\"hb-sb-msg\">\n    <span class=\"hb-sb-dot\"></span>\n    <span>Sale Ends In</span>\n  </div>\n\n  <div class=\"hb-sb-timer\" id=\"hb-sticky-timer\">\n    <div class=\"hb-sb-seg\">\n      <span class=\"hb-n\" data-unit=\"hrs\">14</span>\n      <span class=\"hb-u\">Hrs</span>\n    </div>\n    <span class=\"hb-sb-colon\">:</span>\n    <div class=\"hb-sb-seg\">\n      <span class=\"hb-n\" data-unit=\"min\">32</span>\n      <span class=\"hb-u\">Min</span>\n    </div>\n    <span class=\"hb-sb-colon\">:</span>\n    <div class=\"hb-sb-seg\">\n      <span class=\"hb-n\" data-unit=\"sec\">08</span>\n      <span class=\"hb-u\">Sec</span>\n    </div>\n  </div>\n\n  <a href=\"#products\" class=\"hb-sb-cta\">Shop Now</a>\n</div>\n\n<script>\n  (function () {\n    // Countdown target: July 6, 2026, 12:00 AM (local time)\n    var end = new Date(2026, 6, 6, 0, 0, 0);\n    var bar = document.getElementById('hb-sticky-bar');\n\n    function pad(n) {\n      return String(n).padStart(2, '0');\n    }\n\n    function tick() {\n      var diff = Math.max(0, end - new Date());\n\n      var hrs = Math.floor(diff / 3600000);\n      var min = Math.floor((diff % 3600000) / 60000);\n      var sec = Math.floor((diff % 60000) / 1000);\n\n      bar.querySelector('[data-unit=\"hrs\"]').textContent = pad(hrs);\n      bar.querySelector('[data-unit=\"min\"]').textContent = pad(min);\n      bar.querySelector('[data-unit=\"sec\"]').textContent = pad(sec);\n\n      if (diff <= 0) {\n        bar.classList.add('hb-hide');\n        clearInterval(timer);\n      }\n    }\n\n    tick();\n    var timer = setInterval(tick, 1000);\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_TYDpBY": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\nOne-off popup (single image).\n- Triggers after 13s of inactivity on all devices.\n- Once per browser session (sessionStorage)\n- Updated session key for Diwali.\n- FIX: Stops tracking events immediately after opening to prevent re-opening.\n{%- endcomment -%}\n\n<style>\n  .oneoff-popup[hidden] { display: none !important; }\n  .oneoff-popup {\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    display: grid;\n    place-items: center;\n    padding: 24px;\n    background: rgba(0,0,0,0.6);\n    opacity: 0;\n    transition: opacity .2s ease;\n  }\n  .oneoff-popup.is-open { opacity: 1; }\n  .oneoff-dialog {\n    position: relative;\n    max-width: min(90vw, 720px);\n    width: 450px;\n  }\n  .oneoff-dialog img {\n    display: block;\n    width: 100%;\n    height: auto;\n    border-radius: 8px;\n    box-shadow: 0 10px 30px rgba(0,0,0,.35);\n  }\n  .oneoff-close {\n    position: absolute;\n    top: 8px;\n    right: 8px;\n    border: 0;\n    background: rgba(255,255,255,.9);\n    color: #111;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    font-size: 22px;\n    text-align: center;\n    cursor: pointer;\n  }\n  .oneoff-close:hover { background: #fff; }\n  @media (prefers-reduced-motion: reduce) {\n    .oneoff-popup { transition: none; }\n  }\n</style>\n\n<div\n  id=\"exit-popup\"\n  class=\"oneoff-popup\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  hidden\n  data-session-key=\"oneoff_diwali_exit_popup_shown\"\n>\n  <div class=\"oneoff-dialog\" role=\"document\">\n    <button\n      type=\"button\"\n      class=\"oneoff-close\"\n      aria-label=\"{{ 'accessibility.close' | t }}\"\n      data-close\n    >×</button>\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bth_webpopup.png?v=1783185505\"\n      alt=\"\"\n      loading=\"lazy\"\n      width=\"1000\"\n      height=\"1000\"\n    />\n  </div>\n</div>\n\n<script>\n  (function () {\n    try {\n      var root = document.getElementById('exit-popup');\n      if (!root) return;\n\n      var sessionKey = root.dataset.sessionKey || 'oneoff_diwali_exit_popup_shown';\n\n      function getSeen() {\n        try { return sessionStorage.getItem(sessionKey) === '1'; } catch (e) { return false; }\n      }\n      function setSeen() {\n        try { sessionStorage.setItem(sessionKey, '1'); } catch (e) {}\n      }\n\n      // 1. If already seen in this session, do nothing.\n      if (getSeen()) return;\n\n      var opened = false;\n      var inactivityTimeout;\n      \n      // The events we track to detect activity\n      var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];\n\n      // Helper: Stop tracking to save performance and prevent double-firing\n      function removeInactivityListeners() {\n        events.forEach(function(event) {\n          document.removeEventListener(event, resetInactivityTimer, { passive: true });\n        });\n        clearTimeout(inactivityTimeout);\n      }\n\n      function resetInactivityTimer() {\n        clearTimeout(inactivityTimeout);\n        // Show popup after 13 seconds of inactivity\n        inactivityTimeout = setTimeout(openPopup, 13000);\n      }\n\n      function openPopup() {\n        if (opened) return;\n        \n        // Double check session (optional safety)\n        if (getSeen()) return;\n\n        opened = true;\n        setSeen();\n        \n        // FIX: Stop listening immediately so it doesn't trigger again\n        removeInactivityListeners();\n\n        root.hidden = false;\n        root.classList.add('is-open');\n        document.addEventListener('keydown', onKeydown);\n        document.documentElement.style.overflow = 'hidden';\n        \n        var btn = root.querySelector('[data-close]');\n        if (btn && btn.focus) { try { btn.focus({ preventScroll: true }); } catch (e) {} }\n      }\n\n      function closePopup() {\n        // If we haven't opened it, do nothing\n        if (!opened) return;\n\n        root.classList.remove('is-open');\n        root.hidden = true;\n        \n        document.removeEventListener('keydown', onKeydown);\n        document.documentElement.style.overflow = '';\n        \n        // Note: We do not set opened = false here or restart the timer.\n        // Once shown, it is done for the session.\n      }\n\n      function onKeydown(e) { if (e.key === 'Escape') closePopup(); }\n\n      root.addEventListener('click', function (e) {\n        if (e.target === root || e.target.hasAttribute('data-close')) closePopup();\n      });\n\n      // Start tracking user inactivity\n      function trackInactivity() {\n        events.forEach(function(event) {\n          document.addEventListener(event, resetInactivityTimer, { passive: true });\n        });\n        resetInactivityTimer(); // Initial call start\n      }\n      \n      trackInactivity();\n      \n    } catch (error) {\n      console.error(error);\n    }\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
