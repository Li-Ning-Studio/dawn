      "settings": {
        "custom_liquid": "<style>\n#HeaderMenu-flash-sale, #HeaderDrawer-flash-sale{\nbackground-image: linear-gradient(to right, #F84509 0%, blue 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent; /* Fallback for unsupported browsers */\n\n}\n</style>",
