-left {\n\n    left: 1px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-party--right {\n\n    right: 1px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-popper {\n\n    left: 5px;\n\n    bottom: 5px;\n\n    transform:\n      rotate(-34deg)\n      scale(.7);\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-confetti {\n\n    left: 18px;\n\n    top: 15px;\n\n    transform:\n      scale(.7);\n\n  }\n\n}\n\n\n\n/* =====================================================\n   VERY SMALL MOBILE\n===================================================== */\n\n@media (max-width: 360px) {\n\n  #non-countdown-{{ section.id }} {\n\n    min-height: 79px;\n\n    padding:\n      7px\n      30px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-countdown__title {\n\n    font-size: 8px;\n\n    letter-spacing: .13em;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-time {\n\n    min-width: 46px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-time__box {\n\n    min-width: 46px;\n\n    height: 27px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-time__box span {\n\n    font-size: 15px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-timer {\n\n    gap: 5px;\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-party {\n\n    transform:\n      translateY(-50%)\n      scale(.84);\n\n  }\n\n\n  #non-countdown-{{ section.id }}\n  .non-party--right {\n\n    transform:\n      translateY(-50%)\n      scaleX(-1)\n      scale(.84);\n\n  }\n\n}\n\n\n\n/* =====================================================\n   SALE LIVE STATE\n===================================================== */\n\n#non-countdown-{{ section.id }}.non-sale-live {\n\n  min-height: 68px;\n\n}\n\n\n#non-countdown-{{ section.id }}.non-sale-live\n.non-countdown__title {\n\n  margin: 0;\n\n  font-size:\n    clamp(\n      14px,\n      1.3vw,\n      18px\n    );\n\n  letter-spacing:\n    .16em;\n\n}\n\n\n#non-countdown-{{ section.id }}.non-sale-live\n.non-timer {\n\n  display: none;\n\n}\n\n\n\n/* =====================================================\n   ANIMATIONS\n===================================================== */\n\n@keyframes nonGradientFlow {\n\n  0% {\n\n    background-position:\n      0% 50%;\n\n  }\n\n  100% {\n\n    background-position:\n      100% 50%;\n\n  }\n\n}\n\n\n\n@keyframes nonLightMove1 {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        210px,\n        18px,\n        0\n      );\n\n  }\n\n}\n\n\n\n@keyframes nonLightMove2 {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -230px,\n        -14px,\n        0\n      );\n\n  }\n\n}\n\n\n\n@keyframes nonColonPulse {\n\n  0%,\n  100% {\n\n    opacity: .45;\n\n  }\n\n  50% {\n\n    opacity: 1;\n\n  }\n\n}\n\n\n\n@keyframes nonNumberUpdate {\n\n  0% {\n\n    opacity: .4;\n\n    transform:\n      translateY(-4px)\n      scale(.97);\n\n  }\n\n  100% {\n\n    opacity: 1;\n\n    transform:\n      translateY(0)\n      scale(1);\n\n  }\n\n}\n\n\n\n@keyframes nonPopperBounce {\n\n  0%,\n  70%,\n  100% {\n\n    transform:\n      rotate(-34deg)\n      scale(1);\n\n  }\n\n  76% {\n\n    transform:\n      rotate(-30deg)\n      scale(1.08);\n\n  }\n\n  84% {\n\n    transform:\n      rotate(-37deg)\n      scale(.98);\n\n  }\n\n}\n\n\n\n/* confetti fires near end of cycle */\n\n@keyframes nonConfettiBurst {\n\n  0%,\n  67% {\n\n    opacity: 0;\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      )\n      rotate(0deg)\n      scale(.7);\n\n  }\n\n  72% {\n\n    opacity: 1;\n\n  }\n\n  84% {\n\n    opacity: 1;\n\n    transform:\n      translate3d(\n        var(--x),\n        var(--y),\n        0\n      )\n      rotate(\n        var(--r)\n      )\n      scale(1);\n\n  }\n\n  100% {\n\n    opacity: 0;\n\n    transform:\n      translate3d(\n        calc(var(--x) * 1.15),\n        calc(var(--y) * 1.05),\n        0\n      )\n      rotate(\n        var(--r)\n      )\n      scale(.8);\n\n  }\n\n}\n\n\n\n/* =====================================================\n   REDUCED MOTION\n===================================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  #non-countdown-{{ section.id }},\n  #non-countdown-{{ section.id }} *,\n  #non-countdown-{{ section.id }} *::before,\n  #non-countdown-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'non-countdown-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n  const targetString =\n    section.getAttribute(\n      'data-target'\n    );\n\n\n  const target =\n    new Date(\n      targetString\n    ).getTime();\n\n\n  const hoursEl =\n    section.querySelector(\n      '[data-hours]'\n    );\n\n\n  const minutesEl =\n    section.querySelector(\n      '[data-minutes]'\n    );\n\n\n  const secondsEl =\n    section.querySelector(\n      '[data-seconds]'\n    );\n\n\n  const titleEl =\n    section.querySelector(\n      '[data-countdown-title]'\n    );\n\n\n  let previousHours = null;\n  let previousMinutes = null;\n  let previousSeconds = null;\n\n\n\n  /* number animation */\n\n  function animateNumber(\n    element\n  ) {\n\n    if (!element) return;\n\n\n    element.classList.remove(\n      'non-number-change'\n    );\n\n\n    void element.offsetWidth;\n\n\n    element.classList.add(\n      'non-number-change'\n    );\n\n  }\n\n\n\n  /* format */\n\n  function pad(\n    value,\n    length\n  ) {\n\n    return String(value)\n      .padStart(\n        length,\n        '0'\n      );\n\n  }\n\n\n\n  /* countdown */\n\n  function updateCountdown() {\n\n    const now =\n      Date.now();\n\n\n    const difference =\n      target - now;\n\n\n\n    /* SALE HAS STARTED */\n\n    if (difference <= 0) {\n\n      if (hoursEl) {\n        hoursEl.textContent =\n          '000';\n      }\n\n\n      if (minutesEl) {\n        minutesEl.textContent =\n          '00';\n      }\n\n\n      if (secondsEl) {\n        secondsEl.textContent =\n          '00';\n      }\n\n\n      if (titleEl) {\n\n        titleEl.textContent =\n          'NOW OR NEVER SALE IS LIVE';\n\n      }\n\n\n      section.classList.add(\n        'non-sale-live'\n      );\n\n\n      return false;\n\n    }\n\n\n\n    const totalSeconds =\n      Math.floor(\n        difference / 1000\n      );\n\n\n    /*\n      Hours are intentionally total hours remaining,\n      matching the style in your reference.\n      Example: 109 HOURS rather than 4 DAYS + 13 HOURS.\n    */\n\n    const hours =\n      Math.floor(\n        totalSeconds / 3600\n      );\n\n\n    const minutes =\n      Math.floor(\n        (\n          totalSeconds % 3600\n        ) / 60\n      );\n\n\n    const seconds =\n      totalSeconds % 60;\n\n\n\n    /* HOURS */\n\n    if (\n      previousHours !== hours\n    ) {\n\n      hoursEl.textContent =\n        pad(\n          hours,\n          3\n        );\n\n\n      animateNumber(\n        hoursEl\n      );\n\n\n      previousHours =\n        hours;\n\n    }\n\n\n\n    /* MINUTES */\n\n    if (\n      previousMinutes !== minutes\n    ) {\n\n      minutesEl.textContent =\n        pad(\n          minutes,\n          2\n        );\n\n\n      animateNumber(\n        minutesEl\n      );\n\n\n      previousMinutes =\n        minutes;\n\n    }\n\n\n\n    /* SECONDS */\n\n    if (\n      previousSeconds !== seconds\n    ) {\n\n      secondsEl.textContent =\n        pad(\n          seconds,\n          2\n        );\n\n\n      animateNumber(\n        secondsEl\n      );\n\n\n      previousSeconds =\n        seconds;\n\n    }\n\n\n    return true;\n\n  }\n\n\n\n  updateCountdown();\n\n\n  const timer =\n    setInterval(\n      function () {\n\n        const active =\n          updateCountdown();\n\n\n        if (!active) {\n\n          clearInterval(\n            timer\n          );\n\n        }\n\n      },\n      1000\n    );\n\n\n})();\n\n</script>",
