{%- liquid
  assign b1_stroke = 'transparent'
  assign b2_stroke = 'transparent'
-%}

<style>
  #shopify-section-{{ section.id }} .kin {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    min-height: {{ section.settings.min_height_mobile }}px;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .kin__bands {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .kin__band {
    position: absolute;
    left: -10%;
    width: 120%;
    overflow: hidden;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .kin__band--1 {
    top: {{ section.settings.band1_top }}%;
    transform: rotate({{ section.settings.band1_rotate }}deg);
  }

  #shopify-section-{{ section.id }} .kin__band--2 {
    top: {{ section.settings.band2_top }}%;
    transform: rotate({{ section.settings.band2_rotate }}deg);
  }

  #shopify-section-{{ section.id }} .kin__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .kin__run {
    font-family: var(--font-heading-family, inherit);
    font-weight: {{ section.settings.band_weight }};
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    padding-right: 0.3em;
  }

  #shopify-section-{{ section.id }} .kin__band--1 .kin__run {
    font-size: {{ section.settings.band1_size_mobile }}px;
    letter-spacing: {{ section.settings.band1_spacing }}em;
    opacity: {{ section.settings.band1_opacity | divided_by: 100.0 }};
    {% if section.settings.band1_style == 'outline' %}
      color: transparent;
      -webkit-text-stroke: {{ section.settings.band1_stroke_width }}px {{ section.settings.band1_color }};
    {% else %}
      color: {{ section.settings.band1_color }};
    {% endif %}
    {% if section.settings.band1_italic %}font-style: italic;{% endif %}
  }

  #shopify-section-{{ section.id }} .kin__band--2 .kin__run {
    font-size: {{ section.settings.band2_size_mobile }}px;
    letter-spacing: {{ section.settings.band2_spacing }}em;
    opacity: {{ section.settings.band2_opacity | divided_by: 100.0 }};
    {% if section.settings.band2_style == 'outline' %}
      color: transparent;
      -webkit-text-stroke: {{ section.settings.band2_stroke_width }}px {{ section.settings.band2_color }};
    {% else %}
      color: {{ section.settings.band2_color }};
    {% endif %}
    {% if section.settings.band2_italic %}font-style: italic;{% endif %}
  }

  #shopify-section-{{ section.id }} .kin__inner {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .kin__media {
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .kin__media img {
    display: block;
    width: auto;
    max-width: 100%;
    height: {{ section.settings.image_height_mobile }}px;
    object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55));
  }

  #shopify-section-{{ section.id }} .kin__card {
    box-sizing: border-box;
    width: 100%;
    padding: {{ section.settings.card_padding }}px;
    background: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .kin__eyebrow {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .kin__lead {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-size: {{ section.settings.lead_size_mobile }}px;
    font-weight: {{ section.settings.lead_weight }};
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .kin__body {
    margin: 0;
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.7;
    color: inherit;
    opacity: {{ section.settings.body_opacity | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .kin__body > * {
    margin: 0 0 0.8em;
  }

  #shopify-section-{{ section.id }} .kin__body > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .kin__button {
    align-self: flex-start;
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    border-radius: 40px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_border_color }};
    font-family: var(--font-heading-family, inherit);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .kin__button:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .kin__button svg {
    width: 14px;
    height: 14px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .kin {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      min-height: {{ section.settings.min_height }}px;
    }

    #shopify-section-{{ section.id }} .kin__inner {
      flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
      align-items: center;
      gap: {{ section.settings.column_gap }}px;
    }

    #shopify-section-{{ section.id }} .kin__media {
      flex: 0 0 {{ section.settings.image_column_width }}%;
      justify-content: {% if section.settings.image_position == 'right' %}flex-end{% else %}flex-start{% endif %};
    }

    #shopify-section-{{ section.id }} .kin__media img {
      height: {{ section.settings.image_height }}px;
    }

    #shopify-section-{{ section.id }} .kin__card {
      flex: 1 1 auto;
      max-width: {{ section.settings.card_max_width }}px;
    }

    #shopify-section-{{ section.id }} .kin__band--1 .kin__run {
      font-size: {{ section.settings.band1_size }}px;
    }

    #shopify-section-{{ section.id }} .kin__band--2 .kin__run {
      font-size: {{ section.settings.band2_size }}px;
    }

    #shopify-section-{{ section.id }} .kin__lead {
      font-size: {{ section.settings.lead_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    {% unless section.settings.show_image_mobile %}
      #shopify-section-{{ section.id }} .kin__media { display: none; }
    {% endunless %}
  }
</style>

<div class="kin" data-kin>
  <div class="kin__bands" aria-hidden="true">
    {%- if section.settings.band1_text != blank -%}
      <div class="kin__band kin__band--1">
        <div class="kin__track" data-kin-track data-dir="{% if section.settings.band1_direction == 'right' %}1{% else %}-1{% endif %}" data-speed="{{ section.settings.band1_speed }}">
          <span class="kin__run">{% for i in (1..8) %}{{ section.settings.band1_text }}{% if section.settings.band_separator != blank %} {{ section.settings.band_separator }} {% else %}&nbsp;{% endif %}{% endfor %}</span>
          <span class="kin__run">{% for i in (1..8) %}{{ section.settings.band1_text }}{% if section.settings.band_separator != blank %} {{ section.settings.band_separator }} {% else %}&nbsp;{% endif %}{% endfor %}</span>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.band2_text != blank -%}
      <div class="kin__band kin__band--2">
        <div class="kin__track" data-kin-track data-dir="{% if section.settings.band2_direction == 'right' %}1{% else %}-1{% endif %}" data-speed="{{ section.settings.band2_speed }}">
          <span class="kin__run">{% for i in (1..8) %}{{ section.settings.band2_text }}{% if section.settings.band_separator != blank %} {{ section.settings.band_separator }} {% else %}&nbsp;{% endif %}{% endfor %}</span>
          <span class="kin__run">{% for i in (1..8) %}{{ section.settings.band2_text }}{% if section.settings.band_separator != blank %} {{ section.settings.band_separator }} {% else %}&nbsp;{% endif %}{% endfor %}</span>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="kin__inner">
    {%- if section.settings.image != blank -%}
      <div class="kin__media">
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1100, 1400',
            sizes: '(min-width: 750px) 40vw, 80vw',
            alt: section.settings.image.alt | default: section.settings.eyebrow
        }}
      </div>
    {%- endif -%}

    <div class="kin__card">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kin__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="kin__lead">{{ section.settings.lead | escape }}</p>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="kin__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="kin__button">
          {{ section.settings.button_label | escape }}
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5"></path></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var scrollBoost = {{ section.settings.scroll_boost }};

    function initKinetic() {
      var root = document.querySelector('#shopify-section-' + sectionId + ' [data-kin]');
      if (!root) return;

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var tracks = [];

      root.querySelectorAll('[data-kin-track]').forEach(function (el) {
        tracks.push({
          el: el,
          dir: parseFloat(el.dataset.dir) || -1,
          speed: parseFloat(el.dataset.speed) || 40,
          offset: 0,
          half: 0
        });
      });

      if (!tracks.length || reduce) return;

      function measure() {
        tracks.forEach(function (t) {
          var first = t.el.firstElementChild;
          t.half = first ? first.getBoundingClientRect().width : 0;
        });
      }

      measure();
      window.addEventListener('resize', measure);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(measure);
      }

      var boost = 0;
      var lastY = window.scrollY;
      var last = 0;
      var raf = null;
      var running = false;

      window.addEventListener('scroll', function () {
        var delta = Math.abs(window.scrollY - lastY);
        lastY = window.scrollY;
        boost = Math.min(scrollBoost, boost + delta * 14);
      }, { passive: true });

      function step(now) {
        if (!last) last = now;
        var dt = Math.min(now - last, 50);
        last = now;
        boost *= 0.90;

        tracks.forEach(function (t) {
          if (!t.half) return;
          t.offset += t.dir * (t.speed + boost) * dt / 1000;
          var x = t.offset % t.half;
          if (x > 0) x -= t.half;
          t.el.style.transform = 'translate3d(' + x + 'px, 0, 0)';
        });

        raf = window.requestAnimationFrame(step);
      }

      function start() {
        if (running) return;
        running = true;
        last = 0;
        raf = window.requestAnimationFrame(step);
      }

      function stop() {
        running = false;
        if (raf) window.cancelAnimationFrame(raf);
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries[0].isIntersecting ? start() : stop();
        }, { rootMargin: '200px' }).observe(root);
      } else {
        start();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKinetic);
    } else {
      initKinetic();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) initKinetic();
    });
  })();
</script>

{% schema %}
{
  "name": "Historien bag",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Lille tekst øverst", "default": "Since 2008" },
    { "type": "text", "id": "lead", "label": "Hovedsætning", "default": "Gear that earns its place in your bag." },
    { "type": "richtext", "id": "body", "label": "Brødtekst", "default": "<p>Skriv historien her. Hold den kort — tre til fem linjer.</p>" },
    { "type": "range", "id": "eyebrow_size", "label": "Størrelse på lille tekst", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "lead_size", "label": "Hovedsætning (computer)", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 25 },
    { "type": "range", "id": "lead_size_mobile", "label": "Hovedsætning (mobil)", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 21 },
    { "type": "select", "id": "lead_weight", "label": "Hovedsætningens tykkelse", "options": [{ "value": "400", "label": "Normal" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Halvfed" }, { "value": "700", "label": "Fed" }], "default": "500" },
    { "type": "range", "id": "body_size", "label": "Brødtekstens størrelse", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_opacity", "label": "Brødtekstens styrke", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 75 },

    { "type": "header", "content": "Knap" },
    { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Read the full story" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "color", "id": "button_background", "label": "Knapbaggrund", "default": "#e4661f" },
    { "type": "color", "id": "button_text_color", "label": "Knaptekstfarve", "default": "#0a0a0a" },
    { "type": "color", "id": "button_border_color", "label": "Knapkant", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Billede" },
    { "type": "image_picker", "id": "image", "label": "Fritlagt billede", "info": "Virker bedst som PNG uden baggrund." },
    { "type": "select", "id": "image_position", "label": "Billedets side", "options": [{ "value": "left", "label": "Venstre" }, { "value": "right", "label": "Højre" }], "default": "left" },
    { "type": "range", "id": "image_height", "label": "Billedhøjde (computer)", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 620 },
    { "type": "range", "id": "image_height_mobile", "label": "Billedhøjde (mobil)", "min": 160, "max": 560, "step": 10, "unit": "px", "default": 320 },
    { "type": "range", "id": "image_column_width", "label": "Billedspaltens bredde", "min": 25, "max": 60, "step": 5, "unit": "%", "default": 45 },
    { "type": "checkbox", "id": "show_image_mobile", "label": "Vis billedet på mobil", "default": true },

    { "type": "header", "content": "Bånd 1" },
    { "type": "text", "id": "band1_text", "label": "Tekst", "default": "HNDRD" },
    { "type": "select", "id": "band1_style", "label": "Stil", "options": [{ "value": "outline", "label": "Kun omrids" }, { "value": "solid", "label": "Massiv" }], "default": "outline" },
    { "type": "color", "id": "band1_color", "label": "Farve", "default": "#ffffff" },
    { "type": "range", "id": "band1_opacity", "label": "Styrke", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "band1_stroke_width", "label": "Omridsets tykkelse", "min": 1, "max": 5, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "band1_size", "label": "Størrelse (computer)", "min": 40, "max": 260, "step": 5, "unit": "px", "default": 150 },
    { "type": "range", "id": "band1_size_mobile", "label": "Størrelse (mobil)", "min": 30, "max": 140, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "band1_top", "label": "Lodret placering", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "band1_rotate", "label": "Hældning", "min": -15, "max": 15, "step": 1, "unit": "°", "default": -5 },
    { "type": "range", "id": "band1_spacing", "label": "Bogstavafstand", "min": -1, "max": 2, "step": 1, "unit": "em", "default": 0 },
    { "type": "range", "id": "band1_speed", "label": "Hastighed", "min": 10, "max": 200, "step": 5, "unit": "px", "default": 45 },
    { "type": "select", "id": "band1_direction", "label": "Retning", "options": [{ "value": "left", "label": "Mod venstre" }, { "value": "right", "label": "Mod højre" }], "default": "left" },
    { "type": "checkbox", "id": "band1_italic", "label": "Kursiv", "default": true },

    { "type": "header", "content": "Bånd 2" },
    { "type": "text", "id": "band2_text", "label": "Tekst", "default": "The story behind" },
    { "type": "select", "id": "band2_style", "label": "Stil", "options": [{ "value": "outline", "label": "Kun omrids" }, { "value": "solid", "label": "Massiv" }], "default": "solid" },
    { "type": "color", "id": "band2_color", "label": "Farve", "default": "#e4661f" },
    { "type": "range", "id": "band2_opacity", "label": "Styrke", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 90 },
    { "type": "range", "id": "band2_stroke_width", "label": "Omridsets tykkelse", "min": 1, "max": 5, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "band2_size", "label": "Størrelse (computer)", "min": 40, "max": 260, "step": 5, "unit": "px", "default": 110 },
    { "type": "range", "id": "band2_size_mobile", "label": "Størrelse (mobil)", "min": 30, "max": 140, "step": 5, "unit": "px", "default": 55 },
    { "type": "range", "id": "band2_top", "label": "Lodret placering", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "band2_rotate", "label": "Hældning", "min": -15, "max": 15, "step": 1, "unit": "°", "default": 4 },
    { "type": "range", "id": "band2_spacing", "label": "Bogstavafstand", "min": -1, "max": 2, "step": 1, "unit": "em", "default": 0 },
    { "type": "range", "id": "band2_speed", "label": "Hastighed", "min": 10, "max": 200, "step": 5, "unit": "px", "default": 30 },
    { "type": "select", "id": "band2_direction", "label": "Retning", "options": [{ "value": "left", "label": "Mod venstre" }, { "value": "right", "label": "Mod højre" }], "default": "right" },
    { "type": "checkbox", "id": "band2_italic", "label": "Kursiv", "default": false },

    { "type": "header", "content": "Bånd — fælles" },
    { "type": "text", "id": "band_separator", "label": "Tegn mellem gentagelser", "default": "·" },
    { "type": "select", "id": "band_weight", "label": "Tykkelse", "options": [{ "value": "600", "label": "Halvfed" }, { "value": "700", "label": "Fed" }, { "value": "800", "label": "Ekstra fed" }, { "value": "900", "label": "Sort" }], "default": "800" },
    { "type": "range", "id": "scroll_boost", "label": "Ekstra fart ved scroll", "min": 0, "max": 1200, "step": 50, "unit": "px", "default": 500, "info": "0 slår effekten fra, så båndene bare glider jævnt." },

    { "type": "header", "content": "Kort" },
    { "type": "color", "id": "card_background", "label": "Kortets baggrund", "default": "rgba(10,10,10,0.92)" },
    { "type": "range", "id": "card_padding", "label": "Luft inde i kortet", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "card_radius", "label": "Runde hjørner", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "card_border_width", "label": "Kantlinje", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "card_border_color", "label": "Kantlinjens farve", "default": "rgba(255,255,255,0.12)" },
    { "type": "range", "id": "card_max_width", "label": "Kortets bredde", "min": 320, "max": 700, "step": 20, "unit": "px", "default": 460 },

    { "type": "header", "content": "Sektion" },
    { "type": "color", "id": "bg_color", "label": "Baggrundsfarve", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Tekstfarve", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accentfarve", "default": "#e4661f" },
    { "type": "range", "id": "max_width", "label": "Indholdets maksbredde", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "side_padding", "label": "Luft ud til kanten", "min": 12, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "column_gap", "label": "Afstand mellem billede og kort", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
