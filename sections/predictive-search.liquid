{%- if predictive_search.performed -%}<div id="predictive-search-results" role="listbox">{%- assign hs_r = predictive_search.resources -%}{%- if hs_r.queries.size > 0 or hs_r.products.size > 0 or hs_r.collections.size > 0 or hs_r.pages.size > 0 or hs_r.articles.size > 0 -%}<div id="predictive-search-results-groups-wrapper" class="predictive-search__results-groups-wrapper hs-grid">{%- if hs_r.queries.size > 0 or hs_r.collections.size > 0 or hs_r.pages.size > 0 or hs_r.articles.size > 0 -%}<div class="hs-side">{%- if hs_r.queries.size > 0 -%}<div class="hs-group"><h2 id="predictive-search-queries" class="hs-h">{{ 'templates.search.suggestions' | t }}</h2><ul id="predictive-search-results-queries-list" class="hs-links list-unstyled" role="group" aria-labelledby="predictive-search-queries">{%- for hs_q in hs_r.queries -%}<li id="predictive-search-option-query-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_q.url }}" class="predictive-search__item hs-link" tabindex="-1">{{ hs_q.styled_text }}</a></li>{%- endfor -%}</ul></div>{%- endif -%}{%- if hs_r.collections.size > 0 -%}<div class="hs-group"><h2 id="predictive-search-collections" class="hs-h">{%- case request.locale.iso_code -%}{%- when 'da' or 'sv' -%}Kollektioner{%- when 'de' -%}Kollektionen{%- else -%}Collections{%- endcase -%}</h2><ul class="hs-links list-unstyled" role="group" aria-labelledby="predictive-search-collections">{%- for hs_c in hs_r.collections -%}<li id="predictive-search-option-collection-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_c.url }}" class="predictive-search__item hs-link" tabindex="-1">{{ hs_c.title | escape }}</a></li>{%- endfor -%}</ul></div>{%- endif -%}{%- if hs_r.pages.size > 0 or hs_r.articles.size > 0 -%}<div class="hs-group"><h2 id="predictive-search-pages" class="hs-h">{{ 'templates.search.pages' | t }}</h2><ul class="hs-links list-unstyled" role="group" aria-labelledby="predictive-search-pages">{%- for hs_pg in hs_r.pages -%}<li id="predictive-search-option-page-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_pg.url }}" class="predictive-search__item hs-link" tabindex="-1">{{ hs_pg.title | escape }}</a></li>{%- endfor -%}{%- for hs_a in hs_r.articles -%}<li id="predictive-search-option-article-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_a.url }}" class="predictive-search__item hs-link" tabindex="-1">{{ hs_a.title | escape }}</a></li>{%- endfor -%}</ul></div>{%- endif -%}</div>{%- endif -%}{%- if hs_r.products.size > 0 -%}<div class="hs-main"><h2 id="predictive-search-products" class="hs-h">{{ 'templates.search.products' | t }}</h2><ul id="predictive-search-results-products-list" class="hs-products list-unstyled" role="group" aria-labelledby="predictive-search-products">{%- for hs_p in hs_r.products limit: 4 -%}<li id="predictive-search-option-product-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ hs_p.url }}" class="predictive-search__item hs-prod" tabindex="-1"><span class="hs-thumb">{%- if hs_p.featured_media -%}{{ hs_p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: hs_p.title }}{%- endif -%}</span><span class="hs-info">{%- if hs_p.type != blank -%}<span class="hs-type">{{ hs_p.type | escape }}</span>{%- endif -%}<span class="hs-title">{{ hs_p.title | escape }}</span></span><span class="hs-price">{{ hs_p.price_min | money }}</span></a></li>{%- endfor -%}</ul></div>{%- endif -%}</div>{%- endif -%}<span class="hidden" data-predictive-search-live-region-count-value>{{ predictive_search.resources.products.size }}</span><div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button"><button class="predictive-search__item predictive-search__item--term hs-all" tabindex="-1" role="option" aria-selected="false"><span data-predictive-search-search-for-text>{{ 'templates.search.search_for' | t: terms: predictive_search.terms }}</span><span aria-hidden="true">→</span></button></div></div>{%- endif -%}