{%- comment -%}
  HUNDRED – Contact
  Simpel kontaktside i HUNDRED-stil. Bruger Shopifys egen kontaktformular,
  så beskeder sendes til butikkens e-mail (Indstillinger → Butiksoplysninger).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">

<style>
  .hct{
    --bg:#0a0a0b;--panel:#131315;--line:#2a2722;--text:#f3efe7;--soft:#cfc9be;--muted:#8c867b;
    --gold:#f2a81d;--ember:#e5701a;--warn:#ff8a65;--ok:#7bc47f;
    --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;
    --body:"Barlow","Helvetica Neue",Arial,sans-serif;
    background:var(--bg);color:var(--text);font:16px/1.6 var(--body);letter-spacing:0;
    padding-block:clamp(60px,10vh,110px);
  }
  .hct *{box-sizing:border-box}
  .hct-wrap{max-width:1080px;margin-inline:auto;padding-inline:clamp(16px,4vw,32px)}
  .hct .hct-title{font:italic 900 clamp(52px,8vw,100px)/.86 var(--display);text-transform:uppercase;margin:0 0 14px;letter-spacing:-.01em;
    background:linear-gradient(180deg,#ffc94a,var(--gold) 45%,var(--ember));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hct-intro{color:var(--soft);max-width:56ch;margin:0 0 48px}
  .hct-intro p{margin:0}

  .hct-grid{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:clamp(24px,4vw,56px);align-items:start}
  .hct-grid > *{min-width:0}

  .hct-info{display:grid;gap:12px}
  .hct-item{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:18px 20px;display:grid;gap:4px}
  .hct-item span{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
  .hct-item a,.hct-item p{color:var(--text);text-decoration:none;font-weight:600;font-size:17px;margin:0;overflow-wrap:anywhere}
  .hct-item a:hover{color:var(--gold)}
  .hct-item small{color:var(--muted);font-size:14px}

  .hct-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:clamp(20px,4vw,36px)}
  .hct-form{display:grid;gap:16px}
  .hct-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:16px}
  .hct-field{display:grid;gap:8px}
  .hct-field label{font-weight:600;font-size:15px}
  .hct-req{color:var(--gold)}
  .hct input[type=text],.hct input[type=email],.hct input[type=tel],.hct textarea{
    width:100%;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:12px 14px;min-height:48px;
    font:inherit;font-size:16px;letter-spacing:0;box-shadow:none}
  .hct textarea{min-height:150px;resize:vertical}
  .hct input:focus,.hct textarea:focus{outline:2px solid var(--gold);outline-offset:0;border-color:transparent}
  .hct-consent{display:flex;gap:12px;align-items:flex-start;color:var(--soft);font-size:14px;cursor:pointer}
  .hct-consent input{width:20px;height:20px;margin:1px 0 0;accent-color:var(--gold);flex:none}
  .hct .hct-btn{justify-self:start;border:0;border-radius:999px;padding:16px 34px;background:var(--gold);color:#000;
    font:700 14px/1 var(--body);letter-spacing:.16em;text-transform:uppercase;cursor:pointer;transition:background .2s}
  .hct .hct-btn:hover{background:#ffbb3a}
  .hct .hct-btn:focus-visible,.hct a:focus-visible{outline:2px solid var(--text);outline-offset:3px}
  .hct-msg{border-radius:8px;padding:14px 16px;font-size:15px}
  .hct-msg--ok{border:1px solid var(--ok);color:var(--ok)}
  .hct-msg--error{border:1px solid var(--warn);color:var(--warn)}
  .hct-msg ul{margin:6px 0 0;padding-left:18px}

  @media (max-width:820px){
    .hct-grid{grid-template-columns:minmax(0,1fr)}
  }
</style>

<div class="hct" id="hct-{{ section.id }}">
  <div class="hct-wrap">
    <h1 class="hct-title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="hct-intro">{{ section.settings.intro }}</div>{%- endif -%}

    <div class="hct-grid">
      <aside class="hct-info">
        {%- if section.settings.email != blank -%}
          <div class="hct-item"><span>Email</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="hct-item"><span>Phone / WhatsApp</span>
            <a href="https://wa.me/{{ section.settings.phone | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener noreferrer">{{ section.settings.phone }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="hct-item"><span>Address</span><p>{{ section.settings.address | newline_to_br }}</p></div>
        {%- endif -%}
        {%- if section.settings.response != blank -%}
          <div class="hct-item"><span>Response time</span><small>{{ section.settings.response | escape }}</small></div>
        {%- endif -%}
      </aside>

      <div class="hct-card">
        {%- assign hct_form_id = 'ContactForm-' | append: section.id -%}
        {%- form 'contact', id: hct_form_id, class: 'hct-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="hct-msg hct-msg--ok" role="status" tabindex="-1" autofocus>{{ section.settings.success | escape }}</div>
          {%- elsif form.errors -%}
            <div class="hct-msg hct-msg--error" role="alert" tabindex="-1" autofocus>
              Please check the form:
              <ul>
                {%- for field in form.errors -%}
                  <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{% endif %}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="hct-row">
            <div class="hct-field">
              <label for="hct-name-{{ section.id }}">Name</label>
              <input type="text" id="hct-name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="hct-field">
              <label for="hct-email-{{ section.id }}">Email <span class="hct-req">*</span></label>
              <input type="email" id="hct-email-{{ section.id }}" name="contact[email]" autocomplete="email" required autocorrect="off" autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
          </div>

          <div class="hct-field">
            <label for="hct-phone-{{ section.id }}">Phone</label>
            <input type="tel" id="hct-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>

          <div class="hct-field">
            <label for="hct-body-{{ section.id }}">Message <span class="hct-req">*</span></label>
            <textarea id="hct-body-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
          </div>

          <label class="hct-consent">
            <input type="checkbox" name="contact[consent]" value="yes" required>
            <span>{{ section.settings.consent | escape }}</span>
          </label>

          <button type="submit" class="hct-btn">{{ section.settings.button | escape }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HUNDRED Contact",
  "tag": "section",
  "class": "section-hundred-contact",
  "settings": [
    { "type": "text", "id": "title", "label": "Overskrift", "default": "Contact us" },
    { "type": "richtext", "id": "intro", "label": "Indledning", "default": "<p>Questions about an order, a product or a partnership? Send us a message and we'll get back to you.</p>" },
    { "type": "header", "content": "Kontaktoplysninger" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "jakob@sportbiz.dk" },
    { "type": "text", "id": "phone", "label": "Telefon / WhatsApp", "default": "+45 31 31 04 49" },
    { "type": "textarea", "id": "address", "label": "Adresse", "default": "Marielundvej 45B, ground floor\n2730 Herlev\nDenmark" },
    { "type": "text", "id": "response", "label": "Svartid", "default": "We usually reply within 1–2 business days." },
    { "type": "header", "content": "Formular" },
    { "type": "text", "id": "consent", "label": "Samtykke-tekst", "default": "I agree that my personal information may be used to respond to my enquiry." },
    { "type": "text", "id": "button", "label": "Knaptekst", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Tak-besked", "default": "Thank you! We have received your message and will get back to you soon." }
  ],
  "presets": [{ "name": "HUNDRED Contact" }]
}
{% endschema %}
