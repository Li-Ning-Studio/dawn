{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0

  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and section.blocks.size > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign card_ratio = '3 / 4'
    when 'landscape'
      assign card_ratio = '4 / 3'
    when 'wide'
      assign card_ratio = '16 / 9'
    else
      assign card_ratio = '1 / 1'
  endcase

  case section.settings.text_position_vertical
    when 'top'
      assign justify = 'flex-start'
    when 'middle'
      assign justify = 'center'
    else
      assign justify = 'flex-end'
  endcase

  case section.settings.text_position_horizontal
    when 'center'
      assign align = 'center'
      assign text_align = 'center'
    when 'right'
      assign align = 'flex-end'
      assign text_align = 'right'
    else
      assign align = 'flex-start'
      assign text_align = 'left'
  endcase

  case section.settings.card_heading_size
    when 'small'
      assign heading_font = '1.8rem'
      assign heading_font_desktop = '2.2rem'
    when 'large'
      assign heading_font = '2.6rem'
      assign heading_font_desktop = '3.6rem'
    else
      assign heading_font = '2.2rem'
      assign heading_font_desktop = '2.8rem'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Slider-{{ section.id }} .collection-card {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    text-decoration: none;
    color: inherit;
  }

  #Slider-{{ section.id }} .collection-card__media {
    position: relative;
    aspect-ratio: {{ card_ratio }};
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.04);
  }

  #Slider-{{ section.id }} .collection-card__media img,
  #Slider-{{ section.id }} .collection-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  #Slider-{{ section.id }} .collection-card:hover .collection-card__media img {
    transform: scale(1.04);
  }

  {%- if section.settings.overlay_opacity > 0 -%}
    #Slider-{{ section.id }} .collection-card__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
        rgba(0, 0, 0, 0) 65%
      );
      pointer-events: none;
    }
  {%- endif -%}

  #Slider-{{ section.id }} .collection-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ justify }};
    align-items: {{ align }};
    text-align: {{ text_align }};
    padding: 2rem;
    pointer-events: none;
    color: {{ section.settings.overlay_text_color }};
  }

  #Slider-{{ section.id }} .collection-card__heading {
    margin: 0;
    font-size: {{ heading_font }};
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: inherit;
  }

  #Slider-{{ section.id }} .collection-card__text {
    margin: 0.6rem 0 0;
    font-size: 1.4rem;
    line-height: 1.4;
    max-width: 32ch;
    color: inherit;
  }

  #Slider-{{ section.id }} .collection-card:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
  }

  @media screen and (min-width: 750px) {
    #Slider-{{ section.id }} .collection-card__content {
      padding: 2.8rem;
    }

    #Slider-{{ section.id }} .collection-card__heading {
      font-size: {{ heading_font_desktop }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #Slider-{{ section.id }} .collection-card__media img {
      transition: none;
    }

    #Slider-{{ section.id }} .collection-card:hover .collection-card__media img {
      transform: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider or show_desktop_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider or show_desktop_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="collection-list-title inline-richtext {{ section.settings.heading_size }}"
        >
          {{ section.settings.title }}
        </h2>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="collection-list grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_mobile_slider or show_desktop_slider %} slider slider--tablet grid--peek{% endif %}{% if show_desktop_slider %} slider--desktop{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_collection = block.settings.collection
            assign card_image = block.settings.image | default: card_collection.featured_image

            assign card_heading = block.settings.heading
            if card_heading == blank
              assign card_heading = card_collection.title
            endif

            assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
            assign placeholder_image = 'collection-apparel-' | append: placeholder_index
          -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-list__item grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            
              href="{{ card_collection.url | default: '#' }}"
              class="collection-card"
              {% if card_collection == blank %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              <div class="collection-card__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      widths: '275,400,550,700,900,1100,1500',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw'
                  }}
                {%- else -%}
                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="collection-card__content">
                {%- if card_heading != blank -%}
                  <span class="collection-card__heading {{ section.settings.card_heading_style }}">
                    {{- card_heading -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="collection-card__text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons{% unless show_mobile_slider %} small-hide medium-hide{% endunless %}{% unless show_desktop_slider %} large-up-hide{% endunless %}">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
        
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "hxl", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "hxxl", "label": "t:sections.all.heading_size.options__5.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "square", "label": "Kvadratisk" },
        { "value": "portrait", "label": "Stående" },
        { "value": "landscape", "label": "Liggende" },
        { "value": "wide", "label": "Bred" }
      ],
      "default": "square",
      "label": "Billedformat"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Antal synlige kort på desktop"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": true,
      "label": "Swipe med pile på desktop",
      "info": "Tilføj så mange kollektioner du vil. Kortene beholder deres størrelse, og resten kan man bladre til."
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Afrundede hjørner"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Tekst på billedet"
    },
    {
      "type": "select",
      "id": "text_position_vertical",
      "options": [
        { "value": "top", "label": "Øverst" },
        { "value": "middle", "label": "Midt" },
        { "value": "bottom", "label": "Nederst" }
      ],
      "default": "bottom",
      "label": "Lodret placering"
    },
    {
      "type": "select",
      "id": "text_position_horizontal",
      "options": [
        { "value": "left", "label": "Venstre" },
        { "value": "center", "label": "Midt" },
        { "value": "right", "label": "Højre" }
      ],
      "default": "left",
      "label": "Vandret placering"
    },
    {
      "type": "select",
      "id": "card_heading_size",
      "options": [
        { "value": "small", "label": "Lille" },
        { "value": "medium", "label": "Mellem" },
        { "value": "large", "label": "Stor" }
      ],
      "default": "medium",
      "label": "Tekststørrelse"
    },
    {
      "type": "select",
      "id": "card_heading_style",
      "options": [
        { "value": "h3", "label": "Normal" },
        { "value": "h3 uppercase", "label": "Versaler" }
      ],
      "default": "h3",
      "label": "Tekststil"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "default": "#ffffff",
      "label": "Tekstfarve"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40,
      "label": "Mørk overgang bag teksten",
      "info": "Gør teksten læsbar på lyse billeder. Sæt til 0 for at fjerne den."
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.collection-list.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.collection-list.settings.columns_mobile.options__2.label" }
      ],
      "default": "1",
      "label": "t:sections.collection-list.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "Knap"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede",
          "info": "Valgfrit. Uden billede bruges kollektionens eget."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Overskrift på billedet",
          "info": "Tomt felt betyder, at kollektionens navn bruges."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Undertekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}