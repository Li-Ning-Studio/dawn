<style>
.lnp-section{background:#000;padding:80px 24px}
.lnp-inner{max-width:1400px;margin:0 auto}
.lnp-eyebrow{text-align:center;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#9a9a9a;margin:0 0 12px}
.lnp-title{text-align:center;font-size:clamp(32px,5vw,56px);font-weight:800;color:#fff;letter-spacing:-.5px;margin:0 0 48px;text-transform:uppercase}
.lnp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.lnp-card{position:relative;display:block;border-radius:16px;overflow:hidden;background:#111;text-decoration:none;transition:transform .35s ease}
.lnp-card:hover{transform:translateY(-6px)}
.lnp-media{position:relative;aspect-ratio:3/4;overflow:hidden;background:#242424}
.lnp-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}
.lnp-card:hover .lnp-media img{transform:scale(1.06)}
.lnp-fade{position:absolute;inset:auto 0 0 0;height:55%;background:linear-gradient(to top,rgba(0,0,0,.85),transparent);pointer-events:none}
.lnp-badge{position:absolute;left:16px;bottom:16px;background:#000;color:#fff;font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;padding:6px 12px;border-radius:6px}
.lnp-info{padding:18px}
.lnp-name{font-size:19px;font-weight:700;color:#fff;margin:0}
.lnp-meta{font-size:13px;color:#8a8a8a;margin:5px 0 0}
.lnp-link{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:#fff;margin-top:16px;padding-top:14px;border-top:1px solid #2e2e2e}
.lnp-link svg{transition:transform .3s ease}
.lnp-card:hover .lnp-link svg{transform:translateX(5px)}
.lnp-cta{display:block;width:fit-content;margin:48px auto 0;background:#fff;color:#000;font-size:15px;font-weight:700;padding:15px 38px;border-radius:999px;text-decoration:none;transition:opacity .25s ease}
.lnp-cta:hover{opacity:.85}
@media(max-width:1024px){.lnp-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.lnp-section{padding:56px 16px}.lnp-grid{grid-template-columns:1fr;gap:16px}}
</style>

<section class="lnp-section">
  <div class="lnp-inner">
    {% if section.settings.eyebrow != blank %}
      <p class="lnp-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="lnp-title">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="lnp-grid">
      {% for block in section.blocks %}
        <a class="lnp-card" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="lnp-media">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 800 }}"
                   alt="{{ block.settings.name | escape }}"
                   width="800" height="1067" loading="lazy">
            {% endif %}
            <span class="lnp-fade"></span>
            {% if block.settings.badge != blank %}
              <span class="lnp-badge">{{ block.settings.badge }}</span>
            {% endif %}
          </div>
          <div class="lnp-info">
            <p class="lnp-name">{{ block.settings.name }}</p>
            {% if block.settings.meta != blank %}
              <p class="lnp-meta">{{ block.settings.meta }}</p>
            {% endif %}
            {% if block.settings.link_text != blank %}
              <span class="lnp-link">{{ block.settings.link_text }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank %}
      <a class="lnp-cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Our players",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sponsored by Li-Ning" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our players" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Meet all our players" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "player",
      "name": "Player",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (portrait 3:4)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Player name" },
        { "type": "text", "id": "meta", "label": "Subtitle", "default": "Plays Axforce 90 Dragon" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Men's singles" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop their gear" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Our players",
      "blocks": [
        { "type": "player" },
        { "type": "player" },
        { "type": "player" },
        { "type": "player" }
      ]
    }
  ]
}
{% endschema %}