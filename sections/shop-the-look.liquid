{%- comment -%}
  HUNDRED – Shop the look
  Look-billede med 2 prikker + 2 produktkort. Billede og produkter hentes fra
  produktets metafelter (navnene skrives i Tilpas). Prikkernes placering
  styres med skydere og gælder hele skabelonen.
  Priser følger kundens katalog automatisk (B2B ser B2B-priser).
{%- endcomment -%}

{%- liquid
  assign k_img = section.settings.mf_image | strip | split: '.'
  assign k_p1 = section.settings.mf_product_1 | strip | split: '.'
  assign k_p2 = section.settings.mf_product_2 | strip | split: '.'

  assign look_img = product.metafields[k_img[0]][k_img[1]].value
  assign p1 = product.metafields[k_p1[0]][k_p1[1]].value
  assign p2 = product.metafields[k_p2[0]][k_p2[1]].value

  assign count = 1
  assign total = product.selected_or_first_available_variant.price
  if p1 != blank
    assign count = count | plus: 1
    assign total = total | plus: p1.selected_or_first_available_variant.price
  endif
  if p2 != blank
    assign count = count | plus: 1
    assign total = total | plus: p2.selected_or_first_available_variant.price
  endif
-%}

{%- if look_img != blank and p1 != blank or look_img != blank and p2 != blank -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">

<style>
  .hsl{--ink:#0a0a0b;--soft:#5d584f;--muted:#8c867b;--line:#e7e3dc;--panel:#f5f3ef;--gold:#f2a81d;--ember:#e5701a;
    --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;--body:"Barlow","Helvetica Neue",Arial,sans-serif;
    background:#fff;color:var(--ink);font-family:var(--body);letter-spacing:0;padding-block:clamp(40px,6vw,80px)}
  .hsl *{box-sizing:border-box}
  .hsl a{color:inherit;text-decoration:none}
  .hsl-wrap{max-width:var(--page-width,1440px);margin-inline:auto;padding-inline:clamp(16px,4.4vw,64px);
    display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(28px,4vw,56px);align-items:center}

  /* Billede */
  .hsl-look{position:relative;aspect-ratio:1;background:var(--panel);border-radius:16px;overflow:hidden}
  .hsl-in{position:absolute;top:3%;bottom:3%;left:50%;transform:translateX(-50%);aspect-ratio:var(--ar);max-width:94%;mix-blend-mode:multiply}
  .hsl-in > img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block}

  /* Prikker */
  .hsl-pin{position:absolute;width:0;height:0;z-index:2}
  .hsl .hsl-dot{position:absolute;left:0;top:0;width:38px;height:38px;margin:-19px 0 0 -19px;padding:0;border:0;border-radius:50%;cursor:pointer;
    background:#fff;color:var(--ink);font:800 15px/1 var(--body);display:grid;place-items:center;box-shadow:0 6px 18px rgba(0,0,0,.18);transition:transform .2s,background .2s,color .2s}
  .hsl-dot::before{content:"";position:absolute;inset:-8px;border-radius:50%;border:2px solid var(--gold);opacity:.55;transition:opacity .2s,inset .2s;animation:hsl-pulse 2.4s ease-out infinite}
  .hsl-pin.is-on .hsl-dot{background:var(--ink);color:#fff;transform:scale(1.12)}
  .hsl-pin.is-on .hsl-dot::before{opacity:1;inset:-7px;animation:none}
  @keyframes hsl-pulse{0%{transform:scale(.9);opacity:.7}70%{transform:scale(1.25);opacity:0}100%{opacity:0}}

  .hsl-pop{position:absolute;left:30px;top:0;transform:translateY(-50%) scale(.96);opacity:0;visibility:hidden;transition:opacity .2s,transform .2s,visibility 0s .2s;
    display:grid;grid-template-columns:56px auto;gap:10px;align-items:center;background:#fff;border-radius:12px;padding:8px 14px 8px 8px;
    box-shadow:0 14px 34px rgba(0,0,0,.16);white-space:nowrap;mix-blend-mode:normal}
  .hsl-pin--flip .hsl-pop{left:auto;right:30px}
  .hsl-pop::before{content:"";position:absolute;right:100%;top:0;bottom:0;width:16px}
  .hsl-pin--flip .hsl-pop::before{right:auto;left:100%}
  .hsl-pin.is-on .hsl-pop{opacity:1;visibility:visible;transform:translateY(-50%) scale(1);transition:opacity .2s,transform .2s}
  .hsl-pop-t{width:56px;height:56px;border-radius:8px;background:var(--panel);display:grid;place-items:center;overflow:hidden}
  .hsl-pop-t img{max-width:86%;max-height:86%;object-fit:contain;mix-blend-mode:multiply}
  .hsl-pop b{display:block;font-size:14px;line-height:1.3}
  .hsl-pop span{font-size:13px;color:var(--soft)}

  /* Højre side */
  .hsl-side{display:grid;gap:22px;min-width:0}
  .hsl-over{margin:0;font-size:12px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--ember)}
  .hsl .hsl-title{margin:8px 0 0;font:italic 900 clamp(38px,4vw,56px)/.95 var(--display);text-transform:uppercase;letter-spacing:-.005em;color:var(--ink)}
  .hsl-title em{font-style:inherit;color:var(--ember)}
  .hsl-lead{margin:0;color:var(--soft);font-size:16px;max-width:38ch}

  .hsl-cards{display:grid;gap:12px}
  .hsl-card{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:18px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:14px;position:relative;transition:border-color .2s,box-shadow .2s}
  .hsl-card:hover,.hsl-card.is-on{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
  .hsl-card-t{aspect-ratio:1;border-radius:10px;background:var(--panel);display:grid;place-items:center;overflow:hidden}
  .hsl-card-t img{width:84%;height:84%;object-fit:contain;mix-blend-mode:multiply}
  .hsl-n{position:absolute;left:-8px;top:-8px;width:26px;height:26px;border-radius:50%;background:#fff;border:1px solid var(--line);display:grid;place-items:center;font-size:12px;font-weight:800}
  .hsl-card.is-on .hsl-n{background:var(--ink);color:#fff;border-color:var(--ink)}
  .hsl-card b{display:block;font-size:16px;line-height:1.3}
  .hsl-card small{display:block;color:var(--muted);font-size:13px}
  .hsl-pr{font-weight:600;margin-top:4px;font-variant-numeric:tabular-nums}
  .hsl-go{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;transition:background .2s,color .2s}
  .hsl-card:hover .hsl-go,.hsl-card.is-on .hsl-go{background:var(--ink);color:#fff;border-color:var(--ink)}
  .hsl-go svg{width:18px;height:18px}

  .hsl-total{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:16px;font-size:14px;color:var(--soft)}
  .hsl-total b{font-size:20px;color:var(--ink);font-variant-numeric:tabular-nums}
  .hsl .hsl-dot:focus-visible,.hsl a:focus-visible{outline:2px solid var(--ink);outline-offset:3px}

  @media (max-width:749px){
    .hsl-wrap{grid-template-columns:1fr;gap:16px}
    .hsl-side{display:contents}
    .hsl-head{order:-1}
    .hsl-lead{display:none}
    .hsl .hsl-title{font-size:38px}
    .hsl-look{aspect-ratio:4/5}
    .hsl .hsl-dot{width:30px;height:30px;margin:-15px 0 0 -15px;font-size:13px}
    .hsl-pop{display:none}
    .hsl-cards{grid-template-columns:1fr 1fr;gap:10px}
    .hsl-card{grid-template-columns:1fr;gap:8px;padding:8px;align-items:start}
    .hsl-n{left:14px;top:14px;width:22px;height:22px;font-size:11px;z-index:1}
    .hsl-card b{font-size:13px}
    .hsl-card small{display:none}
    .hsl-pr{font-size:13px;margin-top:2px}
    .hsl-go{display:none}
    .hsl-total{font-size:13px}
  }
  @media (prefers-reduced-motion:reduce){.hsl-dot::before{animation:none}}
</style>

{%- capture arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}

<div class="hsl" id="hsl-{{ section.id }}">
  <div class="hsl-wrap">
    <div class="hsl-look">
      <div class="hsl-in" style="--ar:{{ look_img.aspect_ratio | default: 0.6 }}">
        {{ look_img | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', alt: section.settings.heading }}

        {%- for i in (1..2) -%}
          {%- if i == 1 -%}
            {%- assign p = p1 -%}{%- assign px = section.settings.dot1_x -%}{%- assign py = section.settings.dot1_y -%}
          {%- else -%}
            {%- assign p = p2 -%}{%- assign px = section.settings.dot2_x -%}{%- assign py = section.settings.dot2_y -%}
          {%- endif -%}
          {%- if p != blank -%}
            <div class="hsl-pin{% if px > 60 %} hsl-pin--flip{% endif %}" style="left:{{ px }}%;top:{{ py }}%" data-i="{{ i }}">
              <button type="button" class="hsl-dot" aria-label="{{ i }}: {{ p.title | escape }}">{{ i }}</button>
              <a class="hsl-pop" href="{{ p.url }}" tabindex="-1">
                <span class="hsl-pop-t">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
                <span><b>{{ p.title | escape }}</b><span>{{ p.selected_or_first_available_variant.price | money }} →</span></span>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="hsl-side">
      <div class="hsl-head">
        {%- if section.settings.overline != blank -%}<p class="hsl-over">{{ section.settings.overline | escape }}</p>{%- endif -%}
        <h2 class="hsl-title">{{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.lead != blank -%}<p class="hsl-lead">{{ section.settings.lead | escape }}</p>{%- endif -%}

      <div class="hsl-cards">
        {%- for i in (1..2) -%}
          {%- if i == 1 -%}{%- assign p = p1 -%}{%- else -%}{%- assign p = p2 -%}{%- endif -%}
          {%- if p != blank -%}
            <a class="hsl-card" href="{{ p.url }}" data-i="{{ i }}">
              <span class="hsl-n">{{ i }}</span>
              <span class="hsl-card-t">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '(min-width: 750px) 110px, 45vw', loading: 'lazy', alt: p.title }}{%- endif -%}</span>
              <span>
                <b>{{ p.title | escape }}</b>
                {%- if p.type != blank -%}<small>{{ p.type | escape }}</small>{%- endif -%}
                <span class="hsl-pr">{{ p.selected_or_first_available_variant.price | money }}</span>
              </span>
              <span class="hsl-go">{{ arrow }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_total -%}
        <div class="hsl-total"><span>{{ section.settings.total_label | escape }} · {{ count }} items</span><b>{{ total | money }}</b></div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('hsl-{{ section.id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var pins = root.querySelectorAll('.hsl-pin');
  var cards = root.querySelectorAll('.hsl-card');
  var hover = window.matchMedia('(hover: hover)').matches;

  function set(i){
    pins.forEach(function(p){ p.classList.toggle('is-on', p.dataset.i === i); });
    cards.forEach(function(c){ c.classList.toggle('is-on', c.dataset.i === i); });
  }
  pins.forEach(function(p){
    var dot = p.querySelector('.hsl-dot');
    if (hover) {
      p.addEventListener('mouseenter', function(){ set(p.dataset.i); });
      p.addEventListener('mouseleave', function(){ set(null); });
    }
    dot.addEventListener('focus', function(){ set(p.dataset.i); });
    dot.addEventListener('click', function(){
      // Mobil/klik: første tryk viser produktet, andet tryk åbner det
      if (p.classList.contains('is-on') && !hover) { window.location = p.querySelector('.hsl-pop').href; return; }
      if (hover) { window.location = p.querySelector('.hsl-pop').href; return; }
      set(p.dataset.i);
    });
  });
  cards.forEach(function(c){
    if (hover) {
      c.addEventListener('mouseenter', function(){ set(c.dataset.i); });
      c.addEventListener('mouseleave', function(){ set(null); });
    }
  });
})();
</script>
{%- elsif request.design_mode -%}
  <div style="padding:40px 24px;text-align:center;font:15px/1.5 Barlow,Arial,sans-serif;color:#5d584f;background:#f5f3ef">
    <b>HUNDRED Shop the look:</b> Dette produkt mangler look-billede eller produkter i metafelterne
    ({{ section.settings.mf_image }}, {{ section.settings.mf_product_1 }}, {{ section.settings.mf_product_2 }}). Sektionen vises ikke for kunderne.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HUNDRED Shop the look",
  "tag": "section",
  "class": "section-hundred-shop-the-look",
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "overline", "label": "Overlinje", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Overskrift (sort)", "default": "Complete" },
    { "type": "text", "id": "heading_accent", "label": "Overskrift (orange)", "default": "the look" },
    { "type": "text", "id": "lead", "label": "Kort tekst (kun computer)", "default": "Hover the dots to shop each piece." },
    { "type": "checkbox", "id": "show_total", "label": "Vis samlet pris for hele looket", "default": true },
    { "type": "text", "id": "total_label", "label": "Tekst ved samlet pris", "default": "Complete look" },

    { "type": "header", "content": "Metafelter", "info": "Skriv navnene præcis som i Indstillinger → Brugerdefinerede data → Produkter, fx custom.look_billede" },
    { "type": "text", "id": "mf_image", "label": "Metafelt til look-billedet", "default": "custom.look_billede" },
    { "type": "text", "id": "mf_product_1", "label": "Metafelt til produkt 1 (prik 1)", "default": "custom.look_shorts" },
    { "type": "text", "id": "mf_product_2", "label": "Metafelt til produkt 2 (prik 2)", "default": "custom.look_sko" },

    { "type": "header", "content": "Prikkernes placering", "info": "I procent af billedet. Venstre kant er 0, højre kant er 100. Top er 0, bund er 100." },
    { "type": "range", "id": "dot1_x", "label": "Prik 1 – vandret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 44 },
    { "type": "range", "id": "dot1_y", "label": "Prik 1 – lodret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 61 },
    { "type": "range", "id": "dot2_x", "label": "Prik 2 – vandret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "dot2_y", "label": "Prik 2 – lodret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 89 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "HUNDRED Shop the look" }]
}
{% endschema %}
