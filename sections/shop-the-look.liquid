{%- liquid
  assign look_image = product.metafields.custom.look_image.value
  assign p1 = product.metafields.custom.look_product_1.value
  assign p2 = product.metafields.custom.look_product_2.value

  assign image_is_file = false
  if look_image.src != blank or look_image.url != blank
    assign image_is_file = true
  endif

  assign image_is_url = false
  unless image_is_file
    assign image_string = look_image | strip
    if image_string contains '//'
      assign image_is_url = true
    endif
  endunless

  assign has_look = false
  if image_is_file or image_is_url
    if p1 != blank or p2 != blank
      assign has_look = true
    endif
  endif
-%}

{%- if request.design_mode and has_look == false -%}
  <div style="padding:24px;background:#fff3cd;color:#664d03;font-size:14px;line-height:1.6;border:1px solid #ffe69c;">
    <strong>Shop looket kan ikke vises endnu.</strong><br>
    Billede fundet som fil: {{ image_is_file }}<br>
    Billede fundet som adresse: {{ image_is_url }}<br>
    Rå værdi af metafeltet: {{ product.metafields.custom.look_image }}<br>
    Produkt 1: {% if p1 != blank %}{{ p1.title }}{% else %}ikke fundet{% endif %}<br>
    Produkt 2: {% if p2 != blank %}{{ p2.title }}{% else %}ikke fundet{% endif %}
  </div>
{%- endif -%}

{%- if has_look -%}
<style>
  #shopify-section-{{ section.id }} .stl {
    box-sizing: border-box;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | divided_by: 2 }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  #shopify-section-{{ section.id }} .stl__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .stl__heading {
    margin: 0 0 {{ section.settings.heading_space }}px;
    font-family: var(--font-heading-family, inherit);
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    {% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
    {% if section.settings.heading_italic %}font-style: italic;{% endif %}
    text-align: {{ section.settings.heading_align }};
  }

  #shopify-section-{{ section.id }} .stl__stage {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .stl__stage > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #shopify-section-{{ section.id }} .stl__spot {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .stl__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    box-shadow: 0 0 0 {{ section.settings.dot_ring }}px {{ section.settings.dot_ring_color }};
    cursor: pointer;
    display: block;
    position: relative;
  }

  #shopify-section-{{ section.id }} .stl__dot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .stl__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.55;
    animation: stl-pulse-{{ section.id }} 2.4s ease-out infinite;
  }

  @keyframes stl-pulse-{{ section.id }} {
    0%   { transform: scale(1); opacity: 0.5; }
    70%  { transform: scale(2.1); opacity: 0; }
    100% { transform: scale(2.1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .stl__dot::after { animation: none; }
  }

  #shopify-section-{{ section.id }} .stl__card {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    transform: translateX(-50%) translateY(6px);
    width: {{ section.settings.card_width }}px;
    max-width: 78vw;
    box-sizing: border-box;
    padding: 12px;
    background: {{ section.settings.card_background }};
    color: {{ section.settings.card_text_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    display: flex;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .stl__spot.is-open .stl__card,
  #shopify-section-{{ section.id }} .stl__spot:hover .stl__card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  #shopify-section-{{ section.id }} .stl__card img {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 8px;
    background: rgba(127,127,127,0.12);
  }

  #shopify-section-{{ section.id }} .stl__card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .stl__card-name {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .stl__card-price {
    font-size: 13px;
    font-weight: 700;
    color: {{ section.settings.price_color }};
  }

  #shopify-section-{{ section.id }} .stl__card-compare {
    font-size: 12px;
    text-decoration: line-through;
    opacity: 0.55;
    margin-left: 6px;
    font-weight: 400;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .stl {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .stl__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
  }
</style>

<div class="stl">
  <div class="stl__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="stl__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="stl__stage" data-stl>
      {%- if image_is_file -%}
        {{
          look_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1100, 1400, 1600',
            sizes: '(min-width: 750px) 50vw, 92vw',
            alt: product.title
        }}
      {%- else -%}
        <img src="{{ look_image | strip }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- endif -%}

      {%- for n in (1..2) -%}
        {%- liquid
          if n == 1
            assign item = p1
            assign pos_x = section.settings.dot1_x
            assign pos_y = section.settings.dot1_y
          else
            assign item = p2
            assign pos_x = section.settings.dot2_x
            assign pos_y = section.settings.dot2_y
          endif
        -%}
        {%- if item != blank -%}
          <div class="stl__spot" style="left: {{ pos_x }}%; top: {{ pos_y }}%;" data-stl-spot>
            <button type="button" class="stl__dot" aria-label="{{ item.title | escape }}" data-stl-dot></button>
            <a class="stl__card" href="{{ item.url }}">
              {%- if item.featured_image != blank -%}
                {{ item.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '64px', alt: '' }}
              {%- endif -%}
              <span class="stl__card-text">
                <span class="stl__card-name">{{ item.title }}</span>
                <span class="stl__card-price">
                  {{ item.price | money }}
                  {%- if item.compare_at_price > item.price -%}
                    <span class="stl__card-compare">{{ item.compare_at_price | money }}</span>
                  {%- endif -%}
                </span>
              </span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function initLook() {
      var stage = document.querySelector('#shopify-section-' + sectionId + ' [data-stl]');
      if (!stage) return;

      var spots = stage.querySelectorAll('[data-stl-spot]');

      spots.forEach(function (spot) {
        var dot = spot.querySelector('[data-stl-dot]');
        if (!dot) return;

        dot.addEventListener('click', function (event) {
          event.stopPropagation();
          var wasOpen = spot.classList.contains('is-open');
          spots.forEach(function (s) { s.classList.remove('is-open'); });
          if (!wasOpen) spot.classList.add('is-open');
        });
      });

      document.addEventListener('click', function () {
        spots.forEach(function (s) { s.classList.remove('is-open'); });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLook);
    } else {
      initLook();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) initLook();
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Shop looket",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Prikkernes placering", "info": "Måles i procent af billedet. Venstre kant er 0, højre kant er 100. Top er 0, bund er 100." },
    { "type": "range", "id": "dot1_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 1 — vandret", "default": 50 },
    { "type": "range", "id": "dot1_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 1 — lodret", "default": 42 },
    { "type": "range", "id": "dot2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 2 — vandret", "default": 50 },
    { "type": "range", "id": "dot2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 2 — lodret", "default": 68 },

    { "type": "header", "content": "Prikkernes udseende" },
    { "type": "range", "id": "dot_size", "min": 10, "max": 40, "step": 2, "unit": "px", "label": "Størrelse", "default": 18 },
    { "type": "color", "id": "dot_color", "label": "Farve", "default": "#ffffff" },
    { "type": "range", "id": "dot_ring", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Ring omkring", "default": 2 },
    { "type": "color", "id": "dot_ring_color", "label": "Ringens farve", "default": "rgba(0,0,0,0.35)" },

    { "type": "header", "content": "Produktkortet" },
    { "type": "range", "id": "card_width", "min": 200, "max": 360, "step": 10, "unit": "px", "label": "Bredde", "default": 260 },
    { "type": "color", "id": "card_background", "label": "Baggrund", "default": "#ffffff" },
    { "type": "color", "id": "card_text_color", "label": "Tekstfarve", "default": "#121212" },
    { "type": "color", "id": "card_border_color", "label": "Kantlinje", "default": "rgba(0,0,0,0.1)" },
    { "type": "color", "id": "price_color", "label": "Prisens farve", "default": "#121212" },

    { "type": "header", "content": "Overskrift" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Shop looket" },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Store bogstaver", "default": true },
    { "type": "checkbox", "id": "heading_italic", "label": "Kursiv", "default": true },
    { "type": "range", "id": "heading_size", "min": 18, "max": 72, "step": 2, "unit": "px", "label": "Størrelse (computer)", "default": 38 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Størrelse (mobil)", "default": 26 },
    { "type": "select", "id": "heading_weight", "label": "Tykkelse", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Halvfed" }, { "value": "700", "label": "Fed" }, { "value": "800", "label": "Ekstra fed" }], "default": "800" },
    { "type": "select", "id": "heading_align", "label": "Placering", "options": [{ "value": "left", "label": "Venstre" }, { "value": "center", "label": "Midten" }, { "value": "right", "label": "Højre" }], "default": "left" },
    { "type": "range", "id": "heading_space", "min": 8, "max": 60, "step": 2, "unit": "px", "label": "Afstand ned til billedet", "default": 24 },

    { "type": "header", "content": "Sektion" },
    { "type": "color", "id": "bg_color", "label": "Baggrundsfarve", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Tekstfarve", "default": "#121212" },
    { "type": "range", "id": "image_width", "min": 400, "max": 1200, "step": 20, "unit": "px", "label": "Billedets bredde", "default": 700 },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Runde hjørner", "default": 0 },
    { "type": "range", "id": "max_width", "min": 600, "max": 1600, "step": 20, "unit": "px", "label": "Indholdets maksbredde", "default": 1280 },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Luft ud til kanten", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Afstand over", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Afstand under", "default": 64 }
  ],
  "presets": [{ "name": "Shop looket" }]
}
{% endschema %}