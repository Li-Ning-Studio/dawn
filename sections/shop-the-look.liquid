{%- liquid
  assign img_parts = section.settings.mf_image | split: '.'
  assign p1_parts = section.settings.mf_product_1 | split: '.'
  assign p2_parts = section.settings.mf_product_2 | split: '.'

  assign look_image = product.metafields[img_parts[0]][img_parts[1]].value
  assign p1 = product.metafields[p1_parts[0]][p1_parts[1]].value
  assign p2 = product.metafields[p2_parts[0]][p2_parts[1]].value

  assign image_is_file = false
  if look_image.src != blank or look_image.url != blank
    assign image_is_file = true
  endif

  assign image_is_url = false
  unless image_is_file
    assign image_string = look_image | strip
    if image_string contains '//'
      assign image_is_url = true
    endif
  endunless

  assign has_look = false
  if image_is_file or image_is_url
    if p1 != blank or p2 != blank
      assign has_look = true
    endif
  endif
-%}

{%- if request.design_mode and has_look == false -%}
  <div style="padding:24px;background:#fff3cd;color:#664d03;font-size:14px;line-height:1.7;border:1px solid #ffe69c;">
    <strong>Shop looket kan ikke vises endnu.</strong><br><br>
    Kopier de rigtige navne herunder ind i sektionens indstillinger under "Metafelter".<br><br>
    {%- for namespace in product.metafields -%}
      {%- for field in namespace[1] -%}
        <code style="background:#fff;padding:2px 6px;border-radius:4px;">{{ namespace[0] }}.{{ field[0] }}</code><br>
      {%- endfor -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{%- if has_look -%}
<style>
  #shopify-section-{{ section.id }} .stl {
    box-sizing: border-box;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | divided_by: 2 }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  #shopify-section-{{ section.id }} .stl__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .stl__heading {
    margin: 0 0 {{ section.settings.heading_space }}px;
    font-family: var(--font-heading-family, inherit);
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    {% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
    {% if section.settings.heading_italic %}font-style: italic;{% endif %}
    text-align: {{ section.settings.heading_align }};
  }

  #shopify-section-{{ section.id }} .stl__layout {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .stl__stage {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
  }

  #shopify-section-{{ section.id }} .stl__stage > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #shopify-section-{{ section.id }} .stl__dot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    box-shadow: 0 0 0 {{ section.settings.dot_ring }}px {{ section.settings.dot_ring_color }};
    cursor: pointer;
    z-index: 3;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .stl__dot:hover,
  #shopify-section-{{ section.id }} .stl__dot.is-active {
    transform: translate(-50%, -50%) scale(1.25);
  }

  #shopify-section-{{ section.id }} .stl__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.5;
    animation: stl-pulse-{{ section.id }} 2.4s ease-out infinite;
  }

  #shopify-section-{{ section.id }} .stl__dot.is-active::after {
    animation: none;
  }

  @keyframes stl-pulse-{{ section.id }} {
    0%   { transform: scale(1); opacity: 0.5; }
    70%  { transform: scale(2.1); opacity: 0; }
    100% { transform: scale(2.1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .stl__dot::after { animation: none; }
  }

  /* Produktkolonnen til højre */

  #shopify-section-{{ section.id }} .stl__panel {
    position: relative;
    flex: 1;
    min-height: {{ section.settings.panel_min_height }}px;
  }

  #shopify-section-{{ section.id }} .stl__product {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: {{ section.settings.panel_align }};
  }

  #shopify-section-{{ section.id }} .stl__product:not(.is-active) {
    display: none;
  }

  #shopify-section-{{ section.id }} .stl__product-media {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.panel_image_width }}px;
    margin-bottom: 20px;
    {% if section.settings.panel_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if section.settings.panel_align == 'right' %}margin-left: auto;{% endif %}
  }

  #shopify-section-{{ section.id }} .stl__product-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.panel_image_radius }}px;
  }

  #shopify-section-{{ section.id }} .stl__badges {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .stl__badge {
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .stl__badge--save {
    background: {{ section.settings.save_badge_bg }};
    color: {{ section.settings.save_badge_color }};
  }

  #shopify-section-{{ section.id }} .stl__badge--stock {
    background: {{ section.settings.stock_badge_bg }};
    color: {{ section.settings.stock_badge_color }};
  }

  #shopify-section-{{ section.id }} .stl__product-name {
    display: block;
    margin: 0;
    font-size: {{ section.settings.panel_name_size }}px;
    font-weight: 700;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .stl__product-price {
    display: block;
    margin-top: 8px;
    font-size: {{ section.settings.panel_price_size }}px;
    font-weight: 600;
    color: {{ section.settings.price_color }};
  }

  #shopify-section-{{ section.id }} .stl__product-compare {
    margin-left: 10px;
    text-decoration: line-through;
    opacity: 0.5;
    font-weight: 400;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .stl__hint {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .stl {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .stl__heading {
      font-size: {{ section.settings.heading_size }}px;
    }

    #shopify-section-{{ section.id }} .stl__layout {
      flex-direction: row;
      align-items: center;
      gap: {{ section.settings.column_gap }}px;
    }

    #shopify-section-{{ section.id }} .stl__stage {
      flex: 0 0 {{ section.settings.image_column_width }}%;
    }
  }
</style>

<div class="stl">
  <div class="stl__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="stl__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="stl__layout" data-stl>
      <div class="stl__stage">
        {%- if image_is_file -%}
          {{
            look_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1100, 1400, 1600',
              sizes: '(min-width: 750px) 50vw, 92vw',
              alt: product.title
          }}
        {%- else -%}
          <img src="{{ look_image | strip }}" alt="{{ product.title | escape }}" loading="lazy">
        {%- endif -%}

        {%- if p1 != blank -%}
          <button type="button" class="stl__dot" style="left: {{ section.settings.dot1_x }}%; top: {{ section.settings.dot1_y }}%;" data-stl-dot="1" aria-label="{{ p1.title | escape }}"></button>
        {%- endif -%}
        {%- if p2 != blank -%}
          <button type="button" class="stl__dot" style="left: {{ section.settings.dot2_x }}%; top: {{ section.settings.dot2_y }}%;" data-stl-dot="2" aria-label="{{ p2.title | escape }}"></button>
        {%- endif -%}
      </div>

      <div class="stl__panel">
        {%- for n in (1..2) -%}
          {%- liquid
            if n == 1
              assign item = p1
            else
              assign item = p2
            endif
          -%}
          {%- if item != blank -%}
            {%- liquid
              assign saving = 0
              if item.compare_at_price > item.price
                assign saving = item.compare_at_price | minus: item.price
              endif
            -%}
            <a class="stl__product" href="{{ item.url }}" data-stl-product="{{ n }}">
              <div class="stl__product-media">
                {%- if item.featured_image != blank -%}
                  {{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', sizes: '(min-width: 750px) 30vw, 80vw', alt: item.title }}
                {%- endif -%}
                <div class="stl__badges">
                  {%- if saving > 0 and section.settings.show_save_badge -%}
                    <span class="stl__badge stl__badge--save">{{ section.settings.save_badge_text }} {{ saving | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                  {%- if section.settings.show_stock_badge and item.available and item.selected_or_first_available_variant.inventory_quantity > 0 and item.selected_or_first_available_variant.inventory_quantity <= section.settings.stock_threshold -%}
                    <span class="stl__badge stl__badge--stock">{{ section.settings.stock_badge_text }}</span>
                  {%- endif -%}
                </div>
              </div>
              <span class="stl__product-name">{{ item.title }}</span>
              <span class="stl__product-price">
                {{ item.price | money }}
                {%- if item.compare_at_price > item.price -%}
                  <span class="stl__product-compare">{{ item.compare_at_price | money }}</span>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.hint != blank -%}
          <p class="stl__hint">{{ section.settings.hint | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function initLook() {
      var root = document.querySelector('#shopify-section-' + sectionId + ' [data-stl]');
      if (!root) return;

      var dots = root.querySelectorAll('[data-stl-dot]');
      var products = root.querySelectorAll('[data-stl-product]');
      if (!dots.length || !products.length) return;

      function show(key) {
        products.forEach(function (p) {
          p.classList.toggle('is-active', p.dataset.stlProduct === key);
        });
        dots.forEach(function (d) {
          d.classList.toggle('is-active', d.dataset.stlDot === key);
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('mouseenter', function () { show(dot.dataset.stlDot); });
        dot.addEventListener('focus', function () { show(dot.dataset.stlDot); });
        dot.addEventListener('click', function (e) { e.preventDefault(); show(dot.dataset.stlDot); });
      });

      show(dots[0].dataset.stlDot);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLook);
    } else {
      initLook();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) initLook();
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Shop looket",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Metafelter", "info": "Skriv navnene præcis som de står i den gule kasse på produktsiden." },
    { "type": "text", "id": "mf_image", "label": "Metafelt til look-billedet", "default": "custom.look_billede" },
    { "type": "text", "id": "mf_product_1", "label": "Metafelt til produkt 1", "default": "custom.look_shorts" },
    { "type": "text", "id": "mf_product_2", "label": "Metafelt til produkt 2", "default": "custom.look_sko" },

    { "type": "header", "content": "Prikkernes placering", "info": "Måles i procent af billedet. Venstre kant er 0, højre kant er 100. Top er 0, bund er 100." },
    { "type": "range", "id": "dot1_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 1 — vandret", "default": 44 },
    { "type": "range", "id": "dot1_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 1 — lodret", "default": 61 },
    { "type": "range", "id": "dot2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 2 — vandret", "default": 50 },
    { "type": "range", "id": "dot2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Prik 2 — lodret", "default": 89 },

    { "type": "header", "content": "Prikkernes udseende" },
    { "type": "range", "id": "dot_size", "min": 10, "max": 50, "step": 2, "unit": "px", "label": "Størrelse", "default": 28 },
    { "type": "color", "id": "dot_color", "label": "Farve", "default": "#ffffff" },
    { "type": "range", "id": "dot_ring", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Ring omkring", "default": 2 },
    { "type": "color", "id": "dot_ring_color", "label": "Ringens farve", "default": "rgba(0,0,0,0.25)" },

    { "type": "header", "content": "Produktet til højre" },
    { "type": "range", "id": "panel_image_width", "min": 200, "max": 600, "step": 10, "unit": "px", "label": "Produktbilledets bredde", "default": 420 },
    { "type": "range", "id": "panel_image_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Runde hjørner", "default": 0 },
    { "type": "range", "id": "panel_min_height", "min": 200, "max": 700, "step": 20, "unit": "px", "label": "Mindste højde", "default": 420, "info": "Holder højden ens når du skifter mellem produkterne." },
    { "type": "select", "id": "panel_align", "label": "Justering", "options": [{ "value": "left", "label": "Venstre" }, { "value": "center", "label": "Midten" }, { "value": "right", "label": "Højre" }], "default": "left" },
    { "type": "range", "id": "panel_name_size", "min": 14, "max": 30, "step": 1, "unit": "px", "label": "Navnets størrelse", "default": 18 },
    { "type": "range", "id": "panel_price_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Prisens størrelse", "default": 17 },
    { "type": "color", "id": "price_color", "label": "Prisens farve", "default": "#c8102e" },
    { "type": "text", "id": "hint", "label": "Lille hjælpetekst", "default": "Hold musen over prikkerne", "info": "Tøm feltet for at fjerne den." },

    { "type": "header", "content": "Mærkater" },
    { "type": "checkbox", "id": "show_save_badge", "label": "Vis besparelse", "default": true },
    { "type": "text", "id": "save_badge_text", "label": "Tekst før beløbet", "default": "Spar" },
    { "type": "color", "id": "save_badge_bg", "label": "Besparelsens baggrund", "default": "#000000" },
    { "type": "color", "id": "save_badge_color", "label": "Besparelsens tekstfarve", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_stock_badge", "label": "Vis 'få tilbage'", "default": true },
    { "type": "text", "id": "stock_badge_text", "label": "Tekst", "default": "Få tilbage" },
    { "type": "range", "id": "stock_threshold", "min": 1, "max": 20, "step": 1, "unit": "stk", "label": "Vis når lageret er under", "default": 5 },
    { "type": "color", "id": "stock_badge_bg", "label": "Baggrund", "default": "#e01b24" },
    { "type": "color", "id": "stock_badge_color", "label": "Tekstfarve", "default": "#ffffff" },

    { "type": "header", "content": "Overskrift" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Shop looket" },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Store bogstaver", "default": true },
    { "type": "checkbox", "id": "heading_italic", "label": "Kursiv", "default": true },
    { "type": "range", "id": "heading_size", "min": 18, "max": 72, "step": 2, "unit": "px", "label": "Størrelse (computer)", "default": 38 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Størrelse (mobil)", "default": 26 },
    { "type": "select", "id": "heading_weight", "label": "Tykkelse", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Halvfed" }, { "value": "700", "label": "Fed" }, { "value": "800", "label": "Ekstra fed" }], "default": "800" },
    { "type": "select", "id": "heading_align", "label": "Placering", "options": [{ "value": "left", "label": "Venstre" }, { "value": "center", "label": "Midten" }, { "value": "right", "label": "Højre" }], "default": "left" },
    { "type": "range", "id": "heading_space", "min": 8, "max": 60, "step": 2, "unit": "px", "label": "Afstand ned til billedet", "default": 32 },

    { "type": "header", "content": "Sektion" },
    { "type": "color", "id": "bg_color", "label": "Baggrundsfarve", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Tekstfarve", "default": "#121212" },
    { "type": "range", "id": "image_width", "min": 300, "max": 900, "step": 20, "unit": "px", "label": "Look-billedets bredde", "default": 620 },
    { "type": "range", "id": "image_column_width", "min": 30, "max": 70, "step": 5, "unit": "%", "label": "Look-billedets spaltebredde", "default": 50 },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Runde hjørner", "default": 0 },
    { "type": "range", "id": "column_gap", "min": 20, "max": 140, "step": 4, "unit": "px", "label": "Afstand mellem spalterne", "default": 60 },
    { "type": "range", "id": "max_width", "min": 600, "max": 1600, "step": 20, "unit": "px", "label": "Indholdets maksbredde", "default": 1280 },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Luft ud til kanten", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Afstand over", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Afstand under", "default": 64 }
  ],
  "presets": [{ "name": "Shop looket" }]
}
{% endschema %}