{%- comment -%}
  HUNDRED – Hero slideshow
  Fast format på computer og mobil, uanset billedernes størrelse (billeder/video beskæres).
  Hver slide: billede ELLER video til computer + billede ELLER video til mobil,
  overlinje, overskrift med guld-ord, kort tekst, mærker og én Shop-knap.
  Skifter selv, med pile, prikker, pause-knap, swipe og piletaster.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800;1,900&family=Barlow:wght@500;600;700&display=swap">

<style>
  #hhs-{{ section.id }}{--ar-d:{{ section.settings.ratio_desktop }};--ar-m:{{ section.settings.ratio_mobile }}}
  .hhs{
    --gold:#f2a81d;--ember:#e5701a;--text:#f3efe7;--soft:#e2ddd4;--line:#2a2722;
    --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;
    --body:"Barlow","Helvetica Neue",Arial,sans-serif;
    --pad:clamp(24px,3.75vw,72px);
    position:relative;width:100%;aspect-ratio:var(--ar-d);overflow:hidden;background:#000;color:var(--text);font-family:var(--body);letter-spacing:0;
  }
  .hhs *{box-sizing:border-box}
  .hhs-track{position:absolute;inset:0}
  .hhs-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .9s ease,visibility 0s linear .9s}
  .hhs-slide.is-active{opacity:1;visibility:visible;transition:opacity .9s ease,visibility 0s}

  /* Medier fylder altid hele feltet og beskæres – formatet ændrer sig aldrig */
  .hhs-media{position:absolute;inset:0}
  .hhs-slide--right .hhs-media{left:20%}
  .hhs-media picture,.hhs-dev{position:absolute;inset:0;display:block}
  .hhs-media img,.hhs-media video,.hhs-media svg{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;display:block;border:0}
  .hhs-media svg{background:#131315;fill:#2a2722}
  .hhs-media img,.hhs-media video{object-position:var(--pos-d,center) center;filter:brightness(var(--bri,1))}
  .hhs-dev--m{display:none}

  .hhs-deco{position:absolute;inset:0;pointer-events:none}
  .hhs-deco::before{content:"";position:absolute;width:1000px;height:1000px;left:62%;top:50%;transform:translate(-50%,-50%);border-radius:50%;
    background:radial-gradient(circle,rgba(242,168,29,.38),rgba(229,112,26,.12) 45%,transparent 70%)}
  .hhs-deco::after{content:"";position:absolute;inset:0;opacity:.07;
    background:repeating-linear-gradient(45deg,#f3efe7 0 1px,transparent 1px 14px),repeating-linear-gradient(-45deg,#f3efe7 0 1px,transparent 1px 14px);
    -webkit-mask:radial-gradient(circle at 62% 50%,#000,transparent 45%);mask:radial-gradient(circle at 62% 50%,#000,transparent 45%)}

  .hhs-shade{position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(90deg,rgba(0,0,0,.85) 0%,rgba(0,0,0,.55) 28%,transparent 55%),linear-gradient(180deg,transparent 70%,rgba(0,0,0,.55) 100%)}
  .hhs-slide--right .hhs-shade{background:linear-gradient(90deg,#000 0%,#000 22%,rgba(0,0,0,.6) 30%,transparent 40%),linear-gradient(180deg,transparent 72%,rgba(0,0,0,.5) 100%)}

  .hhs-copy{position:absolute;left:var(--pad);top:50%;transform:translateY(-50%);max-width:560px;display:grid;gap:16px;justify-items:start;z-index:2}
  .hhs-slide .hhs-copy > *{opacity:0;translate:0 18px;transition:opacity .7s ease,translate .7s ease}
  .hhs-slide.is-active .hhs-copy > *{opacity:1;translate:0 0}
  .hhs-slide.is-active .hhs-copy > :nth-child(2){transition-delay:.08s}
  .hhs-slide.is-active .hhs-copy > :nth-child(3){transition-delay:.16s}
  .hhs-slide.is-active .hhs-copy > :nth-child(n+4){transition-delay:.24s}

  .hhs-over{margin:0;font-weight:700;font-size:15px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}
  .hhs .hhs-h{margin:0;font:italic 900 clamp(56px,6.4vw,124px)/.86 var(--display);text-transform:uppercase;letter-spacing:-.005em;color:var(--text)}
  .hhs-h em{font-style:inherit;background:linear-gradient(180deg,#ffd25a,var(--gold) 50%,var(--ember));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:var(--gold);padding-right:.04em}
  .hhs-sub{margin:0;font-weight:500;font-size:19px;line-height:1.45;color:var(--soft);max-width:34ch}
  .hhs-tags{display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0;list-style:none}
  .hhs-tags li{border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--soft);background:rgba(0,0,0,.35)}
  .hhs .hhs-btn{display:inline-block;margin-top:8px;padding:17px 34px;border-radius:999px;background:var(--gold);color:#000;text-decoration:none;
    font:700 13px/1 var(--body);letter-spacing:.16em;text-transform:uppercase;transition:background .2s,transform .2s}
  .hhs .hhs-btn:hover{background:#ffbb3a;transform:translateY(-1px)}

  .hhs-credit{position:absolute;right:56px;bottom:44px;z-index:2;margin:0;font-size:13px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(243,239,231,.7)}
  .hhs-credit b{color:var(--gold)}

  /* Pile, prikker og pause */
  .hhs-ctrl{position:absolute;left:var(--pad);bottom:32px;z-index:3;display:flex;align-items:center;gap:14px}
  .hhs .hhs-arrow,.hhs .hhs-pause{width:44px;height:44px;flex:none;display:grid;place-items:center;padding:0;margin:0;border-radius:50%;
    border:1.5px solid rgba(243,239,231,.45);background:rgba(0,0,0,.35);color:var(--text);cursor:pointer;transition:border-color .2s,color .2s,background .2s}
  .hhs .hhs-arrow:hover,.hhs .hhs-pause:hover{border-color:var(--gold);color:var(--gold)}
  .hhs-arrow svg,.hhs-pause svg{width:18px;height:18px;display:block}
  .hhs-pause .i-play{display:none}
  .hhs-pause[aria-pressed="true"] .i-play{display:block}
  .hhs-pause[aria-pressed="true"] .i-pause{display:none}
  .hhs-dots{display:flex;gap:8px}
  .hhs-dot{width:40px;height:24px;padding:0;margin:0;border:0;background:none;cursor:pointer;position:relative}
  .hhs-dot::before{content:"";position:absolute;left:0;right:0;top:50%;height:3px;margin-top:-1.5px;border-radius:3px;background:rgba(243,239,231,.3);transition:background .3s}
  .hhs-dot[aria-current="true"]::before{background:var(--gold)}
  .hhs .hhs-btn:focus-visible,.hhs .hhs-dot:focus-visible,.hhs .hhs-arrow:focus-visible,.hhs .hhs-pause:focus-visible{outline:2px solid var(--text);outline-offset:3px}
  .hhs-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  @media (max-width:749px){
    .hhs{aspect-ratio:var(--ar-m)}
    .hhs-slide--right .hhs-media{left:0}
    .hhs-dev--d{display:none}
    .hhs-dev--m{display:block}
    .hhs-media img,.hhs-media video{object-position:var(--pos-m,center) var(--pos-my,top);filter:brightness(var(--bri-m,1))}
    .hhs-deco::before{width:520px;height:520px;left:50%;top:32%}
    .hhs-deco::after{-webkit-mask:radial-gradient(circle at 50% 30%,#000,transparent 55%);mask:radial-gradient(circle at 50% 30%,#000,transparent 55%)}
    .hhs-shade,.hhs-slide--right .hhs-shade{background:linear-gradient(180deg,transparent 42%,rgba(0,0,0,.8) 64%,#000 88%)}
    .hhs-copy{left:22px;right:22px;top:auto;bottom:80px;transform:none;max-width:none;gap:10px}
    .hhs-over{font-size:10px;letter-spacing:.28em}
    .hhs .hhs-h{font-size:clamp(44px,14vw,64px)}
    .hhs-br{display:none}
    .hhs-sub{font-size:15px}
    .hhs-tags{gap:8px}
    .hhs-tags li{font-size:10px;padding:6px 11px}
    .hhs .hhs-btn{margin-top:6px;padding:14px 26px;font-size:12px}
    .hhs-credit{display:none}
    .hhs-ctrl{left:22px;right:22px;bottom:18px;gap:10px}
    .hhs .hhs-arrow,.hhs .hhs-pause{width:38px;height:38px}
    .hhs-dots{gap:6px}
    .hhs-dot{width:22px}
  }
  @media (prefers-reduced-motion:reduce){
    .hhs-slide,.hhs-slide .hhs-copy > *{transition:none}
  }
</style>

{%- liquid
  assign hero_prio = 'auto'
  if section.index == 1
    assign hero_prio = 'high'
  endif

  # B2B = kunden er logget ind og har B2B-tagget (eller er en Shopify B2B-virksomhedskunde)
  assign is_b2b = false
  if customer
    if customer.tags contains section.settings.b2b_tag
      assign is_b2b = true
    endif
    if customer.b2b?
      assign is_b2b = true
    endif
  endif

  # Tæl de slides, denne kunde må se
  assign visible_count = 0
  for block in section.blocks
    assign b = block.settings
      assign show = false
      if b.show_b2c and is_b2b == false
        assign show = true
      endif
      if b.show_b2b and is_b2b
        assign show = true
      endif
      if request.design_mode and section.settings.editor_show_all
        if b.show_b2c or b.show_b2b
          assign show = true
        endif
      endif
    if show
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  assign vi = 0
-%}

<div class="hhs" id="hhs-{{ section.id }}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}"
  data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="hhs-track" aria-live="{% if section.settings.autoplay %}off{% else %}polite{% endif %}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign show = false
      if b.show_b2c and is_b2b == false
        assign show = true
      endif
      if b.show_b2b and is_b2b
        assign show = true
      endif
      if request.design_mode and section.settings.editor_show_all
        if b.show_b2c or b.show_b2b
          assign show = true
        endif
      endif
    -%}
    {%- unless show -%}{%- continue -%}{%- endunless -%}
    {%- liquid
      assign vi = vi | plus: 1
      if vi == 1
        assign is_first = true
      else
        assign is_first = false
      endif
      assign dv = b.video_desktop
      assign di = b.image_desktop
      assign mv = b.video_mobile
      assign mi = b.image_mobile
      if is_first
        assign load = 'eager'
        assign prio = hero_prio
      else
        assign load = 'lazy'
        assign prio = 'auto'
      endif
      assign alt_text = b.heading | append: ' ' | append: b.heading_gold | strip
      assign d_sizes = '100vw'
      if b.layout == 'right'
        assign d_sizes = '80vw'
      endif
    -%}
    {%- capture pos_style -%}--pos-d:{{ b.position_desktop }};--pos-m:{{ b.position_mobile }};--pos-my:{{ b.position_mobile_y }};--bri:{{ b.brightness | divided_by: 100.0 }};--bri-m:{{ b.brightness_mobile | divided_by: 100.0 }}{%- endcapture -%}

    <div class="hhs-slide{% if b.layout == 'right' %} hhs-slide--right{% endif %}{% if is_first %} is-active{% endif %}"
      role="group" aria-roledescription="slide" aria-label="{{ vi }} / {{ visible_count }}"
      {% unless is_first %}aria-hidden="true" inert{% endunless %} {{ block.shopify_attributes }}>

      <div class="hhs-media" style="{{ pos_style }}">
        {%- if dv == blank and mv == blank -%}
          {%- comment -%} Kun billeder: ét <picture>, som selv vælger mobil- eller computerbilledet {%- endcomment -%}
          {%- assign img_d = di | default: mi -%}
          {%- if img_d != blank -%}
            <picture>
              {%- if mi != blank -%}
                <source media="(max-width: 749px)"
                  srcset="{{ mi | image_url: width: 750 }} 750w, {{ mi | image_url: width: 1100 }} 1100w, {{ mi | image_url: width: 1500 }} 1500w"
                  sizes="100vw">
              {%- endif -%}
              <img src="{{ img_d | image_url: width: 1920 }}"
                srcset="{{ img_d | image_url: width: 750 }} 750w, {{ img_d | image_url: width: 1100 }} 1100w, {{ img_d | image_url: width: 1500 }} 1500w, {{ img_d | image_url: width: 1920 }} 1920w, {{ img_d | image_url: width: 2400 }} 2400w, {{ img_d | image_url: width: 3000 }} 3000w"
                sizes="(min-width: 750px) {{ d_sizes }}, 100vw"
                width="{{ img_d.width }}" height="{{ img_d.height }}"
                alt="{{ img_d.alt | default: alt_text | escape }}" loading="{{ load }}" fetchpriority="{{ prio }}">
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        {%- else -%}
          {%- comment -%} Video med: hver enhed får sit eget medie. Mangler en enhed, bruges den andens. {%- endcomment -%}
          <div class="hhs-dev hhs-dev--d">
            {%- if dv != blank -%}
              {{ dv | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hhs-vid' }}
            {%- elsif di != blank -%}
              {{ di | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: d_sizes, loading: load, fetchpriority: prio, alt: alt_text }}
            {%- elsif mv != blank -%}
              {{ mv | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hhs-vid' }}
            {%- else -%}
              {{ mi | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: d_sizes, loading: load, fetchpriority: prio, alt: alt_text }}
            {%- endif -%}
          </div>
          <div class="hhs-dev hhs-dev--m">
            {%- if mv != blank -%}
              {{ mv | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hhs-vid' }}
            {%- elsif mi != blank -%}
              {{ mi | image_url: width: 1500 | image_tag: widths: '750, 1100, 1500', sizes: '100vw', loading: 'lazy', alt: alt_text }}
            {%- elsif dv != blank -%}
              {{ dv | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hhs-vid' }}
            {%- else -%}
              {{ di | image_url: width: 1500 | image_tag: widths: '750, 1100, 1500', sizes: '100vw', loading: 'lazy', alt: alt_text }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if b.glow -%}<div class="hhs-deco" aria-hidden="true"></div>{%- endif -%}
      {%- if b.shade -%}<div class="hhs-shade" aria-hidden="true"></div>{%- endif -%}

      <div class="hhs-copy">
        {%- if b.overline != blank -%}<p class="hhs-over">{{ b.overline | escape }}</p>{%- endif -%}
        {%- if b.heading != blank or b.heading_gold != blank -%}
          {%- if is_first and section.settings.first_is_h1 -%}{%- assign htag = 'h1' -%}{%- else -%}{%- assign htag = 'h2' -%}{%- endif -%}
          <{{ htag }} class="hhs-h">{{ b.heading | escape }}{% if b.heading_gold != blank %}{% if b.heading != blank %}{% case b.gold_join %}{% when 'newline' %}<br class="hhs-br"> {% when 'space' %} {% endcase %}{% endif %}<em>{{ b.heading_gold | escape }}</em>{% endif %}</{{ htag }}>
        {%- endif -%}
        {%- if b.text != blank -%}<p class="hhs-sub">{{ b.text | escape }}</p>{%- endif -%}
        {%- if b.tags != blank -%}
          <ul class="hhs-tags">
            {%- assign tags = b.tags | split: ',' -%}
            {%- for t in tags -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<li>{{ tt | escape }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if b.button_label != blank -%}
          <a class="hhs-btn" href="{{ b.button_link | default: routes.all_products_collection_url }}">{{ b.button_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if b.credit != blank -%}<p class="hhs-credit">{{ b.credit }}</p>{%- endif -%}
    </div>
  {%- endfor -%}
  </div>

  {%- if visible_count > 1 -%}
    <div class="hhs-ctrl">
      <button type="button" class="hhs-arrow" data-dir="-1" aria-label="Previous slide" aria-controls="hhs-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <div class="hhs-dots">
        {%- for n in (1..visible_count) -%}
          <button type="button" class="hhs-dot" aria-label="Show slide {{ n }} of {{ visible_count }}" aria-current="{% if n == 1 %}true{% else %}false{% endif %}"></button>
        {%- endfor -%}
      </div>
      <button type="button" class="hhs-arrow" data-dir="1" aria-label="Next slide" aria-controls="hhs-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
      {%- if section.settings.autoplay -%}
        <button type="button" class="hhs-pause" aria-pressed="false" aria-label="Pause slideshow">
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script>
(function(){
  var root = document.getElementById('hhs-{{ section.id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var slides = Array.prototype.slice.call(root.querySelectorAll('.hhs-slide'));
  var dots = Array.prototype.slice.call(root.querySelectorAll('.hhs-dot'));
  var track = root.querySelector('.hhs-track');
  var pauseBtn = root.querySelector('.hhs-pause');
  var mq = window.matchMedia('(max-width: 749px)');
  var i = 0, timer = null, hover = false, held = false;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var auto = root.dataset.autoplay === 'true' && !reduce && slides.length > 1;
  var ms = (parseInt(root.dataset.speed, 10) || 6) * 1000;
  if (pauseBtn && !auto) setPaused(true);

  // Afspil kun den synlige video på den aktive slide
  function syncVideos(){
    slides.forEach(function(s, k){
      s.querySelectorAll('video').forEach(function(v){
        var visible = k === i && v.offsetParent !== null;
        if (visible) { v.muted = true; var p = v.play(); if (p && p.catch) p.catch(function(){}); }
        else if (!v.paused) v.pause();
      });
    });
  }
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){
      var on = k === i;
      s.classList.toggle('is-active', on);
      if (on) { s.removeAttribute('aria-hidden'); s.inert = false; }
      else { s.setAttribute('aria-hidden', 'true'); s.inert = true; }
    });
    dots.forEach(function(d, k){ d.setAttribute('aria-current', k === i ? 'true' : 'false'); });
    syncVideos();
  }
  function stop(){ clearInterval(timer); timer = null; }
  function play(){
    stop();
    if (auto && !hover && !held && !document.hidden) timer = setInterval(function(){ go(i + 1); }, ms);
  }
  function setPaused(p){
    if (!pauseBtn) return;
    pauseBtn.setAttribute('aria-pressed', p ? 'true' : 'false');
    pauseBtn.setAttribute('aria-label', p ? 'Play slideshow' : 'Pause slideshow');
    track.setAttribute('aria-live', p ? 'polite' : 'off');
  }
  function step(n){ go(n); play(); }

  root.querySelectorAll('.hhs-arrow').forEach(function(a){
    a.addEventListener('click', function(){ step(i + parseInt(a.dataset.dir, 10)); });
  });
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ step(k); }); });
  if (pauseBtn) pauseBtn.addEventListener('click', function(){
    auto = !auto;
    setPaused(!auto);
    play();
  });

  root.addEventListener('mouseenter', function(){ hover = true; stop(); });
  root.addEventListener('mouseleave', function(){ hover = false; play(); });
  root.addEventListener('focusin', function(){ hover = true; stop(); });
  root.addEventListener('focusout', function(e){ if (!root.contains(e.relatedTarget)) { hover = false; play(); } });
  root.addEventListener('keydown', function(e){
    if (e.key === 'ArrowLeft') { e.preventDefault(); step(i - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); step(i + 1); }
  });
  document.addEventListener('visibilitychange', play);
  if (mq.addEventListener) mq.addEventListener('change', syncVideos);

  var x0 = null, y0 = null;
  root.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; stop(); }, { passive: true });
  root.addEventListener('touchend', function(e){
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(i + (dx < 0 ? 1 : -1));
    x0 = null; play();
  }, { passive: true });

  // Temaeditoren: vis den slide, du redigerer
  document.addEventListener('shopify:block:select', function(e){
    var k = slides.indexOf(e.target);
    if (k > -1) { held = true; stop(); go(k); }
  });
  document.addEventListener('shopify:block:deselect', function(e){
    if (slides.indexOf(e.target) > -1) { held = false; play(); }
  });

  syncVideos();
  play();
})();
</script>

{% schema %}
{
  "name": "HUNDRED Hero slideshow",
  "tag": "section",
  "class": "section-hundred-hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Format" },
    { "type": "select", "id": "ratio_desktop", "label": "Format på computer", "default": "16/7",
      "info": "Alle slides får samme format. Billeder og video beskæres, så de fylder feltet.",
      "options": [
