{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign first_text_block_subtext = blank
  for block in section.blocks
    if block.type == 'text' and block.settings.subtext != blank and first_text_block_subtext == blank
      assign first_text_block_subtext = block.settings.subtext
    endif
  endfor
-%}

<section
  class="footer__upper color-{{ section.settings.subfooter_color_scheme }} color-foreground"
  style="background: {{ section.settings.subfooter_background | escape }}; background-size: contain;"
>
  <div class="footer__upper-grid page-width">
    {%- if first_text_block_subtext != blank -%}
      <div class="footer__upper-statement rte">
        {{ first_text_block_subtext }}
      </div>
    {%- endif -%}
    <div class="footer__upper-intro">
      {%- if section.settings.subfooter_title != blank -%}
        <p class="footer__upper-title">{{ section.settings.subfooter_title }}</p>
      {%- endif -%}
      {%- if section.settings.subfooter_subtitle != blank -%}
        <div class="footer__upper-subtitle rte">{{ section.settings.subfooter_subtitle }}</div>
      {%- endif -%}
    </div>

    <nav class="footer__upper-channels" aria-label="{{ 'sections.footer.communication_channels' | t }}">
      <ul class="footer__upper-channel-list list-unstyled">
        {%- for block in section.blocks -%}
          {%- if block.type == 'comm_channel' and block.settings.channel_link != blank -%}
            {%- liquid
              assign channel_fallback_value = block.settings.channel_link
              assign channel_fallback_value = channel_fallback_value | replace: 'mailto:', ''
              assign channel_fallback_value = channel_fallback_value | replace: 'tel:', ''
              assign channel_fallback_value = channel_fallback_value | replace: 'https://wa.me/', ''
              assign channel_fallback_value = channel_fallback_value | replace: 'http://wa.me/', ''
              assign channel_fallback_value = channel_fallback_value | replace: 'https://api.whatsapp.com/send?phone=', ''
              assign channel_fallback_value = channel_fallback_value | split: '?' | first
              assign channel_value = block.settings.channel_value | default: channel_fallback_value
            -%}
            <li class="footer__upper-channel" {{ block.shopify_attributes }}>
              {%- if block.settings.channel_label != blank -%}
                <span class="footer__upper-channel-label">{{ block.settings.channel_label }}</span>
              {%- endif -%}
              <a
                href="{{ block.settings.channel_link }}"
                class="footer__upper-channel-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{{ channel_value }}</span>
                <span class="footer__upper-channel-arrow svg-wrapper" aria-hidden="true">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
                <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</section>

<footer class=" color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    assign footer_menu_link_count = 0
    for block in section.blocks
      if block.type == 'link_list' and block.settings.menu != blank
        assign footer_menu_link_count = footer_menu_link_count | plus: block.settings.menu.links.size
      endif
    endfor

    assign footer_company_name = settings.brand_region_name | default: shop.name
    assign payment_methods_menu = linklists['payment-methods']
  -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__bottom-grid page-width">
      {%- assign footer_image_rendered = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' and block.settings.image != blank and footer_image_rendered == false -%}
          {%- assign footer_image_width_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
          <div class="footer__image {{ block.settings.alignment }}" {{ block.shopify_attributes }}>
            <img
              srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: footer_image_width_2x }} 2x"
              src="{{ block.settings.image | image_url: width: 760 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              style="max-width: min(100%, {{ block.settings.image_width }}px);"
            >
          </div>
          {%- assign footer_image_rendered = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if footer_menu_link_count > 0 -%}
        <nav class="footer__menu-column footer__menu-column--primary" aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="footer__menu-list list-unstyled">
            {%- assign footer_link_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'link_list' and block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  {%- assign footer_link_index = footer_link_index | plus: 1 -%}
                  {%- if footer_link_index <= 7 -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="link link--text footer__menu-link{% if link.active %} footer__menu-link--active{% endif %}"
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>

        {%- if footer_menu_link_count > 7 -%}
          <nav class="footer__menu-column footer__menu-column--secondary" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="footer__menu-list list-unstyled">
              {%- assign footer_link_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'link_list' and block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    {%- assign footer_link_index = footer_link_index | plus: 1 -%}
                    {%- if footer_link_index > 7 and footer_link_index <= 14 -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="link link--text footer__menu-link{% if link.active %} footer__menu-link--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_social and has_social_icons -%}
        <nav class="footer__social-text" aria-label="{{ 'sections.footer.social_links' | t }}">
          <ul class="footer__social-text-list list-unstyled">
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_facebook_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.facebook' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_instagram_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.instagram' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_youtube_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.youtube' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_tiktok_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.tiktok' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_twitter_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.twitter' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_pinterest_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.pinterest' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_snapchat_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_snapchat_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.snapchat' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tumblr_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_tumblr_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.tumblr' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_vimeo_link != blank -%}
              <li>
                <a
                  href="{{ settings.social_vimeo_link }}"
                  class="footer__social-text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ 'general.social.links.vimeo' | t }}</span>
                  <span class="footer__social-text-arrow svg-wrapper" aria-hidden="true">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="footer__copyright caption">
        <small class="copyright__content">&copy; {{ 'now' | date: '%Y' }}, {{ footer_company_name -}}</small>
        {%- if settings.brand_hq_address != blank -%}
          <small class="copyright__content footer__address">{{ settings.brand_hq_address }}</small>
        {%- endif -%}
      </div>

      <div class="footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                {% comment %}
                  <h2 class="caption-large text-body" id="FooterLanguageLabel">
                    {{ 'localization.language_label' | t }}
                  </h2>
                {% endcomment %}
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      {%- if payment_methods_menu.links.size > 0 -%}
        <nav class="footer__payment-methods visually-hidden" aria-label="{{ 'sections.footer.payment' | t }}">
          <ul class="footer__payment-methods-list list-unstyled">
            {%- for link in payment_methods_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "comm_channel",
      "name": "t:sections.footer.blocks.comm_channel.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "channel_label",
          "label": "t:sections.footer.blocks.comm_channel.settings.channel_label.label"
        },
        {
          "type": "text",
          "id": "channel_value",
          "label": "t:sections.footer.blocks.comm_channel.settings.channel_value.label"
        },
        {
          "type": "text",
          "id": "channel_link",
          "label": "t:sections.footer.blocks.comm_channel.settings.channel_link.label"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Sub Footer Settings",
      "info": "This renders the data above the footer."
    },
    {
      "type": "text",
      "id": "subfooter_title",
      "label": "Sub Footer Title",
      "default": "Have any questions?"
    },
    {
      "type": "text",
      "id": "subfooter_subtitle",
      "label": "Sub Footer SubTitle",
      "default": "We are here to help. Lets Talk ⟶"
    },
    {
      "type": "textarea",
      "id": "subfooter_background",
      "label": "Sub Footer Background",
      "default": "red"
    },
    {
      "type": "color_scheme",
      "id": "subfooter_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "info": "t:sections.footer.settings.enable_follow_on_shop.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "t:sections.footer.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "text"
      }
    ]
  }
}
{% endschema %}
