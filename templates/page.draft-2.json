rent !important;\n    box-shadow: none !important;\n  }\n\n  #hnps-{{ sid }} .rch {\n    display: inline-block;\n    padding: 0;\n    margin: 0;\n    line-height: .95;\n    letter-spacing: -.035em;\n    background: linear-gradient(\n      180deg,\n      #ff7ad9 0%,\n      #ff3aa7 38%,\n      #ff0d87 68%,\n      #ff0066 100%\n    ) !important;\n    -webkit-background-clip: text !important;\n    background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    color: transparent !important;\n    transform: translateY(115%);\n    opacity: 0;\n    animation: hnpsCharIn-{{ sid }} .72s cubic-bezier(.16,1,.3,1) forwards;\n    animation-delay: var(--d);\n    filter:\n      drop-shadow(0 0 6px rgba(255, 60, 170, .20))\n      drop-shadow(0 0 16px rgba(255, 0, 102, .14));\n  }\n\n  @keyframes hnpsCharIn-{{ sid }} {\n    0% {\n      transform: translateY(115%) rotate(6deg);\n      opacity: 0;\n      filter: blur(8px);\n    }\n\n    100% {\n      transform: translateY(0) rotate(0);\n      opacity: 1;\n      filter:\n        drop-shadow(0 0 6px rgba(255, 60, 170, .20))\n        drop-shadow(0 0 16px rgba(255, 0, 102, .14));\n    }\n  }\n\n  #hnps-{{ sid }} .sub {\n    font-size: clamp(1rem, 1.5vw, 1.22rem);\n    font-weight: 300;\n    color: rgba(255,255,255,.6);\n    max-width: 570px;\n    line-height: 1.55;\n    margin: 0 0 42px;\n  }\n\n  #hnps-{{ sid }} .star {\n    display: inline-block;\n    position: relative;\n    border-radius: 22px;\n    overflow: hidden;\n    padding: 1px 0;\n    color: #fff;\n    background: transparent;\n    isolation: isolate;\n    box-shadow:\n      0 0 20px rgba(var(--sr,255,255,255),.18),\n      0 0 60px rgba(var(--sr,255,255,255),.12);\n    animation: hnpsOuterGlow-{{ sid }} 2.8s ease-in-out infinite;\n  }\n\n  #hnps-{{ sid }} .star::after {\n    content: \"\";\n    position: absolute;\n    inset: -18px;\n    z-index: -1;\n    background: radial-gradient(circle, rgba(var(--sr,255,255,255),.28), transparent 62%);\n    opacity: .6;\n    filter: blur(18px);\n    animation: hnpsHalo-{{ sid }} 2.8s ease-in-out infinite;\n  }\n\n  #hnps-{{ sid }} .bgb,\n  #hnps-{{ sid }} .bgt {\n    position: absolute;\n    width: 300%;\n    height: 50%;\n    opacity: .95;\n    border-radius: 50%;\n    background: radial-gradient(circle, var(--sc,#fff), transparent 10%);\n    animation: hnpsBottomSweep-{{ sid }} 5s linear infinite alternate;\n    z-index: 0;\n  }\n\n  #hnps-{{ sid }} .bgb {\n    bottom: -12px;\n    right: -250%;\n  }\n\n  #hnps-{{ sid }} .bgt {\n    top: -12px;\n    left: -250%;\n    animation-name: hnpsTopSweep-{{ sid }};\n  }\n\n  #hnps-{{ sid }} .inn {\n    position: relative;\n    z-index: 1;\n    min-height: 56px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 16px 30px;\n    border-radius: 22px;\n    border: 1px solid rgba(255,255,255,.14);\n    background: linear-gradient(180deg, rgba(255,255,255,.075), transparent), #000;\n    color: #fff;\n    font-size: 13px;\n    font-weight: 900;\n    letter-spacing: 1.25px;\n    text-transform: uppercase;\n    white-space: nowrap;\n    box-shadow:\n      inset 0 0 22px rgba(var(--sr,255,255,255),.08),\n      0 0 24px rgba(var(--sr,255,255,255),.2);\n    animation: hnpsInnerGlow-{{ sid }} 2.8s ease-in-out infinite;\n    transition: .3s;\n  }\n\n  #hnps-{{ sid }} .star:hover .inn {\n    transform: translateY(-1px);\n    border-color: rgba(255,255,255,.28);\n    background: linear-gradient(180deg, rgba(255,255,255,.1), transparent), #050505;\n  }\n\n  #hnps-{{ sid }} .star:hover svg {\n    transform: translateX(4px);\n  }\n\n  #hnps-{{ sid }} .star svg {\n    transition: .3s;\n  }\n\n  @keyframes hnpsOuterGlow-{{ sid }} {\n    0%, 100% {\n      box-shadow:\n        0 0 18px rgba(var(--sr,255,255,255),.18),\n        0 0 54px rgba(var(--sr,255,255,255),.1);\n    }\n\n    50% {\n      box-shadow:\n        0 0 28px rgba(var(--sr,255,255,255),.32),\n        0 0 84px rgba(var(--sr,255,255,255),.18);\n    }\n  }\n\n  @keyframes hnpsHalo-{{ sid }} {\n    0%, 100% {\n      opacity: .45;\n      transform: scale(.95);\n    }\n\n    50% {\n      opacity: .8;\n      transform: scale(1.08);\n    }\n  }\n\n  @keyframes hnpsInnerGlow-{{ sid }} {\n    0%, 100% {\n      box-shadow:\n        inset 0 0 18px rgba(var(--sr,255,255,255),.07),\n        0 0 20px rgba(var(--sr,255,255,255),.16);\n    }\n\n    50% {\n      box-shadow:\n        inset 0 0 26px rgba(var(--sr,255,255,255),.13),\n        0 0 34px rgba(var(--sr,255,255,255),.28);\n    }\n  }\n\n  @keyframes hnpsBottomSweep-{{ sid }} {\n    0% {\n      transform: translate(0,0);\n      opacity: 1;\n    }\n\n    100% {\n      transform: translate(-100%,0);\n      opacity: .12;\n    }\n  }\n\n  @keyframes hnpsTopSweep-{{ sid }} {\n    0% {\n      transform: translate(0,0);\n      opacity: 1;\n    }\n\n    100% {\n      transform: translate(100%,0);\n      opacity: .12;\n    }\n  }\n\n  #hnps-{{ sid }} .reveal {\n    padding: 110px 24px;\n    max-width: 980px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  #hnps-{{ sid }} .rtext {\n    margin: 0;\n    font-size: clamp(1.7rem, 4vw, 3.4rem);\n    line-height: 1.35;\n    font-weight: 800;\n    letter-spacing: -.035em;\n    color: rgba(255,255,255,.16);\n  }\n\n  #hnps-{{ sid }} .rtext .word {\n    display: inline-block;\n    margin: 0 5px;\n    transition: .4s;\n    filter: blur(8px);\n  }\n\n  #hnps-{{ sid }} .rtext .word.show {\n    color: rgba(255,255,255,.95);\n    filter: blur(0);\n  }\n\n  #hnps-{{ sid }} .div {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,.06), transparent);\n    margin: 0 auto;\n    max-width: 220px;\n  }\n\n  #hnps-{{ sid }} .chap {\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    position: relative;\n    overflow: hidden;\n    padding: 80px 0;\n  }\n\n  #hnps-{{ sid }} .bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n  }\n\n  #hnps-{{ sid }} .bg::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse at 30% 50%, var(--gl), transparent 70%);\n    opacity: .65;\n  }\n\n  #hnps-{{ sid }} .bg::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, transparent, #050505);\n  }\n\n  #hnps-{{ sid }} .blur {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    backdrop-filter: blur(0);\n    background: rgba(5,5,5,0);\n    transition: .8s;\n    pointer-events: none;\n  }\n\n  #hnps-{{ sid }} .chap.blurring .blur {\n    backdrop-filter: blur(8px);\n    background: rgba(5,5,5,.3);\n  }\n\n  #hnps-{{ sid }} .thread {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    bottom: 0;\n    width: 1px;\n    background: rgba(255,255,255,.075);\n    z-index: 1;\n    transform: translateX(-50%);\n    overflow: visible;\n  }\n\n  #hnps-{{ sid }} .thread::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 1px;\n    height: calc(var(--line-progress,0) * 100%);\n    background: var(--ac);\n    box-shadow:\n      0 0 18px var(--ac),\n      0 0 38px rgba(var(--rgb),.35);\n    transition: height .08s linear, background .25s ease, box-shadow .25s ease;\n  }\n\n  #hnps-{{ sid }} .thread i {\n    position: absolute;\n    left: 50%;\n    top: calc(var(--dot-progress,.5) * 100%);\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    opacity: .35;\n    background: rgba(255,255,255,.38);\n    box-shadow: none;\n    transform: translate(-50%, -50%) scale(.78);\n    transition: top .08s linear, opacity .25s ease, background .25s ease, box-shadow .25s ease, transform .25s ease;\n  }\n\n  #hnps-{{ sid }} .chap.active .thread i {\n    opacity: 1;\n    background: var(--ac);\n    box-shadow:\n      0 0 18px var(--ac),\n      0 0 46px rgba(var(--rgb),.45);\n    transform: translate(-50%, -50%) scale(1.25);\n  }\n\n  #hnps-{{ sid }} .chap.passed .thread i {\n    opacity: .5;