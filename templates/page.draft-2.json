      "settings": {
        "custom_liquid": "{% assign sid = section.id | default: 'static' %}\n\n<section id=\"hnps-{{ sid }}\" class=\"hnps\">\n\n<style>\n  #hnps-{{ sid }},\n  #hnps-{{ sid }} *,\n  #hnps-{{ sid }}::before,\n  #hnps-{{ sid }} *::before,\n  #hnps-{{ sid }} *::after {\n    box-sizing: border-box;\n  }\n\n  #hnps-{{ sid }} {\n    font-family: var(--font-body-family, Inter, Arial, sans-serif);\n    background: #050505;\n    color: #fff;\n    overflow: hidden;\n    position: relative;\n  }\n\n  #hnps-{{ sid }} a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  #hnps-{{ sid }} svg {\n    width: 16px;\n    height: 16px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  @media (pointer:fine) and (min-width:769px) {\n    #hnps-{{ sid }},\n    #hnps-{{ sid }} a,\n    #hnps-{{ sid }} button {\n      cursor: none;\n    }\n  }\n\n  #hnps-{{ sid }} .cdot {\n    position: fixed;\n    left: 0;\n    top: 0;\n    width: 6px;\n    height: 6px;\n    background: #fff;\n    border-radius: 99px;\n    pointer-events: none;\n    z-index: 99999;\n    transform: translate(-50%, -50%);\n    opacity: 0;\n    mix-blend-mode: difference;\n  }\n\n  #hnps-{{ sid }} .trail {\n    position: fixed;\n    left: 0;\n    top: 0;\n    width: 4px;\n    height: 4px;\n    border-radius: 99px;\n    background: rgba(255,255,255,.72);\n    pointer-events: none;\n    z-index: 99998;\n    transform: translate(-50%, -50%);\n    mix-blend-mode: difference;\n    animation: hnpsTrail-{{ sid }} .62s ease-out forwards;\n  }\n\n  @keyframes hnpsTrail-{{ sid }} {\n    0% {\n      opacity: .65;\n      transform: translate(-50%, -50%) scale(1);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translate(-50%, -50%) scale(.25);\n      filter: blur(2px);\n    }\n  }\n\n  #hnps-{{ sid }} .tc {\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: 99997;\n    opacity: 0;\n    mix-blend-mode: difference;\n    transition: opacity .18s ease;\n  }\n\n  #hnps-{{ sid }} .tc.on {\n    opacity: 1;\n  }\n\n  #hnps-{{ sid }} .cr {\n    position: fixed;\n    width: 14px;\n    height: 14px;\n    border: 2px solid var(--cc, #fff);\n    opacity: 0;\n    transition: left .2s ease, top .2s ease, opacity .18s ease;\n  }\n\n  #hnps-{{ sid }} .tc.on .cr {\n    opacity: 1;\n  }\n\n  #hnps-{{ sid }} .tl {\n    border-right: 0;\n    border-bottom: 0;\n  }\n\n  #hnps-{{ sid }} .trc {\n    border-left: 0;\n    border-bottom: 0;\n  }\n\n  #hnps-{{ sid }} .br {\n    border-left: 0;\n    border-top: 0;\n  }\n\n  #hnps-{{ sid }} .bl {\n    border-right: 0;\n    border-top: 0;\n  }\n\n  @media (pointer:coarse), (max-width:768px) {\n    #hnps-{{ sid }} .cdot,\n    #hnps-{{ sid }} .tc,\n    #hnps-{{ sid }} .trail {\n      display: none !important;\n    }\n  }\n\n  #hnps-{{ sid }} .hero {\n    min-height: min(86svh, 760px);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: clamp(78px, 9vw, 118px) 24px clamp(56px, 7vw, 88px);\n    position: relative;\n    background:\n      radial-gradient(circle at 50% 8%, rgba(255, 0, 102, .055), transparent 34%),\n      #000000;\n    overflow: hidden;\n  }\n\n  #hnps-{{ sid }} .hero::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: .08;\n    pointer-events: none;\n    mix-blend-mode: overlay;\n    background-image:\n      repeating-radial-gradient(circle at 20% 30%, rgba(255,255,255,.22) 0 1px, transparent 1px 4px),\n      repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 9px);\n  }\n\n  #hnps-{{ sid }} .hero > * {\n    position: relative;\n    z-index: 2;\n  }\n\n  #hnps-{{ sid }} .kick {\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 5px;\n    text-transform: uppercase;\n    color: rgba(255,255,255,.42);\n    margin: 0 0 24px;\n  }\n\n  #hnps-{{ sid }} .title {\n    width: 100%;\n    ma