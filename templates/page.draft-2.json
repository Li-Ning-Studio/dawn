n: 0 -320px, 0 -420px;\n    }\n  }\n\n  @keyframes hnProFlicker {\n    0%, 100% { opacity: .28; }\n    50% { opacity: .68; }\n  }\n\n  @keyframes hnProFamilyFloat {\n    0%, 100% { margin-top: 0; }\n    50% { margin-top: -18px; }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-pro-thread {\n      left: 14px;\n    }\n\n    .hn-pro-ghost img {\n      right: -36%;\n      width: 94vw;\n      opacity: .09;\n    }\n\n    .hn-pro-fit {\n      padding: 58px 18px 72px;\n      align-items: flex-start;\n    }\n\n    .hn-pro-fit__top {\n      margin-bottom: 42px;\n    }\n\n    .hn-pro-fit__steps span {\n      width: 24px;\n    }\n\n    .hn-pro-fit__question h2,\n    .hn-pro-titlecard h2 {\n      font-size: clamp(48px, 14vw, 74px);\n      max-width: 8.5ch;\n    }\n\n    .hn-pro-fit__options {\n      grid-template-columns: 1fr;\n      margin-top: 42px;\n      gap: 12px;\n    }\n\n    .hn-pro-fit__option {\n      min-height: 126px;\n      border-radius: 26px;\n      padding: 22px;\n    }\n\n    .hn-pro-fit__option small {\n      width: 30px;\n      height: 30px;\n      margin-bottom: 24px;\n    }\n\n    .hn-pro-fit__option strong {\n      font-size: clamp(26px, 7.6vw, 36px);\n      max-width: 12ch;\n    }\n\n    .hn-pro-fit__actions {\n      display: grid;\n      grid-template-columns: 1fr;\n    }\n\n    .hn-pro-fit__actions button,\n    .hn-pro-fit__actions a {\n      width: 100%;\n    }\n\n    .hn-pro-titlecard {\n      min-height: 72svh;\n      padding: 70px 24px 70px 34px;\n    }\n\n    .hn-pro-chapter {\n      min-height: auto;\n      grid-template-columns: 1fr;\n      gap: 18px;\n      padding: 78px 24px 82px 34px;\n    }\n\n    .hn-pro-chapter__visual {\n      min-height: 330px;\n      order: 1;\n    }\n\n    .hn-pro-chapter__visual img {\n      width: min(78vw, 330px);\n    }\n\n    .hn-pro-chapter__copy {\n      order: 2;\n    }\n\n    .hn-pro-chapter__copy h2 {\n      font-size: clamp(44px, 13vw, 68px);\n    }\n\n    .hn-pro-beats p {\n      font-size: 17px;\n      line-height: 1.42;\n    }\n\n    .hn-pro-family {\n      grid-template-columns: 1fr;\n      padding: 76px 24px 90px 34px;\n    }\n\n    .hn-pro-family__rackets {\n      min-height: 360px;\n      order: 1;\n    }\n\n    .hn-pro-family__rackets img {\n      width: min(34vw, 170px);\n    }\n\n    .hn-pro-family__copy {\n      order: 2;\n    }\n\n    .hn-pro-family__copy h2 {\n      font-size: clamp(44px, 13vw, 68px);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-pro-world *,\n    .hn-pro-world *::before,\n    .hn-pro-world *::after {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnProWorld');\n    if (!section || section.dataset.ready === 'true') return;\n    section.dataset.ready = 'true';\n\n    var productData = {\n      venom: {\n        color: '#19b84a',\n        rgb: '25,184,74',\n        name: 'Nitrix 70 Venom',\n        tag: 'You’re built for Attack.',\n        copy: 'Built for heavy smashes, hard rallies, and players who finish points with pressure.',\n        anchor: '#hn-chapter-venom',\n        img: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756'\n      },\n      volta: {\n        color: '#1f7ed8',\n        rgb: '31,126,216',\n        name: 'Nitrix 70 Volta',\n        tag: 'You’re built for Clean Power.',\n        copy: 'Built for balanced attackers who want power that travels fast and lands clean.',\n        anchor: '#hn-chapter-volta',\n        img: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756'\n      },\n      hyfonic: {\n        color: '#6f42d8',\n        rgb: '111,66,216',\n        name: 'Hyfonic 7',\n        tag: 'You’re built for Precision.',\n        copy: 'Built for placement, control, and players who stay composed at match speed.',\n        anchor: '#hn-chapter-hyfonic',\n        img: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Hyfonic.png?v=1753182756'\n      },\n      flareon: {\n        color: '#ff3b24',\n        rgb: '255,59,36',\n        name: 'Flareon 700',\n        tag: 'You’re built for Speed.',\n        copy: 'Built for fast hands, quick recovery, and players who arrive early to every shot.',\n        anchor: '#hn-chapter-flareon',\n        img: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon.png?v=1753182756'\n      }\n    };\n\n    var fitQuestions = [\n      {\n        step: 'Step 01',\n        question: 'How do you play?',\n        options: [\n          ['A', 'Aggressive Smasher', 'venom'],\n          ['B', 'All-Round Precision', 'hyfonic'],\n          ['C', 'Speed & Control', 'flareon']\n        ]\n      },\n      {\n        step: 'Step 02',\n        question: 'How do you swing?',\n        options: [\n          ['A', 'Heavy-Handed', 'venom'],\n          ['B', 'Balanced', 'volta'],\n          ['C', 'Light & Fast', 'flareon']\n        ]\n      },\n      {\n        step: 'Step 03',\n        question: 'What matters most?',\n        options: [\n          ['A', 'Power', 'volta'],\n          ['B', 'Control', 'hyfonic'],\n          ['C', 'Maneuverability', 'flareon']\n        ]\n      }\n    ];\n\n    var ghost = document.getElementById('hnProGhostImg');\n    var zones = Array.prototype.slice.call(section.querySelectorAll('[data-world-zone]'));\n    var chapters = Array.prototype.slice.call(section.querySelectorAll('.hn-pro-chapter'));\n\n    var stepIndex = 0;\n    var scores = { venom: 0, volta: 0, hyfonic: 0, flareon: 0 };\n\n    var fitStep = document.getElementById('hnFitStep');\n    var fitQuestion = document.getElementById('hnFitQuestion');\n    var fitOptions = document.getElementById('hnFitOptions');\n    var fitResult = document.getElementById('hnFitResult');\n    var fitResultTag = document.getElementById('hnFitResultTag');\n    var fitResultName = document.getElementById('hnFitResultName');\n    var fitResultCopy = document.getElementById('hnFitResultCopy');\n    var fitBegin = document.getElementById('hnFitBegin');\n    var fitDots = Array.prototype.slice.call(section.querySelectorAll('.hn-pro-fit__steps span'));\n\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function topMatch() {\n      return Object.keys(scores).sort(function (a, b) {\n        return scores[b] - scores[a];\n      })[0] || 'venom';\n    }\n\n    function setTheme(key) {\n      var item = productData[key] || productData.venom;\n\n      section.style.setProperty('--accent', item.color);\n      section.style.setProperty('--accent-rgb', item.rgb);\n\n      if (ghost && ghost.dataset.key !== key) {\n        ghost.dataset.key = key;\n        ghost.src = item.img;\n      }\n    }\n\n    function renderFit() {\n      var q = fitQuestions[stepIndex];\n\n      fitResult.hidden = true;\n      fitOptions.hidden = false;\n\n      fitStep.textContent = q.step;\n      fitQuestion.textContent = q.question;\n      fitOptions.innerHTML = '';\n\n      fitDots.forEach(function (dot, index) {\n        dot.classList.toggle('is-on', index === stepIndex);\n        dot.classList.toggle('is-done', index < stepIndex);\n      });\n\n      q.options.forEach(function (option) {\n        var item = productData[option[2]];\n        var button = document.createElement('button');\n\n        button.type = 'button';\n        button.className = 'hn-pro-fit__option';\n        button.style.setProperty('--option-rgb', item.rgb);\n        button.innerHTML = '<small>' + option[0] + '</small><strong>' + option[1] + '</strong>';\n\n        button.addEventListener('mousemove', function (event) {\n          var rect = button.getBoundingClientRect();\n          button.style.setProperty('--mx', (((event.clientX - rect.left) / rect.width) * 100).toFixed(2) + '%');\n          button.style.setProperty('--my', (((event.clientY - rect.top) / rect.height) * 100).toFixed(2) + '%');\n        });\n\n        button.addEventListener('click', function () {\n          scores[option[2]] += 1;\n          setTheme(topMatch());\n\n          if (stepIndex < fitQuestions.length - 1) {\n            stepIndex += 1;\n            window.setTimeout(renderFit, 240);\n          } else {\n            window.setTimeout(showFitResult, 260);\n          }\n        });\n\n        fitOptions.appendChild(button);\n      });\n\n      setTheme(topMatch());\n    }\n\n    function showFitResult() {\n      var key = topMatch();\n      var item = productData[key];\n\n      setTheme(key);\n\n      fitOptions.hidden = true;\n      fitResult.hidden = false;\n\n      fitDots.forEach(function (dot) {\n        dot.classList.add('is-done');\n        dot.classList.remove('is-on');\n      });\n\n      fitResultTag.textContent = item.tag;\n      fitResultName.textContent = item.name;\n      fitResultCopy.textContent = item.copy;\n\n      fitBegin.onclick = function () {\n        var target = document.querySelector(item.anchor);\n        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      };\n    }\n\n    function updateJourney() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      section.style.setProperty('--journey-progress', progress.toFixed(4));\n\n      var activeKey = 'venom';\n      var center = window.innerHeight * 0.48;\n\n      zones.forEach(function (zone) {\n        var r = zone.getBoundingClientRect();\n        if (r.top <= center && r.bottom >= center) {\n          activeKey = zone.dataset.worldZone || activeKey;\n        }\n      });\n\n      if (productData[activeKey]) setTheme(activeKey);\n\n      chapters.forEach(function (chapter) {\n        var r = chapter.getBoundingClientRect();\n        var p = clamp((window.innerHeight * 0.78 - r.top) / (r.height * 0.72), 0, 1);\n\n        chapter.style.setProperty('--p', p.toFixed(3));\n\n        Array.prototype.slice.call(chapter.querySelectorAll('.hn-pro-beats p')).forEach(function (beat, index) {\n          var show = clamp((p - index * 0.18) / 0.22, 0, 1);\n          beat.style.setProperty('--show', show.toFixed(3));\n        });\n      });\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateJourney);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    renderFit();\n    updateJourney();\n  })();\n</script>",
