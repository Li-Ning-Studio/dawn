cument.documentElement.style.cursor = 'none';\n  document.body.style.cursor = 'none';\n\n  var dot = document.createElement('div');\n  dot.className = 'hndrd-global-cursor-dot';\n\n  var focus = document.createElement('div');\n  focus.className = 'hndrd-global-cursor-focus';\n  focus.innerHTML =\n    '<span class=\"hndrd-global-cursor-corner hndrd-global-cursor-corner--tl\"></span>' +\n    '<span class=\"hndrd-global-cursor-corner hndrd-global-cursor-corner--tr\"></span>' +\n    '<span class=\"hndrd-global-cursor-corner hndrd-global-cursor-corner--br\"></span>' +\n    '<span class=\"hndrd-global-cursor-corner hndrd-global-cursor-corner--bl\"></span>';\n\n  document.body.appendChild(dot);\n  document.body.appendChild(focus);\n\n  var corners = Array.prototype.slice.call(focus.querySelectorAll('.hndrd-global-cursor-corner'));\n\n  var mouseX = window.innerWidth / 2;\n  var mouseY = window.innerHeight / 2;\n  var dotX = mouseX;\n  var dotY = mouseY;\n  var lastTrail = 0;\n  var activeTarget = null;\n\n  function markAllClickable() {\n    document.querySelectorAll(\n      'a[href],' +\n      'button,' +\n      '[role=\"button\"],' +\n      'input[type=\"submit\"],' +\n      'input[type=\"button\"],' +\n      '.cta,' +\n      '[class*=\"cta\"],' +\n      '[class*=\"button\"],' +\n      '[class*=\"btn\"],' +\n      '.shopify-payment-button__button'\n    ).forEach(function (el) {\n      if (\n        el.closest('.hndrd-global-cursor-focus') ||\n        el.classList.contains('hndrd-global-cursor-dot') ||\n        el.classList.contains('hndrd-global-cursor-trail')\n      ) return;\n\n      el.classList.add('hndrd-cursor-target');\n    });\n  }\n\n  function findTarget(el) {\n    if (!el) return null;\n\n    return el.closest(\n      '.hndrd-cursor-target,' +\n      '.cursor-target,' +\n      'a[href],' +\n      'button,' +\n      '[role=\"button\"],' +\n      'input[type=\"submit\"],' +\n      'input[type=\"button\"],' +\n      '.cta,' +\n      '[class*=\"cta\"],' +\n      '[class*=\"button\"],' +\n      '[class*=\"btn\"],' +\n      '.shopify-payment-button__button'\n    );\n  }\n\n  function getTargetColor(el) {\n    if (!el) return '#ffffff';\n\n    var sr = el.style.getPropertyValue('--sr');\n    var accent = el.style.getPropertyValue('--accent');\n    var ac = el.style.getPropertyValue('--ac');\n\n    if (sr) return 'rgb(' + sr + ')';\n    if (accent) return accent;\n    if (ac) return ac;\n\n    var computed = window.getComputedStyle(el);\n    var bg = computed.backgroundColor;\n    var border = computed.borderColor;\n    var color = computed.color;\n\n    if (border && border !== 'rgba(0, 0, 0, 0)') return border;\n    if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') return bg;\n    return color || '#ffffff';\n  }\n\n  function makeTrail(x, y) {\n    var now = performance.now();\n    if (now - lastTrail < 16) return;\n    lastTrail = now;\n\n    var trail = document.createElement('span');\n    trail.className = 'hndrd-global-cursor-trail';\n    trail.style.left = x + 'px';\n    trail.style.top = y + 'px';\n\n    document.body.appendChild(trail);\n\n    setTimeout(function () {\n      trail.remove();\n    }, 680);\n  }\n\n  function positionCorners(target, event) {\n    if (!target || !corners.length) return;\n\n    var rect = target.getBoundingClientRect();\n\n    if (rect.width <= 0 || rect.height <= 0) {\n      focus.classList.remove('is-active');\n      activeTarget = null;\n      return;\n    }\n\n    var padding = 8;\n    var size = 17;\n    var pushX = 0;\n    var pushY = 0;\n\n    if (event) {\n      pushX = (event.clientX - (rect.left + rect.width / 2)) * 0.035;\n      pushY = (event.clientY - (rect.top + rect.height / 2)) * 0.035;\n    }\n\n    var positions = [\n      [rect.left - padding + pushX, rect.top - padding + pushY],\n      [rect.right + padding - size + pushX, rect.top - padding + pushY],\n      [rect.right + padding - size + pushX, rect.bottom + padding - size + pushY],\n      [rect.left - padding + pushX, rect.bottom + padding - size + pushY]\n    ];\n\n    corners.forEach(function (corner, index) {\n      corner.style.left = positions[index][0] + 'px';\n      corner.style.top = positions[index][1] + 'px';\n    });\n  }\n\n  function showFocus(target, event) {\n    var color = getTargetColor(target);\n\n    document.documentElement.style.setProperty('--hndrd-cursor-color', color);\n\n    activeTarget = target;\n    dot.classList.add('is-on-cta');\n    focus.classList.add('is-active');\n    positionCorners(target, event);\n  }\n\n  function hideFocus() {\n    activeTarget = null;\n    dot.classList.remove('is-on-cta');\n    focus.classList.remove('is-active');\n  }\n\n  markAllClickable();\n\n  document.addEventListener('mousemove', function (event) {\n    mouseX = event.clientX;\n    mouseY = event.clientY;\n\n    dot.style.opacity = '1';\n\n    makeTrail(mouseX, mouseY);\n\n    var target = findTarget(event.target);\n\n    if (target) {\n      showFocus(target, event);\n    } else {\n      hideFocus();\n    }\n  }, { passive: true });\n\n  document.addEventListener('mouseleave', function () {\n    dot.style.opacity = '0';\n    hideFocus();\n  });\n\n  window.addEventListener('scroll', function () {\n    if (activeTarget) positionCorners(activeTarget);\n  }, { passive: true });\n\n  window.addEventListener('resize', function () {\n    if (!isDesktopCursor()) {\n      dot.style.display = 'none';\n      focus.style.display = 'none';\n      document.documentElement.style.cursor = '';\n      document.body.style.cursor = '';\n      return;\n    }\n\n    markAllClickable();\n    if (activeTarget) positionCorners(activeTarget);\n  });\n\n  var observer = new MutationObserver(function () {\n    markAllClickable();\n  });\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  function animateDot() {\n    dotX += (mouseX - dotX) * 0.24;\n    dotY += (mouseY - dotY) * 0.24;\n\n    dot.style.left = dotX + 'px';\n    dot.style.top = dotY + 'px';\n\n    requestAnimationFrame(animateDot);\n  }\n\n  animateDot();\n})();\n</script>",
