ition:\n      opacity .12s ease,\n      width .18s ease,\n      height .18s ease,\n      box-shadow .18s ease;\n  }\n\n  .hndrd-global-cursor-dot.is-on-cta {\n    width: 7px;\n    height: 7px;\n    box-shadow:\n      0 0 16px rgba(255,255,255,.9),\n      0 0 38px var(--hndrd-cursor-color, rgba(255,255,255,.38));\n  }\n\n  .hndrd-global-cursor-trail {\n    position: fixed !important;\n    left: 0;\n    top: 0;\n    width: 5px;\n    height: 5px;\n    border-radius: 999px;\n    background: rgba(255,255,255,.72);\n    pointer-events: none !important;\n    z-index: 2147483646 !important;\n    transform: translate(-50%, -50%);\n    box-shadow: 0 0 12px rgba(255,255,255,.35);\n    animation: hndrdCursorTrail .62s ease-out forwards;\n  }\n\n  @keyframes hndrdCursorTrail {\n    0% {\n      opacity: .8;\n      transform: translate(-50%, -50%) scale(1);\n      filter: blur(0);\n    }\n\n    100% {\n      opacity: 0;\n      transform: translate(-50%, -50%) scale(.25);\n      filter: blur(2px);\n    }\n  }\n\n  .hndrd-global-cursor-focus {\n    position: fixed !important;\n    inset: 0;\n    pointer-events: none !important;\n    z-index: 2147483645 !important;\n    opacity: 0;\n    transition: opacity .14s ease;\n  }\n\n  .hndrd-global-cursor-focus.is-active {\n    opacity: 1;\n  }\n\n  .hndrd-global-cursor-corner {\n    position: fixed !important;\n    width: 17px;\n    height: 17px;\n    border: 2px solid var(--hndrd-cursor-color, #ffffff);\n    pointer-events: none !important;\n    opacity: 0;\n    filter: drop-shadow(0 0 8px var(--hndrd-cursor-color, rgba(255,255,255,.5)));\n    transition:\n      left .16s ease,\n      top .16s ease,\n      opacity .14s ease,\n      border-color .14s ease;\n  }\n\n  .hndrd-global-cursor-focus.is-active .hndrd-global-cursor-corner {\n    opacity: 1;\n  }\n\n  .hndrd-global-cursor-corner--tl {\n    border-right: 0;\n    border-bottom: 0;\n  }\n\n  .hndrd-global-cursor-corner--tr {\n    border-left: 0;\n    border-bottom: 0;\n  }\n\n  .hndrd-global-cursor-corner--br {\n    border-left: 0;\n    border-top: 0;\n  }\n\n  .hndrd-global-cursor-corner--bl {\n    border-right: 0;\n    border-top: 0;\n  }\n\n  @media (pointer:coarse), (max-width:768px) {\n    html,\n    body,\n    body *,\n    a,\n    button,\n    [role=\"button\"],\n    input,\n    textarea,\n    select {\n      cursor: auto !important;\n    }\n\n    .hndrd-global-cursor-dot,\n    .hndrd-global-cursor-trail,\n    .hndrd-global-cursor-focus {\n      display: none !important;\n    }\n  }\n</style>",
