      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-pro-world\" id=\"hnProWorld\" aria-label=\"Pro Series racket journey\">\n  <div class=\"hn-pro-thread\" aria-hidden=\"true\">\n    <span class=\"hn-pro-thread__line\"></span>\n    <span class=\"hn-pro-thread__dot\"></span>\n  </div>\n\n  <div class=\"hn-pro-ghost\" aria-hidden=\"true\">\n    <img id=\"hnProGhostImg\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756\" alt=\"\">\n  </div>\n\n  <!-- THE FITTING -->\n  <section class=\"hn-pro-fit\" id=\"hnProFit\">\n    <div class=\"hn-pro-fit__inner\">\n      <div class=\"hn-pro-fit__top\">\n        <p>The Fitting</p>\n        <div class=\"hn-pro-fit__steps\" aria-hidden=\"true\">\n          <span class=\"is-on\"></span>\n          <span></span>\n          <span></span>\n        </div>\n      </div>\n\n      <div class=\"hn-pro-fit__question\">\n        <p id=\"hnFitStep\">Step 01</p>\n        <h2 id=\"hnFitQuestion\">How do you play?</h2>\n      </div>\n\n      <div class=\"hn-pro-fit__options\" id=\"hnFitOptions\"></div>\n\n      <div class=\"hn-pro-fit__result\" id=\"hnFitResult\" hidden>\n        <p id=\"hnFitResultTag\">You’re built for Attack.</p>\n        <h3 id=\"hnFitResultName\">Nitrix 70 Venom</h3>\n        <p id=\"hnFitResultCopy\">Built for heavy smashes, hard rallies, and players who finish points with pressure.</p>\n\n        <div class=\"hn-pro-fit__actions\">\n          <button type=\"button\" id=\"hnFitBegin\">Begin with your match</button>\n          <a href=\"#hnProLineup\">See full lineup</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CHAPTER 01 -->\n  <section class=\"hn-pro-titlecard\" data-world-zone=\"venom\" id=\"hn-chapter-venom\" style=\"--accent:#19b84a;--accent-rgb:25,184,74;\">\n    <p>Chapter 01</p>\n    <h2>Nitrix 70 Venom</h2>\n    <span>Built to hit through the rally.</span>\n  </section>\n\n  <section class=\"hn-pro-chapter hn-pro-chapter--venom\" data-world-zone=\"venom\" style=\"--accent:#19b84a;--accent-rgb:25,184,74;\">\n    <div class=\"hn-pro-chapter__ambient\"></div>\n\n    <div class=\"hn-pro-chapter__visual\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756\" alt=\"Nitrix 70 Venom badminton racket\">\n    </div>\n\n    <div class=\"hn-pro-chapter__copy\">\n      <p class=\"hn-pro-chapter__eyebrow\">Attack</p>\n      <h2>Meet Nitrix 70 Venom</h2>\n\n      <div class=\"hn-pro-beats\">\n        <p>Built for heavy smashes.</p>\n        <p>Whip-like momentum on contact.</p>\n        <p>M46X Carbon. CNTRL Foam. 32 LBS.</p>\n      </div>\n\n      <a href=\"/products/nitrix-70-venom\">View Nitrix 70 Venom <span>→</span></a>\n    </div>\n  </section>\n\n  <div class=\"hn-pro-bleed\" style=\"--from-rgb:25,184,74;--to-rgb:31,126,216;\"></div>\n\n  <!-- CHAPTER 02 -->\n  <section class=\"hn-pro-titlecard\" data-world-zone=\"volta\" id=\"hn-chapter-volta\" style=\"--accent:#1f7ed8;--accent-rgb:31,126,216;\">\n    <p>Chapter 02</p>\n    <h2>Nitrix 70 Volta</h2>\n    <span>Power that travels clean.</span>\n  </section>\n\n  <section class=\"hn-pro-chapter hn-pro-chapter--volta\" data-world-zone=\"volta\" style=\"--accent:#1f7ed8;--accent-rgb:31,126,216;\">\n    <div class=\"hn-pro-chapter__ambient\"></div>\n\n    <div class=\"hn-pro-chapter__visual\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756\" alt=\"Nitrix 70 Volta badminton racket\">\n    </div>\n\n    <div class=\"hn-pro-chapter__copy\">\n      <p class=\"hn-pro-chapter__eyebrow\">Clean Power</p>\n      <h2>Meet Nitrix 70 Volta</h2>\n\n      <div class=\"hn-pro-beats\">\n        <p>Fast energy through the frame.</p>\n        <p>Clean strike feel under pressure.</p>\n        <p>M46X Carbon. Curve² frame. 32 LBS.</p>\n      </div>\n\n      <a href=\"/products/nitrix-70-volta\">View Nitrix 70 Volta <span>→</span></a>\n    </div>\n  </section>\n\n  <div class=\"hn-pro-bleed\" style=\"--from-rgb:31,126,216;--to-rgb:111,66,216;\"></div>\n\n  <!-- CHAPTER 03 -->\n  <section class=\"hn-pro-titlecard\" data-world-zone=\"hyfonic\" id=\"hn-chapter-hyfonic\" style=\"--accent:#6f42d8;--accent-rgb:111,66,216;\">\n    <p>Chapter 03</p>\n    <h2>Hyfonic 7</h2>\n    <span>Place the point before it begins.</span>\n  </section>\n\n  <section class=\"hn-pro-chapter hn-pro-chapter--hyfonic\" data-world-zone=\"hyfonic\" style=\"--accent:#6f42d8;--accent-rgb:111,66,216;\">\n    <div class=\"hn-pro-chapter__ambient\"></div>\n\n    <div class=\"hn-pro-chapter__visual\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Hyfonic.png?v=1753182756\" alt=\"Hyfonic 7 badminton racket\">\n    </div>\n\n    <div class=\"hn-pro-chapter__copy\">\n      <p class=\"hn-pro-chapter__eyebrow\">Precision</p>\n      <h2>Meet Hyfonic 7</h2>\n\n      <div class=\"hn-pro-beats\">\n        <p>Composed through every rally.</p>\n        <p>Sharper placement. Cleaner control.</p>\n        <p>Hyperweave Carbon. 7.0 MM shaft. 32 LBS.</p>\n      </div>\n\n      <a href=\"/products/hyfonic-7-4u\">View Hyfonic 7 <span>→</span></a>\n    </div>\n  </section>\n\n  <div class=\"hn-pro-bleed\" style=\"--from-rgb:111,66,216;--to-rgb:255,59,36;\"></div>\n\n  <!-- CHAPTER 04 -->\n  <section class=\"hn-pro-titlecard\" data-world-zone=\"flareon\" id=\"hn-chapter-flareon\" style=\"--accent:#ff3b24;--accent-rgb:255,59,36;\">\n    <p>Chapter 04</p>\n    <h2>Flareon 700</h2>\n    <span>Arrive early. Strike faster.</span>\n  </section>\n\n  <section class=\"hn-pro-chapter hn-pro-chapter--flareon\" data-world-zone=\"flareon\" style=\"--accent:#ff3b24;--accent-rgb:255,59,36;\">\n    <div class=\"hn-pro-chapter__ambient\"></div>\n\n    <div class=\"hn-pro-chapter__visual\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon.png?v=1753182756\" alt=\"Flareon 700 badminton racket\">\n    </div>\n\n    <div class=\"hn-pro-chapter__copy\">\n      <p class=\"hn-pro-chapter__eyebrow\">Speed</p>\n      <h2>Meet Flareon 700</h2>\n\n      <div class=\"hn-pro-beats\">\n        <p>Fast hands. Faster recovery.</p>\n        <p>Built to move before the rally does.</p>\n        <p>Hyperweave Carbon. Hard Flex. 32 LBS.</p>\n      </div>\n\n      <a href=\"/products/flareon-700\">View Flareon 700 <span>→</span></a>\n    </div>\n  </section>\n\n  <!-- FAMILY CLOSE -->\n  <section class=\"hn-pro-family\" id=\"hnProLineup\" data-world-zone=\"family\" style=\"--accent:#ffffff;--accent-rgb:255,255,255;\">\n    <div class=\"hn-pro-family__rackets\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756\" alt=\"Nitrix 70 Venom\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756\" alt=\"Nitrix 70 Volta\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Hyfonic.png?v=1753182756\" alt=\"Hyfonic 7\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon.png?v=1753182756\" alt=\"Flareon 700\">\n    </div>\n\n    <div class=\"hn-pro-family__copy\">\n      <p>Pro Series</p>\n      <h2>Four rackets. One obsession: winning the point.</h2>\n      <a href=\"/pages/pro-series-rackets\">Explore the full lineup <span>→</span></a>\n    </div>\n  </section>\n</section>\n\n<style>\n  .hn-pro-world,\n  .hn-pro-world *,\n  .hn-pro-world *::before,\n  .hn-pro-world *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-pro-world {\n    --accent: #19b84a;\n    --accent-rgb: 25,184,74;\n    --journey-progress: 0;\n    position: relative;\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    background: #000;\n    color: #fff;\n    overflow: clip;\n    isolation: isolate;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n  }\n\n  .hn-pro-thread {\n    position: absolute;\n    left: clamp(18px, 3vw, 54px);\n    top: 0;\n    bottom: 0;\n    z-index: 20;\n    width: 2px;\n    pointer-events: none;\n  }\n\n  .hn-pro-thread__line {\n    position: absolute;\n    inset: 0;\n    display: block;\n    background: rgba(255,255,255,0.08);\n  }\n\n  .hn-pro-thread__line::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    height: calc(var(--journey-progress) * 100%);\n    border-radius: 999px;\n    background: linear-gradient(to bottom, rgba(255,255,255,0.18), var(--accent));\n    box-shadow: 0 0 22px rgba(var(--accent-rgb),0.8);\n  }\n\n  .hn-pro-thread__dot {\n    position: sticky;\n    top: 50vh;\n    display: block;\n    width: 10px;\n    height: 10px;\n    margin-left: -4px;\n    border-radius: 999px;\n    background: var(--accent);\n    box-shadow:\n      0 0 20px rgba(var(--accent-rgb),0.85),\n      0 0 54px rgba(var(--accent-rgb),0.35);\n    transition: background 700ms cubic-bezier(.19,1,.22,1), box-shadow 700ms cubic-bezier(.19,1,.22,1);\n  }\n\n  .hn-pro-ghost {\n    position: sticky;\n    top: 0;\n    z-index: 1;\n    height: 100svh;\n    margin-bottom: -100svh;\n    pointer-events: none;\n    overflow: hidden;\n  }\n\n  .hn-pro-ghost img {\n    position: absolute;\n    right: clamp(-170px, -8vw, -70px);\n    top: 50%;\n    width: min(52vw, 650px);\n    height: auto;\n    opacity: 0.13;\n    transform: translateY(-50%) rotate(-8deg) scale(0.94);\n    filter:\n      saturate(1.1)\n      contrast(1.05)\n      brightness(0.62)\n      drop-shadow(0 42px 70px rgba(0,0,0,0.85));\n    transition:\n      opacity 700ms cubic-bezier(.19,1,.22,1),\n      transform 700ms cubic-bezier(.19,1,.22,1),\n      filter 700ms cubic-bezier(.19,1,.22,1);\n  }\n\n  .hn-pro-fit,\n  .hn-pro-titlecard,\n  .hn-pro-chapter,\n  .hn-pro-family {\n    position: relative;\n    z-index: 3;\n  }\n\n  .hn-pro-fit {\n    min-height: 100svh;\n    display: flex;\n    align-items: center;\n    padding: clamp(64px, 7vw, 110px) 20px;\n    background:\n      radial-gradient(circle at 76% 22%, rgba(var(--accent-rgb),0.12), transparent 34%),\n      linear-gradient(180deg, #000 0%, #030303 100%);\n  }\n\n  .hn-pro-fit__inner {\n    width: min(1180px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-pro-fit__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    margin-bottom: clamp(42px, 5vw, 70px);\n  }\n\n  .hn-pro-fit__top p,\n  .hn-pro-fit__question p,\n  .hn-pro-titlecard p,\n  .hn-pro-chapter__eyebrow,\n  .hn-pro-family__copy p {\n    margin: 0;\n    color: var(--accent);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .hn-pro-fit__steps {\n    display: flex;\n    gap: 8px;\n  }\n\n  .hn-pro-fit__steps span {\n    width: 34px;\n    height: 3px;\n    border-radius: 99px;\n    background: rgba(255,255,255,.16);\n    overflow: hidden;\n    position: relative;\n  }\n\n  .hn-pro-fit__steps span::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    transform: scaleX(0);\n    transform-origin: left;\n    background: var(--accent);\n    transition: transform 560ms cubic-bezier(.19,1,.22,1);\n  }\n\n  .hn-pro-fit__steps span.is-on::after,\n  .hn-pro-fit__steps span.is-done::after {\n    transform: scaleX(1);\n  }\n\n  .hn-pro-fit__question h2,\n  .hn-pro-titlecard h2,\n  .hn-pro-family__copy h2 {\n    margin: 16px 0 0;\n    max-width: 9ch;\n    color: #fff;\n    font-size: clamp(54px, 8vw, 126px);\n    line-height: .86;\n    font-weight: 950;\n    letter-spacing: -.085em;\n    text-shadow: 0 30px 80px rgba(0,0,0,.9);\n  }\n\n  .hn-pro-fit__options {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: clamp(12px, 1.5vw, 20px);\n    margin-top: clamp(40px, 5vw, 70px);\n  }\n\n  .hn-pro-fit__option {\n    --option-rgb: 255,255,255;\n    position: relative;\n    min-height: clamp(160px, 20vh, 225px);\n    padding: clamp(22px, 2.5vw, 34px);\n    border-radius: 34px;\n    border: 1px solid rgba(255,255,255,.11);\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)),\n      rgba(5,5,5,.84);\n    color: #fff;\n    text-align: left;\n    cursor: pointer;\n    overflow: hidden;\n    transition:\n      transform 420ms cubic-bezier(.19,1,.22,1),\n      border-color 420ms cubic-bezier(.19,1,.22,1),\n      box-shadow 420ms cubic-bezier(.19,1,.22,1);\n  }\n\n  .hn-pro-fit__option::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(circle at var(--mx,70%) var(--my,20%), rgba(var(--option-rgb),.24), transparent 38%);\n    opacity: 0;\n    transition: opacity 360ms cubic-bezier(.19,1,.22,1);\n    pointer-events: none;\n  }\n\n  .hn-pro-fit__option small,\n  .hn-pro-fit__option strong {\n    position: relative;\n    z-index: 2;\n  }\n\n  .hn-pro-fit__option small {\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    margin-bottom: 42px;\n    border-radius: 999px;\n    color: rgba(255,255,255,.7);\n    background: rgba(255,255,255,.07);\n    border: 1px solid rgba(255,255,255,.11);\n    font-size: 11px;\n    font-weight: 900;\n  }\n\n  .hn-pro-fit__option strong {\n    display: block;\n    max-width: 10ch;\n    color: #fff;\n    font-size: clamp(24px, 2.2vw, 38px);\n    line-height: .96;\n    font-weight: 900;\n    letter-spacing: -.058em;\n  }\n\n  .hn-pro-fit__option:hover {\n    transform: translateY(-6px) scale(1.02);\n    border-color: rgba(var(--option-rgb),.48);\n    box-shadow:\n      0 34px 90px rgba(0,0,0,.58),\n      0 0 42px rgba(var(--option-rgb),.12);\n  }\n\n  .hn-pro-fit__option:hover::before {\n    opacity: 1;\n  }\n\n  .hn-pro-fit__result {\n    width: min(760px, 100%);\n    margin-top: clamp(34px, 5vw, 60px);\n    padding: clamp(24px, 3vw, 40px);\n    border-radius: 32px;\n    background:\n      radial-gradient(circle at 80% 0%, rgba(var(--accent-rgb),.16), transparent 42%),\n      linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.012)),\n      #030303;\n    border: 1px solid rgba(255,255,255,.1);\n    box-shadow: 0 34px 100px rgba(0,0,0,.62);\n    animation: hnProFade .7s cubic-bezier(.19,1,.22,1) both;\n  }\n\n  .hn-pro-fit__result h3 {\n    margin: 12px 0 0;\n    color: #fff;\n    font-size: clamp(38px, 5vw, 78px);\n    line-height: .88;\n    font-weight: 950;\n    letter-spacing: -.08em;\n  }\n\n  .hn-pro-fit__result > p:last-of-type {\n    max-width: 48ch;\n    margin: 22px 0 0;\n    color: rgba(255,255,255,.72);\n    font-size: clamp(15px, 1.15vw, 18px);\n    line-height: 1.55;\n  }\n\n  .hn-pro-fit__actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    margin-top: 28px;\n  }\n\n  .hn-pro-fit__actions button,\n  .hn-pro-fit__actions a,\n  .hn-pro-chapter__copy a,\n  .hn-pro-family__copy a {\n    min-height: 48px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    padding: 0 22px;\n    border-radius: 999px;\n    border: 1px solid rgba(var(--accent-rgb),.62);\n    background: rgba(var(--accent-rgb),.1);\n    color: #fff;\n    text-decoration: none;\n    font: inherit;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 900;\n    cursor: pointer;\n  }\n\n  .hn-pro-fit__actions a {\n    background: transparent;\n    border-color: rgba(255,255,255,.14);\n    color: rgba(255,255,255,.66);\n  }\n\n  .hn-pro-titlecard {\n    min-height: 86svh;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: clamp(70px, 8vw, 128px) clamp(24px, 8vw, 140px);\n    background:\n      radial-gradient(circle at 65% 42%, rgba(var(--accent-rgb),.18), transparent 38%),\n      linear-gradient(180deg, #000, #030303);\n  }\n\n  .hn-pro-titlecard span {\n    display: block;\n    margin-top: 24px;\n    color: rgba(255,255,255,.68);\n    font-size: clamp(16px, 1.6vw, 24px);\n    line-height: 1.45;\n    font-weight: 560;\n    letter-spacing: -.02em;\n  }\n\n  .hn-pro-chapter {\n    --p: 0;\n    min-height: 110svh;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(360px, .85fr);\n    gap: clamp(34px, 6vw, 96px);\n    align-items: center;\n    padding: clamp(70px, 8vw, 120px) clamp(24px, 7vw, 120px);\n    background:\n      radial-gradient(circle at 24% 38%, rgba(var(--accent-rgb),.22), transparent 34%),\n      radial-gradient(circle at 82% 70%, rgba(var(--accent-rgb),.08), transparent 36%),\n      #000;\n    overflow: hidden;\n  }\n\n  .hn-pro-chapter__ambient {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .65;\n    background:\n      radial-gradient(circle at 20% calc(80% - var(--p) * 20%), rgba(var(--accent-rgb),.12), transparent 3px),\n      radial-gradient(circle at 70% calc(20% + var(--p) * 30%), rgba(255,255,255,.08), transparent 2px),\n      radial-gradient(circle at 88% calc(74% - var(--p) * 28%), rgba(var(--accent-rgb),.18), transparent 3px);\n    background-size: 180px 220px, 240px 260px, 310px 300px;\n    animation: hnProAmbient 8s linear infinite;\n  }\n\n  .hn-pro-chapter--volta .hn-pro-chapter__ambient {\n    background:\n      linear-gradient(115deg, transparent 0 42%, rgba(var(--accent-rgb),.16) 44%, transparent 47%),\n      linear-gradient(70deg, transparent 0 55%, rgba(255,255,255,.08) 57%, transparent 59%);\n    opacity: .5;\n    animation: hnProFlicker 3s ease-in-out infinite;\n  }\n\n  .hn-pro-chapter--flareon .hn-pro-chapter__ambient {\n    background:\n      radial-gradient(circle, rgba(var(--accent-rgb),.32), transparent 3px),\n      radial-gradient(circle, rgba(255,255,255,.16), transparent 2px);\n    background-size: 180px 240px, 260px 320px;\n    animation: hnProEmbers 9s linear infinite;\n  }\n\n  .hn-pro-chapter__visual {\n    position: relative;\n    min-height: clamp(420px, 72vh, 720px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-pro-chapter__visual::before {\n    content: \"\";\n    position: absolute;\n    width: 78%;\n    aspect-ratio: 1;\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(var(--accent-rgb),.26), transparent 68%);\n    filter: blur(44px);\n    opacity: calc(.55 + var(--p) * .35);\n  }\n\n  .hn-pro-chapter__visual img {\n    position: relative;\n    z-index: 2;\n    width: min(80%, 560px);\n    height: auto;\n    transform:\n      translateY(calc(34px - var(--p) * 68px))\n      rotate(calc(-11deg + var(--p) * 9deg))\n      scale(calc(.94 + var(--p) * .08));\n    filter:\n      saturate(1.12)\n      contrast(1.05)\n      drop-shadow(0 42px 62px rgba(0,0,0,.82))\n      drop-shadow(0 0 44px rgba(var(--accent-rgb),.18));\n    will-change: transform;\n  }\n\n  .hn-pro-chapter__copy {\n    position: relative;\n    z-index: 2;\n  }\n\n  .hn-pro-chapter__copy h2 {\n    margin: 16px 0 0;\n    color: #fff;\n    font-size: clamp(46px, 6vw, 94px);\n    line-height: .87;\n    font-weight: 950;\n    letter-spacing: -.085em;\n    max-width: 9ch;\n  }\n\n  .hn-pro-beats {\n    margin-top: clamp(28px, 3vw, 44px);\n  }\n\n  .hn-pro-beats p {\n    --show: 0;\n    margin: 0;\n    max-width: 42ch;\n    color: rgba(255,255,255,.76);\n    font-size: clamp(17px, 1.55vw, 25px);\n    line-height: 1.36;\n    font-weight: 620;\n    letter-spacing: -.03em;\n    opacity: var(--show);\n    transform: translateY(calc((1 - var(--show)) * 18px));\n  }\n\n  .hn-pro-beats p + p {\n    margin-top: 14px;\n  }\n\n  .hn-pro-chapter__copy a,\n  .hn-pro-family__copy a {\n    margin-top: 36px;\n  }\n\n  .hn-pro-bleed {\n    height: clamp(220px, 24vw, 390px);\n    background:\n      radial-gradient(circle at 30% 50%, rgba(var(--from-rgb),.28), transparent 42%),\n      radial-gradient(circle at 70% 50%, rgba(var(--to-rgb),.28), transparent 42%),\n      linear-gradient(90deg, rgba(var(--from-rgb),.14), rgba(var(--to-rgb),.14)),\n      #000;\n    filter: saturate(1.08);\n  }\n\n  .hn-pro-family {\n    min-height: 100svh;\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap: clamp(28px, 5vw,