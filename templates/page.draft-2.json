  <span class=\"inn\">\n          Enter Precision Mode\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M5 12h14\"/>\n            <path d=\"m12 5 7 7-7 7\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n  </div>\n</section>\n\n<div class=\"div\"></div>\n\n<section class=\"chap\" style=\"--ac:#ef4444;--rgb:239,68,68;--gl:rgba(239,68,68,.15)\">\n  <div class=\"bg\"></div>\n  <div class=\"blur\"></div>\n  <div class=\"thread\"><i></i></div>\n\n  <div class=\"inner rev\">\n    <div class=\"copy\">\n      <p class=\"ser\">Speed Series</p>\n      <h2>Flareon 700</h2>\n      <h3>Move First. Hit Faster.</h3>\n\n      <p class=\"desc\">\n        Designed for quick hands, sharp reactions and rapid-fire exchanges when the rally gets fast.\n      </p>\n\n      <div class=\"spec\">\n        <div>\n          <b>7.0mm</b>\n          <span>Shaft Dia.</span>\n        </div>\n        <div>\n          <b>Hard</b>\n          <span>Flex</span>\n        </div>\n        <div>\n          <b>32 Lbs</b>\n          <span>Max Tension</span>\n        </div>\n      </div>\n\n      <a href=\"https://in.hndrd.co/products/flareon-700-3u\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:#ef4444;--sr:239,68,68\">\n        <span class=\"bgb\"></span>\n        <span class=\"bgt\"></span>\n        <span class=\"inn\">\n          Enter Speed Mode\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M5 12h14\"/>\n            <path d=\"m12 5 7 7-7 7\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n\n    <div class=\"vis\">\n      <span class=\"orb\"></span>\n      <img src=\"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941\" alt=\"Flareon 700\">\n    </div>\n  </div>\n</section>\n\n<div class=\"qt\">\n  <button type=\"button\" data-open>Find Your Racket</button>\n</div>\n\n<div class=\"quiz\">\n  <div class=\"modal\">\n    <button class=\"close\" type=\"button\" data-close>&times;</button>\n\n    <div class=\"step on\" data-step=\"1\">\n      <p class=\"qeyebrow\">Quick Match</p>\n      <h3>Choose your style.</h3>\n      <p class=\"qsub\">We’ll suggest your racket.</p>\n\n      <button type=\"button\" data-res=\"venom\" style=\"--q:rgba(34,197,94,.9)\">\n        <span>Attack</span>\n      </button>\n\n      <button type=\"button\" data-res=\"volta\" style=\"--q:rgba(59,130,246,.9)\">\n        <span>Power</span>\n      </button>\n\n      <button type=\"button\" data-res=\"hyfonic\" style=\"--q:rgba(168,85,247,.9)\">\n        <span>Precision</span>\n      </button>\n\n      <button type=\"button\" data-res=\"flareon\" style=\"--q:rgba(239,68,68,.9)\">\n        <span>Speed</span>\n      </button>\n    </div>\n\n    <div class=\"step\" data-step=\"result\">\n      <div class=\"res\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  const root = document.getElementById(\"hnps-{{ sid }}\");\n  if (!root || root.dataset.r) return;\n  root.dataset.r = 1;\n\n  const dot = root.querySelector(\".cdot\");\n  const tc = root.querySelector(\".tc\");\n  const cs = tc ? [...tc.querySelectorAll(\".cr\")] : [];\n\n  let mx = 0;\n  let my = 0;\n  let dx = 0;\n  let dy = 0;\n  let last = 0;\n  let tg = null;\n\n  const fine = matchMedia(\"(pointer:fine)\").matches && innerWidth > 768;\n\n  function trail(x, y) {\n    let n = performance.now();\n    if (n - last < 18) return;\n    last = n;\n\n    let e = document.createElement(\"span\");\n    e.className = \"trail\";\n    e.style.left = x + \"px\";\n    e.style.top = y + \"px\";\n    root.appendChild(e);\n\n    setTimeout(() => e.remove(), 650);\n  }\n\n  function corners(el, e) {\n    if (!el || !cs.length) return;\n\n    let r = el.getBoundingClientRect();\n    let p = 7;\n    let s = 14;\n    let px = 0;\n    let py = 0;\n\n    if (e) {\n      px = (e.clientX - (r.left + r.width / 2)) * .035;\n      py = (e.clientY - (r.top + r.height / 2)) * .035;\n    }\n\n    [\n      [r.left - p + px, r.top - p + py],\n      [r.right + p - s + px, r.top - p + py],\n      [r.right + p - s + px, r.bottom + p - s + py],\n      [r.left - p + px, r.bottom + p - s + py]\n    ].forEach((a, i) => {\n      cs[i].style.left = a[0] + \"px\";\n      cs[i].style.top = a[1] + \"px\";\n    });\n  }\n\n  if (dot && fine) {\n    root.addEventListener(\"mouseenter\", () => dot.style.opacity = 1);\n\n    root.addEventListener(\"mouseleave\", () => {\n      dot.style.opacity = 0;\n      tc.classList.remove(\"on\");\n      tg = null;\n    });\n\n    root.addEventListener(\"mousemove\", e => {\n      mx = e.clientX;\n      my = e.clientY;\n      trail(mx, my);\n\n      let x = e.target.closest(\".cursor-target\");\n\n      if (x) {\n        tg = x;\n        root.style.setProperty(\"--cc\", \"rgb(\" + (x.style.getPropertyValue(\"--sr\") || \"255,255,255\") + \")\");\n        tc.classList.add(\"on\");\n        corners(x, e);\n      } else {\n        tg = null;\n        tc.classList.remove(\"on\");\n      }\n    });\n\n    addEventListener(\"scroll\", () => {\n      if (tg) corners(tg);\n    }, { passive: true });\n\n    addEventListener(\"resize\", () => {\n      if (tg) corners(tg);\n    });\n\n    (function animateDot() {\n      dx += (mx - dx) * .22;\n      dy += (my - dy) * .22;\n      dot.style.left = dx + \"px\";\n      dot.style.top = dy + \"px\";\n      requestAnimationFrame(animateDot);\n    })();\n  }\n\n  const rot = root.querySelector(\".rot\");\n\n  if (rot) {\n    let w;\n\n    try {\n      w = JSON.parse(rot.dataset.rotate);\n    } catch (e) {\n      w = [\"Attack\", \"Power\", \"Precision\", \"Speed\"];\n    }\n\n    let i = 0;\n\n    function split(s) {\n      if (window.Intl && Intl.Segmenter) {\n        let g = new Intl.Segmenter(\"en\", { granularity: \"grapheme\" });\n        return Array.from(g.segment(s), x => x.segment);\n      }\n\n      return Array.from(s);\n    }\n\n    function draw(x) {\n      rot.innerHTML = \"\";\n\n      let sr = document.createElement(\"span\");\n      sr.className = \"rsr\";\n      sr.textContent = x;\n\n      let wr = document.createElement(\"span\");\n      wr.className = \"rw\";\n      wr.setAttribute(\"aria-hidden\", \"true\");\n\n      let ar = split(x);\n\n      ar.forEach((c, n) => {\n        let sp = document.createElement(\"span\");\n        sp.className = \"rch\";\n        sp.textContent = c;\n        sp.style.setProperty(\"--d\", ((ar.length - 1 - n) * 25) + \"ms\");\n        wr.appendChild(sp);\n      });\n\n      rot.append(sr, wr);\n    }\n\n    draw(w[i] || \"Attack\");\n\n    setInterval(() => {\n      i = (i + 1) % w.length;\n      draw(w[i]);\n    }, 2000);\n  }\n\n  const rv = root.querySelector(\".rtext\");\n\n  if (rv) {\n    let ws = rv.textContent.trim().split(/\\s+/);\n\n    rv.innerHTML = ws.map(x => \"<span class='word'>\" + x + \"</span>\").join(\" \");\n\n    let sp = [...rv.querySelectorAll(\".word\")];\n\n    let ob = new IntersectionObserver(es => {\n      es.forEach(en => {\n        if (en.isIntersecting) {\n          sp.forEach((w, i) => setTimeout(() => w.classList.add(\"show\"), i * 55));\n          ob.unobserve(en.target);\n        }\n      });\n    }, { threshold: .3 });\n\n    ob.observe(rv);\n  }\n\n  let ch = [...root.querySelectorAll(\".chap\")];\n\n  let co = new IntersectionObserver(es => {\n    es.forEach(en => {\n      if (en.isIntersecting) en.target.classList.add(\"visible\");\n\n      let r = en.intersectionRatio;\n      en.target.classList.toggle(\"blurring\", r < .3 && r > 0);\n    });\n  }, { threshold: [0, .15, .3, .5, .8, 1] });\n\n  ch.forEach(c => co.observe(c));\n\n  const qt = root.querySelector(\".qt\");\n\n  function toggleFloating() {\n    if (!ch.length) return;\n\n    const first = ch[0].getBoundingClientRect();\n    const lastChap = ch[ch.length - 1].getBoundingClientRect();\n    const trigger = innerHeight * .5;\n    const show = first.top <= trigger && lastChap.bottom >= trigger;\n\n    if (qt) qt.classList.toggle(\"visible\", show);\n  }\n\n  function updateProgress() {\n    if (!ch.length) return;\n\n    const trigger = innerHeight * .5;\n    let active = 0;\n    let close = 999999;\n\n    ch.forEach((sec, i) => {\n      const r = sec.getBoundingClientRect();\n      const center = r.top + r.height / 2;\n      const dist = Math.abs(center - trigger);\n\n      if (dist < close) {\n        close = dist;\n        active = i;\n      }\n\n      let p = (trigger - r.top) / r.height;\n      p = Math.max(0, Math.min(1, p));\n\n      sec.style.setProperty(\"--dot-progress\", p.toFixed(4));\n      sec.style.setProperty(\"--line-progress\", p.toFixed(4));\n      sec.classList.toggle(\"passed\", p >= .98);\n    });\n\n    ch.forEach((sec, i) => sec.classList.toggle(\"active\", i === active));\n\n    toggleFloating();\n  }\n\n  let tick = false;\n\n  function onScroll() {\n    if (tick) return;\n\n    tick = true;\n\n    requestAnimationFrame(() => {\n      updateProgress();\n      tick = false;\n    });\n  }\n\n  addEventListener(\"scroll\", onScroll, { passive: true });\n  addEventListener(\"resize\", updateProgress);\n  updateProgress();\n\n  let q = root.querySelector(\".quiz\");\n  let steps = [...root.querySelectorAll(\".step\")];\n  let res = root.querySelector(\".res\");\n\n  function show(n) {\n    steps.forEach(s => s.classList.toggle(\"on\", s.dataset.step == n));\n  }\n\n  function reset() {\n    show(1);\n  }\n\n  function open() {\n    q.classList.add(\"on\");\n    document.body.style.overflow = \"hidden\";\n    reset();\n  }\n\n  function close() {\n    q.classList.remove(\"on\");\n    document.body.style.overflow = \"\";\n  }\n\n  root.querySelector(\"[data-open]\")?.addEventListener(\"click\", open);\n  root.querySelector(\"[data-close]\")?.addEventListener(\"click\", close);\n\n  q?.addEventListener(\"click\", e => {\n    if (e.target === q) close();\n  });\n\n  let data = {\n    venom: [\n      \"Nitrix 70 Venom\",\n      \"Attack\",\n      \"#22c55e\",\n      \"34,197,94\",\n      \"For aggressive players who want heavier smashes and stronger follow-through.\",\n      \"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=900\",\n      \"https://in.hndrd.co/products/nitrix-70-venom\"\n    ],\n    volta: [\n      \"Nitrix 70 Volta\",\n      \"Power\",\n      \"#3b82f6\",\n      \"59,130,246\",\n      \"For players who want fast swing speed, crisp impact and clean attacking power.\",\n      \"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=900\",\n      \"https://in.hndrd.co/products/nitrix-70-volta\"\n    ],\n    hyfonic: [\n      \"Hyfonic 7\",\n      \"Precision\",\n      \"#a855f7\",\n      \"168,85,247\",\n      \"For players who want stable control, sharp placement and composed feedback.\",\n      \"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=900\",\n      \"https://in.hndrd.co/products/hyfonic-7-4u\"\n    ],\n    flareon: [\n      \"Flareon 700\",\n      \"Speed\",\n      \"#ef4444\",\n      \"239,68,68\",\n      \"For players who win through reactions, fast hands and quick exchanges.\",\n      \"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941\",\n      \"https://in.hndrd.co/products/flareon-700-3u\"\n    ]\n  };\n\n  root.querySelectorAll(\"[data-res]\").forEach(b => {\n    b.addEventListener(\"click\", () => {\n      let r = data[b.dataset.res] || data.venom;\n\n      show(\"result\");\n\n      res.innerHTML =\n        `<img src=\"${r[5]}\" alt=\"${r[0]}\">\n        <p style=\"color:${r[2]}\">${r[1]} Series</p>\n        <h3>${r[0]}</h3>\n        <span class=\"rdesc\">${r[4]}</span>\n        <a href=\"${r[6]}\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:${r[2]};--sr:${r[3]}\">\n          <span class=\"bgb\"></span>\n          <span class=\"bgt\"></span>\n          <span class=\"inn\">\n            Shop Now\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"/>\n              <path d=\"m12 5 7 7-7 7\"/>\n            </svg>\n          </span>\n        </a>`;\n    });\n  });\n\n  document.addEventListener(\"keydown\", e => {\n    if (e.key === \"Escape\") close();\n  });\n})();\n</script>\n<style>\n  /* ROUNDED PRODUCT IMAGES — ONLY THIS SECTION */\n  #hnps-{{ sid }} .vis img {\n    border-radius: 30px !important;\n    overflow: hidden !important;\n    clip-path: inset(0 round 30px) !important;\n    background: #050505 !important;\n    border: 1px solid rgba(255,255,255,0.08) !important;\n  }\n\n  @media screen and (max-width: 640px) {\n    #hnps-{{ sid }} .vis img {\n      border-radius: 22px !important;\n      clip-path: inset(0 round 22px) !important;\n    }\n  }\n</style>\n<style>\n  /* FINAL ROTATING TEXT — WORD COLOR BY STYLE */\n\n  #hnps-{{ sid }} .title,\n  #hnps-{{ sid }} .tlx {\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    background: transparent !important;\n    background-image: none !important;\n  }\n\n  #hnps-{{ sid }} .tlx {\n    display: inline-flex !important;\n    align-items: baseline !important;\n    justify-content: center !important;\n    gap: 0.14em !important;\n    line-height: 0.95 !important;\n  }\n\n  #hnps-{{ sid }} .rot.hn-style-rot {\n    display: inline-flex !important;\n    align-items: baseline !important;\n    justify-content: center !important;\n    width: auto !important;\n    min-width: 0 !important;\n    height: auto !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    overflow: visible !important;\n    background: transparent !important;\n    background-image: none !important;\n    background-color: transparent !important;\n    box-shadow: none !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    vertical-align: baseline !important;\n    line-height: 0.95 !important;\n  }\n\n  #hnps-{{ sid }} .rot.hn-style-rot .rsr {\n    position: absolute !important;\n    display: block !important;\n    width: 1px !important;\n    height: 1px !important;\n    overflow: hidden !important;\n    clip: rect(0,0,0,0) !important;\n    white-space: nowrap !important;\n  }\n\n  #hnps-{{ sid }} .rot.hn-style-rot .rw {\n    display: inline-flex !important;\n    align-items: baseline !important;\n    white-space: nowrap !important;\n    width: auto !important;\n    height: auto !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    overflow: visible !important;\n    line-height: 0.95 !important;\n    background: transparent !important;\n    background-image: none !important;\n    box-shadow: none !important;\n  }\n\n  #hnps-{{ sid }} .rot.hn-style-rot .rch {\n    display: inline-block !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    line-height: 0.95 !important;\n    letter-spacing: -0.035em !important;\n\n    background-image: linear-gradient(\n      90deg,\n      var(--word-a),\n      var(--word-b)\n    ) !important;\n    background-size: var(--word-w, 100%) 100% !important;\n    background-position: var(--word-x, 0px) 0 !important;\n    background-repeat: no-repeat !important;\n\n    -webkit-background-clip: text !important;\n    background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    color: transparent !important;\n\n    opacity: 0;\n    transform: translateY(115%) rotate(6deg);\n    animation: hnStyleRotIn-{{ sid }} 0.72s cubic-bezier(.16,1,.3,1) forwards;\n    animation-delay: var(--d);\n    animation-play-state: paused !important;\n  }\n\n  #hnps-{{ sid }} .rot.hn-style-rot .rw.is-ready .rch {\n    animation-play-state: running !important;\n  }\n\n  @keyframes hnStyleRotIn-{{ sid }} {\n    0% {\n      opacity: 0;\n      transform: translateY(115%) rotate(6deg);\n      filter: blur(8px);\n    }\n\n    100% {\n      opacity: 1;\n      transform: translateY(0) rotate(0);\n      filter:\n        drop-shadow(0 0 8px var(--word-glow-a))\n        drop-shadow(0 0 18px var(--word-glow-b));\n    }\n  }\n\n  @media screen and (max-width: 640px) {\n    #hnps-{{ sid }} .tlx {\n      gap: 0.1em !important;\n    }\n\n    #hnps-{{ sid }} .rot.hn-style-rot .rch {\n      letter-spacing: -0.03em !important;\n    }\n  }\n/* REMOVE CUSTOM CURSOR - KEEP ORIGINAL BROWSER CURSOR */\n#hnps-{{sid}},\n#hnps-{{sid}} *,\n#hnps-{{sid}} a,\n#hnps-{{sid}} button,\n#hnps-{{sid}} .cursor-target{\n  cursor:auto!important;\n}\n\n#hnps-{{sid}} a,\n#hnps-{{sid}} button{\n  cursor:pointer!important;\n}\n\n#hnps-{{sid}} .cdot,\n#hnps-{{sid}} .tc,\n#hnps-{{sid}} .trail,\n#hnps-{{sid}} .cr{\n  display:none!important;\n  opacity:0!important;\n  visibility:hidden!important;\n  pointer-events:none!important;\n}\n</style>\n\n<script>\n(function () {\n  var root = document.getElementById(\"hnps-{{ sid }}\");\n  if (!root) return;\n\n  var oldRot = root.querySelector(\".rot\");\n  if (!oldRot) return;\n\n  if (root.__hnRotCleanTimer) clearInterval(root.__hnRotCleanTimer);\n  if (root.__hnRotWholeGradientTimer) clearInterval(root.__hnRotWholeGradientTimer);\n  if (root.__hnFinalRotTimer) clearInterval(root.__hnFinalRotTimer);\n  if (root.__hnPerfectRotTimer) clearInterval(root.__hnPerfectRotTimer);\n  if (root.__hnStyleRotTimer) clearInterval(root.__hnStyleRotTimer);\n\n  var rot = document.createElement(\"span\");\n  rot.className = \"rot hn-style-rot\";\n  rot.setAttribute(\"aria-live\", \"polite\");\n\n  oldRot.parentNode.replaceChild(rot, oldRot);\n\n  var words = [\n    {\n      text: \"Attack\",\n      a: \"#22c55e\",\n      b: \"#86efac\",\n      glowA: \"rgba(34,197,94,.34)\",\n      glowB: \"rgba(34,197,94,.18)\"\n    },\n    {\n      text: \"Power\",\n      a: \"#3b82f6\",\n      b: \"#60a5fa\",\n      glowA: \"rgba(59,130,246,.34)\",\n      glowB: \"rgba(59,130,246,.18)\"\n    },\n    {\n      text: \"Precision\",\n      a: \"#a855f7\",\n      b: \"#d946ef\",\n      glowA: \"rgba(168,85,247,.34)\",\n      glowB: \"rgba(217,70,239,.18)\"\n    },\n    {\n      text: \"Speed\",\n      a: \"#ef4444\",\n      b: \"#fb7185\",\n      glowA: \"rgba(239,68,68,.34)\",\n      glowB: \"rgba(239,68,68,.18)\"\n    }\n  ];\n\n  var index = 0;\n\n  function splitText(text) {\n    if (window.Intl && Intl.Segmenter) {\n      var segmenter = new Intl.Segmenter(\"en\", { granularity: \"grapheme\" });\n      return Array.from(segmenter.segment(text), function (x) {\n        return x.segment;\n      });\n    }\n\n    return Array.from(text);\n  }\n\n  function applyWholeWordColor(wrapper) {\n    if (!wrapper) return;\n\n    var wrapperRect = wrapper.getBoundingClientRect();\n    var wrapperWidth = Math.max(1, wrapperRect.width);\n    var letters = Array.prototype.slice.call(wrapper.querySelectorAll(\".rch\"));\n\n    letters.forEach(function (letter) {\n      var letterRect = letter.getBoundingClientRect();\n      var x = letterRect.left - wrapperRect.left;\n\n      letter.style.setProperty(\"--word-w\", wrapperWidth + \"px\");\n      letter.style.setProperty(\"--word-x\", (-x) + \"px\");\n    });\n\n    wrapper.classList.add(\"is-ready\");\n  }\n\n  function draw(item) {\n    rot.innerHTML = \"\";\n\n    rot.style.setProperty(\"--word-a\", item.a);\n    rot.style.setProperty(\"--word-b\", item.b);\n    rot.style.setProperty(\"--word-glow-a\", item.glowA);\n    rot.style.setProperty(\"--word-glow-b\", item.glowB);\n\n    var sr = document.createElement(\"span\");\n    sr.className = \"rsr\";\n    sr.textContent = item.text;\n\n    var wrapper = document.createElement(\"span\");\n    wrapper.className = \"rw\";\n    wrapper.setAttribute(\"aria-hidden\", \"true\");\n\n    var chars = splitText(item.text);\n\n    chars.forEach(function (char, n) {\n      var span = document.createElement(\"span\");\n      span.className = \"rch\";\n      span.textContent = char;\n      span.style.setProperty(\"--d\", ((chars.length - 1 - n) * 25) + \"ms\");\n      wrapper.appendChild(span);\n    });\n\n    rot.appendChild(sr);\n    rot.appendChild(wrapper);\n\n    requestAnimationFrame(function () {\n      requestAnimationFrame(function () {\n        applyWholeWordColor(wrapper);\n      });\n    });\n  }\n\n  draw(words[index]);\n\n  root.__hnStyleRotTimer = setInterval(function () {\n    index = (index + 1) % words.length;\n    draw(words[index]);\n  }, 2000);\n\n  window.addEventListener(\"resize\", function () {\n    var wrapper = rot.querySelector(\".rw\");\n    applyWholeWordColor(wrapper);\n  });\n})();\n</script>\n\n</section>",
        "color_scheme": "scheme-4",
        "padding_top": 40,
        "padding_bottom": 52
      }
