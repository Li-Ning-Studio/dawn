        "custom_liquid": "<section\n  style=\"\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n  \"\n>\n  <p style=\"margin-bottom: 0\">Introducing</p>\n\n  <h1 style=\"margin: 0; font-weight: 900; letter-spacing: -1px\" class=\"title\">\n    Peak Performance Trio\n  </h1>\n\n  <p style=\"margin-top: 3px\">Pro Rackets Series from HNDRD.</p>\n\n  <a href=\"/collections/flagship\" class=\"cta\">\n    <span>Explore</span>\n  </a>\n</section>\n\n<style>\n  .cta {\n    margin-top: 2rem;\n    background: transparent;\n    border: 1.5px solid #ff0066;\n    font-weight: 700;\n    padding: 1.6rem 3.1rem;\n    border-radius: 500px;\n    cursor: pointer !important;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: white;\n    text-decoration: none;\n    font-size: 1.5rem;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .title {\n    font-size: 3.2rem;\n    background-image: linear-gradient(\n      -225deg,\n      #a445b2 0%,\n      #d41872 52%,\n      #ff0066 100%\n    );\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n\n  @media screen and (min-width: 750px) {\n    .title {\n      font-size: 6rem;\n    }\n  }\n\n  /* FORCE NORMAL CURSOR BACK */\n  html,\n  body,\n  body *,\n  a,\n  button,\n  [role=\"button\"],\n  input,\n  textarea,\n  select {\n    cursor: auto !important;\n  }\n\n  a,\n  button,\n  [role=\"button\"],\n  .cta {\n    cursor: pointer !important;\n  }\n\n  .hndrd-global-cursor-dot,\n  .hndrd-global-cursor-trail,\n  .hndrd-global-cursor-focus,\n  .hndrd-global-cursor-corner {\n    display: none !important;\n    opacity: 0 !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n  }\n</style>\n<style>\n  /* HNDRD GLOBAL CTA FOCUS EFFECT - NORMAL CURSOR */\n\n  html,\n  body,\n  body *,\n  a,\n  button,\n  [role=\"button\"],\n  input,\n  textarea,\n  select {\n    cursor: auto !important;\n  }\n\n  a,\n  button,\n  [role=\"button\"],\n  input[type=\"button\"],\n  input[type=\"submit\"],\n  .cta,\n  .cta2,\n  .cta3,\n  .btn,\n  .button,\n  .star,\n  .cursor-target,\n  .hndrd-focus-target,\n  .shopify-payment-button__button {\n    cursor: pointer !important;\n  }\n\n  /* Remove old fake cursor only */\n  .hndrd-global-cursor-dot,\n  .hndrd-global-cursor-trail,\n  .cdot,\n  .trail {\n    display: none !important;\n    opacity: 0 !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n  }\n\n  /* Hide old focus layer to avoid duplicate corners */\n  .hndrd-global-cursor-focus {\n    display: none !important;\n  }\n\n  .hndrd-cta-focus-layer {\n    position: fixed !important;\n    inset: 0;\n    z-index: 2147483645 !important;\n    pointer-events: none !important;\n    opacity: 0;\n    transition: opacity .16s ease;\n  }\n\n  .hndrd-cta-focus-layer.is-active {\n    opacity: 1;\n  }\n\n  .hndrd-cta-focus-corner {\n    position: fixed !important;\n    width: 18px;\n    height: 18px;\n    border: 2px solid var(--hndrd-focus-color, #ffffff);\n    pointer-events: none !important;\n    opacity: 0;\n    filter: drop-shadow(0 0 8px var(--hndrd-focus-color, rgba(255,255,255,.55)));\n    transition:\n      left .18s ease,\n      top .18s ease,\n      opacity .16s ease,\n      border-color .16s ease,\n      filter .16s ease;\n  }\n\n  .hndrd-cta-focus-layer.is-active .hndrd-cta-focus-corner {\n    opacity: 1;\n  }\n\n  .hndrd-cta-focus-corner--tl {\n    border-right: 0;\n    border-bottom: 0;\n  }\n\n  .hndrd-cta-focus-corner--tr {\n    border-left: 0;\n    border-bottom: 0;\n  }\n\n  .hndrd-cta-focus-corner--br {\n    border-left: 0;\n    border-top: 0;\n  }\n\n  .hndrd-cta-focus-corner--bl {\n    border-right: 0;\n    border-top: 0;\n  }\n\n  @media (pointer: coarse), (max-width: 768px) {\n    .hndrd-cta-focus-layer {\n      display: none !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  if (window.__hndrdGlobalCtaFocusOnlyV1) return;\n  window.__hndrdGlobalCtaFocusOnlyV1 = true;\n\n  function ready(fn) {\n    if (document.readyState !== \"loading\") fn();\n    else document.addEventListener(\"DOMContentLoaded\", fn);\n  }\n\n  ready(function () {\n    document.querySelectorAll(\".hndrd-global-cursor-dot, .hndrd-global-cursor-trail, .cdot, .trail\").forEach(function (el) {\n      el.remove();\n    });\n\n    var oldFocus = document.querySelector(\".hndrd-global-cursor-focus\");\n    if (oldFocus) oldFocus.remove();\n\n    var layer = document.querySelector(\".hndrd-cta-focus-layer\");\n\n    if (!layer) {\n      layer = document.createElement(\"div\");\n      layer.className = \"hndrd-cta-focus-layer\";\n      layer.innerHTML =\n        '<span class=\"hndrd-cta-focus-corner hndrd-cta-focus-corner--tl\"></span>' +\n        '<span class=\"hndrd-cta-focus-corner hndrd-cta-focus-corner--tr\"></span>' +\n        '<span class=\"hndrd-cta-focus-corner hndrd-cta-focus-corner--br\"></span>' +\n        '<span class=\"hndrd-cta-focus-corner hndrd-cta-focus-corner--bl\"></span>';\n      document.body.appendChild(layer);\n    }\n\n    var corners = Array.prototype.slice.call(layer.querySelectorAll(\".hndrd-cta-focus-corner\"));\n    var activeTarget = null;\n    var raf = null;\n\n    function isExcluded(el) {\n      return !!(\n        el.closest(\".hndrd-no-focus\") ||\n        el.closest(\"[data-hndrd-no-focus]\") ||\n        el.closest(\".menu-drawer\") ||\n        el.closest(\".header__menu-item\") ||\n        el.closest(\".list-menu__item\") ||\n        el.closest(\".predictive-search\")\n      );\n    }\n\n    function looksLikeCTA(el) {\n      if (!el || isExcluded(el)) return false;\n\n      var tag = el.tagName ? el.tagName.toLowerCase() : \"\";\n      var cls = typeof el.className === \"string\" ? el.className.toLowerCase() : \"\";\n      var txt = (el.textContent || \"\").trim().toLowerCase();\n\n      if (el.matches(\".hndrd-focus-target, .cta, .cta2, .cta3, .btn, .button, .star, .cursor-target, .shopify-payment-button__button\")) return true;\n      if (tag === \"button\") return true;\n      if (el.getAttribute(\"role\") === \"button\") return true;\n      if (tag === \"input\" && [\"button\", \"submit\"].indexOf((el.type || \"\").toLowerCase()) > -1) return true;\n\n      if (tag === \"a\") {\n        if (\n          cls.indexOf(\"cta\") > -1 ||\n          cls.indexOf(\"btn\") > -1 ||\n          cls.indexOf(\"button\") > -1 ||\n          cls.indexOf(\"shop\") > -1 ||\n          cls.indexOf(\"buy\") > -1 ||\n          cls.indexOf(\"view\") > -1\n        ) return true;\n\n        if (\n          txt === \"view\" ||\n          txt === \"shop\" ||\n          txt === \"shop now\" ||\n          txt === \"explore\" ||\n          txt === \"buy now\" ||\n          txt === \"add to cart\" ||\n          txt === \"learn more\" ||\n          txt === \"discover\"\n        ) return true;\n      }\n\n      return false;\n    }\n\n    function getTarget(el) {\n      if (!el) return null;\n\n      var candidate = el.closest(\"a[href], button, [role='button'], input[type='button'], input[type='submit'], .hndrd-focus-target, .cta, .cta2, .cta3, .btn, .button, .star, .cursor-target, .shopify-payment-button__button\");\n\n      if (!candidate) return null;\n      if (!looksLikeCTA(candidate)) return null;\n\n      return candidate;\n    }\n\n    function getColor(el) {\n      if (!el) return \"#ffffff\";\n\n      var s = window.getComputedStyle(el);\n\n      var color =\n        el.style.getPropertyValue(\"--focus\") ||\n        el.style.getPropertyValue(\"--btn\") ||\n        el.style.getPropertyValue(\"--sc\") ||\n        el.style.getPropertyValue(\"--accent\") ||\n        s.getPropertyValue(\"--focus\") ||\n        s.getPropertyValue(\"--btn\") ||\n        s.getPropertyValue(\"--sc\") ||\n        s.getPropertyValue(\"--accent\") ||\n        s.borderTopColor ||\n        s.color ||\n        \"#ffffff\";\n\n      color = (color || \"\").trim();\n\n      if (\n        !color ||\n        color === \"initial\" ||\n        color === \"inherit\" ||\n        color === \"transparent\" ||\n        color === \"rgba(0, 0, 0, 0)\"\n      ) {\n        color = \"#ffffff\";\n      }\n\n      return color;\n    }\n\n    function placeCorners(el) {\n      if (!el || !corners.length) return;\n\n      var rect = el.getBoundingClientRect();\n\n      if (rect.width <= 0 || rect.height <= 0) {\n        layer.classList.remove(\"is-active\");\n        return;\n      }\n\n      var gap = 7;\n      var size = 18;\n\n      var points = [\n        [rect.left - gap, rect.top - gap],\n        [rect.right + gap - size, rect.top - gap],\n        [rect.right + gap - size, rect.bottom + gap - size],\n        [rect.left - gap, rect.bottom + gap - size]\n      ];\n\n      corners.forEach(function (corner, index) {\n        corner.style.left = points[index][0] + \"px\";\n        corner.style.top = points[index][1] + \"px\";\n      });\n\n      document.documentElement.style.setProperty(\"--hndrd-focus-color\", getColor(el));\n      layer.classList.add(\"is-active\");\n    }\n\n    function activate(el) {\n      activeTarget = el;\n\n      if (raf) cancelAnimationFrame(raf);\n\n      raf = requestAnimationFrame(function () {\n        placeCorners(activeTarget);\n      });\n    }\n\n    function deactivate() {\n      activeTarget = null;\n      layer.classList.remove(\"is-active\");\n    }\n\n    document.addEventListener(\"mousemove\", function (event) {\n      var target = getTarget(event.target);\n\n      if (target) activate(target);\n      else deactivate();\n    });\n\n    document.addEventListener(\"mouseover\", function (event) {\n      var target = getTarget(event.target);\n      if (target) activate(target);\n    });\n\n    document.addEventListener(\"mouseout\", function (event) {\n      if (!activeTarget) return;\n\n      var next = event.relatedTarget;\n\n      if (!next || !activeTarget.contains(next)) {\n        deactivate();\n      }\n    });\n\n    document.addEventListener(\"focusin\", function (event) {\n      var target = getTarget(event.target);\n      if (target) activate(target);\n    });\n\n    document.addEventListener(\"focusout\", function () {\n      deactivate();\n    });\n\n    window.addEventListener(\"scroll\", function () {\n      if (activeTarget) placeCorners(activeTarget);\n    }, { passive: true });\n\n    window.addEventListener(\"resize\", function () {\n      if (activeTarget) placeCorners(activeTarget);\n    });\n  });\n})();\n</script>",
