      "settings": {
        "custom_liquid": "<section class=\"bth-teaser\">\n  <style>\n    .bth-teaser {\n      background: #110900;\n      padding: 76px 20px;\n    }\n    .bth-teaser-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n      text-align: center;\n    }\n    .bth-teaser-tag {\n      display: inline-block;\n      font-family: 'Inter', sans-serif;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: #FF5500;\n      border: 1px solid rgba(255,85,0,0.35);\n      border-radius: 100px;\n      padding: 4px 14px;\n      margin-bottom: 18px;\n    }\n    .bth-teaser-heading {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: clamp(30px, 5.5vw, 54px);\n      font-weight: 900;\n      color: #ffffff;\n      text-transform: uppercase;\n      letter-spacing: 0.02em;\n      line-height: 1.05;\n      margin-bottom: 10px;\n    }\n    .bth-teaser-heading span {\n      color: #F5C500;\n    }\n    .bth-teaser-sub {\n      font-family: 'Inter', sans-serif;\n      font-size: 14px;\n      color: rgba(255,255,255,0.4);\n      margin-bottom: 48px;\n    }\n    .bth-teaser-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n    @media (max-width: 768px) {\n      .bth-teaser-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n    }\n    @media (max-width: 420px) {\n      .bth-teaser-grid { grid-template-columns: 1fr; }\n    }\n    .bth-teaser-card {\n      border-radius: 12px;\n      overflow: hidden;\n      position: relative;\n    }\n    .bth-teaser-card img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n      transition: transform 0.4s ease;\n    }\n    .bth-teaser-card:hover img {\n      transform: scale(1.03);\n    }\n    .bth-teaser-overlay {\n      position: absolute;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.45);\n      display: flex;\n      flex-direction: column;\n      align-i