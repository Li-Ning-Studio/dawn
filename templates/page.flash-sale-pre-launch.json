      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<link href=\"https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Barlow+Condensed:wght@400;700;900&family=Barlow:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    min-height: 100vh;\n    background: #0a0a0f;\n    font-family: 'Barlow', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .bg-layer {\n    position: fixed;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(30,120,255,0.18) 0%, transparent 60%),\n      radial-gradient(ellipse 80% 50% at 50% 110%, rgba(255,100,0,0.22) 0%, transparent 60%),\n      #0a0a0f;\n    z-index: 0;\n  }\n\n  .page {\n    position: relative;\n    z-index: 1;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 2rem 1rem;\n    gap: 0;\n  }\n\n  /* Top eyebrow */\n  .eyebrow {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 13px;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.45);\n    margin-bottom: 2rem;\n  }\n\n  .eyebrow span {\n    display: inline-block;\n    border: 1px solid rgba(255,255,255,0.15);\n    border-radius: 100px;\n    padding: 6px 18px;\n  }\n\n  /* Logo container */\n  .logo-wrap {\n    margin-bottom: 1.5rem;\n  }\n\n  .logo-wrap img {\n    max-width: 480px;\n    width: 90vw;\n    filter: drop-shadow(0 0 60px rgba(255,130,0,0.35)) drop-shadow(0 0 30px rgba(30,140,255,0.25));\n  }\n\n  /* Tagline */\n  .tagline {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 400;\n    font-size: 18px;\n    letter-spacing: 0.06em;\n    color: rgba(255,255,255,0.55);\n    text-align: center;\n    margin-bottom: 3rem;\n    text-transform: uppercase;\n  }\n\n  .tagline strong {\n    color: rgba(255,255,255,0.9);\n    font-weight: 700;\n  }\n\n  /* Date badge */\n  .date-badge {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 2.5rem;\n  }\n\n  .date-pill {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 22px;\n    letter-spacing: 0.04em;\n    background: linear-gradient(135deg, #ff9a00, #ff5500);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n\n  .date-divider {\n    width: 1px;\n    height: 20px;\n    background: rgba(255,255,255,0.2);\n  }\n\n  .date-day {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 400;\n    font-size: 14px;\n    letter-spacing: 0.15em;\n    color: rgba(255,255,255,0.4);\n    text-transform: uppercase;\n  }\n\n  /* Countdown */\n  .countdown-label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 11px;\n    letter-spacing: 0.3em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.3);\n    margin-bottom: 1rem;\n    text-align: center;\n  }\n\n  .countdown {\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n    margin-bottom: 3.5rem;\n  }\n\n  .cd-unit {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .cd-box {\n    width: 80px;\n    height: 80px;\n    background: rgba(255,255,255,0.04);\n    border: 1px solid rgba(255,255,255,0.08);\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .cd-box::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, transparent 50%);\n    pointer-events: none;\n  }\n\n  .cd-num {\n    font-family: 'Black Han Sans', sans-serif;\n    font-size: 36px;\n    line-height: 1;\n    background: linear-gradient(180deg, #7dd4fc 0%, #ffffff 50%, #fdba74 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n\n  .cd-lbl {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.3);\n  }\n\n  .cd-sep {\n    font-family: 'Black Han Sans', sans-serif;\n    font-size: 32px;\n    color: rgba(255,255,255,0.15);\n    padding-top: 16px;\n    line-height: 1;\n  }\n\n  /* Divider */\n  .divider {\n    width: 100%;\n    max-width: 400px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);\n    margin-bottom: 2.5rem;\n  }\n\n  /* Notify section */\n  .notify-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n    max-width: 380px;\n    margin-bottom: 3rem;\n  }\n\n  .notify-label {\n    font-family: 'Barlow', sans-serif;\n    font-size: 13px;\n    color: rgba(255,255,255,0.35);\n    letter-spacing: 0.02em;\n  }\n\n  .notify-row {\n    display: flex;\n    width: 100%;\n    gap: 0;\n    border-radius: 8px;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .notify-input {\n    flex: 1;\n    background: rgba(255,255,255,0.04);\n    border: none;\n    outline: none;\n    padding: 12px 16px;\n    font-family: 'Barlow', sans-serif;\n    font-size: 14px;\n    color: rgba(255,255,255,0.8);\n    min-width: 0;\n  }\n\n  .notify-input::placeholder {\n    color: rgba(255,255,255,0.2);\n  }\n\n  .notify-btn {\n    background: linear-gradient(135deg, #ff9a00, #ff5500);\n    border: none;\n    padding: 12px 20px;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 13px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: white;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: opacity 0.2s;\n  }\n\n  .notify-btn:hover { opacity: 0.88; }\n\n  .success-msg {\n    display: none;\n    font-size: 13px;\n    color: #4ade80;\n    letter-spacing: 0.05em;\n  }\n\n  /* Bottom brand */\n  .brand-footer {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .brand-name {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 20px;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.9);\n  }\n\n  .brand-sub {\n    font-family: 'Barlow', sans-serif;\n    font-size: 11px;\n    color: rgba(255,255,255,0.25);\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .brand-link {\n    font-family: 'Barlow', sans-serif;\n    font-size: 11px;\n    color: rgba(255,160,60,0.5);\n    letter-spacing: 0.08em;\n    text-decoration: none;\n    margin-top: 2px;\n  }\n\n  /* Ice accent line */\n  .ice-line {\n    width: 60px;\n    height: 2px;\n    background: linear-gradient(90deg, #7dd4fc, #38bdf8);\n    border-radius: 2px;\n    margin: 0 auto 2rem;\n  }\n\n  /* Snowflake / heat specks */\n  .specks {\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: 0;\n    overflow: hidden;\n  }\n\n  .speck {\n    position: absolute;\n    border-radius: 50%;\n    animation: float linear infinite;\n    opacity: 0;\n  }\n\n  @keyframes float {\n    0%   { transform: translateY(0) rotate(0deg); opacity: 0; }\n    10%  { opacity: 1; }\n    90%  { opacity: 0.5; }\n    100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }\n  }\n</style>\n</head>\n<body>\n<div class=\"bg-layer\"></div>\n\n<div class=\"specks\" id=\"specks\"></div>\n\n<div class=\"page\">\n\n  <div class=\"eyebrow\"><span>Flash Sale — Coming Soon</span></div>\n\n  <div class=\"logo-wrap\">\n    <img src=\"/mnt/user-data/uploads/Artboard_1.png\" alt=\"Beat the Heat Sale\" onerror=\"this.style.display='none'; document.getElementById('logo-fallback').style.display='block'\">\n    <div id=\"logo-fallback\" style=\"display:none; font-family:'Black Han Sans',sans-serif; font-size:52px; text-align:center; line-height:1.1;\">\n      <div style=\"background:linear-gradient(180deg,#93c5fd,#7dd4fc); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\">BEAT THE</div>\n      <div style=\"background:linear-gradient(180deg,#fb923c,#ef4444); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\">HEAT</div>\n    </div>\n  </div>\n\n  <p class=\"tagline\">Hundred India's biggest sale of the season &nbsp;·&nbsp; <strong>This Sunday Only</strong></p>\n\n  <div class=\"date-badge\">\n    <div class=\"date-pill\">Sunday, July 5</div>\n    <div class=\"date-divider\"></div>\n    <div class=\"date-day\">in.hndrd.co</div>\n  </div>\n\n  <div class=\"ice-line\"></div>\n\n  <p class=\"countdown-label\">Sale starts in</p>\n\n  <div class=\"countdown\">\n    <div class=\"cd-unit\">\n      <div class=\"cd-box\"><div class=\"cd-num\" id=\"cd-d\">00</div></div>\n      <div class=\"cd-lbl\">Days</div>\n    </div>\n    <div class=\"cd-sep\">:</div>\n    <div class=\"cd-unit\">\n      <div class=\"cd-box\"><div class=\"cd-num\" id=\"cd-h\">00</div></div>\n      <div class=\"cd-lbl\">Hours</div>\n    </div>\n    <div class=\"cd-sep\">:</div>\n    <div class=\"cd-unit\">\n      <div class=\"cd-box\"><div class=\"cd-num\" id=\"cd-m\">00</div></div>\n      <div class=\"cd-lbl\">Mins</div>\n    </div>\n    <div class=\"cd-sep\">:</div>\n    <div class=\"cd-unit\">\n      <div class=\"cd-box\"><div class=\"cd-num\" id=\"cd-s\">00</div></div>\n      <div class=\"cd-lbl\">Secs</div>\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"notify-block\">\n    <p class=\"notify-label\">Get notified when the sale goes live</p>\n    <div class=\"notify-row\">\n      <input class=\"notify-input\" type=\"email\" placeholder=\"your@email.com\" id=\"email-inp\">\n      <button class=\"notify-btn\" onclick=\"handleNotify()\">Notify Me</button>\n    </div>\n    <p class=\"success-msg\" id=\"success-msg\">🎉 You're in! We'll ping you when it's live.</p>\n  </div>\n\n  <div class=\"brand-footer\">\n    <div class=\"brand-name\">Hundred India</div>\n    <div class=\"brand-sub\">Badminton Gear · Sportswear</div>\n    <a class=\"brand-link\" href=\"https://in.hndrd.co\" target=\"_blank\">in.hndrd.co</a>\n  </div>\n\n</div>\n\n<script>\n  function pad(n) { return String(n).padStart(2,'0'); }\n\n  function tick() {\n    const now = new Date();\n    const target = new Date('2025-07-05T00:00:00+05:30');\n    const now2026 = new Date('2026-07-05T00:00:00+05:30');\n    const saleDate = now2026;\n    const diff = Math.max(0, saleDate - now);\n    const d = Math.floor(diff / 86400000);\n    const h = Math.floor((diff % 86400000) / 3600000);\n    const m = Math.floor((diff % 3600000) / 60000);\n    const s = Math.floor((diff % 60000) / 1000);\n    document.getElementById('cd-d').textContent = pad(d);\n    document.getElementById('cd-h').textContent = pad(h);\n    document.getElementById('cd-m').textContent = pad(m);\n    document.getElementById('cd-s').textContent = pad(s);\n  }\n\n  tick();\n  setInterval(tick, 1000);\n\n  function handleNotify() {\n    const v = document.getElementById('email-inp').value.trim();\n    if (!v || !v.includes('@')) {\n      document.getElementById('email-inp').style.borderBottom = '1px solid #ef4444';\n      return;\n    }\n    document.querySelector('.notify-row').style.display = 'none';\n    document.getElementById('success-msg').style.display = 'block';\n  }\n\n  const specks = document.getElementById('specks');\n  for (let i = 0; i < 28; i++) {\n    const el = document.createElement('div');\n    el.className = 'speck';\n    const isIce = Math.random() > 0.5;\n    const size = Math.random() * 4 + 2;\n    el.style.cssText = `\n      width:${size}px; height:${size}px;\n      left:${Math.random()*100}%;\n      bottom:${Math.random()*20 - 10}%;\n      background:${isIce ? 'rgba(125,212,252,0.6)' : 'rgba(251,146,60,0.5)'};\n      animation-duration:${Math.random()*8+5}s;\n      animation-delay:${Math.random()*8}s;\n    `;\n    specks.appendChild(el);\n  }\n</script>\n</body>\n</html>",
