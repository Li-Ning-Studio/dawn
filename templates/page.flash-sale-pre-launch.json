      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"bth-countdown\">\n  <style>\n    .bth-countdown {\n      background: #0F0A00;\n      padding: 72px 20px 80px;\n      text-align: center;\n      position: relative;\n      overflow: hidden;\n    }\n    .bth-countdown::before {\n      content: '';\n      position: absolute;\n      width: 700px;\n      height: 700px;\n      border-radius: 50%;\n      background: radial-gradient(circle, rgba(255,85,0,0.18) 0%, transparent 70%);\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      pointer-events: none;\n    }\n    .bth-cd-label-top {\n      font-family: 'Inter', sans-serif;\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: #FF5500;\n      margin-bottom: 14px;\n      position: relative;\n    }\n    .bth-cd-heading {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: clamp(38px, 8vw, 76px);\n      font-weight: 900;\n      color: #ffffff;\n      text-transform: uppercase;\n      letter-spacing: 0.01em;\n      line-height: 1;\n      margin-bottom: 6px;\n      position: relative;\n    }\n    .bth-cd-heading em {\n      font-style: normal;\n      color: #F5C500;\n    }\n    .bth-cd-subline {\n      font-family: 'Inter', sans-serif;\n      font-size: 14px;\n      color: rgba(255,255,255,0.45);\n      margin-bottom: 52px;\n      position: relative;\n    }\n    .bth-cd-units {\n      display: flex;\n      align-items: flex-start;\n      justify-content: center;\n      gap: 10px;\n      flex-wrap: wrap;\n      position: relative;\n    }\n    .bth-cd-block {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 10px;\n    }\n    .bth-cd-num {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: clamp(26px, 11vw, 56px);\n      font-weight: 900;\n      color: #F5C500;\n      line-height: 1;\n      background: rgba(255,255,255,0.04);\n      border: 1px solid rgba(255,85,0,0.3);\n      border-radius: 10px;\n      padding: 14px 22px;\n      min-width: 100px;\n      letter-spacing: 0.1em;\n    }\n    .bth-cd-unit-label {\n      font-family: 'Inter', sans-serif;\n      font-size: 10px;\n      font-weight: 600;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: rgba(255,255,255,0.4);\n    }\n    .bth-cd-colon {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 46px;\n      font-weight: 900;\n      color: rgba(255,85,0,0.35);\n      line-height: 1;\n      padding-top: 16px;\n      align-self: flex-start;\n    }\n    .bth-cd-live-cta {\n      display: none;\n      margin-top: 44px;\n      position: relative;\n    }\n    .bth-cd-live-cta a {\n      display: inline-block;\n      background: #FF5500;\n      color: #ffffff;\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 22px;\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      padding: 14px 40px;\n      border-radius: 6px;\n      text-decoration: none;\n      transition: background 0.15s ease, transform 0.15s ease;\n    }\n    .bth-cd-live-cta a:hover {\n      background: #FF7733;\n      transform: translateY(-2px);\n    }\n    @media (max-width: 480px) {\n      .bth-cd-num { min-width: 72px; padding: 12px 16px; }\n      .bth-cd-colon { font-size: 26px; }\n    }\n  </style>\n\n  <p class=\"bth-cd-label-top\">The wait is almost over</p>\n  <h2 class=\"bth-cd-heading\">Sale Starts <em>July 5th</em></h2>\n  <p class=\"bth-cd-subline\">Sunday· 12:00 AM IST · Be Ready</p>\n\n  <div class=\"bth-cd-units\">\n    <div class=\"bth-cd-block\">\n      <div class=\"bth-cd-num\" id=\"bth2-days\">00</div>\n      <div class=\"bth-cd-unit-label\">Days</div>\n    </div>\n    <div class=\"bth-cd-colon\">:</div>\n    <div class=\"bth-cd-block\">\n      <div class=\"bth-cd-num\" id=\"bth2-hours\">00</div>\n      <div class=\"bth-cd-unit-label\">Hours</div>\n    </div>\n    <div class=\"bth-cd-colon\">:</div>\n    <div class=\"bth-cd-block\">\n      <div class=\"bth-cd-num\" id=\"bth2-mins\">00</div>\n      <div class=\"bth-cd-unit-label\">Minutes</div>\n    </div>\n    <div class=\"bth-cd-colon\">:</div>\n    <div class=\"bth-cd-block\">\n      <div class=\"bth-cd-num\" id=\"bth2-secs\">00</div>\n      <div class=\"bth-cd-unit-label\">Seconds</div>\n    </div>\n  </div>\n\n  <div class=\"bth-cd-live-cta\" id=\"bth2-cta\">\n    <a href=\"https://in.hndrd.co/collections/all\">🔥 Shop the Sale Now →</a>\n  </div>\n\n  <script>\n    (function () {\n      var target = new Date('2026-07-04T18:30:00Z');\n      function pad(n) { return n < 10 ? '0' + n : String(n); }\n      function tick() {\n        var now = new Date();\n        var diff = target - now;\n        if (diff <= 0) {\n          ['days','hours','mins','secs'].forEach(function(id) {\n            document.getElementById('bth2-' + id).textContent = '00';\n          });\n          document.getElementById('bth2-cta').style.display = 'block';\n          return;\n        }\n        var d = Math.floor(diff / 86400000);\n        var h = Math.floor((diff % 86400000) / 3600000);\n        var m = Math.floor((diff % 3600000)  / 60000);\n        var s = Math.floor((diff % 60000)    / 1000);\n        document.getElementById('bth2-days').textContent  = pad(d);\n        document.getElementById('bth2-hours').textContent = pad(h);\n        document.getElementById('bth2-mins').textContent  = pad(m);\n        document.getElementById('bth2-secs').textContent  = pad(s);\n        setTimeout(tick, 1000);\n      }\n      tick();\n    })();\n  </script>\n</section>",
