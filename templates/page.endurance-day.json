    "collapsible_content_ywGM93": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_bKfjRY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Your Tour Benefits At a Glance",
            "open_by_default": false,
            "icon": "star",
            "row_content": "<p>🎯 What's in Store for You</p><p>✅ Free Equipment Trials - Experience our latest high-performance rackets at no cost</p><p>🎁 Exclusive Rewards - Unlock special offers and limited-time coupon codes</p><p>🏆 Competitive Fun - Participate in on-court challenges and win exciting prizes</p><p>🤝 Network & Connect - Meet professional players and fellow badminton enthusiasts</p><p>💬 Meet the Team - Connect with Hundred experts and discover what makes our gear elite</p>",
            "page": ""
          }
        },
        "collapsible_row_HhrpyN": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Terms and Conditions",
            "open_by_default": false,
            "icon": "clipboard",
            "row_content": "<p>By attending the Hundred Experience Tour, you agree that:</p><ul><li>Your participation was voluntary and you were responsible for your own safety.</li><li>The brand and organizers are not liable for any injuries, accidents, or health issues that may have occurred.</li><li>The brand and organizers are not liable for any lost, stolen, or damaged personal items.</li><li>You consented to photos and videos being taken and used for marketing, promotional, and branding purposes without further approval or compensation.</li><li>Event details and activities may have been subject to change at the organizers' discretion.</li><li>The organizers had the right to deny entry or remove participants for not following guidelines or for disruptive behavior.</li><li>Non Marking Shoes are not provided by us during the event. Please bring your own.</li></ul>",
            "page": ""
          }
        },
        "collapsible_row_d8Azcr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the Racket Experience Tour?",
            "open_by_default": false,
            "icon": "fire",
            "row_content": "<p>The Racket Experience Tour is a hands-on demo event where players can <strong>try and play with our latest badminton rackets</strong> before deciding which one suits their playing style best.</p>",
            "page": ""
          }
        },
        "collapsible_row_6PJJLm": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Who can participate?",
            "open_by_default": false,
            "icon": "question_mark",
            "row_content": "<p>The event is open to <strong>all badminton players</strong> — beginners, intermediate, advanced players, academy trainees, and recreational players.</p>",
            "page": ""
          }
        },
        "collapsible_row_xU3L8e": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is the event free to attend?",
            "open_by_default": false,
            "icon": "price_tag",
            "row_content": "<p>Yes, the Racket Experience Tour is <strong>completely free</strong> for all participants.</p>",
            "page": ""
          }
        },
        "collapsible_row_BfyDx3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will experts be available to help choose the right racket?",
            "open_by_default": false,
            "icon": "check_mark",
            "row_content": "<p>Yes. Our team will be present to <strong>guide you in selecting the right racket</strong> based on your playing style, level, and preferences.</p>",
            "page": ""
          }
        },
        "collapsible_row_dYfxKE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is this event only for badminton?",
            "open_by_default": false,
            "icon": "eye",
            "row_content": "<p>Yes, this particular tour stop in Rajasthan is <strong>focused on badminton rackets only</strong>.</p>",
            "page": ""
          }
        },
        "collapsible_row_qbkH6m": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I purchase rackets at the venue?",
            "open_by_default": false,
            "icon": "price_tag",
            "row_content": "<p>Selected products may be available for <strong>exclusive event offers</strong>.<br/>Our team will also guide you on <strong>where to purchase online or in-store</strong>.</p>",
            "page": ""
          }
        },
        "collapsible_row_CFeGXg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can academy players and coaches attend together?",
            "open_by_default": false,
            "icon": "lightning_bolt",
            "row_content": "<p>Absolutely. <strong>Players, coaches, and academy groups</strong> are welcome to attend and experience the rackets together.</p>",
            "page": ""
          }
        }
      },
