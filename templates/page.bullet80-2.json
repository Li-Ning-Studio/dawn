        "custom_liquid": "{% comment %}\n==================================================\nNITRIX 80 BULLET\nPREMIUM HERO + ADAPTIVE PRODUCT NAV\n==================================================\n{% endcomment %}\n\n{% assign bullet_video = '' %}\n{% assign bullet_poster = '' %}\n{% assign buy_link = '#' %}\n\n\n<section id=\"b80-hero\" class=\"b80-hero\">\n\n  <!-- ==================================================\n       FLOATING MARK\n  =================================================== -->\n\n  <div class=\"b80-mark\" id=\"b80-mark\">\n    <span>H</span>\n  </div>\n\n\n  <!-- ==================================================\n       PREMIUM NAV\n  =================================================== -->\n\n  <div class=\"b80-nav\" id=\"b80-nav\">\n\n    <!-- refracted glass -->\n    <div class=\"b80-glass-light\"></div>\n\n    <!-- moving highlight -->\n    <div class=\"b80-nav-sheen\"></div>\n\n\n    <!-- ================================================\n         HERO STATE\n    ================================================= -->\n\n    <div class=\"b80-nav-hero\">\n\n      <div class=\"b80-nav-links\">\n\n        <a href=\"#b80-hero\">\n          Overview\n        </a>\n\n        <a href=\"#bullet-next\">\n          Engineering\n        </a>\n\n        <a href=\"#bullet-next\">\n          Technology\n        </a>\n\n        <a href=\"#bullet-next\">\n          Specs\n        </a>\n\n      </div>\n\n\n      <a\n        href=\"#bullet-next\"\n        class=\"b80-explore-button\"\n      >\n\n        <span class=\"b80-explore-text\">\n          Explore\n        </span>\n\n        <span class=\"b80-arrow-orb\">\n\n          <svg\n            viewBox=\"0 0 18 18\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 13L13 5\"\n            ></path>\n\n            <path\n              d=\"M7 5H13V11\"\n            ></path>\n          </svg>\n\n        </span>\n\n      </a>\n\n    </div>\n\n\n    <!-- =========================