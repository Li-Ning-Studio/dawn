      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %} NITRIX 80 BULLET - SECTION 3: BENTO STAT GRID {% endcomment %}\n{% assign card_shaft_img = '' %}\n{% assign card_tfuse_img = '' %}\n{% assign card_foam_img = '' %}\n\n<section id=\"bullet-bento\" class=\"b80b-bento\">\n\n  <div class=\"b80b-bg\">\n    <div class=\"b80b-glow\"></div>\n  </div>\n\n  <div class=\"b80b-head\">\n    <span class=\"b80b-kicker\">ENGINEERED TO ATTACK</span>\n    <h2>The numbers behind<br><em>every smash.</em></h2>\n  </div>\n\n  <div class=\"b80b-grid\">\n\n    <a href=\"#bullet-shaft\" class=\"b80b-card b80b-card-hero\" data-fallback=\"#bullet-next\">\n\n      <div class=\"b80b-card-media\">\n        {% if card_shaft_img != blank %}\n          <img src=\"{{ card_shaft_img | img_url: '1200x' }}\" alt=\"Nitrix 80 Bullet 5.9mm Shaft\" loading=\"lazy\">\n        {% else %}\n          <div class=\"b80b-media-fallback\">\n            <div class=\"b80b-fallback-aura\"></div>\n          </div>\n        {% endif %}\n      </div>\n\n      <div class=\"b80b-card-copy\">\n        <strong>5.9mm VaporShaft</strong>\n        <span>The thinnest shaft HNDRD has ever made</span>\n      </div>\n\n      <div class=\"b80b-card-arrow\">\n        <svg viewBox=\"0 0 18 18\" aria-hidden=\"true\"><path d=\"M4 9H14M10 5L14 9L10 13\"/></svg>\n      </div>\n\n    </a>\n\n    <a href=\"#bullet-frame\" class=\"b80b-card b80b-card-half\" data-fallback=\"#bullet-next\">\n\n      <div class=\"b80b-card-media\">\n        {% if card_tfuse_img != blank %}\n          <img src=\"{{ card_tfuse_img | img_url: '800x' }}\" alt=\"Nitrix 80 Bullet T Fuse\" loading=\"lazy\">\n        {% else %}\n          <div class=\"b80b-media-fallback\">\n            <div class=\"b80b-fallback-aura\"></div>\n          </div>\n        {% endif %}\n      </div>\n\n      <div class=\"b80b-card-copy\">\n        <strong>T Fuse</strong>\n        <span>Resist the twist — torsion control</span>\n      </div>\n\n      <div class=\"b80b-card-arrow\">\n        <svg viewBox=\"0 0 18 18\" aria-hidden=\"true\"><path d=\"M4 9H14M10 5L14 9L10 13\"/></svg>\n      </div>\n\n    </a>\n\n    <a href=\"#bullet-frame\" class=\"b80b-card b80b-card-half\" data-fallback=\"#bullet-next\">\n\n      <div class=\"b80b-card-media\">\n        {% if card_foam_img != blank %}\n          <img src=\"{{ card_foam_img | img_url: '800x' }}\" alt=\"Nitrix 80 Bullet CNTRL Foam\" loading=\"lazy\">\n        {% else %}\n          <div class=\"b80b-media-fallback\">\n            <div class=\"b80b-fallback-aura\"></div>\n          </div>\n        {% endif %}\n      </div>\n\n      <div class=\"b80b-card-copy\">\n        <strong>CNTRL Foam</strong>\n        <span>Shock stops here, before it reaches your hand</span>\n      </div>\n\n      <div class=\"b80b-card-arrow\">\n        <svg viewBox=\"0 0 18 18\" aria-hidden=\"true\"><path d=\"M4 9H14M10 5L14 9L10 13\"/></svg>\n      </div>\n\n    </a>\n\n  </div>\n\n</section>\n\n\n<style>\n\n#bullet-bento,\n#bullet-bento *{\n  box-sizing:border-box;\n}\n\n.b80b-bento{\n  position:relative;\n\n  padding:110px 28px 130px;\n\n  background:#020304;\n\n  color:#fff;\n\n  font-family:Arial,Helvetica,sans-serif;\n\n  overflow:hidden;\n}\n\n\n.b80b-bg{\n  position:absolute;\n\n  inset:0;\n\n  pointer-events:none;\n}\n\n\n.b80b-glow{\n  position:absolute;\n\n  left:50%;\n  top:-120px;\n\n  width:900px;\n  height:520px;\n\n  transform:translateX(-50%);\n\n  border-radius:50%;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(52,163,189,.14),\n      rgba(21,79,95,.05) 42%,\n      transparent 72%\n    );\n\n  filter:blur(60px);\n}\n\n\n.b80b-head{\n  position:relative;\n  z-index:2;\n\n  max-width:1100px;\n\n  margin:0 auto 52px;\n\n  text-align:center;\n}\n\n\n.b80b-kicker{\n  display:inline-block;\n\n  margin-bottom:18px;\n\n  padding:6px 14px;\n\n  border:1px solid rgba(255,255,255,.14);\n\n  border-radius:999px;\n\n  color:rgba(255,255,255,.5);\n\n  font-size:9px;\n\n  font-weight:700;\n\n  letter-spacing:.22em;\n}\n\n\n.b80b-head h2{\n  margin:0;\n\n  font-family:\"Iowan Old Style\",Baskerville,\"Times New Roman\",serif;\n\n  font-size:clamp(34px,4.6vw,58px);\n\n  font-weight:400;\n\n  line-height:1.08;\n\n  letter-spacing:-.03em;\n\n  color:#fff;\n}\n\n\n.b80b-head h2 em{\n  font-style:normal;\n\n  color:rgba(255,255,255,.42);\n}\n\n\n/* GRID */\n\n.b80b-grid{\n  position:relative;\n  z-index:2;\n\n  max-width:1100px;\n\n  margin:0 auto;\n\n  display:grid;\n\n  grid-template-columns:1fr 1fr;\n\n  gap:16px;\n}\n\n\n.b80b-card{\n  position:relative;\n\n  display:flex;\n\n  flex-direction:column;\n\n  justify-content:flex-end;\n\n  overflow:hidden;\n\n  border-radius:20px;\n\n  border:1px solid rgba(255,255,255,.1);\n\n  background:\n    linear-gradient(\n      160deg,\n      rgba(22,26,29,.9),\n      rgba(6,8,9,.95)\n    );\n\n  text-decoration:none;\n\n  color:#fff;\n\n  isolation:isolate;\n\n  transition:\n    border-color .3s,\n    transform .4s cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80b-card:hover{\n  border-color:rgba(255,255,255,.24);\n\n  transform:translateY(-3px);\n}\n\n\n.b80b-card-hero{\n  grid-column:1 / -1;\n\n  min-height:380px;\n\n  flex-direction:row;\n\n  align-items:center;\n\n  justify-content:space-between;\n\n  padding:0 52px;\n}\n\n\n.b80b-card-half{\n  min-height:280px;\n\n  padding:26px;\n}\n\n\n/* MEDIA */\n\n.b80b-card-media{\n  position:absolute;\n\n  inset:0;\n\n  z-index:0;\n\n  pointer-events:none;\n}\n\n\n.b80b-card-hero .b80b-card-media{\n  left:auto;\n\n  right:-6%;\n\n  width:62%;\n\n  -webkit-mask-image:linear-gradient(to left,#000 55%,transparent);\n\n  mask-image:linear-gradient(to left,#000 55%,transparent);\n}\n\n\n.b80b-card-half .b80b-card-media{\n  -webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.15) 78%,transparent);\n\n  mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.15) 78%,transparent);\n}\n\n\n.b80b-card-media img{\n  width:100%;\n  height:100%;\n\n  object-fit:cover;\n\n  opacity:.92;\n\n  filter:contrast(1.06) brightness(.82) saturate(.9);\n}\n\n\n.b80b-media-fallback{\n  position:absolute;\n\n  inset:0;\n}\n\n\n.b80b-fallback-aura{\n  position:absolute;\n\n  right:-10%;\n  top:50%;\n\n  width:420px;\n  height:420px;\n\n  transform:translateY(-50%);\n\n  border-radius:50%;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(79,191,213,.16),\n      transparent 68%\n    );\n\n  filter:blur(30px);\n}\n\n\n/* COPY */\n\n.b80b-card-copy{\n  position:relative;\n  z-index:2;\n\n  display:flex;\n\n  flex-direction:column;\n\n  gap:8px;\n}\n\n\n.b80b-card-hero .b80b-card-copy{\n  max-width:280px;\n}\n\n\n.b80b-card-copy strong{\n  font-family:\"Iowan Old Style\",Baskerville,\"Times New Roman\",serif;\n\n  font-weight:400;\n\n  letter-spacing:-.02em;\n\n  color:#fff;\n}\n\n\n.b80b-card-hero .b80b-card-copy strong{\n  font-size:30px;\n\n  line-height:1.12;\n}\n\n\n.b80b-card-half .b80b-card-copy strong{\n  font-size:19px;\n\n  line-height:1.15;\n}\n\n\n.b80b-card-copy span{\n  color:rgba(255,255,255,.46);\n\n  font-size:12.5px;\n\n  line-height:1.5;\n}\n\n\n.b80b-card-half .b80b-card-copy span{\n  max-width:220px;\n}\n\n\n/* ARROW */\n\n.b80b-card-arrow{\n  position:absolute;\n  z-index:3;\n\n  top:20px;\n  right:20px;\n\n  width:34px;\n  height:34px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border:1px solid rgba(255,255,255,.14);\n\n  border-radius:50%;\n\n  background:rgba(255,255,255,.04);\n\n  color:rgba(255,255,255,.6);\n\n  opacity:0;\n\n  transform:translate(-4px,4px);\n\n  transition:\n    opacity .25s,\n    transform .35s cubic-bezier(.16,1,.3,1),\n    background .25s;\n}\n\n\n.b80b-card-arrow svg{\n  width:13px;\n  height:13px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.4;\n\n  stroke-linecap:round;\n\n  stroke-linejoin:round;\n}\n\n\n.b80b-card:hover .b80b-card-arrow{\n  opacity:1;\n\n  transform:translate(0,0);\n\n  background:rgba(255,255,255,.09);\n}\n\n\n/* MOBILE */\n\n@media(max-width:820px){\n\n  .b80b-bento{\n    padding:80px 18px 90px;\n  }\n\n\n  .b80b-grid{\n    grid-template-columns:1fr;\n  }\n\n\n  .b80b-card-hero{\n    grid-column:auto;\n\n    flex-direction:column;\n\n    align-items:flex-start;\n\n    justify-content:flex-end;\n\n    min-height:340px;\n\n    padding:26px;\n  }\n\n\n  .b80b-card-hero .b80b-card-media{\n    right:-18%;\n\n    width:80%;\n\n    -webkit-mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.15) 78%,transparent);\n\n    mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.15) 78%,transparent);\n  }\n\n\n  .b80b-card-hero .b80b-card-copy{\n    max-width:100%;\n  }\n\n\n  .b80b-card-hero .b80b-card-copy strong{\n    font-size:26px;\n  }\n\n}\n\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80b-card{\n    transition:none;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function(){\n\n  var section = document.getElementById('bullet-bento');\n\n  if(!section){\n    return;\n  }\n\n\n  section\n  .querySelectorAll('a[href^=\"#\"]')\n  .forEach(function(link){\n\n\n    link.addEventListener('click', function(event){\n\n\n      var href = link.getAttribute('href');\n\n      var target = null;\n\n\n      try{\n        target = document.querySelector(href);\n      }\n      catch(error){}\n\n\n      if(!target && link.dataset.fallback){\n\n        try{\n          target = document.querySelector(link.dataset.fallback);\n        }\n        catch(error){}\n\n      }\n\n\n      if(target){\n\n        event.preventDefault();\n\n        target.scrollIntoView({\n          behavior:'smooth',\n          block:'start'\n        });\n\n      }\n\n\n    });\n\n\n  });\n\n\n})();\n\n</script>",
