    "custom_liquid_gbxy7j": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NITRIX 80 BULLET\n  GET THE HIGHLIGHTS\n  PREMIUM SWIPE CAROUSEL\n{% endcomment %}\n\n{% assign hl_frame_img = '' %}\n{% assign hl_shaft_img = '' %}\n{% assign hl_tfuse_img = '' %}\n{% assign hl_foam_img = '' %}\n{% assign hl_athlete_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/08.png?v=1786883528' %}\n{% assign hl_frame_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/c66801aeac4c4d1db7c606334738e499.mp4' %}\n{% assign hl_frame_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/b403c6653ca04ea09884ff1d3f1e7c08.mp4' %}\n{% assign hl_shaft_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/5630f38387364b2f9a62016e558a1906.mp4' %}\n{% assign hl_shaft_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/c1872e9aefc24e55a21bd2e3b40a2c6c.mp4' %}\n{% assign hl_tfuse_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/ea14913004e943afa41f16205a761dac.mp4' %}\n{% assign hl_tfuse_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/270e32d870614aa2aa14a81437dba491.mp4' %}\n{% assign hl_foam_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/29a4fed6315945d8b30f325867fc6341.mp4' %}\n{% assign hl_foam_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/ec73b1af8a104a2e8e7655e64f8016e9.mp4' %}\n\n\n<style>\n\n  /* =========================================================\n     RESET\n  ========================================================= */\n\n  #bullet-highlights,\n  #bullet-highlights * {\n    box-sizing: border-box;\n  }\n\n  #bullet-highlights {\n    position: relative;\n    width: 100%;\n\n    padding:\n      clamp(72px, 7vw, 100px)\n      0\n      clamp(54px, 6vw, 78px);\n\n    background:\n      radial-gradient(\n        ellipse at 50% 18%,\n        rgba(255,255,255,.022),\n        transparent 48%\n      ),\n      #000;\n\n    color: #fff;\n\n    font-family: inherit;\n\n    overflow: hidden;\n\n    isolation: isolate;\n  }\n\n  #bullet-highlights *,\n  #bullet-highlights button {\n    font-family: inherit;\n  }\n\n\n\n  /* =========================================================\n     HEADER\n  ========================================================= */\n\n  .b80h-head {\n    width: 100%;\n    max-width: 1180px;\n\n    margin: 0 auto 42px;\n\n    padding: 0 24px;\n\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  .b80h-head h2 {\n    margin: 0;\n\n    color: #fff;\n\n    font-size: clamp(38px, 4vw, 54px);\n\n    line-height: 1;\n\n    font-weight: 600;\n\n    letter-spacing: -.045em;\n  }\n\n\n\n  /* =========================================================\n     CAROUSEL VIEWPORT\n  ========================================================= */\n\n  .b80h-track-wrap {\n    --b80h-viewport: min(100vw, 1160px);\n    --b80h-card-width: min(82vw, 900px);\n\n    position: relative;\n\n    width: 100%;\n    max-width: 1160px;\n\n    margin: 0 auto;\n    padding: 0;\n\n    overflow-x: auto;\n    overflow-y: hidden;\n\n    scroll-snap-type: x mandatory;\n\n    scroll-behavior: smooth;\n\n    overscroll-behavior-x: contain;\n\n    -webkit-overflow-scrolling: touch;\n\n    touch-action: pan-x pan-y;\n\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n\n    cursor: grab;\n\n    user-select: none;\n    -webkit-user-select: none;\n  }\n\n  .b80h-track-wrap::-webkit-scrollbar {\n    display: none;\n  }\n\n  .b80h-track-wrap:hover {\n    cursor: grab;\n  }\n\n  .b80h-track-wrap.is-dragging {\n    cursor: grabbing;\n\n    scroll-snap-type: none;\n\n    scroll-behavior: auto;\n  }\n\n  .b80h-track-wrap.is-dragging * {\n    pointer-events: none;\n  }\n\n\n\n  /* =========================================================\n     TRACK\n  ========================================================= */\n\n  .b80h-track {\n    display: flex;\n\n    align-items: stretch;\n\n    gap: 16px;\n\n    width: max-content;\n\n    padding-left:\n      max(\n        24px,\n        calc(\n          (\n            var(--b80h-viewport)\n            -\n            var(--b80h-card-width)\n          ) / 2\n        )\n      );\n\n    padding-right:\n      max(\n        24px,\n        calc(\n          (\n            var(--b80h-viewport)\n            -\n            var(--b80h-card-width)\n          ) / 2\n        )\n      );\n\n    user-select: none;\n\n    -webkit-user-select: none;\n  }\n\n\n\n  /* =========================================================\n     SLIDES\n  ========================================================= */\n\n  .b80h-slide {\n    position: relative;\n\n    flex:\n      0 0\n      var(--b80h-card-width);\n\n    width:\n      var(--b80h-card-width);\n\n    scroll-snap-align:\n      center;\n\n    scroll-snap-stop:\n      always;\n\n    opacity:\n      .56;\n\n    transform:\n      scale(.975);\n\n    transition:\n      opacity .55s ease,\n      transform .65s cubic-bezier(.16,1,.3,1);\n  }\n\n  .b80h-slide.is-current {\n    opacity: 1;\n\n    transform:\n      scale(1);\n  }\n\n\n\n  /* =========================================================\n     CARD\n  ========================================================= */\n\n  .b80h-slide-inner {\n    position: relative;\n\n    min-height: 430px;\n\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: center;\n\n    justify-content: center;\n\n    gap: 20px;\n\n    padding:\n      44px\n      34px\n      32px;\n\n    overflow: hidden;\n\n    border:\n      none !important;\n\n    outline:\n      none !important;\n\n    border-radius:\n      28px;\n\n    background:\n      radial-gradient(\n        ellipse at 50% 82%,\n        rgba(255,255,255,.035),\n        transparent 48%\n      ),\n      linear-gradient(\n        145deg,\n        rgba(22,23,24,.98) 0%,\n        rgba(10,11,12,.99) 47%,\n        rgba(3,3,3,1) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.045),\n      inset 0 -70px 110px rgba(0,0,0,.18),\n      0 30px 75px rgba(0,0,0,.34);\n\n    isolation: isolate;\n\n    transition:\n      background .5s ease,\n      box-shadow .5s ease;\n  }\n\n  .b80h-slide.is-current\n  .b80h-slide-inner {\n    background:\n      radial-gradient(\n        ellipse at 50% 80%,\n        rgba(255,255,255,.047),\n        transparent 48%\n      ),\n      linear-gradient(\n        145deg,\n        rgba(25,26,27,.99) 0%,\n        rgba(11,12,13,.99) 48%,\n        rgba(3,3,3,1) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.055),\n      inset 0 -70px 110px rgba(0,0,0,.14),\n      0 32px 78px rgba(0,0,0,.38);\n  }\n\n\n\n  /* =========================================================\n     CARD ATMOSPHERE\n  ========================================================= */\n\n  .b80h-card-glow {\n    position: absolute;\n\n    z-index: 0;\n\n    width: 560px;\n    height: 350px;\n\n    left: 50%;\n    bottom: -245px;\n\n    transform:\n      translateX(-50%);\n\n    border-radius:\n      50%;\n\n    background:\n      rgba(255,255,255,.025);\n\n    filter:\n      blur(90px);\n\n    opacity:\n      .65;\n\n    pointer-events:\n      none;\n  }\n\n\n\n  /* =========================================================\n     NUMBER\n  ========================================================= */\n\n  .b80h-number {\n    position: absolute;\n\n    z-index: 4;\n\n    top: 22px;\n    left: 25px;\n\n    color:\n      rgba(255,255,255,.30);\n\n    font-size:\n      11px;\n\n    line-height:\n      1;\n\n    font-weight:\n      600;\n\n    letter-spacing:\n      .14em;\n  }\n\n\n\n  /* =========================================================\n     CARD COPY\n  ========================================================= */\n\n  .b80h-slide-copy {\n    position: relative;\n\n    z-index: 5;\n\n    width: 100%;\n    max-width: 660px;\n\n    margin: 0;\n\n    text-align:\n      center;\n\n    color:\n      rgba(255,255,255,.95);\n\n    font-size:\n      clamp(\n        18px,\n        2vw,\n        23px\n      );\n\n    line-height:\n      1.3;\n\n    font-weight:\n      550;\n\n    letter-spacing:\n      -.025em;\n  }\n\n\n\n  /* =========================================================\n     MEDIA\n  ========================================================= */\n\n  .b80h-slide-media {\n    position: relative;\n\n    z-index: 2;\n\n    width: 100%;\n    max-width: 780px;\n\n    height: 270px;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n  }\n\n  .b80h-slide-media img {\n    display: block;\n\n    max-width: 100%;\n    max-height: 100%;\n\n    object-fit:\n      contain;\n\n    filter:\n      contrast(1.02)\n      brightness(.98);\n\n    transform:\n      scale(.98);\n\n    pointer-events:\n      none;\n\n    -webkit-user-drag:\n      none;\n\n    transition:\n      transform .7s cubic-bezier(.16,1,.3,1);\n  }\n\n  .b80h-slide.is-current\n  .b80h-slide-media img {\n    transform:\n      scale(1);\n  }\n\n  /* VIDEO CARDS: VIDEO FILLS THE ENTIRE CARD */\n  .b80h-slide.has-video\n  .b80h-slide-media {\n    position: static;\n\n    z-index: auto;\n  }\n\n  .b80h-slide.has-video\n  .b80h-slide-inner::after {\n    content: \"\";\n\n    position: absolute;\n\n    z-index: 1;\n\n    inset: 0;\n\n    pointer-events: none;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0,0,0,.46) 0%,\n        rgba(0,0,0,.16) 30%,\n        rgba(0,0,0,.06) 56%,\n        rgba(0,0,0,.30) 100%\n      );\n  }\n\n  .b80h-slide.has-video\n  .b80h-card-glow {\n    z-index: 2;\n  }\n\n  .b80h-card-video {\n    position: absolute;\n\n    z-index: 0;\n\n    inset: 0;\n\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    max-width: none;\n    max-height: none;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: 0;\n    outline: 0;\n    box-shadow: none;\n\n    background: #000;\n\n    pointer-events: none;\n    user-select: none;\n\n    opacity: .96;\n\n    transform:\n      scale(1.018);\n\n    transition:\n      transform .7s cubic-bezier(.16,1,.3,1),\n      opacity .35s ease;\n  }\n\n  .b80h-slide.is-current\n  .b80h-card-video {\n    opacity: 1;\n\n    transform:\n      scale(1);\n  }\n\n  .b80h-card-video::-webkit-media-controls,\n  .b80h-card-video::-webkit-media-controls-enclosure,\n  .b80h-card-video::-webkit-media-controls-panel,\n  .b80h-card-video::-webkit-media-controls-play-button,\n  .b80h-card-video::-webkit-media-controls-start-playback-button {\n    display: none !important;\n  }\n\n\n\n\n  /* ATHLETE CARD: FULL-CARD CINEMATIC IMAGE */\n  /* Keep the athlete media slot in normal flow so the copy\n     sits at exactly the same height as the other cards. */\n  .b80h-slide.has-athlete\n  .b80h-slide-media {\n    position: static !important;\n    z-index: auto !important;\n    inset: auto !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: visible;\n    pointer-events: none;\n    transform: none !important;\n  }\n\n  .b80h-slide.has-athlete\n  .b80h-slide-inner::after {\n    content: \"\";\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0,0,0,.50) 0%,\n        rgba(0,0,0,.16) 35%,\n        rgba(0,0,0,.08) 58%,\n        rgba(0,0,0,.30) 100%\n      );\n  }\n\n  .b80h-slide.has-athlete\n  .b80h-card-glow {\n    z-index: 2;\n  }\n\n  .b80h-slide.has-athlete\n  .b80h-athlete-image {\n    position: absolute !important;\n    inset: 0 !important;\n    display: block !important;\n    width: 100% !important;\n    height: 100% !important;\n    max-width: none !important;\n    max-height: none !important;\n    margin: 0 !important;\n    object-fit: cover !important;\n    object-position: center center !important;\n    filter: none !important;\n    pointer-events: none;\n    user-select: none;\n    -webkit-user-drag: none;\n    will-change: transform;\n    transform:\n      translate3d(\n        var(--b80h-px,0px),\n        var(--b80h-py,0px),\n        0\n      )\n      scale(1.055)\n      translate3d(-1.2%,.8%,0);\n    animation:\n      b80hAthleteMotion\n      6s\n      ease-in-out\n      infinite\n      alternate;\n    animation-play-state: paused;\n  }\n\n  .b80h-slide.has-athlete.is-current\n  .b80h-athlete-image {\n    animation-play-state: running;\n  }\n\n  @keyframes b80hAthleteMotion {\n    0% {\n      transform:\n        translate3d(\n          var(--b80h-px,0px),\n          var(--b80h-py,0px),\n          0\n        )\n        scale(1.055)\n        translate3d(-1.2%,.8%,0);\n    }\n\n    50% {\n      transform:\n        translate3d(\n          var(--b80h-px,0px),\n          var(--b80h-py,0px),\n          0\n        )\n        scale(1.085)\n        translate3d(.6%,-.7%,0);\n    }\n\n    100% {\n      transform:\n        translate3d(\n          var(--b80h-px,0px),\n          var(--b80h-py,0px),\n          0\n        )\n        scale(1.065)\n        translate3d(1.2%,-1.1%,0);\n    }\n  }\n\n  @media(max-width:750px) {\n    .b80h-slide.has-athlete\n    .b80h-athlete-image {\n      width: 100% !important;\n      height: 100% !important;\n      object-fit: cover !important;\n      object-position: center center !important;\n    }\n  }\n\n  /* =========================================================\n     FALLBACK\n  ========================================================= */\n\n  .b80h-media-fallback {\n    position: relative;\n\n    width: 100%;\n    height: 100%;\n  }\n\n  .b80h-aura {\n    position: absolute;\n\n    left: 50%;\n    top: 50%;\n\n    width: 430px;\n    height: 300px;\n\n    transform:\n      translate(-50%,-50%);\n\n    border-radius:\n      50%;\n\n    background:\n      radial-gradient(\n        circle,\n        rgba(255,255,255,.06),\n        rgba(255,255,255,.015) 40%,\n        transparent 70%\n      );\n\n    filter:\n      blur(28px);\n  }\n\n\n\n  /* =========================================================\n     HARD / MID / SOFT\n  ========================================================= */\n\n  .b80h-chip-row {\n    position: absolute;\n\n    z-index: 6;\n\n    left: 50%;\n    bottom: 10px;\n\n    transform:\n      translateX(-50%);\n\n    display: flex;\n\n    align-items: center;\n\n    gap: 3px;\n\n    padding: 4px;\n\n    border:\n      none !important;\n\n    border-radius:\n      999px;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(38,38,39,.84),\n        rgba(14,14,15,.78)\n      );\n\n    backdrop-filter:\n      blur(20px);\n\n    -webkit-backdrop-filter:\n      blur(20px);\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.065),\n      0 9px 26px rgba(0,0,0,.25);\n  }\n\n  .b80h-chip-row span {\n    min-width:\n      58px;\n\n    padding:\n      8px\n      13px;\n\n    border-radius:\n      999px;\n\n    text-align:\n      center;\n\n    color:\n      rgba(255,255,255,.38);\n\n    font-size:\n      11px;\n\n    line-height:\n      1;\n\n    font-weight:\n      600;\n  }\n\n  .b80h-chip-row\n  span.is-active {\n    color:\n      #fff;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.15),\n        rgba(255,255,255,.06)\n      );\n\n    box-shadow:\n      inset 0 1px 0\n      rgba(255,255,255,.11);\n  }\n\n\n\n  /* =========================================================\n     CONTROLS\n  ========================================================= */\n\n  .b80h-controls {\n    width:\n      max-content;\n\n    min-height:\n      50px;\n\n    margin:\n      26px auto 0;\n\n    padding:\n      6px 7px\n      6px 13px;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content:\n      center;\n\n    gap:\n      11px;\n\n    border:\n      none !important;\n\n    border-radius:\n      999px;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(34,34,35,.88),\n        rgba(13,13,14,.80)\n      );\n\n    backdrop-filter:\n      blur(24px);\n\n    -webkit-backdrop-filter:\n      blur(24px);\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.065),\n      0 11px 34px rgba(0,0,0,.27);\n  }\n\n\n\n  /* =========================================================\n     DOTS\n  ========================================================= */\n\n  .b80h-dots {\n    display:\n      flex;\n\n    align-items:\n      center;\n\n    gap:\n      6px;\n  }\n\n  .b80h-dot {\n    position:\n      relative;\n\n    width:\n      15px;\n\n    height:\n      5px;\n\n    margin:\n      0;\n\n    padding:\n      0;\n\n    border:\n      0;\n\n    border-radius:\n      999px;\n\n    background:\n      rgba(255,255,255,.18);\n\n    overflow:\n      hidden;\n\n    cursor:\n      pointer;\n\n    transition:\n      width .38s cubic-bezier(.16,1,.3,1),\n      background .25s ease;\n  }\n\n  .b80h-dot:hover {\n    background:\n      rgba(255,255,255,.34);\n  }\n\n  .b80h-dot.is-active {\n    width:\n      48px;\n\n    background:\n      rgba(255,255,255,.15);\n  }\n\n  .b80h-dot-fill {\n    position:\n      absolute;\n\n    left:\n      0;\n\n    top:\n      0;\n\n    width:\n      0%;\n\n    height:\n      100%;\n\n    border-radius:\n      inherit;\n\n    background:\n      #fff;\n  }\n\n  .b80h-dot.is-active\n  .b80h-dot-fill {\n    animation:\n      b80hFill\n      linear\n      forwards;\n\n    animation-duration:\n      var(--b80h-duration,6s);\n  }\n\n  @keyframes b80hFill {\n\n    from {\n      width: 0%;\n    }\n\n    to {\n      width: 100%;\n    }\n\n  }\n\n\n\n  /* =========================================================\n     PLAY / PAUSE\n  ========================================================= */\n\n  .b80h-playpause {\n    width:\n      40px;\n\n    height:\n      40px;\n\n    flex:\n      0 0 40px;\n\n    margin:\n      0;\n\n    padding:\n      0;\n\n    display:\n      grid;\n\n    place-items:\n      center;\n\n    border:\n      none !important;\n\n    border-radius:\n      50%;\n\n    background:\n      rgba(255,255,255,.06);\n\n    color:\n      rgba(255,255,255,.88);\n\n    cursor:\n      pointer;\n\n    transition:\n      color .25s ease,\n      background .25s ease,\n      transform .25s ease;\n  }\n\n  .b80h-playpause:hover {\n    color:\n      #fff;\n\n    background:\n      rgba(255,255,255,.12);\n\n    transform:\n      scale(1.04);\n  }\n\n  .b80h-playpause svg {\n    width:\n      17px;\n\n    height:\n      17px;\n\n    display:\n      block;\n\n    fill:\n      currentColor;\n  }\n\n  .b80h-icon-play {\n    display:\n      none !important;\n  }\n\n  .b80h-playpause.is-paused\n  .b80h-icon-play {\n    display:\n      block !important;\n  }\n\n  .b80h-playpause.is-paused\n  .b80h-icon-pause {\n    display:\n      none !important;\n  }\n\n\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n\n  @media(max-width:750px) {\n\n    #bullet-highlights {\n      padding:\n        64px\n        0\n        48px;\n    }\n\n\n    .b80h-head {\n      padding:\n        0 18px;\n\n      margin-bottom:\n        30px;\n    }\n\n\n    .b80h-head h2 {\n      font-size:\n        clamp(\n          32px,\n          9.5vw,\n          43px\n        );\n    }\n\n\n\n    /* TRUE MOBILE SWIPE */\n\n    .b80h-track-wrap {\n      --b80h-viewport:\n        100vw;\n\n      --b80h-card-width:\n        88vw;\n\n      max-width:\n        none;\n\n      margin-top:\n        0;\n\n      overflow-x:\n        auto;\n\n      overflow-y:\n        hidden;\n\n      scroll-snap-type:\n        x mandatory;\n\n      touch-action:\n        pan-x pan-y;\n\n      overscroll-behavior-x:\n        contain;\n\n      -webkit-overflow-scrolling:\n        touch;\n    }\n\n\n    .b80h-track {\n      gap:\n        12px;\n\n      padding-left:\n        6vw;\n\n      padding-right:\n        6vw;\n    }\n\n\n    .b80h-slide {\n      opacity:\n        .56;\n\n      transform:\n        scale(.985);\n    }\n\n\n    .b80h-slide.is-current {\n      opacity:\n        1;\n\n      transform:\n        scale(1);\n    }\n\n\n    .b80h-slide-inner {\n      min-height:\n        390px;\n\n      padding:\n        40px\n        18px\n        27px;\n\n      border-radius:\n        23px;\n    }\n\n\n    .b80h-slide-copy {\n      max-width:\n        340px;\n\n      font-size:\n        17px;\n\n      line-height:\n        1.35;\n    }\n\n\n    .b80h-slide-media {\n      height:\n        225px;\n    }\n\n    .b80h-card-video {\n      object-fit: cover;\n      object-position: center;\n    }\n\n\n    .b80h-number {\n      top:\n        18px;\n\n      left:\n        18px;\n\n      font-size:\n        11px;\n    }\n\n\n    .b80h-controls {\n      min-height:\n        54px;\n\n      margin-top:\n        22px;\n\n      padding:\n        7px 7px\n        7px 13px;\n    }\n\n\n    .b80h-dot {\n      width:\n        16px;\n\n      height:\n        5px;\n    }\n\n\n    .b80h-dot.is-active {\n      width:\n        46px;\n    }\n\n\n    .b80h-playpause {\n      width:\n        42px;\n\n      height:\n        42px;\n\n      flex-basis:\n        42px;\n    }\n\n\n    .b80h-playpause svg {\n      width:\n        18px;\n\n      height:\n        18px;\n    }\n\n  }\n\n\n\n  /* =========================================================\n     REDUCED MOTION\n  ========================================================= */\n\n  @media(prefers-reduced-motion:reduce) {\n\n    .b80h-slide,\n    .b80h-dot,\n    .b80h-dot-fill,\n    .b80h-slide-media img,\n    .b80h-card-video,\n    .b80h-athlete-image {\n      transition:\n        none !important;\n\n      animation:\n        none !important;\n    }\n\n  }\n\n</style>\n\n\n\n<section\n  id=\"bullet-highlights\"\n  class=\"b80h\"\n>\n\n\n  <!-- =====================================================\n       HEADER\n  ====================================================== -->\n\n  <div class=\"b80h-head\">\n\n    <h2>\n      Get the highlights.\n    </h2>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       CAROUSEL\n  ====================================================== -->\n\n  <div\n    class=\"b80h-track-wrap\"\n    id=\"b80h-track-wrap\"\n  >\n\n    <div\n      class=\"b80h-track\"\n      id=\"b80h-track\"\n    >\n\n\n\n      <!-- =================================================\n           01 — FRAME\n      ================================================== -->\n\n      <article\n        class=\"b80h-slide has-video is-current\"\n        data-index=\"0\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n\n          <div class=\"b80h-number\">\n            01\n          </div>\n\n\n          <p class=\"b80h-slide-copy\">\n\n            Aerospace-grade AECG+ carbon frame,<br>\n            built for exceptional pro capability.\n\n          </p>\n\n\n          <div class=\"b80h-slide-media\">\n\n              <video\n                class=\"b80h-card-video\"\n                muted\n                loop\n                playsinline\n                webkit-playsinline\n                preload=\"metadata\"\n                aria-hidden=\"true\"\n              >\n                <source\n                  src=\"{{ hl_frame_video_mobile }}\"\n                  type=\"video/mp4\"\n                  media=\"(max-width: 750px)\"\n                >\n                <source\n                  src=\"{{ hl_frame_video_desktop }}\"\n                  type=\"video/mp4\"\n                >\n              </video>\n\n            </div>\n\n\n        </div>\n\n      </article>\n\n\n\n      <!-- =================================================\n           02 — SHAFT\n      ================================================== -->\n\n      <article\n        class=\"b80h-slide has-video\"\n        data-index=\"1\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n\n          <div class=\"b80h-number\">\n            02\n          </div>\n\n\n          <p class=\"b80h-slide-copy\">\n\n            5.9mm VaporShaft.<br>\n            The thinnest shaft HNDRD has ever made.\n\n          </p>\n\n\n          <div class=\"b80h-slide-media\">\n\n              <video\n                class=\"b80h-card-video\"\n                muted\n                loop\n                playsinline\n                webkit-playsinline\n                preload=\"metadata\"\n                aria-hidden=\"true\"\n              >\n                <source\n                  src=\"{{ hl_shaft_video_mobile }}\"\n                  type=\"video/mp4\"\n                  media=\"(max-width: 750px)\"\n                >\n                <source\n                  src=\"{{ hl_shaft_video_desktop }}\"\n                  type=\"video/mp4\"\n                >\n              </video>\n\n            </div>\n\n\n        </div>\n\n      </article>\n\n\n\n      <!-- =================================================\n           03 — T FUSE\n      ================================================== -->\n\n      <article\n        class=\"b80h-slide has-video\"\n        data-index=\"2\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n\n          <div class=\"b80h-number\">\n            03\n          </div>\n\n\n          <p class=\"b80h-slide-copy\">\n\n            Resist the twist.<br>\n            T Fuse controls torsion right where it counts.\n\n          </p>\n\n\n          <div class=\"b80h-slide-media\">\n\n              <video\n                class=\"b80h-card-video\"\n                muted\n                loop\n                playsinline\n                webkit-playsinline\n                preload=\"metadata\"\n                aria-hidden=\"true\"\n              >\n                <source\n                  src=\"{{ hl_tfuse_video_mobile }}\"\n                  type=\"video/mp4\"\n                  media=\"(max-width: 750px)\"\n                >\n                <source\n                  src=\"{{ hl_tfuse_video_desktop }}\"\n                  type=\"video/mp4\"\n                >\n              </video>\n\n\n            <div class=\"b80h-chip-row\">\n\n              <span>\n                Hard\n              </span>\n\n\n              <span class=\"is-active\">\n                Mid\n              </span>\n\n\n              <span>\n                Soft\n              </span>\n\n            </div>\n\n            </div>\n\n\n        </div>\n\n      </article>\n\n\n\n      <!-- =================================================\n           04 — CNTRL FOAM\n      ================================================== -->\n\n      <article\n        class=\"b80h-slide has-video\"\n        data-index=\"3\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n\n          <div class=\"b80h-number\">\n            04\n          </div>\n\n\n          <p class=\"b80h-slide-copy\">\n\n            Shock stops here,<br>\n            before it ever reaches your hand.\n\n          </p>\n\n\n          <div class=\"b80h-slide-media\">\n\n              <video\n                class=\"b80h-card-video\"\n                muted\n                loop\n                playsinline\n                webkit-playsinline\n                preload=\"metadata\"\n                aria-hidden=\"true\"\n              >\n                <source\n                  src=\"{{ hl_foam_video_mobile }}\"\n                  type=\"video/mp4\"\n                  media=\"(max-width: 750px)\"\n                >\n                <source\n                  src=\"{{ hl_foam_video_desktop }}\"\n                  type=\"video/mp4\"\n                >\n              </video>\n\n            </div>\n\n\n        </div>\n\n      </article>\n\n\n\n      <!-- =================================================\n           05 — ATHLETE\n      ================================================== -->\n\n      <article\n        class=\"b80h-slide has-athlete\"\n        data-index=\"4\"\n        data-duration=\"6000\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n\n          <div class=\"b80h-number\">\n            05\n          </div>\n\n\n          <p class=\"b80h-slide-copy\">\n\n            Built to attack.<br>\n            Trusted by ranked professionals worldwide.\n\n          </p>\n\n\n          <div class=\"b80h-slide-media b80h-athlete-media\">\n\n            <img\n              class=\"b80h-athlete-image\"\n              src=\"{{ hl_athlete_img }}\"\n              alt=\"Nitrix 80 Bullet Athletes\"\n              loading=\"lazy\"\n              decoding=\"async\"\n            >\n\n          </div>\n\n\n        </div>\n\n      </article>\n\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       CONTROLS\n  ====================================================== -->\n\n  <div class=\"b80h-controls\">\n\n\n    <div\n      class=\"b80h-dots\"\n      id=\"b80h-dots\"\n    >\n\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot is-active\"\n        data-i=\"0\"\n        aria-label=\"Slide 1\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"1\"\n        aria-label=\"Slide 2\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"2\"\n        aria-label=\"Slide 3\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"3\"\n        aria-label=\"Slide 4\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"4\"\n        aria-label=\"Slide 5\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n\n    </div>\n\n\n\n    <!-- PLAY / PAUSE -->\n\n    <button\n      type=\"button\"\n      class=\"b80h-playpause\"\n      id=\"b80h-playpause\"\n      aria-label=\"Pause\"\n    >\n\n\n      <!-- PAUSE -->\n\n      <svg\n        class=\"b80h-icon-pause\"\n        viewBox=\"0 0 20 20\"\n        aria-hidden=\"true\"\n      >\n\n        <rect\n          x=\"5\"\n          y=\"4\"\n          width=\"3.4\"\n          height=\"12\"\n          rx=\"1.5\"\n        />\n\n        <rect\n          x=\"11.6\"\n          y=\"4\"\n          width=\"3.4\"\n          height=\"12\"\n          rx=\"1.5\"\n        />\n\n      </svg>\n\n\n\n      <!-- PLAY -->\n\n      <svg\n        class=\"b80h-icon-play\"\n        viewBox=\"0 0 20 20\"\n        aria-hidden=\"true\"\n      >\n\n        <path\n          d=\"M6.5 4.5L15.5 10L6.5 15.5V4.5Z\"\n        />\n\n      </svg>\n\n\n    </button>\n\n\n  </div>\n\n\n</section>\n\n\n\n<script>\n\n(function () {\n\n  var section =\n    document.getElementById(\n      'bullet-highlights'\n    );\n\n\n  if (!section) {\n    return;\n  }\n\n\n  var trackWrap =\n    section.querySelector(\n      '#b80h-track-wrap'\n    );\n\n\n  var track =\n    section.querySelector(\n      '#b80h-track'\n    );\n\n\n  var playPauseBtn =\n    section.querySelector(\n      '#b80h-playpause'\n    );\n\n\n  if (\n    !trackWrap ||\n    !track ||\n    !playPauseBtn\n  ) {\n    return;\n  }\n\n\n  var slides =\n    Array.prototype.slice.call(\n      track.querySelectorAll(\n        '.b80h-slide'\n      )\n    );\n\n\n  var dots =\n    Array.prototype.slice.call(\n      section.querySelectorAll(\n        '#b80h-dots .b80h-dot'\n      )\n    );\n\n\n  var cardVideos =\n    Array.prototype.slice.call(\n      section.querySelectorAll(\n        '.b80h-card-video'\n      )\n    );\n\n\n  var slideCount =\n    slides.length;\n\n\n  if (!slideCount) {\n    return;\n  }\n\n\n  var current = 0;\n\n  var sectionIsVisible = false;\n\n  var isPaused = false;\n\n  var timer = null;\n\n  var FALLBACK_DURATION = 3000;\n\n  var scrollEndTimer = null;\n\n  var programmaticScroll = false;\n\n  var dragging = false;\n\n  var dragStartX = 0;\n\n  var dragStartScroll = 0;\n\n  var dragMoved = false;\n\n\n  section.style.setProperty(\n    '--b80h-duration',\n    FALLBACK_DURATION + 'ms'\n  );\n\n\n\n  /* =====================================================\n     GET CENTER POSITION\n  ====================================================== */\n\n  function getSlideLeft(index) {\n\n    var slide =\n      slides[index];\n\n\n    if (!slide) {\n      return 0;\n    }\n\n\n    var slideCenter =\n      slide.offsetLeft +\n      slide.offsetWidth / 2;\n\n\n    var viewportCenter =\n      trackWrap.clientWidth / 2;\n\n\n    return (\n      slideCenter -\n      viewportCenter\n    );\n\n  }\n\n\n\n  /* =====================================================\n     CARD VIDEOS\n     Only the current card plays.\n  ====================================================== */\n\n  function syncCardVideos() {\n\n    slides.forEach(\n      function (\n        slide,\n        index\n      ) {\n\n        var video =\n          slide.querySelector(\n            '.b80h-card-video'\n          );\n\n\n        if (!video) {\n          return;\n        }\n\n\n        video.muted = true;\n        video.loop = true;\n\n        video.setAttribute(\n          'muted',\n          ''\n        );\n\n        video.setAttribute(\n          'playsinline',\n          ''\n        );\n\n        video.setAttribute(\n          'webkit-playsinline',\n          ''\n        );\n\n\n        if (\n          index === current &&\n          sectionIsVisible &&\n          document.visibilityState !== 'hidden'\n        ) {\n\n          var playPromise =\n            video.play();\n\n\n          if (\n            playPromise &&\n            typeof playPromise.catch === 'function'\n          ) {\n\n            playPromise.catch(\n              function () {}\n            );\n\n          }\n\n        }\n\n        else {\n\n          video.pause();\n\n        }\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     UPDATE SLIDES\n  ====================================================== */\n\n  function updateSlides() {\n\n    slides.forEach(\n      function (\n        slide,\n        index\n      ) {\n\n        var wasCurrent =\n          slide.classList.contains(\n            'is-current'\n          );\n\n\n        var isCurrent =\n          index === current;\n\n\n        slide.classList.toggle(\n          'is-current',\n          isCurrent\n        );\n\n\n        if (\n          isCurrent &&\n          !wasCurrent\n        ) {\n\n          var video =\n            slide.querySelector(\n              '.b80h-card-video'\n            );\n\n\n          if (video) {\n\n            try {\n\n              video.currentTime = 0;\n\n            }\n\n            catch (error) {}\n\n          }\n\n        }\n\n      }\n    );\n\n\n    syncCardVideos();\n\n  }\n\n\n\n  /* =====================================================\n     UPDATE DOTS\n  ====================================================== */\n\n  function updateDots(\n    restartAnimation\n  ) {\n\n    dots.forEach(\n      function (\n        dot,\n        index\n      ) {\n\n        dot.classList.toggle(\n          'is-active',\n          index === current\n        );\n\n\n        var fill =\n          dot.querySelector(\n            '.b80h-dot-fill'\n          );\n\n\n        if (!fill) {\n          return;\n        }\n\n\n        if (\n          index === current\n        ) {\n\n          if (\n            restartAnimation\n          ) {\n\n            fill.style.animation =\n              'none';\n\n\n            void fill.offsetWidth;\n\n\n            fill.style.animation =\n              '';\n\n\n            fill.style.width =\n              '';\n\n\n            fill.style.animationPlayState =\n              isPaused\n                ? 'paused'\n                : 'running';\n\n          }\n\n        }\n\n        else {\n\n          fill.style.animation =\n            'none';\n\n\n          fill.style.width =\n            index < current\n              ? '100%'\n              : '0%';\n\n        }\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     TIMER\n  ====================================================== */\n\n  function restartTimer(\n    restartProgress\n  ) {\n\n    if (timer) {\n\n      clearTimeout(\n        timer\n      );\n\n      timer = null;\n\n    }\n\n\n    var slide =\n      slides[current];\n\n\n    var video =\n      slide\n        ? slide.querySelector(\n            '.b80h-card-video'\n          )\n        : null;\n\n\n    var durationMs =\n      slide &&\n      slide.dataset.duration\n        ? parseInt(\n            slide.dataset.duration,\n            10\n          )\n        : FALLBACK_DURATION;\n\n\n    if (\n      !Number.isFinite(durationMs) ||\n      durationMs <= 0\n    ) {\n      durationMs =\n        FALLBACK_DURATION;\n    }\n\n\n    if (video) {\n\n      if (\n        !Number.isFinite(\n          video.duration\n        ) ||\n        video.duration <= 0\n      ) {\n\n        section.style.setProperty(\n          '--b80h-duration',\n          FALLBACK_DURATION + 'ms'\n        );\n\n\n        if (restartProgress) {\n\n          updateDots(\n            true\n          );\n\n        }\n\n\n        var waitingIndex =\n          current;\n\n\n        video.addEventListener(\n          'loadedmetadata',\n          function () {\n\n            if (\n              current === waitingIndex\n            ) {\n\n              restartTimer(\n                true\n              );\n\n            }\n\n          },\n          {\n            once: true\n          }\n        );\n\n\n        return;\n\n      }\n\n\n      durationMs =\n        video.duration * 1000;\n\n    }\n\n\n    section.style.setProperty(\n      '--b80h-duration',\n      durationMs + 'ms'\n    );\n\n\n    if (restartProgress) {\n\n      updateDots(\n        true\n      );\n\n    }\n\n\n    if (\n      isPaused ||\n      !sectionIsVisible\n    ) {\n      return;\n    }\n\n\n    var delay =\n      durationMs;\n\n\n    if (video) {\n\n      var remaining =\n        (\n          video.duration -\n          video.currentTime\n        ) * 1000;\n\n\n      delay =\n        Math.max(\n          120,\n          remaining\n        );\n\n    }\n\n\n    timer =\n      setTimeout(\n        next,\n        delay\n      );\n\n  }\n\n\n\n  /* =====================================================\n     GO TO SLIDE\n  ====================================================== */\n\n  function goTo(\n    index,\n    instant\n  ) {\n\n    current =\n      (\n        (\n          index %\n          slideCount\n        )\n        +\n        slideCount\n      )\n      %\n      slideCount;\n\n\n    programmaticScroll =\n      true;\n\n\n    updateSlides();\n\n\n    restartTimer(\n      true\n    );\n\n\n    trackWrap.scrollTo({\n\n      left:\n        getSlideLeft(\n          current\n        ),\n\n      behavior:\n        instant\n          ? 'auto'\n          : 'smooth'\n\n    });\n\n\n    setTimeout(\n      function () {\n\n        programmaticScroll =\n          false;\n\n      },\n\n      instant\n        ? 50\n        : 650\n    );\n\n  }\n\n\n\n  /* =====================================================\n     NEXT\n  ====================================================== */\n\n  function next() {\n\n    if (\n      current >=\n      slideCount - 1\n    ) {\n\n      goTo(0);\n\n    }\n\n    else {\n\n      goTo(\n        current + 1\n      );\n\n    }\n\n  }\n\n\n\n  /* =====================================================\n     PLAY / PAUSE\n  ====================================================== */\n\n  function setPaused(\n    paused\n  ) {\n\n    isPaused =\n      paused;\n\n\n    playPauseBtn\n      .classList\n      .toggle(\n        'is-paused',\n        paused\n      );\n\n\n    playPauseBtn\n      .setAttribute(\n        'aria-label',\n        paused\n          ? 'Play'\n          : 'Pause'\n      );\n\n\n    var activeFill =\n      section.querySelector(\n        '.b80h-dot.is-active .b80h-dot-fill'\n      );\n\n\n    if (\n      activeFill\n    ) {\n\n      activeFill\n        .style\n        .animationPlayState =\n          paused\n            ? 'paused'\n            : 'running';\n\n    }\n\n\n    if (\n      paused\n    ) {\n\n      if (\n        timer\n      ) {\n\n        clearTimeout(\n          timer\n        );\n\n        timer = null;\n\n      }\n\n\n      var activeVideo =\n        slides[current]\n          ? slides[current].querySelector(\n              '.b80h-card-video'\n            )\n          : null;\n\n\n      if (activeVideo) {\n\n        activeVideo.pause();\n\n      }\n\n    }\n\n    else {\n\n      syncCardVideos();\n\n      restartTimer(\n        false\n      );\n\n    }\n\n  }\n\n\n\n  /* =====================================================\n     DOT CLICKS\n  ====================================================== */\n\n  dots.forEach(\n    function (dot) {\n\n      dot.addEventListener(\n        'click',\n        function () {\n\n          var index =\n            parseInt(\n              dot.dataset.i,\n              10\n            );\n\n\n          goTo(\n            index\n          );\n\n        }\n      );\n\n    }\n  );\n\n\n\n  /* =====================================================\n     PLAY CLICK\n  ====================================================== */\n\n  playPauseBtn\n    .addEventListener(\n      'click',\n      function () {\n\n        setPaused(\n          !isPaused\n        );\n\n      }\n    );\n\n\n\n  /* =====================================================\n     CLOSEST SLIDE\n  ====================================================== */\n\n  function findClosestSlide() {\n\n    var viewportCenter =\n      trackWrap.scrollLeft +\n      trackWrap.clientWidth / 2;\n\n\n    var closestIndex =\n      0;\n\n\n    var closestDistance =\n      Infinity;\n\n\n    slides.forEach(\n      function (\n        slide,\n        index\n      ) {\n\n        var slideCenter =\n          slide.offsetLeft +\n          slide.offsetWidth / 2;\n\n\n        var distance =\n          Math.abs(\n            viewportCenter -\n            slideCenter\n          );\n\n\n        if (\n          distance <\n          closestDistance\n        ) {\n\n          closestDistance =\n            distance;\n\n\n          closestIndex =\n            index;\n\n        }\n\n      }\n    );\n\n\n    return closestIndex;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE TOUCH\n  ====================================================== */\n\n  trackWrap.addEventListener(\n    'touchstart',\n    function () {\n\n      if (\n        timer\n      ) {\n\n        clearTimeout(\n          timer\n        );\n\n      }\n\n    },\n\n    {\n      passive: true\n    }\n  );\n\n\n\n  /* =====================================================\n     SCROLL / SWIPE DETECTION\n  ====================================================== */\n\n  trackWrap.addEventListener(\n    'scroll',\n    function () {\n\n      if (\n        programmaticScroll ||\n        dragging\n      ) {\n        return;\n      }\n\n\n      clearTimeout(\n        scrollEndTimer\n      );\n\n\n      scrollEndTimer =\n        setTimeout(\n          function () {\n\n            var newIndex =\n              findClosestSlide();\n\n\n            if (\n              newIndex !==\n              current\n            ) {\n\n              current =\n                newIndex;\n\n\n              updateSlides();\n\n\n              restartTimer(\n                true\n              );\n\n            }\n\n            else {\n\n              restartTimer(\n                false\n              );\n\n            }\n\n          },\n\n          110\n        );\n\n    },\n\n    {\n      passive: true\n    }\n  );\n\n\n\n  /* =====================================================\n     DESKTOP CLICK + DRAG\n  ====================================================== */\n\n  trackWrap.addEventListener(\n    'pointerdown',\n    function (event) {\n\n      /*\n        Mobile / tablets use native\n        touch scrolling.\n      */\n\n      if (\n        event.pointerType ===\n        'touch'\n      ) {\n        return;\n      }\n\n\n      dragging =\n        true;\n\n\n      dragMoved =\n        false;\n\n\n      dragStartX =\n        event.clientX;\n\n\n      dragStartScroll =\n        trackWrap.scrollLeft;\n\n\n      trackWrap.classList.add(\n        'is-dragging'\n      );\n\n\n      if (\n        timer\n      ) {\n\n        clearTimeout(\n          timer\n        );\n\n      }\n\n\n      try {\n\n        trackWrap\n          .setPointerCapture(\n            event.pointerId\n          );\n\n      }\n\n      catch (error) {}\n\n    }\n  );\n\n\n  trackWrap.addEventListener(\n    'pointermove',\n    function (event) {\n\n      if (\n        !dragging\n      ) {\n        return;\n      }\n\n\n      var delta =\n        event.clientX -\n        dragStartX;\n\n\n      if (\n        Math.abs(delta) >\n        3\n      ) {\n\n        dragMoved =\n          true;\n\n      }\n\n\n      trackWrap.scrollLeft =\n        dragStartScroll -\n        delta;\n\n    }\n  );\n\n\n  function finishDrag(event) {\n\n    if (\n      !dragging\n    ) {\n      return;\n    }\n\n\n    dragging =\n      false;\n\n\n    trackWrap.classList.remove(\n      'is-dragging'\n    );\n\n\n    try {\n\n      if (\n        event &&\n        trackWrap.hasPointerCapture(\n          event.pointerId\n        )\n      ) {\n\n        trackWrap.releasePointerCapture(\n          event.pointerId\n        );\n\n      }\n\n    }\n\n    catch (error) {}\n\n\n    var index =\n      findClosestSlide();\n\n\n    goTo(\n      index\n    );\n\n  }\n\n\n  trackWrap.addEventListener(\n    'pointerup',\n    finishDrag\n  );\n\n\n  trackWrap.addEventListener(\n    'pointercancel',\n    finishDrag\n  );\n\n\n  trackWrap.addEventListener(\n    'pointerleave',\n    function (event) {\n\n      if (\n        dragging &&\n        event.buttons === 0\n      ) {\n\n        finishDrag(\n          event\n        );\n\n      }\n\n    }\n  );\n\n\n\n  /* =====================================================\n     DESKTOP TRACKPAD / SHIFT + WHEEL\n  ====================================================== */\n\n  trackWrap.addEventListener(\n    'wheel',\n    function (event) {\n\n      var horizontal =\n        event.deltaX;\n\n\n      /*\n        Shift + normal mouse wheel\n        also works horizontally.\n      */\n\n      if (\n        event.shiftKey &&\n        Math.abs(horizontal) <\n        Math.abs(event.deltaY)\n      ) {\n\n        horizontal =\n          event.deltaY;\n\n      }\n\n\n      /*\n        Only hijack the wheel if it\n        is clearly a horizontal gesture.\n        Normal vertical page scrolling\n        stays untouched.\n      */\n\n      if (\n        Math.abs(horizontal) <\n        2\n      ) {\n        return;\n      }\n\n\n      if (\n        !event.shiftKey &&\n        Math.abs(event.deltaX) <\n        Math.abs(event.deltaY) * .65\n      ) {\n        return;\n      }\n\n\n      event.preventDefault();\n\n\n      if (\n        timer\n      ) {\n\n        clearTimeout(\n          timer\n        );\n\n      }\n\n\n      trackWrap.scrollLeft +=\n        horizontal;\n\n\n      clearTimeout(\n        scrollEndTimer\n      );\n\n\n      scrollEndTimer =\n        setTimeout(\n          function () {\n\n            var index =\n              findClosestSlide();\n\n\n            goTo(\n              index\n            );\n\n          },\n\n          150\n        );\n\n    },\n\n    {\n      passive: false\n    }\n  );\n\n\n\n  /* =====================================================\n     PREVENT CLICK AFTER DRAG\n  ====================================================== */\n\n  trackWrap.addEventListener(\n    'click',\n    function (event) {\n\n      if (\n        dragMoved\n      ) {\n\n        event.preventDefault();\n\n        event.stopPropagation();\n\n        dragMoved =\n          false;\n\n      }\n\n    },\n\n    true\n  );\n\n\n\n\n  var athleteSlide =\n    section.querySelector(\n      '.b80h-slide.has-athlete'\n    );\n\n\n  if (\n    athleteSlide &&\n    window.matchMedia(\n      '(min-width:751px)'\n    ).matches\n  ) {\n\n    athleteSlide.addEventListener(\n      'pointermove',\n      function (event) {\n\n        if (\n          !athleteSlide.classList.contains(\n            'is-current'\n          )\n        ) {\n          return;\n        }\n\n        var rect =\n          athleteSlide.getBoundingClientRect();\n\n        var x =\n          (\n            event.clientX -\n            rect.left\n          ) /\n          rect.width -\n          .5;\n\n        var y =\n          (\n            event.clientY -\n            rect.top\n          ) /\n          rect.height -\n          .5;\n\n        athleteSlide.style.setProperty(\n          '--b80h-px',\n          x * 8 + 'px'\n        );\n\n        athleteSlide.style.setProperty(\n          '--b80h-py',\n          y * 6 + 'px'\n        );\n\n      }\n    );\n\n\n    athleteSlide.addEventListener(\n      'pointerleave',\n      function () {\n\n        athleteSlide.style.setProperty(\n          '--b80h-px',\n          '0px'\n        );\n\n        athleteSlide.style.setProperty(\n          '--b80h-py',\n          '0px'\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     SECTION VISIBILITY\n  ====================================================== */\n\n  if (\n    'IntersectionObserver'\n    in window\n  ) {\n\n    var observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (\n                entry.isIntersecting\n              ) {\n\n                sectionIsVisible =\n                  true;\n\n\n                var activeFill =\n                  section.querySelector(\n                    '.b80h-dot.is-active .b80h-dot-fill'\n                  );\n\n\n                if (\n                  activeFill &&\n                  !isPaused\n                ) {\n\n                  activeFill.style.animationPlayState =\n                    'running';\n\n                }\n\n\n                syncCardVideos();\n\n                if (\n                  !isPaused\n                ) {\n\n                  restartTimer(\n                    false\n                  );\n\n                }\n\n              }\n\n              else {\n\n                sectionIsVisible =\n                  false;\n\n\n                var activeFill =\n                  section.querySelector(\n                    '.b80h-dot.is-active .b80h-dot-fill'\n                  );\n\n\n                if (activeFill) {\n\n                  activeFill.style.animationPlayState =\n                    'paused';\n\n                }\n\n\n                cardVideos.forEach(\n                  function (video) {\n\n                    video.pause();\n\n                  }\n                );\n\n                if (\n                  timer\n                ) {\n\n                  clearTimeout(\n                    timer\n                  );\n\n                  timer = null;\n\n                }\n\n              }\n\n            }\n          );\n\n        },\n\n        {\n          threshold: .3\n        }\n\n      );\n\n\n    observer.observe(\n      section\n    );\n\n  }\n\n\n\n  document.addEventListener(\n    'visibilitychange',\n    function () {\n\n      if (\n        document.visibilityState === 'hidden'\n      ) {\n\n        cardVideos.forEach(\n          function (video) {\n\n            video.pause();\n\n          }\n        );\n\n      }\n\n      else {\n\n        syncCardVideos();\n\n      }\n\n    }\n  );\n\n\n\n  /* =====================================================\n     RESIZE\n  ====================================================== */\n\n  var resizeTimer =\n    null;\n\n\n  window.addEventListener(\n    'resize',\n    function () {\n\n      clearTimeout(\n        resizeTimer\n      );\n\n\n      resizeTimer =\n        setTimeout(\n          function () {\n\n            goTo(\n              current,\n              true\n            );\n\n          },\n\n          120\n        );\n\n    }\n  );\n\n\n\n  /* =====================================================\n     INIT\n  ====================================================== */\n\n  requestAnimationFrame(\n    function () {\n\n      goTo(\n        0,\n        true\n      );\n\n    }\n  );\n\n\n})();\n\n</script>",
