;\n}\n}\n);\nfunction update(){\npositionNav();\nupdateState();\nif(menuOpen){\npositionMenu();\n}\nrafBusy = false;\n}\nfunction requestUpdate(){\nif(rafBusy){\nreturn;\n}\nrafBusy = true;\nrequestAnimationFrame(\nupdate\n);\n}\nfunction track(\nmilliseconds\n){\ntrackingUntil =\nMath.max(\ntrackingUntil,\nperformance.now() +\nmilliseconds\n);\nrequestAnimationFrame(\nfollow\n);\n}\nfunction follow(){\npositionNav();\nupdateState();\nif(menuOpen){\npositionMenu();\n}\nif(\nperformance.now() <\ntrackingUntil\n){\nrequestAnimationFrame(\nfollow\n);\n}\n}\nwindow\n.addEventListener(\n'scroll',\nfunction(){\nrequestUpdate();\ntrack(\n700\n);\n},\n{\npassive:true\n}\n);\nwindow\n.addEventListener(\n'resize',\nfunction(){\nrequestUpdate();\ntrack(\n500\n);\n}\n);\nif(\n'ResizeObserver'\nin window\n){\nconst observer =\nnew ResizeObserver(\nfunction(){\ntrack(\n500\n);\n}\n);\nheaderSelectors\n.forEach(\nfunction(selector){\ndocument\n.querySelectorAll(\nselector\n)\n.forEach(\nfunction(element){\nif(\nelement !== nav &&\n!element.contains(nav)\n){\nobserver.observe(\nelement\n);\n}\n}\n);\n}\n);\n}\npositionNav();\nupdateState();\n\nif(backgroundVideo){\nbackgroundVideo.muted = true;\nbackgroundVideo.defaultMuted = true;\nbackgroundVideo.loop = true;\n\nplayBackgroundVideo();\n\nif('IntersectionObserver' in window){\nconst heroVideoObserver = new IntersectionObserver(\nfunction(entries){\nentries.forEach(function(entry){\nheroVideoVisible = entry.isIntersecting;\nif(entry.isIntersecting){\nplayBackgroundVideo();\n}else{\npauseBackgroundVideo();\n}\n});\n},\n{\nthreshold:.08\n}\n);\nheroVideoObserver.observe(hero);\n}\n\ndocument.addEventListener(\n'visibilitychange',\nfunction(){\nif(document.visibilityState === 'visible' && heroVideoVisible){\nplayBackgroundVideo();\n}else{\npauseBackgroundVideo();\n}\n}\n);\n\nwindow.addEventListener(\n'pageshow',\nfunction(){\nif(heroVideoVisible){\nrequestAnimationFrame(playBackgroundVideo);\n}\n},\n{\nonce:true\n}\n);\n}\n\ntrack(\n