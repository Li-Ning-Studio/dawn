    "custom_liquid_kjREq7": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET\nPREMIUM ENGINEERING GRID\n{% endcomment %}\n\n{% assign b80_shaft_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Screenshot_2026-08-14_at_6.06.56_PM.png?v=1786711037' %}\n{% assign b80_curve_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Sweet_Spot.png?v=1786709949' %}\n{% assign b80_foam_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Cntrl_Foam.png?v=1786709950' %}\n{% assign b80_tfuse_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/T_Fuse_without_String.png?v=1786709947' %}\n{% assign b80_hyper_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Woven_to_Whip.png?v=1786709948' %}\n{% assign b80_carbon_img = '' %}\n\n<section class=\"b80-upgrade\">\n\n  <div class=\"b80-upgrade__shell\">\n\n    <div class=\"b80-upgrade__head\">\n\n      <div class=\"b80-upgrade__headline\">\n        <h2>\n         Everything your racket should do.\n        </h2>\n      </div>\n\n      <div class=\"b80-upgrade__intro\">\n        <span>NITRIX 80 BULLET</span>\n\n        <p>\n          Six engineering decisions working together\n          to make every swing faster, cleaner and harder to contain.\n        </p>\n      </div>\n\n    </div>\n\n\n    <div class=\"b80-upgrade__grid\">\n\n\n      <!-- 01 / 5.9MM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--shaft\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            VAPORSHAFT\n          </span>\n\n          <h3>\n            Just\n            <strong>5.9mm.</strong>\n          </h3>\n\n          <p>\n            The thinnest shaft HNDRD has ever made.\n            Built to whip through the swing and stay stable at contact.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_shaft_img != blank %}\n\n            <img\n              src=\"{{ b80_shaft_img }}\"\n              alt=\"Nitrix 80 Bullet 5.9mm VaporShaft\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"high\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__shaft-demo\">\n\n              <div class=\"b80-upgrade__shaft-line\"></div>\n\n              <div class=\"b80-upgrade__measure\">\n                <span></span>\n\n                <div>\n                  <strong>5.9</strong>\n                  <small>MM</small>\n                </div>\n\n                <span></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 02 / CURVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--curve\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CURVE²\n          </span>\n\n          <h3>\n            Sweet spot.<br>\n            Expanded.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_curve_img != blank %}\n\n            <img\n              src=\"{{ b80_curve_img }}\"\n              alt=\"Nitrix 80 Bullet Curve² Frame\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"low\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__curve-demo\">\n\n              <span class=\"b80-upgrade__ring ring-a\"></span>\n              <span class=\"b80-upgrade__ring ring-b\"></span>\n              <span class=\"b80-upgrade__ring ring-c\"></span>\n\n              <div class=\"b80-upgrade__sweet\">\n                <small>EXPANDED</small>\n                <strong>SWEET SPOT</strong>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Refined frame geometry widens the effective sweet spot\n          without slowing the frame down.\n        </p>\n\n      </article>\n\n\n      <!-- 03 / FOAM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--foam\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CNTRL FOAM\n          </span>\n\n          <h3>\n            Shock<br>\n            stops here.\n          </h3>\n\n          <p>\n            Foam engineered inside the frame absorbs shock\n            before it reaches your hand.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_foam_img != blank %}\n\n            <img\n              src=\"{{ b80_foam_img }}\"\n              alt=\"Nitrix 80 Bullet CNTRL Foam\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"low\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__foam-demo\">\n\n              <span class=\"b80-upgrade__wave wave-a\"></span>\n              <span class=\"b80-upgrade__wave wave-b\"></span>\n              <span class=\"b80-upgrade__wave wave-c\"></span>\n\n              <div class=\"b80-upgrade__foam-piece\">\n                <span>CNTRL</span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 04 / T FUSE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--tfuse\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            T FUSE\n          </span>\n\n          <h3>\n            Resist<br>\n            the twist.\n          </h3>\n\n          <p>\n            Reinforcement at the frame and shaft junction\n            controls torsion through full-power swings.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_tfuse_img != blank %}\n\n            <img\n              src=\"{{ b80_tfuse_img }}\"\n              alt=\"Nitrix 80 Bullet T Fuse\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"low\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__tfuse-demo\">\n\n              <span class=\"b80-upgrade__orbit orbit-a\"></span>\n              <span class=\"b80-upgrade__orbit orbit-b\"></span>\n\n              <div class=\"b80-upgrade__t\">\n                <span class=\"b80-upgrade__t-top\"></span>\n                <span class=\"b80-upgrade__t-stem\"></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 05 / HYPERWEAVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--weave\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            HYPERWEAVE\n          </span>\n\n          <h3>\n            Woven<br>\n            to whip.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_hyper_img != blank %}\n\n            <img\n              src=\"{{ b80_hyper_img }}\"\n              alt=\"Nitrix 80 Bullet Hyperweave\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"low\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__weave-demo\">\n\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Woven carbon construction gives the shaft flex\n          without giving away strength.\n        </p>\n\n      </article>\n\n\n      <!-- 06 / CARBON -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--carbon\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            M46X + AECG+\n          </span>\n\n          <h3>\n            Carbon without<br>\n            compromise.\n          </h3>\n\n          <p>\n            Refined carbon systems balance low weight,\n            responsiveness and durability for aggressive play.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_carbon_img != blank %}\n\n            <img\n              src=\"{{ b80_carbon_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet Carbon Construction\"\n              loading=\"eager\"\n              decoding=\"async\"\n              fetchpriority=\"low\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__carbon-demo\">\n\n              <div class=\"b80-upgrade__carbon-sheet\"></div>\n\n              <strong>M46X</strong>\n\n              <span>\n                AEROSPACE-GRADE<br>\n                CARBON SYSTEM\n              </span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n.b80-upgrade,\n.b80-upgrade *{\n  box-sizing:border-box;\n}\n\n\n/* SECTION */\n\n.b80-upgrade{\n  width:100%;\n  padding:120px 24px;\n  background:#000;\n  color:#fff;\n  font-family:Arial,Helvetica,sans-serif;\n}\n\n\n/* OUTER PANEL */\n\n.b80-upgrade__shell{\n  width:100%;\n  max-width:1240px;\n  margin:0 auto;\n\n  padding:\n    clamp(52px,6vw,78px);\n\n  border-radius:42px;\n\n  background:#121214;\n}\n\n\n/* HEADER */\n\n.b80-upgrade__head{\n  display:grid;\n\n  grid-template-columns:\n    minmax(0,1fr)\n    minmax(280px,.55fr);\n\n  gap:80px;\n\n  align-items:start;\n\n  margin-bottom:60px;\n}\n\n\n.b80-upgrade__headline h2{\n  margin:0;\n\n  max-width:650px;\n\n  color:#f5f5f7;\n\n  font-size:\n    clamp(46px,5.5vw,76px);\n\n  line-height:.97;\n\n  font-weight:700;\n\n  letter-spacing:-.055em;\n}\n\n\n.b80-upgrade__intro{\n  padding-top:9px;\n}\n\n\n.b80-upgrade__intro span{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.38);\n\n  font-size:10px;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__intro p{\n  max-width:370px;\n\n  margin:0;\n\n  color:rgba(255,255,255,.72);\n\n  font-size:16px;\n\n  line-height:1.5;\n\n  font-weight:500;\n}\n\n\n/* GRID */\n\n.b80-upgrade__grid{\n  display:grid;\n\n  grid-template-columns:\n    repeat(3,minmax(0,1fr));\n\n  gap:16px;\n}\n\n\n/* CARD */\n\n.b80-upgrade__card{\n  position:relative;\n\n  min-height:440px;\n\n  overflow:hidden;\n\n  border-radius:26px;\n\n  background:#000;\n\n  isolation:isolate;\n\n  transform:translateZ(0);\n\n  transition:\n    transform .55s cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-upgrade__card:hover{\n  transform:translateY(-5px);\n}\n\n\n.b80-upgrade__card::after{\n  content:\"\";\n\n  position:absolute;\n\n  top:0;\n  left:14%;\n  right:14%;\n\n  height:1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.10),\n      transparent\n    );\n\n  pointer-events:none;\n}\n\n\n/* COPY */\n\n.b80-upgrade__copy{\n  position:relative;\n\n  z-index:10;\n\n  padding:\n    34px 32px 0;\n}\n\n\n.b80-upgrade__copy--center{\n  text-align:center;\n}\n\n\n.b80-upgrade__eyebrow{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.34);\n\n  font-size:9px;\n\n  line-height:1;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__copy h3{\n  margin:0;\n\n  color:rgba(255,255,255,.94);\n\n  font-size:\n    clamp(28px,2.5vw,39px);\n\n  line-height:1.03;\n\n  font-weight:650;\n\n  letter-spacing:-.045em;\n}\n\n\n.b80-upgrade__copy h3 strong{\n  display:block;\n\n  margin-top:5px;\n\n  color:#fff;\n\n  font-size:\n    clamp(52px,4.3vw,72px);\n\n  line-height:.9;\n\n  letter-spacing:-.07em;\n}\n\n\n.b80-upgrade__copy p{\n  max-width:300px;\n\n  margin:17px 0 0;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:13px;\n\n  line-height:1.5;\n}\n\n\n.b80-upgrade__bottom{\n  position:absolute;\n\n  z-index:10;\n\n  left:30px;\n  right:30px;\n  bottom:26px;\n\n  margin:0;\n\n  text-align:center;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:12.5px;\n\n  line-height:1.45;\n}\n\n\n/* MEDIA */\n\n.b80-upgrade__media{\n  position:absolute;\n  z-index:2;\n\n  inset:170px 0 0;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  overflow:hidden;\n  pointer-events:none;\n}\n\n\n/* Keeps real product artwork INSIDE the visual pocket of each card.\n   The fade makes black/transparent PNG edges disappear naturally into the card. */\n.b80-upgrade__media img{\n  display:block !important;\n  visibility:visible !important;\n  content-visibility:visible;\n  backface-visibility:hidden;\n  -webkit-backface-visibility:hidden;\n\n  width:auto;\n  height:auto;\n\n  max-width:92%;\n  max-height:92%;\n\n  object-fit:contain;\n  object-position:center;\n\n  opacity:.98;\n  transform:translateZ(0);\n\n  -webkit-mask-image:linear-gradient(\n    to bottom,\n    transparent 0%,\n    #000 10%,\n    #000 84%,\n    transparent 100%\n  );\n  mask-image:linear-gradient(\n    to bottom,\n    transparent 0%,\n    #000 10%,\n    #000 84%,\n    transparent 100%\n  );\n}\n\n\n/* Extra black feathering over the artwork so it feels built into the card. */\n.b80-upgrade__card--curve .b80-upgrade__media::after,\n.b80-upgrade__card--foam .b80-upgrade__media::after,\n.b80-upgrade__card--tfuse .b80-upgrade__media::after,\n.b80-upgrade__card--weave .b80-upgrade__media::after{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  z-index:3;\n  pointer-events:none;\n\n  background:\n    linear-gradient(180deg,\n      #000 0%,\n      rgba(0,0,0,.76) 4%,\n      rgba(0,0,0,0) 22%,\n      rgba(0,0,0,0) 72%,\n      rgba(0,0,0,.34) 90%,\n      #000 100%\n    ),\n    linear-gradient(90deg,\n      #000 0%,\n      rgba(0,0,0,0) 14%,\n      rgba(0,0,0,0) 86%,\n      #000 100%\n    );\n}\n\n\n/* SWEET SPOT / CURVE² */\n.b80-upgrade__card--curve .b80-upgrade__media{\n  inset:158px 10px 68px;\n}\n\n.b80-upgrade__card--curve .b80-upgrade__media img{\n  max-width:94%;\n  max-height:100%;\n  transform:scale(1.02);\n}\n\n\n/* CNTRL FOAM */\n.b80-upgrade__card--foam .b80-upgrade__media{\n  inset:176px 10px 8px;\n}\n\n.b80-upgrade__card--foam .b80-upgrade__media img{\n  max-width:90%;\n  max-height:96%;\n  transform:translateY(5px) scale(.98);\n}\n\n\n/* T FUSE */\n.b80-upgrade__card--tfuse .b80-upgrade__media{\n  inset:174px 8px 6px;\n}\n\n.b80-upgrade__card--tfuse .b80-upgrade__media img{\n  max-width:94%;\n  max-height:96%;\n  transform:translateY(4px) scale(1.01);\n}\n\n\n/* HYPERWEAVE */\n.b80-upgrade__card--weave .b80-upgrade__media{\n  inset:156px 8px 70px;\n}\n\n.b80-upgrade__card--weave .b80-upgrade__media img{\n  max-width:96%;\n  max-height:100%;\n  transform:scale(1.03);\n}\n\n\n/* ========================\n   SHAFT\n======================== */\n\n.b80-upgrade__card--shaft{\n  \n}\n\n\n.b80-upgrade__shaft-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__shaft-line{\n  width:8px;\n  height:78%;\n\n  border-radius:999px;\n\n  transform:rotate(12deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      #121416,\n      #bccbd3 28%,\n      #f7fdff 48%,\n      #56636a 70%,\n      #111315\n    );\n\n  box-shadow:\n    0 0 30px rgba(255,255,255,.05);\n}\n\n\n.b80-upgrade__measure{\n  position:absolute;\n\n  left:13%;\n  right:13%;\n  top:47%;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:12px;\n}\n\n\n.b80-upgrade__measure > span{\n  flex:1;\n\n  height:1px;\n\n  background:\n    rgba(255,255,255,.16);\n}\n\n\n.b80-upgrade__measure div{\n  display:flex;\n\n  align-items:baseline;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__measure strong{\n  font-size:38px;\n\n  line-height:1;\n\n  letter-spacing:-.06em;\n}\n\n\n.b80-upgrade__measure small{\n  color:rgba(255,255,255,.35);\n\n  font-size:9px;\n\n  font-weight:700;\n}\n\n\n/* ========================\n   CURVE²\n======================== */\n\n.b80-upgrade__curve-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__ring{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.15);\n\n  border-radius:50%;\n\n  transform:\n    perspective(500px)\n    rotateX(62deg);\n}\n\n\n.ring-a{\n  width:240px;\n  height:155px;\n}\n\n\n.ring-b{\n  width:195px;\n  height:125px;\n\n  opacity:.65;\n}\n\n\n.ring-c{\n  width:150px;\n  height:95px;\n\n  opacity:.35;\n}\n\n\n.b80-upgrade__sweet{\n  position:relative;\n\n  z-index:3;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__sweet small{\n  color:rgba(255,255,255,.30);\n\n  font-size:8px;\n\n  letter-spacing:.14em;\n}\n\n\n.b80-upgrade__sweet strong{\n  color:rgba(255,255,255,.88);\n\n  font-size:13px;\n}\n\n\n/* ========================\n   FOAM\n======================== */\n\n.b80-upgrade__foam-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__foam-piece{\n  position:absolute;\n\n  bottom:-40px;\n\n  width:145px;\n  height:230px;\n\n  border-radius:\n    62px 62px\n    24px 24px;\n\n  transform:rotate(17deg);\n\n  background:\n    linear-gradient(\n      145deg,\n      #202428,\n      #090a0b\n    );\n\n  box-shadow:\n    inset 15px 0 25px\n    rgba(255,255,255,.025);\n}\n\n\n.b80-upgrade__foam-piece span{\n  position:absolute;\n\n  left:50%;\n  top:50%;\n\n  transform:\n    translate(-50%,-50%)\n    rotate(-90deg);\n\n  color:rgba(255,255,255,.16);\n\n  font-size:18px;\n\n  font-weight:700;\n\n  letter-spacing:.10em;\n}\n\n\n.b80-upgrade__wave{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.07);\n\n  border-radius:50%;\n}\n\n\n.wave-a{\n  width:120px;\n  height:120px;\n}\n\n\n.wave-b{\n  width:190px;\n  height:190px;\n}\n\n\n.wave-c{\n  width:265px;\n  height:265px;\n\n  opacity:.45;\n}\n\n\n/* ========================\n   T FUSE\n======================== */\n\n.b80-upgrade__tfuse-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__t{\n  position:relative;\n\n  width:220px;\n  height:190px;\n}\n\n\n.b80-upgrade__t-top{\n  position:absolute;\n\n  left:0;\n  right:0;\n  top:18px;\n\n  height:30px;\n\n  border-radius:\n    50% 50%\n    12px 12px;\n\n  background:\n    linear-gradient(\n      180deg,\n      #373c40,\n      #101214\n    );\n}\n\n\n.b80-upgrade__t-stem{\n  position:absolute;\n\n  left:50%;\n  top:34px;\n\n  width:25px;\n  height:160px;\n\n  transform:translateX(-50%);\n\n  border-radius:10px;\n\n  background:\n    linear-gradient(\n      90deg,\n      #0c0d0e,\n      #4e575c,\n      #0d0f10\n    );\n}\n\n\n.b80-upgrade__orbit{\n  position:absolute;\n\n  width:235px;\n  height:90px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  border-radius:50%;\n}\n\n\n.orbit-a{\n  transform:rotate(18deg);\n}\n\n\n.orbit-b{\n  transform:rotate(-18deg);\n}\n\n\n/* ========================\n   WEAVE\n======================== */\n\n.b80-upgrade__weave-demo{\n  position:relative;\n\n  width:86%;\n  height:180px;\n}\n\n\n.b80-upgrade__weave-demo span{\n  position:absolute;\n\n  left:0;\n  right:0;\n\n  height:7px;\n\n  border-radius:999px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      #272b2d 8%,\n      #dce8ed 32%,\n      #222629 70%,\n      transparent\n    );\n}\n\n\n.b80-upgrade__weave-demo span:nth-child(1){\n  top:18px;\n  transform:rotate(-8deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(2){\n  top:40px;\n  transform:rotate(-5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(3){\n  top:62px;\n  transform:rotate(-2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(4){\n  top:84px;\n}\n\n.b80-upgrade__weave-demo span:nth-child(5){\n  top:106px;\n  transform:rotate(2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(6){\n  top:128px;\n  transform:rotate(5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(7){\n  top:150px;\n  transform:rotate(8deg);\n}\n\n\n/* ========================\n   CARBON\n======================== */\n\n.b80-upgrade__carbon-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__carbon-sheet{\n  position:absolute;\n\n  width:90%;\n  height:110px;\n\n  background:\n    repeating-linear-gradient(\n      45deg,\n      #080808 0,\n      #080808 4px,\n      #171717 4px,\n      #171717 6px\n    );\n\n  transform:rotate(-8deg);\n\n  opacity:.75;\n}\n\n\n.b80-upgrade__carbon-demo strong{\n  position:relative;\n\n  z-index:2;\n\n  font-size:\n    clamp(56px,5vw,82px);\n\n  line-height:.9;\n\n  letter-spacing:-.075em;\n}\n\n\n.b80-upgrade__carbon-demo > span{\n  position:relative;\n\n  z-index:2;\n\n  margin-top:15px;\n\n  color:rgba(255,255,255,.28);\n\n  font-size:8px;\n\n  line-height:1.45;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n\n  text-align:center;\n}\n\n\n/* TABLET */\n\n@media(max-width:1000px){\n\n  .b80-upgrade__head{\n    grid-template-columns:1fr;\n\n    gap:28px;\n  }\n\n\n  .b80-upgrade__grid{\n    grid-template-columns:\n      repeat(2,minmax(0,1fr));\n  }\n\n}\n\n\n/* MOBILE */\n\n@media(max-width:700px){\n\n  .b80-upgrade{\n    padding:\n      74px 14px;\n  }\n\n\n  .b80-upgrade__shell{\n    padding:\n      42px 14px\n      16px;\n\n    border-radius:28px;\n  }\n\n\n  .b80-upgrade__head{\n    padding:\n      0 12px;\n\n    margin-bottom:40px;\n  }\n\n\n  .b80-upgrade__headline h2{\n    font-size:\n      clamp(\n        40px,\n        12vw,\n        56px\n      );\n  }\n\n\n  .b80-upgrade__intro{\n    padding:0;\n  }\n\n\n  /* MOBILE = SWIPEABLE CARDS */\n\n  .b80-upgrade__grid{\n    display:flex;\n\n    gap:13px;\n\n    overflow-x:auto;\n\n    overflow-y:hidden;\n\n    scroll-snap-type:\n      x mandatory;\n\n    scroll-behavior:smooth;\n\n    overscroll-behavior-x:\n      contain;\n\n    -webkit-overflow-scrolling:\n      touch;\n\n    scrollbar-width:none;\n\n    padding:\n      0 0 2px;\n  }\n\n\n  .b80-upgrade__grid::-webkit-scrollbar{\n    display:none;\n  }\n\n\n  .b80-upgrade__card{\n    flex:\n      0 0\n      87%;\n\n    width:87%;\n\n    min-height:485px;\n\n    border-radius:25px;\n\n    scroll-snap-align:center;\n\n    scroll-snap-stop:always;\n  }\n\n\n  .b80-upgrade__copy{\n    padding:\n      31px 26px 0;\n  }\n\n\n  .b80-upgrade__copy h3{\n    font-size:\n      clamp(\n        30px,\n        9vw,\n        40px\n      );\n  }\n\n\n  .b80-upgrade__copy h3 strong{\n    font-size:\n      clamp(\n        52px,\n        16vw,\n        70px\n      );\n  }\n\n\n  /* Keep the four supplied PNGs balanced inside taller mobile cards. */\n  .b80-upgrade__card--curve .b80-upgrade__media{\n    inset:166px 8px 70px;\n  }\n\n  .b80-upgrade__card--foam .b80-upgrade__media,\n  .b80-upgrade__card--tfuse .b80-upgrade__media{\n    inset:184px 8px 8px;\n  }\n\n  .b80-upgrade__card--weave .b80-upgrade__media{\n    inset:164px 8px 72px;\n  }\n\n  .b80-upgrade__card--curve .b80-upgrade__media img,\n  .b80-upgrade__card--foam .b80-upgrade__media img,\n  .b80-upgrade__card--tfuse .b80-upgrade__media img,\n  .b80-upgrade__card--weave .b80-upgrade__media img{\n    max-width:94%;\n  }\n\n\n  .b80-upgrade__bottom{\n    left:25px;\n    right:25px;\n    bottom:25px;\n  }\n\n}\n\n</style>\n\n<script>\n(function () {\n  var sections =\n    document.querySelectorAll(\n      '.b80-upgrade'\n    );\n\n  sections.forEach(function (section) {\n    var images =\n      section.querySelectorAll(\n        '.b80-upgrade__media img'\n      );\n\n    images.forEach(function (img) {\n      img.loading = 'eager';\n      img.decoding = 'async';\n\n      var originalSrc =\n        img.getAttribute('src');\n\n      if (!originalSrc) {\n        return;\n      }\n\n      function revealImage() {\n        img.classList.add(\n          'b80-img-ready'\n        );\n      }\n\n      if (\n        img.complete &&\n        img.naturalWidth > 0\n      ) {\n        revealImage();\n\n        if (\n          typeof img.decode ===\n          'function'\n        ) {\n          img.decode().catch(\n            function () {}\n          );\n        }\n\n        return;\n      }\n\n      img.addEventListener(\n        'load',\n        function () {\n          revealImage();\n\n          if (\n            typeof img.decode ===\n            'function'\n          ) {\n            img.decode().catch(\n              function () {}\n            );\n          }\n        },\n        {\n          once: true\n        }\n      );\n\n      img.addEventListener(\n        'error',\n        function () {\n          if (\n            img.dataset.b80Retried ===\n            '1'\n          ) {\n            return;\n          }\n\n          img.dataset.b80Retried =\n            '1';\n\n          var retrySrc =\n            originalSrc +\n            (\n              originalSrc.indexOf('?') > -1\n                ? '&'\n                : '?'\n            ) +\n            'b80retry=' +\n            Date.now();\n\n          img.src =\n            retrySrc;\n        },\n        {\n          once: true\n        }\n      );\n    });\n  });\n})();\n</script>",
