hopify.com/s/files/1/0933/9378/1029/files/bullet_web_carbon_fibre_66b5dbda-2f3d-43a6-96b6-df10cb7d78d3.jpg?v=1786704667\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          M46X Carbon Fibre\n        </h3>\n\n        <p>\n          Engineered for attacking response.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 5\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-5\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/attack_ready_R.jpg?v=1786710287\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/attack_ready.jpg?v=1786704666\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Attack Ready\n        </h3>\n\n        <p>\n          Power on a hair trigger.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 6\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-6\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/built_faster.jpg?v=1786710287\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Built Faster\n        </h3>\n\n        <p>\n          Ready for the next shot.\n        