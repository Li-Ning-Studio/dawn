sform .4s ease;\n}\n\n\n.b80-nav-links{\n  display:flex;\n\n  align-items:center;\n\n  gap:24px;\n}\n\n\n.b80-nav-links a{\n  position:relative;\n\n  color:\n    rgba(255,255,255,.68);\n\n  text-decoration:none;\n\n  font-size:10px;\n\n  transition:\n    color .25s ease;\n}\n\n\n.b80-nav-links a:after{\n  content:\"\";\n\n  position:absolute;\n\n  left:0;\n  right:0;\n  bottom:-6px;\n\n  height:1px;\n\n  transform:\n    scaleX(0);\n\n  transform-origin:left;\n\n  background:#fff;\n\n  transition:\n    transform .25s ease;\n}\n\n\n.b80-nav-links a:hover{\n  color:#fff;\n}\n\n\n.b80-nav-links a:hover:after{\n  transform:\n    scaleX(1);\n}\n\n\n/* =====================================================\n   NEW EXPLORE CONTROL\n===================================================== */\n\n.b80-explore-button{\n  height:38px;\n\n  padding:\n    0 5px 0 16px;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:12px;\n\n  border-radius:999px;\n\n  background:\n    rgba(255,255,255,.94);\n\n  text-decoration:none;\n\n  color:#090a0b;\n\n  box-shadow:\n    0 5px 18px\n    rgba(0,0,0,.18);\n\n  transition:\n    transform .3s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-explore-text{\n  font-size:10px;\n\n  font-weight:600;\n}\n\n\n.b80-arrow-orb{\n  width:29px;\n  height:29px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  background:#0c0d0e;\n\n  color:#fff;\n\n  overflow:hidden;\n}\n\n\n.b80-arrow-orb svg,\n.b80-small-arrow svg,\n.b80-hero-arrow svg{\n  width:14px;\n  height:14px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.35;\n\n  stroke-linecap:round;\n\n  stroke-linejoin:round;\n\n  transition:\n    transform .35s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-explore-button:hover{\n  transform:\n    scale(1.025);\n}\n\n\n.b80-explore-button:hover\n.b80-arrow-orb svg{\n  transform:\n    translate(2px,-2px);\n}\n\n\n/* =====================================================\n   PRODUCT NAV\n==================