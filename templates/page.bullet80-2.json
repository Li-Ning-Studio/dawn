    "custom_liquid_gbxy7j": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign hl_frame_img = '' %}\n{% assign hl_shaft_img = '' %}\n{% assign hl_tfuse_img = '' %}\n{% assign hl_foam_img = '' %}\n{% assign hl_athlete_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/08.png?v=1786883528' %}\n{% assign hl_frame_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/c66801aeac4c4d1db7c606334738e499.mp4' %}\n{% assign hl_frame_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/b403c6653ca04ea09884ff1d3f1e7c08.mp4' %}\n{% assign hl_shaft_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/5630f38387364b2f9a62016e558a1906.mp4' %}\n{% assign hl_shaft_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/c1872e9aefc24e55a21bd2e3b40a2c6c.mp4' %}\n{% assign hl_tfuse_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/ea14913004e943afa41f16205a761dac.mp4' %}\n{% assign hl_tfuse_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/270e32d870614aa2aa14a81437dba491.mp4' %}\n{% assign hl_foam_video_desktop = 'https://cdn.shopify.com/videos/c/o/v/29a4fed6315945d8b30f325867fc6341.mp4' %}\n{% assign hl_foam_video_mobile = 'https://cdn.shopify.com/videos/c/o/v/ec73b1af8a104a2e8e7655e64f8016e9.mp4' %}\n<style>\n#bullet-highlights,\n#bullet-highlights * {\nbox-sizing: border-box;\n}\n#bullet-highlights {\nposition: relative;\nwidth: 100%;\npadding:\nclamp(72px, 7vw, 100px)\n0\nclamp(54px, 6vw, 78px);\nbackground:\nradial-gradient(\nellipse at 50% 18%,\nrgba(255,255,255,.022),\ntransparent 48%\n),\n#000;\ncolor: #fff;\nfont-family: inherit;\noverflow: hidden;\nisolation: isolate;\n}\n#bullet-highlights *,\n#bullet-highlights button {\nfont-family: inherit;\n}\n.b80h-head {\nwidth: 100%;\nmax-width: 1180px;\nmargin: 0 auto 42px;\npadding: 0 24px;\ndisplay: flex;\nalign-items: center;\njustify-content: flex-start;\n}\n.b80h-head h2 {\nmargin: 0;\ncolor: #fff;\nfont-size: clamp(38px, 4vw, 54px);\nline-height: 1;\nfont-weight: 600;\nletter-spacing: -.045em;\n}\n.b80h-track-wrap {\n--b80h-viewport: min(100vw, 1160px);\n--b80h-card-width: min(82vw, 900px);\nposition: relative;\nwidth: 100%;\nmax-width: 1160px;\nmargin: 0 auto;\npadding: 0;\noverflow-x: auto;\noverflow-y: hidden;\nscroll-snap-type: x mandatory;\nscroll-behavior: auto;\noverscroll-behavior-x: contain;\n-webkit-overflow-scrolling: touch;\ntouch-action: pan-x pan-y;\nscrollbar-width: none;\n-ms-overflow-style: none;\ncursor: grab;\nuser-select: none;\n-webkit-user-select: none;\n}\n.b80h-track-wrap::-webkit-scrollbar {\ndisplay: none;\n}\n.b80h-track-wrap:hover {\ncursor: grab;\n}\n.b80h-track-wrap.is-dragging {\ncursor: grabbing;\nscroll-snap-type: none;\nscroll-behavior: auto;\n}\n.b80h-track-wrap.is-dragging * {\npointer-events: none;\n}\n.b80h-track {\ndisplay: flex;\nalign-items: stretch;\ngap: 16px;\nwidth: max-content;\npadding-left:\nmax(\n24px,\ncalc(\n(\nvar(--b80h-viewport)\n-\nvar(--b80h-card-width)\n) / 2\n)\n);\npadding-right:\nmax(\n24px,\ncalc(\n(\nvar(--b80h-viewport)\n-\nvar(--b80h-card-width)\n) / 2\n)\n);\nuser-select: none;\n-webkit-user-select: none;\n}\n.b80h-slide {\nposition: relative;\nflex:\n0 0\nvar(--b80h-card-width);\nwidth:\nvar(--b80h-card-width);\nscroll-snap-align:\ncenter;\nscroll-snap-stop:\nalways;\nopacity:\n.56;\ntransform:\nscale(.975);\ntransition:\nopacity .55s ease,\ntransform .65s cubic-bezier(.16,1,.3,1);\n}\n.b80h-slide.is-current {\nopacity: 1;\ntransform:\nscale(1);\n}\n.b80h-slide-inner {\nposition: relative;\nmin-height: 430px;\ndisplay: flex;\nflex-direction: column;\nalign-items: center;\njustify-content: center;\ngap: 20px;\npadding:\n44px\n34px\n32px;\noverflow: hidden;\nborder:\nnone !important;\noutline:\nnone !important;\nborder-radius:\n28px;\nbackground:\nradial-gradient(\nellipse at 50% 82%,\nrgba(255,255,255,.035),\ntransparent 48%\n),\nlinear-gradient(\n145deg,\nrgba(22,23,24,.98) 0%,\nrgba(10,11,12,.99) 47%,\nrgba(3,3,3,1) 100%\n);\nbox-shadow:\ninset 0 1px 0 rgba(255,255,255,.045),\ninset 0 -70px 110px rgba(0,0,0,.18),\n0 30px 75px rgba(0,0,0,.34);\nisolation: isolate;\ncontain:\nlayout\npaint\nstyle;\ntransition:\nbackground .5s ease,\nbox-shadow .5s ease;\n}\n.b80h-slide.is-current\n.b80h-slide-inner {\nbackground:\nradial-gradient(\nellipse at 50% 80%,\nrgba(255,255,255,.047),\ntransparent 48%\n),\nlinear-gradient(\n145deg,\nrgba(25,26,27,.99) 0%,\nrgba(11,12,13,.99) 48%,\nrgba(3,3,3,1) 100%\n);\nbox-shadow:\ninset 0 1px 0 rgba(255,255,255,.055),\ninset 0 -70px 110px rgba(0,0,0,.14),\n0 32px 78px rgba(0,0,0,.38);\n}\n.b80h-card-glow {\nposition: absolute;\nz-index: 0;\nwidth: 560px;\nheight: 350px;\nleft: 50%;\nbottom: -245px;\ntransform:\ntranslateX(-50%);\nborder-radius:\n50%;\nbackground:\nrgba(255,255,255,.025);\nfilter:\nblur(90px);\nopacity:\n.65;\npointer-events:\nnone;\n}\n.b80h-number {\nposition: absolute;\nz-index: 4;\ntop: 22px;\nleft: 25px;\ncolor:\nrgba(255,255,255,.30);\nfont-size:\n11px;\nline-height:\n1;\nfont-weight:\n600;\nletter-spacing:\n.14em;\n}\n.b80h-slide-copy {\nposition: relative;\nz-index: 5;\nwidth: 100%;\nmax-width: 660px;\nmargin: 0;\ntext-align:\ncenter;\ncolor:\nrgba(255,255,255,.95);\nfont-size:\nclamp(\n18px,\n2vw,\n23px\n);\nline-height:\n1.3;\nfont-weight:\n550;\nletter-spacing:\n-.025em;\n}\n.b80h-slide-media {\nposition: relative;\nz-index: 2;\nwidth: 100%;\nmax-width: 780px;\nheight: 270px;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\n}\n.b80h-slide-media img {\ndisplay: block;\nmax-width: 100%;\nmax-height: 100%;\nobject-fit:\ncontain;\nfilter:\ncontrast(1.02)\nbrightness(.98);\ntransform:\nscale(.98);\npointer-events:\nnone;\n-webkit-user-drag:\nnone;\ntransition:\ntransform .7s cubic-bezier(.16,1,.3,1);\n}\n.b80h-slide.is-current\n.b80h-slide-media img {\ntransform:\nscale(1);\n}\n.b80h-slide.has-video\n.b80h-slide-media {\nposition: static;\nz-index: auto;\n}\n.b80h-slide.has-video\n.b80h-slide-inner::after {\ncontent: \"\";\nposition: absolute;\nz-index: 1;\ninset: 0;\npointer-events: none;\nbackground:\nlinear-gradient(\n180deg,\nrgba(0,0,0,.46) 0