    "custom_liquid_aXDi93": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .b80-film {\n    width: 100%;\n    background: #000;\n    color: #fff;\n\n    padding: 105px 24px 115px;\n\n    overflow: hidden;\n\n    /* USE HNDRD / THEME DEFAULT FONT */\n    font-family: inherit;\n  }\n\n  .b80-film,\n  .b80-film * {\n    font-family: inherit;\n  }\n\n\n  /* ================================\n     MAIN CONTAINER\n  ================================= */\n\n  .b80-film__inner {\n    width: 100%;\n    max-width: 1280px;\n\n    margin: 0 auto;\n  }\n\n\n  /* ================================\n     COPY\n  ================================= */\n\n  .b80-film__copy {\n    width: 100%;\n    max-width: 900px;\n\n    margin: 0 auto 64px;\n\n    text-align: center;\n  }\n\n\n  .b80-film__eyebrow {\n    margin: 0 0 15px;\n\n    color: rgba(255,255,255,.42);\n\n    font-size: 12px;\n    font-weight: 500;\n\n    letter-spacing: .13em;\n    text-transform: uppercase;\n\n    text-align: center;\n  }\n\n\n  .b80-film__title {\n    width: 100%;\n    max-width: 850px;\n\n    margin: 0 auto;\n\n    color: #fff;\n\n    font-size: clamp(42px, 4.6vw, 68px);\n    line-height: 1;\n\n    letter-spacing: -.04em;\n\n    font-weight: 600;\n\n    text-align: center;\n  }\n\n\n  .b80-film__description {\n    width: 100%;\n    max-width: 820px;\n\n    margin: 26px auto 0;\n\n    color: rgba(255,255,255,.55);\n\n    font-size: clamp(16px, 1.25vw, 19px);\n    line-height: 1.5;\n\n    font-weight: 400;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  /* ================================\n     VIDEO CONTAINER\n  ================================= */\n\n  .b80-film__video-container {\n    width: 100%;\n    max-width: 1080px;\n\n    margin: 0 auto;\n  }\n\n\n  .b80-film__stage {\n    position: relative;\n\n    width: 100%;\n\n    margin: 0 auto;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    /* NO BORDER */\n    border: none !important;\n    outline: none !important;\n    box-shadow: none !important;\n\n    border-radius: 26px;\n\n    background: #050505;\n\n    isolation: isolate;\n  }\n\n\n  /* NO OVERLAY / NO BORDER EFFECT */\n\n  .b80-film__stage::before {\n    display: none;\n  }\n\n\n  /* ================================\n     VIDEO\n  ================================= */\n\n  .b80-film__video {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: none;\n    outline: none;\n\n    background: #050505;\n  }\n\n\n  /* ================================\n     PLAY / PAUSE\n  ================================= */\n\n  .b80-film__control {\n    position: absolute;\n\n    z-index: 10;\n\n    right: 20px;\n    bottom: 20px;\n\n    width: 48px;\n    height: 48px;\n\n    padding: 0;\n\n    display: grid;\n    place-items: center;\n\n    border: none;\n    outline: none;\n\n    border-radius: 16px;\n\n    background: rgba(255,255,255,.96);\n    color: #090909;\n\n    cursor: pointer;\n\n    transition:\n      transform .2s ease,\n      background .2s ease;\n  }\n\n\n  .b80-film__control:hover {\n    transform: scale(1.04);\n\n    background: #fff;\n  }\n\n\n  .b80-film__control svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  .b80-film__control .pause-icon {\n    display: block;\n  }\n\n\n  .b80-film__control .play-icon {\n    display: none;\n\n    margin-left: 2px;\n  }\n\n\n  .b80-film__control.is-paused .pause-icon {\n    display: none;\n  }\n\n\n  .b80-film__control.is-paused .play-icon {\n    display: block;\n  }\n\n\n  /* ================================\n     WATCH FILM\n  ================================= */\n\n  .b80-film__meta {\n    width: 100%;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    padding-top: 24px;\n  }\n\n\n  .b80-film__watch {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 9px;\n\n    color: rgba(255,255,255,.9);\n\n    font-size: 14px;\n    font-weight: 550;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  .b80-film__watch-icon {\n    width: 21px;\n    height: 21px;\n\n    display: grid;\n    place-items: center;\n\n    border: 1px solid rgba(255,255,255,.42);\n\n    border-radius: 7px;\n\n    color: #fff;\n  }\n\n\n  .b80-film__watch-icon svg {\n    width: 8px;\n    height: 8px;\n\n    margin-left: 1px;\n  }\n\n\n  /* ================================\n     REVEAL ANIMATION\n  ================================= */\n\n  .b80-film__copy,\n  .b80-film__video-container,\n  .b80-film__meta {\n    opacity: 0;\n\n    transform: translateY(22px);\n\n    transition:\n      opacity .9s cubic-bezier(.2,.7,.2,1),\n      transform .9s cubic-bezier(.2,.7,.2,1);\n  }\n\n\n  .b80-film.is-visible .b80-film__copy {\n    opacity: 1;\n\n    transform: translateY(0);\n  }\n\n\n  .b80-film.is-visible .b80-film__video-container {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .10s;\n  }\n\n\n  .b80-film.is-visible .b80-film__meta {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .17s;\n  }\n\n\n  /* ================================\n     MOBILE\n  ================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .b80-film {\n      padding: 72px 14px 80px;\n    }\n\n\n    .b80-film__copy {\n      max-width: 100%;\n\n      margin-bottom: 36px;\n\n      padding: 0 8px;\n    }\n\n\n    .b80-film__eyebrow {\n      margin-bottom: 11px;\n\n      font-size: 10px;\n    }\n\n\n    .b80-film__title {\n      max-width: 390px;\n\n      font-size: clamp(38px, 11vw, 52px);\n\n      line-height: 1.02;\n    }\n\n\n    .b80-film__description {\n      max-width: 390px;\n\n      margin-top: 19px;\n\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n\n    .b80-film__video-container {\n      max-width: 100%;\n    }\n\n\n    .b80-film__stage {\n      aspect-ratio: 16 / 10;\n\n      border-radius: 18px;\n    }\n\n\n    .b80-film__control {\n      width: 42px;\n      height: 42px;\n\n      right: 12px;\n      bottom: 12px;\n\n      border-radius: 14px;\n    }\n\n\n    .b80-film__meta {\n      padding-top: 18px;\n    }\n\n\n    .b80-film__watch {\n      font-size: 13px;\n    }\n\n  }\n\n\n  /* ================================\n     REDUCED MOTION\n  ================================= */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .b80-film__copy,\n    .b80-film__video-container,\n    .b80-film__meta {\n      opacity: 1;\n\n      transform: none;\n\n      transition: none;\n    }\n\n  }\n</style>\n\n\n\n<section class=\"b80-film\">\n\n  <div class=\"b80-film__inner\">\n\n\n    <!-- ==================================\n         CENTERED COPY\n    =================================== -->\n\n    <div class=\"b80-film__copy\">\n\n    \n\n      <h2 class=\"b80-film__title\">\n        Attack in motion.\n      </h2>\n\n\n      <p class=\"b80-film__description\">\n        A razor-thin 5.9 mm shaft built for faster release, sharper handling and explosive response when the rally turns aggressive.\n      </p>\n\n    </div>\n\n\n\n    <!-- ==================================\n         CENTERED VIDEO\n    =================================== -->\n\n    <div class=\"b80-film__video-container\">\n\n      <div class=\"b80-film__stage\">\n\n\n        <!--\n        ==================================\n        ADD YOUR VIDEO HERE\n        ==================================\n        -->\n\n\n        <video\n          class=\"b80-film__video\"\n\n          autoplay\n          muted\n          loop\n          playsinline\n\n          preload=\"metadata\"\n\n          poster=\"PASTE-YOUR-POSTER-IMAGE-URL-HERE\"\n        >\n\n          <source\n            src=\"PASTE-YOUR-VIDEO-URL-HERE\"\n            type=\"video/mp4\"\n          >\n\n        </video>\n\n\n\n        <!-- ==================================\n             PLAY / PAUSE\n        =================================== -->\n\n        <button\n          class=\"b80-film__control\"\n\n          type=\"button\"\n\n          aria-label=\"Pause video\"\n        >\n\n\n          <!-- PAUSE -->\n\n          <svg\n            class=\"pause-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <rect\n              x=\"7\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n\n            <rect\n              x=\"13.5\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n          </svg>\n\n\n\n          <!-- PLAY -->\n\n          <svg\n            class=\"play-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <path\n              d=\"M8 5.5L18 12L8 18.5V5.5Z\"\n            ></path>\n\n          </svg>\n\n\n        </button>\n\n\n      </div>\n\n\n\n      <!-- ==================================\n           WATCH THE FILM\n      =================================== -->\n\n      <div class=\"b80-film__meta\">\n\n        <div class=\"b80-film__watch\">\n\n          Watch the film\n\n\n          <span class=\"b80-film__watch-icon\">\n\n            <svg\n              viewBox=\"0 0 12 12\"\n\n              fill=\"currentColor\"\n            >\n\n              <path\n                d=\"M3.5 2.4L9 6L3.5 9.6V2.4Z\"\n              ></path>\n\n            </svg>\n\n          </span>\n\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<script>\n(() => {\n\n  const sections =\n    document.querySelectorAll('.b80-film');\n\n\n  sections.forEach(section => {\n\n    const video =\n      section.querySelector('.b80-film__video');\n\n    const control =\n      section.querySelector('.b80-film__control');\n\n\n    if (!video || !control) return;\n\n\n\n    /* ================================\n       PLAY / PAUSE\n    ================================= */\n\n    control.addEventListener('click', () => {\n\n      if (video.paused) {\n\n        video.play();\n\n        control.classList.remove('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Pause video'\n        );\n\n      } else {\n\n        video.pause();\n\n        control.classList.add('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Play video'\n        );\n\n      }\n\n    });\n\n\n\n    /* ================================\n       SCROLL REVEAL\n    ================================= */\n\n    const observer =\n      new IntersectionObserver(entries => {\n\n        entries.forEach(entry => {\n\n          if (entry.isIntersecting) {\n\n            section.classList.add('is-visible');\n\n            observer.unobserve(section);\n\n          }\n\n        });\n\n      }, {\n\n        threshold: .12\n\n      });\n\n\n    observer.observe(section);\n\n  });\n\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_kjREq7": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET\nPREMIUM ENGINEERING GRID\n{% endcomment %}\n\n{% assign b80_shaft_img = '' %}\n{% assign b80_curve_img = '' %}\n{% assign b80_foam_img = '' %}\n{% assign b80_tfuse_img = '' %}\n{% assign b80_hyper_img = '' %}\n{% assign b80_carbon_img = '' %}\n\n<section class=\"b80-upgrade\">\n\n  <div class=\"b80-upgrade__shell\">\n\n    <div class=\"b80-upgrade__head\">\n\n      <div class=\"b80-upgrade__headline\">\n        <h2>\n          Built to attack.<br>\n          Engineered to hold.\n        </h2>\n      </div>\n\n      <div class=\"b80-upgrade__intro\">\n        <span>NITRIX 80 BULLET</span>\n\n        <p>\n          Six engineering decisions working together\n          to make every swing faster, cleaner and harder to contain.\n        </p>\n      </div>\n\n    </div>\n\n\n    <div class=\"b80-upgrade__grid\">\n\n\n      <!-- 01 / 5.9MM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--shaft\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            VAPORSHAFT\n          </span>\n\n          <h3>\n            Just\n            <strong>5.9mm.</strong>\n          </h3>\n\n          <p>\n            The thinnest shaft HNDRD has ever made.\n            Built to whip through the swing and stay stable at contact.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_shaft_img != blank %}\n\n            <img\n              src=\"{{ b80_shaft_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet 5.9mm VaporShaft\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__shaft-demo\">\n\n              <div class=\"b80-upgrade__shaft-line\"></div>\n\n              <div class=\"b80-upgrade__measure\">\n                <span></span>\n\n                <div>\n                  <strong>5.9</strong>\n                  <small>MM</small>\n                </div>\n\n                <span></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 02 / CURVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--curve\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CURVE²\n          </span>\n\n          <h3>\n            Sweet spot.<br>\n            Expanded.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_curve_img != blank %}\n\n            <img\n              src=\"{{ b80_curve_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet Curve² Frame\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__curve-demo\">\n\n              <span class=\"b80-upgrade__ring ring-a\"></span>\n              <span class=\"b80-upgrade__ring ring-b\"></span>\n              <span class=\"b80-upgrade__ring ring-c\"></span>\n\n              <div class=\"b80-upgrade__sweet\">\n                <small>EXPANDED</small>\n                <strong>SWEET SPOT</strong>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Refined frame geometry widens the effective sweet spot\n          without slowing the frame down.\n        </p>\n\n      </article>\n\n\n      <!-- 03 / FOAM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--foam\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CNTRL FOAM\n          </span>\n\n          <h3>\n            Shock<br>\n            stops here.\n          </h3>\n\n          <p>\n            Foam engineered inside the frame absorbs shock\n            before it reaches your hand.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_foam_img != blank %}\n\n            <img\n              src=\"{{ b80_foam_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet CNTRL Foam\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__foam-demo\">\n\n              <span class=\"b80-upgrade__wave wave-a\"></span>\n              <span class=\"b80-upgrade__wave wave-b\"></span>\n              <span class=\"b80-upgrade__wave wave-c\"></span>\n\n              <div class=\"b80-upgrade__foam-piece\">\n                <span>CNTRL</span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 04 / T FUSE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--tfuse\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            T FUSE\n          </span>\n\n          <h3>\n            Resist<br>\n            the twist.\n          </h3>\n\n          <p>\n            Reinforcement at the frame and shaft junction\n            controls torsion through full-power swings.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_tfuse_img != blank %}\n\n            <img\n              src=\"{{ b80_tfuse_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet T Fuse\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__tfuse-demo\">\n\n              <span class=\"b80-upgrade__orbit orbit-a\"></span>\n              <span class=\"b80-upgrade__orbit orbit-b\"></span>\n\n              <div class=\"b80-upgrade__t\">\n                <span class=\"b80-upgrade__t-top\"></span>\n                <span class=\"b80-upgrade__t-stem\"></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 05 / HYPERWEAVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--weave\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            HYPERWEAVE\n          </span>\n\n          <h3>\n            Woven<br>\n            to whip.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_hyper_img != blank %}\n\n            <img\n              src=\"{{ b80_hyper_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet Hyperweave\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__weave-demo\">\n\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Woven carbon construction gives the shaft flex\n          without giving away strength.\n        </p>\n\n      </article>\n\n\n      <!-- 06 / CARBON -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--carbon\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            M46X + AECG+\n          </span>\n\n          <h3>\n            Carbon without<br>\n            compromise.\n          </h3>\n\n          <p>\n            Refined carbon systems balance low weight,\n            responsiveness and durability for aggressive play.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_carbon_img != blank %}\n\n            <img\n              src=\"{{ b80_carbon_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet Carbon Construction\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__carbon-demo\">\n\n              <div class=\"b80-upgrade__carbon-sheet\"></div>\n\n              <strong>M46X</strong>\n\n              <span>\n                AEROSPACE-GRADE<br>\n                CARBON SYSTEM\n              </span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n.b80-upgrade,\n.b80-upgrade *{\n  box-sizing:border-box;\n}\n\n\n/* SECTION */\n\n.b80-upgrade{\n  width:100%;\n  padding:120px 24px;\n  background:#000;\n  color:#fff;\n  font-family:Arial,Helvetica,sans-serif;\n}\n\n\n/* OUTER PANEL */\n\n.b80-upgrade__shell{\n  width:100%;\n  max-width:1240px;\n  margin:0 auto;\n\n  padding:\n    clamp(52px,6vw,78px);\n\n  border-radius:42px;\n\n  background:#121214;\n}\n\n\n/* HEADER */\n\n.b80-upgrade__head{\n  display:grid;\n\n  grid-template-columns:\n    minmax(0,1fr)\n    minmax(280px,.55fr);\n\n  gap:80px;\n\n  align-items:start;\n\n  margin-bottom:60px;\n}\n\n\n.b80-upgrade__headline h2{\n  margin:0;\n\n  max-width:650px;\n\n  color:#f5f5f7;\n\n  font-size:\n    clamp(46px,5.5vw,76px);\n\n  line-height:.97;\n\n  font-weight:700;\n\n  letter-spacing:-.055em;\n}\n\n\n.b80-upgrade__intro{\n  padding-top:9px;\n}\n\n\n.b80-upgrade__intro span{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.38);\n\n  font-size:10px;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__intro p{\n  max-width:370px;\n\n  margin:0;\n\n  color:rgba(255,255,255,.72);\n\n  font-size:16px;\n\n  line-height:1.5;\n\n  font-weight:500;\n}\n\n\n/* GRID */\n\n.b80-upgrade__grid{\n  display:grid;\n\n  grid-template-columns:\n    repeat(3,minmax(0,1fr));\n\n  gap:16px;\n}\n\n\n/* CARD */\n\n.b80-upgrade__card{\n  position:relative;\n\n  min-height:440px;\n\n  overflow:hidden;\n\n  border-radius:26px;\n\n  background:#000;\n\n  isolation:isolate;\n\n  transform:translateZ(0);\n\n  transition:\n    transform .55s cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-upgrade__card:hover{\n  transform:translateY(-5px);\n}\n\n\n.b80-upgrade__card::after{\n  content:\"\";\n\n  position:absolute;\n\n  top:0;\n  left:14%;\n  right:14%;\n\n  height:1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.10),\n      transparent\n    );\n\n  pointer-events:none;\n}\n\n\n/* COPY */\n\n.b80-upgrade__copy{\n  position:relative;\n\n  z-index:10;\n\n  padding:\n    34px 32px 0;\n}\n\n\n.b80-upgrade__copy--center{\n  text-align:center;\n}\n\n\n.b80-upgrade__eyebrow{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.34);\n\n  font-size:9px;\n\n  line-height:1;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__copy h3{\n  margin:0;\n\n  color:rgba(255,255,255,.94);\n\n  font-size:\n    clamp(28px,2.5vw,39px);\n\n  line-height:1.03;\n\n  font-weight:650;\n\n  letter-spacing:-.045em;\n}\n\n\n.b80-upgrade__copy h3 strong{\n  display:block;\n\n  margin-top:5px;\n\n  color:#fff;\n\n  font-size:\n    clamp(52px,4.3vw,72px);\n\n  line-height:.9;\n\n  letter-spacing:-.07em;\n}\n\n\n.b80-upgrade__copy p{\n  max-width:300px;\n\n  margin:17px 0 0;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:13px;\n\n  line-height:1.5;\n}\n\n\n.b80-upgrade__bottom{\n  position:absolute;\n\n  z-index:10;\n\n  left:30px;\n  right:30px;\n  bottom:26px;\n\n  margin:0;\n\n  text-align:center;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:12.5px;\n\n  line-height:1.45;\n}\n\n\n/* MEDIA */\n\n.b80-upgrade__media{\n  position:absolute;\n\n  inset:\n    170px 0 0;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  pointer-events:none;\n}\n\n\n.b80-upgrade__media img{\n  width:100%;\n  height:100%;\n\n  object-fit:contain;\n\n  object-position:center bottom;\n}\n\n\n/* ========================\n   SHAFT\n======================== */\n\n.b80-upgrade__card--shaft{\n  background:\n    radial-gradient(\n      circle at 50% 80%,\n      rgba(255,255,255,.045),\n      transparent 48%\n    ),\n    #020202;\n}\n\n\n.b80-upgrade__shaft-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__shaft-line{\n  width:8px;\n  height:78%;\n\n  border-radius:999px;\n\n  transform:rotate(12deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      #121416,\n      #bccbd3 28%,\n      #f7fdff 48%,\n      #56636a 70%,\n      #111315\n    );\n\n  box-shadow:\n    0 0 30px rgba(255,255,255,.05);\n}\n\n\n.b80-upgrade__measure{\n  position:absolute;\n\n  left:13%;\n  right:13%;\n  top:47%;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:12px;\n}\n\n\n.b80-upgrade__measure > span{\n  flex:1;\n\n  height:1px;\n\n  background:\n    rgba(255,255,255,.16);\n}\n\n\n.b80-upgrade__measure div{\n  display:flex;\n\n  align-items:baseline;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__measure strong{\n  font-size:38px;\n\n  line-height:1;\n\n  letter-spacing:-.06em;\n}\n\n\n.b80-upgrade__measure small{\n  color:rgba(255,255,255,.35);\n\n  font-size:9px;\n\n  font-weight:700;\n}\n\n\n/* ========================\n   CURVE²\n======================== */\n\n.b80-upgrade__curve-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__ring{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.15);\n\n  border-radius:50%;\n\n  transform:\n    perspective(500px)\n    rotateX(62deg);\n}\n\n\n.ring-a{\n  width:240px;\n  height:155px;\n}\n\n\n.ring-b{\n  width:195px;\n  height:125px;\n\n  opacity:.65;\n}\n\n\n.ring-c{\n  width:150px;\n  height:95px;\n\n  opacity:.35;\n}\n\n\n.b80-upgrade__sweet{\n  position:relative;\n\n  z-index:3;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__sweet small{\n  color:rgba(255,255,255,.30);\n\n  font-size:8px;\n\n  letter-spacing:.14em;\n}\n\n\n.b80-upgrade__sweet strong{\n  color:rgba(255,255,255,.88);\n\n  font-size:13px;\n}\n\n\n/* ========================\n   FOAM\n======================== */\n\n.b80-upgrade__foam-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__foam-piece{\n  position:absolute;\n\n  bottom:-40px;\n\n  width:145px;\n  height:230px;\n\n  border-radius:\n    62px 62px\n    24px 24px;\n\n  transform:rotate(17deg);\n\n  background:\n    linear-gradient(\n      145deg,\n      #202428,\n      #090a0b\n    );\n\n  box-shadow:\n    inset 15px 0 25px\n    rgba(255,255,255,.025);\n}\n\n\n.b80-upgrade__foam-piece span{\n  position:absolute;\n\n  left:50%;\n  top:50%;\n\n  transform:\n    translate(-50%,-50%)\n    rotate(-90deg);\n\n  color:rgba(255,255,255,.16);\n\n  font-size:18px;\n\n  font-weight:700;\n\n  letter-spacing:.10em;\n}\n\n\n.b80-upgrade__wave{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.07);\n\n  border-radius:50%;\n}\n\n\n.wave-a{\n  width:120px;\n  height:120px;\n}\n\n\n.wave-b{\n  width:190px;\n  height:190px;\n}\n\n\n.wave-c{\n  width:265px;\n  height:265px;\n\n  opacity:.45;\n}\n\n\n/* ========================\n   T FUSE\n======================== */\n\n.b80-upgrade__tfuse-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__t{\n  position:relative;\n\n  width:220px;\n  height:190px;\n}\n\n\n.b80-upgrade__t-top{\n  position:absolute;\n\n  left:0;\n  right:0;\n  top:18px;\n\n  height:30px;\n\n  border-radius:\n    50% 50%\n    12px 12px;\n\n  background:\n    linear-gradient(\n      180deg,\n      #373c40,\n      #101214\n    );\n}\n\n\n.b80-upgrade__t-stem{\n  position:absolute;\n\n  left:50%;\n  top:34px;\n\n  width:25px;\n  height:160px;\n\n  transform:translateX(-50%);\n\n  border-radius:10px;\n\n  background:\n    linear-gradient(\n      90deg,\n      #0c0d0e,\n      #4e575c,\n      #0d0f10\n    );\n}\n\n\n.b80-upgrade__orbit{\n  position:absolute;\n\n  width:235px;\n  height:90px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  border-radius:50%;\n}\n\n\n.orbit-a{\n  transform:rotate(18deg);\n}\n\n\n.orbit-b{\n  transform:rotate(-18deg);\n}\n\n\n/* ========================\n   WEAVE\n======================== */\n\n.b80-upgrade__weave-demo{\n  position:relative;\n\n  width:86%;\n  height:180px;\n}\n\n\n.b80-upgrade__weave-demo span{\n  position:absolute;\n\n  left:0;\n  right:0;\n\n  height:7px;\n\n  border-radius:999px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      #272b2d 8%,\n      #dce8ed 32%,\n      #222629 70%,\n      transparent\n    );\n}\n\n\n.b80-upgrade__weave-demo span:nth-child(1){\n  top:18px;\n  transform:rotate(-8deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(2){\n  top:40px;\n  transform:rotate(-5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(3){\n  top:62px;\n  transform:rotate(-2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(4){\n  top:84px;\n}\n\n.b80-upgrade__weave-demo span:nth-child(5){\n  top:106px;\n  transform:rotate(2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(6){\n  top:128px;\n  transform:rotate(5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(7){\n  top:150px;\n  transform:rotate(8deg);\n}\n\n\n/* ========================\n   CARBON\n======================== */\n\n.b80-upgrade__carbon-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__carbon-sheet{\n  position:absolute;\n\n  width:90%;\n  height:110px;\n\n  background:\n    repeating-linear-gradient(\n      45deg,\n      #080808 0,\n      #080808 4px,\n      #171717 4px,\n      #171717 6px\n    );\n\n  transform:rotate(-8deg);\n\n  opacity:.75;\n}\n\n\n.b80-upgrade__carbon-demo strong{\n  position:relative;\n\n  z-index:2;\n\n  font-size:\n    clamp(56px,5vw,82px);\n\n  line-height:.9;\n\n  letter-spacing:-.075em;\n}\n\n\n.b80-upgrade__carbon-demo > span{\n  position:relative;\n\n  z-index:2;\n\n  margin-top:15px;\n\n  color:rgba(255,255,255,.28);\n\n  font-size:8px;\n\n  line-height:1.45;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n\n  text-align:center;\n}\n\n\n/* TABLET */\n\n@media(max-width:1000px){\n\n  .b80-upgrade__head{\n    grid-template-columns:1fr;\n\n    gap:28px;\n  }\n\n\n  .b80-upgrade__grid{\n    grid-template-columns:\n      repeat(2,minmax(0,1fr));\n  }\n\n}\n\n\n/* MOBILE */\n\n@media(max-width:700px){\n\n  .b80-upgrade{\n    padding:\n      74px 14px;\n  }\n\n\n  .b80-upgrade__shell{\n    padding:\n      42px 14px\n      16px;\n\n    border-radius:28px;\n  }\n\n\n  .b80-upgrade__head{\n    padding:\n      0 12px;\n\n    margin-bottom:40px;\n  }\n\n\n  .b80-upgrade__headline h2{\n    font-size:\n      clamp(\n        40px,\n        12vw,\n        56px\n      );\n  }\n\n\n  .b80-upgrade__intro{\n    padding:0;\n  }\n\n\n  /* MOBILE = SWIPEABLE CARDS */\n\n  .b80-upgrade__grid{\n    display:flex;\n\n    gap:13px;\n\n    overflow-x:auto;\n\n    overflow-y:hidden;\n\n    scroll-snap-type:\n      x mandatory;\n\n    scroll-behavior:smooth;\n\n    overscroll-behavior-x:\n      contain;\n\n    -webkit-overflow-scrolling:\n      touch;\n\n    scrollbar-width:none;\n\n    padding:\n      0 0 2px;\n  }\n\n\n  .b80-upgrade__grid::-webkit-scrollbar{\n    display:none;\n  }\n\n\n  .b80-upgrade__card{\n    flex:\n      0 0\n      87%;\n\n    width:87%;\n\n    min-height:485px;\n\n    border-radius:25px;\n\n    scroll-snap-align:center;\n\n    scroll-snap-stop:always;\n  }\n\n\n  .b80-upgrade__copy{\n    padding:\n      31px 26px 0;\n  }\n\n\n  .b80-upgrade__copy h3{\n    font-size:\n      clamp(\n        30px,\n        9vw,\n        40px\n      );\n  }\n\n\n  .b80-upgrade__copy h3 strong{\n    font-size:\n      clamp(\n        52px,\n        16vw,\n        70px\n      );\n  }\n\n\n  .b80-upgrade__bottom{\n    left:25px;\n    right:25px;\n    bottom:25px;\n  }\n\n}\n\n</style>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
