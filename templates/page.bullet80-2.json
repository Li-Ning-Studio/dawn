      "settings": {
        "custom_liquid": "<style>\n  .bullet-xiaomi-wrap {\n    background: #000000;\n    width: 100%;\n    padding: 80px 20px;\n  }\n\n  .bullet-xiaomi-grid {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n\n    grid-template-rows:\n      330px\n      300px\n      145px\n      145px;\n\n    gap: 16px;\n  }\n\n\n  /* =========================================\n     BASIC CARD\n  ========================================= */\n\n  .bx-card {\n    position: relative;\n\n    overflow: hidden;\n\n    border-radius: 24px;\n\n    background: #03050a;\n\n    isolation: isolate;\n  }\n\n\n  .bx-picture {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    z-index: 0;\n  }\n\n\n  .bx-picture img {\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n\n  .bx-card::after {\n    content: \"\";\n\n    position: absolute;\n    inset: 0;\n\n    z-index: 1;\n\n    pointer-events: none;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0,0,0,.10) 0%,\n        rgba(0,0,0,0) 55%,\n        rgba(0,0,0,.10) 100%\n      );\n  }\n\n\n\n  /* =========================================\n     DESKTOP GRID\n  ========================================= */\n\n\n  /* LARGE TOP CARD */\n\n  .bx-card-1 {\n    grid-column: 1 / 3;\n    grid-row: 1;\n  }\n\n\n  /* SECOND ROW */\n\n  .bx-card-2 {\n    grid-column: 1;\n    grid-row: 2;\n  }\n\n\n  .bx-card-3 {\n    grid-column: 2;\n    grid-row: 2;\n  }\n\n\n  /* LARGE TALL LEFT */\n\n  .bx-card-4 {\n    grid-column: 1;\n    grid-row: 3 / 5;\n  }\n\n\n  /* SMALL RIGHT */\n\n  .bx-card-5 {\n    grid-column: 2;\n    grid-row: 3;\n  }\n\n\n  .bx-card-6 {\n    grid-column: 2;\n    grid-row: 4;\n  }\n\n\n\n  /* =========================================\n     TEXT\n  ========================================= */\n\n  .bx-copy {\n    position: absolute;\n\n    z-index: 5;\n\n    color: #ffffff;\n\n    pointer-events: none;\n  }\n\n\n  .bx-copy h3 {\n    padding: 0;\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 25px;\n    line-height: 1.05;\n\n    font-weight: 650;\n\n    letter-spacing: -0.03em;\n  }\n\n\n  .bx-copy p {\n    padding: 0;\n\n    margin: 9px 0 0;\n\n    color: rgba(255,255,255,.62);\n\n    font-size: 15px;\n    line-height: 1.35;\n\n    font-weight: 400;\n  }\n\n\n\n  /* =========================================\n     TEXT POSITIONS\n  ========================================= */\n\n  .bx-top-left {\n    left: 6%;\n    top: 8%;\n  }\n\n\n  .bx-top-right {\n    right: 6%;\n    top: 8%;\n  }\n\n\n  .bx-center-right {\n    right: 8%;\n    top: 50%;\n\n    transform: translateY(-50%);\n  }\n\n\n  .bx-center-left {\n    left: 8%;\n    top: 50%;\n\n    transform: translateY(-50%);\n  }\n\n\n  .bx-bottom-left {\n    left: 6%;\n    bottom: 8%;\n  }\n\n\n  .bx-bottom-right {\n    right: 6%;\n    bottom: 8%;\n  }\n\n\n\n  /* =========================================\n     TOP CARD\n  ========================================= */\n\n  .bx-card-1 .bx-copy {\n    max-width: 340px;\n  }\n\n\n  .bx-card-1 .bx-copy h3 {\n    font-size: 29px;\n  }\n\n\n  .bx-card-1 .bx-copy p {\n    font-size: 17px;\n  }\n\n\n\n  /* =========================================\n     SMALL RIGHT CARDS\n  ========================================= */\n\n  .bx-card-5 .bx-copy,\n  .bx-card-6 .bx-copy {\n    max-width: 44%;\n  }\n\n\n  .bx-card-5 .bx-copy h3,\n  .bx-card-6 .bx-copy h3 {\n    font-size: 20px;\n  }\n\n\n  .bx-card-5 .bx-copy p,\n  .bx-card-6 .bx-copy p {\n    font-size: 12px;\n\n    margin-top: 6px;\n  }\n\n\n\n  /* =========================================\n     TABLET\n  ========================================= */\n\n  @media screen and (max-width: 990px) and (min-width: 750px) {\n\n    .bullet-xiaomi-grid {\n      max-width: 760px;\n\n      grid-template-rows:\n        260px\n        250px\n        130px\n        130px;\n    }\n\n\n    .bx-card {\n      border-radius: 20px;\n    }\n\n\n    .bx-copy h3 {\n      font-size: 20px;\n    }\n\n\n    .bx-copy p {\n      font-size: 13px;\n    }\n\n  }\n\n\n\n  /* =========================================\n     MOBILE\n     XIAOMI STYLE LAYOUT\n  ========================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .bullet-xiaomi-wrap {\n      padding: 30px 12px;\n    }\n\n\n    .bullet-xiaomi-grid {\n      width: 100%;\n      max-width: 430px;\n\n      margin: 0 auto;\n\n      display: grid;\n\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n\n\n      /*\n        MOBILE STRUCTURE\n\n        CARD 1   = 310px\n        CARD 2/3 = 345px\n        CARD 4/5 = 345px\n        CARD 6   = 225px\n      */\n\n      grid-template-rows:\n        310px\n        345px\n        345px\n        225px;\n\n      gap: 10px;\n    }\n\n\n    .bx-card {\n      min-height: 0;\n\n      border-radius: 15px;\n    }\n\n\n\n    /* =========================================\n       MOBILE GRID POSITIONS\n    ========================================= */\n\n\n    /* FULL WIDTH TOP */\n\n    .bx-card-1 {\n      grid-column: 1 / 3;\n      grid-row: 1;\n    }\n\n\n    /* TWO TALL CARDS */\n\n    .bx-card-2 {\n      grid-column: 1;\n      grid-row: 2;\n    }\n\n\n    .bx-card-3 {\n      grid-column: 2;\n      grid-row: 2;\n    }\n\n\n    /* NEXT TWO TALL CARDS */\n\n    .bx-card-4 {\n      grid-column: 1;\n      grid-row: 3;\n    }\n\n\n    .bx-card-5 {\n      grid-column: 2;\n      grid-row: 3;\n    }\n\n\n    /* FULL WIDTH BOTTOM */\n\n    .bx-card-6 {\n      grid-column: 1 / 3;\n      grid-row: 4;\n    }\n\n\n\n    /* =========================================\n       MOBILE IMAGE POSITION\n    ========================================= */\n\n    .bx-picture img {\n      object-position: center;\n    }\n\n\n\n    /* =========================================\n       MOBILE TEXT\n    ========================================= */\n\n    .bx-copy {\n      transform: none;\n\n      max-width: none;\n    }\n\n\n    .bx-top-left,\n    .bx-center-left,\n    .bx-bottom-left {\n      left: 18px;\n      right: auto;\n    }\n\n\n    .bx-top-right,\n    .bx-center-right,\n    .bx-bottom-right {\n      left: 18px;\n      right: auto;\n    }\n\n\n    /*\n      Xiaomi style:\n      text sits near top instead of floating\n      around unpredictably.\n    */\n\n    .bx-copy,\n    .bx-top-left,\n    .bx-top-right,\n    .bx-center-left,\n    .bx-center-right,\n    .bx-bottom-left,\n    .bx-bottom-right {\n      top: 22px;\n      bottom: auto;\n\n      transform: none;\n    }\n\n\n\n    /* CARD 1 */\n\n    .bx-card-1 .bx-copy {\n      left: 24px;\n\n      top: 26px;\n\n      max-width: 58%;\n    }\n\n\n    .bx-card-1 .bx-copy h3 {\n      font-size: 20px;\n      line-height: 1.05;\n    }\n\n\n    .bx-card-1 .bx-copy p {\n      margin-top: 8px;\n\n      font-size: 13px;\n      line-height: 1.35;\n    }\n\n\n\n    /* HALF WIDTH TALL CARDS */\n\n    .bx-card-2 .bx-copy,\n    .bx-card-3 .bx-copy,\n    .bx-card-4 .bx-copy,\n    .bx-card-5 .bx-copy {\n      left: 18px;\n      right: 14px;\n\n      top: 28px;\n\n      max-width: calc(100% - 32px);\n    }\n\n\n    .bx-card-2 .bx-copy h3,\n    .bx-card-3 .bx-copy h3,\n    .bx-card-4 .bx-copy h3,\n    .bx-card-5 .bx-copy h3 {\n      font-size: 16px;\n\n      line-height: 1.05;\n    }\n\n\n    .bx-card-2 .bx-copy p,\n    .bx-card-3 .bx-copy p,\n    .bx-card-4 .bx-copy p,\n    .bx-card-5 .bx-copy p {\n      margin-top: 10px;\n\n      font-size: 12px;\n\n      line-height: 1.3;\n    }\n\n\n\n    /* BOTTOM FULL WIDTH */\n\n    .bx-card-6 .bx-copy {\n      left: 24px;\n\n      top: 28px;\n\n      max-width: 55%;\n    }\n\n\n    .bx-card-6 .bx-copy h3 {\n      font-size: 19px;\n    }\n\n\n    .bx-card-6 .bx-copy p {\n      margin-top: 8px;\n\n      font-size: 12px;\n    }\n\n  }\n\n\n\n  /* =========================================\n     SMALL MOBILE\n  ========================================= */\n\n  @media screen and (max-width: 390px) {\n\n    .bullet-xiaomi-grid {\n      grid-template-rows:\n        285px\n        320px\n        320px\n        205px;\n\n      gap: 8px;\n    }\n\n\n    .bx-card {\n      border-radius: 13px;\n    }\n\n\n    .bx-card-2 .bx-copy,\n    .bx-card-3 .bx-copy,\n    .bx-card-4 .bx-copy,\n    .bx-card-5 .bx-copy {\n      left: 15px;\n      right: 12px;\n    }\n\n\n    .bx-card-2 .bx-copy h3,\n    .bx-card-3 .bx-copy h3,\n    .bx-card-4 .bx-copy h3,\n    .bx-card-5 .bx-copy h3 {\n      font-size: 15px;\n    }\n\n\n    .bx-card-2 .bx-copy p,\n    .bx-card-3 .bx-copy p,\n    .bx-card-4 .bx-copy p,\n    .bx-card-5 .bx-copy p {\n      font-size: 11px;\n    }\n\n  }\n\n</style>\n\n\n\n<div class=\"bullet-xiaomi-wrap\">\n\n  <div class=\"bullet-xiaomi-grid\">\n\n\n\n    <!-- =========================================\n         CARD 1\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-1\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_5.9_mm_R.jpg?v=1786710857\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_5.9_mm_2_f7be9ba1-297e-40a8-9e1a-f3892c4b8cc0.jpg?v=1786704666\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          5.9 MM SHAFT\n        </h3>\n\n        <p>\n          Built for faster release.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 2\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-2\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_ctrl.jpg?v=1786701901\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_ctrl.jpg?v=1786701901\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          CNTRL Foam.\n        </h3>\n\n        <p>\n          Shock stops here.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 3\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-3\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_curve_2.jpg?v=1786701900\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_curve_2.jpg?v=1786701900\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          Curve² Frame.\n        </h3>\n\n        <p>\n          Sweet spot expanded.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 4\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-4\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_carbon_fibre_66b5dbda-2f3d-43a6-96b6-df10cb7d78d3.jpg?v=1786704667\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/bullet_web_carbon_fibre_66b5dbda-2f3d-43a6-96b6-df10cb7d78d3.jpg?v=1786704667\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          M46X Carbon Fibre\n        </h3>\n\n        <p>\n          Engineered for attacking response.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 5\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-5\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/attack_ready_R.jpg?v=1786710287\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/attack_ready.jpg?v=1786704666\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Attack Ready\n        </h3>\n\n        <p>\n          Power on a hair trigger.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 6\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-6\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/built_faster.jpg?v=1786710287\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Built Faster\n        </h3>\n\n        <p>\n          Ready for the next shot.\n        </p>\n\n      </div>\n\n    </div>\n\n\n  </div>\n\n</div>",
