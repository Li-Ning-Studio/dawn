    "custom_liquid_xtqQbp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .b80-360 {\n    width: 100%;\n    background: #000;\n    color: #fff;\n    padding: 100px 24px 80px;\n    overflow: hidden;\n    font-family: inherit;\n  }\n\n  .b80-360,\n  .b80-360 * {\n    font-family: inherit;\n    box-sizing: border-box;\n  }\n\n  .b80-360__inner {\n    width: 100%;\n    max-width: 1380px;\n    margin: 0 auto;\n  }\n\n\n  /* =====================================================\n     HEADING\n  ===================================================== */\n\n  .b80-360__heading {\n    width: 100%;\n    max-width: 900px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .b80-360__title {\n    margin: 0;\n    color: #fff;\n\n    font-size: clamp(42px, 5.5vw, 80px);\n    line-height: .95;\n\n    letter-spacing: -.05em;\n    font-weight: 700;\n  }\n\n  .b80-360__intro {\n    width: 100%;\n    max-width: 610px;\n\n    margin: 20px auto 0;\n\n    color: rgba(255,255,255,.52);\n\n    font-size: clamp(15px, 1.3vw, 19px);\n    line-height: 1.55;\n\n    font-weight: 400;\n  }\n\n\n  /* =====================================================\n     SPEC NAVIGATION\n  ===================================================== */\n\n  .b80-feature-nav {\n    width: 100%;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n\n    gap: 9px;\n\n    margin: 0 auto 22px;\n  }\n\n  .b80-feature-button {\n    position: relative;\n    isolation: isolate;\n\n    appearance: none;\n\n    padding: 12px 19px;\n\n    border: 0 !important;\n    outline: none;\n\n    border-radius: 999px;\n\n    color: rgba(255,255,255,.52);\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.075) 0%,\n        rgba(255,255,255,.038) 48%,\n        rgba(255,255,255,.018) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.07),\n      inset 0 -1px 0 rgba(0,0,0,.26),\n      0 8px 24px rgba(0,0,0,.16);\n\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n\n    font: inherit;\n    font-size: 13px;\n    font-weight: 500;\n\n    cursor: pointer;\n\n    transition:\n      color .25s ease,\n      background .25s ease,\n      transform .25s ease,\n      box-shadow .25s ease;\n  }\n\n  .b80-feature-button::before {\n    content: \"\";\n\n    position: absolute;\n    z-index: -1;\n\n    inset: 1px;\n\n    border-radius: inherit;\n\n    background:\n      radial-gradient(\n        circle at 50% 0%,\n        rgba(255,255,255,.055),\n        transparent 64%\n      );\n\n    pointer-events: none;\n  }\n\n  .b80-feature-button:hover {\n    color: rgba(255,255,255,.92);\n\n    transform: translateY(-1px);\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.105) 0%,\n        rgba(255,255,255,.052) 52%,\n        rgba(255,255,255,.025) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.10),\n      0 10px 28px rgba(0,0,0,.22);\n  }\n\n  .b80-feature-button.is-active {\n    color: #fff;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.15) 0%,\n        rgba(255,255,255,.075) 48%,\n        rgba(255,255,255,.035) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.14),\n      inset 0 -1px 0 rgba(0,0,0,.30),\n      0 10px 30px rgba(0,0,0,.23);\n  }\n\n\n  /* =====================================================\n     MODEL VIEWER\n  ===================================================== */\n\n  .b80-viewer {\n    position: relative;\n\n    width: 100%;\n    height: min(75vw, 820px);\n    min-height: 650px;\n\n    overflow: hidden;\n\n    border: 0 !important;\n    outline: 0 !important;\n\n    border-radius: 32px;\n\n    background:\n      radial-gradient(\n        ellipse at 50% 44%,\n        rgba(255,255,255,.045) 0%,\n        rgba(255,255,255,.018) 30%,\n        rgba(255,255,255,.005) 55%,\n        transparent 74%\n      ),\n      linear-gradient(\n        180deg,\n        #070707 0%,\n        #030303 55%,\n        #000 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.025);\n\n    isolation: isolate;\n  }\n\n  #b80-model {\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    background: transparent;\n\n    --poster-color: transparent;\n    --progress-bar-color: rgba(255,255,255,.72);\n    --progress-bar-height: 2px;\n  }\n\n\n  /* =====================================================\n     VIEWER TOP UI\n  ===================================================== */\n\n  .b80-viewer__top {\n    position: absolute;\n    z-index: 30;\n\n    top: 22px;\n    left: 22px;\n    right: 22px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    pointer-events: none;\n  }\n\n  .b80-viewer__badge {\n    display: inline-flex;\n    align-items: center;\n\n    gap: 8px;\n\n    padding: 9px 13px;\n\n    border: 0 !important;\n    border-radius: 999px;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.08),\n        rgba(255,255,255,.025)\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.065),\n      0 8px 25px rgba(0,0,0,.17);\n\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n\n    color: rgba(255,255,255,.63);\n\n    font-size: 11px;\n    font-weight: 500;\n\n    letter-spacing: .08em;\n  }\n\n  .b80-viewer__badge-dot {\n    width: 6px;\n    height: 6px;\n\n    border-radius: 50%;\n\n    background: rgba(255,255,255,.75);\n  }\n\n\n  /* =====================================================\n     RESET BUTTON\n  ===================================================== */\n\n  .b80-reset {\n    pointer-events: auto;\n\n    width: 42px;\n    height: 42px;\n\n    display: grid;\n    place-items: center;\n\n    padding: 0;\n\n    border: 0 !important;\n    outline: none;\n\n    border-radius: 50%;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.09),\n        rgba(255,255,255,.03)\n      );\n\n    color: #fff;\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.08),\n      0 8px 24px rgba(0,0,0,.20);\n\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n\n    cursor: pointer;\n\n    transition:\n      transform .25s ease,\n      background .25s ease;\n  }\n\n  .b80-reset:hover {\n    transform: scale(1.04);\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.13),\n        rgba(255,255,255,.05)\n      );\n  }\n\n  .b80-reset svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  /* =====================================================\n     HOTSPOTS\n  ===================================================== */\n\n  .b80-hotspot {\n    position: relative;\n\n    width: 24px;\n    height: 24px;\n\n    padding: 0;\n\n    border: 0 !important;\n    outline: none;\n\n    border-radius: 50%;\n\n    background:\n      radial-gradient(\n        circle,\n        #fff 0%,\n        #f4f4f4 52%,\n        #d6d6d6 100%\n      );\n\n    cursor: pointer;\n\n    box-shadow:\n      0 0 0 5px rgba(255,255,255,.045),\n      0 8px 22px rgba(0,0,0,.27);\n  }\n\n  .b80-hotspot::before {\n    content: \"\";\n\n    position: absolute;\n\n    inset: 8px;\n\n    border-radius: 50%;\n\n    background: #111;\n  }\n\n  .b80-hotspot::after {\n    content: \"\";\n\n    position: absolute;\n\n    inset: -8px;\n\n    border: 0 !important;\n    border-radius: 50%;\n\n    background: rgba(255,255,255,.065);\n\n    animation: b80Pulse 2.2s infinite ease-out;\n\n    pointer-events: none;\n  }\n\n  @keyframes b80Pulse {\n    0% {\n      transform: scale(.72);\n      opacity: 0;\n    }\n\n    35% {\n      opacity: .65;\n    }\n\n    100% {\n      transform: scale(1.5);\n      opacity: 0;\n    }\n  }\n\n  .b80-hotspot__label {\n    position: absolute;\n\n    left: 34px;\n    top: 50%;\n\n    transform: translateY(-50%);\n\n    width: max-content;\n    max-width: 220px;\n\n    padding: 8px 12px;\n\n    border: 0 !important;\n    border-radius: 999px;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(35,35,35,.88),\n        rgba(12,12,12,.82)\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.07),\n      0 8px 25px rgba(0,0,0,.20);\n\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n\n    color: rgba(255,255,255,.76);\n\n    font-size: 12px;\n    font-weight: 500;\n\n    pointer-events: none;\n\n    transition:\n      color .2s ease,\n      background .2s ease,\n      opacity .2s ease;\n  }\n\n  .b80-hotspot.is-active .b80-hotspot__label {\n    color: #fff;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(48,48,48,.94),\n        rgba(17,17,17,.9)\n      );\n  }\n\n\n  /* =====================================================\n     SPEC INFORMATION CARD\n  ===================================================== */\n\n  .b80-info {\n    position: absolute;\n    z-index: 25;\n\n    left: 28px;\n    bottom: 28px;\n\n    width: min(380px, calc(100% - 56px));\n\n    padding: 20px 22px;\n\n    overflow: hidden;\n\n    border: 0 !important;\n    outline: none;\n\n    border-radius: 20px;\n\n    background:\n      linear-gradient(\n        145deg,\n        rgba(32,32,32,.88) 0%,\n        rgba(18,18,18,.84) 48%,\n        rgba(8,8,8,.80) 100%\n      );\n\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.075),\n      0 20px 60px rgba(0,0,0,.32);\n\n    backdrop-filter: blur(28px) saturate(105%);\n    -webkit-backdrop-filter: blur(28px) saturate(105%);\n\n    opacity: 0;\n\n    transform: translateY(12px);\n\n    pointer-events: none;\n\n    transition:\n      opacity .35s ease,\n      transform .35s ease;\n  }\n\n  .b80-info.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .b80-info__index {\n    display: block;\n\n    margin-bottom: 8px;\n\n    color: rgba(255,255,255,.38);\n\n    font-size: 11px;\n    font-weight: 500;\n\n    letter-spacing: .14em;\n  }\n\n  .b80-info h3 {\n    margin: 0;\n\n    color: #fff;\n\n    font-size: 24px;\n    line-height: 1.05;\n\n    letter-spacing: -.025em;\n\n    font-weight: 600;\n  }\n\n  .b80-info p {\n    margin: 10px 0 0;\n\n    color: rgba(255,255,255,.57);\n\n    font-size: 14px;\n    line-height: 1.5;\n\n    font-weight: 400;\n  }\n\n\n  /* =====================================================\n     DRAG HINT\n  ===================================================== */\n\n  .b80-hint {\n    position: absolute;\n\n    z-index: 10;\n\n    left: 50%;\n    bottom: 25px;\n\n    transform: translateX(-50%);\n\n    display: flex;\n    align-items: center;\n\n    gap: 8px;\n\n    color: rgba(255,255,255,.38);\n\n    font-size: 12px;\n\n    pointer-events: none;\n\n    transition: opacity .4s ease;\n  }\n\n  .b80-hint.is-hidden {\n    opacity: 0;\n  }\n\n  .b80-hint svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  /* =====================================================\n     MOBILE\n  ===================================================== */\n\n  @media screen and (max-width: 749px) {\n\n    .b80-360 {\n      padding: 70px 12px 55px;\n    }\n\n    .b80-360__heading {\n      margin-bottom: 28px;\n      padding: 0 10px;\n    }\n\n    .b80-360__title {\n      font-size: clamp(40px, 12vw, 58px);\n    }\n\n    .b80-360__intro {\n      font-size: 15px;\n    }\n\n\n    /* specs become horizontal scroll */\n\n    .b80-feature-nav {\n      justify-content: flex-start;\n\n      flex-wrap: nowrap;\n\n      overflow-x: auto;\n      overflow-y: hidden;\n\n      margin-left: -12px;\n      margin-right: -12px;\n\n      padding: 0 12px 6px;\n\n      scrollbar-width: none;\n\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .b80-feature-nav::-webkit-scrollbar {\n      display: none;\n    }\n\n    .b80-feature-button {\n      flex: 0 0 auto;\n\n      padding: 11px 16px;\n\n      font-size: 12px;\n    }\n\n\n    /* viewer */\n\n    .b80-viewer {\n      height: 620px;\n      min-height: 0;\n\n      border-radius: 22px;\n    }\n\n    .b80-viewer__top {\n      top: 14px;\n      left: 14px;\n      right: 14px;\n    }\n\n    .b80-viewer__badge {\n      padding: 8px 11px;\n\n      font-size: 9px;\n    }\n\n    .b80-reset {\n      width: 40px;\n      height: 40px;\n    }\n\n\n    /* hotspot labels hidden on mobile */\n\n    .b80-hotspot__label {\n      display: none;\n    }\n\n    .b80-hotspot {\n      width: 26px;\n      height: 26px;\n    }\n\n\n    /* info card */\n\n    .b80-info {\n      left: 14px;\n      bottom: 16px;\n\n      width: calc(100% - 28px);\n\n      padding: 17px;\n\n      border-radius: 17px;\n    }\n\n    .b80-info h3 {\n      font-size: 21px;\n    }\n\n    .b80-info p {\n      font-size: 13px;\n    }\n\n\n    /* drag hint */\n\n    .b80-hint {\n      bottom: 22px;\n\n      font-size: 11px;\n    }\n\n  }\n\n\n  /* =====================================================\n     REDUCED MOTION\n  ===================================================== */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .b80-hotspot::after {\n      animation: none;\n    }\n\n    .b80-feature-button,\n    .b80-info,\n    .b80-reset {\n      transition: none;\n    }\n\n  }\n</style>\n\n\n\n<section class=\"b80-360\">\n\n  <div class=\"b80-360__inner\">\n\n\n    <!-- =====================================================\n         HEADING\n    ====================================================== -->\n\n    <div class=\"b80-360__heading\">\n\n      <h2 class=\"b80-360__title\">\n        Explore Every Angle.\n      </h2>\n\n      <p class=\"b80-360__intro\">\n        Select an engineering point to move closer, then drag the racket to explore it from any angle.\n      </p>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         SPEC / CAMERA PRESETS\n    ====================================================== -->\n\n    <div class=\"b80-feature-nav\">\n\n\n      <!-- FULL RACKET -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button is-active\"\n\n        data-feature=\"full\"\n\n        data-target=\"0m 0m 0m\"\n        data-orbit=\"0deg 78deg 105%\"\n        data-fov=\"35deg\"\n\n        data-index=\"\"\n        data-title=\"\"\n        data-copy=\"\"\n      >\n        Full Racket\n      </button>\n\n\n\n      <!-- 5.9 MM SHAFT -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"shaft\"\n\n        data-target=\"0m -0.20m 0m\"\n        data-orbit=\"15deg 82deg 58%\"\n        data-fov=\"24deg\"\n\n        data-index=\"01\"\n\n        data-title=\"5.9 MM Shaft\"\n\n        data-copy=\"HNDRD's thinnest professional racket shaft yet, engineered for faster release and sharper handling.\"\n      >\n        5.9 MM Shaft\n      </button>\n\n\n\n      <!-- CURVE² -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"curve\"\n\n        data-target=\"0m 0.48m 0m\"\n        data-orbit=\"-15deg 76deg 62%\"\n        data-fov=\"25deg\"\n\n        data-index=\"02\"\n\n        data-title=\"Curve² Frame\"\n\n        data-copy=\"Refined frame geometry expands the effective sweet spot while maintaining a fast aerodynamic profile.\"\n      >\n        Curve²\n      </button>\n\n\n\n      <!-- CNTRL FOAM -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"cntrl\"\n\n        data-target=\"-0.12m 0.50m 0m\"\n        data-orbit=\"-32deg 77deg 48%\"\n        data-fov=\"22deg\"\n\n        data-index=\"03\"\n\n        data-title=\"CNTRL Foam\"\n\n        data-copy=\"Foam engineered inside the frame helps control unwanted vibration at impact.\"\n      >\n        CNTRL Foam\n      </button>\n\n\n\n      <!-- T FUSE -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"tfuse\"\n\n        data-target=\"0m 0.08m 0m\"\n        data-orbit=\"20deg 80deg 43%\"\n        data-fov=\"20deg\"\n\n        data-index=\"04\"\n\n        data-title=\"T Fuse\"\n\n        data-copy=\"The reinforced racket junction keeps the frame and shaft connection stable through aggressive swings.\"\n      >\n        T Fuse\n      </button>\n\n\n    </div>\n\n\n\n    <!-- =====================================================\n         VIEWER\n    ====================================================== -->\n\n    <div class=\"b80-viewer\">\n\n\n      <!-- TOP CONTROLS -->\n\n      <div class=\"b80-viewer__top\">\n\n        <div class=\"b80-viewer__badge\">\n\n          <span class=\"b80-viewer__badge-dot\"></span>\n\n          INTERACTIVE 360°\n\n        </div>\n\n\n        <button\n          class=\"b80-reset\"\n          type=\"button\"\n          aria-label=\"Return to full racket view\"\n        >\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.7\"\n          >\n            <path d=\"M4.5 8.5A8 8 0 1 1 4 14\"></path>\n            <path d=\"M4.5 4v4.5H9\"></path>\n          </svg>\n\n        </button>\n\n      </div>\n\n\n\n      <!-- =====================================================\n           PUT YOUR GLB URL BELOW\n      ====================================================== -->\n\n      <model-viewer\n        id=\"b80-model\"\n\n        src=\"PASTE-YOUR-RACKET-GLB-URL-HERE\"\n\n        alt=\"Interactive 3D model of the Nitrix 80 Bullet badminton racket\"\n\n        camera-controls\n\n        touch-action=\"pan-y\"\n\n        interaction-prompt=\"none\"\n\n        interpolation-decay=\"90\"\n\n        shadow-intensity=\".7\"\n        shadow-softness=\"1\"\n\n        exposure=\"1.05\"\n\n        camera-orbit=\"0deg 78deg 105%\"\n        camera-target=\"0m 0m 0m\"\n        field-of-view=\"35deg\"\n\n        min-camera-orbit=\"auto 25deg 35%\"\n        max-camera-orbit=\"auto 150deg 220%\"\n\n        min-field-of-view=\"12deg\"\n        max-field-of-view=\"55deg\"\n      >\n\n\n\n        <!-- =====================================================\n             CURVE² HOTSPOT\n        ====================================================== -->\n\n        <button\n          class=\"b80-hotspot\"\n\n          slot=\"hotspot-curve\"\n\n          data-position=\"-0.16m 0.63m 0.02m\"\n          data-normal=\"-0.2m 0.3m 1m\"\n\n          data-feature=\"curve\"\n        >\n\n          <span class=\"b80-hotspot__label\">\n            Curve²\n          </span>\n\n        </button>\n\n\n\n        <!-- =====================================================\n             CNTRL FOAM HOTSPOT\n        ====================================================== -->\n\n        <button\n          class=\"b80-hotspot\"\n\n          slot=\"hotspot-cntrl\"\n\n          data-position=\"0.14m 0.34m 0.025m\"\n          data-normal=\"0.2m 0m 1m\"\n\n          data-feature=\"cntrl\"\n        >\n\n          <span class=\"b80-hotspot__label\">\n            CNTRL Foam\n          </span>\n\n        </button>\n\n\n\n        <!-- =====================================================\n             T FUSE HOTSPOT\n        ====================================================== -->\n\n        <button\n          class=\"b80-hotspot\"\n\n          slot=\"hotspot-tfuse\"\n\n          data-position=\"0m 0.02m 0.03m\"\n          data-normal=\"0m 0m 1m\"\n\n          data-feature=\"tfuse\"\n        >\n\n          <span class=\"b80-hotspot__label\">\n            T Fuse\n          </span>\n\n        </button>\n\n\n\n        <!-- =====================================================\n             SHAFT HOTSPOT\n        ====================================================== -->\n\n        <button\n          class=\"b80-hotspot\"\n\n          slot=\"hotspot-shaft\"\n\n          data-position=\"0m -0.23m 0.025m\"\n          data-normal=\"0m 0m 1m\"\n\n          data-feature=\"shaft\"\n        >\n\n          <span class=\"b80-hotspot__label\">\n            5.9 MM Shaft\n          </span>\n\n        </button>\n\n\n      </model-viewer>\n\n\n\n      <!-- =====================================================\n           INFORMATION PANEL\n      ====================================================== -->\n\n      <div\n        class=\"b80-info\"\n        aria-live=\"polite\"\n      >\n\n        <span class=\"b80-info__index\">\n          01\n        </span>\n\n\n        <h3>\n          5.9 MM Shaft\n        </h3>\n\n\n        <p>\n          Engineered for faster release.\n        </p>\n\n      </div>\n\n\n\n      <!-- =====================================================\n           DRAG HINT\n      ====================================================== -->\n\n      <div class=\"b80-hint\">\n\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n        >\n          <path d=\"M8 8l-4 4 4 4\"></path>\n          <path d=\"M16 8l4 4-4 4\"></path>\n          <path d=\"M4 12h16\"></path>\n        </svg>\n\n        Drag to explore\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<!-- =========================================================\n     MODEL VIEWER\n========================================================= -->\n\n<script\n  type=\"module\"\n  src=\"https://cdn.jsdelivr.net/npm/@google/model-viewer@4.3.0/dist/model-viewer.min.js\">\n</script>\n\n\n\n<script>\n(() => {\n\n  const sections =\n    document.querySelectorAll('.b80-360');\n\n\n  sections.forEach(section => {\n\n    const viewer =\n      section.querySelector('#b80-model');\n\n    const buttons =\n      section.querySelectorAll('.b80-feature-button');\n\n    const hotspots =\n      section.querySelectorAll('.b80-hotspot');\n\n    const info =\n      section.querySelector('.b80-info');\n\n    const infoIndex =\n      info.querySelector('.b80-info__index');\n\n    const infoTitle =\n      info.querySelector('h3');\n\n    const infoCopy =\n      info.querySelector('p');\n\n    const reset =\n      section.querySelector('.b80-reset');\n\n    const hint =\n      section.querySelector('.b80-hint');\n\n\n    if (!viewer) return;\n\n\n\n    /* =====================================================\n       FOCUS CAMERA ON SELECTED FEATURE\n    ====================================================== */\n\n    function focusFeature(button) {\n\n      if (!button) return;\n\n\n      const target =\n        button.dataset.target;\n\n      const orbit =\n        button.dataset.orbit;\n\n      const fov =\n        button.dataset.fov;\n\n      const feature =\n        button.dataset.feature;\n\n\n\n      /* CAMERA TARGET */\n\n      if (target) {\n        viewer.cameraTarget = target;\n      }\n\n\n\n      /* CAMERA ANGLE */\n\n      if (orbit) {\n        viewer.cameraOrbit = orbit;\n      }\n\n\n\n      /* CAMERA ZOOM */\n\n      if (fov) {\n        viewer.fieldOfView = fov;\n      }\n\n\n\n      /* =====================================================\n         ACTIVE SPEC\n      ====================================================== */\n\n      buttons.forEach(item => {\n        item.classList.remove('is-active');\n      });\n\n      button.classList.add('is-active');\n\n\n\n      /* =====================================================\n         HOTSPOT ACTIVE STATE\n      ====================================================== */\n\n      hotspots.forEach(item => {\n        item.classList.remove('is-active');\n      });\n\n\n      const matchingHotspot =\n        section.querySelector(\n          '.b80-hotspot[data-feature=\"' +\n          feature +\n          '\"]'\n        );\n\n\n      if (matchingHotspot) {\n        matchingHotspot.classList.add('is-active');\n      }\n\n\n\n      /* =====================================================\n         FULL RACKET\n      ====================================================== */\n\n      if (feature === 'full') {\n\n        info.classList.remove('is-visible');\n\n        return;\n\n      }\n\n\n\n      /* =====================================================\n         UPDATE INFORMATION\n      ====================================================== */\n\n      infoIndex.textContent =\n        button.dataset.index || '';\n\n      infoTitle.textContent =\n        button.dataset.title || '';\n\n      infoCopy.textContent =\n        button.dataset.copy || '';\n\n\n      info.classList.add('is-visible');\n\n\n      hint.classList.add('is-hidden');\n\n    }\n\n\n\n    /* =====================================================\n       SPEC BUTTON CLICKS\n    ====================================================== */\n\n    buttons.forEach(button => {\n\n      button.addEventListener('click', () => {\n\n        focusFeature(button);\n\n      });\n\n    });\n\n\n\n    /* =====================================================\n       HOTSPOT CLICKS\n    ====================================================== */\n\n    hotspots.forEach(hotspot => {\n\n      hotspot.addEventListener('click', event => {\n\n        event.stopPropagation();\n\n\n        const feature =\n          hotspot.dataset.feature;\n\n\n        const button =\n          section.querySelector(\n            '.b80-feature-button[data-feature=\"' +\n            feature +\n            '\"]'\n          );\n\n\n        focusFeature(button);\n\n      });\n\n    });\n\n\n\n    /* =====================================================\n       RESET\n    ====================================================== */\n\n    reset.addEventListener('click', () => {\n\n      const fullButton =\n        section.querySelector(\n          '.b80-feature-button[data-feature=\"full\"]'\n        );\n\n\n      focusFeature(fullButton);\n\n    });\n\n\n\n    /* =====================================================\n       MANUAL MODEL INTERACTION\n    ====================================================== */\n\n    viewer.addEventListener(\n      'pointerdown',\n      () => {\n\n        hint.classList.add('is-hidden');\n\n      },\n      {\n        once: true\n      }\n    );\n\n\n    viewer.addEventListener(\n      'wheel',\n      () => {\n\n        hint.classList.add('is-hidden');\n\n      },\n      {\n        once: true\n      }\n    );\n\n  });\n\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_aXDi93": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .b80-film {\n    width: 100%;\n    background: #000;\n    color: #fff;\n\n    padding: 105px 24px 115px;\n\n    overflow: hidden;\n\n    /* USE HNDRD / THEME DEFAULT FONT */\n    font-family: inherit;\n  }\n\n  .b80-film,\n  .b80-film * {\n    font-family: inherit;\n  }\n\n\n  /* ================================\n     MAIN CONTAINER\n  ================================= */\n\n  .b80-film__inner {\n    width: 100%;\n    max-width: 1280px;\n\n    margin: 0 auto;\n  }\n\n\n  /* ================================\n     COPY\n  ================================= */\n\n  .b80-film__copy {\n    width: 100%;\n    max-width: 900px;\n\n    margin: 0 auto 64px;\n\n    text-align: center;\n  }\n\n\n  .b80-film__eyebrow {\n    margin: 0 0 15px;\n\n    color: rgba(255,255,255,.42);\n\n    font-size: 12px;\n    font-weight: 500;\n\n    letter-spacing: .13em;\n    text-transform: uppercase;\n\n    text-align: center;\n  }\n\n\n  .b80-film__title {\n    width: 100%;\n    max-width: 850px;\n\n    margin: 0 auto;\n\n    color: #fff;\n\n    font-size: clamp(42px, 4.6vw, 68px);\n    line-height: 1;\n\n    letter-spacing: -.04em;\n\n    font-weight: 600;\n\n    text-align: center;\n  }\n\n\n  .b80-film__description {\n    width: 100%;\n    max-width: 820px;\n\n    margin: 26px auto 0;\n\n    color: rgba(255,255,255,.55);\n\n    font-size: clamp(16px, 1.25vw, 19px);\n    line-height: 1.5;\n\n    font-weight: 400;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  /* ================================\n     VIDEO CONTAINER\n  ================================= */\n\n  .b80-film__video-container {\n    width: 100%;\n    max-width: 1080px;\n\n    margin: 0 auto;\n  }\n\n\n  .b80-film__stage {\n    position: relative;\n\n    width: 100%;\n\n    margin: 0 auto;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    /* NO BORDER */\n    border: none !important;\n    outline: none !important;\n    box-shadow: none !important;\n\n    border-radius: 26px;\n\n    background: #050505;\n\n    isolation: isolate;\n  }\n\n\n  /* NO OVERLAY / NO BORDER EFFECT */\n\n  .b80-film__stage::before {\n    display: none;\n  }\n\n\n  /* ================================\n     VIDEO\n  ================================= */\n\n  .b80-film__video {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: none;\n    outline: none;\n\n    background: #050505;\n  }\n\n\n  /* ================================\n     PLAY / PAUSE\n  ================================= */\n\n  .b80-film__control {\n    position: absolute;\n\n    z-index: 10;\n\n    right: 20px;\n    bottom: 20px;\n\n    width: 48px;\n    height: 48px;\n\n    padding: 0;\n\n    display: grid;\n    place-items: center;\n\n    border: none;\n    outline: none;\n\n    border-radius: 16px;\n\n    background: rgba(255,255,255,.96);\n    color: #090909;\n\n    cursor: pointer;\n\n    transition:\n      transform .2s ease,\n      background .2s ease;\n  }\n\n\n  .b80-film__control:hover {\n    transform: scale(1.04);\n\n    background: #fff;\n  }\n\n\n  .b80-film__control svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  .b80-film__control .pause-icon {\n    display: block;\n  }\n\n\n  .b80-film__control .play-icon {\n    display: none;\n\n    margin-left: 2px;\n  }\n\n\n  .b80-film__control.is-paused .pause-icon {\n    display: none;\n  }\n\n\n  .b80-film__control.is-paused .play-icon {\n    display: block;\n  }\n\n\n  /* ================================\n     WATCH FILM\n  ================================= */\n\n  .b80-film__meta {\n    width: 100%;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    padding-top: 24px;\n  }\n\n\n  .b80-film__watch {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 9px;\n\n    color: rgba(255,255,255,.9);\n\n    font-size: 14px;\n    font-weight: 550;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  .b80-film__watch-icon {\n    width: 21px;\n    height: 21px;\n\n    display: grid;\n    place-items: center;\n\n    border: 1px solid rgba(255,255,255,.42);\n\n    border-radius: 7px;\n\n    color: #fff;\n  }\n\n\n  .b80-film__watch-icon svg {\n    width: 8px;\n    height: 8px;\n\n    margin-left: 1px;\n  }\n\n\n  /* ================================\n     REVEAL ANIMATION\n  ================================= */\n\n  .b80-film__copy,\n  .b80-film__video-container,\n  .b80-film__meta {\n    opacity: 0;\n\n    transform: translateY(22px);\n\n    transition:\n      opacity .9s cubic-bezier(.2,.7,.2,1),\n      transform .9s cubic-bezier(.2,.7,.2,1);\n  }\n\n\n  .b80-film.is-visible .b80-film__copy {\n    opacity: 1;\n\n    transform: translateY(0);\n  }\n\n\n  .b80-film.is-visible .b80-film__video-container {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .10s;\n  }\n\n\n  .b80-film.is-visible .b80-film__meta {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .17s;\n  }\n\n\n  /* ================================\n     MOBILE\n  ================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .b80-film {\n      padding: 72px 14px 80px;\n    }\n\n\n    .b80-film__copy {\n      max-width: 100%;\n\n      margin-bottom: 36px;\n\n      padding: 0 8px;\n    }\n\n\n    .b80-film__eyebrow {\n      margin-bottom: 11px;\n\n      font-size: 10px;\n    }\n\n\n    .b80-film__title {\n      max-width: 390px;\n\n      font-size: clamp(38px, 11vw, 52px);\n\n      line-height: 1.02;\n    }\n\n\n    .b80-film__description {\n      max-width: 390px;\n\n      margin-top: 19px;\n\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n\n    .b80-film__video-container {\n      max-width: 100%;\n    }\n\n\n    .b80-film__stage {\n      aspect-ratio: 16 / 10;\n\n      border-radius: 18px;\n    }\n\n\n    .b80-film__control {\n      width: 42px;\n      height: 42px;\n\n      right: 12px;\n      bottom: 12px;\n\n      border-radius: 14px;\n    }\n\n\n    .b80-film__meta {\n      padding-top: 18px;\n    }\n\n\n    .b80-film__watch {\n      font-size: 13px;\n    }\n\n  }\n\n\n  /* ================================\n     REDUCED MOTION\n  ================================= */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .b80-film__copy,\n    .b80-film__video-container,\n    .b80-film__meta {\n      opacity: 1;\n\n      transform: none;\n\n      transition: none;\n    }\n\n  }\n</style>\n\n\n\n<section class=\"b80-film\">\n\n  <div class=\"b80-film__inner\">\n\n\n    <!-- ==================================\n         CENTERED COPY\n    =================================== -->\n\n    <div class=\"b80-film__copy\">\n\n    \n\n      <h2 class=\"b80-film__title\">\n        Attack in motion.\n      </h2>\n\n\n      <p class=\"b80-film__description\">\n        A razor-thin 5.9 mm shaft built for faster release, sharper handling and explosive response when the rally turns aggressive.\n      </p>\n\n    </div>\n\n\n\n    <!-- ==================================\n         CENTERED VIDEO\n    =================================== -->\n\n    <div class=\"b80-film__video-container\">\n\n      <div class=\"b80-film__stage\">\n\n\n        <!--\n        ==================================\n        ADD YOUR VIDEO HERE\n        ==================================\n        -->\n\n\n        <video\n          class=\"b80-film__video\"\n\n          autoplay\n          muted\n          loop\n          playsinline\n\n          preload=\"metadata\"\n\n          poster=\"PASTE-YOUR-POSTER-IMAGE-URL-HERE\"\n        >\n\n          <source\n            src=\"PASTE-YOUR-VIDEO-URL-HERE\"\n            type=\"video/mp4\"\n          >\n\n        </video>\n\n\n\n        <!-- ==================================\n             PLAY / PAUSE\n        =================================== -->\n\n        <button\n          class=\"b80-film__control\"\n\n          type=\"button\"\n\n          aria-label=\"Pause video\"\n        >\n\n\n          <!-- PAUSE -->\n\n          <svg\n            class=\"pause-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <rect\n              x=\"7\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n\n            <rect\n              x=\"13.5\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n          </svg>\n\n\n\n          <!-- PLAY -->\n\n          <svg\n            class=\"play-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <path\n              d=\"M8 5.5L18 12L8 18.5V5.5Z\"\n            ></path>\n\n          </svg>\n\n\n        </button>\n\n\n      </div>\n\n\n\n      <!-- ==================================\n           WATCH THE FILM\n      =================================== -->\n\n      <div class=\"b80-film__meta\">\n\n        <div class=\"b80-film__watch\">\n\n          Watch the film\n\n\n          <span class=\"b80-film__watch-icon\">\n\n            <svg\n              viewBox=\"0 0 12 12\"\n\n              fill=\"currentColor\"\n            >\n\n              <path\n                d=\"M3.5 2.4L9 6L3.5 9.6V2.4Z\"\n              ></path>\n\n            </svg>\n\n          </span>\n\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<script>\n(() => {\n\n  const sections =\n    document.querySelectorAll('.b80-film');\n\n\n  sections.forEach(section => {\n\n    const video =\n      section.querySelector('.b80-film__video');\n\n    const control =\n      section.querySelector('.b80-film__control');\n\n\n    if (!video || !control) return;\n\n\n\n    /* ================================\n       PLAY / PAUSE\n    ================================= */\n\n    control.addEventListener('click', () => {\n\n      if (video.paused) {\n\n        video.play();\n\n        control.classList.remove('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Pause video'\n        );\n\n      } else {\n\n        video.pause();\n\n        control.classList.add('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Play video'\n        );\n\n      }\n\n    });\n\n\n\n    /* ================================\n       SCROLL REVEAL\n    ================================= */\n\n    const observer =\n      new IntersectionObserver(entries => {\n\n        entries.forEach(entry => {\n\n          if (entry.isIntersecting) {\n\n            section.classList.add('is-visible');\n\n            observer.unobserve(section);\n\n          }\n\n        });\n\n      }, {\n\n        threshold: .12\n\n      });\n\n\n    observer.observe(section);\n\n  });\n\n})();\n</script>",
