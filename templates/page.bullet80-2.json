e:12px !important;\n  }\n\n}\n\n@media(max-width:390px){\n\n  .b80-menu-grid{\n    grid-template-columns:1fr !important;\n  }\n\n  .b80-menu-head h3{\n    font-size:28px !important;\n  }\n\n  .b80-menu-link{\n    min-height:82px !important;\n  }\n\n  .b80-menu-link strong{\n    font-size:15px !important;\n  }\n\n  .b80-menu-link small{\n    font-size:11px !important;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function(){\n\n  const nav =\n    document.getElementById(\n      'b80-nav'\n    );\n\n  const hero =\n    document.getElementById(\n      'b80-hero'\n    );\n\n  const menu =\n    document.getElementById(\n      'b80-menu'\n    );\n\n\n  if(\n    !nav ||\n    !hero ||\n    !menu\n  ){\n    return;\n  }\n\n\n  /*\n  MOVE NAV + MENU TO BODY\n\n  This makes them global and prevents\n  the Shopify section from clipping them.\n  */\n\n  document.body.appendChild(\n    nav\n  );\n\n  document.body.appendChild(\n    menu\n  );\n\n\n  const explore =\n    nav.querySelector(\n      '.b80-product-explore'\n    );\n\n  const close =\n    menu.querySelector(\n      '.b80-menu-close'\n    );\n\n\n  const scrollHint =\n    hero.querySelector(\n      '.b80-scroll'\n    );\n\n\n  let menuOpen = false;\n\n  let trackingUntil = 0;\n\n  let rafBusy = false;\n\n\n  /*\n  SHOPIFY HEADER SELECTORS\n  */\n\n  const headerSelectors = [\n\n    '#shopify-section-header',\n\n    '.shopify-section-header-sticky',\n\n    'sticky-header',\n\n    '.header-wrapper',\n\n    '.section-header',\n\n    '.shopify-section-group-header-group',\n\n    'header.header'\n\n  ];\n\n\n  /*\n  FIND ACTUAL VISIBLE BOTTOM\n  OF SHOPIFY STICKY HEADER\n  */\n\n  function headerBottom(){\n\n    let bottom = 0;\n\n    const seen =\n      new Set();\n\n\n    headerSelectors\n    .forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              seen.has(\n                element\n              )\n            ){\n              return;\n            }\n\n\n            if(\n              element === nav ||\n              element.contains(nav)\n            ){\n              return;\n            }\n\n\n            seen.add(\n              element\n            );\n\n\n            const rect =\n              element\n              .getBoundingClientRect();\n\n\n            const style =\n              getComputedStyle(\n                element\n              );\n\n\n            if(\n              style.display ===\n              'none' ||\n\n              style.visibility ===\n              'hidden' ||\n\n              Number(\n                style.opacity\n              ) === 0 ||\n\n              rect.height < 2 ||\n\n              rect.height > 220 ||\n\n              rect.bottom <= 0 ||\n\n              rect.top >= 220\n            ){\n              return;\n            }\n\n\n            bottom =\n              Math.max(\n                bottom,\n                rect.bottom\n              );\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n    return Math.max(\n      0,\n\n      Math.min(\n        bottom,\n        220\n      )\n    );\n\n  }\n\n\n  /*\n  KEEP BULLET BAR UNDER\n  SHOPIFY HEADER\n  */\n\n  function positionNav(){\n\n    const gap =\n      window.innerWidth <= 750\n      ? 8\n      : 10;\n\n\n    const top =\n      Math.round(\n        headerBottom() +\n        gap\n      );\n\n\n    document\n    .documentElement\n    .style\n    .setProperty(\n\n      '--b80-top',\n\n      top + 'px'\n\n    );\n\n  }\n\n\n  /*\n  HERO NAV -> PRODUCT NAV\n  */\n\n  function updateState(){\n\n    const rect =\n      hero\n      .getBoundingClientRect();\n\n\n    const product =\n      rect.bottom <=\n      window.innerHeight * .34;\n\n\n    nav\n    .classList\n    .toggle(\n      'is-product',\n      product\n    );\n\n\n    /*\n    SCROLL TO ENGAGE\n\n    Hide it once the user moves into\n    the next section. When the user\n    scrolls back into the hero, it\n    automatically appears again.\n    */\n\n    if(scrollHint){\n\n      const hideScrollHint =\n        rect.bottom <=\n        window.innerHeight * .72;\n\n      scrollHint\n      .classList\n      .toggle(\n        'is-hidden',\n        hideScrollHint\n      );\n\n    }\n\n\n    /*\n    MENU ONLY BELONGS TO\n    BUY NOW PRODUCT BAR\n    */\n\n    if(\n      !product &&\n      menuOpen\n    ){\n      closeMenu();\n    }\n\n  }\n\n\n  /*\n  POSITION MENU DIRECTLY\n  UNDER PRODUCT BAR\n  */\n\n  function positionMenu(){\n\n    const navRect =\n      nav\n      .getBoundingClientRect();\n\n\n    const buttonRect =\n      explore\n      .getBoundingClientRect();\n\n\n    const width =\n\n      window.innerWidth <= 750\n\n      ? window.innerWidth - 16\n\n      : Math.min(\n          900,\n          window.innerWidth - 32\n        );\n\n\n    const left =\n      (\n        window.innerWidth -\n        width\n      ) / 2;\n\n\n    /*\n    CONNECTOR POINT\n    DIRECTLY UNDER EXPLORE\n    */\n\n    const neck =\n\n      Math.max(\n\n        42,\n\n        Math.min(\n\n          width - 42,\n\n          buttonRect.left +\n          buttonRect.width / 2 -\n          left\n\n        )\n\n      );\n\n\n    menu.style.width =\n      width + 'px';\n\n\n    menu.style.top =\n      (\n        navRect.bottom +\n        9\n      ) + 'px';\n\n\n    menu.style.maxHeight =\n\n      Math.max(\n\n        240,\n\n        window.innerHeight -\n        navRect.bottom -\n        21\n\n      ) + 'px';\n\n\n    menu.style.setProperty(\n\n      '--b80-neck',\n\n      neck + 'px'\n\n    );\n\n  }\n\n\n  /*\n  SMALL BUTTON JUMP\n  */\n\n  function jump(){\n\n    explore\n    .classList\n    .remove(\n      'b80-menu-jump'\n    );\n\n\n    void explore.offsetWidth;\n\n\n    explore\n    .classList\n    .add(\n      'b80-menu-jump'\n    );\n\n\n    setTimeout(\n      function(){\n\n        explore\n        .classList\n        .remove(\n          'b80-menu-jump'\n        );\n\n      },\n      450\n    );\n\n  }\n\n\n  /*\n  OPEN MENU\n  */\n\n  function openMenu(){\n\n    if(\n      !nav\n      .classList\n      .contains(\n        'is-product'\n      )\n    ){\n      return;\n    }\n\n\n    jump();\n\n    positionNav();\n\n    positionMenu();\n\n\n    menu\n    .classList\n    .add(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'false'\n    );\n\n\n    explore.setAttribute(\n      'aria-expanded',\n      'true'\n    );\n\n\n    menuOpen = true;\n\n  }\n\n\n  /*\n  CLOSE MENU\n  */\n\n  function closeMenu(){\n\n    menu\n    .classList\n    .remove(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'true'\n    );\n\n\n    explore.setAttribute(\n      'aria-expanded',\n      'false'\n    );\n\n\n    menuOpen = false;\n\n  }\n\n\n  /*\n  ONLY THIS EXPLORE\n  OPENS THE MENU\n  */\n\n  explore\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      event.preventDefault();\n\n      event.stopPropagation();\n\n\n      if(menuOpen){\n\n        jump();\n\n        closeMenu();\n\n      }\n\n      else{\n\n        openMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  CLOSE X\n  */\n\n  close\n  .addEventListener(\n    'click',\n    closeMenu\n  );\n\n\n  /*\n  MENU SECTION LINKS\n  */\n\n  menu\n  .querySelectorAll(\n    'a[href^=\"#\"]'\n  )\n  .forEach(\n    function(link){\n\n\n      link\n      .addEventListener(\n        'click',\n        function(event){\n\n\n          event.preventDefault();\n\n\n          let target =\n            null;\n\n\n          const href =\n            link.getAttribute(\n              'href'\n            );\n\n\n          try{\n\n            target =\n              document\n              .querySelector(\n                href\n              );\n\n          }\n\n          catch(error){}\n\n\n          /*\n          UNTIL YOUR FINAL SECTION IDS\n          EXIST, FALL BACK TO #bullet-next\n          */\n\n          if(\n            !target &&\n            link.dataset.fallback\n          ){\n\n            try{\n\n              target =\n                document\n                .querySelector(\n                  link.dataset.fallback\n                );\n\n            }\n\n            catch(error){}\n\n          }\n\n\n          closeMenu();\n\n\n          if(target){\n\n            setTimeout(\n              function(){\n\n                target\n                .scrollIntoView({\n                  behavior:'smooth',\n                  block:'start'\n                });\n\n              },\n              100\n            );\n\n          }\n\n\n        }\n      );\n\n\n    }\n  );\n\n\n  /*\n  CLICK OUTSIDE\n  */\n\n  document\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      if(\n        menuOpen &&\n        !menu.contains(\n          event.target\n        ) &&\n        !explore.contains(\n          event.target\n        )\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  ESCAPE\n  */\n\n  document\n  .addEventListener(\n    'keydown',\n    function(event){\n\n\n      if(\n        event.key ===\n        'Escape'\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  STANDARD RAF UPDATE\n  */\n\n  function update(){\n\n    positionNav();\n\n    updateState();\n\n\n    if(menuOpen){\n      positionMenu();\n    }\n\n\n    rafBusy = false;\n\n  }\n\n\n  function requestUpdate(){\n\n    if(rafBusy){\n      return;\n    }\n\n\n    rafBusy = true;\n\n\n    requestAnimationFrame(\n      update\n    );\n\n  }\n\n\n  /*\n  CONTINUOUS TRACKING DURING\n  SHOPIFY HEADER SLIDE\n  */\n\n  function track(\n    milliseconds\n  ){\n\n    trackingUntil =\n      Math.max(\n\n        trackingUntil,\n\n        performance.now() +\n        milliseconds\n\n      );\n\n\n    requestAnimationFrame(\n      follow\n    );\n\n  }\n\n\n  function follow(){\n\n    positionNav();\n\n    updateState();\n\n\n    if(menuOpen){\n      positionMenu();\n    }\n\n\n    if(\n      performance.now() <\n      trackingUntil\n    ){\n\n      requestAnimationFrame(\n        follow\n      );\n\n    }\n\n  }\n\n\n  /*\n  SCROLL\n  */\n\n  window\n  .addEventListener(\n    'scroll',\n    function(){\n\n      requestUpdate();\n\n      /*\n      Keeps tracking while the Shopify\n      sticky header animates down/up.\n      */\n\n      track(\n        700\n      );\n\n    },\n    {\n      passive:true\n    }\n  );\n\n\n  /*\n  RESIZE\n  */\n\n  window\n  .addEventListener(\n    'resize',\n    function(){\n\n      requestUpdate();\n\n      track(\n        500\n      );\n\n    }\n  );\n\n\n  /*\n  WATCH HEADER HEIGHT CHANGES\n  */\n\n  if(\n    'ResizeObserver'\n    in window\n  ){\n\n    const observer =\n      new ResizeObserver(\n        function(){\n\n          track(\n            500\n          );\n\n        }\n      );\n\n\n    headerSelectors\n    .forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              element !== nav &&\n              !element.contains(nav)\n            ){\n\n              observer.observe(\n                element\n              );\n\n            }\n\n\n          }\n        );\n\n\n      }\n    );\n\n  }\n\n\n  /*\n  INITIAL LOAD\n  */\n\n  positionNav();\n\n  updateState();\n\n\n  /*\n  Shopify header initializes\n  after page render, so keep\n  watching initially.\n  */\n\n  track(\n    1500\n  );\n\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_6T9YpH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .bullet-xiaomi-wrap {\n    background: #000000;\n    width: 100%;\n    padding: 80px 20px;\n  }\n\n  .bullet-xiaomi-grid {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n\n    grid-template-rows:\n      330px\n      300px\n      145px\n      145px;\n\n    gap: 16px;\n  }\n\n\n  /* =========================================\n     BASIC CARD\n  ========================================= */\n\n  .bx-card {\n    position: relative;\n\n    overflow: hidden;\n\n    border-radius: 24px;\n\n    background: #03050a;\n\n    isolation: isolate;\n  }\n\n\n  .bx-picture {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    z-index: 0;\n  }\n\n\n  .bx-picture img {\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n\n  .bx-card::after {\n    content: \"\";\n\n    position: absolute;\n    inset: 0;\n\n    z-index: 1;\n\n    pointer-events: none;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0,0,0,.10) 0%,\n        rgba(0,0,0,0) 55%,\n        rgba(0,0,0,.10) 100%\n      );\n  }\n\n\n\n  /* =========================================\n     DESKTOP GRID\n  ========================================= */\n\n\n  /* LARGE TOP CARD */\n\n  .bx-card-1 {\n    grid-column: 1 / 3;\n    grid-row: 1;\n  }\n\n\n  /* SECOND ROW */\n\n  .bx-card-2 {\n    grid-column: 1;\n    grid-row: 2;\n  }\n\n\n  .bx-card-3 {\n    grid-column: 2;\n    grid-row: 2;\n  }\n\n\n  /* LARGE TALL LEFT */\n\n  .bx-card-4 {\n    grid-column: 1;\n    grid-row: 3 / 5;\n  }\n\n\n  /* SMALL RIGHT */\n\n  .bx-card-5 {\n    grid-column: 2;\n    grid-row: 3;\n  }\n\n\n  .bx-card-6 {\n    grid-column: 2;\n    grid-row: 4;\n  }\n\n\n\n  /* =========================================\n     TEXT\n  ========================================= */\n\n  .bx-copy {\n    position: absolute;\n\n    z-index: 5;\n\n    color: #ffffff;\n\n    pointer-events: none;\n  }\n\n\n  .bx-copy h3 {\n    padding: 0;\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 25px;\n    line-height: 1.05;\n\n    font-weight: 650;\n\n    letter-spacing: -0.03em;\n  }\n\n\n  .bx-copy p {\n    padding: 0;\n\n    margin: 9px 0 0;\n\n    color: rgba(255,255,255,.62);\n\n    font-size: 15px;\n    line-height: 1.35;\n\n    font-weight: 400;\n  }\n\n\n\n  /* =========================================\n     TEXT POSITIONS\n  ========================================= */\n\n  .bx-top-left {\n    left: 6%;\n    top: 8%;\n  }\n\n\n  .bx-top-right {\n    right: 6%;\n    top: 8%;\n  }\n\n\n  .bx-center-right {\n    right: 8%;\n    top: 50%;\n\n    transform: translateY(-50%);\n  }\n\n\n  .bx-center-left {\n    left: 8%;\n    top: 50%;\n\n    transform: translateY(-50%);\n  }\n\n\n  .bx-bottom-left {\n    left: 6%;\n    bottom: 8%;\n  }\n\n\n  .bx-bottom-right {\n    right: 6%;\n    bottom: 8%;\n  }\n\n\n\n  /* =========================================\n     TOP CARD\n  ========================================= */\n\n  .bx-card-1 .bx-copy {\n    max-width: 340px;\n  }\n\n\n  .bx-card-1 .bx-copy h3 {\n    font-size: 29px;\n  }\n\n\n  .bx-card-1 .bx-copy p {\n    font-size: 17px;\n  }\n\n\n\n  /* =========================================\n     SMALL RIGHT CARDS\n  ========================================= */\n\n  .bx-card-5 .bx-copy,\n  .bx-card-6 .bx-copy {\n    max-width: 44%;\n  }\n\n\n  .bx-card-5 .bx-copy h3,\n  .bx-card-6 .bx-copy h3 {\n    font-size: 20px;\n  }\n\n\n  .bx-card-5 .bx-copy p,\n  .bx-card-6 .bx-copy p {\n    font-size: 12px;\n\n    margin-top: 6px;\n  }\n\n\n\n  /* =========================================\n     TABLET\n  ========================================= */\n\n  @media screen and (max-width: 990px) and (min-width: 750px) {\n\n    .bullet-xiaomi-grid {\n      max-width: 760px;\n\n      grid-template-rows:\n        260px\n        250px\n        130px\n        130px;\n    }\n\n\n    .bx-card {\n      border-radius: 20px;\n    }\n\n\n    .bx-copy h3 {\n      font-size: 20px;\n    }\n\n\n    .bx-copy p {\n      font-size: 13px;\n    }\n\n  }\n\n\n\n  /* =========================================\n     MOBILE\n     XIAOMI STYLE LAYOUT\n  ========================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .bullet-xiaomi-wrap {\n      padding: 30px 12px;\n    }\n\n\n    .bullet-xiaomi-grid {\n      width: 100%;\n      max-width: 430px;\n\n      margin: 0 auto;\n\n      display: grid;\n\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n\n\n      /*\n        MOBILE STRUCTURE\n\n        CARD 1   = 310px\n        CARD 2/3 = 345px\n        CARD 4/5 = 345px\n        CARD 6   = 225px\n      */\n\n      grid-template-rows:\n        310px\n        345px\n        345px\n        225px;\n\n      gap: 10px;\n    }\n\n\n    .bx-card {\n      min-height: 0;\n\n      border-radius: 15px;\n    }\n\n\n\n    /* =========================================\n       MOBILE GRID POSITIONS\n    ========================================= */\n\n\n    /* FULL WIDTH TOP */\n\n    .bx-card-1 {\n      grid-column: 1 / 3;\n      grid-row: 1;\n    }\n\n\n    /* TWO TALL CARDS */\n\n    .bx-card-2 {\n      grid-column: 1;\n      grid-row: 2;\n    }\n\n\n    .bx-card-3 {\n      grid-column: 2;\n      grid-row: 2;\n    }\n\n\n    /* NEXT TWO TALL CARDS */\n\n    .bx-card-4 {\n      grid-column: 1;\n      grid-row: 3;\n    }\n\n\n    .bx-card-5 {\n      grid-column: 2;\n      grid-row: 3;\n    }\n\n\n    /* FULL WIDTH BOTTOM */\n\n    .bx-card-6 {\n      grid-column: 1 / 3;\n      grid-row: 4;\n    }\n\n\n\n    /* =========================================\n       MOBILE IMAGE POSITION\n    ========================================= */\n\n    .bx-picture img {\n      object-position: center;\n    }\n\n\n\n    /* =========================================\n       MOBILE TEXT\n    ========================================= */\n\n    .bx-copy {\n      transform: none;\n\n      max-width: none;\n    }\n\n\n    .bx-top-left,\n    .bx-center-left,\n    .bx-bottom-left {\n      left: 18px;\n      right: auto;\n    }\n\n\n    .bx-top-right,\n    .bx-center-right,\n    .bx-bottom-right {\n      left: 18px;\n      right: auto;\n    }\n\n\n    /*\n      Xiaomi style:\n      text sits near top instead of floating\n      around unpredictably.\n    */\n\n    .bx-copy,\n    .bx-top-left,\n    .bx-top-right,\n    .bx-center-left,\n    .bx-center-right,\n    .bx-bottom-left,\n    .bx-bottom-right {\n      top: 22px;\n      bottom: auto;\n\n      transform: none;\n    }\n\n\n\n    /* CARD 1 */\n\n    .bx-card-1 .bx-copy {\n      left: 24px;\n\n      top: 26px;\n\n      max-width: 58%;\n    }\n\n\n    .bx-card-1 .bx-copy h3 {\n      font-size: 20px;\n      line-height: 1.05;\n    }\n\n\n    .bx-card-1 .bx-copy p {\n      margin-top: 8px;\n\n      font-size: 13px;\n      line-height: 1.35;\n    }\n\n\n\n    /* HALF WIDTH TALL CARDS */\n\n    .bx-card-2 .bx-copy,\n    .bx-card-3 .bx-copy,\n    .bx-card-4 .bx-copy,\n    .bx-card-5 .bx-copy {\n      left: 18px;\n      right: 14px;\n\n      top: 28px;\n\n      max-width: calc(100% - 32px);\n    }\n\n\n    .bx-card-2 .bx-copy h3,\n    .bx-card-3 .bx-copy h3,\n    .bx-card-4 .bx-copy h3,\n    .bx-card-5 .bx-copy h3 {\n      font-size: 16px;\n\n      line-height: 1.05;\n    }\n\n\n    .bx-card-2 .bx-copy p,\n    .bx-card-3 .bx-copy p,\n    .bx-card-4 .bx-copy p,\n    .bx-card-5 .bx-copy p {\n      margin-top: 10px;\n\n      font-size: 12px;\n\n      line-height: 1.3;\n    }\n\n\n\n    /* BOTTOM FULL WIDTH */\n\n    .bx-card-6 .bx-copy {\n      left: 24px;\n\n      top: 28px;\n\n      max-width: 55%;\n    }\n\n\n    .bx-card-6 .bx-copy h3 {\n      font-size: 19px;\n    }\n\n\n    .bx-card-6 .bx-copy p {\n      margin-top: 8px;\n\n      font-size: 12px;\n    }\n\n  }\n\n\n\n  /* =========================================\n     SMALL MOBILE\n  ========================================= */\n\n  @media screen and (max-width: 390px) {\n\n    .bullet-xiaomi-grid {\n      grid-template-rows:\n        285px\n        320px\n        320px\n        205px;\n\n      gap: 8px;\n    }\n\n\n    .bx-card {\n      border-radius: 13px;\n    }\n\n\n    .bx-card-2 .bx-copy,\n    .bx-card-3 .bx-copy,\n    .bx-card-4 .bx-copy,\n    .bx-card-5 .bx-copy {\n      left: 15px;\n      right: 12px;\n    }\n\n\n    .bx-card-2 .bx-copy h3,\n    .bx-card-3 .bx-copy h3,\n    .bx-card-4 .bx-copy h3,\n    .bx-card-5 .bx-copy h3 {\n      font-size: 15px;\n    }\n\n\n    .bx-card-2 .bx-copy p,\n    .bx-card-3 .bx-copy p,\n    .bx-card-4 .bx-copy p,\n    .bx-card-5 .bx-copy p {\n      font-size: 11px;\n    }\n\n  }\n\n</style>\n\n\n\n<div class=\"bullet-xiaomi-wrap\">\n\n  <div class=\"bullet-xiaomi-grid\">\n\n\n\n    <!-- =========================================\n         CARD 1\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-1\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-1-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-1-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          5.9 MM SHAFT\n        </h3>\n\n        <p>\n          Built for faster release.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 2\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-2\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-2-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-2-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          CNTRL Foam.\n        </h3>\n\n        <p>\n          Shock stops here.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 3\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-3\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-3-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-3-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          Curve² Frame.\n        </h3>\n\n        <p>\n          Sweet spot expanded.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 4\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-4\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-4-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-4-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          M46X Carbon Fibre\n        </h3>\n\n        <p>\n          Engineered for attacking response.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 5\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-5\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-5-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-5-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Attack Ready\n        </h3>\n\n        <p>\n          Power on a hair trigger.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================================\n         CARD 6\n    ========================================== -->\n\n    <div class=\"bx-card bx-card-6\">\n\n\n      <picture class=\"bx-picture\">\n\n        <!-- MOBILE IMAGE -->\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"PASTE-MOBILE-IMAGE-6-URL-HERE\"\n        >\n\n\n        <!-- DESKTOP IMAGE -->\n        <img\n          src=\"PASTE-DESKTOP-IMAGE-6-URL-HERE\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </picture>\n\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Built Faster\n        </h3>\n\n        <p>\n          Ready for the next shot.\n        </p>\n\n      </div>\n\n    </div>\n\n\n  </div>\n\n</div>",
