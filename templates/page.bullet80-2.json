      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .b80-film {\n    width: 100%;\n    background: #000;\n    color: #fff;\n\n    padding: 105px 24px 115px;\n\n    overflow: hidden;\n\n    /* USE HNDRD / THEME DEFAULT FONT */\n    font-family: inherit;\n  }\n\n  .b80-film,\n  .b80-film * {\n    font-family: inherit;\n  }\n\n\n  /* ================================\n     MAIN CONTAINER\n  ================================= */\n\n  .b80-film__inner {\n    width: 100%;\n    max-width: 1280px;\n\n    margin: 0 auto;\n  }\n\n\n  /* ================================\n     COPY\n  ================================= */\n\n  .b80-film__copy {\n    width: 100%;\n    max-width: 900px;\n\n    margin: 0 auto 64px;\n\n    text-align: center;\n  }\n\n\n  .b80-film__eyebrow {\n    margin: 0 0 15px;\n\n    color: rgba(255,255,255,.42);\n\n    font-size: 12px;\n    font-weight: 500;\n\n    letter-spacing: .13em;\n    text-transform: uppercase;\n\n    text-align: center;\n  }\n\n\n  .b80-film__title {\n    width: 100%;\n    max-width: 850px;\n\n    margin: 0 auto;\n\n    color: #fff;\n\n    font-size: clamp(42px, 4.6vw, 68px);\n    line-height: 1;\n\n    letter-spacing: -.04em;\n\n    font-weight: 600;\n\n    text-align: center;\n  }\n\n\n  .b80-film__description {\n    width: 100%;\n    max-width: 820px;\n\n    margin: 26px auto 0;\n\n    color: rgba(255,255,255,.55);\n\n    font-size: clamp(16px, 1.25vw, 19px);\n    line-height: 1.5;\n\n    font-weight: 400;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  /* ================================\n     VIDEO CONTAINER\n  ================================= */\n\n  .b80-film__video-container {\n    width: 100%;\n    max-width: 1080px;\n\n    margin: 0 auto;\n  }\n\n\n  .b80-film__stage {\n    position: relative;\n\n    width: 100%;\n\n    margin: 0 auto;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    /* NO BORDER */\n    border: none !important;\n    outline: none !important;\n    box-shadow: none !important;\n\n    border-radius: 26px;\n\n    background: #050505;\n\n    isolation: isolate;\n  }\n\n\n  /* NO OVERLAY / NO BORDER EFFECT */\n\n  .b80-film__stage::before {\n    display: none;\n  }\n\n\n  /* ================================\n     VIDEO\n  ================================= */\n\n  .b80-film__video {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: none;\n    outline: none;\n\n    background: #050505;\n  }\n\n\n  /* ================================\n     PLAY / PAUSE\n  ================================= */\n\n  .b80-film__control {\n    position: absolute;\n\n    z-index: 10;\n\n    right: 20px;\n    bottom: 20px;\n\n    width: 48px;\n    height: 48px;\n\n    padding: 0;\n\n    display: grid;\n    place-items: center;\n\n    border: none;\n    outline: none;\n\n    border-radius: 16px;\n\n    background: rgba(255,255,255,.96);\n    color: #090909;\n\n    cursor: pointer;\n\n    transition:\n      transform .2s ease,\n      background .2s ease;\n  }\n\n\n  .b80-film__control:hover {\n    transform: scale(1.04);\n\n    background: #fff;\n  }\n\n\n  .b80-film__control svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  .b80-film__control .pause-icon {\n    display: block;\n  }\n\n\n  .b80-film__control .play-icon {\n    display: none;\n\n    margin-left: 2px;\n  }\n\n\n  .b80-film__control.is-paused .pause-icon {\n    display: none;\n  }\n\n\n  .b80-film__control.is-paused .play-icon {\n    display: block;\n  }\n\n\n  /* ================================\n     WATCH FILM\n  ================================= */\n\n  .b80-film__meta {\n    width: 100%;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    padding-top: 24px;\n  }\n\n\n  .b80-film__watch {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 9px;\n\n    color: rgba(255,255,255,.9);\n\n    font-size: 14px;\n    font-weight: 550;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  .b80-film__watch-icon {\n    width: 21px;\n    height: 21px;\n\n    display: grid;\n    place-items: center;\n\n    border: 1px solid rgba(255,255,255,.42);\n\n    border-radius: 7px;\n\n    color: #fff;\n  }\n\n\n  .b80-film__watch-icon svg {\n    width: 8px;\n    height: 8px;\n\n    margin-left: 1px;\n  }\n\n\n  /* ================================\n     REVEAL ANIMATION\n  ================================= */\n\n  .b80-film__copy,\n  .b80-film__video-container,\n  .b80-film__meta {\n    opacity: 0;\n\n    transform: translateY(22px);\n\n    transition:\n      opacity .9s cubic-bezier(.2,.7,.2,1),\n      transform .9s cubic-bezier(.2,.7,.2,1);\n  }\n\n\n  .b80-film.is-visible .b80-film__copy {\n    opacity: 1;\n\n    transform: translateY(0);\n  }\n\n\n  .b80-film.is-visible .b80-film__video-container {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .10s;\n  }\n\n\n  .b80-film.is-visible .b80-film__meta {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .17s;\n  }\n\n\n  /* ================================\n     MOBILE\n  ================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .b80-film {\n      padding: 72px 14px 80px;\n    }\n\n\n    .b80-film__copy {\n      max-width: 100%;\n\n      margin-bottom: 36px;\n\n      padding: 0 8px;\n    }\n\n\n    .b80-film__eyebrow {\n      margin-bottom: 11px;\n\n      font-size: 10px;\n    }\n\n\n    .b80-film__title {\n      max-width: 390px;\n\n      font-size: clamp(38px, 11vw, 52px);\n\n      line-height: 1.02;\n    }\n\n\n    .b80-film__description {\n      max-width: 390px;\n\n      margin-top: 19px;\n\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n\n    .b80-film__video-container {\n      max-width: 100%;\n    }\n\n\n    .b80-film__stage {\n      aspect-ratio: 16 / 10;\n\n      border-radius: 18px;\n    }\n\n\n    .b80-film__control {\n      width: 42px;\n      height: 42px;\n\n      right: 12px;\n      bottom: 12px;\n\n      border-radius: 14px;\n    }\n\n\n    .b80-film__meta {\n      padding-top: 18px;\n    }\n\n\n    .b80-film__watch {\n      font-size: 13px;\n    }\n\n  }\n\n\n  /* ================================\n     REDUCED MOTION\n  ================================= */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .b80-film__copy,\n    .b80-film__video-container,\n    .b80-film__meta {\n      opacity: 1;\n\n      transform: none;\n\n      transition: none;\n    }\n\n  }\n</style>\n\n\n\n<section class=\"b80-film\">\n\n  <div class=\"b80-film__inner\">\n\n\n    <!-- ==================================\n         CENTERED COPY\n    =================================== -->\n\n    <div class=\"b80-film__copy\">\n\n    \n\n      <h2 class=\"b80-film__title\">\n        Attack in motion.\n      </h2>\n\n\n      <p class=\"b80-film__description\">\n        A razor-thin 5.9 mm shaft built for faster release, sharper handling and explosive response when the rally turns aggressive.\n      </p>\n\n    </div>\n\n\n\n    <!-- ==================================\n         CENTERED VIDEO\n    =================================== -->\n\n    <div class=\"b80-film__video-container\">\n\n      <div class=\"b80-film__stage\">\n\n\n        <!--\n        ==================================\n        ADD YOUR VIDEO HERE\n        ==================================\n        -->\n\n\n        <video\n          class=\"b80-film__video\"\n\n          autoplay\n          muted\n          loop\n          playsinline\n\n          preload=\"metadata\"\n\n          poster=\"PASTE-YOUR-POSTER-IMAGE-URL-HERE\"\n        >\n\n          <source\n            src=\"PASTE-YOUR-VIDEO-URL-HERE\"\n            type=\"video/mp4\"\n          >\n\n        </video>\n\n\n\n        <!-- ==================================\n             PLAY / PAUSE\n        =================================== -->\n\n        <button\n          class=\"b80-film__control\"\n\n          type=\"button\"\n\n          aria-label=\"Pause video\"\n        >\n\n\n          <!-- PAUSE -->\n\n          <svg\n            class=\"pause-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <rect\n              x=\"7\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n\n            <rect\n              x=\"13.5\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n          </svg>\n\n\n\n          <!-- PLAY -->\n\n          <svg\n            class=\"play-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <path\n              d=\"M8 5.5L18 12L8 18.5V5.5Z\"\n            ></path>\n\n          </svg>\n\n\n        </button>\n\n\n      </div>\n\n\n\n      <!-- ==================================\n           WATCH THE FILM\n      =================================== -->\n\n      <div class=\"b80-film__meta\">\n\n        <div class=\"b80-film__watch\">\n\n          Watch the film\n\n\n          <span class=\"b80-film__watch-icon\">\n\n            <svg\n              viewBox=\"0 0 12 12\"\n\n              fill=\"currentColor\"\n            >\n\n              <path\n                d=\"M3.5 2.4L9 6L3.5 9.6V2.4Z\"\n              ></path>\n\n            </svg>\n\n          </span>\n\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<script>\n(() => {\n\n  const sections =\n    document.querySelectorAll('.b80-film');\n\n\n  sections.forEach(section => {\n\n    const video =\n      section.querySelector('.b80-film__video');\n\n    const control =\n      section.querySelector('.b80-film__control');\n\n\n    if (!video || !control) return;\n\n\n\n    /* ================================\n       PLAY / PAUSE\n    ================================= */\n\n    control.addEventListener('click', () => {\n\n      if (video.paused) {\n\n        video.play();\n\n        control.classList.remove('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Pause video'\n        );\n\n      } else {\n\n        video.pause();\n\n        control.classList.add('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Play video'\n        );\n\n      }\n\n    });\n\n\n\n    /* ================================\n       SCROLL REVEAL\n    ================================= */\n\n    const observer =\n      new IntersectionObserver(entries => {\n\n        entries.forEach(entry => {\n\n          if (entry.isIntersecting) {\n\n            section.classList.add('is-visible');\n\n            observer.unobserve(section);\n\n          }\n\n        });\n\n      }, {\n\n        threshold: .12\n\n      });\n\n\n    observer.observe(section);\n\n  });\n\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_kjREq7": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET\nPREMIUM ENGINEERING GRID\n{% endcomment %}\n\n{% assign b80_shaft_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Screenshot_2026-08-14_at_6.06.56_PM.png?v=1786711037' %}\n{% assign b80_curve_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Sweet_Spot.png?v=1786709949' %}\n{% assign b80_foam_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Cntrl_Foam.png?v=1786709950' %}\n{% assign b80_tfuse_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/T_Fuse_without_String.png?v=1786709947' %}\n{% assign b80_hyper_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Woven_to_Whip.png?v=1786709948' %}\n{% assign b80_carbon_img = '' %}\n\n<section class=\"b80-upgrade\">\n\n  <div class=\"b80-upgrade__shell\">\n\n    <div class=\"b80-upgrade__head\">\n\n      <div class=\"b80-upgrade__headline\">\n        <h2>\n          Built to attack.<br>\n          Engineered to hold.\n        </h2>\n      </div>\n\n      <div class=\"b80-upgrade__intro\">\n        <span>NITRIX 80 BULLET</span>\n\n        <p>\n          Six engineering decisions working together\n          to make every swing faster, cleaner and harder to contain.\n        </p>\n      </div>\n\n    </div>\n\n\n    <div class=\"b80-upgrade__grid\">\n\n\n      <!-- 01 / 5.9MM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--shaft\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            VAPORSHAFT\n          </span>\n\n          <h3>\n            Just\n            <strong>5.9mm.</strong>\n          </h3>\n\n          <p>\n            The thinnest shaft HNDRD has ever made.\n            Built to whip through the swing and stay stable at contact.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_shaft_img != blank %}\n\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Screenshot_2026-08-14_at_6.06.56_PM.png?v=1786711037\"\n              alt=\"Nitrix 80 Bullet 5.9mm VaporShaft\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__shaft-demo\">\n\n              <div class=\"b80-upgrade__shaft-line\"></div>\n\n              <div class=\"b80-upgrade__measure\">\n                <span></span>\n\n                <div>\n                  <strong>5.9</strong>\n                  <small>MM</small>\n                </div>\n\n                <span></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 02 / CURVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--curve\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CURVE²\n          </span>\n\n          <h3>\n            Sweet spot.<br>\n            Expanded.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_curve_img != blank %}\n\n            <img\n              src=\"{{ b80_curve_img }}\"\n              alt=\"Nitrix 80 Bullet Curve² Frame\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__curve-demo\">\n\n              <span class=\"b80-upgrade__ring ring-a\"></span>\n              <span class=\"b80-upgrade__ring ring-b\"></span>\n              <span class=\"b80-upgrade__ring ring-c\"></span>\n\n              <div class=\"b80-upgrade__sweet\">\n                <small>EXPANDED</small>\n                <strong>SWEET SPOT</strong>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Refined frame geometry widens the effective sweet spot\n          without slowing the frame down.\n        </p>\n\n      </article>\n\n\n      <!-- 03 / FOAM -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--foam\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            CNTRL FOAM\n          </span>\n\n          <h3>\n            Shock<br>\n            stops here.\n          </h3>\n\n          <p>\n            Foam engineered inside the frame absorbs shock\n            before it reaches your hand.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_foam_img != blank %}\n\n            <img\n              src=\"{{ b80_foam_img }}\"\n              alt=\"Nitrix 80 Bullet CNTRL Foam\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__foam-demo\">\n\n              <span class=\"b80-upgrade__wave wave-a\"></span>\n              <span class=\"b80-upgrade__wave wave-b\"></span>\n              <span class=\"b80-upgrade__wave wave-c\"></span>\n\n              <div class=\"b80-upgrade__foam-piece\">\n                <span>CNTRL</span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 04 / T FUSE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--tfuse\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            T FUSE\n          </span>\n\n          <h3>\n            Resist<br>\n            the twist.\n          </h3>\n\n          <p>\n            Reinforcement at the frame and shaft junction\n            controls torsion through full-power swings.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_tfuse_img != blank %}\n\n            <img\n              src=\"{{ b80_tfuse_img }}\"\n              alt=\"Nitrix 80 Bullet T Fuse\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__tfuse-demo\">\n\n              <span class=\"b80-upgrade__orbit orbit-a\"></span>\n              <span class=\"b80-upgrade__orbit orbit-b\"></span>\n\n              <div class=\"b80-upgrade__t\">\n                <span class=\"b80-upgrade__t-top\"></span>\n                <span class=\"b80-upgrade__t-stem\"></span>\n              </div>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n      <!-- 05 / HYPERWEAVE -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--weave\">\n\n        <div class=\"b80-upgrade__copy b80-upgrade__copy--center\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            HYPERWEAVE\n          </span>\n\n          <h3>\n            Woven<br>\n            to whip.\n          </h3>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_hyper_img != blank %}\n\n            <img\n              src=\"{{ b80_hyper_img }}\"\n              alt=\"Nitrix 80 Bullet Hyperweave\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__weave-demo\">\n\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n              <span></span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n        <p class=\"b80-upgrade__bottom\">\n          Woven carbon construction gives the shaft flex\n          without giving away strength.\n        </p>\n\n      </article>\n\n\n      <!-- 06 / CARBON -->\n      <article class=\"b80-upgrade__card b80-upgrade__card--carbon\">\n\n        <div class=\"b80-upgrade__copy\">\n\n          <span class=\"b80-upgrade__eyebrow\">\n            M46X + AECG+\n          </span>\n\n          <h3>\n            Carbon without<br>\n            compromise.\n          </h3>\n\n          <p>\n            Refined carbon systems balance low weight,\n            responsiveness and durability for aggressive play.\n          </p>\n\n        </div>\n\n        <div class=\"b80-upgrade__media\">\n\n          {% if b80_carbon_img != blank %}\n\n            <img\n              src=\"{{ b80_carbon_img | img_url: '1400x' }}\"\n              alt=\"Nitrix 80 Bullet Carbon Construction\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"b80-upgrade__carbon-demo\">\n\n              <div class=\"b80-upgrade__carbon-sheet\"></div>\n\n              <strong>M46X</strong>\n\n              <span>\n                AEROSPACE-GRADE<br>\n                CARBON SYSTEM\n              </span>\n\n            </div>\n\n          {% endif %}\n\n        </div>\n\n      </article>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n.b80-upgrade,\n.b80-upgrade *{\n  box-sizing:border-box;\n}\n\n\n/* SECTION */\n\n.b80-upgrade{\n  width:100%;\n  padding:120px 24px;\n  background:#000;\n  color:#fff;\n  font-family:Arial,Helvetica,sans-serif;\n}\n\n\n/* OUTER PANEL */\n\n.b80-upgrade__shell{\n  width:100%;\n  max-width:1240px;\n  margin:0 auto;\n\n  padding:\n    clamp(52px,6vw,78px);\n\n  border-radius:42px;\n\n  background:#121214;\n}\n\n\n/* HEADER */\n\n.b80-upgrade__head{\n  display:grid;\n\n  grid-template-columns:\n    minmax(0,1fr)\n    minmax(280px,.55fr);\n\n  gap:80px;\n\n  align-items:start;\n\n  margin-bottom:60px;\n}\n\n\n.b80-upgrade__headline h2{\n  margin:0;\n\n  max-width:650px;\n\n  color:#f5f5f7;\n\n  font-size:\n    clamp(46px,5.5vw,76px);\n\n  line-height:.97;\n\n  font-weight:700;\n\n  letter-spacing:-.055em;\n}\n\n\n.b80-upgrade__intro{\n  padding-top:9px;\n}\n\n\n.b80-upgrade__intro span{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.38);\n\n  font-size:10px;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__intro p{\n  max-width:370px;\n\n  margin:0;\n\n  color:rgba(255,255,255,.72);\n\n  font-size:16px;\n\n  line-height:1.5;\n\n  font-weight:500;\n}\n\n\n/* GRID */\n\n.b80-upgrade__grid{\n  display:grid;\n\n  grid-template-columns:\n    repeat(3,minmax(0,1fr));\n\n  gap:16px;\n}\n\n\n/* CARD */\n\n.b80-upgrade__card{\n  position:relative;\n\n  min-height:440px;\n\n  overflow:hidden;\n\n  border-radius:26px;\n\n  background:#000;\n\n  isolation:isolate;\n\n  transform:translateZ(0);\n\n  transition:\n    transform .55s cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-upgrade__card:hover{\n  transform:translateY(-5px);\n}\n\n\n.b80-upgrade__card::after{\n  content:\"\";\n\n  position:absolute;\n\n  top:0;\n  left:14%;\n  right:14%;\n\n  height:1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.10),\n      transparent\n    );\n\n  pointer-events:none;\n}\n\n\n/* COPY */\n\n.b80-upgrade__copy{\n  position:relative;\n\n  z-index:10;\n\n  padding:\n    34px 32px 0;\n}\n\n\n.b80-upgrade__copy--center{\n  text-align:center;\n}\n\n\n.b80-upgrade__eyebrow{\n  display:block;\n\n  margin-bottom:16px;\n\n  color:rgba(255,255,255,.34);\n\n  font-size:9px;\n\n  line-height:1;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n}\n\n\n.b80-upgrade__copy h3{\n  margin:0;\n\n  color:rgba(255,255,255,.94);\n\n  font-size:\n    clamp(28px,2.5vw,39px);\n\n  line-height:1.03;\n\n  font-weight:650;\n\n  letter-spacing:-.045em;\n}\n\n\n.b80-upgrade__copy h3 strong{\n  display:block;\n\n  margin-top:5px;\n\n  color:#fff;\n\n  font-size:\n    clamp(52px,4.3vw,72px);\n\n  line-height:.9;\n\n  letter-spacing:-.07em;\n}\n\n\n.b80-upgrade__copy p{\n  max-width:300px;\n\n  margin:17px 0 0;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:13px;\n\n  line-height:1.5;\n}\n\n\n.b80-upgrade__bottom{\n  position:absolute;\n\n  z-index:10;\n\n  left:30px;\n  right:30px;\n  bottom:26px;\n\n  margin:0;\n\n  text-align:center;\n\n  color:rgba(255,255,255,.46);\n\n  font-size:12.5px;\n\n  line-height:1.45;\n}\n\n\n/* MEDIA */\n\n.b80-upgrade__media{\n  position:absolute;\n  z-index:2;\n\n  inset:170px 0 0;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  overflow:hidden;\n  pointer-events:none;\n}\n\n\n/* Keeps real product artwork INSIDE the visual pocket of each card.\n   The fade makes black/transparent PNG edges disappear naturally into the card. */\n.b80-upgrade__media img{\n  display:block;\n\n  width:auto;\n  height:auto;\n\n  max-width:92%;\n  max-height:92%;\n\n  object-fit:contain;\n  object-position:center;\n\n  opacity:.98;\n  transform:translateZ(0);\n\n  -webkit-mask-image:linear-gradient(\n    to bottom,\n    transparent 0%,\n    #000 10%,\n    #000 84%,\n    transparent 100%\n  );\n  mask-image:linear-gradient(\n    to bottom,\n    transparent 0%,\n    #000 10%,\n    #000 84%,\n    transparent 100%\n  );\n}\n\n\n/* Extra black feathering over the artwork so it feels built into the card. */\n.b80-upgrade__card--curve .b80-upgrade__media::after,\n.b80-upgrade__card--foam .b80-upgrade__media::after,\n.b80-upgrade__card--tfuse .b80-upgrade__media::after,\n.b80-upgrade__card--weave .b80-upgrade__media::after{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  z-index:3;\n  pointer-events:none;\n\n  background:\n    linear-gradient(180deg,\n      #000 0%,\n      rgba(0,0,0,.76) 4%,\n      rgba(0,0,0,0) 22%,\n      rgba(0,0,0,0) 72%,\n      rgba(0,0,0,.34) 90%,\n      #000 100%\n    ),\n    linear-gradient(90deg,\n      #000 0%,\n      rgba(0,0,0,0) 14%,\n      rgba(0,0,0,0) 86%,\n      #000 100%\n    );\n}\n\n\n/* SWEET SPOT / CURVE² */\n.b80-upgrade__card--curve .b80-upgrade__media{\n  inset:158px 10px 68px;\n}\n\n.b80-upgrade__card--curve .b80-upgrade__media img{\n  max-width:94%;\n  max-height:100%;\n  transform:scale(1.02);\n}\n\n\n/* CNTRL FOAM */\n.b80-upgrade__card--foam .b80-upgrade__media{\n  inset:176px 10px 8px;\n}\n\n.b80-upgrade__card--foam .b80-upgrade__media img{\n  max-width:90%;\n  max-height:96%;\n  transform:translateY(5px) scale(.98);\n}\n\n\n/* T FUSE */\n.b80-upgrade__card--tfuse .b80-upgrade__media{\n  inset:174px 8px 6px;\n}\n\n.b80-upgrade__card--tfuse .b80-upgrade__media img{\n  max-width:94%;\n  max-height:96%;\n  transform:translateY(4px) scale(1.01);\n}\n\n\n/* HYPERWEAVE */\n.b80-upgrade__card--weave .b80-upgrade__media{\n  inset:156px 8px 70px;\n}\n\n.b80-upgrade__card--weave .b80-upgrade__media img{\n  max-width:96%;\n  max-height:100%;\n  transform:scale(1.03);\n}\n\n\n/* ========================\n   SHAFT\n======================== */\n\n.b80-upgrade__card--shaft{\n  \n}\n\n\n.b80-upgrade__shaft-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__shaft-line{\n  width:8px;\n  height:78%;\n\n  border-radius:999px;\n\n  transform:rotate(12deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      #121416,\n      #bccbd3 28%,\n      #f7fdff 48%,\n      #56636a 70%,\n      #111315\n    );\n\n  box-shadow:\n    0 0 30px rgba(255,255,255,.05);\n}\n\n\n.b80-upgrade__measure{\n  position:absolute;\n\n  left:13%;\n  right:13%;\n  top:47%;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:12px;\n}\n\n\n.b80-upgrade__measure > span{\n  flex:1;\n\n  height:1px;\n\n  background:\n    rgba(255,255,255,.16);\n}\n\n\n.b80-upgrade__measure div{\n  display:flex;\n\n  align-items:baseline;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__measure strong{\n  font-size:38px;\n\n  line-height:1;\n\n  letter-spacing:-.06em;\n}\n\n\n.b80-upgrade__measure small{\n  color:rgba(255,255,255,.35);\n\n  font-size:9px;\n\n  font-weight:700;\n}\n\n\n/* ========================\n   CURVE²\n======================== */\n\n.b80-upgrade__curve-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__ring{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.15);\n\n  border-radius:50%;\n\n  transform:\n    perspective(500px)\n    rotateX(62deg);\n}\n\n\n.ring-a{\n  width:240px;\n  height:155px;\n}\n\n\n.ring-b{\n  width:195px;\n  height:125px;\n\n  opacity:.65;\n}\n\n\n.ring-c{\n  width:150px;\n  height:95px;\n\n  opacity:.35;\n}\n\n\n.b80-upgrade__sweet{\n  position:relative;\n\n  z-index:3;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  gap:4px;\n}\n\n\n.b80-upgrade__sweet small{\n  color:rgba(255,255,255,.30);\n\n  font-size:8px;\n\n  letter-spacing:.14em;\n}\n\n\n.b80-upgrade__sweet strong{\n  color:rgba(255,255,255,.88);\n\n  font-size:13px;\n}\n\n\n/* ========================\n   FOAM\n======================== */\n\n.b80-upgrade__foam-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__foam-piece{\n  position:absolute;\n\n  bottom:-40px;\n\n  width:145px;\n  height:230px;\n\n  border-radius:\n    62px 62px\n    24px 24px;\n\n  transform:rotate(17deg);\n\n  background:\n    linear-gradient(\n      145deg,\n      #202428,\n      #090a0b\n    );\n\n  box-shadow:\n    inset 15px 0 25px\n    rgba(255,255,255,.025);\n}\n\n\n.b80-upgrade__foam-piece span{\n  position:absolute;\n\n  left:50%;\n  top:50%;\n\n  transform:\n    translate(-50%,-50%)\n    rotate(-90deg);\n\n  color:rgba(255,255,255,.16);\n\n  font-size:18px;\n\n  font-weight:700;\n\n  letter-spacing:.10em;\n}\n\n\n.b80-upgrade__wave{\n  position:absolute;\n\n  border:\n    1px solid\n    rgba(255,255,255,.07);\n\n  border-radius:50%;\n}\n\n\n.wave-a{\n  width:120px;\n  height:120px;\n}\n\n\n.wave-b{\n  width:190px;\n  height:190px;\n}\n\n\n.wave-c{\n  width:265px;\n  height:265px;\n\n  opacity:.45;\n}\n\n\n/* ========================\n   T FUSE\n======================== */\n\n.b80-upgrade__tfuse-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:grid;\n\n  place-items:center;\n}\n\n\n.b80-upgrade__t{\n  position:relative;\n\n  width:220px;\n  height:190px;\n}\n\n\n.b80-upgrade__t-top{\n  position:absolute;\n\n  left:0;\n  right:0;\n  top:18px;\n\n  height:30px;\n\n  border-radius:\n    50% 50%\n    12px 12px;\n\n  background:\n    linear-gradient(\n      180deg,\n      #373c40,\n      #101214\n    );\n}\n\n\n.b80-upgrade__t-stem{\n  position:absolute;\n\n  left:50%;\n  top:34px;\n\n  width:25px;\n  height:160px;\n\n  transform:translateX(-50%);\n\n  border-radius:10px;\n\n  background:\n    linear-gradient(\n      90deg,\n      #0c0d0e,\n      #4e575c,\n      #0d0f10\n    );\n}\n\n\n.b80-upgrade__orbit{\n  position:absolute;\n\n  width:235px;\n  height:90px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  border-radius:50%;\n}\n\n\n.orbit-a{\n  transform:rotate(18deg);\n}\n\n\n.orbit-b{\n  transform:rotate(-18deg);\n}\n\n\n/* ========================\n   WEAVE\n======================== */\n\n.b80-upgrade__weave-demo{\n  position:relative;\n\n  width:86%;\n  height:180px;\n}\n\n\n.b80-upgrade__weave-demo span{\n  position:absolute;\n\n  left:0;\n  right:0;\n\n  height:7px;\n\n  border-radius:999px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      #272b2d 8%,\n      #dce8ed 32%,\n      #222629 70%,\n      transparent\n    );\n}\n\n\n.b80-upgrade__weave-demo span:nth-child(1){\n  top:18px;\n  transform:rotate(-8deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(2){\n  top:40px;\n  transform:rotate(-5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(3){\n  top:62px;\n  transform:rotate(-2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(4){\n  top:84px;\n}\n\n.b80-upgrade__weave-demo span:nth-child(5){\n  top:106px;\n  transform:rotate(2deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(6){\n  top:128px;\n  transform:rotate(5deg);\n}\n\n.b80-upgrade__weave-demo span:nth-child(7){\n  top:150px;\n  transform:rotate(8deg);\n}\n\n\n/* ========================\n   CARBON\n======================== */\n\n.b80-upgrade__carbon-demo{\n  position:relative;\n\n  width:100%;\n  height:100%;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n}\n\n\n.b80-upgrade__carbon-sheet{\n  position:absolute;\n\n  width:90%;\n  height:110px;\n\n  background:\n    repeating-linear-gradient(\n      45deg,\n      #080808 0,\n      #080808 4px,\n      #171717 4px,\n      #171717 6px\n    );\n\n  transform:rotate(-8deg);\n\n  opacity:.75;\n}\n\n\n.b80-upgrade__carbon-demo strong{\n  position:relative;\n\n  z-index:2;\n\n  font-size:\n    clamp(56px,5vw,82px);\n\n  line-height:.9;\n\n  letter-spacing:-.075em;\n}\n\n\n.b80-upgrade__carbon-demo > span{\n  position:relative;\n\n  z-index:2;\n\n  margin-top:15px;\n\n  color:rgba(255,255,255,.28);\n\n  font-size:8px;\n\n  line-height:1.45;\n\n  font-weight:700;\n\n  letter-spacing:.16em;\n\n  text-align:center;\n}\n\n\n/* TABLET */\n\n@media(max-width:1000px){\n\n  .b80-upgrade__head{\n    grid-template-columns:1fr;\n\n    gap:28px;\n  }\n\n\n  .b80-upgrade__grid{\n    grid-template-columns:\n      repeat(2,minmax(0,1fr));\n  }\n\n}\n\n\n/* MOBILE */\n\n@media(max-width:700px){\n\n  .b80-upgrade{\n    padding:\n      74px 14px;\n  }\n\n\n  .b80-upgrade__shell{\n    padding:\n      42px 14px\n      16px;\n\n    border-radius:28px;\n  }\n\n\n  .b80-upgrade__head{\n    padding:\n      0 12px;\n\n    margin-bottom:40px;\n  }\n\n\n  .b80-upgrade__headline h2{\n    font-size:\n      clamp(\n        40px,\n        12vw,\n        56px\n      );\n  }\n\n\n  .b80-upgrade__intro{\n    padding:0;\n  }\n\n\n  /* MOBILE = SWIPEABLE CARDS */\n\n  .b80-upgrade__grid{\n    display:flex;\n\n    gap:13px;\n\n    overflow-x:auto;\n\n    overflow-y:hidden;\n\n    scroll-snap-type:\n      x mandatory;\n\n    scroll-behavior:smooth;\n\n    overscroll-behavior-x:\n      contain;\n\n    -webkit-overflow-scrolling:\n      touch;\n\n    scrollbar-width:none;\n\n    padding:\n      0 0 2px;\n  }\n\n\n  .b80-upgrade__grid::-webkit-scrollbar{\n    display:none;\n  }\n\n\n  .b80-upgrade__card{\n    flex:\n      0 0\n      87%;\n\n    width:87%;\n\n    min-height:485px;\n\n    border-radius:25px;\n\n    scroll-snap-align:center;\n\n    scroll-snap-stop:always;\n  }\n\n\n  .b80-upgrade__copy{\n    padding:\n      31px 26px 0;\n  }\n\n\n  .b80-upgrade__copy h3{\n    font-size:\n      clamp(\n        30px,\n        9vw,\n        40px\n      );\n  }\n\n\n  .b80-upgrade__copy h3 strong{\n    font-size:\n      clamp(\n        52px,\n        16vw,\n        70px\n      );\n  }\n\n\n  /* Keep the four supplied PNGs balanced inside taller mobile cards. */\n  .b80-upgrade__card--curve .b80-upgrade__media{\n    inset:166px 8px 70px;\n  }\n\n  .b80-upgrade__card--foam .b80-upgrade__media,\n  .b80-upgrade__card--tfuse .b80-upgrade__media{\n    inset:184px 8px 8px;\n  }\n\n  .b80-upgrade__card--weave .b80-upgrade__media{\n    inset:164px 8px 72px;\n  }\n\n  .b80-upgrade__card--curve .b80-upgrade__media img,\n  .b80-upgrade__card--foam .b80-upgrade__media img,\n  .b80-upgrade__card--tfuse .b80-upgrade__media img,\n  .b80-upgrade__card--weave .b80-upgrade__media img{\n    max-width:94%;\n  }\n\n\n  .b80-upgrade__bottom{\n    left:25px;\n    right:25px;\n    bottom:25px;\n  }\n\n}\n\n</style>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_8n7t4D": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NITRIX SERIES COMPARISON\n  Premium Apple-style text-only comparison\n\n  Left side switches between:\n  - Nitrix 70 Venom\n  - Nitrix 70 Volta\n\n  Right side stays:\n  - Nitrix 80 Bullet\n\n  Paste only the Bullet image URL below.\n{% endcomment %}\n\n{% assign bullet_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623' %}\n\n{% assign venom_product = all_products['nitrix-70-venom'] %}\n{% assign volta_product = all_products['nitrix-70-volta-3u'] %}\n\n<style>\n  #nitrix-premium-compare,\n  #nitrix-premium-compare * {\n    box-sizing: border-box;\n  }\n\n  #nitrix-premium-compare {\n    width: 100%;\n    padding: clamp(76px, 8vw, 120px) 20px clamp(82px, 8vw, 126px);\n    background: #000;\n    color: #fff;\n    font-family: inherit;\n  }\n\n  #nitrix-premium-compare * {\n    font-family: inherit;\n  }\n\n  .npc-inner {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  /* =========================\n     HEADING\n  ========================= */\n\n  .npc-heading {\n    max-width: 780px;\n    margin: 0 auto 34px;\n    text-align: center;\n  }\n\n  .npc-kicker {\n    margin: 0 0 12px;\n    color: rgba(255,255,255,.38);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .npc-heading h2 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(44px, 5.8vw, 78px);\n    line-height: .95;\n    font-weight: 650;\n    letter-spacing: -.06em;\n  }\n\n  .npc-heading-copy {\n    max-width: 560px;\n    margin: 18px auto 0;\n    color: rgba(255,255,255,.48);\n    font-size: clamp(14px, 1.3vw, 17px);\n    line-height: 1.5;\n  }\n\n  /* =========================\n     DROPDOWN\n  ========================= */\n\n  .npc-selector {\n    width: min(100%, 360px);\n    margin: 0 auto 28px;\n  }\n\n  .npc-selector-label {\n    margin: 0 0 10px 15px;\n    color: rgba(255,255,255,.9);\n    font-size: 13px;\n    line-height: 1.2;\n    font-weight: 600;\n  }\n\n  .npc-select-shell {\n    position: relative;\n    width: 100%;\n  }\n\n  .npc-select {\n    width: 100%;\n    height: 52px;\n    appearance: none;\n    -webkit-appearance: none;\n    padding: 0 52px 0 18px;\n    border: 1px solid rgba(255,255,255,.28);\n    border-radius: 999px;\n    outline: none;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.05),\n        rgba(255,255,255,.015)\n      ),\n      #0b0c0e;\n    color: #fff;\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 600;\n    cursor: pointer;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.05),\n      0 10px 26px rgba(0,0,0,.22);\n    transition:\n      border-color .2s ease,\n      background .2s ease,\n      transform .2s ease;\n  }\n\n  .npc-select:hover,\n  .npc-select:focus {\n    border-color: rgba(255,255,255,.42);\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.075),\n        rgba(255,255,255,.02)\n      ),\n      #0d0e10;\n  }\n\n  .npc-select-shell::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    right: 20px;\n    width: 8px;\n    height: 8px;\n    border-right: 1.5px solid #35aee8;\n    border-bottom: 1.5px solid #35aee8;\n    transform: translateY(-68%) rotate(45deg);\n    pointer-events: none;\n  }\n\n  /* =========================\n     MAIN CARD\n  ========================= */\n\n  .npc-card {\n    position: relative;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,.13);\n    border-radius: 32px;\n    background:\n      radial-gradient(\n        ellipse at 50% 0%,\n        rgba(255,255,255,.045),\n        transparent 38%\n      ),\n      linear-gradient(\n        145deg,\n        #111316 0%,\n        #08090b 48%,\n        #030405 100%\n      );\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.04),\n      0 34px 90px rgba(0,0,0,.3);\n  }\n\n  /* =========================\n     PRODUCT HEADER\n  ========================= */\n\n  .npc-products {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 70px minmax(0, 1fr);\n    align-items: end;\n    gap: clamp(14px, 3vw, 34px);\n    padding: clamp(34px, 4vw, 54px) clamp(18px, 4vw, 48px) 24px;\n  }\n\n  .npc-product {\n    min-width: 0;\n    text-align: center;\n  }\n\n  .npc-product-media {\n    position: relative;\n    height: clamp(250px, 29vw, 390px);\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n  }\n\n  .npc-product-media::before {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    bottom: 2%;\n    width: 70%;\n    height: 28px;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: rgba(255,255,255,.10);\n    filter: blur(20px);\n    opacity: .55;\n  }\n\n  .npc-product-media img {\n    position: relative;\n    z-index: 1;\n    display: block;\n    width: auto;\n    height: 94%;\n    max-width: 100%;\n    object-fit: contain;\n\n    border-radius: 22px;\n    overflow: hidden;\n\n    box-shadow:\n      0 18px 44px rgba(0,0,0,.28),\n      inset 0 1px 0 rgba(255,255,255,.06);\n\n    transition:\n      transform .55s cubic-bezier(.16,1,.3,1),\n      opacity .22s ease,\n      box-shadow .3s ease;\n  }\n\n  .npc-product:hover .npc-product-media img {\n    transform: translateY(-5px);\n  }\n\n  .npc-placeholder {\n    width: 112px;\n    height: 86%;\n    margin-bottom: 8px;\n    border-radius: 999px;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.07),\n        rgba(255,255,255,.015)\n      );\n  }\n\n  .npc-product-name {\n    margin: 17px 0 0;\n    color: #fff;\n    font-size: clamp(20px, 2.2vw, 29px);\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: -.04em;\n  }\n\n  .npc-product-note {\n    max-width: 320px;\n    min-height: 42px;\n    margin: 10px auto 0;\n    color: rgba(255,255,255,.42);\n    font-size: 12px;\n    line-height: 1.42;\n  }\n\n  .npc-vs {\n    align-self: center;\n    margin-top: 110px;\n    color: rgba(255,255,255,.34);\n    font-size: 11px;\n    font-weight: 650;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  /* =========================\n     COMPARISON TABLE\n  ========================= */\n\n  .npc-table {\n    padding: 12px clamp(18px, 4vw, 48px) 50px;\n  }\n\n  .npc-row {\n    display: grid;\n    grid-template-columns:\n      minmax(0, 1fr)\n      minmax(110px, 150px)\n      minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(12px, 3vw, 34px);\n    min-height: 74px;\n    border-top: 1px solid rgba(255,255,255,.085);\n  }\n\n  .npc-value {\n    color: #fff;\n    font-size: clamp(16px, 1.8vw, 21px);\n    line-height: 1.15;\n    font-weight: 560;\n    letter-spacing: -.02em;\n  }\n\n  .npc-value--left {\n    text-align: right;\n  }\n\n  .npc-value--right {\n    text-align: left;\n  }\n\n  .npc-label {\n    color: rgba(255,255,255,.38);\n    font-size: 10px;\n    line-height: 1.1;\n    font-weight: 650;\n    letter-spacing: .14em;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  /* =========================\n     BOTTOM MESSAGE\n  ========================= */\n\n  .npc-bottom {\n    padding: 12px 18px 52px;\n    text-align: center;\n  }\n\n  .npc-bottom-label {\n    margin: 0 0 12px;\n    color: rgba(255,255,255,.34);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .npc-bottom h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(30px, 4vw, 52px);\n    line-height: .98;\n    font-weight: 620;\n    letter-spacing: -.05em;\n  }\n\n  .npc-bottom h3 span {\n    color: rgba(255,255,255,.38);\n  }\n\n  /* =========================\n     SWITCH ANIMATION\n  ========================= */\n\n  .npc-switching {\n    opacity: .28 !important;\n    transform: translateY(5px) !important;\n  }\n\n  .npc-change {\n    transition:\n      opacity .18s ease,\n      transform .24s cubic-bezier(.16,1,.3,1);\n  }\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    #nitrix-premium-compare {\n      padding: 64px 12px 72px;\n    }\n\n    .npc-heading {\n      margin-bottom: 28px;\n    }\n\n    .npc-heading h2 {\n      font-size: clamp(40px, 12vw, 52px);\n    }\n\n    .npc-heading-copy {\n      padding: 0 8px;\n      font-size: 13px;\n    }\n\n    .npc-selector {\n      width: 100%;\n      max-width: none;\n      margin-bottom: 18px;\n    }\n\n    .npc-selector-label {\n      margin-left: 15px;\n      font-size: 12px;\n    }\n\n    .npc-select {\n      height: 48px;\n      font-size: 13px;\n    }\n\n    .npc-card {\n      border-radius: 24px;\n    }\n\n    .npc-products {\n      grid-template-columns: minmax(0,1fr) 34px minmax(0,1fr);\n      gap: 7px;\n      padding: 27px 10px 18px;\n    }\n\n    .npc-product-media {\n      height: 220px;\n    }\n\n    .npc-product-media img {\n      border-radius: 16px;\n    }\n\n    .npc-product-name {\n      font-size: 16px;\n    }\n\n    .npc-product-note {\n      min-height: 52px;\n      padding: 0 2px;\n      font-size: 9.5px;\n    }\n\n    .npc-vs {\n      margin-top: 75px;\n      font-size: 8px;\n    }\n\n    .npc-table {\n      padding: 8px 11px 34px;\n    }\n\n    .npc-row {\n      grid-template-columns:\n        minmax(0, 1fr)\n        minmax(76px, 88px)\n        minmax(0, 1fr);\n      gap: 7px;\n      min-height: 64px;\n    }\n\n    .npc-value {\n      font-size: 13px;\n      line-height: 1.2;\n    }\n\n    .npc-label {\n      font-size: 7px;\n      letter-spacing: .09em;\n    }\n\n    .npc-bottom {\n      padding: 8px 12px 38px;\n    }\n\n    .npc-bottom h3 {\n      font-size: 34px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .npc-product-media {\n      height: 190px;\n    }\n\n    .npc-product-media img {\n      border-radius: 14px;\n    }\n\n    .npc-product-name {\n      font-size: 14px;\n    }\n\n    .npc-product-note {\n      font-size: 8.7px;\n    }\n\n    .npc-row {\n      grid-template-columns:\n        minmax(0, 1fr)\n        72px\n        minmax(0, 1fr);\n    }\n\n    .npc-value {\n      font-size: 12px;\n    }\n\n    .npc-label {\n      font-size: 6.4px;\n    }\n  }\n</style>\n\n<section id=\"nitrix-premium-compare\">\n  <div class=\"npc-inner\">\n\n    <div class=\"npc-heading\">\n      <p class=\"npc-kicker\">NITRIX SERIES COMPARISON</p>\n\n      <h2>\n        Compare.\n      </h2>\n\n      <p class=\"npc-heading-copy\">\n        Two different weapons. One attacking mindset.\n      </p>\n    </div>\n\n    <div class=\"npc-selector\">\n      <p class=\"npc-selector-label\">\n        Select a racket to compare to Nitrix 80 Bullet:\n      </p>\n\n      <div class=\"npc-select-shell\">\n        <select\n          class=\"npc-select\"\n          id=\"npc-model-select\"\n          aria-label=\"Select a Nitrix racket to compare\"\n        >\n          <option value=\"venom\">Nitrix 70 Venom</option>\n          <option value=\"volta\">Nitrix 70 Volta</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"npc-card\">\n\n      <!-- =========================\n           PRODUCT TOP\n      ========================== -->\n\n      <div class=\"npc-products\">\n\n        <article class=\"npc-product npc-change\" id=\"npc-left-product\">\n\n          <div class=\"npc-product-media\">\n\n            {% if venom_product != blank and venom_product.featured_image != blank %}\n\n              <img\n                id=\"npc-left-image\"\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541\"\n                alt=\"Nitrix 70 Venom\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"npc-placeholder\"></div>\n\n            {% endif %}\n\n          </div>\n\n          <h3 class=\"npc-product-name\" id=\"npc-left-name\">\n            Nitrix 70 Venom\n          </h3>\n\n          <p class=\"npc-product-note\" id=\"npc-left-note\">\n            Fast attacking response with controlled handling.\n          </p>\n\n        </article>\n\n\n        <div class=\"npc-vs\">\n          VS\n        </div>\n\n\n        <article class=\"npc-product\">\n\n          <div class=\"npc-product-media\">\n\n            {% if bullet_img != blank %}\n\n              <img\n                src=\"{{ bullet_img }}\"\n                alt=\"Nitrix 80 Bullet\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"npc-placeholder\"></div>\n\n            {% endif %}\n\n          </div>\n\n          <h3 class=\"npc-product-name\">\n            Nitrix 80 Bullet\n          </h3>\n\n          <p class=\"npc-product-note\">\n            Razor-thin response engineered for aggressive attacking play.\n          </p>\n\n        </article>\n\n      </div>\n\n\n      <!-- =========================\n           TEXT-ONLY SPECS\n      ========================== -->\n\n      <div class=\"npc-table\">\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-shaft\">\n            6.1 mm\n          </div>\n\n          <div class=\"npc-label\">\n            Shaft Thickness\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            5.9 mm\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-flex\">\n            Hard Flex\n          </div>\n\n          <div class=\"npc-label\">\n            Flex\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Fast Release\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-carbon\">\n            M46X Carbon Fibre\n          </div>\n\n          <div class=\"npc-label\">\n            Carbon Fibre\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            M46X Carbon Fibre\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-frame\">\n            Curve² Frame\n          </div>\n\n          <div class=\"npc-label\">\n            Frame\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Curve² Frame\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-tech\">\n            CNTRL Foam\n          </div>\n\n          <div class=\"npc-label\">\n            Technology\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            CNTRL Foam\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-response\">\n            Controlled Attack\n          </div>\n\n          <div class=\"npc-label\">\n            Response\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Faster Release\n          </div>\n        </div>\n\n      </div>\n\n\n      <!-- =========================\n           BOTTOM\n      ========================== -->\n\n      <div class=\"npc-bottom\">\n\n        <p class=\"npc-bottom-label\">\n          THE DIFFERENCE\n        </p>\n\n        <h3>\n          Thinner shaft.<br>\n          <span>Sharper release.</span>\n        </h3>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n\n  var section =\n    document.getElementById(\n      'nitrix-premium-compare'\n    );\n\n  if (!section) {\n    return;\n  }\n\n  var select =\n    section.querySelector(\n      '#npc-model-select'\n    );\n\n  if (!select) {\n    return;\n  }\n\n  var data = {\n\n    venom: {\n      name:\n        'Nitrix 70 Venom',\n\n      note:\n        'Fast attacking response with controlled handling.',\n\n      shaft:\n        '6.1 mm',\n\n      flex:\n        'Hard Flex',\n\n      carbon:\n        'M46X Carbon Fibre',\n\n      frame:\n        'Curve² Frame',\n\n      tech:\n        'CNTRL Foam',\n\n      response:\n        'Controlled Attack',\n\n      image:\n        {% if venom_product != blank and venom_product.featured_image != blank %}\n          '{{ venom_product.featured_image | image_url: width: 900 }}'\n        {% else %}\n          ''\n        {% endif %}\n    },\n\n\n    volta: {\n      name:\n        'Nitrix 70 Volta',\n\n      note:\n        'Clean aggressive power with a flexible shaft.',\n\n      shaft:\n        '7.0 mm',\n\n      flex:\n        'Flexible',\n\n      carbon:\n        'M46X + AECG+ Carbon',\n\n      frame:\n        'Aerodynamic Frame',\n\n      tech:\n        'Performance Construction',\n\n      response:\n        'Loaded Power',\n\n      image:\n        'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_dba40639-bb18-422f-adcc-defb52ab3d09.jpg?v=1786712390'\n    }\n\n  };\n\n\n  var product =\n    section.querySelector(\n      '#npc-left-product'\n    );\n\n  var image =\n    section.querySelector(\n      '#npc-left-image'\n    );\n\n  var name =\n    section.querySelector(\n      '#npc-left-name'\n    );\n\n  var note =\n    section.querySelector(\n      '#npc-left-note'\n    );\n\n  var shaft =\n    section.querySelector(\n      '#npc-shaft'\n    );\n\n  var flex =\n    section.querySelector(\n      '#npc-flex'\n    );\n\n  var carbon =\n    section.querySelector(\n      '#npc-carbon'\n    );\n\n  var frame =\n    section.querySelector(\n      '#npc-frame'\n    );\n\n  var tech =\n    section.querySelector(\n      '#npc-tech'\n    );\n\n  var response =\n    section.querySelector(\n      '#npc-response'\n    );\n\n  var changing =\n    section.querySelectorAll(\n      '.npc-change'\n    );\n\n\n  function setSwitching(\n    state\n  ) {\n\n    changing.forEach(\n      function (element) {\n\n        element.classList.toggle(\n          'npc-switching',\n          state\n        );\n\n      }\n    );\n\n  }\n\n\n  function updateCompare(\n    key\n  ) {\n\n    var item =\n      data[key];\n\n    if (!item) {\n      return;\n    }\n\n    setSwitching(\n      true\n    );\n\n\n    window.setTimeout(\n      function () {\n\n        if (name) {\n          name.textContent =\n            item.name;\n        }\n\n        if (note) {\n          note.textContent =\n            item.note;\n        }\n\n        if (shaft) {\n          shaft.textContent =\n            item.shaft;\n        }\n\n        if (flex) {\n          flex.textContent =\n            item.flex;\n        }\n\n        if (carbon) {\n          carbon.textContent =\n            item.carbon;\n        }\n\n        if (frame) {\n          frame.textContent =\n            item.frame;\n        }\n\n        if (tech) {\n          tech.textContent =\n            item.tech;\n        }\n\n        if (response) {\n          response.textContent =\n            item.response;\n        }\n\n        if (\n          image &&\n          item.image && item.name==\"Nitrix 70 Venom\"\n        ) {\n\n          image.src =\n            \"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541\";\n\n          image.alt =\n            item.name;\n\n        }else{\nimage.src =\n            item.image;\n\n          image.alt =\n            item.name;\n}\n\n        setSwitching(\n          false\n        );\n\n      },\n      140\n    );\n\n  }\n\n\n  select.addEventListener(\n    'change',\n    function () {\n\n      updateCompare(\n        this.value\n      );\n\n    }\n  );\n\n})();\n</script>",
