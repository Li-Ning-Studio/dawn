osition:absolute;\n\n  left:50%;\n  top:50%;\n\n  width:12px;\n  height:1px;\n\n  background:\n    rgba(255,255,255,.74);\n}\n\n\n.b80-menu-close:before{\n  transform:\n    translate(-50%,-50%)\n    rotate(45deg);\n}\n\n\n.b80-menu-close:after{\n  transform:\n    translate(-50%,-50%)\n    rotate(-45deg);\n}\n\n\n/* MENU GRID */\n\n.b80-menu-grid{\n  display:grid;\n\n  grid-template-columns:\n    repeat(\n      3,\n      minmax(0,1fr)\n    );\n\n  gap:\n    4px 14px;\n\n  padding:\n    22px 0;\n}\n\n\n.b80-menu-link{\n  position:relative;\n\n  min-height:72px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  justify-content:center;\n\n  padding:\n    12px 40px 12px 13px;\n\n  overflow:hidden;\n\n  border-radius:14px;\n\n  color:#fff;\n\n  text-decoration:none;\n\n  opacity:0;\n\n  transform:\n    translateY(7px);\n\n  transition:\n    transform .35s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-menu-link:before{\n  content:\"\";\n\n  position:absolute;\n\n  inset:0;\n\n  opacity:0;\n\n  background:\n    linear-gradient(\n      120deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.018)\n    );\n\n  transition:\n    opacity .25s;\n}\n\n\n.b80-menu-link:hover{\n  transform:\n    translateY(-2px);\n}\n\n\n.b80-menu-link:hover:before{\n  opacity:1;\n}\n\n\n.b80-menu-link b,\n.b80-menu-link strong,\n.b80-menu-link small{\n  position:relative;\n\n  z-index:2;\n}\n\n\n.b80-menu-link b{\n  margin-bottom:5px;\n\n  color:\n    rgba(255,255,255,.23);\n\n  font-size:6px;\n\n  letter-spacing:.18em;\n}\n\n\n.b80-menu-link strong{\n  font-size:14px;\n\n  font-weight:500;\n\n  letter-spacing:\n    -.02em;\n}\n\n\n.b80-menu-link small{\n  margin-top:5px;\n\n  color:\n    rgba(255,255,255,.31);\n\n  font-size:8px;\n}\n\n\n.b80-menu-link i{\n  position:absolute;\n\n  z-index:2;\n\n  right:13px;\n  top:50%;\n\n  width:25px;\n  height:25px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  opacity:0;\n\n  color:\n    rgba(255,255,255,.58);\n\n  transform:\n    translateY(-50%)\n    translateX(-4px);\n\n  transition:\n    opacity .25s,\n    transform .35s\n    cubic-bezier(.16,1,.3,1),\n    background .25s;\n}\n\n\n.b80-menu-link i svg,\n.b80-menu-utils svg{\n  width:11px;\n  height:11px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.4;\n\n  stroke-linecap:round;\n\n  stroke-linejoin:round;\n}\n\n\n.b80-menu-link:hover i{\n  opacity:1;\n\n  transform:\n    translateY(-50%);\n\n  background:\n    rgba(255,255,255,.07);\n}\n\n\n/* STAGGER */\n\n.b80-menu.is-open\n.b80-menu-link{\n  animation:\n    b80Item .46s\n    cubic-bezier(.16,1,.3,1)\n    forwards;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(1){\n  animation-delay:.04s;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(2){\n  animation-delay:.07s;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(3){\n  animation-delay:.10s;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(4){\n  animation-delay:.13s;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(5){\n  animation-delay:.16s;\n}\n\n\n.b80-menu.is-open\n.b80-menu-link:nth-child(6){\n  animation-delay:.19s;\n}\n\n\n@keyframes b80Item{\n\n  to{\n    opacity:1;\n\n    transform:none;\n  }\n\n}\n\n\n/* MENU FOOTER */\n\n.b80-menu-foot{\n  display:flex;\n\n  align-items:center;\n\n  justify-content:\n    space-between;\n\n  gap:25px;\n\n  padding-top:19px;\n\n  border-top:\n    1px solid\n    rgba(255,255,255,.075);\n}\n\n\n.b80-menu-utils{\n  display:flex;\n  align-items:center;\n\n  gap:28px;\n}\n\n\n.b80-menu-utils a{\n  display:flex;\n  align-items:center;\n\n  gap:7px;\n\n  color:\n    rgba(255,255,255,.48);\n\n  text-decoration:none;\n\n  font-size:9px;\n\n  transition:\n    color .25s;\n}\n\n\n.b80-menu-utils a:hover{\n  color:#fff;\n}\n\n\n.b80-menu-buy{\n  height:38px;\n\n  padding:\n    0 19px;\n\n  display:flex;\n  align-items:center;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#08090a;\n\n  text-decoration:none;\n\n  font-size:9px;\n\n  font-weight:650;\n\n  white-space:nowrap;\n\n  transition:\n    transform .3s;\n}\n\n\n.b80-menu-buy:hover{\n  transform:\n    scale(1.035);\n}\n\n\n/* MOBILE */\n\n@media(max-width:750px){\n\n  .b80-nav{\n    width:\n      calc(100vw - 24px);\n\n    height:46px;\n  }\n\n\n  .b80-nav-links{\n    gap:18px;\n  }\n\n\n  .b80-nav-links a{\n    font-size:8px;\n  }\n\n\n  .b80-nav.is-product{\n    width:\n      calc(100vw - 16px);\n\n    height:52px;\n\n    border-radius:16px;\n  }\n\n\n  .b80-nav-product{\n    padding:\n      0 6px 0 14px;\n  }\n\n\n  .b80-product-identity strong{\n    font-size:13px;\n  }\n\n\n  .b80-product-identity i,\n  .b80-product-identity span,\n  .b80-live{\n    display:none;\n  }\n\n\n  .b80-product-right{\n    gap:5px;\n  }\n\n\n  .b80-product-explore{\n    height:32px;\n\n    padding:\n      0 4px 0 11px;\n\n    font-size:9px;\n  }\n\n\n  .b80-small-arrow{\n    width:24px;\n    height:24px;\n  }\n\n\n  .b80-buy{\n    height:32px;\n\n    padding:\n      0 13px;\n\n    font-size:9px;\n  }\n\n\n  .b80-hero{\n    min-height:680px;\n  }\n\n\n  .b80-content{\n    top:45%;\n\n    width:93vw;\n  }\n\n\n  .b80-eyebrow{\n    margin-bottom:24px;\n  }\n\n\n  .b80-heading{\n    font-size:\n      clamp(\n        54px,\n        17vw,\n        80px\n      );\n\n    line-height:.82;\n  }\n\n\n  .b80-copy{\n    margin-top:28px;\n\n    font-size:12px;\n  }\n\n\n  .b80-actions{\n    margin-top:25px;\n\n    gap:17px;\n  }\n\n\n  .b80-hero-explore{\n    height:42px;\n\n    padding-left:15px;\n  }\n\n\n  .b80-hero-arrow{\n    width:31px;\n    height:31px;\n  }\n\n\n  .b80-discover{\n    font-size:9px;\n  }\n\n\n  .b80-bottom-left,\n  .b80-bottom-right{\n    display:none;\n  }\n\n\n  .b80-menu{\n    width:\n      calc(100vw - 16px);\n\n    border-radius:\n      0 0 22px 22px;\n  }\n\n\n  .b80-menu-inner{\n    padding:\n      24px 16px 18px;\n  }\n\n\n  .b80-menu-head{\n    padding:\n      0 3px 20px;\n  }\n\n\n  .b80-menu-head h3{\n    font-size:22px;\n  }\n\n\n  .b80-menu-grid{\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap:3px;\n\n    padding:\n      15px 0;\n  }\n\n\n  .b80-menu-link{\n    min-height:66px;\n\n    padding:\n      10px 30px 10px 10px;\n  }\n\n\n  .b80-menu-link strong{\n    font-size:12px;\n  }\n\n\n  .b80-menu-link small{\n    font-size:7px;\n  }\n\n\n  .b80-menu-foot{\n    align-items:flex-end;\n  }\n\n\n  .b80-menu-utils{\n    flex-direction:column;\n\n    align-items:flex-start;\n\n    gap:10px;\n  }\n\n\n  .b80-menu-buy{\n    padding:\n      0 15px;\n  }\n\n}\n\n\n/* SMALL MOBILE */\n\n@media(max-width:390px){\n\n  .b80-nav-links{\n    gap:12px;\n  }\n\n\n  .b80-nav-links a{\n    font-size:7px;\n  }\n\n\n  .b80-menu-grid{\n    grid-template-columns:1fr;\n  }\n\n\n  .b80-menu-link{\n    min-height:57px;\n  }\n\n\n  .b80-menu-link small{\n    display:none;\n  }\n\n\n  .b80-product-explore\n  > span:first-child{\n    display:none;\n  }\n\n\n  .b80-product-explore{\n    padding-left:4px;\n  }\n\n\n  .b80-heading{\n    font-size:50px;\n  }\n\n}\n\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80-nav-sheen,\n  .b80-nav-tracer span,\n  .b80-scroll i:before,\n  .b80-menu-glass:after,\n  .b80-menu-jump,\n  .b80-menu.is-open\n  .b80-menu-link{\n    animation:none !important;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function(){\n\n  const nav =\n    document.getElementById(\n      'b80-nav'\n    );\n\n  const hero =\n    document.getElementById(\n      'b80-hero'\n    );\n\n  const menu =\n    document.getElementById(\n      'b80-menu'\n    );\n\n\n  if(\n    !nav ||\n    !hero ||\n    !menu\n  ){\n    return;\n  }\n\n\n  /*\n  MOVE NAV + MENU TO BODY\n\n  This makes them global and prevents\n  the Shopify section from clipping them.\n  */\n\n  document.body.appendChild(\n    nav\n  );\n\n  document.body.appendChild(\n    menu\n  );\n\n\n  const explore =\n    nav.querySelector(\n      '.b80-product-explore'\n    );\n\n  const close =\n    menu.querySelector(\n      '.b80-menu-close'\n    );\n\n\n  let menuOpen = false;\n\n  let trackingUntil = 0;\n\n  let rafBusy = false;\n\n\n  /*\n  SHOPIFY HEADER SELECTORS\n  */\n\n  const headerSelectors = [\n\n    '#shopify-section-header',\n\n    '.shopify-section-header-sticky',\n\n    'sticky-header',\n\n    '.header-wrapper',\n\n    '.section-header',\n\n    '.shopify-section-group-header-group',\n\n    'header.header'\n\n  ];\n\n\n  /*\n  FIND ACTUAL VISIBLE BOTTOM\n  OF SHOPIFY STICKY HEADER\n  */\n\n  function headerBottom(){\n\n    let bottom = 0;\n\n    const seen =\n      new Set();\n\n\n    headerSelectors\n    .forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              seen.has(\n                element\n              )\n            ){\n              return;\n            }\n\n\n            if(\n              element === nav ||\n              element.contains(nav)\n            ){\n              return;\n            }\n\n\n            seen.add(\n              element\n            );\n\n\n            const rect =\n              element\n              .getBoundingClientRect();\n\n\n            const style =\n              getComputedStyle(\n                element\n              );\n\n\n            if(\n              style.display ===\n              'none' ||\n\n              style.visibility ===\n              'hidden' ||\n\n              Number(\n                style.opacity\n              ) === 0 ||\n\n              rect.height < 2 ||\n\n              rect.height > 220 ||\n\n              rect.bottom <= 0 ||\n\n              rect.top >= 220\n            ){\n              return;\n            }\n\n\n            bottom =\n              Math.max(\n                bottom,\n                rect.bottom\n              );\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n    return Math.max(\n      0,\n\n      Math.min(\n        bottom,\n        220\n      )\n    );\n\n  }\n\n\n  /*\n  KEEP BULLET BAR UNDER\n  SHOPIFY HEADER\n  */\n\n  function positionNav(){\n\n    const gap =\n      window.innerWidth <= 750\n      ? 8\n      : 10;\n\n\n    const top =\n      Math.round(\n        headerBottom() +\n        gap\n      );\n\n\n    document\n    .documentElement\n    .style\n    .setProperty(\n\n      '--b80-top',\n\n      top + 'px'\n\n    );\n\n  }\n\n\n  /*\n  HERO NAV -> PRODUCT NAV\n  */\n\n  function updateState(){\n\n    const rect =\n      hero\n      .getBoundingClientRect();\n\n\n    const product =\n      rect.bottom <=\n      window.innerHeight * .34;\n\n\n    nav\n    .classList\n    .toggle(\n      'is-product',\n      product\n    );\n\n\n    /*\n    MENU ONLY BELONGS TO\n    BUY NOW PRODUCT BAR\n    */\n\n    if(\n      !product &&\n      menuOpen\n    ){\n      closeMenu();\n    }\n\n  }\n\n\n  /*\n  POSITION MENU DIRECTLY\n  UNDER PRODUCT BAR\n  */\n\n  function positionMenu(){\n\n    const navRect =\n      nav\n      .getBoundingClientRect();\n\n\n    const buttonRect =\n      explore\n      .getBoundingClientRect();\n\n\n    const width =\n\n      window.innerWidth <= 750\n\n      ? window.innerWidth - 16\n\n      : Math.min(\n          900,\n          window.innerWidth - 32\n        );\n\n\n    const left =\n      (\n        window.innerWidth -\n        width\n      ) / 2;\n\n\n    /*\n    CONNECTOR POINT\n    DIRECTLY UNDER EXPLORE\n    */\n\n    const neck =\n\n      Math.max(\n\n        42,\n\n        Math.min(\n\n          width - 42,\n\n          buttonRect.left +\n          buttonRect.width / 2 -\n          left\n\n        )\n\n      );\n\n\n    menu.style.width =\n      width + 'px';\n\n\n    menu.style.top =\n      (\n        navRect.bottom +\n        9\n      ) + 'px';\n\n\n    menu.style.maxHeight =\n\n      Math.max(\n\n        240,\n\n        window.innerHeight -\n        navRect.bottom -\n        21\n\n      ) + 'px';\n\n\n    menu.style.setProperty(\n\n      '--b80-neck',\n\n      neck + 'px'\n\n    );\n\n  }\n\n\n  /*\n  SMALL BUTTON JUMP\n  */\n\n  function jump(){\n\n    explore\n    .classList\n    .remove(\n      'b80-menu-jump'\n    );\n\n\n    void explore.offsetWidth;\n\n\n    explore\n    .classList\n    .add(\n      'b80-menu-jump'\n    );\n\n\n    setTimeout(\n      function(){\n\n        explore\n        .classList\n        .remove(\n          'b80-menu-jump'\n        );\n\n      },\n      450\n    );\n\n  }\n\n\n  /*\n  OPEN MENU\n  */\n\n  function openMenu(){\n\n    if(\n      !nav\n      .classList\n      .contains(\n        'is-product'\n      )\n    ){\n      return;\n    }\n\n\n    jump();\n\n    positionNav();\n\n    positionMenu();\n\n\n    menu\n    .classList\n    .add(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'false'\n    );\n\n\n    explore.setAttribute(\n      'aria-expanded',\n      'true'\n    );\n\n\n    menuOpen = true;\n\n  }\n\n\n  /*\n  CLOSE MENU\n  */\n\n  function closeMenu(){\n\n    menu\n    .classList\n    .remove(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'true'\n    );\n\n\n    explore.setAttribute(\n      'aria-expanded',\n      'false'\n    );\n\n\n    menuOpen = false;\n\n  }\n\n\n  /*\n  ONLY THIS EXPLORE\n  OPENS THE MENU\n  */\n\n  explore\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      event.preventDefault();\n\n      event.stopPropagation();\n\n\n      if(menuOpen){\n\n        jump();\n\n        closeMenu();\n\n      }\n\n      else{\n\n        openMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  CLOSE X\n  */\n\n  close\n  .addEventListener(\n    'click',\n    closeMenu\n  );\n\n\n  /*\n  MENU SECTION LINKS\n  */\n\n  menu\n  .querySelectorAll(\n    'a[href^=\"#\"]'\n  )\n  .forEach(\n    function(link){\n\n\n      link\n      .addEventListener(\n        'click',\n        function(event){\n\n\n          event.preventDefault();\n\n\n          let target =\n            null;\n\n\n          const href =\n            link.getAttribute(\n              'href'\n            );\n\n\n          try{\n\n            target =\n              document\n              .querySelector(\n                href\n              );\n\n          }\n\n          catch(error){}\n\n\n          /*\n          UNTIL YOUR FINAL SECTION IDS\n          EXIST, FALL BACK TO #bullet-next\n          */\n\n          if(\n            !target &&\n            link.dataset.fallback\n          ){\n\n            try{\n\n              target =\n                document\n                .querySelector(\n                  link.dataset.fallback\n                );\n\n            }\n\n            catch(error){}\n\n          }\n\n\n          closeMenu();\n\n\n          if(target){\n\n            setTimeout(\n              function(){\n\n                target\n                .scrollIntoView({\n                  behavior:'smooth',\n                  block:'start'\n                });\n\n              },\n              100\n            );\n\n          }\n\n\n        }\n      );\n\n\n    }\n  );\n\n\n  /*\n  CLICK OUTSIDE\n  */\n\n  document\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      if(\n        menuOpen &&\n        !menu.contains(\n          event.target\n        ) &&\n        !explore.contains(\n          event.target\n        )\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  ESCAPE\n  */\n\n  document\n  .addEventListener(\n    'keydown',\n    function(event){\n\n\n      if(\n        event.key ===\n        'Escape'\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n  /*\n  STANDARD RAF UPDATE\n  */\n\n  function update(){\n\n    positionNav();\n\n    updateState();\n\n\n    if(menuOpen){\n      positionMenu();\n    }\n\n\n    rafBusy = false;\n\n  }\n\n\n  function requestUpdate(){\n\n    if(rafBusy){\n      return;\n    }\n\n\n    rafBusy = true;\n\n\n    requestAnimationFrame(\n      update\n    );\n\n  }\n\n\n  /*\n  CONTINUOUS TRACKING DURING\n  SHOPIFY HEADER SLIDE\n  */\n\n  function track(\n    milliseconds\n  ){\n\n    trackingUntil =\n      Math.max(\n\n        trackingUntil,\n\n        performance.now() +\n        milliseconds\n\n      );\n\n\n    requestAnimationFrame(\n      follow\n    );\n\n  }\n\n\n  function follow(){\n\n    positionNav();\n\n    updateState();\n\n\n    if(menuOpen){\n      positionMenu();\n    }\n\n\n    if(\n      performance.now() <\n      trackingUntil\n    ){\n\n      requestAnimationFrame(\n        follow\n      );\n\n    }\n\n  }\n\n\n  /*\n  SCROLL\n  */\n\n  window\n  .addEventListener(\n    'scroll',\n    function(){\n\n      requestUpdate();\n\n      /*\n      Keeps tracking while the Shopify\n      sticky header animates down/up.\n      */\n\n      track(\n        700\n      );\n\n    },\n    {\n      passive:true\n    }\n  );\n\n\n  /*\n  RESIZE\n  */\n\n  window\n  .addEventListener(\n    'resize',\n    function(){\n\n      requestUpdate();\n\n      track(\n        500\n      );\n\n    }\n  );\n\n\n  /*\n  WATCH HEADER HEIGHT CHANGES\n  */\n\n  if(\n    'ResizeObserver'\n    in window\n  ){\n\n    const observer =\n      new ResizeObserver(\n        function(){\n\n          track(\n            500\n          );\n\n        }\n      );\n\n\n    headerSelectors\n    .forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              element !== nav &&\n              !element.contains(nav)\n            ){\n\n              observer.observe(\n                element\n              );\n\n            }\n\n\n          }\n        );\n\n\n      }\n    );\n\n  }\n\n\n  /*\n  INITIAL LOAD\n  */\n\n  positionNav();\n\n  updateState();\n\n\n  /*\n  Shopify header initializes\n  after page render, so keep\n  watching initially.\n  */\n\n  track(\n    1500\n  );\n\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_6T9YpH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .bullet-xiaomi-wrap {\n    background: #000000;\n    width: 100%;\n    padding: 80px 20px;\n  }\n\n  .bullet-xiaomi-grid {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-template-rows:\n      330px\n      300px\n      145px\n      145px;\n\n    gap: 16px;\n  }\n\n  /* =========================================\n     BASIC CARD\n  ========================================= */\n\n  .bx-card {\n    position: relative;\n    overflow: hidden;\n    border-radius: 24px;\n    background: #03050a;\n    isolation: isolate;\n  }\n\n  .bx-card img {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n\n    display: block;\n\n    z-index: 0;\n  }\n\n  /* subtle darkening if text needs contrast */\n  .bx-card::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n\n    z-index: 1;\n    pointer-events: none;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0,0,0,.10) 0%,\n        rgba(0,0,0,0) 55%,\n        rgba(0,0,0,.10) 100%\n      );\n  }\n\n\n  /* =========================================\n     GRID POSITIONS\n  ========================================= */\n\n  /* BIG TOP CARD */\n  .bx-card-1 {\n    grid-column: 1 / 3;\n    grid-row: 1;\n  }\n\n  /* SECOND ROW */\n  .bx-card-2 {\n    grid-column: 1;\n    grid-row: 2;\n  }\n\n  .bx-card-3 {\n    grid-column: 2;\n    grid-row: 2;\n  }\n\n  /* BIG TALL LEFT CARD */\n  .bx-card-4 {\n    grid-column: 1;\n    grid-row: 3 / 5;\n  }\n\n  /* RIGHT SMALL CARDS */\n  .bx-card-5 {\n    grid-column: 2;\n    grid-row: 3;\n  }\n\n  .bx-card-6 {\n    grid-column: 2;\n    grid-row: 4;\n  }\n\n\n  /* =========================================\n     TEXT\n  ========================================= */\n\n  .bx-copy {\n    position: absolute;\n    z-index: 5;\n\n    color: #ffffff;\n  }\n\n  .bx-copy h3 {\n    padding: 0;\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 25px;\n    line-height: 1.05;\n\n    font-weight: 650;\n    letter-spacing: -0.03em;\n  }\n\n  .bx-copy p {\n    padding: 0;\n    margin: 9px 0 0;\n\n    color: rgba(255,255,255,.62);\n\n    font-size: 15px;\n    line-height: 1.35;\n\n    font-weight: 400;\n  }\n\n\n  /* =========================================\n     TEXT POSITIONS\n  ========================================= */\n\n  .bx-top-left {\n    left: 6%;\n    top: 8%;\n  }\n\n  .bx-top-right {\n    right: 6%;\n    top: 8%;\n  }\n\n  .bx-center-right {\n    right: 8%;\n    top: 50%;\n    transform: translateY(-50%);\n  }\n\n  .bx-center-left {\n    left: 8%;\n    top: 50%;\n    transform: translateY(-50%);\n  }\n\n  .bx-bottom-left {\n    left: 6%;\n    bottom: 8%;\n  }\n\n  .bx-bottom-right {\n    right: 6%;\n    bottom: 8%;\n  }\n\n\n  /* =========================================\n     TOP CARD TEXT\n  ========================================= */\n\n  .bx-card-1 .bx-copy {\n    max-width: 340px;\n  }\n\n  .bx-card-1 .bx-copy h3 {\n    font-size: 29px;\n  }\n\n  .bx-card-1 .bx-copy p {\n    font-size: 17px;\n  }\n\n\n  /* =========================================\n     SMALL RIGHT CARDS\n  ========================================= */\n\n  .bx-card-5 .bx-copy,\n  .bx-card-6 .bx-copy {\n    max-width: 44%;\n  }\n\n  .bx-card-5 .bx-copy h3,\n  .bx-card-6 .bx-copy h3 {\n    font-size: 20px;\n  }\n\n  .bx-card-5 .bx-copy p,\n  .bx-card-6 .bx-copy p {\n    font-size: 12px;\n    margin-top: 6px;\n  }\n\n\n  /* =========================================\n     TABLET\n  ========================================= */\n\n  @media screen and (max-width: 990px) {\n\n    .bullet-xiaomi-grid {\n      max-width: 760px;\n\n      grid-template-rows:\n        260px\n        250px\n        130px\n        130px;\n    }\n\n    .bx-card {\n      border-radius: 20px;\n    }\n\n    .bx-copy h3 {\n      font-size: 20px;\n    }\n\n    .bx-copy p {\n      font-size: 13px;\n    }\n  }\n\n\n  /* =========================================\n     MOBILE\n  ========================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .bullet-xiaomi-wrap {\n      padding: 30px 12px;\n    }\n\n    .bullet-xiaomi-grid {\n      display: flex;\n      flex-direction: column;\n\n      width: 100%;\n      max-width: none;\n\n      gap: 12px;\n    }\n\n    .bx-card {\n      width: 100%;\n      min-height: 330px;\n      border-radius: 18px;\n    }\n\n    .bx-card-1 {\n      min-height: 260px;\n    }\n\n    .bx-card-4 {\n      min-height: 430px;\n    }\n\n    .bx-card-5,\n    .bx-card-6 {\n      min-height: 230px;\n    }\n\n    .bx-copy {\n      left: 22px !important;\n      right: auto !important;\n      top: 22px !important;\n      bottom: auto !important;\n\n      transform: none !important;\n\n      max-width: calc(100% - 44px) !important;\n    }\n\n    .bx-copy h3,\n    .bx-card-1 .bx-copy h3,\n    .bx-card-5 .bx-copy h3,\n    .bx-card-6 .bx-copy h3 {\n      font-size: 22px;\n    }\n\n    .bx-copy p,\n    .bx-card-1 .bx-copy p,\n    .bx-card-5 .bx-copy p,\n    .bx-card-6 .bx-copy p {\n      font-size: 14px;\n    }\n  }\n</style>\n\n\n\n<div class=\"bullet-xiaomi-wrap\">\n\n  <div class=\"bullet-xiaomi-grid\">\n\n\n    <!-- =====================================================\n         CARD 1\n         LARGE FULL WIDTH CARD\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-1\">\n\n      <img\n        src=\"PASTE-IMAGE-1-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          5.9 MM SHAFT\n        </h3>\n\n        <p>\n          Built for faster release.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         CARD 2\n         LEFT CARD\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-2\">\n\n      <img\n        src=\"PASTE-IMAGE-2-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          CNTRL Foam.\n        </h3>\n\n        <p>\n          Shock stops here.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         CARD 3\n         RIGHT CARD\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-3\">\n\n      <img\n        src=\"PASTE-IMAGE-3-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          Curve² Frame.\n        </h3>\n\n        <p>\n          Sweet spot expanded.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         CARD 4\n         LARGE TALL LEFT CARD\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-4\">\n\n      <img\n        src=\"PASTE-IMAGE-4-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-top-left\">\n\n        <h3>\n          M46X Carbon Fibre\n        </h3>\n\n        <p>\n          Engineered for attacking response.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         CARD 5\n         SMALL RIGHT TOP\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-5\">\n\n      <img\n        src=\"PASTE-IMAGE-5-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Attack Ready\n        </h3>\n\n        <p>\n          Power on a hair trigger.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         CARD 6\n         SMALL RIGHT BOTTOM\n    ====================================================== -->\n\n    <div class=\"bx-card bx-card-6\">\n\n      <img\n        src=\"PASTE-IMAGE-6-URL-HERE\"\n        alt=\"\"\n        loading=\"lazy\"\n      >\n\n      <div class=\"bx-copy bx-center-right\">\n\n        <h3>\n          Built Faster\n        </h3>\n\n        <p>\n          Ready for the next shot.\n        </p>\n\n      </div>\n\n    </div>\n\n\n  </div>\n\n</div>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
