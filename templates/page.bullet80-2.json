    "custom_liquid_gbxy7j": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET\nGET THE HIGHLIGHTS\nPREMIUM SCROLLABLE CAROUSEL\n{% endcomment %}\n\n{% assign hl_frame_img = '' %}\n{% assign hl_shaft_img = '' %}\n{% assign hl_tfuse_img = '' %}\n{% assign hl_foam_img = '' %}\n{% assign hl_athlete_img = '' %}\n\n{% assign film_link = '#' %}\n{% assign buy_link = '#' %}\n\n\n<section id=\"bullet-highlights\" class=\"b80h\">\n\n  <!-- HEADER -->\n\n  <div class=\"b80h-head\">\n\n    <h2>Get the highlights.</h2>\n\n    <a href=\"{{ film_link }}\" class=\"b80h-watch\">\n      <span>Watch the film</span>\n\n      <span class=\"b80h-watch-icon\">\n        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n          <path d=\"M8 6.5L13.5 10L8 13.5V6.5Z\"/>\n        </svg>\n      </span>\n    </a>\n\n  </div>\n\n\n  <!-- PRODUCT BAR -->\n\n  <div class=\"b80h-stickybar\">\n\n    <span class=\"b80h-stickybar-name\">\n      Nitrix 80 Bullet\n    </span>\n\n    <div class=\"b80h-stickybar-actions\">\n\n      <a\n        href=\"#bullet-specs\"\n        class=\"b80h-pill b80h-pill-ghost\"\n      >\n        Explore\n      </a>\n\n      <a\n        href=\"{{ buy_link }}\"\n        class=\"b80h-pill b80h-pill-solid\"\n      >\n        Buy\n      </a>\n\n    </div>\n\n  </div>\n\n\n\n  <!-- CAROUSEL -->\n\n  <div\n    class=\"b80h-track-wrap\"\n    id=\"b80h-track-wrap\"\n  >\n\n    <div\n      class=\"b80h-track\"\n      id=\"b80h-track\"\n    >\n\n\n      <!-- 01 -->\n\n      <article\n        class=\"b80h-slide is-current\"\n        data-index=\"0\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n          <div class=\"b80h-number\">\n            01\n          </div>\n\n          <p class=\"b80h-slide-copy\">\n            Aerospace-grade AECG+ carbon frame,<br>\n            built for exceptional pro capability.\n          </p>\n\n          <div class=\"b80h-slide-media\">\n\n            {% if hl_frame_img != blank %}\n\n              <img\n                src=\"{{ hl_frame_img | img_url: '1400x' }}\"\n                alt=\"Nitrix 80 Bullet Frame\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"b80h-media-fallback\">\n                <div class=\"b80h-aura\"></div>\n              </div>\n\n            {% endif %}\n\n          </div>\n\n        </div>\n\n      </article>\n\n\n\n      <!-- 02 -->\n\n      <article\n        class=\"b80h-slide\"\n        data-index=\"1\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n          <div class=\"b80h-number\">\n            02\n          </div>\n\n          <p class=\"b80h-slide-copy\">\n            5.9mm VaporShaft.<br>\n            The thinnest shaft HNDRD has ever made.\n          </p>\n\n          <div class=\"b80h-slide-media\">\n\n            {% if hl_shaft_img != blank %}\n\n              <img\n                src=\"{{ hl_shaft_img | img_url: '1400x' }}\"\n                alt=\"Nitrix 80 Bullet 5.9mm Shaft\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"b80h-media-fallback\">\n                <div class=\"b80h-aura\"></div>\n              </div>\n\n            {% endif %}\n\n          </div>\n\n        </div>\n\n      </article>\n\n\n\n      <!-- 03 -->\n\n      <article\n        class=\"b80h-slide\"\n        data-index=\"2\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n          <div class=\"b80h-number\">\n            03\n          </div>\n\n          <p class=\"b80h-slide-copy\">\n            Resist the twist.<br>\n            T Fuse controls torsion right where it counts.\n          </p>\n\n          <div class=\"b80h-slide-media\">\n\n            {% if hl_tfuse_img != blank %}\n\n              <img\n                src=\"{{ hl_tfuse_img | img_url: '1400x' }}\"\n                alt=\"Nitrix 80 Bullet T Fuse\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"b80h-media-fallback\">\n                <div class=\"b80h-aura\"></div>\n              </div>\n\n            {% endif %}\n\n\n            <!-- FLEX SELECTOR -->\n\n            <div class=\"b80h-chip-row\">\n\n              <span>\n                Hard\n              </span>\n\n              <span class=\"is-active\">\n                Mid\n              </span>\n\n              <span>\n                Soft\n              </span>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </article>\n\n\n\n      <!-- 04 -->\n\n      <article\n        class=\"b80h-slide\"\n        data-index=\"3\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n          <div class=\"b80h-number\">\n            04\n          </div>\n\n          <p class=\"b80h-slide-copy\">\n            Shock stops here,<br>\n            before it ever reaches your hand.\n          </p>\n\n          <div class=\"b80h-slide-media\">\n\n            {% if hl_foam_img != blank %}\n\n              <img\n                src=\"{{ hl_foam_img | img_url: '1400x' }}\"\n                alt=\"Nitrix 80 Bullet CNTRL Foam\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"b80h-media-fallback\">\n                <div class=\"b80h-aura\"></div>\n              </div>\n\n            {% endif %}\n\n          </div>\n\n        </div>\n\n      </article>\n\n\n\n      <!-- 05 -->\n\n      <article\n        class=\"b80h-slide\"\n        data-index=\"4\"\n      >\n\n        <div class=\"b80h-slide-inner\">\n\n          <div class=\"b80h-card-glow\"></div>\n\n          <div class=\"b80h-number\">\n            05\n          </div>\n\n          <p class=\"b80h-slide-copy\">\n            Built to attack.<br>\n            Trusted by ranked professionals worldwide.\n          </p>\n\n          <div class=\"b80h-slide-media\">\n\n            {% if hl_athlete_img != blank %}\n\n              <img\n                src=\"{{ hl_athlete_img | img_url: '1400x' }}\"\n                alt=\"Nitrix 80 Bullet Athletes\"\n                loading=\"lazy\"\n              >\n\n            {% else %}\n\n              <div class=\"b80h-media-fallback\">\n                <div class=\"b80h-aura\"></div>\n              </div>\n\n            {% endif %}\n\n          </div>\n\n        </div>\n\n      </article>\n\n\n    </div>\n\n  </div>\n\n\n\n  <!-- PREMIUM CONTROL DOCK -->\n\n  <div class=\"b80h-controls\">\n\n    <div\n      class=\"b80h-dots\"\n      id=\"b80h-dots\"\n    >\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot is-active\"\n        data-i=\"0\"\n        aria-label=\"Slide 1\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"1\"\n        aria-label=\"Slide 2\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"2\"\n        aria-label=\"Slide 3\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"3\"\n        aria-label=\"Slide 4\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n      <button\n        type=\"button\"\n        class=\"b80h-dot\"\n        data-i=\"4\"\n        aria-label=\"Slide 5\"\n      >\n        <span class=\"b80h-dot-fill\"></span>\n      </button>\n\n    </div>\n\n\n    <span class=\"b80h-control-separator\"></span>\n\n\n    <button\n      type=\"button\"\n      class=\"b80h-playpause\"\n      id=\"b80h-playpause\"\n      aria-label=\"Pause\"\n    >\n\n      <svg\n        class=\"b80h-icon-pause\"\n        viewBox=\"0 0 20 20\"\n        aria-hidden=\"true\"\n      >\n        <rect\n          x=\"6\"\n          y=\"5\"\n          width=\"2.4\"\n          height=\"10\"\n          rx=\"1.2\"\n        />\n\n        <rect\n          x=\"11.6\"\n          y=\"5\"\n          width=\"2.4\"\n          height=\"10\"\n          rx=\"1.2\"\n        />\n      </svg>\n\n\n      <svg\n        class=\"b80h-icon-play\"\n        viewBox=\"0 0 20 20\"\n        aria-hidden=\"true\"\n      >\n        <path\n          d=\"M7.5 5.5L14.5 10L7.5 14.5V5.5Z\"\n        />\n      </svg>\n\n    </button>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n#bullet-highlights,\n#bullet-highlights *{\n  box-sizing:border-box;\n}\n\n\n/* ========================================\n   SECTION\n======================================== */\n\n#bullet-highlights{\n  --b80-blue:#42aee8;\n  --b80-blue-bright:#69cfff;\n\n  position:relative;\n\n  width:100%;\n\n  padding:\n    clamp(72px,8vw,110px)\n    0\n    clamp(56px,6vw,82px);\n\n  background:#000;\n\n  color:#fff;\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  overflow:hidden;\n\n  isolation:isolate;\n}\n\n\n/* subtle ambient atmosphere */\n\n#bullet-highlights::before{\n  content:\"\";\n\n  position:absolute;\n\n  z-index:-1;\n\n  width:900px;\n  height:620px;\n\n  left:50%;\n  top:330px;\n\n  transform:\n    translateX(-50%);\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(40,150,210,.08),\n      rgba(20,90,140,.025) 38%,\n      transparent 70%\n    );\n\n  filter:blur(50px);\n\n  pointer-events:none;\n}\n\n\n\n/* ========================================\n   HEADER\n======================================== */\n\n.b80h-head{\n\n  width:100%;\n  max-width:1160px;\n\n  margin:\n    0 auto\n    34px;\n\n  padding:\n    0 24px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:space-between;\n\n  gap:20px;\n}\n\n\n.b80h-head h2{\n\n  margin:0;\n\n  color:#f5f5f7;\n\n  font-family:\n    \"Iowan Old Style\",\n    Baskerville,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      34px,\n      4vw,\n      52px\n    );\n\n  line-height:1;\n\n  font-weight:400;\n\n  letter-spacing:-.045em;\n}\n\n\n/* WATCH FILM */\n\n.b80h-watch{\n\n  display:flex;\n\n  align-items:center;\n\n  gap:9px;\n\n  color:\n    rgba(120,210,255,.9);\n\n  text-decoration:none;\n\n  font-size:13px;\n\n  font-weight:500;\n\n  transition:\n    color .3s ease,\n    opacity .3s ease;\n}\n\n\n.b80h-watch:hover{\n  color:#fff;\n}\n\n\n.b80h-watch-icon{\n\n  width:22px;\n  height:22px;\n\n  display:grid;\n\n  place-items:center;\n\n  border-radius:50%;\n\n  background:\n    rgba(66,174,232,.12);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.07);\n\n  transition:\n    transform .3s\n    cubic-bezier(.2,.8,.2,1),\n    background .3s ease;\n}\n\n\n.b80h-watch:hover\n.b80h-watch-icon{\n\n  transform:\n    translateX(2px);\n\n  background:\n    rgba(66,174,232,.2);\n}\n\n\n.b80h-watch svg{\n\n  width:11px;\n  height:11px;\n\n  fill:currentColor;\n\n  stroke:none;\n}\n\n\n\n/* ========================================\n   PRODUCT BAR\n======================================== */\n\n.b80h-stickybar{\n\n  position:sticky;\n\n  top:10px;\n\n  z-index:30;\n\n  width:\n    calc(100% - 48px);\n\n  max-width:1160px;\n\n  min-height:50px;\n\n  margin:\n    0 auto;\n\n  padding:\n    8px 10px\n    8px 18px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:space-between;\n\n  gap:18px;\n\n  border-radius:18px;\n\n  background:\n    rgba(14,14,16,.68);\n\n  backdrop-filter:\n    blur(24px)\n    saturate(135%);\n\n  -webkit-backdrop-filter:\n    blur(24px)\n    saturate(135%);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.06),\n    0 12px 40px\n    rgba(0,0,0,.30);\n}\n\n\n.b80h-stickybar-name{\n\n  font-size:14px;\n\n  line-height:1;\n\n  font-weight:600;\n\n  letter-spacing:-.025em;\n\n  color:\n    rgba(255,255,255,.92);\n}\n\n\n.b80h-stickybar-actions{\n\n  display:flex;\n\n  align-items:center;\n\n  gap:6px;\n}\n\n\n.b80h-pill{\n\n  min-height:30px;\n\n  padding:\n    0 14px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:999px;\n\n  text-decoration:none;\n\n  font-size:11.5px;\n\n  line-height:1;\n\n  font-weight:600;\n\n  transition:\n    transform .25s\n    cubic-bezier(.2,.8,.2,1),\n    background .25s ease,\n    color .25s ease;\n}\n\n\n.b80h-pill-ghost{\n\n  color:\n    rgba(255,255,255,.76);\n\n  background:\n    rgba(255,255,255,.055);\n}\n\n\n.b80h-pill-ghost:hover{\n\n  color:#fff;\n\n  background:\n    rgba(255,255,255,.10);\n}\n\n\n.b80h-pill-solid{\n\n  color:#031014;\n\n  background:\n    linear-gradient(\n      180deg,\n      #70d3ff,\n      var(--b80-blue)\n    );\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.35),\n    0 4px 14px\n    rgba(66,174,232,.16);\n}\n\n\n.b80h-pill-solid:hover{\n\n  transform:\n    scale(1.035);\n}\n\n\n\n/* ========================================\n   CAROUSEL VIEWPORT\n======================================== */\n\n.b80h-track-wrap{\n\n  --b80h-viewport:\n    min(100vw,1160px);\n\n  --b80h-card-width:\n    min(82vw,900px);\n\n  position:relative;\n\n  width:100%;\n  max-width:1160px;\n\n  margin:\n    26px auto 0;\n\n  padding:0;\n\n  overflow-x:auto;\n  overflow-y:hidden;\n\n  scroll-snap-type:\n    x mandatory;\n\n  scroll-behavior:smooth;\n\n  overscroll-behavior-x:\n    contain;\n\n  -webkit-overflow-scrolling:\n    touch;\n\n  scrollbar-width:none;\n\n  cursor:grab;\n}\n\n\n.b80h-track-wrap::-webkit-scrollbar{\n  display:none;\n}\n\n\n.b80h-track-wrap:active{\n  cursor:grabbing;\n}\n\n\n\n/* ========================================\n   TRACK\n======================================== */\n\n.b80h-track{\n\n  display:flex;\n\n  align-items:stretch;\n\n  gap:18px;\n\n  width:max-content;\n\n  padding-left:\n    max(\n      24px,\n      calc(\n        (\n          var(--b80h-viewport)\n          -\n          var(--b80h-card-width)\n        ) / 2\n      )\n    );\n\n  padding-right:\n    max(\n      24px,\n      calc(\n        (\n          var(--b80h-viewport)\n          -\n          var(--b80h-card-width)\n        ) / 2\n      )\n    );\n\n  user-select:none;\n\n  -webkit-user-select:none;\n}\n\n\n\n/* ========================================\n   SLIDE\n======================================== */\n\n.b80h-slide{\n\n  position:relative;\n\n  flex:\n    0 0\n    var(--b80h-card-width);\n\n  width:\n    var(--b80h-card-width);\n\n  scroll-snap-align:center;\n\n  scroll-snap-stop:always;\n\n  opacity:.46;\n\n  transform:\n    scale(.965);\n\n  transition:\n    opacity .55s ease,\n    transform .65s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80h-slide.is-current{\n\n  opacity:1;\n\n  transform:\n    scale(1);\n}\n\n\n\n/* ========================================\n   PREMIUM CARD\n======================================== */\n\n.b80h-slide-inner{\n\n  position:relative;\n\n  min-height:430px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:20px;\n\n  padding:\n    46px\n    34px\n    34px;\n\n  overflow:hidden;\n\n  border-radius:28px;\n\n  background:\n    radial-gradient(\n      circle at 50% 75%,\n      rgba(35,115,160,.075),\n      transparent 42%\n    ),\n    linear-gradient(\n      155deg,\n      rgba(15,17,19,.96),\n      rgba(4,5,6,.995)\n    );\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.055),\n    inset 0 -1px 0\n    rgba(255,255,255,.012),\n    0 28px 80px\n    rgba(0,0,0,.45);\n\n  isolation:isolate;\n}\n\n\n/* soft internal sheen */\n\n.b80h-slide-inner::before{\n\n  content:\"\";\n\n  position:absolute;\n\n  z-index:0;\n\n  top:0;\n  left:12%;\n  right:12%;\n\n  height:1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.16),\n      transparent\n    );\n\n  opacity:.55;\n\n  pointer-events:none;\n}\n\n\n/* super subtle blue glow */\n\n.b80h-card-glow{\n\n  position:absolute;\n\n  z-index:0;\n\n  width:600px;\n  height:420px;\n\n  left:50%;\n  bottom:-260px;\n\n  transform:\n    translateX(-50%);\n\n  border-radius:50%;\n\n  background:\n    rgba(40,170,230,.065);\n\n  filter:\n    blur(85px);\n\n  opacity:.7;\n\n  pointer-events:none;\n}\n\n\n\n/* ========================================\n   CARD NUMBER\n======================================== */\n\n.b80h-number{\n\n  position:absolute;\n\n  z-index:4;\n\n  top:22px;\n  left:25px;\n\n  color:\n    rgba(255,255,255,.22);\n\n  font-size:10px;\n\n  line-height:1;\n\n  font-weight:600;\n\n  letter-spacing:.14em;\n}\n\n\n\n/* ========================================\n   CARD COPY\n======================================== */\n\n.b80h-slide-copy{\n\n  position:relative;\n\n  z-index:5;\n\n  max-width:650px;\n\n  margin:0;\n\n  text-align:center;\n\n  color:\n    rgba(255,255,255,.94);\n\n  font-size:\n    clamp(\n      17px,\n      2vw,\n      23px\n    );\n\n  line-height:1.32;\n\n  font-weight:600;\n\n  letter-spacing:-.025em;\n}\n\n\n\n/* ========================================\n   MEDIA\n======================================== */\n\n.b80h-slide-media{\n\n  position:relative;\n\n  z-index:2;\n\n  width:100%;\n\n  max-width:780px;\n\n  height:265px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n}\n\n\n.b80h-slide-media img{\n\n  display:block;\n\n  max-width:100%;\n  max-height:100%;\n\n  object-fit:contain;\n\n  filter:\n    contrast(1.035)\n    brightness(.97);\n\n  pointer-events:none;\n\n  -webkit-user-drag:none;\n}\n\n\n\n/* FALLBACK */\n\n.b80h-media-fallback{\n\n  position:relative;\n\n  width:100%;\n  height:100%;\n}\n\n\n.b80h-aura{\n\n  position:absolute;\n\n  left:50%;\n  top:50%;\n\n  width:430px;\n  height:300px;\n\n  transform:\n    translate(-50%,-50%);\n\n  border-radius:50%;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(66,174,232,.10),\n      rgba(66,174,232,.025) 38%,\n      transparent 70%\n    );\n\n  filter:\n    blur(25px);\n}\n\n\n\n/* ========================================\n   FLEX SELECTOR\n======================================== */\n\n.b80h-chip-row{\n\n  position:absolute;\n\n  z-index:6;\n\n  left:50%;\n  bottom:10px;\n\n  transform:\n    translateX(-50%);\n\n  display:flex;\n\n  align-items:center;\n\n  gap:2px;\n\n  padding:4px;\n\n  border-radius:999px;\n\n  background:\n    rgba(18,18,20,.62);\n\n  backdrop-filter:\n    blur(18px)\n    saturate(140%);\n\n  -webkit-backdrop-filter:\n    blur(18px)\n    saturate(140%);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.055),\n    0 8px 28px\n    rgba(0,0,0,.24);\n}\n\n\n.b80h-chip-row span{\n\n  min-width:56px;\n\n  padding:\n    7px 12px;\n\n  border-radius:999px;\n\n  text-align:center;\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-size:10px;\n\n  line-height:1;\n\n  font-weight:600;\n\n  letter-spacing:.025em;\n\n  transition:\n    color .25s ease,\n    background .25s ease;\n}\n\n\n.b80h-chip-row\nspan.is-active{\n\n  color:#fff;\n\n  background:\n    rgba(66,174,232,.16);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.07);\n}\n\n\n\n/* ========================================\n   PREMIUM CONTROL DOCK\n======================================== */\n\n.b80h-controls{\n\n  width:max-content;\n\n  min-height:38px;\n\n  margin:\n    28px auto 0;\n\n  padding:\n    5px 6px\n    5px 10px;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:8px;\n\n  border-radius:999px;\n\n  background:\n    rgba(18,18,20,.72);\n\n  backdrop-filter:\n    blur(22px)\n    saturate(140%);\n\n  -webkit-backdrop-filter:\n    blur(22px)\n    saturate(140%);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.06),\n    0 10px 35px\n    rgba(0,0,0,.30);\n}\n\n\n\n/* DOT GROUP */\n\n.b80h-dots{\n\n  display:flex;\n\n  align-items:center;\n\n  gap:5px;\n}\n\n\n.b80h-dot{\n\n  position:relative;\n\n  width:13px;\n  height:4px;\n\n  margin:0;\n  padding:0;\n\n  border:0;\n\n  border-radius:999px;\n\n  background:\n    rgba(255,255,255,.17);\n\n  overflow:hidden;\n\n  cursor:pointer;\n\n  transition:\n    width .38s\n    cubic-bezier(.16,1,.3,1),\n    opacity .25s ease;\n}\n\n\n.b80h-dot:hover{\n\n  background:\n    rgba(255,255,255,.28);\n}\n\n\n.b80h-dot.is-active{\n\n  width:43px;\n\n  background:\n    rgba(255,255,255,.15);\n}\n\n\n.b80h-dot-fill{\n\n  position:absolute;\n\n  left:0;\n  top:0;\n\n  width:0%;\n  height:100%;\n\n  border-radius:inherit;\n\n  background:\n    linear-gradient(\n      90deg,\n      #8bdcff,\n      var(--b80-blue)\n    );\n}\n\n\n.b80h-dot.is-active\n.b80h-dot-fill{\n\n  animation:\n    b80hFill\n    linear\n    forwards;\n\n  animation-duration:\n    var(--b80h-duration,6s);\n}\n\n\n@keyframes b80hFill{\n\n  from{\n    width:0%;\n  }\n\n  to{\n    width:100%;\n  }\n\n}\n\n\n\n/* separator */\n\n.b80h-control-separator{\n\n  width:1px;\n  height:14px;\n\n  background:\n    rgba(255,255,255,.095);\n}\n\n\n\n/* PLAY / PAUSE */\n\n.b80h-playpause{\n\n  width:28px;\n  height:28px;\n\n  margin:0;\n\n  padding:0;\n\n  display:grid;\n\n  place-items:center;\n\n  border:0;\n\n  border-radius:50%;\n\n  background:transparent;\n\n  color:\n    rgba(255,255,255,.65);\n\n  cursor:pointer;\n\n  transition:\n    color .25s ease,\n    background .25s ease;\n}\n\n\n.b80h-playpause:hover{\n\n  color:#fff;\n\n  background:\n    rgba(255,255,255,.065);\n}\n\n\n.b80h-playpause svg{\n\n  width:10px;\n  height:10px;\n\n  fill:currentColor;\n}\n\n\n.b80h-icon-play{\n  display:none;\n}\n\n\n.b80h-playpause.is-paused\n.b80h-icon-play{\n  display:block;\n}\n\n\n.b80h-playpause.is-paused\n.b80h-icon-pause{\n  display:none;\n}\n\n\n\n/* ========================================\n   MOBILE\n======================================== */\n\n@media(max-width:750px){\n\n  #bullet-highlights{\n\n    padding:\n      66px 0\n      48px;\n  }\n\n\n  .b80h-head{\n\n    padding:\n      0 18px;\n\n    margin-bottom:26px;\n  }\n\n\n  .b80h-head h2{\n\n    font-size:\n      clamp(\n        31px,\n        9.5vw,\n        42px\n      );\n  }\n\n\n  .b80h-watch span:first-child{\n    display:none;\n  }\n\n\n  .b80h-watch-icon{\n\n    width:28px;\n    height:28px;\n  }\n\n\n  .b80h-stickybar{\n\n    width:\n      calc(100% - 24px);\n\n    top:8px;\n\n    padding:\n      7px 8px\n      7px 14px;\n\n    border-radius:16px;\n  }\n\n\n  .b80h-stickybar-name{\n\n    font-size:13px;\n  }\n\n\n  .b80h-track-wrap{\n\n    --b80h-viewport:\n      100vw;\n\n    --b80h-card-width:\n      88vw;\n\n    max-width:none;\n\n    margin-top:18px;\n  }\n\n\n  .b80h-track{\n\n    gap:12px;\n\n    padding-left:6vw;\n\n    padding-right:6vw;\n  }\n\n\n  .b80h-slide-inner{\n\n    min-height:390px;\n\n    border-radius:24px;\n\n    padding:\n      40px\n      18px\n      28px;\n  }\n\n\n  .b80h-slide-copy{\n\n    font-size:\n      17px;\n\n    line-height:1.35;\n  }\n\n\n  .b80h-slide-media{\n\n    height:225px;\n  }\n\n\n  .b80h-number{\n\n    top:18px;\n    left:18px;\n  }\n\n\n  .b80h-controls{\n\n    margin-top:22px;\n  }\n\n}\n\n\n\n/* ========================================\n   REDUCED MOTION\n======================================== */\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80h-slide,\n  .b80h-dot,\n  .b80h-dot-fill{\n\n    transition:none;\n\n    animation:none !important;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function(){\n\n  var section =\n    document.getElementById(\n      'bullet-highlights'\n    );\n\n  if(!section){\n    return;\n  }\n\n\n  var trackWrap =\n    document.getElementById(\n      'b80h-track-wrap'\n    );\n\n  var track =\n    document.getElementById(\n      'b80h-track'\n    );\n\n\n  var slides =\n    Array.prototype.slice.call(\n      track.querySelectorAll(\n        '.b80h-slide'\n      )\n    );\n\n\n  var dots =\n    Array.prototype.slice.call(\n      document.querySelectorAll(\n        '#b80h-dots .b80h-dot'\n      )\n    );\n\n\n  var playPauseBtn =\n    document.getElementById(\n      'b80h-playpause'\n    );\n\n\n  var slideCount =\n    slides.length;\n\n\n  var current = 0;\n\n  var isPaused = false;\n\n  var timer = null;\n\n  var DURATION = 6000;\n\n  var scrollEndTimer = null;\n\n  var programmaticScroll = false;\n\n\n  section.style.setProperty(\n    '--b80h-duration',\n    DURATION + 'ms'\n  );\n\n\n\n  /* ==========================\n     CARD POSITION\n  ========================== */\n\n  function getSlideLeft(index){\n\n    var slide =\n      slides[index];\n\n    if(!slide){\n      return 0;\n    }\n\n\n    var slideCenter =\n      slide.offsetLeft +\n      slide.offsetWidth / 2;\n\n\n    var viewportCenter =\n      trackWrap.clientWidth / 2;\n\n\n    return (\n      slideCenter -\n      viewportCenter\n    );\n\n  }\n\n\n\n  /* ==========================\n     ACTIVE CARD\n  ========================== */\n\n  function updateSlides(){\n\n    slides.forEach(\n      function(slide,i){\n\n        slide.classList.toggle(\n          'is-current',\n          i === current\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* ==========================\n     DOTS\n  ========================== */\n\n  function updateDots(\n    restartAnimation\n  ){\n\n    dots.forEach(\n      function(dot,i){\n\n        dot.classList.toggle(\n          'is-active',\n          i === current\n        );\n\n\n        var fill =\n          dot.querySelector(\n            '.b80h-dot-fill'\n          );\n\n\n        if(!fill){\n          return;\n        }\n\n\n        if(i === current){\n\n          if(restartAnimation){\n\n            fill.style.animation =\n              'none';\n\n            void fill.offsetWidth;\n\n            fill.style.animation =\n              '';\n\n            fill.style.animationPlayState =\n              isPaused\n                ? 'paused'\n                : 'running';\n\n          }\n\n        }else{\n\n          fill.style.animation =\n            'none';\n\n          fill.style.width =\n            i < current\n              ? '100%'\n              : '0%';\n\n        }\n\n      }\n    );\n\n  }\n\n\n\n  /* ==========================\n     TIMER\n  ========================== */\n\n  function restartTimer(){\n\n    if(timer){\n      clearTimeout(timer);\n    }\n\n\n    if(isPaused){\n      return;\n    }\n\n\n    timer =\n      setTimeout(\n        next,\n        DURATION\n      );\n\n  }\n\n\n\n  /* ==========================\n     GO TO CARD\n  ========================== */\n\n  function goTo(\n    index,\n    instant\n  ){\n\n    current =\n      (\n        (\n          index %\n          slideCount\n        )\n        +\n        slideCount\n      )\n      %\n      slideCount;\n\n\n    programmaticScroll =\n      true;\n\n\n    updateSlides();\n\n    updateDots(true);\n\n\n    trackWrap.scrollTo({\n      left:\n        getSlideLeft(current),\n\n      behavior:\n        instant\n          ? 'auto'\n          : 'smooth'\n    });\n\n\n    restartTimer();\n\n\n    setTimeout(\n      function(){\n\n        programmaticScroll =\n          false;\n\n      },\n\n      instant\n        ? 50\n        : 650\n    );\n\n  }\n\n\n\n  function next(){\n\n    if(\n      current >=\n      slideCount - 1\n    ){\n\n      goTo(0);\n\n    }else{\n\n      goTo(\n        current + 1\n      );\n\n    }\n\n  }\n\n\n\n  /* ==========================\n     PAUSE\n  ========================== */\n\n  function setPaused(\n    paused\n  ){\n\n    isPaused =\n      paused;\n\n\n    playPauseBtn\n      .classList\n      .toggle(\n        'is-paused',\n        paused\n      );\n\n\n    playPauseBtn\n      .setAttribute(\n        'aria-label',\n        paused\n          ? 'Play'\n          : 'Pause'\n      );\n\n\n    var activeFill =\n      document.querySelector(\n        '#b80h-dots .b80h-dot.is-active .b80h-dot-fill'\n      );\n\n\n    if(activeFill){\n\n      activeFill\n        .style\n        .animationPlayState =\n          paused\n            ? 'paused'\n            : 'running';\n\n    }\n\n\n    if(paused){\n\n      if(timer){\n        clearTimeout(timer);\n      }\n\n    }else{\n\n      restartTimer();\n\n    }\n\n  }\n\n\n\n  /* ==========================\n     DOT CLICKS\n  ========================== */\n\n  dots.forEach(\n    function(dot){\n\n      dot.addEventListener(\n        'click',\n        function(){\n\n          var index =\n            parseInt(\n              dot.dataset.i,\n              10\n            );\n\n          goTo(index);\n\n        }\n      );\n\n    }\n  );\n\n\n\n  playPauseBtn\n    .addEventListener(\n      'click',\n      function(){\n\n        setPaused(\n          !isPaused\n        );\n\n      }\n    );\n\n\n\n  /* ==========================\n     FIND CLOSEST CARD\n  ========================== */\n\n  function findClosestSlide(){\n\n    var viewportCenter =\n      trackWrap.scrollLeft +\n      trackWrap.clientWidth / 2;\n\n\n    var closestIndex = 0;\n\n    var closestDistance =\n      Infinity;\n\n\n    slides.forEach(\n      function(slide,i){\n\n        var slideCenter =\n          slide.offsetLeft +\n          slide.offsetWidth / 2;\n\n\n        var distance =\n          Math.abs(\n            viewportCenter -\n            slideCenter\n          );\n\n\n        if(\n          distance <\n          closestDistance\n        ){\n\n          closestDistance =\n            distance;\n\n          closestIndex = i;\n\n        }\n\n      }\n    );\n\n\n    return closestIndex;\n\n  }\n\n\n\n  /* ==========================\n     MANUAL SCROLL\n  ========================== */\n\n  trackWrap.addEventListener(\n    'scroll',\n    function(){\n\n      if(\n        programmaticScroll\n      ){\n        return;\n      }\n\n\n      clearTimeout(\n        scrollEndTimer\n      );\n\n\n      scrollEndTimer =\n        setTimeout(\n          function(){\n\n            var newIndex =\n              findClosestSlide();\n\n\n            if(\n              newIndex !==\n              current\n            ){\n\n              current =\n                newIndex;\n\n\n              updateSlides();\n\n              updateDots(true);\n\n              restartTimer();\n\n            }\n\n          },\n          90\n        );\n\n    },\n    {\n      passive:true\n    }\n  );\n\n\n\n  /* ==========================\n     DESKTOP DRAG\n  ========================== */\n\n  var dragging = false;\n\n  var dragStartX = 0;\n\n  var dragStartScroll = 0;\n\n  var dragMoved = false;\n\n\n\n  trackWrap.addEventListener(\n    'pointerdown',\n    function(event){\n\n      if(\n        event.pointerType ===\n        'touch'\n      ){\n        return;\n      }\n\n\n      dragging = true;\n\n      dragMoved = false;\n\n\n      dragStartX =\n        event.clientX;\n\n\n      dragStartScroll =\n        trackWrap.scrollLeft;\n\n\n      trackWrap\n        .setPointerCapture(\n          event.pointerId\n        );\n\n    }\n  );\n\n\n\n  trackWrap.addEventListener(\n    'pointermove',\n    function(event){\n\n      if(!dragging){\n        return;\n      }\n\n\n      var delta =\n        event.clientX -\n        dragStartX;\n\n\n      if(\n        Math.abs(delta) >\n        3\n      ){\n        dragMoved = true;\n      }\n\n\n      trackWrap.scrollLeft =\n        dragStartScroll -\n        delta;\n\n    }\n  );\n\n\n\n  function finishDrag(){\n\n    if(!dragging){\n      return;\n    }\n\n\n    dragging = false;\n\n\n    var index =\n      findClosestSlide();\n\n\n    goTo(index);\n\n  }\n\n\n\n  trackWrap.addEventListener(\n    'pointerup',\n    finishDrag\n  );\n\n\n  trackWrap.addEventListener(\n    'pointercancel',\n    finishDrag\n  );\n\n\n\n  /* ==========================\n     PREVENT CLICK AFTER DRAG\n  ========================== */\n\n  trackWrap.addEventListener(\n    'click',\n    function(event){\n\n      if(dragMoved){\n\n        event.preventDefault();\n\n        event.stopPropagation();\n\n        dragMoved = false;\n\n      }\n\n    },\n    true\n  );\n\n\n\n  /* ==========================\n     VISIBILITY\n  ========================== */\n\n  if(\n    'IntersectionObserver'\n    in window\n  ){\n\n    var observer =\n      new IntersectionObserver(\n\n        function(entries){\n\n          entries.forEach(\n            function(entry){\n\n              if(\n                entry.isIntersecting\n              ){\n\n                if(!isPaused){\n                  restartTimer();\n                }\n\n              }else{\n\n                if(timer){\n                  clearTimeout(timer);\n                }\n\n              }\n\n            }\n          );\n\n        },\n\n        {\n          threshold:.3\n        }\n\n      );\n\n\n    observer.observe(\n      section\n    );\n\n  }\n\n\n\n  /* ==========================\n     RESIZE\n  ========================== */\n\n  var resizeTimer = null;\n\n\n  window.addEventListener(\n    'resize',\n    function(){\n\n      clearTimeout(\n        resizeTimer\n      );\n\n\n      resizeTimer =\n        setTimeout(\n          function(){\n\n            goTo(\n              current,\n              true\n            );\n\n          },\n          120\n        );\n\n    }\n  );\n\n\n\n  /* ==========================\n     INIT\n  ========================== */\n\n  requestAnimationFrame(\n    function(){\n\n      goTo(\n        0,\n        true\n      );\n\n    }\n  );\n\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 52
      }
    },
    "custom_liquid_yCcbDH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET — 5.9MM SHAFT HERO\nReplace YOUR_RACKET_IMAGE_HERE with your actual image URL\n{% endcomment %}\n\n<section class=\"b80-shaft-hero\">\n\n  <div class=\"b80-shaft-wrap\">\n\n    <div class=\"b80-shaft-head\">\n\n      <h2>Thin hits harder.</h2>\n\n      <p>\n        The thinnest shaft in HNDRD’s history, built for faster response,\n        sharper handling, and explosive attack.\n      </p>\n\n    </div>\n\n\n    <div class=\"b80-shaft-stage\">\n\n      <div class=\"b80-shaft-visual\">\n\n        <img\n          src=\"YOUR_RACKET_IMAGE_HERE\"\n          alt=\"Nitrix 80 Bullet racket\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n\n      <div class=\"b80-shaft-specs\">\n\n        <div class=\"b80-shaft-stat\">\n\n          <span class=\"b80-shaft-stat-top\">\n            Just\n          </span>\n\n          <span class=\"b80-shaft-stat-main\">\n            5.9mm\n          </span>\n\n          <span class=\"b80-shaft-stat-bottom\">\n            VaporShaft\n          </span>\n\n        </div>\n\n\n        <div class=\"b80-shaft-stat\">\n\n          <span class=\"b80-shaft-stat-top\">\n            Built for\n          </span>\n\n          <span class=\"b80-shaft-stat-main\">\n            Faster\n          </span>\n\n          <span class=\"b80-shaft-stat-bottom\">\n            response and sharper handling\n          </span>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n  .b80-shaft-hero,\n  .b80-shaft-hero *{\n    box-sizing:border-box;\n  }\n\n\n  .b80-shaft-hero{\n    position:relative;\n    background:#000;\n    color:#fff;\n    overflow:hidden;\n    padding:72px 0 60px;\n    font-family:Arial, Helvetica, sans-serif;\n  }\n\n\n\n  /* ==========================\n     MAIN WRAPPER\n  ========================== */\n\n  .b80-shaft-wrap{\n    max-width:1440px;\n    margin:0 auto;\n  }\n\n\n\n  /* ==========================\n     HEADLINE\n  ========================== */\n\n  .b80-shaft-head{\n    max-width:1040px;\n    margin:0 auto 28px;\n    padding:0 20px;\n    text-align:center;\n  }\n\n\n  .b80-shaft-head h2{\n    margin:0;\n\n    font-size:\n      clamp(\n        42px,\n        7vw,\n        88px\n      );\n\n    line-height:.98;\n    font-weight:700;\n    letter-spacing:-.055em;\n\n    color:#f5f5f7;\n  }\n\n\n  .b80-shaft-head p{\n    margin:16px auto 0;\n    max-width:760px;\n\n    font-size:\n      clamp(\n        15px,\n        1.5vw,\n        19px\n      );\n\n    line-height:1.55;\n    font-weight:500;\n    letter-spacing:-.02em;\n\n    color:rgba(255,255,255,.72);\n  }\n\n\n\n  /* ==========================\n     STAGE\n  ========================== */\n\n  .b80-shaft-stage{\n    display:grid;\n\n    grid-template-columns:\n      minmax(0,1.25fr)\n      minmax(260px,.55fr);\n\n    align-items:center;\n\n    gap:18px;\n\n    min-height:580px;\n  }\n\n\n\n  /* ==========================\n     RACKET VISUAL\n  ========================== */\n\n  .b80-shaft-visual{\n    position:relative;\n\n    min-height:580px;\n\n    display:flex;\n    align-items:center;\n    justify-content:flex-start;\n\n    overflow:hidden;\n  }\n\n\n  .b80-shaft-visual img{\n    display:block;\n\n    width:\n      min(\n        1250px,\n        115%\n      );\n\n    max-width:none;\n    height:auto;\n\n    object-fit:contain;\n\n    transform:translateX(-14%);\n\n    filter:\n      drop-shadow(\n        0 10px 28px\n        rgba(0,0,0,.4)\n      );\n\n    user-select:none;\n    -webkit-user-drag:none;\n  }\n\n\n\n  /* ==========================\n     SPECS\n  ========================== */\n\n  .b80-shaft-specs{\n    position:relative;\n    z-index:2;\n\n    padding-right:40px;\n\n    display:flex;\n    flex-direction:column;\n\n    gap:44px;\n  }\n\n\n  .b80-shaft-stat{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-start;\n\n    gap:2px;\n  }\n\n\n  .b80-shaft-stat-top{\n    font-size:18px;\n    line-height:1.2;\n    font-weight:600;\n\n    color:rgba(255,255,255,.58);\n\n    letter-spacing:-.02em;\n  }\n\n\n  .b80-shaft-stat-main{\n    font-size:\n      clamp(\n        44px,\n        5vw,\n        68px\n      );\n\n    line-height:.95;\n    font-weight:700;\n    letter-spacing:-.05em;\n\n    color:#42A5FF;\n  }\n\n\n  .b80-shaft-stat-bottom{\n    font-size:18px;\n    line-height:1.3;\n    font-weight:600;\n\n    color:rgba(255,255,255,.72);\n\n    letter-spacing:-.02em;\n\n    max-width:260px;\n  }\n\n\n\n  /* ==========================\n     TABLET\n  ========================== */\n\n  @media(max-width:1100px){\n\n    .b80-shaft-stage{\n      grid-template-columns:1fr;\n      gap:8px;\n      min-height:auto;\n    }\n\n\n    .b80-shaft-visual{\n      min-height:auto;\n      justify-content:center;\n      padding:12px 0 0;\n    }\n\n\n    .b80-shaft-visual img{\n      width:min(1000px,120%);\n      transform:none;\n    }\n\n\n    .b80-shaft-specs{\n      padding:0 24px;\n\n      flex-direction:row;\n\n      gap:28px;\n\n      justify-content:center;\n\n      flex-wrap:wrap;\n    }\n\n\n    .b80-shaft-stat{\n      min-width:220px;\n    }\n\n  }\n\n\n\n  /* ==========================\n     MOBILE\n  ========================== */\n\n  @media(max-width:750px){\n\n    .b80-shaft-hero{\n      padding:54px 0 44px;\n    }\n\n\n    .b80-shaft-head{\n      margin-bottom:22px;\n      padding:0 16px;\n    }\n\n\n    .b80-shaft-head h2{\n      font-size:\n        clamp(\n          34px,\n          11vw,\n          54px\n        );\n\n      letter-spacing:-.06em;\n    }\n\n\n    .b80-shaft-head p{\n      margin-top:12px;\n\n      font-size:14px;\n\n      line-height:1.5;\n    }\n\n\n    .b80-shaft-stage{\n      gap:16px;\n    }\n\n\n    .b80-shaft-visual{\n      padding:0;\n    }\n\n\n    .b80-shaft-visual img{\n      width:145%;\n      transform:translateX(-8%);\n    }\n\n\n    .b80-shaft-specs{\n      padding:0 16px;\n\n      gap:22px;\n\n      flex-direction:column;\n\n      align-items:flex-start;\n    }\n\n\n    .b80-shaft-stat-top{\n      font-size:16px;\n    }\n\n\n    .b80-shaft-stat-main{\n      font-size:46px;\n    }\n\n\n    .b80-shaft-stat-bottom{\n      font-size:16px;\n      max-width:100%;\n    }\n\n  }\n\n</style>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 52
      }
