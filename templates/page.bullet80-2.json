    "custom_liquid_yCcbDH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\nNITRIX 80 BULLET — 5.9MM SHAFT HERO\n\nDESKTOP VIDEO:\nMain desktop/tablet video.\n\nMOBILE VIDEO:\nSeparate mobile video below 750px.\n\nBoth videos have rounded corners with NO visible border.\n{% endcomment %}\n\n\n{% assign desktop_video = 'https://cdn.shopify.com/videos/c/o/v/5d7a7e575061451d8208804b8b45602b.mp4' %}\n\n{% assign mobile_video = 'https://cdn.shopify.com/videos/c/o/v/e01d1c6f910b4bb7b6cf69a69027d217.mp4' %}\n\n{% assign poster_image = '' %}\n\n\n\n<section class=\"b80-shaft-hero\">\n\n  <div class=\"b80-shaft-wrap\">\n\n\n    <!-- ==========================================\n         HEADING\n    =========================================== -->\n\n    <div class=\"b80-shaft-head\">\n\n      <h2>\n        Thin hits harder.\n      </h2>\n\n      <p>\n        The thinnest shaft in HNDRD’s history, built for faster response,\n        sharper handling, and explosive attack.\n      </p>\n\n    </div>\n\n\n\n    <!-- ==========================================\n         MAIN STAGE\n    =========================================== -->\n\n    <div class=\"b80-shaft-stage\">\n\n\n      <!-- ==========================================\n           VIDEO\n      =========================================== -->\n\n      <div class=\"b80-shaft-visual\">\n\n        <video\n          class=\"b80-shaft-video\"\n\n          autoplay\n          muted\n          loop\n          playsinline\n          webkit-playsinline\n\n          preload=\"metadata\"\n\n          {% if poster_image != blank %}\n            poster=\"{{ poster_image }}\"\n          {% endif %}\n        >\n\n\n          <!-- MOBILE VIDEO -->\n\n          <source\n            src=\"{{ mobile_video }}\"\n            type=\"video/mp4\"\n            media=\"(max-width: 749px)\"\n          >\n\n\n          <!-- DESKTOP / TABLET -->\n\n          <source\n            src=\"{{ desktop_video }}\"\n            type=\"video/mp4\"\n          >\n\n\n        </video>\n\n      </div>\n\n\n\n      <!-- ==========================================\n           SPECS\n      =========================================== -->\n\n      <div class=\"b80-shaft-specs\">\n\n\n        <div class=\"b80-shaft-stat\">\n\n          <span class=\"b80-shaft-stat-top\">\n            Just\n          </span>\n\n          <span class=\"b80-shaft-stat-main\">\n            5.9mm\n          </span>\n\n          <span class=\"b80-shaft-stat-bottom\">\n            VaporShaft\n          </span>\n\n        </div>\n\n\n\n        <div class=\"b80-shaft-stat\">\n\n          <span class=\"b80-shaft-stat-top\">\n            Built for\n          </span>\n\n          <span class=\"b80-shaft-stat-main\">\n            Faster\n          </span>\n\n          <span class=\"b80-shaft-stat-bottom\">\n            response and sharper handling\n          </span>\n\n        </div>\n\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n  /* =========================================================\n     RESET\n  ========================================================= */\n\n  .b80-shaft-hero,\n  .b80-shaft-hero * {\n    box-sizing: border-box;\n  }\n\n\n\n  /* =========================================================\n     SECTION\n  ========================================================= */\n\n  .b80-shaft-hero {\n    position: relative;\n\n    width: 100%;\n\n    padding:\n      72px\n      0\n      60px;\n\n    background: #000;\n\n    color: #fff;\n\n    overflow: hidden;\n\n    font-family: inherit;\n  }\n\n\n  .b80-shaft-hero * {\n    font-family: inherit;\n  }\n\n\n\n  /* =========================================================\n     WRAPPER\n  ========================================================= */\n\n  .b80-shaft-wrap {\n    width: 100%;\n\n    max-width: 1440px;\n\n    margin: 0 auto;\n  }\n\n\n\n  /* =========================================================\n     HEADING\n  ========================================================= */\n\n  .b80-shaft-head {\n    position: relative;\n\n    z-index: 5;\n\n    width: 100%;\n\n    max-width: 1040px;\n\n    margin:\n      0 auto\n      26px;\n\n    padding:\n      0 20px;\n\n    text-align: center;\n  }\n\n\n  .b80-shaft-head h2 {\n    margin: 0;\n\n    color: #f5f5f7;\n\n    font-size:\n      clamp(\n        42px,\n        7vw,\n        88px\n      );\n\n    line-height: .98;\n\n    font-weight: 650;\n\n    letter-spacing: -.055em;\n  }\n\n\n  .b80-shaft-head p {\n    width: 100%;\n\n    max-width: 740px;\n\n    margin:\n      17px auto 0;\n\n    color:\n      rgba(255,255,255,.58);\n\n    font-size:\n      clamp(\n        15px,\n        1.5vw,\n        19px\n      );\n\n    line-height: 1.5;\n\n    font-weight: 400;\n\n    letter-spacing: -.015em;\n  }\n\n\n\n  /* =========================================================\n     STAGE\n  ========================================================= */\n\n  .b80-shaft-stage {\n    position: relative;\n\n    width: 100%;\n\n    display: grid;\n\n    grid-template-columns:\n      minmax(0,1.28fr)\n      minmax(280px,.52fr);\n\n    align-items: center;\n\n    gap: 16px;\n\n    min-height: 590px;\n  }\n\n\n\n  /* =========================================================\n     VIDEO CONTAINER\n  ========================================================= */\n\n  .b80-shaft-visual {\n    position: relative;\n\n    width: calc(100% - 28px);\n\n    min-width: 0;\n\n    min-height: 590px;\n\n    margin-left: 14px;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: flex-start;\n\n\n    /* =====================================\n       ROUNDED VIDEO\n    ====================================== */\n\n    overflow: hidden;\n\n    border-radius: 30px;\n\n    clip-path:\n      inset(\n        0\n        round\n        30px\n      );\n\n\n    /* Safari rounded video fix */\n\n    -webkit-mask-image:\n      -webkit-radial-gradient(\n        white,\n        black\n      );\n\n\n    transform:\n      translateZ(0);\n\n\n    /* NO BORDER */\n\n    border: 0 !important;\n\n    outline: 0 !important;\n\n    box-shadow: none !important;\n\n    background: transparent;\n\n    isolation: isolate;\n  }\n\n\n\n  /* =========================================================\n     SUBTLE BACKLIGHT\n  ========================================================= */\n\n  .b80-shaft-visual::before {\n    content: \"\";\n\n    position: absolute;\n\n    z-index: 0;\n\n    width: 80%;\n\n    height: 72%;\n\n    left: 28%;\n\n    top: 50%;\n\n    transform:\n      translate(-50%,-50%);\n\n    border-radius: 50%;\n\n    background:\n      radial-gradient(\n        ellipse,\n        rgba(255,255,255,.035),\n        rgba(255,255,255,.012) 38%,\n        transparent 72%\n      );\n\n    filter:\n      blur(35px);\n\n    pointer-events: none;\n  }\n\n\n\n  /* =========================================================\n     VIDEO\n  ========================================================= */\n\n  .b80-shaft-video {\n    position: relative;\n\n    z-index: 2;\n\n    display: block;\n\n    width: 118%;\n\n    max-width: none;\n\n    height: 590px;\n\n    margin: 0;\n\n    object-fit: contain;\n\n    object-position: center;\n\n    transform:\n      translateX(-11%);\n\n\n    /* =====================================\n       ROUND VIDEO ITSELF TOO\n    ====================================== */\n\n    border-radius: inherit;\n\n\n    /* NO BORDER */\n\n    border: none !important;\n\n    outline: none !important;\n\n    box-shadow: none !important;\n\n    background: transparent;\n\n\n    user-select: none;\n\n    -webkit-user-drag: none;\n\n    pointer-events: none;\n  }\n\n\n\n  /* =========================================================\n     REMOVE VIDEO CONTROLS\n  ========================================================= */\n\n  .b80-shaft-video::-webkit-media-controls {\n    display: none !important;\n  }\n\n  .b80-shaft-video::-webkit-media-controls-enclosure {\n    display: none !important;\n  }\n\n  .b80-shaft-video::-webkit-media-controls-panel {\n    display: none !important;\n  }\n\n  .b80-shaft-video::-webkit-media-controls-play-button {\n    display: none !important;\n  }\n\n  .b80-shaft-video::-webkit-media-controls-start-playback-button {\n    display: none !important;\n  }\n\n\n\n  /* =========================================================\n     SPECS\n  ========================================================= */\n\n  .b80-shaft-specs {\n    position: relative;\n\n    z-index: 5;\n\n    width: 100%;\n\n    padding-right:\n      clamp(\n        24px,\n        4vw,\n        56px\n      );\n\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: flex-start;\n\n    justify-content: center;\n\n    gap: 48px;\n  }\n\n\n  .b80-shaft-stat {\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: flex-start;\n\n    gap: 3px;\n  }\n\n\n  .b80-shaft-stat-top {\n    color:\n      rgba(255,255,255,.46);\n\n    font-size: 17px;\n\n    line-height: 1.2;\n\n    font-weight: 500;\n\n    letter-spacing: -.02em;\n  }\n\n\n  .b80-shaft-stat-main {\n    color: #42A5FF;\n\n    font-size:\n      clamp(\n        46px,\n        5vw,\n        70px\n      );\n\n    line-height: .95;\n\n    font-weight: 650;\n\n    letter-spacing: -.055em;\n  }\n\n\n  .b80-shaft-stat-bottom {\n    max-width: 275px;\n\n    color:\n      rgba(255,255,255,.65);\n\n    font-size: 17px;\n\n    line-height: 1.35;\n\n    font-weight: 500;\n\n    letter-spacing: -.02em;\n  }\n\n\n\n  /* =========================================================\n     TABLET\n  ========================================================= */\n\n  @media\n  (min-width:750px)\n  and\n  (max-width:1100px) {\n\n    .b80-shaft-stage {\n      grid-template-columns:\n        1fr;\n\n      gap: 12px;\n\n      min-height: auto;\n    }\n\n\n    .b80-shaft-visual {\n      width:\n        calc(100% - 40px);\n\n      min-height: 500px;\n\n      margin:\n        0 auto;\n\n      justify-content: center;\n\n\n      border-radius: 26px;\n\n      clip-path:\n        inset(\n          0\n          round\n          26px\n        );\n    }\n\n\n    .b80-shaft-video {\n      width: 108%;\n\n      height: 500px;\n\n      transform: none;\n\n      object-position: center;\n    }\n\n\n    .b80-shaft-specs {\n      padding:\n        12px\n        24px\n        0;\n\n      flex-direction: row;\n\n      align-items: flex-start;\n\n      justify-content: center;\n\n      gap:\n        clamp(\n          40px,\n          8vw,\n          100px\n        );\n\n      flex-wrap: wrap;\n    }\n\n\n    .b80-shaft-stat {\n      min-width: 220px;\n    }\n\n  }\n\n\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n\n  @media(max-width:749px) {\n\n    .b80-shaft-hero {\n      padding:\n        54px\n        0\n        48px;\n    }\n\n\n    .b80-shaft-head {\n      margin-bottom: 18px;\n\n      padding:\n        0 18px;\n    }\n\n\n    .b80-shaft-head h2 {\n      font-size:\n        clamp(\n          36px,\n          11vw,\n          54px\n        );\n\n      line-height: .98;\n\n      letter-spacing: -.055em;\n    }\n\n\n    .b80-shaft-head p {\n      max-width: 420px;\n\n      margin-top: 13px;\n\n      font-size: 14px;\n\n      line-height: 1.5;\n    }\n\n\n\n    /* =====================================\n       MOBILE STAGE\n    ====================================== */\n\n    .b80-shaft-stage {\n      display: block;\n\n      min-height: 0;\n    }\n\n\n\n    /* =====================================\n       MOBILE VIDEO\n       VERY CLEAR ROUNDING\n    ====================================== */\n\n    .b80-shaft-visual {\n      width:\n        calc(100% - 24px);\n\n      height: 470px;\n\n      min-height: 470px;\n\n      margin:\n        0 auto;\n\n\n      border-radius:\n        24px;\n\n\n      clip-path:\n        inset(\n          0\n          round\n          24px\n        );\n\n\n      overflow:\n        hidden;\n\n\n      -webkit-mask-image:\n        -webkit-radial-gradient(\n          white,\n          black\n        );\n\n\n      transform:\n        translateZ(0);\n\n\n      border:\n        0 !important;\n\n      outline:\n        0 !important;\n\n      box-shadow:\n        none !important;\n\n      justify-content:\n        center;\n    }\n\n\n    .b80-shaft-visual::before {\n      width: 100%;\n\n      height: 80%;\n\n      left: 50%;\n    }\n\n\n    .b80-shaft-video {\n      width: 100%;\n\n      height: 100%;\n\n      max-width: none;\n\n\n      /* Your mobile video gets its own crop */\n\n      object-fit:\n        cover;\n\n      object-position:\n        center;\n\n\n      transform:\n        none;\n\n\n      border-radius:\n        24px;\n\n\n      border:\n        0 !important;\n\n      outline:\n        0 !important;\n\n      box-shadow:\n        none !important;\n    }\n\n\n\n    /* =====================================\n       MOBILE SPECS\n    ====================================== */\n\n    .b80-shaft-specs {\n      padding:\n        30px\n        20px\n        0;\n\n      display: grid;\n\n      grid-template-columns:\n        repeat(\n          2,\n          minmax(0,1fr)\n        );\n\n      gap:\n        20px;\n    }\n\n\n    .b80-shaft-stat {\n      min-width: 0;\n\n      gap: 3px;\n    }\n\n\n    .b80-shaft-stat-top {\n      font-size: 13px;\n    }\n\n\n    .b80-shaft-stat-main {\n      font-size:\n        clamp(\n          36px,\n          11vw,\n          48px\n        );\n    }\n\n\n    .b80-shaft-stat-bottom {\n      max-width: 150px;\n\n      font-size: 13px;\n\n      line-height: 1.35;\n    }\n\n  }\n\n\n\n  /* =========================================================\n     SMALL MOBILE\n  ========================================================= */\n\n  @media(max-width:420px) {\n\n    .b80-shaft-visual {\n      width:\n        calc(100% - 20px);\n\n      height: 440px;\n\n      min-height: 440px;\n\n\n      border-radius:\n        22px;\n\n\n      clip-path:\n        inset(\n          0\n          round\n          22px\n        );\n    }\n\n\n    .b80-shaft-video {\n      width: 100%;\n\n      height: 100%;\n\n      border-radius:\n        22px;\n    }\n\n\n    .b80-shaft-specs {\n      grid-template-columns:\n        1fr;\n\n      gap:\n        23px;\n    }\n\n\n    .b80-shaft-stat-bottom {\n      max-width:\n        260px;\n    }\n\n  }\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  var sections =\n    document.querySelectorAll(\n      '.b80-shaft-hero'\n    );\n\n\n  sections.forEach(\n    function (section) {\n\n\n      var video =\n        section.querySelector(\n          '.b80-shaft-video'\n        );\n\n\n      if (!video) {\n        return;\n      }\n\n\n\n      /* ==========================================\n         FORCE AUTOPLAY\n      =========================================== */\n\n      video.muted =\n        true;\n\n\n      video.loop =\n        true;\n\n\n      video.setAttribute(\n        'muted',\n        ''\n      );\n\n\n      video.setAttribute(\n        'playsinline',\n        ''\n      );\n\n\n      video.setAttribute(\n        'webkit-playsinline',\n        ''\n      );\n\n\n\n      /* ==========================================\n         PLAY WHEN VISIBLE\n      =========================================== */\n\n      if (\n        'IntersectionObserver'\n        in window\n      ) {\n\n\n        var observer =\n          new IntersectionObserver(\n\n            function (entries) {\n\n\n              entries.forEach(\n                function (entry) {\n\n\n                  if (\n                    entry.isIntersecting\n                  ) {\n\n\n                    var playPromise =\n                      video.play();\n\n\n                    if (\n                      playPromise !==\n                      undefined\n                    ) {\n\n\n                      playPromise.catch(\n                        function () {}\n                      );\n\n\n                    }\n\n\n                  }\n\n                  else {\n\n\n                    video.pause();\n\n\n                  }\n\n\n                }\n              );\n\n\n            },\n\n            {\n              threshold: .18\n            }\n\n          );\n\n\n        observer.observe(\n          video\n        );\n\n\n      }\n\n      else {\n\n\n        var playPromise =\n          video.play();\n\n\n        if (\n          playPromise !==\n          undefined\n        ) {\n\n\n          playPromise.catch(\n            function () {}\n          );\n\n\n        }\n\n\n      }\n\n\n    }\n  );\n\n\n})();\n\n</script>",
