lore:hover{\n  background:\n    rgba(255,255,255,.075);\n\n  border-color:\n    rgba(255,255,255,.28);\n}\n\n\n.b80-product-explore:hover\n.b80-small-arrow svg{\n  transform:\n    translate(1.5px,-1.5px);\n}\n\n\n/* buy */\n\n.b80-buy{\n  height:32px;\n\n  min-width:56px;\n\n  padding:0 16px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#070809;\n\n  text-decoration:none;\n\n  font-size:10px;\n\n  font-weight:650;\n\n  transition:\n    transform .25s ease;\n}\n\n\n.b80-buy:hover{\n  transform:\n    scale(1.035);\n}\n\n\n/* =====================================================\n   TRACER\n===================================================== */\n\n.b80-nav-tracer{\n  position:absolute;\n\n  z-index:10;\n\n  bottom:0;\n\n  left:18px;\n  right:18px;\n\n  height:1px;\n\n  overflow:hidden;\n\n  opacity:0;\n\n  transition:\n    opacity .5s ease;\n}\n\n\n.b80-nav-tracer:before{\n  content:\"\";\n\n  position:absolute;\n\n  inset:0;\n\n  background:\n    rgba(255,255,255,.055);\n}\n\n\n.b80-nav-tracer span{\n  position:absolute;\n\n  left:-140px;\n\n  width:140px;\n  height:1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.75),\n      transparent\n    );\n\n  animation:\n    b80Tracer 3.4s\n    linear\n    infinite;\n}\n\n\n@keyframes b80Tracer{\n\n  from{\n    left:-140px;\n  }\n\n  to{\n    left:110%;\n  }\n\n}\n\n\n/* =====================================================\n   MORPH STATE\n===================================================== */\n\n.b80-nav.is-product{\n\n  width:\n    calc(100vw - 24px);\n\n  height:54px;\n\n  border-radius:18px;\n\n  background:\n    linear-gradient(\n      115deg,\n      rgba(22,23,24,.77),\n      rgba(7,8,9,.67)\n    );\n\n  border-color:\n    rgba(255,255,255,.15);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.13),\n\n    0 12px 40px\n    rgba(0,0,0,.24);\n}\n\n\n.b80-nav.is-product\n.b80-nav-hero{\n  opacity:0;\n\n  transform:\n    translateY(-15px);\n\n  pointer-events:none;\n}\n\n\n.b80-nav.is-product\n.b80-nav-product{\n  opacity:1;\n\n  transform:\n    translateY(0);\n\n  pointer-events:auto;\n}\n\n\n.b80-nav.is-product\n.b80-nav-tracer{\n  opacity:1;\n}\n\n\n/* =====================================================\n   MARK\n===================================================== */\n\n.b80-mark{\n  position:fixed;\n\n  z-index:89;\n\n  top:\n    calc(\n      var(--b80-header-offset) +\n      14px\n    );\n\n  left:\n    clamp(\n      24px,\n      7vw,\n      96px\n    );\n\n  width:42px;\n  height:42px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.16);\n\n  background:\n    rgba(10,11,12,.46);\n\n  color:#fff;\n\n  backdrop-filter:\n    blur(22px);\n\n  -webkit-backdrop-filter:\n    blur(22px);\n\n  transition:\n    top .38s\n    cubic-bezier(.16,1,.3,1),\n\n    opacity .4s ease,\n\n    transform .5s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-mark span{\n  font-family:\n    Georgia,\n    serif;\n\n  font-style:italic;\n}\n\n\n.b80-mark.is-hidden{\n  opacity:0;\n\n  transform:\n    translateY(-8px)\n    scale(.8);\n\n  pointer-events:none;\n}\n\n\n/* =====================================================\n   BACKGROUND\n===================================================== */\n\n.b80-bg{\n  position:absolute;\n\n  inset:0;\n\n  z-index:0;\n\n  pointer-events:none;\n}\n\n\n.b80-grid{\n  position:absolute;\n\n  inset:0;\n\n  opacity:.10;\n\n  background-image:\n    linear-gradient(\n      rgba(255,255,255,.035) 1px,\n      transparent 1px\n    ),\n\n    linear-gradient(\n      90deg,\n      rgba(255,255,255,.035) 1px,\n      transparent 1px\n    );\n\n  background-size:\n    76px 76px;\n\n  mask-image:\n    linear-gradient(\n      to bottom,\n      transparent 5%,\n      #000 65%,\n      #000\n    );\n}\n\n\n.b80-center-light{\n  position:absolute;\n\n  left:50%;\n  bottom:-220px;\n\n  width:850px;\n  height:600px;\n\n  transform:\n    translateX(-50%);\n\n  border-radius:50%;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(52,163,189,.20),\n      rgba(21,79,95,.08) 39%,\n      transparent 70%\n    );\n\n  filter:\n    blur(50px);\n}\n\n\n.b80-side-light{\n  position:absolute;\n\n  left:12%;\n  bottom:-170px;\n\n  width:450px;\n  height:360px;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(255,125,34,.07),\n      transparent 68%\n    );\n\n  filter:\n    blur(60px);\n}\n\n\n.b80-noise{\n  position:absolute;\n\n  inset:-50%;\n\n  width:200%;\n  height:200%;\n\n  opacity:.025;\n\n  pointer-events:none;\n\n  background-image:\n    url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n}\n\n\n/* =====================================================\n   MEDIA\n===================================================== */\n\n.b80-media{\n  position:absolute;\n\n  z-index:1;\n\n  left:0;\n  right:0;\n  bottom:0;\n\n  height:64%;\n\n  pointer-events:none;\n\n  overflow:hidden;\n\n  -webkit-mask-image:\n    linear-gradient(\n      to bottom,\n      transparent,\n      rgba(0,0,0,.25) 12%,\n      #000 37%\n    );\n\n  mask-image:\n    linear-gradient(\n      to bottom,\n      transparent,\n      rgba(0,0,0,.25) 12%,\n      #000 37%\n    );\n}\n\n\n.b80-media video,\n.b80-media img{\n  width:100%;\n  height:100%;\n\n  object-fit:cover;\n\n  opacity:.86;\n\n  filter:\n    contrast(1.08)\n    brightness(.72)\n    saturate(.85);\n}\n\n\n/* =====================================================\n   PLACEHOLDER\n===================================================== */\n\n.b80-placeholder{\n  position:absolute;\n\n  inset:0;\n}\n\n\n.b80-aura{\n  position:absolute;\n\n  left:50%;\n  bottom:-200px;\n\n  width:780px;\n  height:780px;\n\n  transform:\n    translateX(-50%);\n\n  border-radius:50%;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(79,191,213,.25),\n      rgba(24,99,116,.11) 34%,\n      transparent 68%\n    );\n\n  filter:\n    blur(20px);\n}\n\n\n.b80-orbit{\n  position:absolute;\n\n  left:50%;\n  bottom:-230px;\n\n  border:\n    1px solid\n    rgba(117,214,232,.10);\n\n  border-radius:50%;\n\n  transform:\n    translateX(-50%)\n    rotateX(70deg);\n}\n\n\n.b80-orbit-one{\n  width:500px;\n  height:500px;\n}\n\n\n.b80-orbit-two{\n  width:700px;\n  height:700px;\n\n  opacity:.65;\n}\n\n\n.b80-orbit-three{\n  width:900px;\n  height:900px;\n\n  opacity:.3;\n}\n\n\n/* =====================================================\n   HERO CONTENT\n===================================================== */\n\n.b80-content{\n  position:absolute;\n\n  z-index:15;\n\n  top:47%;\n  left:50%;\n\n  width:\n    min(850px,92vw);\n\n  transform:\n    translate(-50%,-50%);\n\n  text-align:center;\n}\n\n\n/* eyebrow */\n\n.b80-eyebrow{\n  width:max-content;\n\n  max-width:90vw;\n\n  margin:\n    0 auto 28px;\n\n  padding:\n    5px 11px 5px 5px;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:9px;\n\n  border-radius:999px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.16);\n\n  background:\n    rgba(12,13,14,.36);\n\n  backdrop-filter:\n    blur(18px);\n\n  -webkit-backdrop-filter:\n    blur(18px);\n\n  color:\n    rgba(255,255,255,.5);\n\n  font-size:8px;\n\n  letter-spacing:.07em;\n}\n\n\n.b80-eyebrow-new{\n  padding:\n    5px 9px;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#080808;\n\n  font-weight:800;\n\n  font-size:7px;\n}\n\n\n.b80-eyebrow i{\n  width:1px;\n  height:11px;\n\n  background:\n    rgba(255,255,255,.15);\n}\n\n\n/* =====================================================\n   TITLE\n===================================================== */\n\n.b80-heading{\n  margin:0;\n\n  color:#fff;\n\n  font-family:\n    \"Iowan Old Style\",\n    Baskerville,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      68px,\n      7.4vw,\n      112px\n    );\n\n  font-weight:400;\n\n  line-height:.78;\n\n  letter-spacing:-.065em;\n}\n\n\n.b80-heading em{\n  display:block;\n\n  margin-top:12px;\n\n  font-weight:400;\n}\n\n\n/* copy */\n\n.b80-copy{\n  width:\n    min(480px,82vw);\n\n  margin:\n    34px auto 0;\n\n  color:\n    rgba(255,255,255,.52);\n\n  font-size:14px;\n\n  line-height:1.65;\n}\n\n\n/* =====================================================\n   HERO ACTIONS\n===================================================== */\n\n.b80-actions{\n  margin-top:29px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  gap:25px;\n}\n\n\n.b80-actions a{\n  text-decoration:none;\n}\n\n\n.b80-hero-explore{\n  height:46px;\n\n  padding:\n    0 5px 0 19px;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:16px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.22);\n\n  border-radius:999px;\n\n  color:#fff;\n\n  background:\n    linear-gradient(\n      120deg,\n      rgba(255,255,255,.10),\n      rgba(255,255,255,.025)\n    );\n\n  backdrop-filter:\n    blur(20px)\n    saturate(150%);\n\n  -webkit-backdrop-filter:\n    blur(20px)\n    saturate(150%);\n\n  font-size:10px;\n\n  transition:\n    border-color .25s ease,\n    background .25s ease,\n    transform .25s ease;\n}\n\n\n.b80-hero-arrow{\n  width:35px;\n  height:35px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  background:#fff;\n\n  color:#090a0b;\n}\n\n\n.b80-hero-explore:hover{\n  transform:\n    translateY(-2px);\n\n  border-color:\n    rgba(255,255,255,.35);\n\n  background:\n    rgba(255,255,255,.10);\n}\n\n\n.b80-hero-explore:hover\n.b80-hero-arrow svg{\n  transform:\n    translate(2px,-2px);\n}\n\n\n/* discover */\n\n.b80-discover{\n  display:flex;\n\n  align-items:center;\n\n  gap:9px;\n\n  color:\n    rgba(255,255,255,.50);\n\n  font-size:10px;\n\n  transition:\n    color .25s ease;\n}\n\n\n.b80-play{\n  width:25px;\n  height:25px;\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  border-radius:50%;\n\n  background:\n    rgba(255,255,255,.025);\n}\n\n\n.b80-play svg{\n  width:10px;\n\n  fill:currentColor;\n}\n\n\n.b80-discover:hover{\n  color:#fff;\n}\n\n\n/* =====================================================\n   FOOTER MICRO DETAILS\n===================================================== */\n\n.b80-bottom-left,\n.b80-bottom-right{\n  position:absolute;\n\n  z-index:15;\n\n  bottom:27px;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:9px;\n\n  color:\n    rgba(255,255,255,.26);\n\n  font-size:6px;\n\n  letter-spacing:.22em;\n}\n\n\n.b80-bottom-left{\n  left:28px;\n}\n\n\n.b80-bottom-right{\n  right:28px;\n}\n\n\n.b80-bottom-left i{\n  width:28px;\n  height:1px;\n\n  background:\n    rgba(255,255,255,.16);\n}\n\n\n.b80-bottom-dot{\n  width:4px;\n  height:4px;\n\n  border-radius:50%;\n\n  background:#fff;\n\n  box-shadow:\n    0 0 7px\n    rgba(255,255,255,.5);\n}\n\n\n/* scroll */\n\n.b80-scroll{\n  position:absolute;\n\n  z-index:15;\n\n  left:50%;\n  bottom:20px;\n\n  transform:\n    translateX(-50%);\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  gap:8px;\n\n  color:\n    rgba(255,255,255,.22);\n\n  font-size:5px;\n\n  letter-spacing:.25em;\n}\n\n\n.b80-scroll i{\n  position:relative;\n\n  width:1px;\n  height:30px;\n\n  overflow:hidden;\n\n  background:\n    rgba(255,255,255,.09);\n}\n\n\n.b80-scroll i:before{\n  content:\"\";\n\n  position:absolute;\n\n  top:-100%;\n\n  width:1px;\n  height:100%;\n\n  background:#fff;\n\n  animation:\n    b80ScrollLine\n    1.8s ease\n    infinite;\n}\n\n\n@keyframes b80ScrollLine{\n\n  0%{\n    top:-100%;\n  }\n\n  55%{\n    top:0;\n  }\n\n  100%{\n    top:100%;\n  }\n\n}\n\n\n/* =====================================================\n   MOBILE\n===================================================== */\n\n@media(max-width:750px){\n\n  .b80-hero{\n    min-height:680px;\n  }\n\n\n  .b80-mark{\n    display:none;\n  }\n\n\n  .b80-nav{\n    width:\n      calc(100vw - 24px);\n\n    height:46px;\n\n    top:\n      calc(\n        var(--b80-header-offset) +\n        8px\n      );\n  }\n\n\n  .b80-nav-links{\n    display:none;\n  }\n\n\n  .b80-nav-hero{\n    justify-content:flex-end;\n\n    padding:4px;\n  }\n\n\n  .b80-explore-button{\n    width:100%;\n\n    justify-content:space-between;\n\n    padding-left:16px;\n  }\n\n\n  .b80-nav.is-product{\n    width:\n      calc(100vw - 16px);\n\n    height:52px;\n\n    border-radius:16px;\n  }\n\n\n  .b80-nav-product{\n    padding:\n      0 7px 0 14px;\n  }\n\n\n  .b80-product-title{\n    font-size:13px;\n  }\n\n\n  .b80-product-divider,\n  .b80-product-edition,\n  .b80-system-state{\n    display:none;\n  }\n\n\n  .b80-product-right{\n    gap:6px;\n  }\n\n\n  .b80-product-explore{\n    height:30px;\n\n    padding:\n      0 4px 0 11px;\n\n    font-size:9px;\n  }\n\n\n  .b80-small-arrow{\n    width:22px;\n    height:22px;\n  }\n\n\n  .b80-buy{\n    min-width:auto;\n\n    height:30px;\n\n    padding:\n      0 13px;\n\n    font-size:9px;\n  }\n\n\n  .b80-content{\n    top:45%;\n\n    width:93vw;\n  }\n\n\n  .b80-eyebrow{\n    margin-bottom:24px;\n  }\n\n\n  .b80-heading{\n    font-size:\n      clamp(\n        54px,\n        17vw,\n        80px\n      );\n  }\n\n\n  .b80-copy{\n    margin-top:28px;\n\n    font-size:12px;\n  }\n\n\n  .b80-actions{\n    margin-top:25px;\n\n    gap:17px;\n  }\n\n\n  .b80-hero-explore{\n    height:42px;\n\n    padding-left:15px;\n  }\n\n\n  .b80-hero-arrow{\n    width:31px;\n    height:31px;\n  }\n\n\n  .b80-discover{\n    font-size:9px;\n  }\n\n\n  .b80-bottom-left,\n  .b80-bottom-right{\n    display:none;\n  }\n\n}\n\n\n/* =====================================================\n   REDUCED MOTION\n===================================================== */\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80-nav-sheen,\n  .b80-nav-tracer span,\n  .b80-scroll i:before{\n    animation:none;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function(){\n\n  const hero =\n    document.getElementById(\n      'b80-hero'\n    );\n\n  const nav =\n    document.getElementById(\n      'b80-nav'\n    );\n\n  const mark =\n    document.getElementById(\n      'b80-mark'\n    );\n\n\n  if(!hero || !nav){\n    return;\n  }\n\n\n  /* ==================================================\n     SHOPIFY HEADER DETECTION\n  ================================================== */\n\n  const possibleHeaders = [\n\n    document.querySelector(\n      'sticky-header'\n    ),\n\n    document.querySelector(\n      '.header-wrapper'\n    ),\n\n    document.querySelector(\n      '.shopify-section-header-sticky'\n    ),\n\n    document.querySelector(\n      '#shopify-section-header'\n    )\n\n  ].filter(Boolean);\n\n\n\n  function getVisibleHeaderBottom(){\n\n    let bottom = 0;\n\n\n    possibleHeaders.forEach(\n      function(header){\n\n        const rect =\n          header.getBoundingClientRect();\n\n\n        const style =\n          window.getComputedStyle(\n            header\n          );\n\n\n        const visible =\n          style.display !== 'none' &&\n          style.visibility !== 'hidden' &&\n          Number(style.opacity || 1) > 0 &&\n          rect.height > 0 &&\n          rect.bottom > 0 &&\n          rect.top < window.innerHeight;\n\n\n        if(visible){\n\n          /*\n          Only use the visible portion\n          of the header.\n\n          This is important for Shopify\n          headers that slide in/out.\n          */\n\n          const visibleBottom =\n            Math.max(\n              0,\n              Math.min(\n                rect.bottom,\n                rect.height\n              )\n            );\n\n\n          bottom =\n            Math.max(\n              bottom,\n              visibleBottom\n            );\n\n        }\n\n      }\n    );\n\n\n    return bottom;\n\n  }\n\n\n\n  function updateHeaderOffset(){\n\n    const headerBottom =\n      getVisibleHeaderBottom();\n\n\n    document.documentElement.style.setProperty(\n\n      '--b80-header-offset',\n\n      headerBottom + 'px'\n\n    );\n\n  }\n\n\n\n  /* ==================================================\n     NAV MORPH\n  ================================================== */\n\n  function updateProductNav(){\n\n    const rect =\n      hero.getBoundingClientRect();\n\n\n    /*\n    PRODUCT BAR APPEARS\n    AS USER APPROACHES\n    NEXT SECTION\n    */\n\n    const trigger =\n      window.innerHeight * .34;\n\n\n    const productMode =\n      rect.bottom <= trigger;\n\n\n    nav.classList.toggle(\n      'is-product',\n      productMode\n    );\n\n\n    if(mark){\n\n      mark.classList.toggle(\n        'is-hidden',\n        productMode\n      );\n\n    }\n\n  }\n\n\n\n  /* ==================================================\n     ONE ANIMATION LOOP\n  ================================================== */\n\n  let ticking = false;\n\n\n  function update(){\n\n    updateHeaderOffset();\n\n    updateProductNav();\n\n    ticking = false;\n\n  }\n\n\n\n  function requestUpdate(){\n\n    if(ticking){\n      return;\n    }\n\n\n    ticking = true;\n\n\n    requestAnimationFrame(\n      update\n    );\n\n  }\n\n\n\n  window.addEventListener(\n    'scroll',\n    requestUpdate,\n    {\n      passive:true\n    }\n  );\n\n\n  window.addEventListener(\n    'resize',\n    requestUpdate\n  );\n\n\n  /*\n  Shopify sticky headers sometimes\n  change transform without firing\n  layout events immediately.\n\n  This keeps our position synced\n  during the slide animation.\n  */\n\n  let frames = 0;\n\n\n  function headerSync(){\n\n    updateHeaderOffset();\n\n\n    frames++;\n\n\n    if(frames < 160){\n\n      requestAnimationFrame(\n        headerSync\n      );\n\n    }\n\n  }\n\n\n  requestAnimationFrame(\n    headerSync\n  );\n\n\n  update();\n\n})();\n\n</script>",
