      "settings": {
        "custom_liquid": "<style>\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.b80-360 {\n  width: 100%;\n  background: #000;\n\n  overflow-anchor: none;\n  contain: layout style;\n  color: #fff;\n\n  padding:\n    100px\n    24px\n    80px;\n\n  overflow: hidden;\n\n  font-family: inherit;\n}\n\n.b80-360,\n.b80-360 * {\n  box-sizing: border-box;\n  font-family: inherit;\n}\n\n.b80-360__inner {\n  width: 100%;\n  max-width: 1380px;\n  margin: 0 auto;\n}\n\n\n/* =========================================================\n   HEADING\n========================================================= */\n\n.b80-360__heading {\n  width: 100%;\n  max-width: 900px;\n\n  margin:\n    0 auto\n    42px;\n\n  text-align: center;\n}\n\n.b80-360__title {\n  margin: 0;\n\n  color: #fff;\n\n  font-size:\n    clamp(\n      42px,\n      5.5vw,\n      80px\n    );\n\n  line-height: .95;\n\n  letter-spacing: -.05em;\n\n  font-weight: 700;\n}\n\n.b80-360__intro {\n  width: 100%;\n  max-width: 610px;\n\n  margin:\n    20px auto 0;\n\n  color:\n    rgba(255,255,255,.52);\n\n  font-size:\n    clamp(\n      15px,\n      1.3vw,\n      19px\n    );\n\n  line-height: 1.55;\n\n  font-weight: 400;\n}\n\n\n/* =========================================================\n   SPEC PILLS\n========================================================= */\n\n.b80-feature-nav {\n  width: 100%;\n\n  display: flex;\n\n  justify-content: center;\n\n  align-items: center;\n\n  flex-wrap: wrap;\n\n  gap: 9px;\n\n  margin:\n    0 auto\n    22px;\n}\n\n.b80-feature-button {\n  position: relative;\n\n  appearance: none;\n\n  padding:\n    12px\n    19px;\n\n  border: 0;\n\n  outline: 0;\n\n  border-radius: 999px;\n\n  color:\n    rgba(255,255,255,.52);\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    );\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.065),\n    0 8px 24px rgba(0,0,0,.16);\n\n  backdrop-filter:\n    blur(16px);\n\n  -webkit-backdrop-filter:\n    blur(16px);\n\n  font:\n    inherit;\n\n  font-size:\n    13px;\n\n  font-weight:\n    500;\n\n  cursor:\n    pointer;\n\n  transition:\n    color .25s ease,\n    background .25s ease,\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n.b80-feature-button:hover {\n  color:\n    rgba(255,255,255,.94);\n\n  transform:\n    translateY(-1px);\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.11),\n      rgba(255,255,255,.04)\n    );\n}\n\n.b80-feature-button.is-active {\n  color: #fff;\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.155),\n      rgba(255,255,255,.055)\n    );\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.13),\n    0 10px 30px rgba(0,0,0,.23);\n}\n\n\n/* =========================================================\n   MAIN VIEWER\n========================================================= */\n\n.b80-viewer {\n  position: relative;\n\n  overflow-anchor: none;\n\n  width: 100%;\n\n  height:\n    min(\n      75vw,\n      820px\n    );\n\n  min-height: 650px;\n\n  overflow: hidden;\n\n  border-radius: 32px;\n\n  border: 0;\n\n  outline: 0;\n\n  background:\n    radial-gradient(\n      ellipse at 50% 45%,\n      rgba(255,255,255,.048),\n      rgba(255,255,255,.014) 34%,\n      transparent 68%\n    ),\n    linear-gradient(\n      180deg,\n      #080808,\n      #030303 57%,\n      #010101\n    );\n\n  box-shadow:\n    0 25px 70px rgba(0,0,0,.25);\n\n  perspective: 1400px;\n\n  cursor: grab;\n\n  touch-action: pan-y;\n\n  isolation: isolate;\n  contain: layout style;\n}\n\n.b80-viewer.is-dragging {\n  cursor: grabbing;\n}\n\n.b80-viewer::before {\n  content: \"\";\n\n  position: absolute;\n\n  z-index: 1;\n\n  left: 50%;\n  top: 48%;\n\n  width: 68%;\n  height: 80%;\n\n  transform:\n    translate(-50%,-50%);\n\n  border-radius: 50%;\n\n  pointer-events: none;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(62,171,202,.14) 0%,\n      rgba(34,92,110,.06) 38%,\n      transparent 74%\n    );\n\n  filter:\n    blur(24px);\n}\n\n\n/* =========================================================\n   SOFT VIEWER BOUNDARY\n========================================================= */\n\n.b80-viewer::after {\n  content: \"\";\n\n  position: absolute;\n\n  z-index: 50;\n\n  inset: 0;\n\n  border-radius: inherit;\n\n  pointer-events: none;\n\n  background:\n\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.075) 0,\n      rgba(255,255,255,.018) 2px,\n      transparent 13px\n    ),\n\n    linear-gradient(\n      0deg,\n      rgba(255,255,255,.105) 0,\n      rgba(255,255,255,.03) 3px,\n      transparent 17px\n    ),\n\n    linear-gradient(\n      90deg,\n      rgba(255,255,255,.05),\n      transparent 12px\n    ),\n\n    linear-gradient(\n      270deg,\n      rgba(255,255,255,.05),\n      transparent 12px\n    );\n}\n\n\n/* =========================================================\n   IMAGE CAMERA\n========================================================= */\n\n.b80-image-camera {\n  --focus-x: 0%;\n  --focus-y: 0%;\n  --focus-scale: 1;\n\n  --tilt-x: 0deg;\n  --tilt-y: 0deg;\n\n  position: absolute;\n\n  z-index: 4;\n\n  left: 50%;\n  top: 50%;\n\n  width:\n    min(\n      36vw,\n      500px\n    );\n\n  max-width: 52%;\n\n  transform-style:\n    preserve-3d;\n\n  transform:\n    translate(-50%,-50%)\n    translate3d(\n      var(--focus-x),\n      var(--focus-y),\n      0\n    )\n    scale(\n      var(--focus-scale)\n    )\n    rotateX(\n      var(--tilt-x)\n    )\n    rotateY(\n      var(--tilt-y)\n    );\n\n  transform-origin:\n    center center;\n\n  transition:\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n  will-change: transform;\n}\n\n.b80-image-camera.is-dragging {\n  transition: none;\n  will-change: transform;\n}\n\n\n/* =========================================================\n   RACKET IMAGE\n========================================================= */\n\n.b80-racket-image {\n  display: block;\n\n  width: 100%;\n  height: auto;\n\n  user-select: none;\n\n  -webkit-user-drag: none;\n\n  pointer-events: none;\n\n  transform: none;\n\n  filter: none;\n\n  image-rendering: auto;\n  opacity: 1;\n\n  will-change: auto;\n}\n\n\n/* subtle depth layer */\n\n.b80-image-shadow {\n  position: absolute;\n\n  z-index: -1;\n\n  left: 50%;\n  top: 50%;\n\n  width: 75%;\n  height: 86%;\n\n  transform:\n    translate(-50%,-50%)\n    translateZ(-30px);\n\n  border-radius: 50%;\n\n  background:\n    rgba(0,0,0,.34);\n\n  filter:\n    blur(28px);\n\n  pointer-events: none;\n}\n\n\n/* =========================================================\n   TOP UI\n========================================================= */\n\n.b80-viewer__top {\n  position: absolute;\n\n  z-index: 40;\n\n  top: 22px;\n  left: 22px;\n  right: 22px;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: flex-end;\n\n  pointer-events: none;\n}\n\n\n/* =========================================================\n   DRAG BADGE\n   \"INTERACTIVE\" REMOVED\n========================================================= */\n\n\n\n/* =========================================================\n   RESET\n========================================================= */\n\n.b80-reset {\n  pointer-events: auto;\n\n  width: 42px;\n  height: 42px;\n\n  display: grid;\n\n  place-items: center;\n\n  padding: 0;\n\n  border: 0;\n\n  outline: 0;\n\n  border-radius: 50%;\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.09),\n      rgba(255,255,255,.03)\n    );\n\n  color: #fff;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.08),\n    0 8px 24px rgba(0,0,0,.20);\n\n  backdrop-filter:\n    blur(18px);\n\n  -webkit-backdrop-filter:\n    blur(18px);\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    background .25s ease;\n}\n\n.b80-reset:hover {\n  transform:\n    scale(1.04);\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.14),\n      rgba(255,255,255,.05)\n    );\n}\n\n.b80-reset svg {\n  width: 18px;\n  height: 18px;\n}\n\n\n/* =========================================================\n   INFO CARD\n========================================================= */\n\n.b80-info {\n  position: absolute;\n\n  z-index: 30;\n\n  left: 28px;\n  bottom: 28px;\n\n  width:\n    min(\n      390px,\n      calc(100% - 56px)\n    );\n\n  padding:\n    20px\n    22px;\n\n  overflow: hidden;\n\n  border: 0;\n\n  border-radius: 20px;\n\n  background:\n    linear-gradient(\n      145deg,\n      rgba(32,32,32,.88),\n      rgba(17,17,17,.84) 48%,\n      rgba(7,7,7,.80)\n    );\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.075),\n    0 20px 60px rgba(0,0,0,.32);\n\n  backdrop-filter:\n    blur(28px);\n\n  -webkit-backdrop-filter:\n    blur(28px);\n\n  opacity: 0;\n\n  transform:\n    translateY(12px);\n\n  pointer-events: none;\n\n  transition:\n    opacity .35s ease,\n    transform .35s ease;\n}\n\n.b80-info.is-visible {\n  opacity: 1;\n\n  transform:\n    translateY(0);\n}\n\n.b80-info__index {\n  display: block;\n\n  margin-bottom: 8px;\n\n  color:\n    rgba(255,255,255,.36);\n\n  font-size: 11px;\n\n  font-weight: 500;\n\n  letter-spacing: .14em;\n}\n\n.b80-info h3 {\n  margin: 0;\n\n  color: #fff;\n\n  font-size: 24px;\n\n  line-height: 1.05;\n\n  letter-spacing: -.025em;\n\n  font-weight: 600;\n}\n\n.b80-info p {\n  margin:\n    10px 0 0;\n\n  color:\n    rgba(255,255,255,.57);\n\n  font-size: 14px;\n\n  line-height: 1.5;\n}\n\n\n/* =========================================================\n   CNTRL FOAM CALLOUT\n========================================================= */\n\n.b80-callout {\n  position: absolute;\n\n  z-index: 26;\n\n  right: 24px;\n  top: 54%;\n\n  width:\n    min(\n      212px,\n      25%\n    );\n\n  opacity: 0;\n\n  transform:\n    translateY(-50%)\n    translateX(14px);\n\n  pointer-events: none;\n\n  transition:\n    opacity .35s ease,\n    transform .38s cubic-bezier(.16,1,.3,1);\n}\n\n.b80-callout.is-visible {\n  opacity: 1;\n\n  transform:\n    translateY(-50%)\n    translateX(0);\n}\n\n.b80-callout::before {\n  content: \"\";\n\n  position: absolute;\n\n  left: -34px;\n  top: 50%;\n\n  width: 28px;\n  height: 2px;\n\n  transform:\n    translateY(-50%);\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(87,197,227,.72),\n      rgba(87,197,227,.14)\n    );\n}\n\n.b80-callout::after {\n  content: \"\";\n\n  position: absolute;\n\n  left: -40px;\n  top: 50%;\n\n  width: 10px;\n  height: 10px;\n\n  transform:\n    translateY(-50%);\n\n  border-radius: 50%;\n\n  background:\n    #5cd0ef;\n\n  box-shadow:\n    0 0 0 4px rgba(92,208,239,.12);\n}\n\n.b80-callout__media {\n  overflow: hidden;\n\n  border-radius: 18px;\n\n  box-shadow:\n    0 20px 48px rgba(0,0,0,.28);\n}\n\n.b80-callout__media img {\n  display: block;\n\n  width: 100%;\n  height: auto;\n}\n\n.b80-callout__body {\n  margin-top: 10px;\n\n  padding:\n    14px\n    14px\n    15px;\n\n  border-radius: 18px;\n\n  background:\n    linear-gradient(\n      145deg,\n      rgba(22,22,22,.94),\n      rgba(8,8,8,.90)\n    );\n\n  box-shadow:\n    0 18px 42px rgba(0,0,0,.28);\n}\n\n.b80-callout__eyebrow {\n  display: block;\n\n  margin-bottom: 7px;\n\n  color:\n    rgba(255,255,255,.36);\n\n  font-size: 9px;\n\n  font-weight: 600;\n\n  letter-spacing: .16em;\n}\n\n.b80-callout__title {\n  display: block;\n\n  color: #fff;\n\n  font-size: 17px;\n\n  line-height: 1.05;\n\n  font-weight: 600;\n\n  letter-spacing: -.02em;\n}\n\n.b80-callout__copy {\n  margin:\n    8px 0 0;\n\n  color:\n    rgba(255,255,255,.54);\n\n  font-size: 12px;\n\n  line-height: 1.42;\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width:749px) {\n\n  .b80-360 {\n    padding: 64px 12px 52px;\n  }\n\n  .b80-360__heading {\n    margin-bottom: 24px;\n    padding: 0 10px;\n  }\n\n  .b80-360__title {\n    font-size: clamp(38px, 11vw, 54px);\n    line-height: .96;\n  }\n\n  .b80-360__intro {\n    max-width: 330px;\n    margin-top: 15px;\n    font-size: 14px;\n    line-height: 1.48;\n  }\n\n  .b80-feature-nav {\n    justify-content: flex-start;\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    overflow-y: hidden;\n    gap: 8px;\n    margin: 0 -12px 14px;\n    padding: 0 12px 8px;\n    scroll-padding-inline: 12px;\n    scroll-snap-type: x proximity;\n    scrollbar-width: none;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .b80-feature-nav::-webkit-scrollbar { display: none; }\n\n  .b80-feature-button {\n    flex: 0 0 auto;\n    min-height: 38px;\n    padding: 10px 15px;\n    font-size: 12px;\n    scroll-snap-align: center;\n  }\n\n  .b80-viewer {\n    height: 570px;\n    min-height: 0;\n    border-radius: 22px;\n    touch-action: pan-y;\n  }\n\n  .b80-viewer::before {\n    width: 92%;\n    height: 74%;\n    top: 43%;\n    opacity: .8;\n  }\n\n  .b80-image-camera {\n    width: min(63vw, 285px);\n    max-width: 70%;\n    top: 46%;\n  }\n\n  .b80-racket-image {\n    filter: none;\n    image-rendering: auto;\n  }\n\n  .b80-viewer__top {\n    top: 12px;\n    left: 12px;\n    right: 12px;\n  }\n\n  .b80-reset {\n    width: 38px;\n    height: 38px;\n  }\n\n  .b80-reset svg {\n    width: 16px;\n    height: 16px;\n  }\n\n  .b80-info {\n    left: 12px;\n    right: 12px;\n    bottom: 12px;\n    width: auto;\n    padding: 15px 16px 16px;\n    border-radius: 18px;\n    background: linear-gradient(145deg, rgba(22,25,30,.94), rgba(9,12,16,.94));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 16px 42px rgba(0,0,0,.42);\n    backdrop-filter: blur(22px);\n    -webkit-backdrop-filter: blur(22px);\n  }\n\n  .b80-info__index {\n    margin-bottom: 7px;\n    font-size: 9px;\n    letter-spacing: .13em;\n  }\n\n  .b80-info h3 {\n    font-size: 20px;\n    line-height: 1.08;\n  }\n\n  .b80-info p {\n    margin-top: 8px;\n    font-size: 12px;\n    line-height: 1.48;\n  }\n\n  .b80-callout {\n    top: 66px;\n    right: 12px;\n    bottom: auto;\n    width: min(40vw, 148px);\n    opacity: 0;\n    transform: translateY(-8px) scale(.96);\n    transform-origin: top right;\n  }\n\n  .b80-callout.is-visible {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  .b80-callout::before,\n  .b80-callout::after {\n    display: none;\n  }\n\n  .b80-callout__media {\n    overflow: hidden;\n    aspect-ratio: 1 / 1.18;\n    border-radius: 16px;\n    background: #0b0d10;\n    box-shadow: 0 14px 34px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.08);\n  }\n\n  .b80-callout__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .b80-callout__body {\n    display: none;\n  }\n\n  .b80-viewer.has-callout .b80-image-camera {\n    transform-origin: 46% 52%;\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media(prefers-reduced-motion:reduce) {\n\n  .b80-image-camera,\n  .b80-feature-button,\n  .b80-info,\n  .b80-reset {\n    transition: none;\n  }\n\n}\n\n</style>\n\n\n\n<section class=\"b80-360\">\n\n  <div class=\"b80-360__inner\">\n\n\n    <!-- =====================================================\n         HEADING\n    ====================================================== -->\n\n    <div class=\"b80-360__heading\">\n\n      <h2 class=\"b80-360__title\">\n        Explore Every Angle.\n      </h2>\n\n\n      <p class=\"b80-360__intro\">\n        Select a spec to see how it's built.\n      </p>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         SPEC PRESETS\n\n         IMPORTANT:\n\n         data-x\n         moves image LEFT / RIGHT\n\n         data-y\n         moves image UP / DOWN\n\n         data-zoom\n         controls close-up\n\n         These are the values to fine-tune if needed.\n    ====================================================== -->\n\n    <div class=\"b80-feature-nav\">\n\n\n      <!-- SHAFT -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button is-active\"\n\n        data-feature=\"shaft\"\n\n        data-x=\"0%\"\n        data-y=\"4%\"\n        data-zoom=\"6.3\"\n        data-mobile-x=\"0%\"\n        data-mobile-y=\"2%\"\n        data-mobile-zoom=\"5.1\"\n        data-callout=\"false\"\n\n        data-index=\"01\"\n\n        data-title=\"5.9 MM Shaft\"\n\n        data-copy=\"Thinner than anything before it, so the swing meets less resistance and the shot gets there faster.\"\n      >\n        5.9 MM Shaft\n      </button>\n\n\n\n      <!-- CURVE -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"curve\"\n\n        data-x=\"0%\"\n        data-y=\"47%\"\n        data-zoom=\"5.55\"\n        data-mobile-x=\"0%\"\n        data-mobile-y=\"46%\"\n        data-mobile-zoom=\"4.55\"\n        data-callout=\"false\"\n\n        data-index=\"02\"\n\n        data-title=\"Curve² Frame\"\n\n        data-copy=\"The frame's curve widens the sweet spot, so an off-centre hit still lands with real pace.\"\n      >\n        Curve²\n      </button>\n\n\n\n      <!-- CNTRL FOAM -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"cntrl\"\n\n        data-x=\"-13%\"\n        data-y=\"43%\"\n        data-zoom=\"5.95\"\n        data-mobile-x=\"-12%\"\n        data-mobile-y=\"41%\"\n        data-mobile-zoom=\"4.85\"\n        data-callout=\"true\"\n\n        data-index=\"03\"\n\n        data-title=\"CNTRL Foam\"\n\n        data-copy=\"Foam packed inside the frame absorbs shock at contact — so your arm never feels it.\"\n      >\n        CNTRL Foam\n      </button>\n\n\n\n      <!-- T FUSE -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"tfuse\"\n\n        data-x=\"0%\"\n        data-y=\"22%\"\n        data-zoom=\"8.1\"\n        data-mobile-x=\"0%\"\n        data-mobile-y=\"21%\"\n        data-mobile-zoom=\"6.35\"\n        data-callout=\"false\"\n\n        data-index=\"04\"\n\n        data-title=\"T Fuse\"\n\n        data-copy=\"Where the frame meets the shaft, T Fuse keeps the racket from twisting on full-power swings.\"\n      >\n        T Fuse\n      </button>\n\n\n\n      <!-- FULL RACKET -->\n\n      <button\n        type=\"button\"\n        class=\"b80-feature-button\"\n\n        data-feature=\"full\"\n\n        data-x=\"0%\"\n        data-y=\"0%\"\n        data-zoom=\"1\"\n        data-mobile-x=\"0%\"\n        data-mobile-y=\"0%\"\n        data-mobile-zoom=\"1\"\n        data-callout=\"false\"\n\n        data-index=\"\"\n        data-title=\"\"\n        data-copy=\"\"\n      >\n        Full Racket\n      </button>\n    </div>\n\n\n\n    <!-- =====================================================\n         IMAGE VIEWER\n    ====================================================== -->\n\n    <div class=\"b80-viewer\">\n\n\n      <!-- TOP UI -->\n\n      <div class=\"b80-viewer__top\">\n        <button\n          class=\"b80-reset\"\n          type=\"button\"\n          aria-label=\"Return to full racket view\"\n        >\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.7\"\n          >\n\n            <path\n              d=\"M4.5 8.5A8 8 0 1 1 4 14\"\n            ></path>\n\n            <path\n              d=\"M4.5 4v4.5H9\"\n            ></path>\n\n          </svg>\n\n        </button>\n\n\n      </div>\n\n\n\n      <!-- =====================================================\n           RACKET IMAGE\n\n           YOUR IMAGE IS ALREADY ADDED HERE\n      ====================================================== -->\n\n      <div class=\"b80-image-camera\">\n\n        <div class=\"b80-image-shadow\"></div>\n\n        <img\n          class=\"b80-racket-image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/17_9a9c8198-8b96-4633-a1a2-f40db4e490d3.png?v=1786622607\"\n          alt=\"Nitrix 80 Bullet badminton racket\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n          decoding=\"async\"\n          draggable=\"false\"\n        >\n\n      </div>\n\n\n\n      <!-- =====================================================\n           INFORMATION\n      ====================================================== -->\n\n      <div\n        class=\"b80-info\"\n        aria-live=\"polite\"\n      >\n\n        <span class=\"b80-info__index\">\n          01\n        </span>\n\n\n        <h3>\n          5.9 MM Shaft\n        </h3>\n\n\n        <p>\n          Engineered for faster release.\n        </p>\n\n      </div>\n\n      <div class=\"b80-callout\" aria-hidden=\"true\">\n\n        <div class=\"b80-callout__media\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Screenshot_2026-08-14_at_1.09.04_PM.png?v=1786693179\"\n            alt=\"CNTRL Foam internal construction\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"b80-callout__body\">\n          <span class=\"b80-callout__eyebrow\">\n            INSIDE THE FRAME\n          </span>\n\n          <strong class=\"b80-callout__title\">\n            CNTRL Foam\n          </strong>\n\n          <p class=\"b80-callout__copy\">\n            Internal foam helps reduce unwanted vibration at impact.\n          </p>\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<script>\n\n(function () {\n\n  const sections =\n    document.querySelectorAll(\n      '.b80-360'\n    );\n\n\n  sections.forEach(\n    function (section) {\n\n\n      const viewer =\n        section.querySelector(\n          '.b80-viewer'\n        );\n\n\n      const camera =\n        section.querySelector(\n          '.b80-image-camera'\n        );\n\n\n      const buttons =\n        section.querySelectorAll(\n          '.b80-feature-button'\n        );\n\n\n      const reset =\n        section.querySelector(\n          '.b80-reset'\n        );\n\n\n      const info =\n        section.querySelector(\n          '.b80-info'\n        );\n\n\n      const infoIndex =\n        info.querySelector(\n          '.b80-info__index'\n        );\n\n\n      const infoTitle =\n        info.querySelector(\n          'h3'\n        );\n\n\n      const infoCopy =\n        info.querySelector(\n          'p'\n        );\n\n\n      const callout =\n        section.querySelector(\n          '.b80-callout'\n        );\n\n\n      const mobileQuery =\n        window.matchMedia(\n          '(max-width: 749px)'\n        );\n\n\n      if (\n        !viewer ||\n        !camera\n      ) {\n\n        return;\n\n      }\n\n\n\n      /* =====================================================\n         STATE\n      ====================================================== */\n\n      let tiltX =\n        0;\n\n\n      let tiltY =\n        0;\n\n\n      let focusX =\n        '0%';\n\n\n      let focusY =\n        '0%';\n\n\n      let focusScale =\n        1;\n\n\n      let dragging =\n        false;\n\n\n      let startX =\n        0;\n\n\n      let startY =\n        0;\n\n\n      let startTiltX =\n        0;\n\n\n      let startTiltY =\n        0;\n\n\n      let dragFrame =\n        0;\n\n\n      let pendingDeltaX =\n        0;\n\n\n      let pendingDeltaY =\n        0;\n\n\n      let gesturePending =\n        false;\n\n\n      let activePointerType =\n        '';\n\n\n      /* =====================================================\n         LIMIT\n      ====================================================== */\n\n      function clamp(\n        value,\n        minimum,\n        maximum\n      ) {\n\n        return Math.min(\n          maximum,\n          Math.max(\n            minimum,\n            value\n          )\n        );\n\n      }\n\n\n\n      /* =====================================================\n         APPLY CAMERA\n      ====================================================== */\n\n      function applyCamera(\n        animate\n      ) {\n\n\n        camera.classList.toggle(\n          'is-dragging',\n          !animate\n        );\n\n\n        camera.style.setProperty(\n          '--focus-x',\n          focusX\n        );\n\n\n        camera.style.setProperty(\n          '--focus-y',\n          focusY\n        );\n\n\n        camera.style.setProperty(\n          '--focus-scale',\n          focusScale\n        );\n\n\n        camera.style.setProperty(\n          '--tilt-x',\n          tiltX + 'deg'\n        );\n\n\n        camera.style.setProperty(\n          '--tilt-y',\n          tiltY + 'deg'\n        );\n\n\n      }\n\n\n\n      /* =====================================================\n         MOBILE ACTIVE PILL\n      ====================================================== */\n\n      function centerActivePill(\n        button\n      ) {\n\n        if (\n          !button ||\n          !mobileQuery.matches\n        ) {\n          return;\n        }\n\n        const nav =\n          button.closest(\n            '.b80-feature-nav'\n          );\n\n        if (!nav) {\n          return;\n        }\n\n        const targetLeft =\n          button.offsetLeft -\n          (\n            nav.clientWidth -\n            button.offsetWidth\n          ) / 2;\n\n        const nextLeft =\n          Math.max(\n            0,\n            targetLeft\n          );\n\n\n        if (\n          Math.abs(\n            nav.scrollLeft -\n            nextLeft\n          ) > 2\n        ) {\n\n          nav.scrollTo({\n            left: nextLeft,\n            behavior: 'smooth'\n          });\n\n        }\n\n      }\n\n\n      /* =====================================================\n         FOCUS SPEC\n      ====================================================== */\n\n      function focusFeature(\n        button\n      ) {\n\n\n        if (!button) {\n          return;\n        }\n\n\n        const isMobile =\n          mobileQuery.matches;\n\n\n        focusX =\n          (\n            isMobile\n            ? button.dataset.mobileX\n            : button.dataset.x\n          ) ||\n          button.dataset.x ||\n          '0%';\n\n\n        focusY =\n          (\n            isMobile\n            ? button.dataset.mobileY\n            : button.dataset.y\n          ) ||\n          button.dataset.y ||\n          '0%';\n\n\n        focusScale =\n          parseFloat(\n            (\n              isMobile\n              ? button.dataset.mobileZoom\n              : button.dataset.zoom\n            ) ||\n            button.dataset.zoom ||\n            '1'\n          );\n\n\n        /* reset orientation for clean transition */\n\n        tiltX =\n          0;\n\n\n        tiltY =\n          0;\n\n\n        applyCamera(\n          true\n        );\n\n\n        /* active pill */\n\n        buttons.forEach(\n          function (item) {\n\n            item.classList.remove(\n              'is-active'\n            );\n\n          }\n        );\n\n\n        button.classList.add(\n          'is-active'\n        );\n\n        const feature =\n          button.dataset.feature;\n\n\n\n        /* FULL VIEW */\n\n        if (\n          feature ===\n          'full'\n        ) {\n\n\n          info.classList.remove(\n            'is-visible'\n          );\n\n          if (callout) {\n            callout.classList.remove(\n              'is-visible'\n            );\n          }\n\n\n        }\n\n        else {\n\n\n          infoIndex.textContent =\n            button.dataset.index ||\n            '';\n\n\n          infoTitle.textContent =\n            button.dataset.title ||\n            '';\n\n\n          infoCopy.textContent =\n            button.dataset.copy ||\n            '';\n\n\n          info.classList.add(\n            'is-visible'\n          );\n\n\n          if (callout) {\n\n            if (\n              button.dataset.callout ===\n              'true'\n            ) {\n\n              callout.classList.add(\n                'is-visible'\n              );\n\n              viewer.classList.add(\n                'has-callout'\n              );\n\n            }\n\n            else {\n\n              callout.classList.remove(\n                'is-visible'\n              );\n\n              viewer.classList.remove(\n                'has-callout'\n              );\n\n            }\n\n          }\n\n\n        }\n\n\n        if (\n          feature ===\n          'full'\n        ) {\n\n          viewer.classList.remove(\n            'has-callout'\n          );\n\n        }\n\n\n        centerActivePill(\n          button\n        );\n\n\n      }\n\n\n\n      /* =====================================================\n         BUTTON EVENTS\n      ====================================================== */\n\n      buttons.forEach(\n        function (button) {\n\n\n          button.addEventListener(\n            'click',\n            function () {\n\n\n              focusFeature(\n                button\n              );\n\n              if (\n                mobileQuery.matches\n              ) {\n                var viewerTop =\n                  viewer.getBoundingClientRect().top +\n                  window.pageYOffset;\n\n                window.scrollTo({\n                  top: viewerTop,\n                  left: 0,\n                  behavior: 'auto'\n                });\n              }\n\n\n            }\n          );\n\n\n        }\n      );\n\n\n\n      /* =====================================================\n         RESET\n      ====================================================== */\n\n      reset.addEventListener(\n        'click',\n        function () {\n\n\n          const fullButton =\n            section.querySelector(\n              '.b80-feature-button[data-feature=\"full\"]'\n            );\n\n\n          focusFeature(\n            fullButton\n          );\n\n\n        }\n      );\n\n\n\n      /* =====================================================\n         POINTER DOWN\n      ====================================================== */\n\n      viewer.addEventListener(\n        'pointerdown',\n        function (event) {\n\n\n          /* don't start drag on reset */\n\n          if (\n            event.target.closest(\n              '.b80-reset'\n            )\n          ) {\n\n            return;\n\n          }\n\n\n          startX =\n            event.clientX;\n\n\n          startY =\n            event.clientY;\n\n\n          startTiltX =\n            tiltX;\n\n\n          startTiltY =\n            tiltY;\n\n\n          activePointerType =\n            event.pointerType ||\n            'mouse';\n\n\n          /*\n            Mouse: drag immediately.\n\n            Touch / pen:\n            wait until movement is clearly horizontal.\n            This prevents normal vertical page scrolling\n            from changing the racket transform.\n          */\n\n          if (\n            activePointerType ===\n            'mouse'\n          ) {\n\n            dragging =\n              true;\n\n\n            gesturePending =\n              false;\n\n\n            viewer.classList.add(\n              'is-dragging'\n            );\n\n\n            camera.classList.add(\n              'is-dragging'\n            );\n\n\n            try {\n\n              viewer.setPointerCapture(\n                event.pointerId\n              );\n\n            }\n\n            catch (error) {}\n\n          }\n\n          else {\n\n            dragging =\n              false;\n\n\n            gesturePending =\n              true;\n\n          }\n\n\n        }\n      );\n\n\n\n      /* =====================================================\n         POINTER MOVE\n      ====================================================== */\n\n      function renderDragFrame() {\n\n        dragFrame =\n          0;\n\n\n        if (\n          !dragging\n        ) {\n\n          return;\n\n        }\n\n\n        tiltY =\n          clamp(\n            startTiltY +\n            pendingDeltaX * .11,\n            -18,\n            18\n          );\n\n\n        tiltX =\n          clamp(\n            startTiltX -\n            pendingDeltaY * .07,\n            -10,\n            10\n          );\n\n\n        applyCamera(\n          false\n        );\n\n      }\n\n\n      viewer.addEventListener(\n        'pointermove',\n        function (event) {\n\n\n          pendingDeltaX =\n            event.clientX -\n            startX;\n\n\n          pendingDeltaY =\n            event.clientY -\n            startY;\n\n\n          if (\n            gesturePending\n          ) {\n\n            const absX =\n              Math.abs(\n                pendingDeltaX\n              );\n\n\n            const absY =\n              Math.abs(\n                pendingDeltaY\n              );\n\n\n            if (\n              absY > 7 &&\n              absY > absX * 1.15\n            ) {\n\n              /*\n                Clearly vertical:\n                leave the gesture to normal page scrolling.\n              */\n\n              gesturePending =\n                false;\n\n\n              return;\n\n            }\n\n\n            if (\n              absX > 7 &&\n              absX > absY * 1.15\n            ) {\n\n              /*\n                Clearly horizontal:\n                now begin racket interaction.\n              */\n\n              gesturePending =\n                false;\n\n\n              dragging =\n                true;\n\n\n              viewer.classList.add(\n                'is-dragging'\n              );\n\n\n              camera.classList.add(\n                'is-dragging'\n              );\n\n\n              try {\n\n                viewer.setPointerCapture(\n                  event.pointerId\n                );\n\n              }\n\n              catch (error) {}\n\n            }\n\n            else {\n\n              return;\n\n            }\n\n          }\n\n\n          if (\n            !dragging\n          ) {\n\n            return;\n\n          }\n\n\n          if (\n            !dragFrame\n          ) {\n\n            dragFrame =\n              requestAnimationFrame(\n                renderDragFrame\n              );\n\n          }\n\n\n        },\n        {\n          passive: true\n        }\n      );\n\n\n\n      /* =====================================================\n         END DRAG\n      ====================================================== */\n\n      function finishDrag() {\n\n\n        gesturePending =\n          false;\n\n\n        activePointerType =\n          '';\n\n\n        if (\n          !dragging\n        ) {\n\n          return;\n\n        }\n\n\n        dragging =\n          false;\n\n\n        if (\n          dragFrame\n        ) {\n\n          cancelAnimationFrame(\n            dragFrame\n          );\n\n          dragFrame =\n            0;\n\n        }\n\n\n        viewer.classList.remove(\n          'is-dragging'\n        );\n\n\n        camera.classList.remove(\n          'is-dragging'\n        );\n\n\n      }\n\n\n      viewer.addEventListener(\n        'pointerup',\n        finishDrag\n      );\n\n\n      viewer.addEventListener(\n        'pointercancel',\n        finishDrag\n      );\n\n\n      viewer.addEventListener(\n        'pointerleave',\n        function (event) {\n\n\n          if (\n            event.pointerType ===\n            'mouse'\n          ) {\n\n            finishDrag();\n\n          }\n\n\n        }\n      );\n\n\n\n      /* =====================================================\n         DOUBLE CLICK = FULL RESET\n      ====================================================== */\n\n      viewer.addEventListener(\n        'dblclick',\n        function (event) {\n\n\n          if (\n            event.target.closest(\n              '.b80-reset'\n            )\n          ) {\n\n            return;\n\n          }\n\n\n          const fullButton =\n            section.querySelector(\n              '.b80-feature-button[data-feature=\"full\"]'\n            );\n\n\n          focusFeature(\n            fullButton\n          );\n\n\n        }\n      );\n\n\n\n      /* =====================================================\n         RESPONSIVE REFRESH\n      ====================================================== */\n\n      let resizeTimer =\n        null;\n\n\n      let lastViewportWidth =\n        window.innerWidth;\n\n\n      let lastMobileState =\n        mobileQuery.matches;\n\n\n      window.addEventListener(\n        'resize',\n        function () {\n\n\n          const nextWidth =\n            window.innerWidth;\n\n\n          const nextMobileState =\n            mobileQuery.matches;\n\n\n          /*\n            Mobile browsers fire resize while their address bar\n            opens/closes during vertical scrolling.\n            Ignore those height-only changes so the racket does\n            not re-focus while the user is scrolling.\n          */\n          const widthChanged =\n            Math.abs(\n              nextWidth -\n              lastViewportWidth\n            ) > 2;\n\n\n          const breakpointChanged =\n            nextMobileState !==\n            lastMobileState;\n\n\n          if (\n            !widthChanged &&\n            !breakpointChanged\n          ) {\n\n            return;\n\n          }\n\n\n          lastViewportWidth =\n            nextWidth;\n\n\n          lastMobileState =\n            nextMobileState;\n\n\n          clearTimeout(\n            resizeTimer\n          );\n\n\n          resizeTimer =\n            setTimeout(\n              function () {\n\n                const activeButton =\n                  section.querySelector(\n                    '.b80-feature-button.is-active'\n                  );\n\n\n                if (\n                  activeButton\n                ) {\n\n                  focusFeature(\n                    activeButton\n                  );\n\n                }\n\n              },\n              120\n            );\n\n        },\n        {\n          passive: true\n        }\n      );\n\n\n\n      /* =====================================================\n         INITIAL\n       ====================================================== */\n\n      const initialButton =\n        section.querySelector(\n          '.b80-feature-button[data-feature=\"shaft\"]'\n        );\n\n      if (initialButton) {\n        focusFeature(initialButton);\n      }\n      else {\n        applyCamera(true);\n      }\n\n\n    }\n  );\n\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_aXDi93": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .b80-film {\n    width: 100%;\n    background: #000;\n    color: #fff;\n\n    padding: 105px 24px 115px;\n\n    overflow: hidden;\n\n    /* USE HNDRD / THEME DEFAULT FONT */\n    font-family: inherit;\n  }\n\n  .b80-film,\n  .b80-film * {\n    font-family: inherit;\n  }\n\n\n  /* ================================\n     MAIN CONTAINER\n  ================================= */\n\n  .b80-film__inner {\n    width: 100%;\n    max-width: 1280px;\n\n    margin: 0 auto;\n  }\n\n\n  /* ================================\n     COPY\n  ================================= */\n\n  .b80-film__copy {\n    width: 100%;\n    max-width: 900px;\n\n    margin: 0 auto 64px;\n\n    text-align: center;\n  }\n\n\n  .b80-film__eyebrow {\n    margin: 0 0 15px;\n\n    color: rgba(255,255,255,.42);\n\n    font-size: 12px;\n    font-weight: 500;\n\n    letter-spacing: .13em;\n    text-transform: uppercase;\n\n    text-align: center;\n  }\n\n\n  .b80-film__title {\n    width: 100%;\n    max-width: 850px;\n\n    margin: 0 auto;\n\n    color: #fff;\n\n    font-size: clamp(42px, 4.6vw, 68px);\n    line-height: 1;\n\n    letter-spacing: -.04em;\n\n    font-weight: 600;\n\n    text-align: center;\n  }\n\n\n  .b80-film__description {\n    width: 100%;\n    max-width: 820px;\n\n    margin: 26px auto 0;\n\n    color: rgba(255,255,255,.55);\n\n    font-size: clamp(16px, 1.25vw, 19px);\n    line-height: 1.5;\n\n    font-weight: 400;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  /* ================================\n     VIDEO CONTAINER\n  ================================= */\n\n  .b80-film__video-container {\n    width: 100%;\n    max-width: 1080px;\n\n    margin: 0 auto;\n  }\n\n\n  .b80-film__stage {\n    position: relative;\n\n    width: 100%;\n\n    margin: 0 auto;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    /* NO BORDER */\n    border: none !important;\n    outline: none !important;\n    box-shadow: none !important;\n\n    border-radius: 26px;\n\n    background: #050505;\n\n    isolation: isolate;\n  }\n\n\n  /* NO OVERLAY / NO BORDER EFFECT */\n\n  .b80-film__stage::before {\n    display: none;\n  }\n\n\n  /* ================================\n     VIDEO\n  ================================= */\n\n  .b80-film__video {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: cover;\n    object-position: center;\n\n    border: none;\n    outline: none;\n\n    background: #050505;\n  }\n\n\n  /* ================================\n     PLAY / PAUSE\n  ================================= */\n\n  .b80-film__control {\n    position: absolute;\n\n    z-index: 10;\n\n    right: 20px;\n    bottom: 20px;\n\n    width: 48px;\n    height: 48px;\n\n    padding: 0;\n\n    display: grid;\n    place-items: center;\n\n    border: none;\n    outline: none;\n\n    border-radius: 16px;\n\n    background: rgba(255,255,255,.96);\n    color: #090909;\n\n    cursor: pointer;\n\n    transition:\n      transform .2s ease,\n      background .2s ease;\n  }\n\n\n  .b80-film__control:hover {\n    transform: scale(1.04);\n\n    background: #fff;\n  }\n\n\n  .b80-film__control svg {\n    width: 18px;\n    height: 18px;\n  }\n\n\n  .b80-film__control .pause-icon {\n    display: block;\n  }\n\n\n  .b80-film__control .play-icon {\n    display: none;\n\n    margin-left: 2px;\n  }\n\n\n  .b80-film__control.is-paused .pause-icon {\n    display: none;\n  }\n\n\n  .b80-film__control.is-paused .play-icon {\n    display: block;\n  }\n\n\n  /* ================================\n     WATCH FILM\n  ================================= */\n\n  .b80-film__meta {\n    width: 100%;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    padding-top: 24px;\n  }\n\n\n  .b80-film__watch {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 9px;\n\n    color: rgba(255,255,255,.9);\n\n    font-size: 14px;\n    font-weight: 550;\n\n    letter-spacing: -.01em;\n\n    text-align: center;\n  }\n\n\n  .b80-film__watch-icon {\n    width: 21px;\n    height: 21px;\n\n    display: grid;\n    place-items: center;\n\n    border: 1px solid rgba(255,255,255,.42);\n\n    border-radius: 7px;\n\n    color: #fff;\n  }\n\n\n  .b80-film__watch-icon svg {\n    width: 8px;\n    height: 8px;\n\n    margin-left: 1px;\n  }\n\n\n  /* ================================\n     REVEAL ANIMATION\n  ================================= */\n\n  .b80-film__copy,\n  .b80-film__video-container,\n  .b80-film__meta {\n    opacity: 0;\n\n    transform: translateY(22px);\n\n    transition:\n      opacity .9s cubic-bezier(.2,.7,.2,1),\n      transform .9s cubic-bezier(.2,.7,.2,1);\n  }\n\n\n  .b80-film.is-visible .b80-film__copy {\n    opacity: 1;\n\n    transform: translateY(0);\n  }\n\n\n  .b80-film.is-visible .b80-film__video-container {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .10s;\n  }\n\n\n  .b80-film.is-visible .b80-film__meta {\n    opacity: 1;\n\n    transform: translateY(0);\n\n    transition-delay: .17s;\n  }\n\n\n  /* ================================\n     MOBILE\n  ================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .b80-film {\n      padding: 72px 14px 80px;\n    }\n\n\n    .b80-film__copy {\n      max-width: 100%;\n\n      margin-bottom: 36px;\n\n      padding: 0 8px;\n    }\n\n\n    .b80-film__eyebrow {\n      margin-bottom: 11px;\n\n      font-size: 10px;\n    }\n\n\n    .b80-film__title {\n      max-width: 390px;\n\n      font-size: clamp(38px, 11vw, 52px);\n\n      line-height: 1.02;\n    }\n\n\n    .b80-film__description {\n      max-width: 390px;\n\n      margin-top: 19px;\n\n      font-size: 15px;\n      line-height: 1.5;\n    }\n\n\n    .b80-film__video-container {\n      max-width: 100%;\n    }\n\n\n    .b80-film__stage {\n      aspect-ratio: 16 / 10;\n\n      border-radius: 18px;\n    }\n\n\n    .b80-film__control {\n      width: 42px;\n      height: 42px;\n\n      right: 12px;\n      bottom: 12px;\n\n      border-radius: 14px;\n    }\n\n\n    .b80-film__meta {\n      padding-top: 18px;\n    }\n\n\n    .b80-film__watch {\n      font-size: 13px;\n    }\n\n  }\n\n\n  /* ================================\n     REDUCED MOTION\n  ================================= */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .b80-film__copy,\n    .b80-film__video-container,\n    .b80-film__meta {\n      opacity: 1;\n\n      transform: none;\n\n      transition: none;\n    }\n\n  }\n</style>\n\n\n\n<section class=\"b80-film\">\n\n  <div class=\"b80-film__inner\">\n\n\n    <!-- ==================================\n         CENTERED COPY\n    =================================== -->\n\n    <div class=\"b80-film__copy\">\n\n    \n\n      <h2 class=\"b80-film__title\">\n        Attack in motion.\n      </h2>\n\n\n      <p class=\"b80-film__description\">\n        A razor-thin 5.9 mm shaft built for faster release, sharper handling and explosive response when the rally turns aggressive.\n      </p>\n\n    </div>\n\n\n\n    <!-- ==================================\n         CENTERED VIDEO\n    =================================== -->\n\n    <div class=\"b80-film__video-container\">\n\n      <div class=\"b80-film__stage\">\n\n\n        <!--\n        ==================================\n        ADD YOUR VIDEO HERE\n        ==================================\n        -->\n\n\n        <video\n          class=\"b80-film__video\"\n\n          autoplay\n          muted\n          loop\n          playsinline\n\n          preload=\"metadata\"\n\n          poster=\"PASTE-YOUR-POSTER-IMAGE-URL-HERE\"\n        >\n\n          <source\n            src=\"PASTE-YOUR-VIDEO-URL-HERE\"\n            type=\"video/mp4\"\n          >\n\n        </video>\n\n\n\n        <!-- ==================================\n             PLAY / PAUSE\n        =================================== -->\n\n        <button\n          class=\"b80-film__control\"\n\n          type=\"button\"\n\n          aria-label=\"Pause video\"\n        >\n\n\n          <!-- PAUSE -->\n\n          <svg\n            class=\"pause-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <rect\n              x=\"7\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n\n            <rect\n              x=\"13.5\"\n              y=\"5\"\n              width=\"3.5\"\n              height=\"14\"\n              rx=\"1.2\"\n            ></rect>\n\n          </svg>\n\n\n\n          <!-- PLAY -->\n\n          <svg\n            class=\"play-icon\"\n\n            viewBox=\"0 0 24 24\"\n\n            fill=\"currentColor\"\n          >\n\n            <path\n              d=\"M8 5.5L18 12L8 18.5V5.5Z\"\n            ></path>\n\n          </svg>\n\n\n        </button>\n\n\n      </div>\n\n\n\n      <!-- ==================================\n           WATCH THE FILM\n      =================================== -->\n\n      <div class=\"b80-film__meta\">\n\n        <div class=\"b80-film__watch\">\n\n          Watch the film\n\n\n          <span class=\"b80-film__watch-icon\">\n\n            <svg\n              viewBox=\"0 0 12 12\"\n\n              fill=\"currentColor\"\n            >\n\n              <path\n                d=\"M3.5 2.4L9 6L3.5 9.6V2.4Z\"\n              ></path>\n\n            </svg>\n\n          </span>\n\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</section>\n\n\n\n<script>\n(() => {\n\n  const sections =\n    document.querySelectorAll('.b80-film');\n\n\n  sections.forEach(section => {\n\n    const video =\n      section.querySelector('.b80-film__video');\n\n    const control =\n      section.querySelector('.b80-film__control');\n\n\n    if (!video || !control) return;\n\n\n\n    /* ================================\n       PLAY / PAUSE\n    ================================= */\n\n    control.addEventListener('click', () => {\n\n      if (video.paused) {\n\n        video.play();\n\n        control.classList.remove('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Pause video'\n        );\n\n      } else {\n\n        video.pause();\n\n        control.classList.add('is-paused');\n\n\n        control.setAttribute(\n          'aria-label',\n          'Play video'\n        );\n\n      }\n\n    });\n\n\n\n    /* ================================\n       SCROLL REVEAL\n    ================================= */\n\n    const observer =\n      new IntersectionObserver(entries => {\n\n        entries.forEach(entry => {\n\n          if (entry.isIntersecting) {\n\n            section.classList.add('is-visible');\n\n            observer.unobserve(section);\n\n          }\n\n        });\n\n      }, {\n\n        threshold: .12\n\n      });\n\n\n    observer.observe(section);\n\n  });\n\n})();\n</script>",
