    "custom_liquid_xdhThj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div id=\"bullet-loader\" class=\"bl-loader\">\n\n  <div class=\"bl-grid\"></div>\n  <div class=\"bl-scan\"></div>\n\n  <div class=\"bl-top-left\">HNDRD // N80</div>\n  <div class=\"bl-top-right\">ACCESS PROTOCOL</div>\n\n  <!-- CENTER -->\n  <div class=\"bl-center\">\n\n    <div class=\"bl-status\">\n      <span class=\"bl-dot\"></span>\n      SECURE ACCESS\n    </div>\n\n    <div class=\"bl-label\">\n      DOCUMENT STATUS\n    </div>\n\n    <div class=\"bl-classified-wrap\">\n      <h1 class=\"bl-title\" data-text=\"CLASSIFIED\">\n        CLASSIFIED\n      </h1>\n    </div>\n\n    <div class=\"bl-redacted\">\n      <i></i>\n      <i></i>\n      <i></i>\n    </div>\n\n    <div class=\"bl-file\">\n      NITRIX 80 // RESTRICTED FILE\n    </div>\n\n  </div>\n\n\n  <!-- BOTTOM LIVE LOADING -->\n  <div class=\"bl-loader-bottom\">\n\n    <div class=\"bl-load-info\">\n\n      <span id=\"bl-status-text\">\n        VERIFYING CLEARANCE\n      </span>\n\n      <div class=\"bl-number\">\n        <span id=\"bl-number\">10</span><small>%</small>\n      </div>\n\n    </div>\n\n\n    <div class=\"bl-progress-track\">\n\n      <div\n        id=\"bl-progress\"\n        class=\"bl-progress\"\n      >\n        <div class=\"bl-progress-glow\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"bl-meta\">\n\n      <span>FILE 080</span>\n\n      <span id=\"bl-stage\">\n        INITIALIZING\n      </span>\n\n      <span>LEVEL 05</span>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<style>\n\nhtml,\nbody{\n  margin:0;\n}\n\n#bullet-loader,\n#bullet-loader *{\n  box-sizing:border-box;\n}\n\nbody.bl-locked{\n  overflow:hidden!important;\n}\n\n\n/* =====================================\nLOADER\n===================================== */\n\n.bl-loader{\n  position:fixed;\n  inset:0;\n\n  width:100%;\n  height:100dvh;\n\n  background:#000;\n\n  color:#fff;\n\n  z-index:2147483647;\n\n  overflow:hidden;\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  transform:translateY(0);\n\n  transition:\n    transform .5s\n    cubic-bezier(.76,0,.24,1);\n}\n\n\n/* =====================================\nGRID\n===================================== */\n\n.bl-grid{\n  position:absolute;\n  inset:0;\n\n  z-index:1;\n\n  pointer-events:none;\n\n  background:\n    linear-gradient(\n      rgba(255,255,255,.025) 1px,\n      transparent 1px\n    ),\n    linear-gradient(\n      90deg,\n      rgba(255,255,255,.025) 1px,\n      transparent 1px\n    );\n\n  background-size:\n    56px 56px;\n}\n\n\n/* VIGNETTE */\n\n.bl-loader:before{\n  content:\"\";\n\n  position:absolute;\n  inset:0;\n\n  z-index:2;\n\n  pointer-events:none;\n\n  background:\n    radial-gradient(\n      circle at center,\n      transparent 10%,\n      rgba(0,0,0,.25) 55%,\n      rgba(0,0,0,.82) 100%\n    );\n}\n\n\n/* =====================================\nSCANNER\n===================================== */\n\n.bl-scan{\n  position:absolute;\n\n  z-index:3;\n\n  left:0;\n  top:-180px;\n\n  width:100%;\n  height:180px;\n\n  pointer-events:none;\n\n  background:\n    linear-gradient(\n      to bottom,\n      transparent,\n      rgba(255,255,255,.02),\n      rgba(255,255,255,.08),\n      rgba(255,255,255,.02),\n      transparent\n    );\n\n  animation:\n    blScanMove 2.5s linear forwards;\n}\n\n\n@keyframes blScanMove{\n\n  from{\n    transform:\n      translateY(0);\n  }\n\n  to{\n    transform:\n      translateY(calc(100vh + 360px));\n  }\n\n}\n\n\n/* =====================================\nTOP INFORMATION\n===================================== */\n\n.bl-top-left,\n.bl-top-right{\n  position:absolute;\n\n  top:26px;\n\n  z-index:20;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.27em;\n\n  color:\n    rgba(255,255,255,.45);\n}\n\n\n.bl-top-left{\n  left:30px;\n}\n\n\n.bl-top-right{\n  right:30px;\n}\n\n\n/* =====================================\nCENTER AREA\n===================================== */\n\n.bl-center{\n  position:absolute;\n\n  z-index:30;\n\n  left:50%;\n  top:45%;\n\n  width:92%;\n\n  max-width:1100px;\n\n  transform:\n    translate(-50%,-50%);\n\n  text-align:center;\n}\n\n\n/* =====================================\nSECURE ACCESS\n===================================== */\n\n.bl-status{\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  gap:10px;\n\n  margin-bottom:16px;\n\n  font-size:9px;\n\n  font-weight:700;\n\n  letter-spacing:.38em;\n\n  color:\n    rgba(255,255,255,.7);\n}\n\n\n.bl-dot{\n  width:6px;\n  height:6px;\n\n  border-radius:50%;\n\n  background:#fff;\n\n  box-shadow:\n    0 0 10px\n    rgba(255,255,255,.7);\n\n  animation:\n    blBlink .4s steps(1) infinite;\n}\n\n\n@keyframes blBlink{\n\n  50%{\n    opacity:.15;\n  }\n\n}\n\n\n/* =====================================\nDOCUMENT STATUS\n===================================== */\n\n.bl-label{\n  margin-bottom:8px;\n\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.58em;\n\n  color:\n    rgba(255,255,255,.45);\n}\n\n\n/* =====================================\nCLASSIFIED\n===================================== */\n\n.bl-classified-wrap{\n  overflow:visible;\n}\n\n\n.bl-title{\n  position:relative;\n\n  display:inline-block;\n\n  margin:0;\n\n  color:#fff!important;\n\n  opacity:1!important;\n  visibility:visible!important;\n\n  font-size:\n    clamp(60px,10vw,155px);\n\n  font-weight:900;\n\n  line-height:.88;\n\n  letter-spacing:-.06em;\n\n  text-shadow:\n    0 0 1px #fff,\n    0 0 20px\n    rgba(255,255,255,.12);\n\n  animation:\n    blTitleIn .55s\n    cubic-bezier(.15,.85,.3,1)\n    forwards;\n}\n\n\n@keyframes blTitleIn{\n\n  0%{\n    opacity:0;\n    transform:\n      translateY(20px)\n      scaleX(.96);\n\n    filter:blur(8px);\n  }\n\n  100%{\n    opacity:1;\n    transform:\n      translateY(0)\n      scaleX(.96);\n\n    filter:blur(0);\n  }\n\n}\n\n\n/* GLITCH */\n\n.bl-title:before,\n.bl-title:after{\n  content:\n    attr(data-text);\n\n  position:absolute;\n  inset:0;\n\n  color:#fff;\n\n  pointer-events:none;\n\n  opacity:0;\n}\n\n\n.bl-title.bl-glitch:before{\n  opacity:.35;\n\n  transform:\n    translateX(-6px);\n\n  clip-path:\n    inset(15% 0 65% 0);\n}\n\n\n.bl-title.bl-glitch:after{\n  opacity:.22;\n\n  transform:\n    translateX(6px);\n\n  clip-path:\n    inset(68% 0 10% 0);\n}\n\n\n/* =====================================\nREDACTED BARS\n===================================== */\n\n.bl-redacted{\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  gap:6px;\n\n  width:min(500px,70vw);\n\n  margin:\n    23px auto 0;\n}\n\n\n.bl-redacted i{\n  display:block;\n\n  height:5px;\n\n  background:#fff;\n\n  opacity:.9;\n}\n\n\n.bl-redacted i:nth-child(1){\n  width:20%;\n}\n\n\n.bl-redacted i:nth-child(2){\n  width:58%;\n}\n\n\n.bl-redacted i:nth-child(3){\n  width:12%;\n}\n\n\n/* =====================================\nFILE NAME\n===================================== */\n\n.bl-file{\n  margin-top:14px;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.34em;\n\n  color:\n    rgba(255,255,255,.44);\n}\n\n\n/* =====================================\nBOTTOM LOADER\n===================================== */\n\n.bl-loader-bottom{\n  position:absolute;\n\n  z-index:50;\n\n  left:50%;\n  bottom:42px;\n\n  width:min(800px,88vw);\n\n  transform:\n    translateX(-50%);\n}\n\n\n/* =====================================\nLOAD INFO\n===================================== */\n\n.bl-load-info{\n  display:flex;\n\n  align-items:flex-end;\n\n  justify-content:\n    space-between;\n\n  margin-bottom:10px;\n}\n\n\n#bl-status-text{\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.27em;\n\n  color:\n    rgba(255,255,255,.65);\n}\n\n\n/* =====================================\nPERCENTAGE\n===================================== */\n\n.bl-number{\n  display:flex;\n\n  align-items:flex-start;\n\n  color:#fff;\n\n  font-size:26px;\n\n  font-weight:800;\n\n  line-height:1;\n\n  font-variant-numeric:\n    tabular-nums;\n}\n\n\n.bl-number small{\n  margin-top:2px;\n  margin-left:2px;\n\n  font-size:10px;\n\n  color:\n    rgba(255,255,255,.55);\n}\n\n\n/* =====================================\nREAL-TIME PROGRESS TRACK\n===================================== */\n\n.bl-progress-track{\n  position:relative;\n\n  width:100%;\n  height:5px;\n\n  background:\n    rgba(255,255,255,.12);\n\n  overflow:hidden;\n}\n\n\n/* ACTUAL MOVING BAR */\n\n.bl-progress{\n  position:absolute;\n\n  left:0;\n  top:0;\n\n  width:100%;\n  height:100%;\n\n  background:#fff;\n\n  transform:\n    scaleX(.1);\n\n  transform-origin:\n    left center;\n\n  will-change:\n    transform;\n}\n\n\n/* MOVING BRIGHT EDGE */\n\n.bl-progress-glow{\n  position:absolute;\n\n  right:-1px;\n  top:-7px;\n\n  width:3px;\n  height:19px;\n\n  background:#fff;\n\n  box-shadow:\n    0 0 8px #fff,\n    0 0 18px\n    rgba(255,255,255,.8);\n}\n\n\n/* =====================================\nBOTTOM META\n===================================== */\n\n.bl-meta{\n  display:flex;\n\n  justify-content:\n    space-between;\n\n  align-items:center;\n\n  margin-top:10px;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.24em;\n\n  color:\n    rgba(255,255,255,.35);\n}\n\n\n#bl-stage{\n  color:\n    rgba(255,255,255,.55);\n}\n\n\n/* =====================================\nACCESS GRANTED\n===================================== */\n\n.bl-loader.bl-complete\n.bl-progress{\n  box-shadow:\n    0 0 18px\n    rgba(255,255,255,.65);\n}\n\n\n.bl-loader.bl-complete\n.bl-title{\n  animation:\n    blCompleteFlash\n    .18s ease;\n}\n\n\n@keyframes blCompleteFlash{\n\n  0%{\n    opacity:1;\n  }\n\n  40%{\n    opacity:.45;\n  }\n\n  100%{\n    opacity:1;\n  }\n\n}\n\n\n/* =====================================\nEXIT\n===================================== */\n\n.bl-loader.bl-exit{\n  transform:\n    translateY(-105%);\n}\n\n\n/* =====================================\nMOBILE\n===================================== */\n\n@media(max-width:600px){\n\n  .bl-center{\n    top:43%;\n  }\n\n  .bl-title{\n    font-size:\n      clamp(\n        46px,\n        16vw,\n        76px\n      );\n  }\n\n  .bl-status{\n    font-size:7px;\n\n    letter-spacing:.28em;\n  }\n\n  .bl-label{\n    font-size:6px;\n\n    letter-spacing:.42em;\n  }\n\n  .bl-redacted{\n    width:73vw;\n\n    margin-top:18px;\n  }\n\n  .bl-file{\n    font-size:6px;\n\n    letter-spacing:.22em;\n  }\n\n  .bl-loader-bottom{\n    bottom:30px;\n\n    width:89vw;\n  }\n\n  #bl-status-text{\n    font-size:6px;\n\n    letter-spacing:.16em;\n  }\n\n  .bl-number{\n    font-size:22px;\n  }\n\n  .bl-progress-track{\n    height:4px;\n  }\n\n  .bl-meta{\n    font-size:5px;\n\n    letter-spacing:.16em;\n  }\n\n  .bl-top-left,\n  .bl-top-right{\n    top:18px;\n\n    font-size:5px;\n\n    letter-spacing:.18em;\n  }\n\n  .bl-top-left{\n    left:18px;\n  }\n\n  .bl-top-right{\n    right:18px;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function(){\n\n  const loader =\n    document.getElementById(\n      'bullet-loader'\n    );\n\n  if(!loader) return;\n\n\n  const number =\n    document.getElementById(\n      'bl-number'\n    );\n\n  const progress =\n    document.getElementById(\n      'bl-progress'\n    );\n\n  const statusText =\n    document.getElementById(\n      'bl-status-text'\n    );\n\n  const stage =\n    document.getElementById(\n      'bl-stage'\n    );\n\n  const title =\n    loader.querySelector(\n      '.bl-title'\n    );\n\n\n  document.body.classList.add(\n    'bl-locked'\n  );\n\n\n  /*\n  ==============================\n  TIMING\n\n  Counter:\n  2.5 seconds\n\n  Hold:\n  .20 seconds\n\n  Exit:\n  .50 seconds\n  ==============================\n  */\n\n  const duration = 2500;\n\n  const startPercent = 10;\n\n  const endPercent = 100;\n\n  let startTime = null;\n\n  let lastGlitch = 0;\n\n\n  /*\n  ==============================\n  ANIMATION LOOP\n  ==============================\n  */\n\n  function animate(time){\n\n\n    if(!startTime){\n      startTime = time;\n    }\n\n\n    const elapsed =\n      time - startTime;\n\n\n    /*\n    TRUE REAL-TIME PROGRESS\n\n    0.0 -> 1.0\n\n    NO FAKE EASING\n    */\n\n    const timeline =\n      Math.min(\n        elapsed / duration,\n        1\n      );\n\n\n    /*\n    10 -> 100\n    */\n\n    const exactPercent =\n      startPercent +\n      (\n        endPercent -\n        startPercent\n      )\n      *\n      timeline;\n\n\n    /*\n    NUMBER\n    */\n\n    const displayedPercent =\n      Math.floor(\n        exactPercent\n      );\n\n\n    number.textContent =\n      displayedPercent;\n\n\n    /*\n    BAR\n\n    IMPORTANT:\n\n    Uses exact decimal percentage,\n    not rounded number.\n\n    Example:\n\n    number = 47%\n\n    actual bar may be 47.68432%\n\n    This creates perfectly smooth\n    movement at 60/120fps.\n    */\n\n    progress.style.transform =\n      'scaleX(' +\n      (\n        exactPercent / 100\n      ) +\n      ')';\n\n\n    /*\n    ==============================\n    LIVE STATUS\n    ==============================\n    */\n\n    if(timeline < .20){\n\n      statusText.textContent =\n        'VERIFYING CLEARANCE';\n\n      stage.textContent =\n        'IDENTITY CHECK';\n\n    }\n\n    else if(timeline < .42){\n\n      statusText.textContent =\n        'DECRYPTING FILE';\n\n      stage.textContent =\n        'DECRYPTING';\n\n    }\n\n    else if(timeline < .66){\n\n      statusText.textContent =\n        'READING BALLISTICS';\n\n      stage.textContent =\n        'BALLISTICS';\n\n    }\n\n    else if(timeline < .88){\n\n      statusText.textContent =\n        'AUTHORIZING ACCESS';\n\n      stage.textContent =\n        'CLEARANCE';\n\n    }\n\n    else{\n\n      statusText.textContent =\n        'ACCESS GRANTED';\n\n      stage.textContent =\n        'AUTHORIZED';\n\n    }\n\n\n    /*\n    ==============================\n    CONTROLLED GLITCH\n    ==============================\n    */\n\n    if(\n      time - lastGlitch > 260 &&\n      timeline < .88\n    ){\n\n      lastGlitch = time;\n\n\n      title.classList.add(\n        'bl-glitch'\n      );\n\n\n      setTimeout(\n        function(){\n\n          title.classList.remove(\n            'bl-glitch'\n          );\n\n        },\n        45\n      );\n\n    }\n\n\n    /*\n    CONTINUE\n    */\n\n    if(timeline < 1){\n\n      requestAnimationFrame(\n        animate\n      );\n\n      return;\n    }\n\n\n    /*\n    ==============================\n    FORCE EXACT FINAL STATE\n    ==============================\n    */\n\n    number.textContent =\n      '100';\n\n\n    progress.style.transform =\n      'scaleX(1)';\n\n\n    statusText.textContent =\n      'ACCESS GRANTED';\n\n\n    stage.textContent =\n      'AUTHORIZED';\n\n\n    loader.classList.add(\n      'bl-complete'\n    );\n\n\n    /*\n    HOLD 100%\n    */\n\n    setTimeout(\n      function(){\n\n\n        /*\n        SLIDE LOADER AWAY\n        */\n\n        loader.classList.add(\n          'bl-exit'\n        );\n\n\n        document.body.classList.remove(\n          'bl-locked'\n        );\n\n\n        /*\n        DELETE AFTER EXIT\n        */\n\n        setTimeout(\n          function(){\n\n            loader.remove();\n\n          },\n          520\n        );\n\n\n      },\n      200\n    );\n\n  }\n\n\n  /*\n  START\n  */\n\n  requestAnimationFrame(\n    animate\n  );\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_L9B8Jj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- =========================================================\n     BULLET 80\n     HEADER-SAFE PRODUCT NAV + APPLE EXPLORE MENU\n========================================================= -->\n\n<style>\n\n/* =========================================================\n   1. REMOVE OLD NON-BUY EXPLORE BUTTON\n========================================================= */\n\n.b80-explore-button{\n  display:none !important;\n}\n\n\n/* keep first/nav state balanced after removing Explore */\n\n.b80-nav-hero{\n  justify-content:center !important;\n  padding-left:20px !important;\n  padding-right:20px !important;\n}\n\n\n/* remove old H mark if still present */\n\n.b80-mark{\n  display:none !important;\n}\n\n\n/* =========================================================\n   2. FORCE PRODUCT BAR BELOW SHOPIFY HEADER\n========================================================= */\n\n:root{\n  --b80-safe-nav-top:72px;\n}\n\n\n.b80-nav{\n\n  /* overrides old top calculation */\n\n  top:\n    var(--b80-safe-nav-top)\n    !important;\n\n  z-index:99990 !important;\n\n  transition:\n    top .32s\n    cubic-bezier(.16,1,.3,1),\n\n    width .7s\n    cubic-bezier(.16,1,.3,1),\n\n    height .6s\n    cubic-bezier(.16,1,.3,1),\n\n    border-radius .6s\n    cubic-bezier(.16,1,.3,1),\n\n    background .45s ease\n    !important;\n\n}\n\n\n/* product state more premium */\n\n.b80-nav.is-product{\n\n  width:\n    calc(100vw - 24px)\n    !important;\n\n  max-width:none;\n\n  height:56px;\n\n  border-radius:18px;\n\n  background:\n    linear-gradient(\n      115deg,\n      rgba(20,21,23,.78),\n      rgba(7,8,9,.68)\n    );\n\n  border:\n    1px solid\n    rgba(255,255,255,.15);\n\n  box-shadow:\n\n    inset 0 1px 0\n    rgba(255,255,255,.14),\n\n    inset 0 -1px 0\n    rgba(255,255,255,.03),\n\n    0 18px 55px\n    rgba(0,0,0,.30);\n\n  backdrop-filter:\n    blur(30px)\n    saturate(165%);\n\n  -webkit-backdrop-filter:\n    blur(30px)\n    saturate(165%);\n\n}\n\n\n/* =========================================================\n   3. PREMIUM PRODUCT EXPLORE BUTTON\n========================================================= */\n\n.b80-product-explore{\n\n  position:relative;\n\n  height:36px;\n\n  padding:\n    0 5px 0 15px;\n\n  gap:11px;\n\n  overflow:hidden;\n\n  border:\n    1px solid\n    rgba(255,255,255,.17);\n\n  background:\n    linear-gradient(\n      120deg,\n      rgba(255,255,255,.085),\n      rgba(255,255,255,.025)\n    );\n\n  backdrop-filter:\n    blur(15px);\n\n  -webkit-backdrop-filter:\n    blur(15px);\n\n  transition:\n    transform .3s\n    cubic-bezier(.16,1,.3,1),\n\n    background .25s ease,\n\n    border-color .25s ease;\n\n}\n\n\n.b80-product-explore:before{\n\n  content:\"\";\n\n  position:absolute;\n\n  top:-100%;\n  left:-60%;\n\n  width:35%;\n  height:300%;\n\n  transform:\n    rotate(20deg);\n\n  pointer-events:none;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.12),\n      transparent\n    );\n\n  transition:\n    left .7s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n.b80-product-explore:hover:before{\n  left:130%;\n}\n\n\n.b80-product-explore:hover{\n\n  border-color:\n    rgba(255,255,255,.28);\n\n  background:\n    rgba(255,255,255,.085);\n\n}\n\n\n/* circular arrow */\n\n.b80-product-explore\n.b80-small-arrow{\n\n  width:27px;\n  height:27px;\n\n  background:\n    rgba(255,255,255,.10);\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  transition:\n    background .25s ease,\n    transform .35s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n.b80-product-explore:hover\n.b80-small-arrow{\n\n  background:\n    rgba(255,255,255,.16);\n\n}\n\n\n/* =========================================================\n   4. CLICK JUMP\n========================================================= */\n\n.b80-menu-jump{\n\n  animation:\n    b80MenuJump\n    .42s\n    cubic-bezier(.16,1,.3,1)\n    !important;\n\n}\n\n\n@keyframes b80MenuJump{\n\n  0%{\n    transform:\n      translateY(0)\n      scale(1);\n  }\n\n  32%{\n    transform:\n      translateY(-5px)\n      scale(1.035);\n  }\n\n  58%{\n    transform:\n      translateY(1px)\n      scale(.99);\n  }\n\n  100%{\n    transform:\n      translateY(0)\n      scale(1);\n  }\n\n}\n\n\n/* =========================================================\n   5. APPLE-STYLE GLASS MENU\n========================================================= */\n\n.b80x-menu{\n\n  --menu-connector-x:80%;\n\n  position:fixed;\n\n  z-index:99989;\n\n  top:120px;\n  left:50%;\n\n  width:\n    min(\n      900px,\n      calc(100vw - 32px)\n    );\n\n  transform:\n    translateX(-50%)\n    translateY(-14px)\n    scale(.98);\n\n  transform-origin:\n    var(--menu-connector-x)\n    top;\n\n  opacity:0;\n\n  visibility:hidden;\n\n  pointer-events:none;\n\n  color:#fff;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  border-radius:\n    0 0 28px 28px;\n\n  background:\n\n    linear-gradient(\n      145deg,\n      rgba(24,25,27,.90),\n      rgba(9,10,11,.85) 55%,\n      rgba(5,6,7,.90)\n    );\n\n  box-shadow:\n\n    inset 0 1px 0\n    rgba(255,255,255,.13),\n\n    inset 0 -1px 0\n    rgba(255,255,255,.025),\n\n    0 30px 90px\n    rgba(0,0,0,.42);\n\n  backdrop-filter:\n    blur(38px)\n    saturate(175%);\n\n  -webkit-backdrop-filter:\n    blur(38px)\n    saturate(175%);\n\n  overflow:visible;\n\n  transition:\n\n    opacity .24s ease,\n\n    visibility .24s ease,\n\n    transform .48s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n/* OPEN */\n\n.b80x-menu.is-open{\n\n  opacity:1;\n\n  visibility:visible;\n\n  pointer-events:auto;\n\n  transform:\n    translateX(-50%)\n    translateY(0)\n    scale(1);\n\n}\n\n\n/* =========================================================\n   CONNECTOR BETWEEN BAR AND MENU\n========================================================= */\n\n.b80x-menu-neck{\n\n  position:absolute;\n\n  top:-13px;\n\n  left:\n    calc(\n      var(--menu-connector-x) -\n      32px\n    );\n\n  width:64px;\n  height:14px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  border-bottom:0;\n\n  border-radius:\n    15px 15px 0 0;\n\n  background:\n    rgba(17,18,20,.90);\n\n  backdrop-filter:\n    blur(30px);\n\n  -webkit-backdrop-filter:\n    blur(30px);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.10);\n\n}\n\n\n/* merge neck into panel */\n\n.b80x-menu-neck:after{\n\n  content:\"\";\n\n  position:absolute;\n\n  left:1px;\n  right:1px;\n\n  bottom:-2px;\n\n  height:3px;\n\n  background:\n    rgba(17,18,20,.98);\n\n}\n\n\n/* =========================================================\n   GLASS LIGHT\n========================================================= */\n\n.b80x-menu-glass{\n\n  position:absolute;\n\n  inset:0;\n\n  overflow:hidden;\n\n  border-radius:inherit;\n\n  pointer-events:none;\n\n}\n\n\n.b80x-menu-glass:before{\n\n  content:\"\";\n\n  position:absolute;\n\n  top:-170px;\n  right:8%;\n\n  width:460px;\n  height:300px;\n\n  border-radius:50%;\n\n  background:\n\n    radial-gradient(\n      circle,\n      rgba(255,255,255,.09),\n      transparent 67%\n    );\n\n  filter:\n    blur(28px);\n\n}\n\n\n.b80x-menu-glass:after{\n\n  content:\"\";\n\n  position:absolute;\n\n  top:-120%;\n\n  left:-25%;\n\n  width:13%;\n  height:340%;\n\n  transform:\n    rotate(22deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.055),\n      transparent\n    );\n\n  animation:\n    b80xGlassMove\n    9s ease-in-out\n    infinite;\n\n}\n\n\n@keyframes b80xGlassMove{\n\n  0%,\n  70%{\n    left:-25%;\n  }\n\n  88%{\n    left:125%;\n  }\n\n  100%{\n    left:125%;\n  }\n\n}\n\n\n/* =========================================================\n   MENU INNER\n========================================================= */\n\n.b80x-menu-inner{\n\n  position:relative;\n\n  z-index:3;\n\n  padding:\n    30px 36px 28px;\n\n}\n\n\n/* =========================================================\n   MENU HEADER\n========================================================= */\n\n.b80x-menu-head{\n\n  display:flex;\n\n  justify-content:space-between;\n\n  align-items:flex-start;\n\n  gap:25px;\n\n  padding-bottom:24px;\n\n  border-bottom:\n    1px solid\n    rgba(255,255,255,.075);\n\n}\n\n\n.b80x-kicker{\n\n  margin-bottom:8px;\n\n  color:\n    rgba(255,255,255,.32);\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.27em;\n\n}\n\n\n.b80x-title{\n\n  margin:0;\n\n  font-size:27px;\n\n  line-height:1;\n\n  font-weight:600;\n\n  letter-spacing:-.04em;\n\n}\n\n\n.b80x-title span{\n\n  margin-left:5px;\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-weight:400;\n\n}\n\n\n/* =========================================================\n   CLOSE BUTTON\n========================================================= */\n\n.b80x-close{\n\n  position:relative;\n\n  width:34px;\n  height:34px;\n\n  flex:0 0 auto;\n\n  padding:0;\n\n  cursor:pointer;\n\n  border:\n    1px solid\n    rgba(255,255,255,.11);\n\n  border-radius:50%;\n\n  background:\n    rgba(255,255,255,.035);\n\n  transition:\n    background .25s ease,\n    transform .3s ease;\n\n}\n\n\n.b80x-close:before,\n.b80x-close:after{\n\n  content:\"\";\n\n  position:absolute;\n\n  left:50%;\n  top:50%;\n\n  width:12px;\n  height:1px;\n\n  background:\n    rgba(255,255,255,.74);\n\n}\n\n\n.b80x-close:before{\n\n  transform:\n    translate(-50%,-50%)\n    rotate(45deg);\n\n}\n\n\n.b80x-close:after{\n\n  transform:\n    translate(-50%,-50%)\n    rotate(-45deg);\n\n}\n\n\n.b80x-close:hover{\n\n  transform:\n    rotate(5deg);\n\n  background:\n    rgba(255,255,255,.08);\n\n}\n\n\n/* =========================================================\n   SECTION GRID\n========================================================= */\n\n.b80x-grid{\n\n  display:grid;\n\n  grid-template-columns:\n    repeat(3,minmax(0,1fr));\n\n  gap:\n    4px 14px;\n\n  padding:\n    22px 0;\n\n}\n\n\n/* =========================================================\n   SECTION ITEMS\n========================================================= */\n\n.b80x-link{\n\n  position:relative;\n\n  min-height:72px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  justify-content:center;\n\n  padding:\n    12px 40px 12px 13px;\n\n  overflow:hidden;\n\n  border-radius:14px;\n\n  color:#fff;\n\n  text-decoration:none;\n\n  transition:\n    transform .35s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n.b80x-link:before{\n\n  content:\"\";\n\n  position:absolute;\n\n  inset:0;\n\n  opacity:0;\n\n  background:\n    linear-gradient(\n      120deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.018)\n    );\n\n  transition:\n    opacity .25s ease;\n\n}\n\n\n.b80x-link:hover{\n\n  transform:\n    translateY(-2px);\n\n}\n\n\n.b80x-link:hover:before{\n  opacity:1;\n}\n\n\n.b80x-num{\n\n  position:relative;\n\n  z-index:2;\n\n  margin-bottom:5px;\n\n  color:\n    rgba(255,255,255,.23);\n\n  font-size:6px;\n\n  font-weight:700;\n\n  letter-spacing:.18em;\n\n}\n\n\n.b80x-link strong{\n\n  position:relative;\n\n  z-index:2;\n\n  font-size:14px;\n\n  font-weight:500;\n\n  letter-spacing:-.02em;\n\n}\n\n\n.b80x-link small{\n\n  position:relative;\n\n  z-index:2;\n\n  margin-top:5px;\n\n  color:\n    rgba(255,255,255,.31);\n\n  font-size:8px;\n\n}\n\n\n/* arrow */\n\n.b80x-link-arrow{\n\n  position:absolute;\n\n  z-index:2;\n\n  right:13px;\n  top:50%;\n\n  width:25px;\n  height:25px;\n\n  transform:\n    translateY(-50%)\n    translateX(-4px);\n\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  opacity:0;\n\n  color:\n    rgba(255,255,255,.58);\n\n  transition:\n\n    opacity .25s ease,\n\n    transform .35s\n    cubic-bezier(.16,1,.3,1),\n\n    background .25s ease;\n\n}\n\n\n.b80x-link-arrow svg{\n\n  width:11px;\n  height:11px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.4;\n\n  stroke-linecap:round;\n\n  stroke-linejoin:round;\n\n}\n\n\n.b80x-link:hover\n.b80x-link-arrow{\n\n  opacity:1;\n\n  transform:\n    translateY(-50%)\n    translateX(0);\n\n  background:\n    rgba(255,255,255,.07);\n\n}\n\n\n/* =========================================================\n   LOWER LINKS LIKE APPLE\n========================================================= */\n\n.b80x-footer{\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:space-between;\n\n  gap:25px;\n\n  padding-top:19px;\n\n  border-top:\n    1px solid\n    rgba(255,255,255,.075);\n\n}\n\n\n.b80x-utilities{\n\n  display:flex;\n\n  align-items:center;\n\n  gap:28px;\n\n}\n\n\n.b80x-utility{\n\n  display:flex;\n\n  align-items:center;\n\n  gap:7px;\n\n  color:\n    rgba(255,255,255,.48);\n\n  text-decoration:none;\n\n  font-size:9px;\n\n  transition:\n    color .25s ease;\n\n}\n\n\n.b80x-utility svg{\n\n  width:10px;\n  height:10px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.5;\n\n  transition:\n    transform .3s ease;\n\n}\n\n\n.b80x-utility:hover{\n  color:#fff;\n}\n\n\n.b80x-utility:hover svg{\n\n  transform:\n    translateX(2px);\n\n}\n\n\n/* =========================================================\n   BUY NOW\n========================================================= */\n\n.b80x-buy{\n\n  height:38px;\n\n  padding:\n    0 19px;\n\n  display:flex;\n\n  align-items:center;\n\n  gap:8px;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#08090a;\n\n  text-decoration:none;\n\n  font-size:9px;\n\n  font-weight:650;\n\n  transition:\n    transform .3s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n.b80x-buy:hover{\n\n  transform:\n    scale(1.035);\n\n}\n\n\n/* =========================================================\n   ITEM ENTRANCE\n========================================================= */\n\n.b80x-menu\n.b80x-link{\n\n  opacity:0;\n\n  transform:\n    translateY(7px);\n\n}\n\n\n.b80x-menu.is-open\n.b80x-link{\n\n  animation:\n    b80xItemIn\n    .46s\n    cubic-bezier(.16,1,.3,1)\n    forwards;\n\n}\n\n\n.b80x-menu.is-open\n.b80x-link:nth-child(1){\n  animation-delay:.04s;\n}\n\n.b80x-menu.is-open\n.b80x-link:nth-child(2){\n  animation-delay:.07s;\n}\n\n.b80x-menu.is-open\n.b80x-link:nth-child(3){\n  animation-delay:.10s;\n}\n\n.b80x-menu.is-open\n.b80x-link:nth-child(4){\n  animation-delay:.13s;\n}\n\n.b80x-menu.is-open\n.b80x-link:nth-child(5){\n  animation-delay:.16s;\n}\n\n.b80x-menu.is-open\n.b80x-link:nth-child(6){\n  animation-delay:.19s;\n}\n\n\n@keyframes b80xItemIn{\n\n  from{\n\n    opacity:0;\n\n    transform:\n      translateY(7px);\n\n  }\n\n  to{\n\n    opacity:1;\n\n    transform:\n      translateY(0);\n\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media(max-width:750px){\n\n\n  .b80-nav{\n\n    top:\n      var(--b80-safe-nav-top)\n      !important;\n\n  }\n\n\n  .b80-nav.is-product{\n\n    width:\n      calc(100vw - 16px)\n      !important;\n\n    height:52px;\n\n    border-radius:16px;\n\n  }\n\n\n  .b80-product-explore{\n\n    height:32px;\n\n    padding:\n      0 4px 0 11px;\n\n    gap:7px;\n\n  }\n\n\n  .b80-product-explore\n  .b80-small-arrow{\n\n    width:24px;\n    height:24px;\n\n  }\n\n\n  .b80x-menu{\n\n    width:\n      calc(100vw - 16px);\n\n    border-radius:\n      0 0 22px 22px;\n\n  }\n\n\n  .b80x-menu-inner{\n\n    padding:\n      24px 16px 18px;\n\n  }\n\n\n  .b80x-menu-head{\n\n    padding:\n      0 3px 20px;\n\n  }\n\n\n  .b80x-title{\n\n    font-size:22px;\n\n  }\n\n\n  .b80x-grid{\n\n    grid-template-columns:\n      repeat(2,minmax(0,1fr));\n\n    gap:3px;\n\n    padding:\n      15px 0;\n\n  }\n\n\n  .b80x-link{\n\n    min-height:66px;\n\n    padding:\n      10px 30px 10px 10px;\n\n  }\n\n\n  .b80x-link strong{\n\n    font-size:12px;\n\n  }\n\n\n  .b80x-link small{\n\n    font-size:7px;\n\n  }\n\n\n  .b80x-footer{\n\n    align-items:flex-end;\n\n  }\n\n\n  .b80x-utilities{\n\n    flex-direction:column;\n\n    align-items:flex-start;\n\n    gap:10px;\n\n  }\n\n\n  .b80x-buy{\n\n    padding:\n      0 15px;\n\n  }\n\n}\n\n\n@media(max-width:390px){\n\n\n  .b80x-grid{\n\n    grid-template-columns:1fr;\n\n  }\n\n\n  .b80x-link{\n\n    min-height:57px;\n\n  }\n\n\n  .b80x-link small{\n\n    display:none;\n\n  }\n\n}\n\n\n/* reduced motion */\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80x-menu-glass:after,\n  .b80-menu-jump,\n  .b80x-menu.is-open\n  .b80x-link{\n\n    animation:none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function(){\n\n\n  /* =====================================================\n     GET MAIN BULLET NAV\n  ===================================================== */\n\n  const nav =\n    document.getElementById(\n      'b80-nav'\n    );\n\n\n  if(!nav){\n    return;\n  }\n\n\n\n  /* =====================================================\n     MOVE NAV OUT OF HERO\n\n     Makes it stay fixed for ALL sections.\n  ===================================================== */\n\n  if(\n    nav.parentElement !==\n    document.body\n  ){\n\n    document.body.appendChild(\n      nav\n    );\n\n  }\n\n\n\n  /* =====================================================\n     REMOVE OLD NON-BUY EXPLORE\n  ===================================================== */\n\n  document\n  .querySelectorAll(\n    '.b80-explore-button'\n  )\n  .forEach(\n    function(button){\n\n      button.remove();\n\n    }\n  );\n\n\n\n  /* =====================================================\n     REMOVE OLD H CIRCLE\n  ===================================================== */\n\n  document\n  .querySelectorAll(\n    '.b80-mark'\n  )\n  .forEach(\n    function(mark){\n\n      mark.remove();\n\n    }\n  );\n\n\n\n  /* =====================================================\n     IF PREVIOUS POPUP CODE WAS INSTALLED,\n     REMOVE ITS PANEL\n  ===================================================== */\n\n  const previousMenu =\n    document.getElementById(\n      'b80-explore-panel'\n    );\n\n\n  if(previousMenu){\n\n    previousMenu.remove();\n\n  }\n\n\n\n  /* =====================================================\n     RESET HERO EXPLORE CTA\n\n     It should scroll normally.\n     It must NOT open menu.\n  ===================================================== */\n\n  document\n  .querySelectorAll(\n    '.b80-hero-explore'\n  )\n  .forEach(\n    function(oldButton){\n\n\n      const cleanButton =\n        oldButton.cloneNode(\n          true\n        );\n\n\n      oldButton.replaceWith(\n        cleanButton\n      );\n\n\n    }\n  );\n\n\n\n  /* =====================================================\n     RESET PRODUCT EXPLORE\n\n     Removes previous click handlers.\n  ===================================================== */\n\n  let productExplore =\n    nav.querySelector(\n      '.b80-product-explore'\n    );\n\n\n  if(!productExplore){\n    return;\n  }\n\n\n  const cleanExplore =\n    productExplore.cloneNode(\n      true\n    );\n\n\n  productExplore.replaceWith(\n    cleanExplore\n  );\n\n\n  productExplore =\n    cleanExplore;\n\n\n  productExplore.setAttribute(\n    'aria-haspopup',\n    'true'\n  );\n\n\n  productExplore.setAttribute(\n    'aria-expanded',\n    'false'\n  );\n\n\n\n  /* =====================================================\n     CHANGE BUY -> BUY NOW\n     OPTIONAL BUT LOOKS BETTER\n  ===================================================== */\n\n  const topBuy =\n    nav.querySelector(\n      '.b80-buy'\n    );\n\n\n  if(topBuy){\n\n    topBuy.textContent =\n      'Buy Now';\n\n  }\n\n\n\n  /* =====================================================\n     CREATE APPLE-STYLE MENU\n  ===================================================== */\n\n  const menu =\n    document.createElement(\n      'div'\n    );\n\n\n  menu.className =\n    'b80x-menu';\n\n\n  menu.id =\n    'b80x-menu';\n\n\n  menu.setAttribute(\n    'aria-hidden',\n    'true'\n  );\n\n\n  menu.innerHTML = `\n\n    <div class=\"b80x-menu-neck\"></div>\n\n    <div class=\"b80x-menu-glass\"></div>\n\n\n    <div class=\"b80x-menu-inner\">\n\n\n      <div class=\"b80x-menu-head\">\n\n\n        <div>\n\n          <div class=\"b80x-kicker\">\n            EXPLORE NITRIX 80\n          </div>\n\n          <h3 class=\"b80x-title\">\n            Built To\n            <span>Attack.</span>\n          </h3>\n\n        </div>\n\n\n        <button\n          class=\"b80x-close\"\n          type=\"button\"\n          aria-label=\"Close menu\"\n        ></button>\n\n\n      </div>\n\n\n      <div class=\"b80x-grid\">\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#b80-hero\"\n        >\n\n          <span class=\"b80x-num\">\n            01\n          </span>\n\n          <strong>\n            Highlights\n          </strong>\n\n          <small>\n            Meet the Bullet\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#bullet-engineering\"\n          data-fallback=\"#bullet-next\"\n        >\n\n          <span class=\"b80x-num\">\n            02\n          </span>\n\n          <strong>\n            Engineering\n          </strong>\n\n          <small>\n            Under the surface\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#bullet-shaft\"\n          data-fallback=\"#bullet-next\"\n        >\n\n          <span class=\"b80x-num\">\n            03\n          </span>\n\n          <strong>\n            5.9 MM Shaft\n          </strong>\n\n          <small>\n            Built for release\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#bullet-frame\"\n          data-fallback=\"#bullet-next\"\n        >\n\n          <span class=\"b80x-num\">\n            04\n          </span>\n\n          <strong>\n            Frame\n          </strong>\n\n          <small>\n            Structure behind impact\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#bullet-performance\"\n          data-fallback=\"#bullet-next\"\n        >\n\n          <span class=\"b80x-num\">\n            05\n          </span>\n\n          <strong>\n            Performance\n          </strong>\n\n          <small>\n            Power in play\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n        <a\n          class=\"b80x-link\"\n          href=\"#bullet-specs\"\n          data-fallback=\"#bullet-next\"\n        >\n\n          <span class=\"b80x-num\">\n            06\n          </span>\n\n          <strong>\n            Specifications\n          </strong>\n\n          <small>\n            The numbers\n          </small>\n\n          <span class=\"b80x-link-arrow\">\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </span>\n\n        </a>\n\n\n      </div>\n\n\n      <div class=\"b80x-footer\">\n\n\n        <div class=\"b80x-utilities\">\n\n\n          <a\n            href=\"#bullet-specs\"\n            data-fallback=\"#bullet-next\"\n            class=\"b80x-utility\"\n          >\n\n            Tech Specs\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </a>\n\n\n          <a\n            href=\"#bullet-story\"\n            data-fallback=\"#bullet-next\"\n            class=\"b80x-utility\"\n          >\n\n            The Bullet Story\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </a>\n\n\n          <a\n            href=\"#bullet-compare\"\n            data-fallback=\"#bullet-next\"\n            class=\"b80x-utility\"\n          >\n\n            Compare\n\n            <svg viewBox=\"0 0 18 18\">\n              <path d=\"M4 9H14\"></path>\n              <path d=\"M10 5L14 9L10 13\"></path>\n            </svg>\n\n          </a>\n\n\n        </div>\n\n\n        <a\n          class=\"b80x-buy\"\n          href=\"{{ buy_link }}\"\n        >\n          Buy Nitrix 80\n        </a>\n\n\n      </div>\n\n\n    </div>\n\n  `;\n\n\n  document.body.appendChild(\n    menu\n  );\n\n\n  const close =\n    menu.querySelector(\n      '.b80x-close'\n    );\n\n\n  let menuOpen =\n    false;\n\n\n\n  /* =====================================================\n     FIND REAL SHOPIFY HEADER BOTTOM\n  ===================================================== */\n\n  const headerSelectors = [\n\n    '.section-header',\n\n    'sticky-header',\n\n    '.header-wrapper',\n\n    '#shopify-section-header',\n\n    '.shopify-section-header-sticky',\n\n    '.shopify-section-group-header-group',\n\n    '[id^=\"shopify-section-sections--\"][id$=\"__header\"]',\n\n    'header.header'\n\n  ];\n\n\n\n  function getStickyHeaderBottom(){\n\n\n    let bottom = 0;\n\n\n    const checked =\n      new Set();\n\n\n    headerSelectors.forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              checked.has(\n                element\n              )\n            ){\n              return;\n            }\n\n\n            checked.add(\n              element\n            );\n\n\n            /*\n            Don't accidentally measure\n            Bullet nav itself.\n            */\n\n            if(\n              element === nav ||\n              element.contains(nav)\n            ){\n              return;\n            }\n\n\n            const rect =\n              element\n              .getBoundingClientRect();\n\n\n            const style =\n              window\n              .getComputedStyle(\n                element\n              );\n\n\n            const visible =\n\n              style.display !==\n              'none' &&\n\n              style.visibility !==\n              'hidden' &&\n\n              Number(\n                style.opacity || 1\n              ) > 0 &&\n\n              rect.height > 1 &&\n\n              rect.height < 220 &&\n\n              rect.bottom > 0 &&\n\n              /*\n              must actually be\n              around top of viewport\n              */\n\n              rect.top < 180;\n\n\n            if(!visible){\n              return;\n            }\n\n\n            /*\n            IMPORTANT:\n\n            Use ACTUAL rect.bottom.\n\n            Don't clamp bottom to\n            rect.height like old code.\n\n            This is what keeps the\n            product nav underneath\n            a sliding Shopify header.\n            */\n\n            bottom =\n              Math.max(\n                bottom,\n                rect.bottom\n              );\n\n\n          }\n        );\n\n\n      }\n    );\n\n\n    return Math.max(\n      0,\n      Math.min(\n        bottom,\n        210\n      )\n    );\n\n  }\n\n\n\n  /* =====================================================\n     POSITION TOP BAR\n  ===================================================== */\n\n  function positionNav(){\n\n\n    const headerBottom =\n      getStickyHeaderBottom();\n\n\n    const gap =\n      window.innerWidth <= 750\n      ? 8\n      : 10;\n\n\n    const safeTop =\n      Math.round(\n        headerBottom + gap\n      );\n\n\n    document\n    .documentElement\n    .style\n    .setProperty(\n\n      '--b80-safe-nav-top',\n\n      safeTop + 'px'\n\n    );\n\n  }\n\n\n\n  /* =====================================================\n     POSITION MENU UNDER BAR\n  ===================================================== */\n\n  function positionMenu(){\n\n\n    const navRect =\n      nav\n      .getBoundingClientRect();\n\n\n    const buttonRect =\n      productExplore\n      .getBoundingClientRect();\n\n\n    const viewport =\n      window.innerWidth;\n\n\n    const width =\n      viewport <= 750\n\n      ? viewport - 16\n\n      : Math.min(\n          900,\n          viewport - 32\n        );\n\n\n    const buttonCenter =\n      buttonRect.left +\n      (\n        buttonRect.width / 2\n      );\n\n\n    const menuLeft =\n      (\n        viewport -\n        width\n      ) / 2;\n\n\n    const connectorX =\n      Math.max(\n        42,\n\n        Math.min(\n          width - 42,\n          buttonCenter -\n          menuLeft\n        )\n      );\n\n\n    menu.style.width =\n      width + 'px';\n\n\n    menu.style.top =\n      (\n        navRect.bottom +\n        9\n      ) + 'px';\n\n\n    menu.style.setProperty(\n\n      '--menu-connector-x',\n\n      connectorX + 'px'\n\n    );\n\n  }\n\n\n\n  /* =====================================================\n     JUMP BUTTON\n  ===================================================== */\n\n  function jumpExplore(){\n\n\n    productExplore\n    .classList\n    .remove(\n      'b80-menu-jump'\n    );\n\n\n    void productExplore.offsetWidth;\n\n\n    productExplore\n    .classList\n    .add(\n      'b80-menu-jump'\n    );\n\n\n    setTimeout(\n      function(){\n\n        productExplore\n        .classList\n        .remove(\n          'b80-menu-jump'\n        );\n\n      },\n      450\n    );\n\n  }\n\n\n\n  /* =====================================================\n     OPEN\n  ===================================================== */\n\n  function openMenu(){\n\n\n    /*\n    ONLY AVAILABLE IN\n    BUY BAR / PRODUCT STATE\n    */\n\n    if(\n      !nav.classList.contains(\n        'is-product'\n      )\n    ){\n      return;\n    }\n\n\n    jumpExplore();\n\n\n    positionNav();\n\n    positionMenu();\n\n\n    menu.classList.add(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'false'\n    );\n\n\n    productExplore\n    .setAttribute(\n      'aria-expanded',\n      'true'\n    );\n\n\n    menuOpen =\n      true;\n\n  }\n\n\n\n  /* =====================================================\n     CLOSE\n  ===================================================== */\n\n  function closeMenu(){\n\n\n    menu.classList.remove(\n      'is-open'\n    );\n\n\n    menu.setAttribute(\n      'aria-hidden',\n      'true'\n    );\n\n\n    productExplore\n    .setAttribute(\n      'aria-expanded',\n      'false'\n    );\n\n\n    menuOpen =\n      false;\n\n  }\n\n\n\n  /* =====================================================\n     PRODUCT EXPLORE ONLY\n  ===================================================== */\n\n  productExplore\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      event.preventDefault();\n\n      event.stopPropagation();\n\n\n      if(menuOpen){\n\n        jumpExplore();\n\n        closeMenu();\n\n      }\n\n      else{\n\n        openMenu();\n\n      }\n\n\n    }\n  );\n\n\n\n  /* =====================================================\n     CLOSE BUTTON\n  ===================================================== */\n\n  close\n  .addEventListener(\n    'click',\n    closeMenu\n  );\n\n\n\n  /* =====================================================\n     MENU LINKS\n  ===================================================== */\n\n  menu\n  .querySelectorAll(\n    'a[href^=\"#\"]'\n  )\n  .forEach(\n    function(link){\n\n\n      link.addEventListener(\n        'click',\n        function(event){\n\n\n          event.preventDefault();\n\n\n          const href =\n            link.getAttribute(\n              'href'\n            );\n\n\n          const fallback =\n            link.getAttribute(\n              'data-fallback'\n            );\n\n\n          let target =\n            null;\n\n\n          try{\n\n            target =\n              document\n              .querySelector(\n                href\n              );\n\n          }\n\n          catch(error){}\n\n\n          if(\n            !target &&\n            fallback\n          ){\n\n            try{\n\n              target =\n                document\n                .querySelector(\n                  fallback\n                );\n\n            }\n\n            catch(error){}\n\n          }\n\n\n          closeMenu();\n\n\n          if(target){\n\n            setTimeout(\n              function(){\n\n                target\n                .scrollIntoView({\n                  behavior:'smooth',\n                  block:'start'\n                });\n\n              },\n              110\n            );\n\n          }\n\n\n        }\n      );\n\n\n    }\n  );\n\n\n\n  /* =====================================================\n     CLICK OUTSIDE\n  ===================================================== */\n\n  document\n  .addEventListener(\n    'click',\n    function(event){\n\n\n      if(!menuOpen){\n        return;\n      }\n\n\n      if(\n        !menu.contains(\n          event.target\n        ) &&\n        !productExplore.contains(\n          event.target\n        )\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n\n  /* =====================================================\n     ESC\n  ===================================================== */\n\n  document\n  .addEventListener(\n    'keydown',\n    function(event){\n\n\n      if(\n        event.key ===\n        'Escape'\n      ){\n\n        closeMenu();\n\n      }\n\n\n    }\n  );\n\n\n\n  /* =====================================================\n     LIVE HEADER FOLLOWING\n\n     Shopify sticky header can animate\n     into view using transforms.\n\n     Keep Bullet bar attached beneath it.\n  ===================================================== */\n\n  let runningUntil =\n    0;\n\n\n  function followHeader(){\n\n\n    positionNav();\n\n\n    if(menuOpen){\n\n      positionMenu();\n\n    }\n\n\n    if(\n      performance.now() <\n      runningUntil\n    ){\n\n      requestAnimationFrame(\n        followHeader\n      );\n\n    }\n\n  }\n\n\n\n  function trackHeaderFor(\n    milliseconds\n  ){\n\n\n    runningUntil =\n      Math.max(\n        runningUntil,\n        performance.now() +\n        milliseconds\n      );\n\n\n    requestAnimationFrame(\n      followHeader\n    );\n\n  }\n\n\n\n  /* =====================================================\n     SCROLL\n  ===================================================== */\n\n  window\n  .addEventListener(\n    'scroll',\n    function(){\n\n\n      /*\n      Track for enough time to follow\n      Shopify's header slide animation.\n      */\n\n      trackHeaderFor(\n        650\n      );\n\n\n      /*\n      Menu only belongs to product/\n      Buy Now bar.\n\n      Close it if user scrolls back\n      to initial nav state.\n      */\n\n      if(\n        menuOpen &&\n        !nav.classList.contains(\n          'is-product'\n        )\n      ){\n\n        closeMenu();\n\n      }\n\n\n    },\n    {\n      passive:true\n    }\n  );\n\n\n\n  /* =====================================================\n     RESIZE\n  ===================================================== */\n\n  window\n  .addEventListener(\n    'resize',\n    function(){\n\n      positionNav();\n\n      if(menuOpen){\n        positionMenu();\n      }\n\n    }\n  );\n\n\n\n  /* =====================================================\n     RESIZE OBSERVER FOR HEADER\n  ===================================================== */\n\n  if(\n    typeof ResizeObserver !==\n    'undefined'\n  ){\n\n    const observer =\n      new ResizeObserver(\n        function(){\n\n          trackHeaderFor(\n            500\n          );\n\n        }\n      );\n\n\n    headerSelectors\n    .forEach(\n      function(selector){\n\n\n        document\n        .querySelectorAll(\n          selector\n        )\n        .forEach(\n          function(element){\n\n\n            if(\n              element !== nav &&\n              !element.contains(nav)\n            ){\n\n              observer.observe(\n                element\n              );\n\n            }\n\n\n          }\n        );\n\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     INITIAL SYNC\n  ===================================================== */\n\n  positionNav();\n\n\n  /*\n  Catch Shopify's initialization\n  and sticky-header setup.\n  */\n\n  trackHeaderFor(\n    1500\n  );\n\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
