oduct-explore{\n    padding:0 12px;\n    min-width:76px;\n    justify-content:center;\n    font-size:11px;\n  }\n\n  .b80-product-explore .b80-small-arrow{\n    display:none !important;\n  }\n\n\n  .b80-heading{\n    font-size:50px;\n  }\n\n}\n\n\n@media(max-width:350px){\n\n  .b80-nav-links{\n    gap:8px;\n  }\n\n  .b80-nav-links a{\n    font-size:9px;\n  }\n\n  .b80-product-identity strong{\n    font-size:14px;\n  }\n\n  .b80-product-explore{\n    min-width:70px;\n    padding:0 10px;\n    font-size:10px;\n  }\n\n  .b80-buy{\n    padding:0 11px;\n    font-size:10px;\n  }\n\n}\n\n\n@media(prefers-reduced-motion:reduce){\n\n  .b80-nav-sheen,\n  .b80-nav-tracer span,\n  .b80-scroll i:before,\n  .b80-menu-glass:after,\n  .b80-menu-jump,\n  .b80-menu.is-open\n  .b80-menu-link{\n    animation:none !important;\n  }\n\n}\n\n\n\n/* =========================================================\n   FINAL EXPLORE MENU TYPOGRAPHY + VISIBILITY FIX\n   Keeps existing menu logic/animation intact.\n========================================================= */\n\n#b80-menu,\n#b80-menu *{\n  font-family:\n    \"Figtree\",\n    -apple-system,\n    BlinkMacSystemFont,\n    \"Segoe UI\",\n    sans-serif !important;\n}\n\n/* Make the glass slightly darker so white copy reads clearly */\n.b80-menu{\n  background:\n    linear-gradient(\n      145deg,\n      rgba(17,18,20,.97),\n      rgba(7,8,10,.95) 56%,\n      rgba(3,4,5,.98)\n    ) !important;\n\n  border-color:rgba(255,255,255,.10) !important;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.07),\n    0 30px 90px rgba(0,0,0,.46) !important;\n}\n\n.b80-menu-inner{\n  padding:32px 36px 28px !important;\n}\n\n/* HEADER */\n.b80-menu-head{\n  padding-bottom:26px !important;\n  border-bottom:1px solid rgba(255,255,255,.065) !important;\n}\n\n.b80-menu-kicker{\n  margin-bottom:10px !important;\n\n  color:rgba(255,255,255,.62) !important;\n\n  font-size:12px !important;\n  line-height:1.15 !important;\n\n  font-weight:600 !important;\n  lette