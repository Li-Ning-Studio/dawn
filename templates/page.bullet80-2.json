      "settings": {
        "custom_liquid": "<div id=\"bullet-loader\" class=\"bl-loader\">\n\n  <div class=\"bl-grid\"></div>\n  <div class=\"bl-scan\"></div>\n\n  <div class=\"bl-top-left\">HNDRD // N80</div>\n  <div class=\"bl-top-right\">ACCESS PROTOCOL</div>\n\n  <!-- CENTER -->\n  <div class=\"bl-center\">\n\n    <div class=\"bl-status\">\n      <span class=\"bl-dot\"></span>\n      SECURE ACCESS\n    </div>\n\n    <div class=\"bl-label\">\n      DOCUMENT STATUS\n    </div>\n\n    <div class=\"bl-classified-wrap\">\n      <h1 class=\"bl-title\" data-text=\"CLASSIFIED\">\n        CLASSIFIED\n      </h1>\n    </div>\n\n    <div class=\"bl-redacted\">\n      <i></i>\n      <i></i>\n      <i></i>\n    </div>\n\n    <div class=\"bl-file\">\n      NITRIX 80 // RESTRICTED FILE\n    </div>\n\n  </div>\n\n\n  <!-- BOTTOM LIVE LOADING -->\n  <div class=\"bl-loader-bottom\">\n\n    <div class=\"bl-load-info\">\n\n      <span id=\"bl-status-text\">\n        VERIFYING CLEARANCE\n      </span>\n\n      <div class=\"bl-number\">\n        <span id=\"bl-number\">10</span><small>%</small>\n      </div>\n\n    </div>\n\n\n    <div class=\"bl-progress-track\">\n\n      <div\n        id=\"bl-progress\"\n        class=\"bl-progress\"\n      >\n        <div class=\"bl-progress-glow\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"bl-meta\">\n\n      <span>FILE 080</span>\n\n      <span id=\"bl-stage\">\n        INITIALIZING\n      </span>\n\n      <span>LEVEL 05</span>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<style>\n\nhtml,\nbody{\n  margin:0;\n}\n\n#bullet-loader,\n#bullet-loader *{\n  box-sizing:border-box;\n}\n\nbody.bl-locked{\n  overflow:hidden!important;\n}\n\n\n/* =====================================\nLOADER\n===================================== */\n\n.bl-loader{\n  position:fixed;\n  inset:0;\n\n  width:100%;\n  height:100dvh;\n\n  background:#000;\n\n  color:#fff;\n\n  z-index:2147483647;\n\n  overflow:hidden;\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  transform:translateY(0);\n\n  transition:\n    transform .5s\n    cubic-bezier(.76,0,.24,1);\n}\n\n\n/* =====================================\nGRID\n===================================== */\n\n.bl-grid{\n  position:absolute;\n  inset:0;\n\n  z-index:1;\n\n  pointer-events:none;\n\n  background:\n    linear-gradient(\n      rgba(255,255,255,.025) 1px,\n      transparent 1px\n    ),\n    linear-gradient(\n      90deg,\n      rgba(255,255,255,.025) 1px,\n      transparent 1px\n    );\n\n  background-size:\n    56px 56px;\n}\n\n\n/* VIGNETTE */\n\n.bl-loader:before{\n  content:\"\";\n\n  position:absolute;\n  inset:0;\n\n  z-index:2;\n\n  pointer-events:none;\n\n  background:\n    radial-gradient(\n      circle at center,\n      transparent 10%,\n      rgba(0,0,0,.25) 55%,\n      rgba(0,0,0,.82) 100%\n    );\n}\n\n\n/* =====================================\nSCANNER\n===================================== */\n\n.bl-scan{\n  position:absolute;\n\n  z-index:3;\n\n  left:0;\n  top:-180px;\n\n  width:100%;\n  height:180px;\n\n  pointer-events:none;\n\n  background:\n    linear-gradient(\n      to bottom,\n      transparent,\n      rgba(255,255,255,.02),\n      rgba(255,255,255,.08),\n      rgba(255,255,255,.02),\n      transparent\n    );\n\n  animation:\n    blScanMove 2.5s linear forwards;\n}\n\n\n@keyframes blScanMove{\n\n  from{\n    transform:\n      translateY(0);\n  }\n\n  to{\n    transform:\n      translateY(calc(100vh + 360px));\n  }\n\n}\n\n\n/* =====================================\nTOP INFORMATION\n===================================== */\n\n.bl-top-left,\n.bl-top-right{\n  position:absolute;\n\n  top:26px;\n\n  z-index:20;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.27em;\n\n  color:\n    rgba(255,255,255,.45);\n}\n\n\n.bl-top-left{\n  left:30px;\n}\n\n\n.bl-top-right{\n  right:30px;\n}\n\n\n/* =====================================\nCENTER AREA\n===================================== */\n\n.bl-center{\n  position:absolute;\n\n  z-index:30;\n\n  left:50%;\n  top:45%;\n\n  width:92%;\n\n  max-width:1100px;\n\n  transform:\n    translate(-50%,-50%);\n\n  text-align:center;\n}\n\n\n/* =====================================\nSECURE ACCESS\n===================================== */\n\n.bl-status{\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  gap:10px;\n\n  margin-bottom:16px;\n\n  font-size:9px;\n\n  font-weight:700;\n\n  letter-spacing:.38em;\n\n  color:\n    rgba(255,255,255,.7);\n}\n\n\n.bl-dot{\n  width:6px;\n  height:6px;\n\n  border-radius:50%;\n\n  background:#fff;\n\n  box-shadow:\n    0 0 10px\n    rgba(255,255,255,.7);\n\n  animation:\n    blBlink .4s steps(1) infinite;\n}\n\n\n@keyframes blBlink{\n\n  50%{\n    opacity:.15;\n  }\n\n}\n\n\n/* =====================================\nDOCUMENT STATUS\n===================================== */\n\n.bl-label{\n  margin-bottom:8px;\n\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.58em;\n\n  color:\n    rgba(255,255,255,.45);\n}\n\n\n/* =====================================\nCLASSIFIED\n===================================== */\n\n.bl-classified-wrap{\n  overflow:visible;\n}\n\n\n.bl-title{\n  position:relative;\n\n  display:inline-block;\n\n  margin:0;\n\n  color:#fff!important;\n\n  opacity:1!important;\n  visibility:visible!important;\n\n  font-size:\n    clamp(60px,10vw,155px);\n\n  font-weight:900;\n\n  line-height:.88;\n\n  letter-spacing:-.06em;\n\n  text-shadow:\n    0 0 1px #fff,\n    0 0 20px\n    rgba(255,255,255,.12);\n\n  animation:\n    blTitleIn .55s\n    cubic-bezier(.15,.85,.3,1)\n    forwards;\n}\n\n\n@keyframes blTitleIn{\n\n  0%{\n    opacity:0;\n    transform:\n      translateY(20px)\n      scaleX(.96);\n\n    filter:blur(8px);\n  }\n\n  100%{\n    opacity:1;\n    transform:\n      translateY(0)\n      scaleX(.96);\n\n    filter:blur(0);\n  }\n\n}\n\n\n/* GLITCH */\n\n.bl-title:before,\n.bl-title:after{\n  content:\n    attr(data-text);\n\n  position:absolute;\n  inset:0;\n\n  color:#fff;\n\n  pointer-events:none;\n\n  opacity:0;\n}\n\n\n.bl-title.bl-glitch:before{\n  opacity:.35;\n\n  transform:\n    translateX(-6px);\n\n  clip-path:\n    inset(15% 0 65% 0);\n}\n\n\n.bl-title.bl-glitch:after{\n  opacity:.22;\n\n  transform:\n    translateX(6px);\n\n  clip-path:\n    inset(68% 0 10% 0);\n}\n\n\n/* =====================================\nREDACTED BARS\n===================================== */\n\n.bl-redacted{\n  display:flex;\n\n  align-items:center;\n  justify-content:center;\n\n  gap:6px;\n\n  width:min(500px,70vw);\n\n  margin:\n    23px auto 0;\n}\n\n\n.bl-redacted i{\n  display:block;\n\n  height:5px;\n\n  background:#fff;\n\n  opacity:.9;\n}\n\n\n.bl-redacted i:nth-child(1){\n  width:20%;\n}\n\n\n.bl-redacted i:nth-child(2){\n  width:58%;\n}\n\n\n.bl-redacted i:nth-child(3){\n  width:12%;\n}\n\n\n/* =====================================\nFILE NAME\n===================================== */\n\n.bl-file{\n  margin-top:14px;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.34em;\n\n  color:\n    rgba(255,255,255,.44);\n}\n\n\n/* =====================================\nBOTTOM LOADER\n===================================== */\n\n.bl-loader-bottom{\n  position:absolute;\n\n  z-index:50;\n\n  left:50%;\n  bottom:42px;\n\n  width:min(800px,88vw);\n\n  transform:\n    translateX(-50%);\n}\n\n\n/* =====================================\nLOAD INFO\n===================================== */\n\n.bl-load-info{\n  display:flex;\n\n  align-items:flex-end;\n\n  justify-content:\n    space-between;\n\n  margin-bottom:10px;\n}\n\n\n#bl-status-text{\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.27em;\n\n  color:\n    rgba(255,255,255,.65);\n}\n\n\n/* =====================================\nPERCENTAGE\n===================================== */\n\n.bl-number{\n  display:flex;\n\n  align-items:flex-start;\n\n  color:#fff;\n\n  font-size:26px;\n\n  font-weight:800;\n\n  line-height:1;\n\n  font-variant-numeric:\n    tabular-nums;\n}\n\n\n.bl-number small{\n  margin-top:2px;\n  margin-left:2px;\n\n  font-size:10px;\n\n  color:\n    rgba(255,255,255,.55);\n}\n\n\n/* =====================================\nREAL-TIME PROGRESS TRACK\n===================================== */\n\n.bl-progress-track{\n  position:relative;\n\n  width:100%;\n  height:5px;\n\n  background:\n    rgba(255,255,255,.12);\n\n  overflow:hidden;\n}\n\n\n/* ACTUAL MOVING BAR */\n\n.bl-progress{\n  position:absolute;\n\n  left:0;\n  top:0;\n\n  width:100%;\n  height:100%;\n\n  background:#fff;\n\n  transform:\n    scaleX(.1);\n\n  transform-origin:\n    left center;\n\n  will-change:\n    transform;\n}\n\n\n/* MOVING BRIGHT EDGE */\n\n.bl-progress-glow{\n  position:absolute;\n\n  right:-1px;\n  top:-7px;\n\n  width:3px;\n  height:19px;\n\n  background:#fff;\n\n  box-shadow:\n    0 0 8px #fff,\n    0 0 18px\n    rgba(255,255,255,.8);\n}\n\n\n/* =====================================\nBOTTOM META\n===================================== */\n\n.bl-meta{\n  display:flex;\n\n  justify-content:\n    space-between;\n\n  align-items:center;\n\n  margin-top:10px;\n\n  font-size:7px;\n\n  font-weight:700;\n\n  letter-spacing:.24em;\n\n  color:\n    rgba(255,255,255,.35);\n}\n\n\n#bl-stage{\n  color:\n    rgba(255,255,255,.55);\n}\n\n\n/* =====================================\nACCESS GRANTED\n===================================== */\n\n.bl-loader.bl-complete\n.bl-progress{\n  box-shadow:\n    0 0 18px\n    rgba(255,255,255,.65);\n}\n\n\n.bl-loader.bl-complete\n.bl-title{\n  animation:\n    blCompleteFlash\n    .18s ease;\n}\n\n\n@keyframes blCompleteFlash{\n\n  0%{\n    opacity:1;\n  }\n\n  40%{\n    opacity:.45;\n  }\n\n  100%{\n    opacity:1;\n  }\n\n}\n\n\n/* =====================================\nEXIT\n===================================== */\n\n.bl-loader.bl-exit{\n  transform:\n    translateY(-105%);\n}\n\n\n/* =====================================\nMOBILE\n===================================== */\n\n@media(max-width:600px){\n\n  .bl-center{\n    top:43%;\n  }\n\n  .bl-title{\n    font-size:\n      clamp(\n        46px,\n        16vw,\n        76px\n      );\n  }\n\n  .bl-status{\n    font-size:7px;\n\n    letter-spacing:.28em;\n  }\n\n  .bl-label{\n    font-size:6px;\n\n    letter-spacing:.42em;\n  }\n\n  .bl-redacted{\n    width:73vw;\n\n    margin-top:18px;\n  }\n\n  .bl-file{\n    font-size:6px;\n\n    letter-spacing:.22em;\n  }\n\n  .bl-loader-bottom{\n    bottom:30px;\n\n    width:89vw;\n  }\n\n  #bl-status-text{\n    font-size:6px;\n\n    letter-spacing:.16em;\n  }\n\n  .bl-number{\n    font-size:22px;\n  }\n\n  .bl-progress-track{\n    height:4px;\n  }\n\n  .bl-meta{\n    font-size:5px;\n\n    letter-spacing:.16em;\n  }\n\n  .bl-top-left,\n  .bl-top-right{\n    top:18px;\n\n    font-size:5px;\n\n    letter-spacing:.18em;\n  }\n\n  .bl-top-left{\n    left:18px;\n  }\n\n  .bl-top-right{\n    right:18px;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function(){\n\n  const loader =\n    document.getElementById(\n      'bullet-loader'\n    );\n\n  if(!loader) return;\n\n\n  const number =\n    document.getElementById(\n      'bl-number'\n    );\n\n  const progress =\n    document.getElementById(\n      'bl-progress'\n    );\n\n  const statusText =\n    document.getElementById(\n      'bl-status-text'\n    );\n\n  const stage =\n    document.getElementById(\n      'bl-stage'\n    );\n\n  const title =\n    loader.querySelector(\n      '.bl-title'\n    );\n\n\n  document.body.classList.add(\n    'bl-locked'\n  );\n\n\n  /*\n  ==============================\n  TIMING\n\n  Counter:\n  2.5 seconds\n\n  Hold:\n  .20 seconds\n\n  Exit:\n  .50 seconds\n  ==============================\n  */\n\n  const duration = 2500;\n\n  const startPercent = 10;\n\n  const endPercent = 100;\n\n  let startTime = null;\n\n  let lastGlitch = 0;\n\n\n  /*\n  ==============================\n  ANIMATION LOOP\n  ==============================\n  */\n\n  function animate(time){\n\n\n    if(!startTime){\n      startTime = time;\n    }\n\n\n    const elapsed =\n      time - startTime;\n\n\n    /*\n    TRUE REAL-TIME PROGRESS\n\n    0.0 -> 1.0\n\n    NO FAKE EASING\n    */\n\n    const timeline =\n      Math.min(\n        elapsed / duration,\n        1\n      );\n\n\n    /*\n    10 -> 100\n    */\n\n    const exactPercent =\n      startPercent +\n      (\n        endPercent -\n        startPercent\n      )\n      *\n      timeline;\n\n\n    /*\n    NUMBER\n    */\n\n    const displayedPercent =\n      Math.floor(\n        exactPercent\n      );\n\n\n    number.textContent =\n      displayedPercent;\n\n\n    /*\n    BAR\n\n    IMPORTANT:\n\n    Uses exact decimal percentage,\n    not rounded number.\n\n    Example:\n\n    number = 47%\n\n    actual bar may be 47.68432%\n\n    This creates perfectly smooth\n    movement at 60/120fps.\n    */\n\n    progress.style.transform =\n      'scaleX(' +\n      (\n        exactPercent / 100\n      ) +\n      ')';\n\n\n    /*\n    ==============================\n    LIVE STATUS\n    ==============================\n    */\n\n    if(timeline < .20){\n\n      statusText.textContent =\n        'VERIFYING CLEARANCE';\n\n      stage.textContent =\n        'IDENTITY CHECK';\n\n    }\n\n    else if(timeline < .42){\n\n      statusText.textContent =\n        'DECRYPTING FILE';\n\n      stage.textContent =\n        'DECRYPTING';\n\n    }\n\n    else if(timeline < .66){\n\n      statusText.textContent =\n        'READING BALLISTICS';\n\n      stage.textContent =\n        'BALLISTICS';\n\n    }\n\n    else if(timeline < .88){\n\n      statusText.textContent =\n        'AUTHORIZING ACCESS';\n\n      stage.textContent =\n        'CLEARANCE';\n\n    }\n\n    else{\n\n      statusText.textContent =\n        'ACCESS GRANTED';\n\n      stage.textContent =\n        'AUTHORIZED';\n\n    }\n\n\n    /*\n    ==============================\n    CONTROLLED GLITCH\n    ==============================\n    */\n\n    if(\n      time - lastGlitch > 260 &&\n      timeline < .88\n    ){\n\n      lastGlitch = time;\n\n\n      title.classList.add(\n        'bl-glitch'\n      );\n\n\n      setTimeout(\n        function(){\n\n          title.classList.remove(\n            'bl-glitch'\n          );\n\n        },\n        45\n      );\n\n    }\n\n\n    /*\n    CONTINUE\n    */\n\n    if(timeline < 1){\n\n      requestAnimationFrame(\n        animate\n      );\n\n      return;\n    }\n\n\n    /*\n    ==============================\n    FORCE EXACT FINAL STATE\n    ==============================\n    */\n\n    number.textContent =\n      '100';\n\n\n    progress.style.transform =\n      'scaleX(1)';\n\n\n    statusText.textContent =\n      'ACCESS GRANTED';\n\n\n    stage.textContent =\n      'AUTHORIZED';\n\n\n    loader.classList.add(\n      'bl-complete'\n    );\n\n\n    /*\n    HOLD 100%\n    */\n\n    setTimeout(\n      function(){\n\n\n        /*\n        SLIDE LOADER AWAY\n        */\n\n        loader.classList.add(\n          'bl-exit'\n        );\n\n\n        document.body.classList.remove(\n          'bl-locked'\n        );\n\n\n        /*\n        DELETE AFTER EXIT\n        */\n\n        setTimeout(\n          function(){\n\n            loader.remove();\n\n          },\n          520\n        );\n\n\n      },\n      200\n    );\n\n  }\n\n\n  /*\n  START\n  */\n\n  requestAnimationFrame(\n    animate\n  );\n\n})();\n\n</script>\n{% comment %}\nNITRIX 80 BULLET\nGLOBAL TYPOGRAPHY SYSTEM\n\nPASTE THIS ONCE NEAR THE TOP OF THE PAGE.\n\nFONT: FIGTREE\n\nDESKTOP\nHero:          64–88px\nSection:       46–64px\nSubheading:    30–40px\nCard:          22–28px\nBig Stat:      48–68px\nIntro:         18px\nBody:          16px\nSecondary:     14px\nButtons:       13px\nLabels:        12px\nMicro:         10px\n\nMOBILE\nHero:          42–54px\nSection:       36–44px\nSubheading:    28px\nCard:          21px\nBig Stat:      38–48px\nIntro:         16px\nBody:          15px\nSecondary:     13px\nButtons:       12px\nLabels:        10px\nMicro:         9px\n{% endcomment %}\n\n\n<style>\n\n  /* =========================================================\n     FIGTREE\n  ========================================================= */\n\n  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap');\n\n\n\n  /* =========================================================\n     GLOBAL TOKENS\n  ========================================================= */\n\n  :root {\n\n    /* FONT */\n\n    --b80-font:\n      \"Figtree\",\n      -apple-system,\n      BlinkMacSystemFont,\n      \"Segoe UI\",\n      sans-serif;\n\n\n\n    /* =========================================\n       DESKTOP FONT SIZES\n    ========================================= */\n\n    --b80-fs-hero:\n      clamp(\n        64px,\n        6.2vw,\n        88px\n      );\n\n\n    --b80-fs-section:\n      clamp(\n        46px,\n        4.6vw,\n        64px\n      );\n\n\n    --b80-fs-subheading:\n      clamp(\n        30px,\n        3vw,\n        40px\n      );\n\n\n    --b80-fs-card:\n      clamp(\n        22px,\n        2vw,\n        28px\n      );\n\n\n    --b80-fs-stat:\n      clamp(\n        48px,\n        5vw,\n        68px\n      );\n\n\n    --b80-fs-intro:\n      18px;\n\n\n    --b80-fs-body:\n      16px;\n\n\n    --b80-fs-secondary:\n      14px;\n\n\n    --b80-fs-button:\n      13px;\n\n\n    --b80-fs-label:\n      12px;\n\n\n    --b80-fs-micro:\n      10px;\n\n\n\n    /* =========================================\n       LINE HEIGHTS\n    ========================================= */\n\n    --b80-lh-hero:\n      .96;\n\n\n    --b80-lh-section:\n      1.02;\n\n\n    --b80-lh-heading:\n      1.08;\n\n\n    --b80-lh-body:\n      1.5;\n\n\n\n    /* =========================================\n       LETTER SPACING\n    ========================================= */\n\n    --b80-track-hero:\n      -.05em;\n\n\n    --b80-track-section:\n      -.04em;\n\n\n    --b80-track-heading:\n      -.025em;\n\n\n    --b80-track-body:\n      -.01em;\n\n\n    --b80-track-label:\n      .12em;\n\n\n\n    /* =========================================\n       WEIGHTS\n    ========================================= */\n\n    --b80-weight-regular:\n      400;\n\n\n    --b80-weight-medium:\n      500;\n\n\n    --b80-weight-semibold:\n      600;\n\n\n    --b80-weight-bold:\n      700;\n\n  }\n\n\n\n  /* =========================================================\n     FORCE FIGTREE THROUGH ALL BULLET COMPONENTS\n  ========================================================= */\n\n  [class^=\"b80-\"],\n  [class*=\" b80-\"],\n\n  [class^=\"b80h-\"],\n  [class*=\" b80h-\"],\n\n  [class^=\"b80c-\"],\n  [class*=\" b80c-\"],\n\n  [class^=\"b80ac-\"],\n  [class*=\" b80ac-\"],\n\n  #bullet-highlights,\n  #b80-compare,\n  #b80-apple-compare,\n  #b80-hero,\n  #b80-nav,\n  #b80-menu {\n\n    font-family:\n      var(--b80-font) !important;\n\n  }\n\n\n\n  [class^=\"b80-\"] *,\n  [class*=\" b80-\"] *,\n\n  [class^=\"b80h-\"] *,\n  [class*=\" b80h-\"] *,\n\n  [class^=\"b80c-\"] *,\n  [class*=\" b80c-\"] *,\n\n  [class^=\"b80ac-\"] *,\n  [class*=\" b80ac-\"] *,\n\n  #bullet-highlights *,\n  #b80-compare *,\n  #b80-apple-compare *,\n  #b80-hero *,\n  #b80-nav *,\n  #b80-menu * {\n\n    font-family:\n      var(--b80-font) !important;\n\n  }\n\n\n\n  /* =========================================================\n     HERO\n  ========================================================= */\n\n  .b80-heading {\n\n    font-family:\n      var(--b80-font) !important;\n\n    font-size:\n      var(--b80-fs-hero) !important;\n\n    line-height:\n      var(--b80-lh-hero) !important;\n\n    font-weight:\n      var(--b80-weight-bold) !important;\n\n    letter-spacing:\n      var(--b80-track-hero) !important;\n\n  }\n\n\n  .b80-heading em {\n\n    font-family:\n      var(--b80-font) !important;\n\n    font-style:\n      normal;\n\n    font-weight:\n      var(--b80-weight-bold) !important;\n\n  }\n\n\n  .b80-copy {\n\n    font-size:\n      var(--b80-fs-intro) !important;\n\n    line-height:\n      var(--b80-lh-body) !important;\n\n    font-weight:\n      var(--b80-weight-regular) !important;\n\n    letter-spacing:\n      var(--b80-track-body) !important;\n\n  }\n\n\n\n  /* =========================================================\n     MAJOR SECTION TITLES\n  ========================================================= */\n\n  .b80-360__title,\n\n  .b80-shaft-head h2,\n\n  .b80-film__title,\n\n  .b80-xfilm__title,\n\n  .b80c-title,\n\n  .b80ac-heading h2,\n\n  .b80h-head h2 {\n\n    font-size:\n      var(--b80-fs-section) !important;\n\n    line-height:\n      var(--b80-lh-section) !important;\n\n    font-weight:\n      var(--b80-weight-bold) !important;\n\n    letter-spacing:\n      var(--b80-track-section) !important;\n\n  }\n\n\n\n  /* =========================================================\n     SECTION INTRO COPY\n  ========================================================= */\n\n  .b80-360__intro,\n\n  .b80-shaft-head p,\n\n  .b80-film__description,\n\n  .b80-xfilm__description,\n\n  .b80c-intro,\n\n  .b80ac-heading > p:last-child {\n\n    font-size:\n      var(--b80-fs-intro) !important;\n\n    line-height:\n      var(--b80-lh-body) !important;\n\n    font-weight:\n      var(--b80-weight-regular) !important;\n\n    letter-spacing:\n      var(--b80-track-body) !important;\n\n  }\n\n\n\n  /* =========================================================\n     SUBSECTION HEADINGS\n  ========================================================= */\n\n  .b80-menu-head h3,\n\n  .b80-info h3,\n\n  .b80c-upgrade-title,\n\n  .b80ac-summary h3 {\n\n    font-size:\n      var(--b80-fs-subheading);\n\n    line-height:\n      var(--b80-lh-heading);\n\n    font-weight:\n      var(--b80-weight-semibold);\n\n    letter-spacing:\n      var(--b80-track-section);\n\n  }\n\n\n\n  /* =========================================================\n     CARD TITLES\n  ========================================================= */\n\n  .b80-card-title,\n\n  .bx-copy h3,\n\n  .b80c-product-name,\n\n  .b80ac-product-name,\n\n  .b80h-slide-copy {\n\n    font-size:\n      var(--b80-fs-card) !important;\n\n    line-height:\n      var(--b80-lh-heading) !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n    letter-spacing:\n      var(--b80-track-heading) !important;\n\n  }\n\n\n\n  /* =========================================================\n     BIG SPECS / STATS\n  ========================================================= */\n\n  .b80-shaft-stat-main,\n\n  .b80-big-stat,\n\n  .b80c-delta-big,\n\n  .b80ac-feature-row--hero\n  .b80ac-feature-main {\n\n    font-size:\n      var(--b80-fs-stat) !important;\n\n    line-height:\n      .95 !important;\n\n    font-weight:\n      var(--b80-weight-bold) !important;\n\n    letter-spacing:\n      -.05em !important;\n\n  }\n\n\n\n  /* =========================================================\n     NORMAL BODY\n  ========================================================= */\n\n  .b80-body,\n\n  .b80-info p,\n\n  .b80c-delta-description {\n\n    font-size:\n      var(--b80-fs-body);\n\n    line-height:\n      var(--b80-lh-body);\n\n    font-weight:\n      var(--b80-weight-regular);\n\n    letter-spacing:\n      var(--b80-track-body);\n\n  }\n\n\n\n  /* =========================================================\n     SECONDARY COPY\n  ========================================================= */\n\n  .b80-card-copy,\n\n  .bx-copy p,\n\n  .b80-shaft-stat-bottom,\n\n  .b80c-value-name,\n\n  .b80c-product-sub,\n\n  .b80ac-product-sub,\n\n  .b80ac-feature-caption,\n\n  .b80h-slide-copy + p {\n\n    font-size:\n      var(--b80-fs-secondary);\n\n    line-height:\n      1.45;\n\n    font-weight:\n      var(--b80-weight-regular);\n\n    letter-spacing:\n      var(--b80-track-body);\n\n  }\n\n\n\n  /* =========================================================\n     BUTTONS + PILLS\n  ========================================================= */\n\n  .b80-feature-button,\n\n  .b80-product-explore,\n\n  .b80-buy,\n\n  .b80-hero-explore,\n\n  .b80-discover,\n\n  .b80-menu-buy,\n\n  .b80h-watch,\n\n  .b80c-selector-btn,\n\n  .b80ac-focus-button,\n\n  .b80-xfilm__watch {\n\n    font-size:\n      var(--b80-fs-button) !important;\n\n    line-height:\n      1 !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n    letter-spacing:\n      -.005em !important;\n\n  }\n\n\n\n  /* =========================================================\n     EYEBROWS / LABELS\n  ========================================================= */\n\n  .b80-eyebrow,\n\n  .b80c-eyebrow,\n\n  .b80c-kicker,\n\n  .b80c-upgrade-label,\n\n  .b80c-delta-label,\n\n  .b80ac-kicker,\n\n  .b80ac-summary-label,\n\n  .b80-film__eyebrow,\n\n  .b80-menu-kicker {\n\n    font-size:\n      var(--b80-fs-label) !important;\n\n    line-height:\n      1.1 !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n    letter-spacing:\n      var(--b80-track-label) !important;\n\n  }\n\n\n\n  /* =========================================================\n     MICRO UI\n  ========================================================= */\n\n  .b80-info__index,\n\n  .b80h-number,\n\n  .b80-product-identity span,\n\n  .b80-bottom-left,\n\n  .b80-bottom-right,\n\n  .b80-scroll,\n\n  .b80-menu-link b {\n\n    font-size:\n      var(--b80-fs-micro) !important;\n\n  }\n\n\n\n  /* =========================================================\n     NAVIGATION\n  ========================================================= */\n\n  .b80-nav-links a {\n\n    font-size:\n      var(--b80-fs-button) !important;\n\n    font-weight:\n      var(--b80-weight-medium) !important;\n\n  }\n\n\n  .b80-product-identity strong {\n\n    font-size:\n      18px !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n    letter-spacing:\n      -.025em !important;\n\n  }\n\n\n\n  /* =========================================================\n     FEATURE VIEWER SPEC COPY\n  ========================================================= */\n\n  .b80-info h3 {\n\n    font-size:\n      24px !important;\n\n    line-height:\n      1.08 !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n  }\n\n\n  .b80-info p {\n\n    font-size:\n      var(--b80-fs-secondary) !important;\n\n    line-height:\n      1.5 !important;\n\n  }\n\n\n\n  /* =========================================================\n     SHAFT HERO SPEC LABELS\n  ========================================================= */\n\n  .b80-shaft-stat-top {\n\n    font-size:\n      var(--b80-fs-body) !important;\n\n    font-weight:\n      var(--b80-weight-medium) !important;\n\n  }\n\n\n  .b80-shaft-stat-bottom {\n\n    font-size:\n      var(--b80-fs-body) !important;\n\n    font-weight:\n      var(--b80-weight-medium) !important;\n\n  }\n\n\n\n  /* =========================================================\n     COMPARISON VALUES\n  ========================================================= */\n\n  .b80c-value-main,\n\n  .b80ac-feature-main {\n\n    font-size:\n      var(--b80-fs-card) !important;\n\n    line-height:\n      1.08 !important;\n\n    font-weight:\n      var(--b80-weight-semibold) !important;\n\n    letter-spacing:\n      var(--b80-track-heading) !important;\n\n  }\n\n\n\n  /* =========================================================\n     MOBILE TYPOGRAPHY SYSTEM\n  ========================================================= */\n\n  @media(max-width:749px) {\n\n    :root {\n\n      --b80-fs-hero:\n        clamp(\n          42px,\n          12vw,\n          54px\n        );\n\n\n      --b80-fs-section:\n        clamp(\n          36px,\n          9.8vw,\n          44px\n        );\n\n\n      --b80-fs-subheading:\n        28px;\n\n\n      --b80-fs-card:\n        21px;\n\n\n      --b80-fs-stat:\n        clamp(\n          38px,\n          10vw,\n          48px\n        );\n\n\n      --b80-fs-intro:\n        16px;\n\n\n      --b80-fs-body:\n        15px;\n\n\n      --b80-fs-secondary:\n        13px;\n\n\n      --b80-fs-button:\n        12px;\n\n\n      --b80-fs-label:\n        10px;\n\n\n      --b80-fs-micro:\n        9px;\n\n    }\n\n\n\n    /* =========================================\n       HERO MOBILE\n    ========================================= */\n\n    .b80-heading {\n\n      font-size:\n        var(--b80-fs-hero) !important;\n\n      line-height:\n        .96 !important;\n\n    }\n\n\n    .b80-copy {\n\n      font-size:\n        var(--b80-fs-body) !important;\n\n      line-height:\n        1.5 !important;\n\n    }\n\n\n\n    /* =========================================\n       SECTION TITLES MOBILE\n    ========================================= */\n\n    .b80-360__title,\n\n    .b80-shaft-head h2,\n\n    .b80-film__title,\n\n    .b80-xfilm__title,\n\n    .b80c-title,\n\n    .b80ac-heading h2,\n\n    .b80h-head h2 {\n\n      font-size:\n        var(--b80-fs-section) !important;\n\n      line-height:\n        1.02 !important;\n\n    }\n\n\n\n    /* =========================================\n       INTRO MOBILE\n    ========================================= */\n\n    .b80-360__intro,\n\n    .b80-shaft-head p,\n\n    .b80-film__description,\n\n    .b80-xfilm__description,\n\n    .b80c-intro,\n\n    .b80ac-heading > p:last-child {\n\n      font-size:\n        var(--b80-fs-body) !important;\n\n      line-height:\n        1.5 !important;\n\n    }\n\n\n\n    /* =========================================\n       CARD MOBILE\n    ========================================= */\n\n    .b80-card-title,\n\n    .bx-copy h3,\n\n    .b80c-product-name,\n\n    .b80ac-product-name,\n\n    .b80h-slide-copy {\n\n      font-size:\n        var(--b80-fs-card) !important;\n\n    }\n\n\n\n    /* =========================================\n       STATS MOBILE\n    ========================================= */\n\n    .b80-shaft-stat-main,\n\n    .b80-big-stat,\n\n    .b80c-delta-big {\n\n      font-size:\n        var(--b80-fs-stat) !important;\n\n    }\n\n\n\n    /* ===