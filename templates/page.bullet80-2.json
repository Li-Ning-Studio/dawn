kground:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.09),\n      transparent\n    );\n\n  animation:\n    b80Sheen 8s\n    ease-in-out\n    infinite;\n}\n\n\n@keyframes b80Sheen{\n\n  0%,\n  65%{\n    left:-35%;\n  }\n\n  85%,\n  100%{\n    left:120%;\n  }\n\n}\n\n\n/* NAV STATES */\n\n.b80-nav-hero,\n.b80-nav-product{\n  position:absolute;\n  z-index:5;\n  inset:0;\n\n  display:flex;\n  align-items:center;\n}\n\n\n.b80-nav-hero{\n  justify-content:center;\n\n  padding:\n    5px 20px;\n\n  transition:\n    opacity .25s ease,\n    transform .4s ease;\n}\n\n\n.b80-nav-links{\n  display:flex;\n  align-items:center;\n\n  gap:28px;\n}\n\n\n.b80-nav-links a{\n  position:relative;\n\n  color:\n    rgba(255,255,255,.68);\n\n  text-decoration:none;\n\n  font-size:13px;\n  font-weight:550;\n}\n\n\n.b80-nav-links a:after{\n  content:\"\";\n\n  position:absolute;\n\n  left:0;\n  right:0;\n  bottom:-6px;\n\n  height:1px;\n\n  background:#fff;\n\n  transform:\n    scaleX(0);\n\n  transform-origin:left;\n\n  transition:\n    transform .25s;\n}\n\n\n.b80-nav-links a:hover{\n  color:#fff;\n}\n\n\n.b80-nav-links a:hover:after{\n  transform:\n    scaleX(1);\n}\n\n\n/* PRODUCT NAV */\n\n.b80-nav-product{\n  justify-content:\n    space-between;\n\n  padding:\n    0 8px 0 22px;\n\n  opacity:0;\n\n  pointer-events:none;\n\n  transform:\n    translateY(15px);\n\n  transition:\n    opacity .35s ease .07s,\n    transform .5s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-product-identity{\n  display:flex;\n  align-items:center;\n\n  gap:10px;\n\n  text-decoration:none;\n\n  color:#fff;\n\n  white-space:nowrap;\n}\n\n\n.b80-product-identity strong{\n  font-size:18px;\n\n  letter-spacing:\n    -.035em;\n}\n\n\n.b80-product-identity i{\n  width:1px;\n  height:15px;\n\n  background:\n    rgba(255,255,255,.18);\n}\n\n\n.b80-product-identity span{\n  color:\n    rgba(255,255,255,.60);\n\n  font-size:11px;\n\n  font-weight:700;\n\n  letter-spacing:.18em;\n}\n\n\n.b80-product-right{\n  display:flex;\n  align-items:center;\n\n  gap:8px;\n}\n\n\n/* EXPLORE ONLY IN BUY BAR */\n\n.b80-product-explore{\n  position:relative;\n\n  height:36px;\n\n  padding:\n    0 5px 0 14px;\n\n  display:flex;\n  align-items:center;\n\n  gap:10px;\n\n  overflow:hidden;\n\n  border:\n    1px solid\n    rgba(255,255,255,.18);\n\n  border-radius:999px;\n\n  background:\n    linear-gradient(\n      120deg,\n      rgba(255,255,255,.08),\n      rgba(255,255,255,.025)\n    );\n\n  color:#fff;\n\n  font:inherit;\n  font-size:12px;\n  font-weight:600;\n\n  cursor:pointer;\n\n  backdrop-filter:\n    blur(14px);\n\n  -webkit-backdrop-filter:\n    blur(14px);\n\n  transition:\n    background .25s,\n    border-color .25s,\n    transform .3s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-product-explore:before{\n  content:\"\";\n\n  position:absolute;\n\n  top:-100%;\n  left:-60%;\n\n  width:35%;\n  height:300%;\n\n  transform:\n    rotate(20deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.12),\n      transparent\n    );\n\n  transition:\n    left .7s\n    cubic-bezier(.16,1,.3,1);\n}\n\n\n.b80-product-explore:hover:before{\n  left:130%;\n}\n\n\n.b80-product-explore:hover{\n  background:\n    rgba(255,255,255,.085);\n\n  border-color:\n    rgba(255,255,255,.28);\n}\n\n\n.b80-small-arrow{\n  width:27px;\n  height:27px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  border-radius:50%;\n\n  background:\n    rgba(255,255,255,.1);\n}\n\n\n.b80-small-arrow svg,\n.b80-hero-arrow svg{\n  width:13px;\n  height:13px;\n\n  fill:none;\n\n  stroke:currentColor;\n\n  stroke-width:1.4;\n\n  stroke-linecap:round;\n\n  stroke-linejoin:round;\n}\n\n\n/* BUY */\n\n.b80-buy{\n  height:36px;\n\n  padding:\n    0 16px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#08090a