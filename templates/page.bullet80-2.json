ation:none;\n\n  font-size:11px;\n\n  transition:\n    color .25s;\n}\n\n\n.b80-menu-utils a:hover{\n  color:#fff;\n}\n\n\n.b80-menu-buy{\n  height:38px;\n\n  padding:\n    0 19px;\n\n  display:flex;\n  align-items:center;\n\n  border-radius:999px;\n\n  background:#fff;\n\n  color:#08090a;\n\n  text-decoration:none;\n\n  font-size:9px;\n\n  font-weight:650;\n\n  white-space:nowrap;\n\n  transition:\n    transform .3s;\n}\n\n\n.b80-menu-buy:hover{\n  transform:\n    scale(1.035);\n}\n\n\n/* MOBILE */\n\n@media(max-width:750px){\n\n  .b80-nav{\n    width:\n      calc(100vw - 24px);\n\n    height:46px;\n  }\n\n\n  .b80-nav-links{\n    gap:15px;\n  }\n\n\n  .b80-nav-links a{\n    font-size:11px;\n    font-weight:600;\n    color:rgba(255,255,255,.90);\n  }\n\n\n  .b80-nav.is-product{\n    width:\n      calc(100vw - 16px);\n\n    height:52px;\n\n    border-radius:16px;\n  }\n\n\n  .b80-nav-product{\n    padding:\n      0 6px 0 14px;\n  }\n\n\n  .b80-product-identity strong{\n    font-size:16px;\n  }\n\n\n  .b80-product-identity i,\n  .b80-product-identity span{\n    display:none;\n  }\n\n\n  .b80-product-right{\n    gap:5px;\n  }\n\n\n  .b80-product-explore{\n    height:36px;\n\n    padding:0 15px;\n\n    font-size:12px;\n    font-weight:650;\n  }\n\n  .b80-product-explore > span:first-child{display:inline !important;}\n  .b80-product-explore .b80-small-arrow{display:none !important;}\n\n\n  .b80-small-arrow{\n    width:24px;\n    height:24px;\n  }\n\n\n  .b80-buy{\n    height:36px;\n\n    padding:0 15px;\n\n    font-size:12px;\n  }\n\n\n  .b80-hero{\n    min-height:680px;\n  }\n\n\n  .b80-content{\n    top:45%;\n\n    width:93vw;\n  }\n\n\n  .b80-eyebrow{\n    margin-bottom:24px;\n  }\n\n\n  .b80-heading{\n    font-size:\n      clamp(\n        54px,\n        17vw,\n        80px\n      );\n\n    line-height:.82;\n  }\n\n\n  .b80-copy{\n    margin-top:28px;\n    width:min(520px,88vw);\n    color:rgba(255,255,255,.78);\n    font-size:15px;\n    line-height:1.55;\n  }\n\n\n 