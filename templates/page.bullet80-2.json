      "settings": {
        "custom_liquid": "<div id=\"bulletMorphHero\" class=\"bmh\">\n  <div class=\"bmh-bg\"></div>\n  <div class=\"bmh-grid\"></div>\n  <div class=\"bmh-vignette\"></div>\n  <div class=\"bmh-smoke bmh-smoke-1\"></div>\n  <div class=\"bmh-smoke bmh-smoke-2\"></div>\n\n  <div class=\"bmh-inner\">\n\n    <div class=\"bmh-side bmh-side-left\">\n      <div class=\"bmh-side-line\"></div>\n\n      <div class=\"bmh-side-block\">\n        <div class=\"bmh-side-kicker\">01</div>\n        <div class=\"bmh-side-title\">PROJECTILE FORM</div>\n        <div class=\"bmh-side-copy\">\n          A live round silhouette leads the reveal. The energy stays compressed before release.\n        </div>\n      </div>\n\n      <div class=\"bmh-side-block\">\n        <div class=\"bmh-side-kicker\">02</div>\n        <div class=\"bmh-side-title\">IGNITION PHASE</div>\n        <div class=\"bmh-side-copy\">\n          Heat, sparks and combustion streaks drive a fluid transformation into attack mode.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"bmh-center\">\n\n      <div class=\"bmh-topcopy\">NITRIX 80 BULLET</div>\n\n      <div class=\"bmh-stage\">\n        <div class=\"bmh-core\">\n\n          <div class=\"bmh-ring\"></div>\n          <div class=\"bmh-flash\"></div>\n          <div class=\"bmh-fire\"></div>\n          <div class=\"bmh-embers\">\n            <span></span><span></span><span></span><span></span>\n            <span></span><span></span><span></span><span></span>\n          </div>\n\n          <img\n            class=\"bmh-bullet\"\n            src=\"PASTE_BULLET_IMAGE_URL_HERE\"\n            alt=\"Bullet\"\n          >\n\n          <img\n            class=\"bmh-racket\"\n            src=\"PASTE_RACKET_IMAGE_URL_HERE\"\n            alt=\"Nitrix 80 Bullet racket\"\n          >\n\n        </div>\n      </div>\n\n      <div class=\"bmh-content\">\n        <div class=\"bmh-eyebrow\">ATTACK CONFIGURATION</div>\n\n        <h1 class=\"bmh-title\">\n          YOUR LICENSE<br>TO KILL\n        </h1>\n\n        <p class=\"bmh-text\">\n          From projectile to precision. A weaponized attack frame built to load fast, release faster, and hit with hair trigger intent.\n        </p>\n\n        <div class=\"bmh-cta-row\">\n          <a href=\"#register\" class=\"bmh-btn bmh-btn-primary\">REGISTER NOW</a>\n          <a href=\"#specs\" class=\"bmh-btn bmh-btn-ghost\">VIEW SPECS</a>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"bmh-side bmh-side-right\">\n      <div class=\"bmh-side-line\"></div>\n\n      <div class=\"bmh-side-block\">\n        <div class=\"bmh-side-kicker\">03</div>\n        <div class=\"bmh-side-title\">5.9 MM SHAFT</div>\n        <div class=\"bmh-side-copy\">\n          Thin by design. Faster load. Quicker kickback. Instant attack release.\n        </div>\n      </div>\n\n      <div class=\"bmh-side-block\">\n        <div class=\"bmh-side-kicker\">04</div>\n        <div class=\"bmh-side-title\">ATTACK READY</div>\n        <div class=\"bmh-side-copy\">\n          M46X carbon fibre response with an explosive feel tuned for tournament-level offense.\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  #bulletMorphHero,\n  #bulletMorphHero *{\n    box-sizing:border-box;\n  }\n\n  #bulletMorphHero{\n    --bg:#000;\n    --text:#fff;\n    --muted:rgba(255,255,255,.64);\n    --soft:rgba(255,255,255,.36);\n    --line:rgba(255,255,255,.12);\n    --accent:#ffb347;\n    --accent-2:#ff6a00;\n    --max:1400px;\n\n    position:relative;\n    width:100%;\n    overflow:hidden;\n    background:#000;\n    color:#fff;\n    isolation:isolate;\n    font-family:Arial,Helvetica,sans-serif;\n  }\n\n  .bmh-bg{\n    position:absolute;\n    inset:0;\n    background:\n      radial-gradient(circle at 50% 35%, rgba(255,132,0,.14) 0%, rgba(255,132,0,0) 26%),\n      radial-gradient(circle at 50% 50%, rgba(255,255,255,.05) 0%, rgba(255,255,255,0) 34%),\n      linear-gradient(180deg, #050505 0%, #000 100%);\n    z-index:0;\n  }\n\n  .bmh-grid{\n    position:absolute;\n    inset:0;\n    z-index:1;\n    opacity:.38;\n    background:\n      linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);\n    background-size:54px 54px;\n    pointer-events:none;\n  }\n\n  .bmh-vignette{\n    position:absolute;\n    inset:0;\n    z-index:2;\n    background:\n      radial-gradient(circle at center, rgba(0,0,0,0) 25%, rgba(0,0,0,.4) 62%, rgba(0,0,0,.86) 100%);\n    pointer-events:none;\n  }\n\n  .bmh-smoke{\n    position:absolute;\n    border-radius:50%;\n    filter:blur(70px);\n    opacity:.16;\n    pointer-events:none;\n    z-index:2;\n    background:\n      radial-gradient(circle, rgba(255,122,0,.75) 0%, rgba(255,122,0,.08) 45%, rgba(255,122,0,0) 72%);\n    animation:bmhSmoke 9s ease-in-out infinite alternate;\n  }\n\n  .bmh-smoke-1{\n    width:440px;\n    height:440px;\n    left:8%;\n    top:18%;\n  }\n\n  .bmh-smoke-2{\n    width:380px;\n    height:380px;\n    right:10%;\n    top:10%;\n    animation-delay:1.4s;\n  }\n\n  @keyframes bmhSmoke{\n    0%{\n      transform:translate3d(0,0,0) scale(.9);\n      opacity:.10;\n    }\n    100%{\n      transform:translate3d(16px,-20px,0) scale(1.08);\n      opacity:.2;\n    }\n  }\n\n  .bmh-inner{\n    position:relative;\n    z-index:5;\n    max-width:var(--max);\n    margin:0 auto;\n    padding:70px 24px 58px;\n    min-height:100vh;\n    display:grid;\n    grid-template-columns:minmax(190px,1fr) minmax(360px,680px) minmax(190px,1fr);\n    align-items:center;\n    gap:24px;\n  }\n\n  .bmh-side{\n    position:relative;\n    display:flex;\n    flex-direction:column;\n    gap:32px;\n    opacity:0;\n    transform:translateY(24px);\n  }\n\n  .bmh-side-line{\n    position:absolute;\n    top:10%;\n    bottom:10%;\n    width:1px;\n    background:linear-gradient(180deg, transparent, rgba(255,255,255,.2), transparent);\n  }\n\n  .bmh-side-left .bmh-side-line{\n    right:0;\n  }\n\n  .bmh-side-right .bmh-side-line{\n    left:0;\n  }\n\n  .bmh-side-left{\n    padding-right:26px;\n    text-align:right;\n  }\n\n  .bmh-side-right{\n    padding-left:26px;\n    text-align:left;\n  }\n\n  .bmh-side-block{\n    position:relative;\n  }\n\n  .bmh-side-kicker{\n    font-size:10px;\n    font-weight:700;\n    letter-spacing:.34em;\n    color:rgba(255,255,255,.38);\n    margin-bottom:10px;\n  }\n\n  .bmh-side-title{\n    font-size:14px;\n    font-weight:800;\n    letter-spacing:.22em;\n    color:#fff;\n    margin-bottom:10px;\n  }\n\n  .bmh-side-copy{\n    font-size:13px;\n    line-height:1.65;\n    color:rgba(255,255,255,.58);\n    max-width:280px;\n  }\n\n  .bmh-side-left .bmh-side-copy{\n    margin-left:auto;\n  }\n\n  .bmh-center{\n    text-align:center;\n  }\n\n  .bmh-topcopy{\n    font-size:10px;\n    letter-spacing:.36em;\n    font-weight:700;\n    color:rgba(255,255,255,.46);\n    margin-bottom:14px;\n    opacity:0;\n    transform:translateY(16px);\n  }\n\n  .bmh-stage{\n    position:relative;\n    width:100%;\n    height:min(62vh,760px);\n    min-height:440px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n  }\n\n  .bmh-core{\n    position:relative;\n    width:min(100%,540px);\n    height:100%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n  }\n\n  .bmh-bullet,\n  .bmh-racket{\n    position:absolute;\n    display:block;\n    max-width:none;\n    user-select:none;\n    pointer-events:none;\n    -webkit-user-drag:none;\n  }\n\n  .bmh-bullet{\n    width:min(56vw,300px);\n    opacity:1;\n    z-index:8;\n    left:50%;\n    top:44%;\n    transform:translate(-50%,-50%) rotate(24deg) scale(1);\n    filter:drop-shadow(0 16px 30px rgba(0,0,0,.46));\n    transform-origin:center center;\n  }\n\n  .bmh-racket{\n    width:min(68vw,420px);\n    opacity:0;\n    z-index:9;\n    left:50%;\n    bottom:0;\n    transform:translateX(-50%) translateY(28px) scale(.84);\n    filter:blur(10px) drop-shadow(0 20px 34px 