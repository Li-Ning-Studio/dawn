important;\nopacity:1 !important;\n}\n.b80-menu-link small{\nmargin-top:8px !important;\ncolor:rgba(255,255,255,.64) !important;\nfont-size:13px !important;\nline-height:1.35 !important;\nfont-weight:400 !important;\nopacity:1 !important;\n}\n.b80-menu-link i{\nwidth:28px !important;\nheight:28px !important;\nright:14px !important;\ncolor:rgba(255,255,255,.68) !important;\n}\n.b80-menu-link i svg,\n.b80-menu-utils svg{\nwidth:12px !important;\nheight:12px !important;\n}\n.b80-menu-foot{\ngap:24px !important;\npadding-top:20px !important;\nborder-top:1px solid rgba(255,255,255,.065) !important;\n}\n.b80-menu-utils{\ngap:30px !important;\nflex-wrap:wrap !important;\n}\n.b80-menu-utils a{\ngap:8px !important;\ncolor:rgba(255,255,255,.72) !important;\nfont-size:13px !important;\nline-height:1 !important;\nfont-weight:500 !important;\n}\n.b80-menu-buy{\nheight:40px !important;\npadding:\n0\n20px !important;\nfont-size:13px !important;\nline-height:1 !important;\nfont-weight:650 !important;\n}\n@media(max-width:750px){\n.b80-menu-inner{\npadding:24px 16px 18px !important;\n}\n.b80-menu-head{\npadding:\n0\n2px\n20px !important;\n}\n.b80-menu-kicker{\nfont-size:10px !important;\nletter-spacing:.17em !important;\n}\n.b80-menu-head h3{\nfont-size:30px !important;\nline-height:.98 !important;\n}\n.b80-menu-head h3 span{\ncolor:rgba(255,255,255,.78) !important;\n}\n.b80-menu-close{\nwidth:36px !important;\nheight:36px !important;\n}\n.b80-menu-grid{\ngrid-template-columns:\nrepeat(\n2,\nminmax(0,1fr)\n) !important;\ngap:10px !important;\npadding:\n18px\n0 !important;\n}\n.b80-menu-link{\nmin-height:92px !important;\npadding:\n14px\n34px\n14px\n12px !important;\n}\n.b80-menu-link b{\nmargin-bottom:7px !important;\nfont-size:10px !important;\n}\n.b80-menu-link strong{\nfont-size:16px !important;\n}\n.b80-menu-link small{\nmargin-top:7px !important;\nfont-size:12px !important;\n}\n.b80-menu-foot{\nalign-items:flex-start !important;\nflex-direction:column !important;\ngap:16px !important;\n}\n.b80-menu-utils{\nwidth:100% !important;\nflex-direction:row !important;\nalign-items:center !important;\ngap:\n14px\n22px !important;\n}\n.b80-menu-utils a{\nfont-size:12px !important;\n}\n.b80-menu-buy{\nheight:38px !important;\npadding:\n0\n16px !important;\nfont-size:12px !important;\n}\n}\n@media(max-width:390px){\n.b80-menu-grid{\ngrid-template-columns:1fr !important;\n}\n.b80-menu-head h3{\nfont-size:28px !important;\n}\n.b80-menu-link{\nmin-height:82px !important;\n}\n.b80-menu-link strong{\nfont-size:15px !important;\n}\n.b80-menu-link small{\nfont-size:11px !important;\n}\n}\n</style>\n<script>\n(function(){\n\nconst nav=document.getElementById('b80-nav');\nconst hero=document.getElementById('b80-hero');\n\nif(!nav||!hero){return;}\n\nconst videoModal=document.getElementById('b80-video-modal');\nconst featureVideo=document.getElementById('b80-feature-video');\nconst discoverVideo=hero.querySelector('#b80-discover-video');\nconst backgroundVideo=hero.querySelector('.b80-media video');\nconst scrollHint=hero.querySelector('.b80-scroll');\n\nlet videoOpen=false;\nlet rafBusy=false;\nlet heroVideoVisible=true;\n\nconst headerSelectors=[\n  '#shopify-section-header',\n  '.shopify-section-header-sticky',\n  'sticky-header',\n  '.header-wrapper',\n  '.section-header',\n  '.shopify-section-group-header-group',\n  'header.header'\n];\n\ndocument.body.appendChild(nav);\n\nif(videoModal){\n  document.body.appendChild(videoModal);\n}\n\nfunction playBackgroundVideo(){\n  if(!backgroundVideo||videoOpen||!heroVideoVisible){return;}\n\n  backgroundVideo.muted=true;\n  backgroundVideo.defaultMuted=true;\n  backgroundVideo.loop=true;\n  backgroundVideo.setAttribute('muted','');\n  backgroundVideo.setAttribute('playsinline','');\n  backgroundVideo.setAttribute('webkit-playsinline','');\n\n  const p=backgroundVideo.play();\n  if(p&&typeof p.catch==='function'){\n    p.catch(function(){});\n  }\n}\n\nfunction pauseBackgroundVideo(){\n  if(backgroundVideo){backgroundVideo.pause();}\n}\n\nfunction headerBottom(){\n  let bottom=0;\n  const seen=new Set();\n\n  headerSelectors.forEach(function(selector){\n    document.querySelectorAll(selector).forEach(function(element){\n      if(seen.has(element)||element===nav||element.contains(nav)){return;}\n\n      seen.add(element);\n\n      const rect=element.getBoundingClientRect();\n      const style=getComputedStyle(element);\n\n      if(\n        style.display==='none'||\n        style.visibility==='hidden'||\n        Number(style.opacity)===0||\n        rect.height<2||\n        rect.height>220||\n        rect.bottom<=0||\n        rect.top>=220\n      ){return;}\n\n      bottom=Math.max(bottom,rect.bottom);\n    });\n  });\n\n  return Math.max(0,Math.min(bottom,220));\n}\n\nfunction positionNav(){\n  const gap=window.innerWidth<=750?8:10;\n\n  document.documentElement.style.setProperty(\n    '--b80-top',\n    Math.round(headerBottom()+gap)+'px'\n  );\n}\n\nfunction updateState(){\n  const rect=hero.getBoundingClientRect();\n\n  nav.classList.toggle(\n    'is-product',\n    rect.bottom<=window.innerHeight*.34\n  );\n\n  if(scrollHint){\n    scrollHint.classList.toggle(\n      'is-hidden',\n      rect.bottom<=window.innerHeight*.72\n    );\n  }\n}\n\nfunction update(){\n  positionNav();\n  updateState();\n  rafBusy=false;\n}\n\nfunction requestUpdate(){\n  if(rafBusy){return;}\n  rafBusy=true;\n  requestAnimationFrame(update);\n}\n\n/* ONLY USER CLICKS MOVE THE PAGE */\nnav.querySelectorAll(\n  '.b80-nav-links a[href^=\"#\"], .b80-product-identity[href^=\"#\"]'\n).forEach(function(link){\n\n  link.addEventListener('click',function(event){\n\n    const href=link.getAttribute('href');\n\n    if(!href||href==='#'){return;}\n\n    const target=document.querySelector(href);\n\n    if(!target){return;}\n\n    event.preventDefault();\n\n    const targetTop=\n      target.getBoundingClientRect().top+\n      window.pageYOffset;\n\n    window.scrollTo({\n      top:targetTop,\n      left:0,\n      behavior:'smooth'\n    });\n\n  });\n\n});\n\nfunction openVideo(){\n  if(!videoModal||!featureVideo){return;}\n\n  pauseBackgroundVideo();\n\n  const chosenSrc=\n    window.innerWidth<=750\n      ?featureVideo.dataset.mobileSrc\n      :featureVideo.dataset.desktopSrc;\n\n  if(\n    chosenSrc&&\n    featureVideo.getAttribute('src')!==chosenSrc\n  ){\n    featureVideo.src=chosenSrc;\n    featureVideo.load();\n  }\n\n  try{featureVideo.currentTime=0;}catch(error){}\n\n  featureVideo.muted=false;\n  featureVideo.defaultMuted=false;\n  featureVideo.volume=1;\n\n  videoModal.classList.add('is-open');\n  videoModal.setAttribute('aria-hidden','false');\n  document.body.classList.add('b80-video-open');\n\n  videoOpen=true;\n\n  const p=featureVideo.play();\n  if(p&&typeof p.catch==='function'){\n    p.catch(function(){});\n  }\n}\n\nfunction closeVideo(){\n  if(!videoModal||!featureVideo){return;}\n\n  featureVideo.pause();\n  featureVideo.muted=true;\n\n  videoModal.classList.remove('is-open');\n  videoModal.setAttribute('aria-hidden','true');\n  document.body.classList.remove('b80-video-open');\n\n  videoOpen=false;\n  playBackgroundVideo();\n}\n\nif(discoverVideo){\n  discoverVideo.addEventListener(\n    'click',\n    function(event){\n      event.preventDefault();\n      openVideo();\n    }\n  );\n}\n\nif(videoModal){\n  videoModal.querySelectorAll(\n    '[data-b80-video-close]'\n  ).forEach(function(control){\n    control.addEventListener('click',closeVideo);\n  });\n}\n\ndocument.addEventListener(\n  'keydown',\n  function(event){\n    if(event.key==='Escape'&&videoOpen){\n      closeVideo();\n    }\n  }\n);\n\nwindow.addEventListener(\n  'scroll',\n  requestUpdate,\n  {passive:true}\n);\n\nwindow.addEventListener(\n  'resize',\n  requestUpdate,\n  {passive:true}\n);\n\nif('ResizeObserver' in window){\n  const observer=new ResizeObserver(requestUpdate);\n\n  headerSelectors.forEach(function(selector){\n    document.querySelectorAll(selector).forEach(function(element){\n      if(element!==nav&&!element.contains(nav)){\n        observer.observe(element);\n      }\n    });\n  });\n}\n\nif(backgroundVideo){\n  playBackgroundVideo();\n\n  if('IntersectionObserver' in window){\n    const heroVideoObserver=\n      new IntersectionObserver(\n        function(entries){\n          entries.forEach(function(entry){\n            heroVideoVisible=entry.isIntersecting;\n\n            if(heroVideoVisible){\n              playBackgroundVideo();\n            }else{\n              pauseBackgroundVideo();\n            }\n          });\n        },\n        {threshold:.08}\n      );\n\n    heroVideoObserver.observe(hero);\n  }\n\n  document.addEventListener(\n    'visibilitychange',\n    function(){\n      if(\n        document.visibilityState==='visible'&&\n        heroVideoVisible\n      ){\n        playBackgroundVideo();\n      }else{\n        pauseBackgroundVideo();\n      }\n    }\n  );\n}\n\npositionNav();\nupdateState();\n\n})();\n</script>",
