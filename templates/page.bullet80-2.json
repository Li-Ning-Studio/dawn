    "custom_liquid_xtqQbp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- =========================================================\n     NITRIX 80 BULLET — TRUE 3D GLB VIEWER\n\n     IMPORTANT:\n     1. Upload \"Nitrix 80 Bullet.glb\" to Shopify Content > Files.\n     2. Copy the Shopify CDN URL.\n     3. Replace PASTE_YOUR_SHOPIFY_GLB_URL_HERE below with that URL.\n\n     This stays well below Shopify's 50 KB Custom Liquid limit.\n========================================================= -->\n\n<script type=\"module\" src=\"https://ajax.googleapis.com/ajax/libs/model-viewer/4.3.1/model-viewer.min.js\"></script>\n\n<style>\n  .b80-360 {\n    width: 100%;\n    background: #000;\n    color: #fff;\n    padding: 100px 24px 80px;\n    overflow: hidden;\n    font-family: inherit;\n  }\n\n  .b80-360,\n  .b80-360 * {\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .b80-360__inner {\n    width: 100%;\n    max-width: 1380px;\n    margin: 0 auto;\n  }\n\n  /* HEADING */\n  .b80-360__heading {\n    width: 100%;\n    max-width: 900px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .b80-360__title {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(42px, 5.5vw, 80px);\n    line-height: .95;\n    letter-spacing: -.05em;\n    font-weight: 700;\n  }\n\n  .b80-360__intro {\n    width: 100%;\n    max-width: 610px;\n    margin: 20px auto 0;\n    color: rgba(255,255,255,.52);\n    font-size: clamp(15px, 1.3vw, 19px);\n    line-height: 1.55;\n    font-weight: 400;\n  }\n\n  /* FEATURE PILLS */\n  .b80-feature-nav {\n    width: 100%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 9px;\n    margin: 0 auto 22px;\n  }\n\n  .b80-feature-button {\n    position: relative;\n    appearance: none;\n    padding: 12px 19px;\n    border: 0;\n    outline: 0;\n    border-radius: 999px;\n    color: rgba(255,255,255,.52);\n    background: linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.025));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.065), 0 8px 24px rgba(0,0,0,.16);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    font: inherit;\n    font-size: 13px;\n    font-weight: 500;\n    cursor: pointer;\n    transition: color .25s ease, background .25s ease, transform .25s ease, box-shadow .25s ease;\n  }\n\n  .b80-feature-button:hover {\n    color: rgba(255,255,255,.94);\n    transform: translateY(-1px);\n    background: linear-gradient(180deg, rgba(255,255,255,.11), rgba(255,255,255,.04));\n  }\n\n  .b80-feature-button.is-active {\n    color: #fff;\n    background: linear-gradient(180deg, rgba(255,255,255,.155), rgba(255,255,255,.055));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.13), 0 10px 30px rgba(0,0,0,.23);\n  }\n\n  /* VIEWER */\n  .b80-viewer {\n    position: relative;\n    width: 100%;\n    height: min(75vw, 820px);\n    min-height: 650px;\n    overflow: hidden;\n    border-radius: 32px;\n    background:\n      radial-gradient(ellipse at 50% 45%, rgba(62,171,202,.11), rgba(34,92,110,.045) 35%, transparent 68%),\n      linear-gradient(180deg, #080808, #030303 57%, #010101);\n    box-shadow: 0 25px 70px rgba(0,0,0,.25);\n    isolation: isolate;\n  }\n\n  .b80-viewer::after {\n    content: \"\";\n    position: absolute;\n    z-index: 50;\n    inset: 0;\n    border-radius: inherit;\n    pointer-events: none;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.075) 0, rgba(255,255,255,.018) 2px, transparent 13px),\n      linear-gradient(0deg, rgba(255,255,255,.105) 0, rgba(255,255,255,.03) 3px, transparent 17px),\n      linear-gradient(90deg, rgba(255,255,255,.05), transparent 12px),\n      linear-gradient(270deg, rgba(255,255,255,.05), transparent 12px);\n  }\n\n  /* REAL 3D MODEL */\n  .b80-model {\n    position: absolute;\n    z-index: 4;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    display: block;\n    background: transparent;\n    --poster-color: transparent;\n    --progress-bar-color: #5cd0ef;\n    --progress-bar-height: 2px;\n    cursor: grab;\n    outline: none;\n  }\n\n  .b80-model:active {\n    cursor: grabbing;\n  }\n\n  /* transparent 3D ground glow */\n  .b80-ground-glow {\n    position: absolute;\n    z-index: 2;\n    left: 50%;\n    bottom: 6%;\n    width: 38%;\n    height: 12%;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: rgba(0,0,0,.52);\n    filter: blur(32px);\n    pointer-events: none;\n  }\n\n  /* LOADER */\n  .b80-model-loader {\n    position: absolute;\n    z-index: 18;\n    left: 50%;\n    top: 50%;\n    width: min(220px, 55%);\n    transform: translate(-50%,-50%);\n    text-align: center;\n    pointer-events: none;\n    transition: opacity .35s ease, visibility .35s ease;\n  }\n\n  .b80-model-loader.is-hidden {\n    opacity: 0;\n    visibility: hidden;\n  }\n\n  .b80-model-loader__label {\n    display: block;\n    margin-bottom: 10px;\n    color: rgba(255,255,255,.48);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .16em;\n  }\n\n  .b80-model-loader__track {\n    width: 100%;\n    height: 2px;\n    overflow: hidden;\n    background: rgba(255,255,255,.09);\n  }\n\n  .b80-model-loader__bar {\n    width: 0%;\n    height: 100%;\n    background: rgba(92,208,239,.9);\n    transition: width .12s linear;\n  }\n\n  /* TOP UI */\n  .b80-viewer__top {\n    position: absolute;\n    z-index: 40;\n    top: 22px;\n    left: 22px;\n    right: 22px;\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    pointer-events: none;\n  }\n\n  .b80-reset {\n    pointer-events: auto;\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    padding: 0;\n    border: 0;\n    outline: 0;\n    border-radius: 50%;\n    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.03));\n    color: #fff;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 8px 24px rgba(0,0,0,.20);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n    cursor: pointer;\n    transition: transform .25s ease, background .25s ease;\n  }\n\n  .b80-reset:hover {\n    transform: scale(1.04);\n    background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.05));\n  }\n\n  .b80-reset svg {\n    width: 18px;\n    height: 18px;\n  }\n\n  /* INFO CARD */\n  .b80-info {\n    position: absolute;\n    z-index: 30;\n    left: 28px;\n    bottom: 28px;\n    width: min(390px, calc(100% - 56px));\n    padding: 20px 22px;\n    overflow: hidden;\n    border-radius: 20px;\n    background: linear-gradient(145deg, rgba(32,32,32,.88), rgba(17,17,17,.84) 48%, rgba(7,7,7,.80));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.075), 0 20px 60px rgba(0,0,0,.32);\n    backdrop-filter: blur(28px);\n    -webkit-backdrop-filter: blur(28px);\n    opacity: 0;\n    transform: translateY(12px);\n    pointer-events: none;\n    transition: opacity .35s ease, transform .35s ease;\n  }\n\n  .b80-info.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .b80-info__index {\n    display: block;\n    margin-bottom: 8px;\n    color: rgba(255,255,255,.36);\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: .14em;\n  }\n\n  .b80-info h3 {\n    margin: 0;\n    color: #fff;\n    font-size: 24px;\n    line-height: 1.05;\n    letter-spacing: -.025em;\n    font-weight: 600;\n  }\n\n  .b80-info p {\n    margin: 10px 0 0;\n    color: rgba(255,255,255,.57);\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  /* CNTRL FOAM CALLOUT */\n  .b80-callout {\n    position: absolute;\n    z-index: 26;\n    right: 28px;\n    top: 50%;\n    width: min(245px, 31%);\n    overflow: visible;\n    opacity: 0;\n    transform: translateY(-50%) translateX(16px);\n    pointer-events: none;\n    transition: opacity .35s ease, transform .38s cubic-bezier(.16,1,.3,1);\n  }\n\n  .b80-callout.is-visible {\n    opacity: 1;\n    transform: translateY(-50%) translateX(0);\n  }\n\n  .b80-callout::before {\n    content: \"\";\n    position: absolute;\n    left: -42px;\n    top: 50%;\n    width: 34px;\n    height: 2px;\n    transform: translateY(-50%);\n    background: linear-gradient(90deg, rgba(87,197,227,.55), rgba(87,197,227,.1));\n  }\n\n  .b80-callout::after {\n    content: \"\";\n    position: absolute;\n    left: -48px;\n    top: 50%;\n    width: 10px;\n    height: 10px;\n    transform: translateY(-50%);\n    border-radius: 50%;\n    background: #5cd0ef;\n    box-shadow: 0 0 0 4px rgba(92,208,239,.12);\n  }\n\n  .b80-callout__media {\n    overflow: hidden;\n    border-radius: 18px;\n    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));\n    box-shadow: 0 20px 48px rgba(0,0,0,.28);\n  }\n\n  .b80-callout__media img {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  .b80-callout__body {\n    margin-top: 12px;\n    padding: 16px 16px 17px;\n    border-radius: 18px;\n    background: linear-gradient(145deg, rgba(27,27,27,.92), rgba(10,10,10,.88));\n    box-shadow: 0 18px 42px rgba(0,0,0,.28);\n  }\n\n  .b80-callout__eyebrow {\n    display: block;\n    margin-bottom: 8px;\n    color: rgba(255,255,255,.38);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .16em;\n  }\n\n  .b80-callout__title {\n    display: block;\n    color: #fff;\n    font-size: 18px;\n    line-height: 1.05;\n    font-weight: 600;\n    letter-spacing: -.02em;\n  }\n\n  .b80-callout__copy {\n    margin: 9px 0 0;\n    color: rgba(255,255,255,.56);\n    font-size: 13px;\n    line-height: 1.45;\n  }\n\n  /* DRAG HINT */\n  .b80-hint {\n    position: absolute;\n    z-index: 20;\n    left: 50%;\n    bottom: 24px;\n    transform: translateX(-50%);\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: rgba(255,255,255,.37);\n    font-size: 12px;\n    pointer-events: none;\n    transition: opacity .35s ease;\n  }\n\n  .b80-hint.is-hidden { opacity: 0; }\n  .b80-hint svg { width: 18px; height: 18px; }\n\n  @media screen and (max-width:749px) {\n    .b80-360 { padding: 70px 12px 55px; }\n    .b80-360__heading { margin-bottom: 28px; padding: 0 10px; }\n    .b80-360__title { font-size: clamp(40px, 12vw, 58px); }\n    .b80-360__intro { font-size: 15px; }\n\n    .b80-feature-nav {\n      justify-content: flex-start;\n      flex-wrap: nowrap;\n      overflow-x: auto;\n      overflow-y: hidden;\n      margin-left: -12px;\n      margin-right: -12px;\n      padding: 0 12px 7px;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .b80-feature-nav::-webkit-scrollbar { display: none; }\n    .b80-feature-button { flex: 0 0 auto; padding: 11px 16px; font-size: 12px; }\n\n    .b80-viewer { height: 620px; min-height: 0; border-radius: 22px; }\n    .b80-viewer__top { top: 14px; left: 14px; right: 14px; }\n    .b80-reset { width: 40px; height: 40px; }\n\n    .b80-info {\n      left: 14px;\n      bottom: 16px;\n      width: calc(100% - 28px);\n      padding: 17px;\n      border-radius: 17px;\n    }\n\n    .b80-info h3 { font-size: 21px; }\n    .b80-info p { font-size: 13px; }\n\n    .b80-callout {\n      right: 14px;\n      top: auto;\n      bottom: 104px;\n      width: min(180px, calc(100% - 28px));\n      transform: translateY(12px) translateX(0);\n    }\n\n    .b80-callout.is-visible { transform: translateY(0) translateX(0); }\n    .b80-callout::before,\n    .b80-callout::after { display: none; }\n    .b80-callout__media { border-radius: 14px; }\n    .b80-callout__body { margin-top: 9px; padding: 13px 13px 14px; border-radius: 14px; }\n    .b80-callout__eyebrow { font-size: 8px; }\n    .b80-callout__title { font-size: 15px; }\n    .b80-callout__copy { font-size: 11px; }\n    .b80-hint { bottom: 22px; font-size: 11px; }\n  }\n\n  @media(prefers-reduced-motion:reduce) {\n    .b80-feature-button,\n    .b80-info,\n    .b80-reset,\n    .b80-callout { transition: none; }\n  }\n</style>\n\n<section class=\"b80-360\">\n  <div class=\"b80-360__inner\">\n\n    <div class=\"b80-360__heading\">\n      <h2 class=\"b80-360__title\">Explore Every Angle.</h2>\n      <p class=\"b80-360__intro\">\n        Select an engineering point to move closer, then drag to inspect the racket in true 3D.\n      </p>\n    </div>\n\n    <div class=\"b80-feature-nav\">\n      <button type=\"button\" class=\"b80-feature-button is-active\" data-feature=\"full\" data-index=\"\" data-title=\"\" data-copy=\"\" data-callout=\"false\">Full Racket</button>\n\n      <button type=\"button\" class=\"b80-feature-button\" data-feature=\"shaft\" data-index=\"01\" data-title=\"5.9 MM Shaft\" data-copy=\"An ultra-thin shaft engineered for faster release, sharper handling, and a more direct attacking response.\" data-callout=\"false\">5.9 MM Shaft</button>\n\n      <button type=\"button\" class=\"b80-feature-button\" data-feature=\"curve\" data-index=\"02\" data-title=\"Curve² Frame\" data-copy=\"The upper head curve is brought front and centre to highlight the aerodynamic profile and expanded effective sweet spot.\" data-callout=\"false\">Curve²</button>\n\n      <button type=\"button\" class=\"b80-feature-button\" data-feature=\"cntrl\" data-index=\"03\" data-title=\"CNTRL Foam\" data-copy=\"The frame zooms closer while the callout reveals the internal foam construction used to manage unwanted vibration.\" data-callout=\"true\">CNTRL Foam</button>\n\n      <button type=\"button\" class=\"b80-feature-button\" data-feature=\"tfuse\" data-index=\"04\" data-title=\"T Fuse\" data-copy=\"A tighter crop on the T-joint highlights the reinforced junction that keeps frame and shaft connected under hard swings.\" data-callout=\"false\">T Fuse</button>\n    </div>\n\n    <div class=\"b80-viewer\">\n\n      <div class=\"b80-ground-glow\"></div>\n\n      <div class=\"b80-model-loader\" aria-hidden=\"true\">\n        <span class=\"b80-model-loader__label\">LOADING 3D</span>\n        <div class=\"b80-model-loader__track\">\n          <div class=\"b80-model-loader__bar\"></div>\n        </div>\n      </div>\n\n      <model-viewer\n        class=\"b80-model\"\n        src=\"https://cdn.shopify.com/3d/models/a7af41c06bb72bfe/Nitrix_80_Bullet.glb\"\n        alt=\"Nitrix 80 Bullet badminton racket 3D model\"\n        camera-controls\n        interaction-prompt=\"none\"\n        touch-action=\"pan-y\"\n        shadow-intensity=\"0.8\"\n        shadow-softness=\"1\"\n        exposure=\"1.12\"\n        environment-image=\"neutral\"\n        camera-target=\"0m 1.78m 0m\"\n        camera-orbit=\"0deg 90deg 5.3m\"\n        field-of-view=\"28deg\"\n        min-camera-orbit=\"auto 45deg 0.65m\"\n        max-camera-orbit=\"auto 135deg 8m\"\n        min-field-of-view=\"16deg\"\n        max-field-of-view=\"45deg\"\n        interpolation-decay=\"110\"\n        disable-pan\n        loading=\"eager\"\n        reveal=\"auto\"\n      ></model-viewer>\n\n      <div class=\"b80-viewer__top\">\n        <button class=\"b80-reset\" type=\"button\" aria-label=\"Return to full racket view\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n            <path d=\"M4.5 8.5A8 8 0 1 1 4 14\"></path>\n            <path d=\"M4.5 4v4.5H9\"></path>\n          </svg>\n        </button>\n      </div>\n\n      <div class=\"b80-info\" aria-live=\"polite\">\n        <span class=\"b80-info__index\">01</span>\n        <h3>5.9 MM Shaft</h3>\n        <p>Engineered for faster release.</p>\n      </div>\n\n      <div class=\"b80-callout\" aria-hidden=\"true\">\n        <div class=\"b80-callout__media\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Screenshot_2026-08-14_at_1.09.04_PM.png?v=1786693179\"\n            alt=\"CNTRL Foam internal construction\"\n            loading=\"lazy\"\n          >\n        </div>\n        <div class=\"b80-callout__body\">\n          <span class=\"b80-callout__eyebrow\">INSIDE THE FRAME</span>\n          <strong class=\"b80-callout__title\">CNTRL Foam</strong>\n          <p class=\"b80-callout__copy\">Internal foam helps reduce unwanted vibration at impact.</p>\n        </div>\n      </div>\n\n      <div class=\"b80-hint\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n          <path d=\"M8 8l-4 4 4 4\"></path>\n          <path d=\"M16 8l4 4-4 4\"></path>\n          <path d=\"M4 12h16\"></path>\n        </svg>\n        Drag to rotate · Pinch to zoom\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  const sections = document.querySelectorAll('.b80-360');\n\n  sections.forEach(function (section) {\n    const model = section.querySelector('.b80-model');\n    const buttons = section.querySelectorAll('.b80-feature-button');\n    const reset = section.querySelector('.b80-reset');\n    const info = section.querySelector('.b80-info');\n    const infoIndex = info ? info.querySelector('.b80-info__index') : null;\n    const infoTitle = info ? info.querySelector('h3') : null;\n    const infoCopy = info ? info.querySelector('p') : null;\n    const callout = section.querySelector('.b80-callout');\n    const hint = section.querySelector('.b80-hint');\n    const loader = section.querySelector('.b80-model-loader');\n    const loaderBar = section.querySelector('.b80-model-loader__bar');\n\n    if (!model) return;\n\n    /*\n      3D CAMERA PRESETS\n      The supplied GLB is roughly 3.70 m tall in model space.\n      Y is vertical. These targets are positioned from the actual GLB bounds.\n\n      target = where the camera looks\n      orbit  = horizontal angle, vertical angle, distance\n      fov    = lens / zoom feel\n    */\n    const desktopPresets = {\n      full:  { target: '0m 1.78m 0m', orbit: '0deg 90deg 5.3m', fov: '28deg' },\n      shaft: { target: '0m 0.62m 0m', orbit: '0deg 90deg 1.55m', fov: '24deg' },\n      curve: { target: '0m 3.15m 0m', orbit: '0deg 90deg 1.70m', fov: '24deg' },\n      cntrl: { target: '0m 2.82m 0m', orbit: '-8deg 88deg 1.55m', fov: '23deg' },\n      tfuse: { target: '0m 1.23m 0m', orbit: '0deg 89deg 1.22m', fov: '23deg' }\n    };\n\n    const mobilePresets = {\n      full:  { target: '0m 1.78m 0m', orbit: '0deg 90deg 6.0m', fov: '30deg' },\n      shaft: { target: '0m 0.62m 0m', orbit: '0deg 90deg 1.85m', fov: '26deg' },\n      curve: { target: '0m 3.12m 0m', orbit: '0deg 90deg 2.0m', fov: '26deg' },\n      cntrl: { target: '0m 2.82m 0m', orbit: '-8deg 88deg 1.9m', fov: '25deg' },\n      tfuse: { target: '0m 1.23m 0m', orbit: '0deg 89deg 1.52m', fov: '25deg' }\n    };\n\n    function getPresets() {\n      return window.matchMedia('(max-width: 749px)').matches ? mobilePresets : desktopPresets;\n    }\n\n    function moveCamera(feature) {\n      const presets = getPresets();\n      const preset = presets[feature] || presets.full;\n\n      model.setAttribute('camera-target', preset.target);\n      model.setAttribute('camera-orbit', preset.orbit);\n      model.setAttribute('field-of-view', preset.fov);\n    }\n\n    function focusFeature(button) {\n      if (!button) return;\n\n      const feature = button.dataset.feature || 'full';\n      moveCamera(feature);\n\n      buttons.forEach(function (item) {\n        item.classList.remove('is-active');\n      });\n      button.classList.add('is-active');\n\n      if (feature === 'full') {\n        if (info) info.classList.remove('is-visible');\n        if (callout) callout.classList.remove('is-visible');\n      } else {\n        if (infoIndex) infoIndex.textContent = button.dataset.index || '';\n        if (infoTitle) infoTitle.textContent = button.dataset.title || '';\n        if (infoCopy) infoCopy.textContent = button.dataset.copy || '';\n        if (info) info.classList.add('is-visible');\n\n        if (callout) {\n          callout.classList.toggle('is-visible', button.dataset.callout === 'true');\n        }\n      }\n\n      if (hint) hint.classList.add('is-hidden');\n    }\n\n    buttons.forEach(function (button) {\n      button.addEventListener('click', function () {\n        focusFeature(button);\n      });\n    });\n\n    if (reset) {\n      reset.addEventListener('click', function () {\n        const fullButton = section.querySelector('.b80-feature-button[data-feature=\"full\"]');\n        focusFeature(fullButton);\n      });\n    }\n\n    /* hide hint as soon as the user manipulates the real 3D model */\n    model.addEventListener('camera-change', function (event) {\n      if (event.detail && event.detail.source === 'user-interaction' && hint) {\n        hint.classList.add('is-hidden');\n      }\n    });\n\n    /* premium loading bar for the 20 MB GLB */\n    model.addEventListener('progress', function (event) {\n      if (!loaderBar || !event.detail) return;\n      const progress = Math.max(0, Math.min(1, event.detail.totalProgress || 0));\n      loaderBar.style.width = (progress * 100).toFixed(1) + '%';\n    });\n\n    model.addEventListener('load', function () {\n      if (loaderBar) loaderBar.style.width = '100%';\n      if (loader) {\n        setTimeout(function () {\n          loader.classList.add('is-hidden');\n        }, 180);\n      }\n      moveCamera('full');\n    });\n\n    model.addEventListener('error', function () {\n      if (loader) loader.classList.add('is-hidden');\n      console.error('Nitrix 80 Bullet GLB failed to load. Check the Shopify Files CDN URL.');\n    });\n\n    /* keep selected preset framed correctly when switching desktop/mobile */\n    let resizeTimer;\n    window.addEventListener('resize', function () {\n      clearTimeout(resizeTimer);\n      resizeTimer = setTimeout(function () {\n        const active = section.querySelector('.b80-feature-button.is-active');\n        moveCamera(active ? active.dataset.feature : 'full');\n      }, 180);\n    });\n  });\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_hg3NiA": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Nitrix 80 Bullet — Locked and Loaded | Hundred</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#0b0c0e;\n    --bg-alt:#131418;\n    --steel:#2a2d33;\n    --steel-light:#4a4e57;\n    --text:#ecedef;\n    --text-dim:#8a8d93;\n    --accent:#fff;\n    --accent-dim:#5c1512;\n    --stage-h: 420vh;\n  }\n\n  *{ margin:0; padding:0; box-sizing:border-box; }\n\n  html{ scroll-behavior:auto; background:var(--bg); }\n\n\n  ::selection{ background:var(--accent); color:#fff; }\n\n  .mono{\n    font-family:'JetBrains Mono', monospace;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n  }\n\n .display{\n    font-family:'Anton', sans-serif;\n    font-weight:400;\n    text-transform:uppercase;\n    letter-spacing:0.01em;\n    line-height:0.92;\n  }\n\n  a{ color:inherit; }\n\n\n  /* ---------- reduced motion ---------- */\n  @media (prefers-reduced-motion: reduce){\n    #racket{ transition:none !important; }\n  }\n\n  /* =====================================================\n     PINNED SCROLL STAGE — racket floats through 4 chapters\n     ===================================================== */\n  .scroll-stage{\n    position:relative;\n    height:var(--stage-h);\n  }\n\n  .stage-sticky{\n    position:sticky;\n    top:40px;\n    height:100vh;\n    width:100%;\n    overflow:hidden;\n    background:\n      radial-gradient(ellipse 70% 60% at 50% 40%, #17191d 0%, var(--bg) 65%);\n  }\n\n  /* faint vignette + grain-like texture, restrained */\n  .stage-sticky::before{\n    content:\"\";\n    position:absolute; inset:0;\n    background:\n      linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 15%, rgba(0,0,0,0) 85%, rgba(0,0,0,0.6) 100%);\n    pointer-events:none;\n    z-index:5;\n  }\n\n  .stage-floor{\n    position:absolute; left:0; right:0; bottom:0; height:35%;\n    background:linear-gradient(180deg, rgba(232,51,43,0) 0%, rgba(232,51,43,0.05) 100%);\n    border-top:1px solid rgba(255,255,255,0.04);\n    pointer-events:none;\n  }\n\n  /* the racket itself — real product photo, panned/zoomed/rotated on scroll */\n  .racket-perspective{\n    position:absolute; inset:0;\n    display:flex; align-items:center; justify-content:center;\n    z-index:3;\n    pointer-events:none;\n  }\n\n  #racket{\n    display:block;\n    width:min(50vw, 460px);\n    max-height:80vh;\n    object-fit:contain;\n    filter:drop-shadow(0 30px 60px rgba(0,0,0,0.6));\n    will-change:transform;\n  }\n\n  /* scrim behind chapter text on mobile, only enabled there */\n  .stage-scrim{ display:none; }\n\n  /* desktop: soft corner-fade so the racket dissolves into the edge\n     nearest the active chapter's text instead of colliding with it */\n  .text-scrim{\n    position:absolute; top:0; bottom:0; z-index:3;\n    width:56%;\n    pointer-events:none;\n    opacity:0;\n  }\n  .text-scrim.scrim-left{\n    left:0;\n    background:linear-gradient(to right, rgba(11,12,14,0.92) 0%, rgba(11,12,14,0.5) 42%, rgba(11,12,14,0) 100%);\n  }\n  .text-scrim.scrim-right{\n    right:0;\n    background:linear-gradient(to left, rgba(11,12,14,0.92) 0%, rgba(11,12,14,0.5) 42%, rgba(11,12,14,0) 100%);\n  }\n\n  /* chapter labels — small tactical tick, not a full HUD */\n  .spec-tick{\n    position:absolute; z-index:6;\n    font-size:11px; color:var(--accent);\n    display:flex; align-items:center; gap:8px;\n  }\n  .spec-tick::before{ content:\"\"; width:22px; height:1px; background:var(--accent); display:inline-block; }\n\n  /* content chapters, stacked and cross-faded by scroll progress */\n  .stage-content{\n    position:absolute; inset:0; z-index:4;\n  }\n  .chapter{\n    position:absolute; inset:0;\n    display:flex; flex-direction:column; justify-content:center;\n    padding:0 6vw;\n    opacity:0;\n    pointer-events:none;\n  }\n  .chapter .eyebrow{\n    font-size:11px; color:var(--accent); margin-bottom:18px;\n    display:flex; align-items:center; gap:10px;\n  }\n  .chapter .eyebrow::before{ content:\"\"; width:26px; height:1px; background:var(--accent); }\n  .chapter h2{\n    font-size:clamp(38px, 6.4vw, 92px);\n    max-width:11ch;\n    color:var(--text);\n   font-family: var(--font-heading-family);\nfont-weight:700;\nline-height:1;\n    \n  }\n  .chapter p{\n    margin-top:22px;\n    max-width:42ch;\n    color:var(--text-dim);\n    font-size:16px;\n    line-height:1.6;\n  }\n  .chapter .stat{\n    margin-top:28px;\n    display:flex; align-items:baseline; gap:14px;\n  }\n  .chapter .stat .num{\n    font-size:56px;\n    color:var(--accent);\n    line-height:1;\n  }\n  .chapter .stat .unit{ font-size:12px; color:var(--text-dim); max-width:20ch; line-height:1.4; }\n\n  /* right-aligned chapters (alternate for depth/rhythm) */\n  .chapter.align-right{ align-items:flex-end; text-align:right; }\n  .chapter.align-right p{ margin-left:auto; }\n  .chapter.align-right .stat{ flex-direction:row-reverse; }\n\n  /* scroll cue on chapter 0 only */\n  .scroll-cue{\n    position:absolute; bottom:36px; left:50%; transform:translateX(-50%);\n    font-size:10px; color:var(--text-dim); z-index:6;\n    display:flex; flex-direction:column; align-items:center; gap:10px;\n  }\n  .scroll-cue .line{ width:1px; height:34px; background:linear-gradient(180deg, var(--accent), transparent); animation:cue-pulse 1.8s ease-in-out infinite; }\n  @keyframes cue-pulse{ 0%,100%{ opacity:0.3; } 50%{ opacity:1; } }\n\n  /* progress rail, far right */\n  .progress-rail{\n    position:fixed; right:5vw; top:50%; transform:translateY(-50%);\n    z-index:50; display:flex; flex-direction:column; gap:16px;\n  }\n  .progress-rail .dot{\n    width:6px; height:6px; border-radius:50%;\n    background:var(--steel-light);\n    transition:background 0.3s ease, transform 0.3s ease;\n  }\n  .progress-rail .dot.active{ background:var(--accent); transform:scale(1.6); }\n\n\n  /* =====================================================\n     MOBILE\n     ===================================================== */\n  @media (max-width:760px){\n    :root{ --stage-h:340vh; }\n\n   \n\n    .progress-rail{ display:none; }\n    .text-scrim{ display:none; }\n\n    #racket{\n      width:500px;\n     \n     \n    }\n\n    .stage-scrim{\n      display:block;\n      position:absolute; left:0; right:0; top:0; height:48%;\n      background:linear-gradient(180deg, rgba(11,12,14,0.95) 0%, rgba(11,12,14,0.55) 55%, rgba(11,12,14,0) 100%);\n      pointer-events:none;\n      z-index:3;\n    }\n\n    .chapter{\n      justify-content:flex-start;\n      padding:92px 6vw 0;\n      align-items:flex-start !important;\n      text-align:left !important;\n    }\n    .chapter p{ margin-left:0 !important; }\n    .chapter .stat{ flex-direction:row !important; }\n    .chapter h2{\n      font-size:clamp(28px, 9vw, 42px);\n      max-width:13ch;\n    }\n    .chapter p{\n      font-size:13.5px;\n      max-width:34ch;\n      margin-top:14px;\n    }\n    .chapter .stat{ margin-top:18px; gap:10px; }\n    .chapter .stat .num{ font-size:36px; }\n    .chapter .stat .unit{ font-size:11px; max-width:22ch; }\n    .chapter .eyebrow{ margin-bottom:10px; font-size:10px; }\n\n    .scroll-cue{ bottom:22px; }\n\n    .testimonials{ padding:90px 6vw; }\n    .testimonials .section-head{ margin-bottom:44px; }\n    .quote-card{ padding:28px 24px; }\n    .quote-card p{ font-size:15px; }\n\n    .closing{ padding:90px 6vw 150px; }\n    .closing h2{ font-size:clamp(34px, 11vw, 60px); }\n    .closing .ghost-racket{ width:80vw; opacity:0.04; }\n\n    .sticky-buy{ padding:14px 5vw; }\n  }\n</style>\n</head>\n<body>\n\n\n<div class=\"progress-rail\" id=\"progressRail\">\n  <div class=\"dot\" data-i=\"0\"></div>\n  <div class=\"dot\" data-i=\"1\"></div>\n  <div class=\"dot\" data-i=\"2\"></div>\n  <div class=\"dot\" data-i=\"3\"></div>\n</div>\n\n<!-- ============ PINNED SCROLL STAGE ============ -->\n<div class=\"scroll-stage\" id=\"scrollStage\">\n  <div class=\"stage-sticky\">\n\n    <div class=\"racket-perspective\">\n      <img id=\"racket\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/18.png\" alt=\"Nitrix 80 Bullet racket\">\n    </div>\n\n    <div class=\"stage-scrim\"></div>\n    <div class=\"text-scrim scrim-left\" id=\"textScrim\"></div>\n\n    <div class=\"stage-floor\"></div>\n\n    <div class=\"stage-content\" id=\"stageContent\">\n      <section class=\"chapter\" data-i=\"0\">\n        <div class=\"eyebrow mono\"></div>\n        <h2>Locked and<br>loaded.</h2>\n        <p>Hundred's most expensive racket, built for one job — the kill. Every gram cut, every fibre tuned for the smash that ends the rally.</p>\n      </section>\n\n      <section class=\"chapter align-right\" data-i=\"1\">\n        <div class=\"eyebrow mono\">Spec 01 — Shaft</div>\n        <h2>5.9mm.<br>Thinnest<br>we've built.</h2>\n        <div class=\"stat\">\n          \n        </div>\n      </section>\n\n      <section class=\"chapter\" data-i=\"2\">\n        <div class=\"eyebrow mono\">Spec 02 — Series</div>\n        <h2>Built to<br>attack.</h2>\n        <p></p>\n      </section>\n\n      <section class=\"chapter align-right\" data-i=\"3\">\n        <div class=\"eyebrow mono\">Spec 03 — Craft</div>\n        <h2>The one<br>above all.</h2>\n        <p>Hand-finished, individually numbered, and priced like the flagship it is. Not a racket for every player — a racket for the point that matters.</p>\n      </section>\n    </div>\n\n    <div class=\"scroll-cue\" id=\"scrollCue\">\n      <span>SCROLL</span>\n      <div class=\"line\"></div>\n    </div>\n  </div>\n</div>\n\n\n\n\n\n\n\n<script>\n(function(){\n  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  var stage = document.getElementById('scrollStage');\n  var racket = document.getElementById('racket');\n  var chapters = Array.prototype.slice.call(document.querySelectorAll('.chapter'));\n  var dots = Array.prototype.slice.call(document.querySelectorAll('.progress-rail .dot'));\n  var stickyBuy = document.getElementById('stickyBuy');\n  var scrollCue = document.getElementById('scrollCue');\n  var textScrim = document.getElementById('textScrim');\n  var topbar = document.querySelector('.topbar');\n\n  // Waypoints for a flat product photo — no 3D flipping, just:\n  // rot: in-plane rotation (0 = upright, 90 = laid horizontal)\n  // scale: zoom level\n  // ox/oy: zoom focal point as % of the image (where \"the camera looks\")\n  //   ~50/19 sits near the head, ~50/54 sits near the mid-shaft\n  // tx/ty: overall drift of the image across the screen, in vw/vh\n  //\n  // Desktop: chapters alternate text left/right (0 left, 1 right, 2 left,\n  // 3 right) — the racket is placed on the OPPOSITE side each time so it\n  // never sits under the copy. It still sweeps side to side chapter to\n  // chapter for the \"moving through space\" feel.\n  var desktopWaypoints = [\n    { rot:  -4, scale: 1.00, ox: 50, oy: 50, tx:   9, ty:  0 },  // hero — text left, racket right-of-center\n    { rot:  90, scale: 1.85, ox: 50, oy: 54, tx: -15, ty: -3 },  // shaft — text right, racket left\n    { rot:   0, scale: 2.05, ox: 50, oy: 19, tx:  17, ty: -4 },  // head — text left, racket right\n    { rot:   0, scale: 1.10, ox: 50, oy: 50, tx: -23, ty:  0 }   // craft — text right, racket hard left\n  ];\n\n  // Mobile: image sits above the text zone, so side collisions aren't the\n  // issue — instead drift it steadily downward across the whole stage so\n  // it visibly \"comes down\" with the scroll, plus a gentle side-to-side\n  // wobble for depth.\n  var mobileWaypoints = [\n    { rot:  -4, scale: 0.88, ox: 50, oy: 50, tx:  0, ty:   6 },\n    { rot:  90, scale: 1.45, ox: 50, oy: 54, tx:  5, ty:  13 },\n    { rot:   0, scale: 1.70, ox: 50, oy: 19, tx: -5, ty:  20 },\n    { rot:   0, scale: 0.98, ox: 50, oy: 50, tx:  0, ty:  26 }\n  ];\n\n  function isMobile(){ return window.innerWidth <= 760; }\n\n  function lerp(a, b, t){ return a + (b - a) * t; }\n\n  function sampleWaypoints(progress){\n    var waypoints = isMobile() ? mobileWaypoints : desktopWaypoints;\n    // progress: 0..1 across 4 waypoints (3 segments)\n    var segCount = waypoints.length - 1;\n    var scaled = progress * segCount;\n    var seg = Math.min(Math.floor(scaled), segCount - 1);\n    var t = scaled - seg;\n    var a = waypoints[seg], b = waypoints[seg + 1];\n    return {\n      rot:   lerp(a.rot,   b.rot,   t),\n      scale: lerp(a.scale, b.scale, t),\n      ox:    lerp(a.ox,    b.ox,    t),\n      oy:    lerp(a.oy,    b.oy,    t),\n      tx:    lerp(a.tx,    b.tx,    t),\n      ty:    lerp(a.ty,    b.ty,    t)\n    };\n  }\n\n  function smoothstep(edge0, edge1, x){\n    var t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));\n    return t * t * (3 - 2 * t);\n  }\n\n  var ticking = false;\n\n  function update(){\n    ticking = false;\n    var rect = stage.getBoundingClientRect();\n    var vh = window.innerHeight;\n    var stageHeight = stage.offsetHeight;\n    var scrolled = -rect.top;\n    var travel = stageHeight - vh;\n    var progress = travel > 0 ? Math.min(1, Math.max(0, scrolled / travel)) : 0;\n\n    // racket transform\n    if (!reduceMotion){\n      var p = sampleWaypoints(progress);\n      racket.style.transformOrigin = p.ox + '% ' + p.oy + '%';\n      racket.style.transform =\n        'translate(' + p.tx + 'vw, ' + p.ty + 'vh) ' +\n        'rotate(' + p.rot + 'deg) ' +\n        'scale(' + p.scale + ')';\n    }\n\n    // chapter cross-fade, 4 even segments\n    var segSize = 1 / chapters.length;\n    var activeOpacity = 0, activeAlignRight = false;\n    chapters.forEach(function(ch, i){\n      var segStart = i * segSize;\n      var segEnd = segStart + segSize;\n      var fadeIn = (i === 0) ? 1 : smoothstep(segStart, segStart + segSize * 0.28, progress);\n      var fadeOut = (i === chapters.length - 1) ? 1 : 1 - smoothstep(segEnd - segSize * 0.28, segEnd, progress);\n      var opacity = Math.max(0, Math.min(fadeIn, fadeOut));\n      ch.style.opacity = opacity;\n      ch.style.transform = 'translateY(' + (1 - opacity) * 18 + 'px)';\n      if (opacity > activeOpacity){\n        activeOpacity = opacity;\n        activeAlignRight = ch.classList.contains('align-right');\n      }\n    });\n\n    if (textScrim){\n      textScrim.style.opacity = activeOpacity;\n      textScrim.classList.toggle('scrim-right', activeAlignRight);\n      textScrim.classList.toggle('scrim-left', !activeAlignRight);\n    }\n\n    if (dots.length){\n      var activeIdx = Math.min(chapters.length - 1, Math.floor(progress * chapters.length));\n      dots.forEach(function(d, i){ d.classList.toggle('active', i === activeIdx); });\n    }\n\n    scrollCue.style.opacity = 1 - smoothstep(0, 0.06, progress);\n\n    // topbar stays hidden through the hero chapter, fades in as chapter 1 begins\n    topbar.style.opacity = smoothstep(segSize * 0.65, segSize, progress);\n\n    stickyBuy.classList.toggle('show', window.scrollY > vh * 0.9);\n  }\n\n  function onScroll(){\n    if (!ticking){\n      requestAnimationFrame(update);\n      ticking = true;\n    }\n  }\n\n  window.addEventListener('scroll', onScroll, { passive: true });\n  window.addEventListener('resize', onScroll);\n  update();\n})();\n</script>\n\n</body>\n</html>",
