    "custom_liquid_8n7t4D": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NITRIX SERIES COMPARISON\n  Premium Apple-style text-only comparison\n\n  Left side switches between:\n  - Nitrix 70 Venom\n  - Nitrix 70 Volta\n\n  Right side stays:\n  - Nitrix 80 Bullet\n\n  Paste only the Bullet image URL below.\n{% endcomment %}\n\n{% assign bullet_img = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623' %}\n\n{% assign venom_product = all_products['nitrix-70-venom'] %}\n{% assign volta_product = all_products['nitrix-70-volta-3u'] %}\n\n<link rel=\"preload\"\n      as=\"image\"\n      href=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=900\"\n      imagesrcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=360 360w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=540 540w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=720 720w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=900 900w\"\n      imagesizes=\"(max-width: 749px) 42vw, 42vw\"\n      fetchpriority=\"high\">\n\n<link rel=\"preload\"\n      as=\"image\"\n      href=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=900\"\n      imagesrcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=360 360w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=540 540w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=720 720w, https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=900 900w\"\n      imagesizes=\"(max-width: 749px) 42vw, 42vw\"\n      fetchpriority=\"high\">\n\n<link rel=\"preload\"\n      as=\"image\"\n      href=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_dba40639-bb18-422f-adcc-defb52ab3d09.jpg?v=1786712390&width=720\"\n      fetchpriority=\"low\">\n\n<style>\n  #nitrix-premium-compare,\n  #nitrix-premium-compare * {\n    box-sizing: border-box;\n  }\n\n  #nitrix-premium-compare {\n    width: 100%;\n    padding: clamp(76px, 8vw, 120px) 20px clamp(82px, 8vw, 126px);\n    background: #000;\n    color: #fff;\n    font-family: inherit;\n  }\n\n  #nitrix-premium-compare * {\n    font-family: inherit;\n  }\n\n  .npc-inner {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  /* =========================\n     HEADING\n  ========================= */\n\n  .npc-heading {\n    max-width: 780px;\n    margin: 0 auto 34px;\n    text-align: center;\n  }\n\n  .npc-kicker {\n    margin: 0 0 12px;\n    color: rgba(255,255,255,.38);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .npc-heading h2 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(44px, 5.8vw, 78px);\n    line-height: .95;\n    font-weight: 650;\n    letter-spacing: -.06em;\n  }\n\n  .npc-heading-copy {\n    max-width: 560px;\n    margin: 18px auto 0;\n    color: rgba(255,255,255,.48);\n    font-size: clamp(14px, 1.3vw, 17px);\n    line-height: 1.5;\n  }\n\n  /* =========================\n     DROPDOWN\n  ========================= */\n\n  .npc-selector {\n    width: min(100%, 360px);\n    margin: 0 auto 28px;\n  }\n\n  .npc-selector-label {\n    margin: 0 0 10px 15px;\n    color: rgba(255,255,255,.9);\n    font-size: 13px;\n    line-height: 1.2;\n    font-weight: 600;\n  }\n\n  .npc-select-shell {\n    position: relative;\n    width: 100%;\n  }\n\n  .npc-select {\n    width: 100%;\n    height: 52px;\n    appearance: none;\n    -webkit-appearance: none;\n    padding: 0 52px 0 18px;\n    border: 1px solid rgba(255,255,255,.28);\n    border-radius: 999px;\n    outline: none;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.05),\n        rgba(255,255,255,.015)\n      ),\n      #0b0c0e;\n    color: #fff;\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 600;\n    cursor: pointer;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.05),\n      0 10px 26px rgba(0,0,0,.22);\n    transition:\n      border-color .2s ease,\n      background .2s ease,\n      transform .2s ease;\n  }\n\n  .npc-select:hover,\n  .npc-select:focus {\n    border-color: rgba(255,255,255,.42);\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.075),\n        rgba(255,255,255,.02)\n      ),\n      #0d0e10;\n  }\n\n  .npc-select-shell::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    right: 20px;\n    width: 8px;\n    height: 8px;\n    border-right: 1.5px solid #35aee8;\n    border-bottom: 1.5px solid #35aee8;\n    transform: translateY(-68%) rotate(45deg);\n    pointer-events: none;\n  }\n\n  /* =========================\n     MAIN CARD\n  ========================= */\n\n  .npc-card {\n    position: relative;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,.13);\n    border-radius: 32px;\n    background:\n      radial-gradient(\n        ellipse at 50% 0%,\n        rgba(255,255,255,.045),\n        transparent 38%\n      ),\n      linear-gradient(\n        145deg,\n        #111316 0%,\n        #08090b 48%,\n        #030405 100%\n      );\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.04),\n      0 34px 90px rgba(0,0,0,.3);\n  }\n\n  /* =========================\n     PRODUCT HEADER\n  ========================= */\n\n  .npc-products {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 70px minmax(0, 1fr);\n    align-items: end;\n    gap: clamp(14px, 3vw, 34px);\n    padding: clamp(34px, 4vw, 54px) clamp(18px, 4vw, 48px) 24px;\n  }\n\n  .npc-product {\n    min-width: 0;\n    text-align: center;\n  }\n\n  .npc-product-media {\n    position: relative;\n    height: clamp(250px, 29vw, 390px);\n    display: flex;\n    align-items: stretch;\n    justify-content: stretch;\n    overflow: hidden;\n    border-radius: 24px;\n    background: #090a0c;\n    isolation: isolate;\n  }\n\n  .npc-product-media::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    left: 50%;\n    bottom: 2%;\n    width: 70%;\n    height: 28px;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: rgba(255,255,255,.10);\n    filter: blur(20px);\n    opacity: .55;\n  }\n\n  .npc-product-media img {\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n\n    display: block;\n    width: 100%;\n    height: 100%;\n\n    max-width: none;\n    max-height: none;\n\n    object-fit: cover;\n    object-position: center center;\n\n    border-radius: inherit;\n\n    transform: translateZ(0) scale(1.001);\n    backface-visibility: hidden;\n    -webkit-backface-visibility: hidden;\n\n    transition:\n      transform .55s cubic-bezier(.16,1,.3,1),\n      opacity .22s ease;\n  }\n\n  .npc-product:hover .npc-product-media img {\n    transform: translateZ(0) scale(1.018);\n  }\n\n  /* =========================\n     DESKTOP IMAGE-SHAPED MEDIA\n     Let each product image define the media-card ratio.\n     No forced landscape crop.\n     Mobile rules below remain untouched.\n  ========================= */\n  @media screen and (min-width: 750px) {\n    .npc-products {\n      align-items: start;\n    }\n\n    .npc-product-media {\n      height: auto;\n      min-height: 0;\n\n      display: block;\n\n      overflow: hidden;\n\n      background: #090a0c;\n    }\n\n    .npc-product-media img {\n      position: relative;\n      inset: auto;\n\n      display: block;\n\n      width: 100%;\n      height: auto;\n\n      max-width: 100%;\n      max-height: none;\n\n      object-fit: contain;\n      object-position: center center;\n\n      border-radius: inherit;\n\n      transform: none;\n    }\n\n    .npc-product:hover .npc-product-media img {\n      transform: none;\n    }\n\n    .npc-vs {\n      margin-top: clamp(120px, 14vw, 190px);\n    }\n  }\n\n  .npc-placeholder {\n    width: 112px;\n    height: 86%;\n    margin-bottom: 8px;\n    border-radius: 999px;\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255,255,255,.07),\n        rgba(255,255,255,.015)\n      );\n  }\n\n  .npc-product-name {\n    margin: 17px 0 0;\n    color: #fff;\n    font-size: clamp(20px, 2.2vw, 29px);\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: -.04em;\n  }\n\n  .npc-product-note {\n    max-width: 320px;\n    min-height: 42px;\n    margin: 10px auto 0;\n    color: rgba(255,255,255,.42);\n    font-size: 12px;\n    line-height: 1.42;\n  }\n\n  .npc-vs {\n    align-self: center;\n    margin-top: 110px;\n    color: rgba(255,255,255,.34);\n    font-size: 11px;\n    font-weight: 650;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  /* =========================\n     COMPARISON TABLE\n  ========================= */\n\n  .npc-table {\n    padding: 12px clamp(18px, 4vw, 48px) 50px;\n  }\n\n  .npc-row {\n    display: grid;\n    grid-template-columns:\n      minmax(0, 1fr)\n      minmax(110px, 150px)\n      minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(12px, 3vw, 34px);\n    min-height: 74px;\n    border-top: 1px solid rgba(255,255,255,.085);\n  }\n\n  .npc-value {\n    color: #fff;\n    font-size: clamp(16px, 1.8vw, 21px);\n    line-height: 1.15;\n    font-weight: 560;\n    letter-spacing: -.02em;\n  }\n\n  .npc-value--left {\n    text-align: right;\n  }\n\n  .npc-value--right {\n    text-align: left;\n  }\n\n  .npc-label {\n    color: rgba(255,255,255,.38);\n    font-size: 10px;\n    line-height: 1.1;\n    font-weight: 650;\n    letter-spacing: .14em;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  /* =========================\n     BOTTOM MESSAGE\n  ========================= */\n\n  .npc-bottom {\n    padding: 12px 18px 52px;\n    text-align: center;\n  }\n\n  .npc-bottom-label {\n    margin: 0 0 12px;\n    color: rgba(255,255,255,.34);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .npc-bottom h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(30px, 4vw, 52px);\n    line-height: .98;\n    font-weight: 620;\n    letter-spacing: -.05em;\n  }\n\n  .npc-bottom h3 span {\n    color: rgba(255,255,255,.38);\n  }\n\n  /* =========================\n     SWITCH ANIMATION\n  ========================= */\n\n  .npc-switching {\n    opacity: .28 !important;\n    transform: translateY(5px) !important;\n  }\n\n  .npc-change {\n    transition:\n      opacity .18s ease,\n      transform .24s cubic-bezier(.16,1,.3,1);\n  }\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    #nitrix-premium-compare {\n      padding: 64px 12px 72px;\n    }\n\n    .npc-heading {\n      margin-bottom: 28px;\n    }\n\n    .npc-heading h2 {\n      font-size: clamp(40px, 12vw, 52px);\n    }\n\n    .npc-heading-copy {\n      padding: 0 8px;\n      font-size: 13px;\n    }\n\n    .npc-selector {\n      width: 100%;\n      max-width: none;\n      margin-bottom: 18px;\n    }\n\n    .npc-selector-label {\n      margin-left: 15px;\n      font-size: 12px;\n    }\n\n    .npc-select {\n      height: 48px;\n      font-size: 13px;\n    }\n\n    .npc-card {\n      border-radius: 24px;\n    }\n\n    .npc-products {\n      grid-template-columns: minmax(0,1fr) 34px minmax(0,1fr);\n      gap: 7px;\n      padding: 27px 10px 18px;\n    }\n\n    .npc-product-media {\n      height: 220px;\n      border-radius: 18px;\n    }\n\n    .npc-product-media img {\n      border-radius: inherit;\n      object-position: center center;\n    }\n\n    .npc-product-name {\n      font-size: 16px;\n    }\n\n    .npc-product-note {\n      min-height: 52px;\n      padding: 0 2px;\n      font-size: 9.5px;\n    }\n\n    .npc-vs {\n      margin-top: 75px;\n      font-size: 8px;\n    }\n\n    .npc-table {\n      padding: 8px 11px 34px;\n    }\n\n    .npc-row {\n      grid-template-columns:\n        minmax(0, 1fr)\n        minmax(76px, 88px)\n        minmax(0, 1fr);\n      gap: 7px;\n      min-height: 64px;\n    }\n\n    .npc-value {\n      font-size: 13px;\n      line-height: 1.2;\n    }\n\n    .npc-label {\n      font-size: 7px;\n      letter-spacing: .09em;\n    }\n\n    .npc-bottom {\n      padding: 8px 12px 38px;\n    }\n\n    .npc-bottom h3 {\n      font-size: 34px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .npc-product-media {\n      height: 190px;\n      border-radius: 16px;\n    }\n\n    .npc-product-media img {\n      border-radius: inherit;\n      object-position: center center;\n    }\n\n    .npc-product-name {\n      font-size: 14px;\n    }\n\n    .npc-product-note {\n      font-size: 8.7px;\n    }\n\n    .npc-row {\n      grid-template-columns:\n        minmax(0, 1fr)\n        72px\n        minmax(0, 1fr);\n    }\n\n    .npc-value {\n      font-size: 12px;\n    }\n\n    .npc-label {\n      font-size: 6.4px;\n    }\n  }\n</style>\n\n<section id=\"nitrix-premium-compare\">\n  <div class=\"npc-inner\">\n\n    <div class=\"npc-heading\">\n      <p class=\"npc-kicker\">NITRIX SERIES COMPARISON</p>\n\n      <h2>\n        Compare.\n      </h2>\n\n      <p class=\"npc-heading-copy\">\n        Two different weapons. One attacking mindset.\n      </p>\n    </div>\n\n    <div class=\"npc-selector\">\n      <p class=\"npc-selector-label\">\n        Select a racket to compare to Nitrix 80 Bullet:\n      </p>\n\n      <div class=\"npc-select-shell\">\n        <select\n          class=\"npc-select\"\n          id=\"npc-model-select\"\n          aria-label=\"Select a Nitrix racket to compare\"\n        >\n          <option value=\"venom\">Nitrix 70 Venom</option>\n          <option value=\"volta\">Nitrix 70 Volta</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"npc-card\">\n\n      <!-- =========================\n           PRODUCT TOP\n      ========================== -->\n\n      <div class=\"npc-products\">\n\n        <article class=\"npc-product npc-change\" id=\"npc-left-product\">\n\n          <div class=\"npc-product-media\">\n\n            {% if venom_product != blank and venom_product.featured_image != blank %}\n\n              <img\n                id=\"npc-left-image\"\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=900\"\n                srcset=\"\n                  https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=360 360w,\n                  https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=540 540w,\n                  https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=720 720w,\n                  https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541&width=900 900w\n                \"\n                sizes=\"(max-width: 749px) 42vw, 42vw\"\n                alt=\"Nitrix 70 Venom\"\n                loading=\"eager\"\n                fetchpriority=\"high\"\n                decoding=\"async\"\n              >\n\n            {% else %}\n\n              <div class=\"npc-placeholder\"></div>\n\n            {% endif %}\n\n          </div>\n\n          <h3 class=\"npc-product-name\" id=\"npc-left-name\">\n            Nitrix 70 Venom\n          </h3>\n\n          <p class=\"npc-product-note\" id=\"npc-left-note\">\n            Fast attacking response with controlled handling.\n          </p>\n\n        </article>\n\n\n        <div class=\"npc-vs\">\n          VS\n        </div>\n\n\n        <article class=\"npc-product\">\n\n          <div class=\"npc-product-media\">\n\n            {% if bullet_img != blank %}\n\n              <img\n                src=\"{{ bullet_img }}&width=900\"\n                srcset=\"\n                  {{ bullet_img }}&width=360 360w,\n                  {{ bullet_img }}&width=540 540w,\n                  {{ bullet_img }}&width=720 720w,\n                  {{ bullet_img }}&width=900 900w\n                \"\n                sizes=\"(max-width: 749px) 42vw, 42vw\"\n                alt=\"Nitrix 80 Bullet\"\n                loading=\"eager\"\n                fetchpriority=\"high\"\n                decoding=\"async\"\n              >\n\n            {% else %}\n\n              <div class=\"npc-placeholder\"></div>\n\n            {% endif %}\n\n          </div>\n\n          <h3 class=\"npc-product-name\">\n            Nitrix 80 Bullet\n          </h3>\n\n          <p class=\"npc-product-note\">\n            Razor-thin response engineered for aggressive attacking play.\n          </p>\n\n        </article>\n\n      </div>\n\n\n      <!-- =========================\n           TEXT-ONLY SPECS\n      ========================== -->\n\n      <div class=\"npc-table\">\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-shaft\">\n            6.1 mm\n          </div>\n\n          <div class=\"npc-label\">\n            Shaft Thickness\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            5.9 mm\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-flex\">\n            Hard Flex\n          </div>\n\n          <div class=\"npc-label\">\n            Flex\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Fast Release\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-carbon\">\n            M46X Carbon Fibre\n          </div>\n\n          <div class=\"npc-label\">\n            Carbon Fibre\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            M46X Carbon Fibre\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-frame\">\n            Curve² Frame\n          </div>\n\n          <div class=\"npc-label\">\n            Frame\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Curve² Frame\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-tech\">\n            CNTRL Foam\n          </div>\n\n          <div class=\"npc-label\">\n            Technology\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            CNTRL Foam\n          </div>\n        </div>\n\n\n        <div class=\"npc-row\">\n          <div class=\"npc-value npc-value--left npc-change\" id=\"npc-response\">\n            Controlled Attack\n          </div>\n\n          <div class=\"npc-label\">\n            Response\n          </div>\n\n          <div class=\"npc-value npc-value--right\">\n            Faster Release\n          </div>\n        </div>\n\n      </div>\n\n\n      <!-- =========================\n           BOTTOM\n      ========================== -->\n\n      <div class=\"npc-bottom\">\n\n        <p class=\"npc-bottom-label\">\n          THE DIFFERENCE\n        </p>\n\n        <h3>\n          Thinner shaft.<br>\n          <span>Sharper release.</span>\n        </h3>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n\n  var section =\n    document.getElementById(\n      'nitrix-premium-compare'\n    );\n\n  if (!section) {\n    return;\n  }\n\n  var select =\n    section.querySelector(\n      '#npc-model-select'\n    );\n\n  if (!select) {\n    return;\n  }\n\n  var data = {\n\n    venom: {\n      name:\n        'Nitrix 70 Venom',\n\n      note:\n        'Fast attacking response with controlled handling.',\n\n      shaft:\n        '6.1 mm',\n\n      flex:\n        'Hard Flex',\n\n      carbon:\n        'M46X Carbon Fibre',\n\n      frame:\n        'Curve² Frame',\n\n      tech:\n        'CNTRL Foam',\n\n      response:\n        'Controlled Attack',\n\n      image:\n        'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541'\n    },\n\n\n    volta: {\n      name:\n        'Nitrix 70 Volta',\n\n      note:\n        'Clean aggressive power with a flexible shaft.',\n\n      shaft:\n        '7.0 mm',\n\n      flex:\n        'Flexible',\n\n      carbon:\n        'M46X + AECG+ Carbon',\n\n      frame:\n        'Aerodynamic Frame',\n\n      tech:\n        'Performance Construction',\n\n      response:\n        'Loaded Power',\n\n      image:\n        'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_dba40639-bb18-422f-adcc-defb52ab3d09.jpg?v=1786712390'\n    }\n\n  };\n\n\n  function sizedUrl(\n    url,\n    width\n  ) {\n    return url +\n      (url.indexOf('?') > -1 ? '&' : '?') +\n      'width=' +\n      width;\n  }\n\n\n  function srcSetFor(\n    url\n  ) {\n    return [\n      sizedUrl(url, 360) + ' 360w',\n      sizedUrl(url, 540) + ' 540w',\n      sizedUrl(url, 720) + ' 720w',\n      sizedUrl(url, 900) + ' 900w'\n    ].join(', ');\n  }\n\n\n  var preloadCache = {};\n\n\n  function warmImage(\n    url\n  ) {\n    if (\n      !url ||\n      preloadCache[url]\n    ) {\n      return preloadCache[url] ||\n        Promise.resolve();\n    }\n\n    var preloader =\n      new Image();\n\n    preloader.decoding =\n      'async';\n\n    preloader.srcset =\n      srcSetFor(url);\n\n    preloader.sizes =\n      '(max-width: 749px) 42vw, 42vw';\n\n    preloader.src =\n      sizedUrl(url, 900);\n\n    var ready =\n      preloader.decode\n        ? preloader.decode().catch(\n            function () {}\n          )\n        : new Promise(\n            function (resolve) {\n              preloader.onload = resolve;\n              preloader.onerror = resolve;\n            }\n          );\n\n    preloadCache[url] =\n      ready;\n\n    return ready;\n  }\n\n\n  warmImage(\n    'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_73395376-8dfa-4b09-adf4-fe5f1d1810ac.jpg?v=1786709541'\n  );\n\n  warmImage(\n    'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_dba40639-bb18-422f-adcc-defb52ab3d09.jpg?v=1786712390'\n  );\n\n  warmImage(\n    'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623'\n  );\n\n\n  var product =\n    section.querySelector(\n      '#npc-left-product'\n    );\n\n  var image =\n    section.querySelector(\n      '#npc-left-image'\n    );\n\n  var name =\n    section.querySelector(\n      '#npc-left-name'\n    );\n\n  var note =\n    section.querySelector(\n      '#npc-left-note'\n    );\n\n  var shaft =\n    section.querySelector(\n      '#npc-shaft'\n    );\n\n  var flex =\n    section.querySelector(\n      '#npc-flex'\n    );\n\n  var carbon =\n    section.querySelector(\n      '#npc-carbon'\n    );\n\n  var frame =\n    section.querySelector(\n      '#npc-frame'\n    );\n\n  var tech =\n    section.querySelector(\n      '#npc-tech'\n    );\n\n  var response =\n    section.querySelector(\n      '#npc-response'\n    );\n\n  var changing =\n    section.querySelectorAll(\n      '.npc-change'\n    );\n\n\n  function setSwitching(\n    state\n  ) {\n\n    changing.forEach(\n      function (element) {\n\n        element.classList.toggle(\n          'npc-switching',\n          state\n        );\n\n      }\n    );\n\n  }\n\n\n  var compareRequest =\n    0;\n\n\n  function updateCompare(\n    key\n  ) {\n\n    var requestId =\n      ++compareRequest;\n\n\n    var item =\n      data[key];\n\n    if (!item) {\n      return;\n    }\n\n\n    setSwitching(\n      true\n    );\n\n\n    warmImage(\n      item.image\n    ).then(\n      function () {\n\n        if (\n          requestId !==\n          compareRequest\n        ) {\n          return;\n        }\n\n\n        if (name) {\n          name.textContent =\n            item.name;\n        }\n\n        if (note) {\n          note.textContent =\n            item.note;\n        }\n\n        if (shaft) {\n          shaft.textContent =\n            item.shaft;\n        }\n\n        if (flex) {\n          flex.textContent =\n            item.flex;\n        }\n\n        if (carbon) {\n          carbon.textContent =\n            item.carbon;\n        }\n\n        if (frame) {\n          frame.textContent =\n            item.frame;\n        }\n\n        if (tech) {\n          tech.textContent =\n            item.tech;\n        }\n\n        if (response) {\n          response.textContent =\n            item.response;\n        }\n\n        if (\n          image &&\n          item.image\n        ) {\n\n          image.srcset =\n            srcSetFor(\n              item.image\n            );\n\n          image.sizes =\n            '(max-width: 749px) 42vw, 42vw';\n\n          image.src =\n            sizedUrl(\n              item.image,\n              900\n            );\n\n          image.alt =\n            item.name;\n\n        }\n\n\n        requestAnimationFrame(\n          function () {\n            setSwitching(\n              false\n            );\n          }\n        );\n\n      }\n    );\n\n  }\n\n\n  select.addEventListener(\n    'change',\n    function () {\n\n      updateCompare(\n        this.value\n      );\n\n    }\n  );\n\n})();\n</script>",
