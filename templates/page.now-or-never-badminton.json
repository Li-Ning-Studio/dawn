      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — PREMIUM MULTI COLLECTION CAROUSEL\n  CUSTOM LIQUID ONLY\n  NO SCHEMA\n\n  Each collection has its own offer tag.\n{% endcomment %}\n\n\n{% assign collection_handles = 'phenom-sale,hyperspeed-non,now-or-never-beast-max,free-sk-bag-and-socks' | split: ',' %}\n\n{% assign collection_tags = 'FREE SK Shoe bag + pack of 3 socks|Free SK Shoe bag |Free pack of 3 socks|Free Shoe bag + sock|Free draw string bag' | split: '|' %}\n\n{% assign products_per_collection = 5 %}\n\n{% assign view_all_link = 'https://in.hndrd.co/collections/now-or-never-badminton-shoes' %}\n\n{% assign section_heading = '\nFree gifts with every pair.' %}\n\n{% assign section_description = 'Buy the shoes and get the shoe bag or the socks for free.' %}\n\n\n\n<section\n  id=\"nn-products-{{ section.id }}\"\n  class=\"nn-products\"\n>\n\n  <!-- AMBIENT BACKGROUND -->\n\n  <div\n    class=\"nn-products__ambient\"\n    aria-hidden=\"true\"\n  >\n\n    <span\n      class=\"\n        nn-products__glow\n        nn-products__glow--1\n      \"\n    ></span>\n\n    <span\n      class=\"\n        nn-products__glow\n        nn-products__glow--2\n      \"\n    ></span>\n\n  </div>\n\n\n\n  <div class=\"nn-products__container\">\n\n\n    <!-- ==================================================\n         HEADER\n    =================================================== -->\n\n    <div\n      class=\"\n        nn-products__header\n        nn-reveal\n      \"\n    >\n\n      <div class=\"nn-products__heading\">\n\n        <h2>\n          {{ section_heading }}\n        </h2>\n\n\n        {% if section_description != blank %}\n\n          <p>\n            {{ section_description }}\n          </p>\n\n        {% endif %}\n\n      </div>\n\n\n\n      <!-- ACTIONS -->\n\n      <div class=\"nn-products__actions\">\n\n\n        <!-- VIEW ALL -->\n\n        <a\n          href=\"{{ view_all_link }}\"\n          class=\"nn-products__view\"\n        >\n\n          <span>\n            View all\n          </span>\n\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n\n            <path\n              d=\"M5 12H19M14 7L19 12L14 17\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.7\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n\n          </svg>\n\n        </a>\n\n\n\n        <!-- DESKTOP NAV -->\n\n        <div class=\"nn-products__nav\">\n\n          <button\n            class=\"\n              nn-products__nav-btn\n              nn-products__prev\n            \"\n            type=\"button\"\n            aria-label=\"Previous products\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n\n              <path\n                d=\"M19 12H5M10 7L5 12L10 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </button>\n\n\n          <button\n            class=\"\n              nn-products__nav-btn\n              nn-products__next\n            \"\n            type=\"button\"\n            aria-label=\"Next products\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </button>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- ==================================================\n         PRODUCT CAROUSEL\n    =================================================== -->\n\n    <div class=\"nn-products__carousel-wrap\">\n\n      <div\n        class=\"nn-products__carousel\"\n        data-nn-carousel\n      >\n\n\n        {% for handle in collection_handles %}\n\n          {% assign current_collection = collections[handle] %}\n\n          {% assign collection_position = forloop.index %}\n\n          {% assign collection_index = forloop.index0 %}\n\n          {% assign collection_tag = collection_tags[collection_index] %}\n\n\n          {% if collection_tag == blank %}\n\n            {% assign collection_tag = current_collection.title %}\n\n          {% endif %}\n\n\n\n          {% if current_collection != blank %}\n\n\n            {% for product in current_collection.products limit: products_per_collection %}\n\n\n              <article\n                class=\"\n                  nn-product\n                  nn-product--collection-{{ collection_position }}\n                  nn-reveal\n                \"\n              >\n\n                <a\n                  href=\"{{ product.url }}\"\n                  class=\"nn-product__link\"\n                  aria-label=\"{{ product.title | escape }}\"\n                >\n\n\n                  <!-- ==============================\n                       IMAGE AREA\n                  =============================== -->\n\n                  <div class=\"nn-product__media\">\n\n\n                    {% if product.featured_image != blank %}\n\n                      <img\n                        class=\"nn-product__image\"\n                        src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                        srcset=\"\n                          {{ product.featured_image | image_url: width: 400 }} 400w,\n                          {{ product.featured_image | image_url: width: 600 }} 600w,\n                          {{ product.featured_image | image_url: width: 900 }} 900w\n                        \"\n                        sizes=\"\n                          (max-width: 749px) 76vw,\n                          (max-width: 1100px) 42vw,\n                          24vw\n                        \"\n                        alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                        loading=\"lazy\"\n                        width=\"900\"\n                        height=\"900\"\n                      >\n\n                    {% endif %}\n\n\n\n                    <!-- VERY SUBTLE SHADE -->\n\n                    <div\n                      class=\"nn-product__shade\"\n                      aria-hidden=\"true\"\n                    ></div>\n\n\n\n                    <!-- ==============================\n                         COLLECTION-SPECIFIC TAG\n                    =============================== -->\n\n                    {% if product.available %}\n\n                      <span\n                        class=\"\n                          nn-product__badge\n                          nn-product__badge--offer\n                          nn-product__badge--collection-{{ collection_position }}\n                        \"\n                      >\n\n                        {{ collection_tag }}\n\n                      </span>\n\n                    {% else %}\n\n                      <span\n                        class=\"\n                          nn-product__badge\n                          nn-product__badge--soldout\n                        \"\n                      >\n\n                        SOLD OUT\n\n                      </span>\n\n                    {% endif %}\n\n\n\n                    <!-- ARROW -->\n\n                    <span\n                      class=\"nn-product__arrow\"\n                      aria-hidden=\"true\"\n                    >\n\n                      <svg\n                        viewBox=\"0 0 24 24\"\n                        fill=\"none\"\n                      >\n\n                        <path\n                          d=\"M5 12H19M14 7L19 12L14 17\"\n                          stroke=\"currentColor\"\n                          stroke-width=\"1.7\"\n                          stroke-linecap=\"round\"\n                          stroke-linejoin=\"round\"\n                        />\n\n                      </svg>\n\n                    </span>\n\n                  </div>\n\n\n\n                  <!-- ==============================\n                       PRODUCT INFO\n                  =============================== -->\n\n                  <div class=\"nn-product__info\">\n\n\n                    <h3>\n                      {{ product.title }}\n                    </h3>\n\n\n\n                    <div class=\"nn-product__price\">\n\n\n                      <span class=\"nn-product__price-current\">\n\n                        {{ product.price | money }}\n\n                      </span>\n\n\n\n                      {% if product.compare_at_price_max > product.price %}\n\n                        <span class=\"nn-product__price-old\">\n\n                          {{ product.compare_at_price_max | money }}\n\n                        </span>\n\n                      {% endif %}\n\n\n                    </div>\n\n                  </div>\n\n\n                </a>\n\n              </article>\n\n\n            {% endfor %}\n\n\n          {% endif %}\n\n\n        {% endfor %}\n\n\n      </div>\n\n\n\n      <!-- ==================================================\n           PROGRESS\n      =================================================== -->\n\n      <div class=\"nn-products__progress\">\n\n        <div class=\"nn-products__progress-track\">\n\n          <span class=\"nn-products__progress-bar\"></span>\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ==========================================================\n   SECTION\n========================================================== */\n\n#nn-products-{{ section.id }} {\n\n  --nn-yellow: #f2ee38;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  /* TIGHTER SECTION SPACING */\n\n  padding:\n    18px 0\n    22px;\n\n  background:\n    linear-gradient(\n      180deg,\n      #16001e 0%,\n      #1b0023 50%,\n      #16001e 100%\n    );\n\n  color:\n    #fff;\n\n}\n\n\n\n/* ==========================================================\n   AMBIENT\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__ambient {\n\n  position: absolute;\n\n  inset: 0;\n\n  pointer-events: none;\n\n  overflow: hidden;\n\n  z-index: -1;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter:\n    blur(150px);\n\n  opacity:\n    .075;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow--1 {\n\n  width: 520px;\n\n  height: 520px;\n\n  top: -300px;\n\n  left: -220px;\n\n  background:\n    #9f1dcb;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow--2 {\n\n  width: 540px;\n\n  height: 540px;\n\n  right: -260px;\n\n  bottom: -300px;\n\n  background:\n    #5d11af;\n\n}\n\n\n\n/* ==========================================================\n   CONTAINER\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__container {\n\n  width:\n    min(\n      1500px,\n      calc(100% - 64px)\n    );\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* ==========================================================\n   HEADER\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__header {\n\n  display: flex;\n\n  align-items:\n    flex-end;\n\n  justify-content:\n    space-between;\n\n  gap:\n    25px;\n\n  margin-bottom:\n    clamp(\n      24px,\n      3vw,\n      36px\n    );\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading {\n\n  max-width:\n    720px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading h2 {\n\n  margin:\n    0;\n\n  color:\n    #fff;\n\n  font-size:\n    clamp(\n      38px,\n      4.5vw,\n      60px\n    );\n\n  line-height:\n    .98;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading p {\n\n  max-width:\n    500px;\n\n  margin:\n    12px 0 0;\n\n  color:\n    rgba(255,255,255,.53);\n\n  font-size:\n    14px;\n\n  line-height:\n    1.5;\n\n}\n\n\n\n/* ==========================================================\n   ACTIONS\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__actions {\n\n  display: flex;\n\n  align-items:\n    center;\n\n  gap:\n    10px;\n\n  flex-shrink:\n    0;\n\n}\n\n\n\n/* ==========================================================\n   VIEW ALL\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__view {\n\n  display:\n    inline-flex;\n\n  align-items:\n    center;\n\n  justify-content:\n    center;\n\n  gap:\n    10px;\n\n  min-height:\n    44px;\n\n  padding:\n    0 17px;\n\n  border-radius:\n    999px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.15);\n\n  background:\n    rgba(255,255,255,.04);\n\n  color:\n    #fff;\n\n  text-decoration:\n    none;\n\n  font-size:\n    12px;\n\n  font-weight:\n    600;\n\n  transition:\n\n    background\n    .4s ease,\n\n    border-color\n    .4s ease,\n\n    color\n    .4s ease,\n\n    transform\n    .45s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__view svg {\n\n  width:\n    15px;\n\n  height:\n    15px;\n\n  transition:\n    transform\n    .4s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__view:hover {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      translateY(-2px);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__view:hover svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   NAV\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__nav {\n\n  display:\n    flex;\n\n  gap:\n    7px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn {\n\n  width:\n    44px;\n\n  height:\n    44px;\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  padding:\n    0;\n\n  cursor:\n    pointer;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  background:\n    rgba(255,255,255,.04);\n\n  color:\n    #fff;\n\n  transition:\n    .4s ease;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn svg {\n\n  width:\n    16px;\n\n  height:\n    16px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn:disabled {\n\n  opacity:\n    .25;\n\n  cursor:\n    default;\n\n}\n\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__nav-btn:not(:disabled):hover {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   CAROUSEL\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__carousel {\n\n  display:\n    grid;\n\n  grid-auto-flow:\n    column;\n\n  grid-auto-columns:\n    calc(\n      (100% - 54px) / 4\n    );\n\n  gap:\n    18px;\n\n  overflow-x:\n    auto;\n\n  overflow-y:\n    hidden;\n\n  padding:\n    3px 2px\n    20px;\n\n  scroll-snap-type:\n    x mandatory;\n\n  scroll-behavior:\n    smooth;\n\n  scrollbar-width:\n    none;\n\n  overscroll-behavior-inline:\n    contain;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__carousel::-webkit-scrollbar {\n\n  display:\n    none;\n\n}\n\n\n\n/* ==========================================================\n   PRODUCT\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product {\n\n  min-width:\n    0;\n\n  scroll-snap-align:\n    start;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__link {\n\n  display:\n    block;\n\n  color:\n    inherit;\n\n  text-decoration:\n    none;\n\n}\n\n\n\n/* ==========================================================\n   PRODUCT MEDIA\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__media {\n\n  position:\n    relative;\n\n  width:\n    100%;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    24px;\n\n  background:\n    #f4f5fa;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  box-shadow:\n    0 15px 40px\n    rgba(0,0,0,.17);\n\n  transform:\n    translateZ(0);\n\n  transition:\n\n    transform\n    .7s\n    cubic-bezier(.16,1,.3,1),\n\n    box-shadow\n    .7s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* ==========================================================\n   SINGLE PRODUCT IMAGE ONLY\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__image {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  display:\n    block;\n\n  width:\n    100%;\n\n  height:\n    100%;\n\n  object-fit:\n    cover;\n\n  transform:\n    scale(1);\n\n  transition:\n    transform\n    .95s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* ==========================================================\n   SUBTLE IMAGE SHADE\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__shade {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    2;\n\n  pointer-events:\n    none;\n\n  background:\n    linear-gradient(\n      180deg,\n      transparent 72%,\n      rgba(0,0,0,.045) 100%\n    );\n\n}\n\n\n\n/* ==========================================================\n   COLLECTION OFFER BADGES\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__badge {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  left:\n    15px;\n\n  bottom:\n    15px;\n\n  display:\n    inline-flex;\n\n  align-items:\n    center;\n\n  justify-content:\n    center;\n\n  max-width:\n    calc(100% - 75px);\n\n  min-height:\n    27px;\n\n  padding:\n    0 11px;\n\n  overflow:\n    hidden;\n\n  text-overflow:\n    ellipsis;\n\n  white-space:\n    nowrap;\n\n  border-radius:\n    999px;\n\n  font-size:\n    8px;\n\n  line-height:\n    1;\n\n  font-weight:\n    800;\n\n  letter-spacing:\n    .11em;\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n/* COMMON OFFER STYLE */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--offer {\n\n  color:\n    #211023;\n\n  box-shadow:\n    0 8px 20px\n    rgba(0,0,0,.09);\n\n}\n\n\n\n/* =========================================\n   COLLECTION 1\n   FREE COSMOGEAR MAX\n========================================= */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--collection-1 {\n\n  background:\n    #f2ee38;\n\n}\n\n\n\n/* =========================================\n   COLLECTION 2\n   FREE METRO KITBAG\n========================================= */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--collection-2 {\n\n  background:\n    #ffffff;\n\n  color:\n    #25152b;\n\n}\n\n\n\n/* =========================================\n   COLLECTION 3\n========================================= */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--collection-3 {\n\n  background:\n    #dcc0ff;\n\n  color:\n    #25152b;\n\n}\n\n\n\n/* =========================================\n   COLLECTION 4\n========================================= */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--collection-4 {\n\n  background:\n    #ffd7ed;\n\n  color:\n    #25152b;\n\n}\n\n\n\n/* =========================================\n   COLLECTION 5\n========================================= */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--collection-5 {\n\n  background:\n    #c9efff;\n\n  color:\n    #171b26;\n\n}\n\n\n\n/* SOLD OUT */\n\n#nn-products-{{ section.id }}\n.nn-product__badge--soldout {\n\n  background:\n    rgba(27,18,31,.91);\n\n  color:\n    #fff;\n\n  box-shadow:\n    none;\n\n}\n\n\n\n/* ==========================================================\n   ARROW\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__arrow {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  top:\n    14px;\n\n  right:\n    14px;\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  width:\n    38px;\n\n  height:\n    38px;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.2);\n\n  background:\n    rgba(82,77,95,.86);\n\n  color:\n    #fff;\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  transition:\n\n    background\n    .4s ease,\n\n    border-color\n    .4s ease,\n\n    color\n    .4s ease,\n\n    transform\n    .5s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__arrow svg {\n\n  width:\n    14px;\n\n  height:\n    14px;\n\n  transition:\n    transform\n    .45s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* ==========================================================\n   PRODUCT INFO\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__info {\n\n  padding:\n    15px 4px\n    3px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__info h3 {\n\n  margin:\n    0;\n\n  min-height:\n    2.5em;\n\n  overflow:\n    hidden;\n\n  display:\n    -webkit-box;\n\n  -webkit-line-clamp:\n    2;\n\n  -webkit-box-orient:\n    vertical;\n\n  color:\n    rgba(255,255,255,.95);\n\n  font-size:\n    clamp(\n      15px,\n      1.15vw,\n      18px\n    );\n\n  line-height:\n    1.24;\n\n  font-weight:\n    560;\n\n  letter-spacing:\n    -.02em;\n\n}\n\n\n\n/* ==========================================================\n   PRICE\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__price {\n\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  flex-wrap:\n    wrap;\n\n  gap:\n    9px;\n\n  margin-top:\n    10px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__price-current {\n\n  color:\n    #fff;\n\n  font-size:\n    16px;\n\n  font-weight:\n    650;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__price-old {\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-size:\n    13px;\n\n  text-decoration:\n    line-through;\n\n}\n\n\n\n/* ==========================================================\n   HOVER\n========================================================== */\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__media {\n\n    transform:\n      translateY(-5px);\n\n    box-shadow:\n      0 26px 58px\n      rgba(0,0,0,.27);\n\n  }\n\n\n  /*\n    SAME IMAGE.\n    Only an extremely subtle push-in.\n  */\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__image {\n\n    transform:\n      scale(1.022);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__arrow {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      scale(1.05);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   PROGRESS\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__progress {\n\n  display:\n    flex;\n\n  justify-content:\n    center;\n\n  margin-top:\n    3px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__progress-track {\n\n  position:\n    relative;\n\n  width:\n    min(\n      230px,\n      40%\n    );\n\n  height:\n    2px;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    999px;\n\n  background:\n    rgba(255,255,255,.1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__progress-bar {\n\n  position:\n    absolute;\n\n  inset:\n    0 auto 0 0;\n\n  width:\n    25%;\n\n  border-radius:\n    inherit;\n\n  background:\n    var(--nn-yellow);\n\n  transform-origin:\n    left center;\n\n}\n\n\n\n/* ==========================================================\n   REVEAL\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-reveal {\n\n  opacity:\n    0;\n\n  transform:\n    translateY(18px);\n\n  transition:\n\n    opacity\n    .78s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .88s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-reveal.nn-visible {\n\n  opacity:\n    1;\n\n  transform:\n    translateY(0);\n\n}\n\n\n\n/* ==========================================================\n   TABLET\n========================================================== */\n\n@media\n(max-width: 1100px) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__container {\n\n    width:\n      calc(100% - 36px);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__carousel {\n\n    grid-auto-columns:\n      calc(\n        (100% - 18px) / 2.15\n      );\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   MOBILE\n========================================================== */\n\n@media\n(max-width: 749px) {\n\n  #nn-products-{{ section.id }} {\n\n    padding:\n      16px 0\n      20px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__container {\n\n    width:\n      100%;\n\n  }\n\n\n\n  /* HEADER */\n\n  #nn-products-{{ section.id }}\n  .nn-products__header {\n\n    width:\n      calc(100% - 28px);\n\n    margin:\n      0 auto\n      22px;\n\n    align-items:\n      flex-end;\n\n    gap:\n      12px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__heading h2 {\n\n    font-size:\n      clamp(\n        31px,\n        8.8vw,\n        41px\n      );\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__heading p {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* VIEW ALL */\n\n  #nn-products-{{ section.id }}\n  .nn-products__view {\n\n    min-height:\n      38px;\n\n    padding:\n      0 13px;\n\n    font-size:\n      10px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__view svg {\n\n    width:\n      12px;\n\n    height:\n      12px;\n\n  }\n\n\n\n  /* HIDE DESKTOP ARROWS */\n\n  #nn-products-{{ section.id }}\n  .nn-products__nav {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* CAROUSEL */\n\n  #nn-products-{{ section.id }}\n  .nn-products__carousel {\n\n    grid-auto-columns:\n      76vw;\n\n    gap:\n      12px;\n\n    padding:\n      2px 14px\n      19px;\n\n    scroll-padding-inline:\n      14px;\n\n  }\n\n\n\n  /* CARD */\n\n  #nn-products-{{ section.id }}\n  .nn-product__media {\n\n    border-radius:\n      21px;\n\n  }\n\n\n\n  /* OFFER BADGE */\n\n  #nn-products-{{ section.id }}\n  .nn-product__badge {\n\n    left:\n      12px;\n\n    bottom:\n      12px;\n\n    max-width:\n      calc(100% - 64px);\n\n    min-height:\n      25px;\n\n    padding:\n      0 9px;\n\n    font-size:\n      7px;\n\n    letter-spacing:\n      .09em;\n\n  }\n\n\n\n  /* ARROW */\n\n  #nn-products-{{ section.id }}\n  .nn-product__arrow {\n\n    top:\n      12px;\n\n    right:\n      12px;\n\n    width:\n      34px;\n\n    height:\n      34px;\n\n  }\n\n\n\n  /* INFO */\n\n  #nn-products-{{ section.id }}\n  .nn-product__info {\n\n    padding:\n      13px 3px\n      3px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__info h3 {\n\n    min-height:\n      auto;\n\n    font-size:\n      16px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__price {\n\n    margin-top:\n      8px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__price-current {\n\n    font-size:\n      15px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__progress-track {\n\n    width:\n      120px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REDUCED MOTION\n========================================================== */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #nn-products-{{ section.id }} *,\n  #nn-products-{{ section.id }} *::before,\n  #nn-products-{{ section.id }} *::after {\n\n    transition:\n      none !important;\n\n    animation:\n      none !important;\n\n    scroll-behavior:\n      auto !important;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-reveal {\n\n    opacity:\n      1;\n\n    transform:\n      none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'nn-products-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n\n  const carousel =\n    section.querySelector(\n      '[data-nn-carousel]'\n    );\n\n\n  if (!carousel) return;\n\n\n\n  const prev =\n    section.querySelector(\n      '.nn-products__prev'\n    );\n\n\n  const next =\n    section.querySelector(\n      '.nn-products__next'\n    );\n\n\n  const progress =\n    section.querySelector(\n      '.nn-products__progress-bar'\n    );\n\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n\n  /* ==================================================\n     CARD STEP\n  ================================================== */\n\n  function getCardStep() {\n\n    const card =\n      carousel.querySelector(\n        '.nn-product'\n      );\n\n\n    if (!card) {\n      return 0;\n    }\n\n\n    const styles =\n      window.getComputedStyle(\n        carousel\n      );\n\n\n    const gap =\n      parseFloat(\n        styles.gap || 0\n      );\n\n\n    return (\n      card.getBoundingClientRect().width +\n      gap\n    );\n\n  }\n\n\n\n  /* ==================================================\n     PREVIOUS\n  ================================================== */\n\n  if (prev) {\n\n    prev.addEventListener(\n      'click',\n      function () {\n\n        carousel.scrollBy({\n\n          left:\n            -getCardStep(),\n\n          behavior:\n            reducedMotion\n              ? 'auto'\n              : 'smooth'\n\n        });\n\n      }\n    );\n\n  }\n\n\n\n  /* ==================================================\n     NEXT\n  ================================================== */\n\n  if (next) {\n\n    next.addEventListener(\n      'click',\n      function () {\n\n        carousel.scrollBy({\n\n          left:\n            getCardStep(),\n\n          behavior:\n            reducedMotion\n              ? 'auto'\n              : 'smooth'\n\n        });\n\n      }\n    );\n\n  }\n\n\n\n  /* ==================================================\n     PROGRESS + BUTTON STATE\n  ================================================== */\n\n  function updateCarousel() {\n\n    const max =\n      carousel.scrollWidth -\n      carousel.clientWidth;\n\n\n    const current =\n      carousel.scrollLeft;\n\n\n\n    if (prev) {\n\n      prev.disabled =\n        current <= 4;\n\n    }\n\n\n\n    if (next) {\n\n      next.disabled =\n        current >= max - 4;\n\n    }\n\n\n\n    if (progress) {\n\n\n      if (max <= 0) {\n\n        progress.style.width =\n          '100%';\n\n\n        progress.style.transform =\n          'translateX(0)';\n\n\n        return;\n\n      }\n\n\n      const visible =\n        carousel.clientWidth /\n        carousel.scrollWidth;\n\n\n      const width =\n        Math.max(\n          20,\n          Math.min(\n            100,\n            visible * 100\n          )\n        );\n\n\n      progress.style.width =\n        width + '%';\n\n\n      const available =\n        100 - width;\n\n\n      const ratio =\n        current / max;\n\n\n      progress.style.transform =\n        'translateX(' +\n        (\n          (available / width) *\n          ratio *\n          100\n        ) +\n        '%)';\n\n    }\n\n  }\n\n\n\n  carousel.addEventListener(\n    'scroll',\n    updateCarousel,\n    {\n      passive: true\n    }\n  );\n\n\n  window.addEventListener(\n    'resize',\n    updateCarousel\n  );\n\n\n  updateCarousel();\n\n\n\n  /* ==================================================\n     REVEAL\n  ================================================== */\n\n  const revealItems =\n    section.querySelectorAll(\n      '.nn-reveal'\n    );\n\n\n  if (\n    !reducedMotion &&\n    'IntersectionObserver' in window\n  ) {\n\n    const observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (\n                !entry.isIntersecting\n              ) {\n                return;\n              }\n\n\n              entry.target\n                .classList\n                .add(\n                  'nn-visible'\n                );\n\n\n              observer.unobserve(\n                entry.target\n              );\n\n            }\n          );\n\n        },\n\n        {\n          threshold:\n            .1,\n\n          rootMargin:\n            '0px 0px -20px 0px'\n        }\n\n      );\n\n\n    revealItems.forEach(\n      function (item) {\n\n        observer.observe(\n          item\n        );\n\n      }\n    );\n\n  }\n\n  else {\n\n    revealItems.forEach(\n      function (item) {\n\n        item.classList.add(\n          'nn-visible'\n        );\n\n      }\n    );\n\n  }\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
    "hero_component_VK9DFC": {
