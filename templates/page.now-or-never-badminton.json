,\n      17px\n    );\n\n  line-height:\n    1.55;\n\n}\n\n\n\n/* ==========================================================\n   CTA BUTTON\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__button {\n\n  position: relative;\n\n  z-index: 3;\n\n  display: inline-flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 17px;\n\n  min-height:\n    58px;\n\n  margin-top:\n    31px;\n\n  padding:\n    6px\n    7px\n    6px\n    23px;\n\n  border-radius:\n    999px;\n\n  border:\n    1px solid\n    var(--non-yellow);\n\n  background:\n    var(--non-yellow);\n\n  color:\n    #211023;\n\n  text-decoration: none;\n\n  font-size:\n    11px;\n\n  line-height: 1;\n\n  font-weight:\n    800;\n\n  letter-spacing:\n    .12em;\n\n  box-shadow:\n    0 14px 34px\n    rgba(242,238,56,.12);\n\n  transition:\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1),\n\n    box-shadow\n    .55s ease,\n\n    background\n    .4s ease,\n\n    color\n    .4s ease;\n\n}\n\n\n\n/* arrow circle */\n\n#non-closing-{{ section.id }}\n.non-closing__button-arrow {\n\n  display: grid;\n\n  place-items: center;\n\n  width:\n    45px;\n\n  height:\n    45px;\n\n  flex-shrink: 0;\n\n  border-radius:\n    50%;\n\n  background:\n    #211023;\n\n  color:\n    #fff;\n\n  transition:\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1),\n\n    background\n    .4s ease,\n\n    color\n    .4s ease;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__button-arrow svg {\n\n  width:\n    17px;\n\n  height:\n    17px;\n\n  transition:\n    transform\n    .5s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* BUTTON HOVER */\n\n@media (hover:hover) {\n\n  #non-closing-{{ section.id }}\n  .non-closing__button:hover {\n\n    transform:\n      translateY(-4px);\n\n    box-shadow:\n      0 22px 46px\n      rgba(242,238,56,.19);\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__button:hover\n  .non-closing__button-arrow {\n\n    transform:\n      rotate(-6deg)\n      scale(1.06);\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__button:hover\n  .non-closing__button-arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   FOOTER LINE\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__footer {\n\n  position: relative;\n\n  z-index: 2;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 8px;\n\n  margin-top:\n    22px;\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-size:\n    8px;\n\n  line-height: 1;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    .16em;\n\n}\n\n\n\n/* live pulse */\n\n#non-closing-{{ section.id }}\n.non-closing__pulse {\n\n  width:\n    5px;\n\n  height:\n    5px;\n\n  border-radius:\n    50%;\n\n  background:\n    var(--non-yellow);\n\n  box-shadow:\n    0 0 0\n    0\n    rgba(242,238,56,.35);\n\n  animation:\n    nonClosingPulse\n    2s\n    ease-out\n    infinite;\n\n}\n\n\n\n/* ==========================================================\n   REVEAL\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing-reveal {\n\n  opacity: 0;\n\n  transform:\n    translateY(24px)\n    scale(.992);\n\n  transition:\n\n    opacity\n    .85s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .95s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing-reveal.is-visible {\n\n  opacity: 1;\n\n  transform:\n    translateY(0)\n    scale(1);\n\n}\n\n\n\n/* ==========================================================\n   MOBILE\n========================================================== */\n\n@media\n(max-width: 749px) {\n\n  #non-closing-{{ section.id }} {\n\n    padding:\n      28px 0\n      34px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__panel {\n\n    min-height:\n      410px;\n\n    padding:\n      58px 22px;\n\n    border-radius:\n      26px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__eyebrow {\n\n    margin-bottom:\n      16px;\n\n    font-size:\n      8px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__eyebrow > span {\n\n    width:\n      17px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__panel h2 {\n\n    font-size:\n      clamp(\n        50px,\n        15vw,\n        66px\n      );\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__panel p {\n\n    max-width:\n      310px;\n\n    margin-top:\n      18px;\n\n    font-size:\n      13px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__button {\n\n    min-height:\n      54px;\n\n    margin-top:\n      27px;\n\n    padding:\n      5px\n      6px\n      5px\n      19px;\n\n    gap:\n      13px;\n\n    font-size:\n      9px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__button-arrow {\n\n    width:\n      42px;\n\n    height:\n      42px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__footer {\n\n    margin-top:\n      20px;\n\n    font-size:\n      7px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__ring--one {\n\n    width:\n      260px;\n\n    height:\n      260px;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing__ring--two {\n\n    width:\n      320px;\n\n    height:\n      320px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   ANIMATIONS\n========================================================== */\n\n@keyframes nonClosingGlowOne {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        90px,\n        45px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes nonClosingGlowTwo {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -90px,\n        -40px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes nonClosingSweep {\n\n  0%,\n  20% {\n\n    left:\n      -80%;\n\n  }\n\n  55% {\n\n    left:\n      140%;\n\n  }\n\n  100% {\n\n    left:\n      140%;\n\n  }\n\n}\n\n\n@keyframes nonClosingPulse {\n\n  0% {\n\n    box-shadow:\n      0 0 0\n      0\n      rgba(242,238,56,.36);\n\n  }\n\n  70% {\n\n    box-shadow:\n      0 0 0\n      7px\n      rgba(242,238,56,0);\n\n  }\n\n  100% {\n\n    box-shadow:\n      0 0 0\n      0\n      rgba(242,238,56,0);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REDUCED MOTION\n========================================================== */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #non-closing-{{ section.id }} *,\n  #non-closing-{{ section.id }} *::before,\n  #non-closing-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #non-closing-{{ section.id }}\n  .non-closing-reveal {\n\n    opacity:\n      1;\n\n    transform:\n      none;\n\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'non-closing-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n  const reveal =\n    section.querySelector(\n      '.non-closing-reveal'\n    );\n\n\n  if (!reveal) return;\n\n\n  const reduceMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (\n    reduceMotion ||\n    !('IntersectionObserver' in window)\n  ) {\n\n    reveal.classList.add(\n      'is-visible'\n    );\n\n    return;\n\n  }\n\n\n  const observer =\n    new IntersectionObserver(\n\n      function (entries) {\n\n        entries.forEach(\n          function (entry) {\n\n            if (!entry.isIntersecting) {\n              return;\n            }\n\n\n            entry.target\n              .classList\n              .add(\n                'is-visible'\n              );\n\n\n            observer.unobserve(\n              entry.target\n            );\n\n          }\n        );\n\n      },\n\n      {\n        threshold:\n          .16,\n\n        rootMargin:\n          '0px 0px -30px 0px'\n      }\n\n    );\n\n\n  observer.observe(\n    reveal\n  );\n\n})();\n\n</script>",
