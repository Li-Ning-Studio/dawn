      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — COLLECTION CARDS\n  CUSTOM LIQUID ONLY\n  NO SCHEMA\n\n  3 IMAGE CARDS\n  + 1 SHOP ALL CARD\n{% endcomment %}\n\n\n{% assign card_1_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Nitrix_Pro_3U_852a2351-da9d-4d83-bf09-b24c0a4c2b9e.jpg?v=1790687677' %}\n\n{% assign card_2_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon_Typhoon_a70d8a4a-5aa1-4027-9a14-bdc6a6a44d76.jpg?v=1790687676' %}\n\n{% assign card_3_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon_100_66637375-6cff-4880-ab50-ca260b6185af.jpg?v=1790687677' %}\n\n\n{% assign card_1_link = '/collections/free-cosmogear-max' %}\n\n{% assign card_2_link = '/collections/now-or-never-free-metro-kitbag' %}\n\n{% assign card_3_link = '/collections/free-string' %}\n\n{% assign shop_all_link = '/collections/now-or-never-free-kitbag-and-strings' %}\n\n\n\n<section\n  id=\"nn-collection-cards-{{ section.id }}\"\n  class=\"nncc\"\n>\n\n  <!-- AMBIENT -->\n\n  <div\n    class=\"nncc__ambient\"\n    aria-hidden=\"true\"\n  >\n\n    <span class=\"nncc__glow nncc__glow--1\"></span>\n\n    <span class=\"nncc__glow nncc__glow--2\"></span>\n\n  </div>\n\n\n\n  <div class=\"nncc__container\">\n\n\n    <!-- HEADER -->\n\n    <div class=\"nncc__header nncc-reveal\">\n\n      <div>\n\n        <h2>\n          Buy one.\n          <span>Unbox three.</span>\n        </h2>\n\n        <p>\n          Every racket here comes with a free kit bag and strings.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- ==================================================\n         COLLECTION CARDS\n    =================================================== -->\n\n    <div class=\"nncc__grid\">\n\n\n      <!-- ==========================================\n           CARD 01\n      =========================================== -->\n\n      <a\n        href=\"{{ card_1_link }}\"\n        class=\"\n          nncc__card\n          nncc__card--image\n          nncc-reveal\n        \"\n        aria-label=\"Shop collection\"\n      >\n\n        <div class=\"nncc__media\">\n\n          <img\n            src=\"{{ card_1_image }}\"\n            alt=\"\"\n            width=\"1000\"\n            height=\"1000\"\n            loading=\"lazy\"\n          >\n\n        </div>\n\n      </a>\n\n\n\n      <!-- ==========================================\n           CARD 02\n      =========================================== -->\n\n      <a\n        href=\"{{ card_2_link }}\"\n        class=\"\n          nncc__card\n          nncc__card--image\n          nncc-reveal\n        \"\n        aria-label=\"Shop collection\"\n      >\n\n        <div class=\"nncc__media\">\n\n          <img\n            src=\"{{ card_2_image }}\"\n            alt=\"\"\n            width=\"1000\"\n            height=\"1000\"\n            loading=\"lazy\"\n          >\n\n        </div>\n\n      </a>\n\n\n\n      <!-- ==========================================\n           CARD 03\n      =========================================== -->\n\n      <a\n        href=\"{{ card_3_link }}\"\n        class=\"\n          nncc__card\n          nncc__card--image\n          nncc-reveal\n        \"\n        aria-label=\"Shop collection\"\n      >\n\n        <div class=\"nncc__media\">\n\n          <img\n            src=\"{{ card_3_image }}\"\n            alt=\"\"\n            width=\"1000\"\n            height=\"1000\"\n            loading=\"lazy\"\n          >\n\n        </div>\n\n      </a>\n\n\n\n      <!-- ==========================================\n           CARD 04 — SHOP ALL\n      =========================================== -->\n\n      <a\n        href=\"{{ shop_all_link }}\"\n        class=\"\n          nncc__card\n          nncc__card--all\n          nncc-reveal\n        \"\n        aria-label=\"Explore all\"\n      >\n\n\n        <div\n          class=\"nncc__all-bg\"\n          aria-hidden=\"true\"\n        >\n\n          <span class=\"nncc__all-glow\"></span>\n\n          <span class=\"nncc__circle nncc__circle--1\"></span>\n\n          <span class=\"nncc__circle nncc__circle--2\"></span>\n\n        </div>\n\n\n\n        <div class=\"nncc__all-content\">\n\n          <span class=\"nncc__all-kicker\">\n          </span>\n\n\n        <strong>\n            Shop<br>\n            All\n          </strong>\n\n\n          <span class=\"nncc__all-arrow\">\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ==========================================================\n   SECTION\n========================================================== */\n\n#nn-collection-cards-{{ section.id }} {\n\n  --nncc-yellow:\n    #f2ee38;\n\n  position:\n    relative;\n\n  width:\n    100%;\n\n  overflow:\n    hidden;\n\n  isolation:\n    isolate;\n\n  padding:\n    24px 0 32px;\n\n  background:\n\n    linear-gradient(\n      180deg,\n      #16001e 0%,\n      #1b0023 50%,\n      #16001e 100%\n    );\n\n  color:\n    #fff;\n\n}\n\n\n\n/* ==========================================================\n   AMBIENT\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__ambient {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    -1;\n\n  overflow:\n    hidden;\n\n  pointer-events:\n    none;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__glow {\n\n  position:\n    absolute;\n\n  border-radius:\n    50%;\n\n  filter:\n    blur(150px);\n\n  opacity:\n    .08;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__glow--1 {\n\n  width:\n    500px;\n\n  height:\n    500px;\n\n  top:\n    -300px;\n\n  left:\n    -180px;\n\n  background:\n    #9f1dcb;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__glow--2 {\n\n  width:\n    500px;\n\n  height:\n    500px;\n\n  right:\n    -250px;\n\n  bottom:\n    -300px;\n\n  background:\n    #6213b7;\n\n}\n\n\n\n/* ==========================================================\n   CONTAINER\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__container {\n\n  width:\n    min(\n      1500px,\n      calc(100% - 64px)\n    );\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* ==========================================================\n   HEADER\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__header {\n\n  margin-bottom:\n    clamp(\n      25px,\n      3vw,\n      38px\n    );\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__header h2 {\n\n  margin:\n    0;\n\n  color:\n    #fff;\n\n  font-size:\n    clamp(\n      38px,\n      4.3vw,\n      60px\n    );\n\n  line-height:\n    .97;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__header h2 span {\n\n  color:\n    var(--nncc-yellow);\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__header p {\n\n  max-width:\n    520px;\n\n  margin:\n    13px 0 0;\n\n  color:\n    rgba(255,255,255,.52);\n\n  font-size:\n    14px;\n\n  line-height:\n    1.5;\n\n}\n\n\n\n/* ==========================================================\n   GRID\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__grid {\n\n  display:\n    grid;\n\n  grid-template-columns:\n    repeat(\n      4,\n      minmax(0,1fr)\n    );\n\n  gap:\n    clamp(\n      13px,\n      1.4vw,\n      20px\n    );\n\n}\n\n\n\n/* ==========================================================\n   CARD\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card {\n\n  position:\n    relative;\n\n  display:\n    block;\n\n  width:\n    100%;\n\n  min-width:\n    0;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    clamp(\n      20px,\n      1.7vw,\n      26px\n    );\n\n  color:\n    inherit;\n\n  text-decoration:\n    none;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  background:\n    #2a0037;\n\n  box-shadow:\n    0 18px 45px\n    rgba(0,0,0,.18);\n\n  transform:\n    translateZ(0);\n\n  transition:\n\n    transform\n    .7s\n    cubic-bezier(.16,1,.3,1),\n\n    box-shadow\n    .7s\n    cubic-bezier(.16,1,.3,1),\n\n    border-color\n    .45s ease;\n\n}\n\n\n\n/* ==========================================================\n   IMAGE CARD\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__media {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    inherit;\n\n  background:\n    #f5f5f7;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__media img {\n\n  display:\n    block;\n\n  width:\n    100%;\n\n  height:\n    100%;\n\n  object-fit:\n    cover;\n\n  object-position:\n    center;\n\n  transform:\n    scale(1.001);\n\n  transition:\n    transform\n    1s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* VERY SUBTLE EDGE */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card--image::after {\n\n  content:\n    \"\";\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    2;\n\n  pointer-events:\n    none;\n\n  border-radius:\n    inherit;\n\n  box-shadow:\n\n    inset\n    0 1px 0\n    rgba(255,255,255,.1),\n\n    inset\n    0 -1px 0\n    rgba(0,0,0,.035);\n\n}\n\n\n\n/* ==========================================================\n   SHOP ALL CARD\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card--all {\n\n  display:\n    flex;\n\n  align-items:\n    stretch;\n\n  background:\n\n    radial-gradient(\n      circle at 25% 20%,\n      rgba(147,28,191,.26),\n      transparent 47%\n    ),\n\n    linear-gradient(\n      145deg,\n      #39004b 0%,\n      #1c0026 72%,\n      #16001e 100%\n    );\n\n  border-color:\n    rgba(242,238,56,.17);\n\n}\n\n\n\n/* ==========================================================\n   SHOP ALL BACKGROUND\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-bg {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  pointer-events:\n    none;\n\n  overflow:\n    hidden;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-glow {\n\n  position:\n    absolute;\n\n  width:\n    240px;\n\n  height:\n    240px;\n\n  left:\n    -100px;\n\n  top:\n    -100px;\n\n  border-radius:\n    50%;\n\n  background:\n    var(--nncc-yellow);\n\n  opacity:\n    .055;\n\n  filter:\n    blur(60px);\n\n  transition:\n    opacity .5s ease,\n    transform .8s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* circles */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__circle {\n\n  position:\n    absolute;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(242,238,56,.08);\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__circle--1 {\n\n  width:\n    250px;\n\n  height:\n    250px;\n\n  right:\n    -150px;\n\n  top:\n    -85px;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__circle--2 {\n\n  width:\n    320px;\n\n  height:\n    320px;\n\n  right:\n    -220px;\n\n  bottom:\n    -180px;\n\n}\n\n\n\n/* ==========================================================\n   SHOP ALL CONTENT\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-content {\n\n  position:\n    relative;\n\n  z-index:\n    3;\n\n  display:\n    flex;\n\n  flex-direction:\n    column;\n\n  align-items:\n    flex-start;\n\n  justify-content:\n    flex-end;\n\n  width:\n    100%;\n\n  height:\n    100%;\n\n  padding:\n    clamp(\n      22px,\n      2.4vw,\n      34px\n    );\n\n}\n\n\n\n/* little label */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-kicker {\n\n  margin-bottom:\n    auto;\n\n  color:\n    rgba(242,238,56,.58);\n\n  font-size:\n    8px;\n\n  line-height:\n    1;\n\n  font-weight:\n    800;\n\n  letter-spacing:\n    .2em;\n\n}\n\n\n\n/* MAIN SHOP ALL */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-content strong {\n\n  color:\n    var(--nncc-yellow);\n\n  font-size:\n    clamp(\n      40px,\n      4.2vw,\n      66px\n    );\n\n  line-height:\n    .83;\n\n  font-weight:\n    750;\n\n  letter-spacing:\n    -.055em;\n\n}\n\n\n\n/* arrow */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-arrow {\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  width:\n    43px;\n\n  height:\n    43px;\n\n  margin-top:\n    23px;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(242,238,56,.26);\n\n  background:\n    rgba(242,238,56,.07);\n\n  color:\n    var(--nncc-yellow);\n\n  transition:\n\n    background\n    .45s ease,\n\n    color\n    .45s ease,\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__all-arrow svg {\n\n  width:\n    16px;\n\n  height:\n    16px;\n\n}\n\n\n\n/* ==========================================================\n   DESKTOP HOVER\n========================================================== */\n\n@media (hover:hover) {\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card:hover {\n\n    transform:\n      translateY(-6px);\n\n    border-color:\n      rgba(255,255,255,.16);\n\n    box-shadow:\n      0 28px 65px\n      rgba(0,0,0,.28);\n\n  }\n\n\n\n  /* Image zoom only */\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card--image:hover\n  img {\n\n    transform:\n      scale(1.028);\n\n  }\n\n\n\n  /* shop all */\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card--all:hover {\n\n    border-color:\n      rgba(242,238,56,.38);\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card--all:hover\n  .nncc__all-glow {\n\n    opacity:\n      .11;\n\n    transform:\n      scale(1.25);\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card--all:hover\n  .nncc__all-arrow {\n\n    background:\n      var(--nncc-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      translateX(4px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REVEAL\n========================================================== */\n\n#nn-collection-cards-{{ section.id }}\n.nncc-reveal {\n\n  opacity:\n    0;\n\n  transform:\n    translateY(18px);\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc-reveal.nncc-visible {\n\n  opacity:\n    1;\n\n  transform:\n    translateY(0);\n\n}\n\n\n/* restrained stagger */\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card:nth-child(1) {\n\n  transition-delay:\n    .03s;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card:nth-child(2) {\n\n  transition-delay:\n    .07s;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card:nth-child(3) {\n\n  transition-delay:\n    .11s;\n\n}\n\n\n#nn-collection-cards-{{ section.id }}\n.nncc__card:nth-child(4) {\n\n  transition-delay:\n    .15s;\n\n}\n\n\n\n/* ==========================================================\n   TABLET\n========================================================== */\n\n@media\n(max-width: 1000px) {\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__container {\n\n    width:\n      calc(100% - 36px);\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__grid {\n\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap:\n      14px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   MOBILE\n========================================================== */\n\n@media\n(max-width: 749px) {\n\n  #nn-collection-cards-{{ section.id }} {\n\n    padding:\n      18px 0\n      24px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n\n  /* HEADER */\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__header {\n\n    margin-bottom:\n      20px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__header h2 {\n\n    font-size:\n      clamp(\n        32px,\n        9vw,\n        42px\n      );\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__header p {\n\n    max-width:\n      330px;\n\n    margin-top:\n      10px;\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  /* TWO BY TWO */\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__grid {\n\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap:\n      10px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card {\n\n    border-radius:\n      18px;\n\n  }\n\n\n\n  /* SHOP ALL */\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-content {\n\n    padding:\n      17px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-kicker {\n\n    font-size:\n      6px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-content strong {\n\n    font-size:\n      clamp(\n        30px,\n        9vw,\n        42px\n      );\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-arrow {\n\n    width:\n      34px;\n\n    height:\n      34px;\n\n    margin-top:\n      14px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-arrow svg {\n\n    width:\n      13px;\n\n    height:\n      13px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   SMALL MOBILE\n========================================================== */\n\n@media\n(max-width: 370px) {\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__container {\n\n    width:\n      calc(100% - 20px);\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__grid {\n\n    gap:\n      8px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__card {\n\n    border-radius:\n      15px;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc__all-content {\n\n    padding:\n      14px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REDUCED MOTION\n========================================================== */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #nn-collection-cards-{{ section.id }} *,\n  #nn-collection-cards-{{ section.id }} *::before,\n  #nn-collection-cards-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #nn-collection-cards-{{ section.id }}\n  .nncc-reveal {\n\n    opacity:\n      1;\n\n    transform:\n      none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'nn-collection-cards-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n  const items =\n    section.querySelectorAll(\n      '.nncc-reveal'\n    );\n\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (\n    reducedMotion ||\n    !('IntersectionObserver' in window)\n  ) {\n\n    items.forEach(\n      function (item) {\n\n        item.classList.add(\n          'nncc-visible'\n        );\n\n      }\n    );\n\n    return;\n\n  }\n\n\n  const observer =\n    new IntersectionObserver(\n\n      function (entries) {\n\n        entries.forEach(\n          function (entry) {\n\n            if (\n              !entry.isIntersecting\n            ) {\n              return;\n            }\n\n\n            entry.target\n              .classList\n              .add(\n                'nncc-visible'\n              );\n\n\n            observer.unobserve(\n              entry.target\n            );\n\n          }\n        );\n\n      },\n\n      {\n        threshold:\n          .1,\n\n        rootMargin:\n          '0px 0px -20px 0px'\n      }\n\n    );\n\n\n  items.forEach(\n    function (item) {\n\n      observer.observe(\n        item\n      );\n\n    }\n  );\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
