bic-bezier(.16,1,.3,1);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card__arrow svg {\n\n  width: 17px;\n\n  height: 17px;\n\n  transition:\n    transform\n    .5s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =========================================================\n   DESKTOP HOVER\n========================================================= */\n\n@media (hover:hover) {\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__media {\n\n    transform:\n      translateY(-6px);\n\n    border-color:\n      rgba(255,255,255,.2);\n\n    box-shadow:\n      0 28px 65px\n      rgba(0,0,0,.31);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__media img {\n\n    transform:\n      scale(1.055);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__arrow {\n\n    background:\n      var(--sport-yellow);\n\n    border-color:\n      var(--sport-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      scale(1.05);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REVEAL\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-reveal {\n\n  opacity: 0;\n\n  transform:\n    translate3d(\n      0,\n      22px,\n      0\n    );\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-reveal.is-visible {\n\n  opacity: 1;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(1) {\n\n  transition-delay: .04s;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(2) {\n\n  transition-delay: .11s;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(3) {\n\n  transition-delay: .18s;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 32px);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    gap: 12px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 749px) {\n\n\n  #sport-premium-{{ section.id }} {\n\n    padding:\n      56px 0\n      64px;\n\n  }\n\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n\n  /* -------------------------\n     HEADER\n  ------------------------- */\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header {\n\n    width:\n      calc(100% - 10px);\n\n    margin-bottom: 27px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header h2 {\n\n    font-size:\n      clamp(\n        36px,\n        10.5vw,\n        48px\n      );\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header p {\n\n    max-width: 315px;\n\n    margin-top: 14px;\n\n    font-size: 13px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__eyebrow {\n\n    margin-bottom: 12px;\n\n    font-size: 8px;\n\n    letter-spacing: .17em;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__eyebrow-line {\n\n    width: 18px;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE GRID\n\n     ┌───────────────────────────┐\n     │         BADMINTON         │\n     └───────────────────────────┘\n\n     ┌─────────────┐ ┌─────────────┐\n     │   CRICKET   │ │ PICKLEBALL  │\n     └─────────────┘ └─────────────┘\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    display: grid;\n\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap: 10px;\n\n  }\n\n\n\n  /* =====================================================\n     BADMINTON\n     FULL WIDTH\n     HEIGHT COMES FROM ACTUAL IMAGE\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton {\n\n    grid-column:\n      1 / -1;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media {\n\n    aspect-ratio: auto;\n\n    height: auto;\n\n    min-height: 0;\n\n    border-radius: 22px;\n\n  }\n\n\n  /*\n    THIS IS THE IMPORTANT PART.\n\n    Desktop image = absolute / cover.\n    Mobile badminton image = normal document flow.\n    So the actual image ratio determines height.\n  */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media img {\n\n    position: relative;\n\n    inset: auto;\n\n    display: block;\n\n    width: 100%;\n\n    height: auto;\n\n    object-fit: contain;\n\n    transform: none;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__overlay {\n\n    position: absolute;\n\n    inset: 0;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__arrow {\n\n    right: 17px;\n\n    bottom: 17px;\n\n    width: 42px;\n\n    height: 42px;\n\n  }\n\n\n\n  /* =====================================================\n     CRICKET + PICKLEBALL\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__media,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__media {\n\n    aspect-ratio:\n      1 / 1.06;\n\n    border-radius: 19px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow {\n\n    right: 12px;\n\n    bottom: 12px;\n\n    width: 34px;\n\n    height: 34px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow svg,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow svg {\n\n    width: 14px;\n\n    height: 14px;\n\n  }\n\n\n\n  /* Disable desktop lift on touch */\n\n  #sport-premium-{{ section.id }}\n  .sport-card__media {\n\n    transform: none;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media (max-width: 360px) {\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 20px);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    gap: 8px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media {\n\n    border-radius: 20px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__media,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__media {\n\n    border-radius: 17px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow {\n\n    width: 30px;\n\n    height: 30px;\n\n    right: 10px;\n\n    bottom: 10px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   AMBIENT ANIMATION\n========================================================= */\n\n@keyframes sportGlowOne {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        65px,\n        30px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes sportGlowTwo {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -60px,\n        -30px,\n        0\n      );\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  #sport-premium-{{ section.id }} *,\n  #sport-premium-{{ section.id }} *::before,\n  #sport-premium-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-reveal {\n\n    opacity: 1;\n\n    transform: none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'sport-premium-{{ section.id }}'\n    );\n\n  if (!section) return;\n\n\n  const items =\n    section.querySelectorAll(\n      '.sport-reveal'\n    );\n\n\n  const reduceMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (reduceMotion) {\n\n    items.forEach(function (item) {\n\n      item.classList.add(\n        'is-visible'\n      );\n\n    });\n\n    return;\n\n  }\n\n\n  if (!('IntersectionObserver' in window)) {\n\n    items.forEach(function (item) {\n\n      item.classList.add(\n        'is-visible'\n      );\n\n    });\n\n    return;\n\n  }\n\n\n  const observer =\n    new IntersectionObserver(\n\n      function (entries) {\n\n        entries.forEach(\n          function (entry) {\n\n            if (!entry.isIntersecting) {\n              return;\n            }\n\n\n            entry.target\n              .classList\n              .add(\n                'is-visible'\n              );\n\n\n            observer.unobserve(\n              entry.target\n            );\n\n          }\n        );\n\n      },\n\n      {\n        threshold: 0.12,\n\n        rootMargin:\n          '0px 0px -25px 0px'\n      }\n\n    );\n\n\n  items.forEach(function (item) {\n\n    observer.observe(item);\n\n  });\n\n})();\n\n</script>",
