    "custom_liquid_FdHkfj": {
      "type": "custom-liquid",
      "custom_css": [
        ".gradient,.nn-products,.nncc {background: #16001e !important;}",
        ".nn-products__glow,.nncc__glow {display: none !important;}"
      ],
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — PREMIUM PRODUCT CAROUSEL\n  NO SCHEMA\n\n  CHANGE THESE 4 VALUES ONLY:\n{% endcomment %}\n  \n{% assign collection_handles = 'now-or-never-buy-1-get-1-badminton-rackets,now-or-never-but-1-get-1-kitbag' | split: ',' %}\n{% assign view_all_link = 'https://in.hndrd.co/collections/now-or-never-buy-1-get-1-badminton-rackets' %}\n{% assign section_heading = 'Two for one.' %}\n{% assign section_description = 'Add 2 of the same product to cart, and pay only for one! ' %}\n\n\n\n<section\n  id=\"nn-products-{{ section.id }}\"\n  class=\"nn-products\"\n>\n\n  <div class=\"nn-products__ambient\" aria-hidden=\"true\">\n    <span class=\"nn-products__glow nn-products__glow--1\"></span>\n    <span class=\"nn-products__glow nn-products__glow--2\"></span>\n  </div>\n\n\n  <div class=\"nn-products__container\">\n\n\n    <!-- HEADER -->\n    <div class=\"nn-products__header nn-reveal\">\n\n      <div class=\"nn-products__heading\">\n\n        <span class=\"nn-products__eyebrow\">\n        </span>\n\n        <h2>\n          {{ section_heading }}\n        </h2>\n\n        <p>\n          {{ section_description }}\n        </p>\n\n      </div>\n\n\n      <div class=\"nn-products__actions\">\n\n        <a\n          href=\"{{ view_all_link }}\"\n          class=\"nn-products__view\"\n        >\n          <span>View all</span>\n\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path\n              d=\"M5 12H19M14 7L19 12L14 17\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.7\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n\n        <div class=\"nn-products__nav\">\n\n          <button\n            class=\"nn-products__nav-btn nn-products__prev\"\n            type=\"button\"\n            aria-label=\"Previous products\"\n          >\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path\n                d=\"M19 12H5M10 7L5 12L10 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n          </button>\n\n\n          <button\n            class=\"nn-products__nav-btn nn-products__next\"\n            type=\"button\"\n            aria-label=\"Next products\"\n          >\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n          </button>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- CAROUSEL -->\n    <div class=\"nn-products__carousel-wrap\">\n\n      <div\n        class=\"nn-products__carousel\"\n        data-nn-carousel\n      >\n\n        {% for handle in collection_handles %}\n          {% assign current_collection = collections[handle] %}\n\n          {% if current_collection != blank %}\n            {% for product in current_collection.products limit: 5 %}\n\n              <article class=\"nn-product nn-reveal\">\n\n                <a\n                  href=\"{{ product.url }}\"\n                  class=\"nn-product__link\"\n                  aria-label=\"{{ product.title | escape }}\"\n                >\n\n                  <div class=\"nn-product__media\">\n\n                    {% if product.featured_image != blank %}\n                      <img\n                        class=\"nn-product__image\"\n                        src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                        srcset=\"\n                          {{ product.featured_image | image_url: width: 400 }} 400w,\n                          {{ product.featured_image | image_url: width: 600 }} 600w,\n                          {{ product.featured_image | image_url: width: 900 }} 900w\n                        \"\n                        sizes=\"\n                          (max-width: 749px) 76vw,\n                          (max-width: 1100px) 42vw,\n                          24vw\n                        \"\n                        alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                        loading=\"lazy\"\n                        width=\"900\"\n                        height=\"900\"\n                      >\n                    {% endif %}\n\n                    <div class=\"nn-product__shade\"></div>\n\n                    {% if product.available %}\n                      <span class=\"nn-product__badge nn-product__badge--b1g1\">\n                        B1G1\n                      </span>\n                    {% else %}\n                      <span class=\"nn-product__badge nn-product__badge--soldout\">\n                        SOLD OUT\n                      </span>\n                    {% endif %}\n\n                    <span class=\"nn-product__arrow\" aria-hidden=\"true\">\n                      <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                        <path\n                          d=\"M5 12H19M14 7L19 12L14 17\"\n                          stroke=\"currentColor\"\n                          stroke-width=\"1.7\"\n                          stroke-linecap=\"round\"\n                          stroke-linejoin=\"round\"\n                        />\n                      </svg>\n                    </span>\n\n                  </div>\n\n\n                  <div class=\"nn-product__info\">\n\n                    <h3>\n                      {{ product.title }}\n                    </h3>\n\n                    <div class=\"nn-product__price\">\n\n                      <span class=\"nn-product__price-current\">\n                        {{ product.price | money }}\n                      </span>\n\n                      {% if product.compare_at_price_max > product.price %}\n                        <span class=\"nn-product__price-old\">\n                          {{ product.compare_at_price_max | money }}\n                        </span>\n                      {% endif %}\n\n                    </div>\n\n                  </div>\n\n                </a>\n\n              </article>\n\n            {% endfor %}\n          {% endif %}\n        {% endfor %}\n\n      </div>\n\n\n\n      <div class=\"nn-products__progress\">\n        <div class=\"nn-products__progress-track\">\n          <span class=\"nn-products__progress-bar\"></span>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ==========================================================\n   SECTION\n========================================================== */\n\n#nn-products-{{ section.id }} {\n  --nn-yellow: #f2ee38;\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  isolation: isolate;\n  padding: clamp(68px, 7vw, 104px) 0 clamp(75px, 7vw, 108px);\n  background: linear-gradient(180deg, #16001e 0%, #1b0023 50%, #16001e 100%);\n  color: white;\n}\n\n\n\n/* ==========================================================\n   AMBIENT\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-products__ambient {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: -1;\n}\n\n#nn-products-{{ section.id }} .nn-products__glow {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(150px);\n  opacity: .08;\n}\n\n#nn-products-{{ section.id }} .nn-products__glow--1 {\n  width: 520px;\n  height: 520px;\n  top: -300px;\n  left: -220px;\n  background: #9f1dcb;\n}\n\n#nn-products-{{ section.id }} .nn-products__glow--2 {\n  width: 540px;\n  height: 540px;\n  right: -260px;\n  bottom: -300px;\n  background: #5d11af;\n}\n\n\n\n/* ==========================================================\n   CONTAINER\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-products__container {\n  width: min(1500px, calc(100% - 64px));\n  margin: 0 auto;\n}\n\n\n\n/* ==========================================================\n   HEADER\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-products__header {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 25px;\n  margin-bottom: clamp(30px, 4vw, 46px);\n}\n\n#nn-products-{{ section.id }} .nn-products__heading {\n  max-width: 720px;\n}\n\n#nn-products-{{ section.id }} .nn-products__eyebrow {\n  display: block;\n  margin-bottom: 12px;\n  color: var(--nn-yellow);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .2em;\n}\n\n#nn-products-{{ section.id }} .nn-products__heading h2 {\n  margin: 0;\n  font-size: clamp(39px, 4.5vw, 62px);\n  line-height: .98;\n  font-weight: 700;\n  letter-spacing: -.05em;\n}\n\n#nn-products-{{ section.id }} .nn-products__heading p {\n  margin: 14px 0 0;\n  max-width: 500px;\n  color: rgba(255,255,255,.52);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n\n\n/* ==========================================================\n   ACTIONS\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-products__actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-shrink: 0;\n}\n\n\n\n/* VIEW ALL */\n\n#nn-products-{{ section.id }} .nn-products__view {\n  min-height: 46px;\n  padding: 0 18px;\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(255,255,255,.14);\n  background: rgba(255,255,255,.04);\n  color: white;\n  text-decoration: none;\n  font-size: 12px;\n  font-weight: 600;\n  transition: .4s ease;\n}\n\n#nn-products-{{ section.id }} .nn-products__view svg {\n  width: 15px;\n  height: 15px;\n  transition: transform .4s ease;\n}\n\n@media (hover:hover) {\n  #nn-products-{{ section.id }} .nn-products__view:hover {\n    background: var(--nn-yellow);\n    border-color: var(--nn-yellow);\n    color: #211023;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__view:hover svg {\n    transform: translateX(2px);\n  }\n}\n\n\n\n/* NAVIGATION */\n\n#nn-products-{{ section.id }} .nn-products__nav {\n  display: flex;\n  gap: 7px;\n}\n\n#nn-products-{{ section.id }} .nn-products__nav-btn {\n  width: 46px;\n  height: 46px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border-radius: 50%;\n  border: 1px solid rgba(255,255,255,.14);\n  background: rgba(255,255,255,.04);\n  color: white;\n  cursor: pointer;\n  transition: .4s ease;\n}\n\n#nn-products-{{ section.id }} .nn-products__nav-btn svg {\n  width: 16px;\n  height: 16px;\n}\n\n#nn-products-{{ section.id }} .nn-products__nav-btn:disabled {\n  opacity: .25;\n  cursor: default;\n}\n\n@media (hover:hover) {\n  #nn-products-{{ section.id }} .nn-products__nav-btn:not(:disabled):hover {\n    background: var(--nn-yellow);\n    border-color: var(--nn-yellow);\n    color: #211023;\n  }\n}\n\n\n\n/* ==========================================================\n   CAROUSEL\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-products__carousel {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: calc((100% - 54px) / 4);\n  gap: 18px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  padding: 3px 2px 22px;\n  scroll-snap-type: x mandatory;\n  scroll-behavior: smooth;\n  scrollbar-width: none;\n  overscroll-behavior-inline: contain;\n}\n\n#nn-products-{{ section.id }} .nn-products__carousel::-webkit-scrollbar {\n  display: none;\n}\n\n\n\n/* ==========================================================\n   PRODUCT CARD\n========================================================== */\n\n#nn-products-{{ section.id }} .nn-product {\n  scroll-snap-align: start;\n  min-width: 0;\n}\n\n#nn-products-{{ section.id }} .nn-product__link {\n  display: block;\n  color: inherit;\n  text-decoration: none;\n}\n\n\n\n/* MEDIA */\n\n#nn-products-{{ section.id }} .nn-product__media {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  overflow: hidden;\n  border-radius: 24px;\n  background: #f4f5fa;\n  border: 1px solid rgba(255,255,255,.08);\n  box-shadow: 0 15px 40px rgba(0,0,0,.17);\n  transition:\n    transform .7s cubic-bezier(.16,1,.3,1),\n    box-shadow .7s cubic-bezier(.16,1,.3,1);\n}\n\n\n\n/* IMAGE */\n\n#nn-products-{{ section.id }} .nn-product__image {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 1s cubic-bezier(.16,1,.3,1);\n}\n\n\n\n/* SHADE */\n\n#nn-products-{{ section.id }} .nn-product__shade {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  background: linear-gradient(180deg, transparent 68%, rgba(0,0,0,.06) 100%);\n}\n\n\n\n/* BADGES */\n\n#nn-products-{{ section.id }} .nn-product__badge {\n  position: absolute;\n  z-index: 4;\n  left: 15px;\n  bottom: 15px;\n  padding: 8px 11px;\n  border-radius: 999px;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: .16em;\n  line-height: 1;\n}\n\n#nn-products-{{ section.id }} .nn-product__badge--b1g1 {\n  background: var(--nn-yellow);\n  color: #211023;\n  box-shadow: 0 8px 20px rgba(242,238,56,.2);\n}\n\n#nn-products-{{ section.id }} .nn-product__badge--soldout {\n  background: rgba(27,18,31,.9);\n  color: white;\n}\n\n\n\n/* ARROW */\n\n#nn-products-{{ section.id }} .nn-product__arrow {\n  position: absolute;\n  z-index: 4;\n  top: 14px;\n  right: 14px;\n  width: 38px;\n  height: 38px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  border: 1px solid rgba(255,255,255,.18);\n  background: rgba(92,87,106,.88);\n  color: white;\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  transition: .45s ease;\n}\n\n#nn-products-{{ section.id }} .nn-product__arrow svg {\n  width: 14px;\n  height: 14px;\n}\n\n\n\n/* INFO */\n\n#nn-products-{{ section.id }} .nn-product__info {\n  padding: 15px 4px 3px;\n}\n\n#nn-products-{{ section.id }} .nn-product__info h3 {\n  margin: 0;\n  min-height: 2.5em;\n  overflow: hidden;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  color: rgba(255,255,255,.95);\n  font-size: clamp(15px, 1.15vw, 18px);\n  line-height: 1.24;\n  font-weight: 560;\n  letter-spacing: -.02em;\n}\n\n\n\n/* PRICE */\n\n#nn-products-{{ section.id }} .nn-product__price {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 9px;\n  margin-top: 10px;\n}\n\n#nn-products-{{ section.id }} .nn-product__price-current {\n  color: white;\n  font-size: 16px;\n  font-weight: 650;\n}\n\n#nn-products-{{ section.id }} .nn-product__price-old {\n  color: rgba(255,255,255,.38);\n  font-size: 13px;\n  text-decoration: line-through;\n}\n\n\n\n/* HOVER */\n\n@media (hover:hover) {\n  #nn-products-{{ section.id }} .nn-product:hover .nn-product__media {\n    transform: translateY(-6px);\n    box-shadow: 0 28px 65px rgba(0,0,0,.28);\n  }\n\n  #nn-products-{{ section.id }} .nn-product:hover .nn-product__image {\n    transform: scale(1.035);\n  }\n\n  #nn-products-{{ section.id }} .nn-product:hover .nn-product__arrow {\n    background: var(--nn-yellow);\n    border-color: var(--nn-yellow);\n    color: #211023;\n    transform: scale(1.05);\n  }\n}\n\n\n\n/* PROGRESS */\n\n#nn-products-{{ section.id }} .nn-products__progress {\n  display: flex;\n  justify-content: center;\n  margin-top: 4px;\n}\n\n#nn-products-{{ section.id }} .nn-products__progress-track {\n  position: relative;\n  width: min(230px, 40%);\n  height: 2px;\n  overflow: hidden;\n  border-radius: 999px;\n  background: rgba(255,255,255,.1);\n}\n\n#nn-products-{{ section.id }} .nn-products__progress-bar {\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 25%;\n  border-radius: 999px;\n  background: var(--nn-yellow);\n  transform-origin: left center;\n}\n\n\n\n/* REVEAL */\n\n#nn-products-{{ section.id }} .nn-reveal {\n  opacity: 0;\n  transform: translateY(20px);\n  transition:\n    opacity .8s cubic-bezier(.16,1,.3,1),\n    transform .9s cubic-bezier(.16,1,.3,1);\n}\n\n#nn-products-{{ section.id }} .nn-reveal.nn-visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n\n\n/* TABLET */\n\n@media (max-width: 1100px) {\n  #nn-products-{{ section.id }} .nn-products__container {\n    width: calc(100% - 36px);\n  }\n\n  #nn-products-{{ section.id }} .nn-products__carousel {\n    grid-auto-columns: calc((100% - 18px) / 2.15);\n  }\n}\n\n\n\n/* MOBILE */\n\n@media (max-width: 749px) {\n\n  #nn-products-{{ section.id }} {\n    padding: 55px 0 65px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__container {\n    width: 100%;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__header {\n    width: calc(100% - 28px);\n    margin: 0 auto 25px;\n    align-items: flex-end;\n    gap: 12px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__heading h2 {\n    font-size: clamp(32px, 8.8vw, 42px);\n  }\n\n  #nn-products-{{ section.id }} .nn-products__heading p {\n    display: none;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__eyebrow {\n    font-size: 8px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__view {\n    min-height: 38px;\n    padding: 0 13px;\n    font-size: 10px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__view svg {\n    width: 12px;\n    height: 12px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__nav {\n    display: none;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__carousel {\n    grid-auto-columns: 76vw;\n    gap: 12px;\n    padding: 2px 14px 21px;\n    scroll-padding-inline: 14px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__media {\n    border-radius: 21px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__badge {\n    left: 12px;\n    bottom: 12px;\n    padding: 8px 10px;\n    font-size: 8px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__arrow {\n    top: 12px;\n    right: 12px;\n    width: 34px;\n    height: 34px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__info {\n    padding: 14px 3px 3px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__info h3 {\n    min-height: auto;\n    font-size: 16px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__price {\n    margin-top: 8px;\n  }\n\n  #nn-products-{{ section.id }} .nn-product__price-current {\n    font-size: 15px;\n  }\n\n  #nn-products-{{ section.id }} .nn-products__progress-track {\n    width: 120px;\n  }\n\n}\n\n\n\n/* REDUCED MOTION */\n\n@media (prefers-reduced-motion: reduce) {\n  #nn-products-{{ section.id }} *,\n  #nn-products-{{ section.id }} *::before,\n  #nn-products-{{ section.id }} *::after {\n    transition: none !important;\n    animation: none !important;\n    scroll-behavior: auto !important;\n  }\n\n  #nn-products-{{ section.id }} .nn-reveal {\n    opacity: 1;\n    transform: none;\n  }\n}\n#nn-products-{{ section.id }} {\n  padding: 18px 0 22px;\n}\n\n@media (max-width: 749px) {\n  #nn-products-{{ section.id }} {\n    padding: 16px 0 20px;\n  }\n}\n</style>\n\n\n\n<script>\n(function () {\n\n  const section =\n    document.getElementById(\n      'nn-products-{{ section.id }}'\n    );\n\n  if (!section) return;\n\n  const carousel =\n    section.querySelector(\n      '[data-nn-carousel]'\n    );\n\n  if (!carousel) return;\n\n  const prev =\n    section.querySelector(\n      '.nn-products__prev'\n    );\n\n  const next =\n    section.querySelector(\n      '.nn-products__next'\n    );\n\n  const progress =\n    section.querySelector(\n      '.nn-products__progress-bar'\n    );\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  function getCardStep() {\n    const card = carousel.querySelector('.nn-product');\n    if (!card) return 0;\n\n    const styles = window.getComputedStyle(carousel);\n    const gap = parseFloat(styles.gap || 0);\n\n    return card.getBoundingClientRect().width + gap;\n  }\n\n\n  if (prev) {\n    prev.addEventListener('click', function () {\n      carousel.scrollBy({\n        left: -getCardStep(),\n        behavior: reducedMotion ? 'auto' : 'smooth'\n      });\n    });\n  }\n\n\n  if (next) {\n    next.addEventListener('click', function () {\n      carousel.scrollBy({\n        left: getCardStep(),\n        behavior: reducedMotion ? 'auto' : 'smooth'\n      });\n    });\n  }\n\n\n  function updateCarousel() {\n    const max = carousel.scrollWidth - carousel.clientWidth;\n    const current = carousel.scrollLeft;\n\n    if (prev) {\n      prev.disabled = current <= 4;\n    }\n\n    if (next) {\n      next.disabled = current >= max - 4;\n    }\n\n    if (progress) {\n      if (max <= 0) {\n        progress.style.width = '100%';\n        progress.style.transform = 'translateX(0)';\n        return;\n      }\n\n      const visible = carousel.clientWidth / carousel.scrollWidth;\n      const width = Math.max(20, Math.min(100, visible * 100));\n\n      progress.style.width = width + '%';\n\n      const available = 100 - width;\n      const ratio = current / max;\n\n      progress.style.transform =\n        'translateX(' +\n        ((available / width) * ratio * 100) +\n        '%)';\n    }\n  }\n\n\n  carousel.addEventListener(\n    'scroll',\n    updateCarousel,\n    { passive: true }\n  );\n\n  window.addEventListener(\n    'resize',\n    updateCarousel\n  );\n\n  updateCarousel();\n\n\n  const revealItems =\n    section.querySelectorAll(\n      '.nn-reveal'\n    );\n\n  if (\n    !reducedMotion &&\n    'IntersectionObserver' in window\n  ) {\n    const observer = new IntersectionObserver(\n      function (entries) {\n        entries.forEach(function (entry) {\n          if (!entry.isIntersecting) return;\n          entry.target.classList.add('nn-visible');\n          observer.unobserve(entry.target);\n        });\n      },\n      {\n        threshold: .1,\n        rootMargin: '0px 0px -20px 0px'\n      }\n    );\n\n    revealItems.forEach(function (item) {\n      observer.observe(item);\n    });\n  } else {\n    revealItems.forEach(function (item) {\n      item.classList.add('nn-visible');\n    });\n  }\n\n})();\n</script>",
