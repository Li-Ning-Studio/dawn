'div');dot.className='hn-user-dot';dot.title='Your shared location';state.userMarker=new maplibregl.Marker({element:dot,anchor:'center'}).setLngLat([state.user.lon,state.user.lat]).addTo(m)}\nfunction focusNearest(){const n=state.nearest;if(!n)return;if(state.mapReady){const d=distance(n);if(d<480000){const box=new maplibregl.LngLatBounds([n.lon,n.lat],[state.user.lon,state.user.lat]);state.map.fitBounds(box,{padding:{top:125,bottom:140,left:85,right:85},maxZoom:12,duration:1000});}else state.map.flyTo({center:[n.lon,n.lat],zoom:9.6,duration:850});}else fallbackEmbed(n);}\nfunction locate(){if(!navigator.geolocation){notify('Your browser does not support location sharing. Search by ZIP instead.');return;}const buttons=[$('hn-near-button'),$('hn-map-near'),$('hn-mobile-near')];buttons.forEach(b=>b.disabled=true);notify('Requesting your location…');navigator.geolocation.getCurrentPosition(pos=>{buttons.forEach(b=>b.disabled=false);state.user={lat:pos.coords.latitude,lon:pos.coords.longitude};state.text='';state.st='all';state.active=null;state.sortNearest=true;state.reversed=false;$('hn-query').value='';updateNearest();renderList();renderDetail();updateUserDot();focusNearest();const near=[...stores].sort((a,b)=>distance(a)-distance(b)).slice(0,8);near.forEach(s=>enqueue(s,true));notify('Sorted by distance from your current position.');},err=>{buttons.forEach(b=>b.disabled=false);const msg=err.code===1?'Location permission was denied. Enable access in your browser and try again.':err.code===2?'Could not determine your location. Try again or search by ZIP.':'Location request timed out. Try again.';notify(msg);},{enableHighAccuracy:true,timeout:15000,maximumAge:60000});}\nfunction reset(){state.text='';state.st='all';state.active=null;state.user=null;state.nearest=null;state.sortNearest=false;state.reversed=false;if(state.userMarker){state.userMarker.remove();state.userMarker=null;}$('hn-query').value='';$('hn-nearest').hidden=true;renderList();renderDetail();mapFit();fallbackEmbed(null);}\nconst cacheKey='HNDRD_COORDS_V2_202610';let cached={};try{cached=JSON.parse(localStorage.getItem(cacheKey)||'{}')}catch(e){}stores.forEach(s=>{const r=cached[s.id];if(r&&Number.isFinite(r.lat)&&Number.isFinite(r.lon)){s.lat=r.lat;s.lon=r.lon;s.quality='street'}});\nlet serial=0;const work=[],pending=new Set();let busy=false;\nfunction enqueue(s,priority=false){if(s.quality==='street'||pending.has(s.id))return;pending.add(s.id);priority?work.unshift(s):work.push(s);pump()}\nfunction pump(){if(busy||!work.length)return;const s=work.shift();busy=true;getCensus(s).then(found=>{if(!found)return;const [lat,lon]=found;const cityD=metres(s.lat,s.lon,lat,lon);if(cityD>85000)return;s.lat=lat;s.lon=lon;s.quality='street';cached[s.id]={lat,lon};try{localStorage.setItem(cacheKey,JSON.stringify(cached))}catch(e){};renderList();renderDetail();updateNearest();if(state.active===s.id){fallbackEmbed(s);if(state.mapReady)state.map.easeTo({center:[s.lon,s.lat],zoom:13.5,duration:650});}}).catch(()=>{}).finally(()=>{pending.delete(s.id);setTimeout(()=>{busy=false;pump()},650)})}\nfunction getCensus(s){return new Promise((resolve,reject)=>{const callback='__hndrdCensus'+(++serial);const el=document.createElement('script');let done=false;const close=()=>{if(done)return;done=true;clearTimeout(t);delete window[callback];el.remove()};const t=setTimeout(()=>{close();reject(Error('geocoder timeout'))},11000);window[callback]=data=>{close();const arr=data?.result?.addressMatches||[];const best=arr.find(x=>String(x.addressComponents?.zip||'')===s.zip.slice(0,5))||arr[0];if(best?.coordinates){resolve([+best.coordinates.y,+best.coordinates.x])}else resolve(null)};el.onerror=()=>{close();reject(Error('geocoder unavailable'))};const q=new URLSearchParams({street:s.street,city:s.city,state:s.st,zip:s.zip.slice(0,5),benchmark:'Public_AR_Current',format:'jsonp',callback});el.src='https://geocoding.geo.census.gov/geocoder/locations/address?'+q.toString();document.head.appendChild(el)})}\nfunction useMap(){const m=state.map;if(!m)return;const onLoaded=()=>{if(state.mapReady)return;state.mapReady=true;$('hn-map').classList.add('hn-ready');$('hn-map-fallback').style.display='none';$('hn-map-status').textContent='OPENFREEMAP · INTERACTIVE';mapAddLayers();updateUserDot();mapFit()};m.once('load',onLoaded);m.on('style.load',()=>{setTimeout(()=>{if(state.mapReady)mapAddLayers()},30)});m.on('error',ev=>{if(!state.mapReady)console.warn('HNDRD map tile error:',ev.error)});setTimeout(()=>{if(!state.mapReady){$('hn-map-status').textContent='OPENSTREETMAP · INTERACTIVE';notify('Showing the OpenStreetMap fallback.')}} ,14000)}\nfunction initMap(){if(!window.maplibregl||state.map)return;try{state.map=new maplibregl.Map({container:$('hn-map'),style:'https://tiles.openfreemap.org/styles/positron',center:[-97.5,39],zoom:3.65,minZoom:2.5,maxZoom:19,dragRotate:false,pitchWithRotate:false,touchPitch:false,attributionControl:true,renderWorldCopies:false});state.map.touchZoomRotate.disableRotation();useMap()}catch(e){console.warn('HNDRD map could not initialize:',e);$('hn-map-status').textContent='OPENSTREETMAP · INTERACTIVE'}}\nfunction loadMap(){if(window.maplibregl){initMap();return}let urls=['https://cdn.jsdelivr.net/npm/maplibre-gl@5.12.0/dist/maplibre-gl.js','https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.js'];const next=()=>{const u=urls.shift();if(!u){$('hn-map-status').textContent='OPENSTREETMAP · INTERACTIVE';return}const el=document.createElement('script');el.src=u;el.async=true;el.onload=()=>window.maplibregl?initMap():next();el.onerror=next;document.head.appendChild(el)};next()}\n$('hn-query').addEventListener('input',e=>{state.text=e.target.value;state.sortNearest=false;state.active=null;renderDetail();renderList();mapFit()});$('hn-state').onchange=e=>{state.st=e.target.value;state.active=null;renderDetail();renderList();mapFit()};ROOT.querySelectorAll('.hn-chip').forEach(b=>b.onclick=()=>{state.st=b.dataset.state;state.active=null;renderDetail();renderList();mapFit()});$('hn-reset').onclick=reset;$('hn-near-button').onclick=locate;$('hn-map-near').onclick=locate;$('hn-mobile-near').onclick=locate;$('hn-nearest-view').onclick=()=>{if(state.nearest)selectStore(state.nearest.id,true)};$('hn-sort').onclick=()=>{state.sortNearest=false;state.reversed=!state.reversed;renderList()};$('hn-view-map').onclick=()=>switchMobile('map');$('hn-view-list').onclick=()=>switchMobile('list');\n$('hn-plus').onclick=()=>{if(state.mapReady)state.map.zoomIn({duration:230});else{const s=byId(state.active)||state.nearest;if(s)fallbackEmbed(s);else notify('Select a store to zoom in.')}};$('hn-minus').onclick=()=>{if(state.mapReady)state.map.zoomOut({duration:230});else fallbackEmbed(null)};$('hn-map-style').onclick=()=>{if(!state.mapReady){notify('Detailed street map is already open.');return}state.mapStyle=state.mapStyle==='positron'?'liberty':'positron';state.map.setStyle('https://tiles.openfreemap.org/styles/'+state.mapStyle);notify(state.mapStyle==='positron'?'Minimal map':'Street-detail map')};\nROOT.addEventListener('keydown',e=>{if(e.key==='/'&&!e.target.closest('input,textarea,select')){e.preventDefault();$('hn-query').focus()}});\nallOptions();renderList();renderDetail();loadMap();for(const s of stores.slice(0,3))enqueue(s,false);\n})();\n</script>",
