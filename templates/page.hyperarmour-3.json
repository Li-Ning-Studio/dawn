    "custom_liquid_UDNNKM": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"launch-wrapper\">\n\n  <div class=\"glass-card\">\n\n    <div class=\"liquid-glow glow-one\"></div>\n    <div class=\"liquid-glow glow-two\"></div>\n\n\n    <div class=\"launch-status\">\n      <span class=\"pulse-dot\"></span>\n      DROPPING SOON\n    </div>\n\n\n    <h1 class=\"launch-title\">\n      EVERY STEP<br>\n      LEADS HERE\n    </h1>\n\n\n    <p class=\"launch-subtitle\">\n      Limited pairs. One release moment. <br>Be ready when the clock hits zero.\n    </p>\n\n\n\n    <div class=\"countdown\">\n\n\n      <div class=\"time-box\">\n        <div class=\"number\" id=\"days\">00</div>\n        <div class=\"label\">DAYS</div>\n      </div>\n\n\n      <div class=\"divider\">:</div>\n\n\n      <div class=\"time-box\">\n        <div class=\"number\" id=\"hours\">00</div>\n        <div class=\"label\">HOURS</div>\n      </div>\n\n\n      <div class=\"divider\">:</div>\n\n\n      <div class=\"time-box\">\n        <div class=\"number\" id=\"minutes\">00</div>\n        <div class=\"label\">MINUTES</div>\n      </div>\n\n\n      <div class=\"divider\">:</div>\n\n\n      <div class=\"time-box\">\n        <div class=\"number\" id=\"seconds\">00</div>\n        <div class=\"label\">SECONDS</div>\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n</div>\n\n\n\n\n\n<style>\n\n*{\n  box-sizing:border-box;\n}\n\n\n.launch-wrapper{\n\n  width:100%;\n\n  padding:70px 20px;\n\n  display:flex;\n\n  justify-content:center;\n\n  align-items:center;\n\n  background:#fff;\n\n  font-family:\n  \"Helvetica Neue\",\n  Arial,\n  sans-serif;\n\n  overflow:hidden;\n\n}\n\n\n\n\n.glass-card{\n\n  position:relative;\n\n  width:min(1250px,100%);\n\n  padding:75px 60px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  text-align:center;\n\n  border-radius:45px;\n\n  background:\n\n  linear-gradient(\n    145deg,\n    rgba(255,255,255,.95),\n    rgba(230,250,248,.75)\n  );\n\n  border:1px solid rgba(0,0,0,.08);\n\n  backdrop-filter:blur(45px);\n\n  -webkit-backdrop-filter:blur(45px);\n\n  box-shadow:\n\n  0 40px 100px rgba(0,0,0,.12),\n  inset 0 1px rgba(255,255,255,.9);\n\n  overflow:hidden;\n\n}\n\n\n\n\n\n.liquid-glow{\n\n  position:absolute;\n\n  border-radius:50%;\n\n  filter:blur(30px);\n\n  animation:\n  moveGlow 8s infinite alternate ease-in-out;\n\n  pointer-events:none;\n\n}\n\n\n\n\n.glow-one{\n\n  width:420px;\n\n  height:420px;\n\n  right:-220px;\n\n  top:-220px;\n\n  background:\n\n  radial-gradient(\n    circle,\n    rgba(50,213,199,.35),\n    transparent 70%\n  );\n\n}\n\n\n\n\n\n.glow-two{\n\n  width:300px;\n\n  height:300px;\n\n  left:-150px;\n\n  bottom:-120px;\n\n  background:\n\n  radial-gradient(\n    circle,\n    rgba(50,213,199,.18),\n    transparent 70%\n  );\n\n}\n\n\n\n\n@keyframes moveGlow{\n\n  0%{\n    transform:translate(0,0) scale(1);\n  }\n\n  100%{\n    transform:translate(-40px,40px) scale(1.2);\n  }\n\n}\n\n\n\n\n\n.launch-status{\n\n  position:relative;\n\n  z-index:2;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:10px;\n\n  font-size:11px;\n\n  font-weight:700;\n\n  letter-spacing:.35em;\n\n  color:#788285;\n\n  margin-bottom:30px;\n\n}\n\n\n\n\n\n.pulse-dot{\n\n  width:8px;\n\n  height:8px;\n\n  flex:none;\n\n  border-radius:50%;\n\n  background:#32d5c7;\n\n  box-shadow:\n\n  0 0 18px #32d5c7;\n\n  animation:pulse 1.5s infinite;\n\n}\n\n\n\n\n\n@keyframes pulse{\n\n  50%{\n\n    transform:scale(1.5);\n\n    opacity:.5;\n\n  }\n\n}\n\n\n\n\n\n.launch-title{\n\n  position:relative;\n\n  z-index:2;\n\n  margin:0;\n\n  font-size:\n\n  clamp(36px,6vw,64px);\n\n  font-weight:900;\n\n  line-height:1.05;\n\n  letter-spacing:-.05em;\n\n  color:#111;\n\n}\n\n\n\n\n\n.launch-subtitle{\n\n  position:relative;\n\n  z-index:2;\n\n  margin:25px 0 0;\n\n  font-size:16px;\n\n  color:#657074;\n\n  max-width:480px;\n\n}\n\n\n\n\n\n.countdown{\n\n  position:relative;\n\n  z-index:2;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:15px;\n\n  margin-top:55px;\n\n}\n\n\n\n\n\n.time-box{\n\n  width:115px;\n\n  height:110px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n\n  border-radius:26px;\n\n  background:\n\n  linear-gradient(\n    145deg,\n    rgba(255,255,255,.9),\n    rgba(230,248,246,.8)\n  );\n\n  border:1px solid rgba(0,0,0,.08);\n\n  box-shadow:\n\n  0 20px 40px rgba(0,0,0,.1),\n  inset 0 1px white;\n\n}\n\n\n\n\n\n/* PROPER FLIP/ROLL NUMBER ANIMATION */\n/* .number is the overlap window; both digit spans are stacked\n   absolutely on top of each other inside it, so the outgoing\n   digit and the incoming digit actually cross over instead of\n   sitting side by side. */\n\n.number{\n\n  font-size:52px;\n\n  font-weight:800;\n\n  height:55px;\n\n  line-height:55px;\n\n  color:#111;\n\n  overflow:hidden;\n\n  position:relative;\n\n  width:100%;\n\n}\n\n\n\n\n\n.number span{\n\n  position:absolute;\n\n  top:0;\n\n  left:0;\n\n  width:100%;\n\n  height:100%;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  will-change:transform,opacity;\n\n  backface-visibility:hidden;\n\n}\n\n\n\n\n\n.old-number{\n\n  animation:\n  slideOut .3s cubic-bezier(.4,0,.2,1) forwards;\n\n}\n\n\n\n\n\n.new-number{\n\n  animation:\n  slideIn .3s cubic-bezier(.4,0,.2,1) forwards;\n\n}\n\n\n\n\n\n@keyframes slideOut{\n\n  0%{\n\n    transform:translateY(0);\n\n    opacity:1;\n\n  }\n\n  100%{\n\n    transform:translateY(-100%);\n\n    opacity:0;\n\n  }\n\n}\n\n\n\n\n\n@keyframes slideIn{\n\n  0%{\n\n    transform:translateY(100%);\n\n    opacity:0;\n\n  }\n\n  100%{\n\n    transform:translateY(0);\n\n    opacity:1;\n\n  }\n\n}\n\n\n\n\n\n.label{\n\n  margin-top:10px;\n\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.25em;\n\n  color:#8b9598;\n\n}\n\n\n\n\n\n.divider{\n\n  font-size:38px;\n\n  font-weight:500;\n\n  color:#32d5c7;\n\n}\n\n\n\n\n\n/*\n==================================================\nMOBILE\n==================================================\n*/\n\n@media(max-width:700px){\n\n  .launch-wrapper{\n\n    padding:35px 8px;\n\n  }\n\n\n\n  .glass-card{\n\n    width:100%;\n\n    padding:58px 16px;\n\n    border-radius:38px;\n\n  }\n\n\n\n  .launch-status{\n\n    font-size:9px;\n\n    margin-bottom:25px;\n\n  }\n\n\n\n  .launch-title{\n\n    font-size:32px;\n\n  }\n\n\n\n  .launch-subtitle{\n\n    font-size:14px;\n\n  }\n\n\n\n  .countdown{\n\n    gap:6px;\n\n    margin-top:45px;\n\n    width:100%;\n\n  }\n\n\n\n  .time-box{\n\n    height:92px;\n\n    width:73px;\n\n    border-radius:21px;\n\n  }\n\n\n\n  .number{\n\n    font-size:29px;\n\n    height:38px;\n\n    line-height:38px;\n\n  }\n\n\n\n  .divider{\n\n    font-size:25px;\n\n  }\n\n\n\n  .label{\n\n    font-size:6px;\n\n    letter-spacing:.18em;\n\n  }\n\n}\n\n\n\n\n\n@media(max-width:380px){\n\n  .time-box{\n\n    width:65px;\n\n    height:87px;\n\n  }\n\n\n\n  .number{\n\n    font-size:26px;\n\n    height:35px;\n\n    line-height:35px;\n\n  }\n\n\n\n  .divider{\n\n    font-size:23px;\n\n  }\n\n}\n\n\n\n\n\n</style>\n\n\n\n\n\n<script>\n\n(function(){\n\n  // Set this to your actual shoe drop date/time.\n  const launchDate =\n    new Date(\"2026-09-05T12:00:00+05:30\").getTime();\n\n  const ANIM_MS = 300;\n\n\n\n  function updateTimer(){\n\n    let distance =\n      launchDate - Date.now();\n\n\n\n    if(distance < 0){\n\n      distance = 0;\n\n    }\n\n\n\n    const days =\n      Math.floor(\n        distance /\n        (1000 * 60 * 60 * 24)\n      );\n\n\n\n    const hours =\n      Math.floor(\n        (distance %\n        (1000 * 60 * 60 * 24))\n        /\n        (1000 * 60 * 60)\n      );\n\n\n\n    const minutes =\n      Math.floor(\n        (distance %\n        (1000 * 60 * 60))\n        /\n        (1000 * 60)\n      );\n\n\n\n    const seconds =\n      Math.floor(\n        (distance %\n        (1000 * 60))\n        /\n        1000\n      );\n\n\n\n    change(\"days\",days);\n\n    change(\"hours\",hours);\n\n    change(\"minutes\",minutes);\n\n    change(\"seconds\",seconds);\n\n  }\n\n\n\n  function change(id,value){\n\n    const element =\n      document.getElementById(id);\n\n\n\n    const formatted =\n      String(value).padStart(2,\"0\");\n\n\n\n    if(element.dataset.value !== formatted){\n\n      const oldValue =\n        element.dataset.value || formatted;\n\n\n\n      element.dataset.value = formatted;\n\n\n\n      element.innerHTML = `\n\n        <span class=\"old-number\">${oldValue}</span>\n\n        <span class=\"new-number\">${formatted}</span>\n\n      `;\n\n\n\n      setTimeout(()=>{\n\n        element.innerHTML = formatted;\n\n      },ANIM_MS);\n\n    }\n\n  }\n\n\n\n  updateTimer();\n\n  setInterval(updateTimer,1000);\n\n})();\n\n</script>",
