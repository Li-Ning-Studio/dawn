      "settings": {
        "custom_liquid": "<div class=\"product-section\">\n\n  <div class=\"product-grid\">\n\n    <a class=\"product-card\" href=\"#\">\n      <div class=\"scratch-surface\" aria-hidden=\"true\"></div>\n      <div class=\"product-info\">\n        <span class=\"product-name\">Hyperarmour</span>\n        <span class=\"product-meta\">3 colors &bull; Badminton Shoe</span>\n      </div>\n    </a>\n\n    <a class=\"product-card\" href=\"#\">\n      <div class=\"scratch-surface\" aria-hidden=\"true\"></div>\n      <div class=\"product-info\">\n        <span class=\"product-name\">Hyperarmour</span>\n        <span class=\"product-meta\">3 colors &bull; Badminton Shoe</span>\n      </div>\n    </a>\n\n    <a class=\"product-card\" href=\"#\">\n      <div class=\"scratch-surface\" aria-hidden=\"true\"></div>\n      <div class=\"product-info\">\n        <span class=\"product-name\">Hyperarmour</span>\n        <span class=\"product-meta\">3 colors &bull; Badminton Shoe</span>\n      </div>\n    </a>\n\n  </div>\n\n</div>\n\n\n<style>\n\n*{\n  box-sizing:border-box;\n}\n\n\n.product-section{\n\n  width:100%;\n\n  padding:60px 20px;\n\n  background:#fff;\n\n  font-family:\n  \"Helvetica Neue\",\n  Arial,\n  sans-serif;\n\n}\n\n\n\n\n.product-grid{\n\n  max-width:1250px;\n\n  margin:0 auto;\n\n  display:grid;\n\n  grid-template-columns:\n  repeat(auto-fill,minmax(240px,1fr));\n\n  gap:20px;\n\n}\n\n\n\n\n\n.product-card{\n\n  display:flex;\n\n  flex-direction:column;\n\n  background:#fff;\n\n  text-decoration:none;\n\n  color:inherit;\n\n  border:1px solid #ececec;\n\n  border-radius:14px;\n\n  overflow:hidden;\n\n}\n\n\n\n\n/*\n==================================================\nSCRATCH-CARD SURFACE\nStatic foil look, standing in for a hidden product\nphoto. Purely decorative — no scratch interaction,\nno reveal-on-hover, no JS attached.\n==================================================\n*/\n\n.scratch-surface{\n\n  position:relative;\n\n  width:100%;\n\n  aspect-ratio:1/1;\n\n  overflow:hidden;\n\n  background:\n\n  linear-gradient(\n    135deg,\n    #e3e6e9 0%,\n    #c2c6cc 24%,\n    #eef0f2 48%,\n    #b7bbc1 72%,\n    #dee1e4 100%\n  );\n\n}\n\n\n\n\n\n.scratch-surface::before{\n\n  /* fine foil weave */\n\n  content:\"\";\n\n  position:absolute;\n\n  inset:0;\n\n  background:\n\n  repeating-linear-gradient(\n    135deg,\n    rgba(255,255,255,.35) 0 1.5px,\n    rgba(255,255,255,0) 1.5px 5px\n  );\n\n}\n\n\n\n\n\n.scratch-surface::after{\n\n  /* slow light sweep across the foil */\n\n  content:\"\";\n\n  position:absolute;\n\n  top:-60%;\n\n  left:-60%;\n\n  width:220%;\n\n  height:220%;\n\n  background:\n\n  linear-gradient(\n    115deg,\n    transparent 42%,\n    rgba(255,255,255,.55) 50%,\n    transparent 58%\n  );\n\n  animation:foilShine 6s ease-in-out infinite;\n\n}\n\n\n\n\n\n@keyframes foilShine{\n\n  0%{\n\n    transform:translate(-8%,-8%);\n\n  }\n\n  50%{\n\n    transform:translate(8%,8%);\n\n  }\n\n  100%{\n\n    transform:translate(-8%,-8%);\n\n  }\n\n}\n\n\n\n\n\n@media(prefers-reduced-motion:reduce){\n\n  .scratch-surface::after{\n\n    animation:none;\n\n  }\n\n}\n\n\n\n\n\n.product-info{\n\n  padding:20px 22px 26px;\n\n  display:flex;\n\n  flex-direction:column;\n\n}\n\n\n\n\n\n.product-name{\n\n  font-size:15px;\n\n  font-weight:500;\n\n  color:#111;\n\n  text-decoration:underline;\n\n  text-underline-offset:2px;\n\n}\n\n\n\n\n\n.product-meta{\n\n  margin-top:6px;\n\n  font-size:13px;\n\n  color:#6b7280;\n\n}\n\n\n\n\n\n\n/*\n==================================================\nMOBILE\n==================================================\n*/\n\n@media(max-width:700px){\n\n  .product-section{\n\n    padding:35px 0;\n\n  }\n\n\n\n  .product-grid{\n\n    display:flex;\n\n    gap:14px;\n\n    overflow-x:auto;\n\n    scroll-snap-type:x mandatory;\n\n    -webkit-overflow-scrolling:touch;\n\n    padding:0 20px 6px;\n\n    scrollbar-width:none;\n\n  }\n\n\n\n  .product-grid::-webkit-scrollbar{\n\n    display:none;\n\n  }\n\n\n\n  .product-card{\n\n    flex:0 0 68%;\n\n    scroll-snap-align:start;\n\n  }\n\n\n\n  .product-info{\n\n    padding:16px 16px 20px;\n\n  }\n\n\n\n  .product-name{\n\n    font-size:14px;\n\n  }\n\n\n\n  .product-meta{\n\n    font-size:12px;\n\n  }\n\n}\n\n\n</style>",
