        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Club Hundred Hero</title>\n  <style>\n    .ch-hero-section {\n      background-color: #ffffff;\n      padding: 80px 20px 0 20px;\n      box-sizing: border-box;\n    }\n\n    .ch-hero-container {\n      max-width: 1400px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 80px;\n      align-items: center;\n    }\n\n    .ch-hero-content {\n      display: flex;\n      flex-direction: column;\n      gap: 40px;\n    }\n\n    .ch-hero-logo {\n      max-width: 450px;\n      width: 100%;\n      height: auto;\n      display: block;\n    }\n\n    .ch-hero-text {\n      font-size: 18px;\n      line-height: 1.8;\n      color: #666666;\n      max-width: 550px;\n      font-weight: 700;\n    }\n\n    .ch-hero-text p {\n      margin: 0 0 20px 0;\n      font-weight: 700;\n    }\n\n    .ch-hero-text p:last-child {\n      margin-bottom: 0;\n    }\n\n    .ch-hero-image-wrapper {\n      position: relative;\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 10px;\n      perspective: 1000px;\n    }\n\n    .ch-hero-card-inner {\n      position: relative;\n      width: 100%;\n      max-width: 600px;\n      transition: transform 0.6s;\n      transform-style: preserve-3d;\n      cursor: pointer;\n    }\n\n    .ch-hero-card-inner.flipped {\n      transform: rotateY(180deg);\n    }\n\n    .ch-hero-card-front,\n    .ch-hero-card-back {\n      width: 100%;\n      backface-visibility: hidden;\n      -webkit-backface-visibility: hidden;\n    }\n\n    .ch-hero-card-back {\n      position: absolute;\n      top: 0;\n      left: 0;\n      transform: rotateY(180deg);\n    }\n\n    .ch-hero-athlete-image {\n      width: 100%;\n      height: auto;\n      object-fit: cover;\n      display: block;\n    }\n\n    .ch-hero-card-front .ch-hero-athlete-image {\n      filter: grayscale(100%);\n    }\n\n    .ch-hero-athlete-name {\n      font-size: 15px;\n      font-weight: 600;\n      color: #000000;\n      margin: 0;\n      text-align: center;\n    }\n\n    .ch-hero-athlete-flag {\n      font-size: 14px;\n      text-align: center;\n    }\n\n\n\n    @media screen and (max-width: 989px) {\n      .ch-hero-section {\n        padding: 60px 20px 0 20px;\n      }\n\n      .ch-hero-container {\n        grid-template-columns: 1fr;\n        gap: 50px;\n      }\n\n      .ch-hero-content {\n        order: 1;\n        align-items: center;\n        text-align: center;\n      }\n\n      .ch-hero-logo {\n        max-width: 280px;\n      }\n\n      .ch-hero-text {\n        max-width: 100%;\n        font-size: 16px;\n        line-height: 1.6;\n      }\n\n      .ch-hero-image-wrapper {\n        order: 2;\n      }\n\n      .ch-hero-athlete-name {\n        font-size: 15px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"ch-hero-section\">\n    <div class=\"ch-hero-container\">\n      \n      <!-- Left Side: Logo & Content -->\n      <div class=\"ch-hero-content\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0742/6336/3817/files/club_hundred_logo.png?v=1759896855\" \n          alt=\"Club Hundred Logo\"\n          class=\"ch-hero-logo\"\n        >\n        \n        <div class=\"ch-hero-text\">\n          <p>At Club Hundred, we stand beside our athletes through every triumph and setback. They carry more than our brand—they carry our belief, our passion, and our commitment to their dreams. Together, we're inspiring a generation to believe in the extraordinary.</p>\n        </div>\n      </div>\n\n      <!-- Right Side: Featured Athlete -->\n      <div class=\"ch-hero-image-wrapper\">\n        <div class=\"ch-hero-card-inner\" onclick=\"this.classList.toggle('flipped')\">\n          <div class=\"ch-hero-card-front\">\n            <img \n              src=\"https://cdn.shopify.com/s/files/1/0742/6336/3817/files/1_d40a3eb3-0b9c-468c-af73-b15c15d9dec4.png?v=1759896956\" \n              alt=\"Srikanth Kidambi\"\n              class=\"ch-hero-athlete-image\"\n            >\n          </div>\n          <div class=\"ch-hero-card-back\">\n            <img \n              src=\"https://cdn.shopify.com/s/files/1/0742/6336/3817/files/2.png?v=1759898348\" \n              alt=\"Srikanth Kidambi Color\"\n              class=\"ch-hero-athlete-image\"\n            >\n          </div>\n        </div>\n        <h3 class=\"ch-hero-athlete-name\">Srikanth Kidambi</h3>\n        <div class=\"ch-hero-athlete-flag\">🇮🇳</div>\n      </div>\n\n    </div>\n  </div>\n\n</body>\n</html>",
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "padding_bottom": 0
      }
