        },
        "big_line_3niaaW": {
          "type": "big_line",
          "settings": {
            "text": "It didn't take long to see the potential."
          }
        },
        "text_q8DLbr": {
          "type": "text",
          "settings": {
            "text": "<p>The products were there. The identity was there. And most importantly, the ambition between both sides was aligned.</p>",
            "style": "normal"
