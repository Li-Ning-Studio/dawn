        "think_big_BFn9De": {
          "type": "think_big",
          "settings": {
            "line_1": "Think big.",
            "line_2": "Build different.",
            "lead": "Becoming a global sports brand doesn't happen by following everyone else.",
            "text": "<p>HUNDRED set out to challenge conventions – through product innovation, bold design, athlete partnerships and a closer connection to the communities that actually play the game.</p>",
            "foundation_title": "Badminton became the",
            "foundation_highlight": "foundation.",
            "foundation_text": "<p>From there, HUNDRED began expanding across markets, signing international athletes and building a presence far beyond its origins.</p>"
