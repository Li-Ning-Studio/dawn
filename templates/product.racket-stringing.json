        "custom_liquid_MnaH6D": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  HUNDRED – Andre farver (automatisk ud fra varenummer)\n  Varenumre: MODEL-FARVE-STØRRELSE, fx HBFS-5M243-5-7  → model HBFS-5M243, farve 5.\n  Produkter med samme model (de to første dele af varenummeret) vises som farver.\n  Søger i de kollektioner, produktet ligger i. Er metafeltet custom.other_colours\n  udfyldt, bruges det i stedet.\n{%- endcomment -%}\n{%- liquid\n  assign hcol_list = product.metafields.custom.other_colours.value\n  assign hcol_ids = '|' | append: product.id | append: '|'\n  assign hcol_html = ''\n\n  if hcol_list == blank\n    assign hcol_sku = product.variants.first.sku | split: '-'\n    if hcol_sku.size >= 3\n      assign hcol_key = hcol_sku[0] | append: '-' | append: hcol_sku[1] | append: '-'\n      for c in product.collections\n        for p in c.products\n          assign pid = '|' | append: p.id | append: '|'\n          if hcol_ids contains pid\n            continue\n          endif\n          assign psku = p.variants.first.sku | default: ''\n          assign pstart = psku | slice: 0, hcol_key.size\n          if pstart == hcol_key\n            assign hcol_ids = hcol_ids | append: p.id | append: '|'\n          endif\n        endfor\n      endfor\n    endif\n  endif\n-%}\n\n{%- capture hcol_items -%}\n  {%- if hcol_list != blank -%}\n    {%- for p in hcol_list -%}\n      {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}\n      <a href=\"{{ p.url }}\" title=\"{{ p.title | escape }}\"{% unless p.available %} class=\"is-out\"{% endunless %}>{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</a>\n    {%- endfor -%}\n  {%- else -%}\n    {%- assign hcol_done = '|' | append: product.id | append: '|' -%}\n    {%- for c in product.collections -%}\n      {%- for p in c.products -%}\n        {%- assign pid = '|' | append: p.id | append: '|' -%}\n        {%- if hcol_ids contains pid -%}\n          {%- unless hcol_done contains pid -%}\n            {%- assign hcol_done = hcol_done | append: p.id | append: '|' -%}\n            <a href=\"{{ p.url }}\" title=\"{{ p.title | escape }}\"{% unless p.available %} class=\"is-out\"{% endunless %}>{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</a>\n          {%- endunless -%}\n        {%- endif -%}\n      {%- endfor -%}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endcapture -%}\n\n{%- if hcol_items != blank -%}\n<style>\n  .hcol{display:grid;gap:12px;margin:18px 0 6px;font-family:\"Barlow\",\"Helvetica Neue\",Arial,sans-serif}\n  .hcol-lbl{display:flex;justify-content:space-between;gap:12px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#0a0a0b}\n  .hcol-lbl span{letter-spacing:.04em;text-transform:none;font-weight:600;color:#8c867b}\n  .hcol-row{display:flex;flex-wrap:wrap;gap:10px}\n  .hcol a{width:72px;aspect-ratio:1;border-radius:8px;background:#f5f3ef;border:1px solid #e7e3dc;display:grid;place-items:center;overflow:hidden;transition:border-color .15s}\n  .hcol a:hover{border-color:#0a0a0b}\n  .hcol a[aria-current=\"true\"]{outline:2px solid #0a0a0b;outline-offset:2px;border-color:transparent}\n  .hcol a.is-out{opacity:.45}\n  .hcol img{width:88%;height:88%;object-fit:contain;mix-blend-mode:multiply}\n  .hcol a:focus-visible{outline:2px solid #0a0a0b;outline-offset:3px}\n</style>\n<div class=\"hcol\">\n  <div class=\"hcol-lbl\">Colour {%- assign hcol_name = product.title | remove: ' Unisex' | remove: ' Women' | remove: ' Men' | split: ' ' | last -%}<span>{{ product.metafields.custom.colour_name | default: hcol_name | escape }}</span></div>\n  <div class=\"hcol-row\">\n    <a href=\"{{ product.url }}\" aria-current=\"true\" title=\"{{ product.title | escape }}\">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}</a>\n    {{ hcol_items }}\n  </div>\n</div>\n{%- endif -%}"
