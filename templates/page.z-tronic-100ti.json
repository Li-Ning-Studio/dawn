      "settings": {
        "custom_liquid": "<section class=\"zt-final\">\n\n  <div class=\"zt-final__glow\"></div>\n\n  <div class=\"zt-final__inner\">\n\n    <p class=\"zt-final__kicker\">\n      Z-TRONIC 100 TI\n    </p>\n\n    <h2 class=\"zt-final__title\">\n      <span>Chế tạo để bùng nổ.</span>\n      <span> Thiết kế để phục hồi.</span>\n    </h2>\n\n    <p class=\"zt-final__description\">\n      Độ uốn dẻo nhanh. Khả năng phục hồi nhờ titan. Sức mạnh được tái tạo cho đợt tấn công tiếp theo.\n    </p>\n\n    <a\n      href=\"/products/z-tronic-100-ti\"\n      class=\"zt-final__button\"\n    >\n      KHÁM PHÁ Z-TRONIC 100 TI\n    </a>\n\n  </div>\n\n</section>\n\n\n<style>\n\n  .zt-final,\n  .zt-final * {\n    box-sizing: border-box;\n  }\n\n\n  /* =========================\n     SECTION\n  ========================= */\n\n  .zt-final {\n    position: relative;\n\n    width: 100%;\n    overflow: hidden;\n\n    padding: 92px 24px 98px;\n\n    background: #0D0D0D;\n\n    text-align: center;\n\n    font-family: \"Figtree\", sans-serif;\n  }\n\n\n  /* =========================\n     SUBTLE TITANIUM GLOW\n  ========================= */\n\n  .zt-final__glow {\n    position: absolute;\n\n    left: 50%;\n    bottom: -280px;\n\n    width: 1050px;\n    height: 470px;\n\n    transform: translateX(-50%);\n\n    background: radial-gradient(\n      ellipse at center,\n      rgba(124,120,114,.13) 0%,\n      rgba(90,85,79,.07) 30%,\n      rgba(55,50,44,.035) 50%,\n      rgba(13,13,13,0) 72%\n    );\n\n    pointer-events: none;\n  }\n\n\n  /* =========================\n     CONTENT\n  ========================= */\n\n  .zt-final__inner {\n    position: relative;\n    z-index: 2;\n\n    width: 100%;\n    max-width: 1200px;\n\n    margin: 0 auto;\n  }\n\n\n  /* =========================\n     KICKER\n  ========================= */\n\n  .zt-final__kicker {\n    margin: 0 0 20px;\n\n    color: #77736E;\n\n    font-size: 13px;\n    line-height: 1;\n\n    font-weight: 700;\n\n    letter-spacing: .18em;\n\n    text-transform: uppercase;\n  }\n\n\n  /* =========================\n     MAIN HEADLINE\n  ========================= */\n\n  .zt-final__title {\n    width: 100%;\n\n    margin: 0 auto;\n\n    font-size: clamp(50px, 5.3vw, 90px);\n\n    line-height: .91;\n\n    font-weight: 700;\n\n    letter-spacing: -4.5px;\n\n    text-transform: uppercase;\n  }\n\n\n  .zt-final__title span {\n    display: block;\n\n    /* KEEP EACH PHRASE ON ONE LINE */\n    white-space: nowrap;\n\n    background: linear-gradient(\n      180deg,\n      #7C7872 50%,\n      #37322C 100%\n    );\n\n    -webkit-background-clip: text;\n    background-clip: text;\n\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n\n\n  .zt-final__title span + span {\n    margin-top: 7px;\n\n    opacity: .82;\n  }\n\n\n  /* =========================\n     DESCRIPTION\n  ========================= */\n\n  .zt-final__description {\n    max-width: 650px;\n\n    margin: 27px auto 0;\n\n    color: #A6A39F;\n\n    font-size: 18px;\n\n    line-height: 1.5;\n\n    font-weight: 500;\n\n    letter-spacing: -.15px;\n  }\n\n\n  /* =========================\n     CTA\n  ========================= */\n\n  .zt-final__button {\n    display: inline-flex;\n\n    align-items: center;\n    justify-content: center;\n\n    margin-top: 37px;\n\n    min-width: 310px;\n    min-height: 60px;\n\n    padding: 0 38px;\n\n    border: 1.5px solid #7C7872;\n    border-radius: 999px;\n\n    background: transparent !important;\n    background-image: none !important;\n\n    color: #FFFFFF;\n\n    font-size: 12px;\n\n    line-height: 1;\n\n    font-weight: 700;\n\n    letter-spacing: .15em;\n\n    text-transform: uppercase;\n\n    text-decoration: none;\n\n    transition:\n      transform .3s ease,\n      border-color .3s ease,\n      color .3s ease;\n  }\n\n\n  /* CTA STAYS TRANSPARENT */\n\n  .zt-final__button:hover {\n    background: transparent !important;\n    background-image: none !important;\n\n    border-color: #7C7872;\n\n    color: #FFFFFF;\n\n    transform: translateY(-2px);\n  }\n\n\n  .zt-final__button:focus,\n  .zt-final__button:active {\n    background: transparent !important;\n    background-image: none !important;\n\n    border-color: #7C7872;\n\n    color: #FFFFFF;\n  }\n\n\n  .zt-final__button::before,\n  .zt-final__button::after {\n    display: none !important;\n    content: none !important;\n  }\n\n\n  /* =========================\n     TABLET\n  ========================= */\n\n  @media screen and (max-width: 990px) {\n\n    .zt-final {\n      padding: 78px 20px 84px;\n    }\n\n    .zt-final__title {\n      font-size: clamp(50px, 7vw, 70px);\n\n      letter-spacing: -3px;\n    }\n\n    .zt-final__description {\n      font-size: 17px;\n    }\n\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    .zt-final {\n      padding: 64px 14px 70px;\n    }\n\n\n    .zt-final__kicker {\n      margin-bottom: 17px;\n\n      font-size: 10px;\n\n      letter-spacing: .17em;\n    }\n\n\n    .zt-final__title {\n      width: 100%;\n      max-width: none;\n\n      /*\n        SCALED TO KEEP BOTH\n        PHRASES ON ONE LINE\n      */\n\n      font-size: clamp(34px, 9.8vw, 46px);\n\n      line-height: .95;\n\n      letter-spacing: -2px;\n    }\n\n\n    .zt-final__title span {\n      display: block;\n\n      white-space: nowrap;\n    }\n\n\n    .zt-final__title span + span {\n      margin-top: 7px;\n    }\n\n\n    .zt-final__description {\n      max-width: 340px;\n\n      margin: 23px auto 0;\n\n      font-size: 15px;\n\n      line-height: 1.5;\n    }\n\n\n    .zt-final__button {\n      margin-top: 30px;\n\n      min-width: 270px;\n      min-height: 55px;\n\n      padding: 0 28px;\n\n      font-size: 11px;\n\n      letter-spacing: .12em;\n    }\n\n\n    .zt-final__glow {\n      bottom: -190px;\n\n      width: 580px;\n      height: 330px;\n    }\n\n  }\n\n\n  /* =========================\n     SMALL MOBILE\n  ========================= */\n\n  @media screen and (max-width: 390px) {\n\n    .zt-final {\n      padding: 58px 10px 64px;\n    }\n\n\n    .zt-final__title {\n      width: 100%;\n      max-width: none;\n\n      font-size: 9.2vw;\n\n      line-height: .95;\n\n      letter-spacing: -1.5px;\n    }\n\n\n    .zt-final__title span {\n      white-space: nowrap;\n    }\n\n\n    .zt-final__description {\n      max-width: 315px;\n\n      font-size: 14px;\n    }\n\n\n    .zt-final__button {\n      min-width: 250px;\n\n      min-height: 53px;\n\n      padding: 0 24px;\n\n      font-size: 10px;\n    }\n\n  }\n\n</style>",
