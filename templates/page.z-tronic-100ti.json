form: translateY(-2px);\n  }\n\n\n  .zt-final__button:focus,\n  .zt-final__button:active {\n    background: transparent !important;\n    background-image: none !important;\n\n    border-color: #7C7872;\n\n    color: #FFFFFF;\n  }\n\n\n  .zt-final__button::before,\n  .zt-final__button::after {\n    display: none !important;\n    content: none !important;\n  }\n\n\n  /* =========================\n     TABLET\n  ========================= */\n\n  @media screen and (max-width: 990px) {\n\n    .zt-final {\n      padding: 78px 20px 84px;\n    }\n\n    .zt-final__title {\n      font-size: clamp(50px, 7vw, 70px);\n\n      letter-spacing: -3px;\n    }\n\n    .zt-final__description {\n      font-size: 17px;\n    }\n\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    .zt-final {\n      padding: 64px 14px 70px;\n    }\n\n\n    .zt-final__kicker {\n      margin-bottom: 17px;\n\n      font-size: 10px;\n\n      letter-spacing: .17em;\n    }\n\n\n    .zt-final__title {\n      width: 100%;\n      max-width: none;\n\n      /*\n        SCALED TO KEEP BOTH\n        PHRASES ON ONE LINE\n      */\n\n      font-size: clamp(34px, 9.8vw, 46px);\n\n      line-height: .95;\n\n      letter-spacing: -2px;\n    }\n\n\n    .zt-final__title span {\n      display: block;\n\n      white-space: nowrap;\n    }\n\n\n    .zt-final__title span + span {\n      margin-top: 7px;\n    }\n\n\n    .zt-final__description {\n      max-width: 340px;\n\n      margin: 23px auto 0;\n\n      font-size: 15px;\n\n      line-height: 1.5;\n    }\n\n\n    .zt-final__button {\n      margin-top: 30px;\n\n      min-width: 270px;\n      min-height: 55px;\n\n      padding: 0 28px;\n\n      font-size: 11px;\n\n      letter-spacing: .12em;\n    }\n\n\n    .zt-final__glow {\n      bottom: -190px;\n\n      width: 580px;\n      height: 330px;\n    }\n\n  }\n\n\n  /* =========================\n     SMALL MOBILE\n  ========================= */\n\n  @