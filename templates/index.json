    "custom_liquid_yLVFUK": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"spotlight\">\n  <div class=\"spotlight-container\">\n\n    <div class=\"spotlight-head\">\n      <h2 class=\"spotlight-title\">Best Sellers</h2>\n\n      <p class=\"spotlight-subtitle\">\n        The most popular picks across rackets, shoes, bags, apparel, and accessories.\n        <b>Loved by players everywhere.</b>\n      </p>\n    </div>\n\n    <div class=\"spotlight-grid\">\n\n      <a class=\"spotlight-item\" href=\"/collections/best-selling-rackets\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/1-7.jpg?v=1772877984&width=1000\"\n            alt=\"Badminton rackets\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Rackets</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n\n      <a class=\"spotlight-item\" href=\"/collections/best-selling-shoes\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/Template-01_6d3c9bd5-61b6-4767-a1fc-5ff451f51e6a.jpg?v=1772878262&width=1000\"\n            alt=\"Badminton shoes\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Shoes</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n\n      <a class=\"spotlight-item\" href=\"/collections/best-selling-kit-bags\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/Template_02.jpg?v=1772878259&width=1000\"\n            alt=\"Badminton kitbags\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Kitbags</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n\n      <a class=\"spotlight-item\" href=\"/collections/backpacks\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://in.lining.studio/cdn/shop/files/Template_01_cf56ccc791.jpg?v=1749900031&width=1600\"\n            alt=\"Backpacks\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Backpacks</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n\n      <a class=\"spotlight-item\" href=\"/collections/apparels\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://in.lining.studio/cdn/shop/files/1_5b9d2aa3-c709-4811-8150-9119b330a67c.jpg?v=1752900767&width=1600\"\n            alt=\"Badminton apparel\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Apparels</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n\n      <a class=\"spotlight-item\" href=\"/collections/accessories\">\n        <div class=\"spotlight-image-wrap\">\n          <img\n            src=\"https://in.lining.studio/cdn/shop/files/01_e94e005a0f.jpg?v=1749896398&width=1600\"\n            alt=\"Badminton accessories\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"spotlight-label\">\n          <span>Accessories</span>\n          <span class=\"spotlight-arrow\">→</span>\n        </div>\n      </a>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n\n  /* ================================\n     BEST SELLERS\n  ================================== */\n\n  .spotlight {\n    width: 100%;\n    padding: 70px 30px 80px;\n    background: #ffffff;\n    box-sizing: border-box;\n  }\n\n  .spotlight *,\n  .spotlight *::before,\n  .spotlight *::after {\n    box-sizing: border-box;\n  }\n\n\n  /* Container */\n\n  .spotlight-container {\n    width: 100%;\n    max-width: 1450px;\n    margin: 0 auto;\n  }\n\n\n  /* Heading */\n\n  .spotlight-head {\n    text-align: center;\n    margin-bottom: 46px;\n  }\n\n  .spotlight-title {\n    margin: 0 0 12px;\n    color: #111111;\n    font-size: clamp(36px, 4vw, 54px);\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: -1.8px;\n  }\n\n  .spotlight-subtitle {\n    max-width: 650px;\n    margin: 0 auto;\n    color: #646464;\n    font-size: 15px;\n    line-height: 1.6;\n  }\n\n  .spotlight-subtitle b {\n    color: #242424;\n    font-weight: 600;\n  }\n\n\n  /* ================================\n     6 ITEMS IN ONE ROW\n  ================================== */\n\n  .spotlight-grid {\n    display: grid;\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n    gap: 14px;\n    width: 100%;\n  }\n\n\n  /* Card */\n\n  .spotlight-item {\n    min-width: 0;\n    position: relative;\n\n    display: flex;\n    flex-direction: column;\n\n    padding: 10px 10px 13px;\n\n    background: #f7f8fa;\n\n    border: 1px solid rgba(0, 0, 0, 0.045);\n    border-radius: 20px;\n\n    color: #111111;\n    text-decoration: none;\n\n    overflow: hidden;\n\n    transition:\n      transform 0.3s ease,\n      background-color 0.3s ease,\n      box-shadow 0.3s ease,\n      border-color 0.3s ease;\n  }\n\n\n  /* Image Area */\n\n  .spotlight-image-wrap {\n    width: 100%;\n    aspect-ratio: 1 / 0.88;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    overflow: hidden;\n\n    border-radius: 15px;\n\n    background:\n      radial-gradient(\n        circle at center,\n        #ffffff 0%,\n        #f9fafb 58%,\n        #f4f5f7 100%\n      );\n  }\n\n  .spotlight-image-wrap img {\n    display: block;\n\n    width: 78%;\n    height: 78%;\n\n    object-fit: contain;\n\n    mix-blend-mode: multiply;\n\n    transition: transform 0.4s cubic-bezier(.2,.7,.2,1);\n  }\n\n\n  /* Bottom label */\n\n  .spotlight-label {\n    width: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    gap: 8px;\n\n    padding: 14px 7px 2px;\n\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.2;\n\n    letter-spacing: -0.15px;\n  }\n\n\n  /* Arrow */\n\n  .spotlight-arrow {\n    flex: 0 0 auto;\n\n    width: 29px;\n    height: 29px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 50%;\n\n    background: #ffffff;\n    border: 1px solid rgba(0, 0, 0, 0.06);\n\n    font-size: 15px;\n    line-height: 1;\n\n    transition:\n      transform 0.3s ease,\n      background-color 0.3s ease,\n      color 0.3s ease;\n  }\n\n\n  /* ================================\n     DESKTOP HOVER\n  ================================== */\n\n  @media (hover: hover) and (pointer: fine) {\n\n    .spotlight-item:hover {\n      transform: translateY(-5px);\n\n      background: #ffffff;\n\n      border-color: rgba(0, 0, 0, 0.07);\n\n      box-shadow:\n        0 15px 35px rgba(0, 0, 0, 0.07);\n    }\n\n    .spotlight-item:hover .spotlight-image-wrap img {\n      transform: scale(1.055);\n    }\n\n    .spotlight-item:hover .spotlight-arrow {\n      transform: translateX(2px);\n      background: #111111;\n      color: #ffffff;\n    }\n\n  }\n\n\n  /* ================================\n     TABLET\n  ================================== */\n\n  @media (max-width: 1050px) {\n\n    .spotlight {\n      padding: 60px 22px 70px;\n    }\n\n    .spotlight-grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 14px;\n    }\n\n    .spotlight-item {\n      border-radius: 18px;\n    }\n\n  }\n\n\n  /* ================================\n     MOBILE\n  ================================== */\n\n  @media (max-width: 600px) {\n\n    .spotlight {\n      padding: 48px 14px 55px;\n    }\n\n    .spotlight-head {\n      margin-bottom: 30px;\n    }\n\n    .spotlight-title {\n      font-size: 36px;\n      letter-spacing: -1.2px;\n      margin-bottom: 10px;\n    }\n\n    .spotlight-subtitle {\n      max-width: 340px;\n      font-size: 13px;\n      line-height: 1.5;\n    }\n\n\n    /* Keep 3 per row on mobile */\n\n    .spotlight-grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 8px;\n    }\n\n\n    .spotlight-item {\n      padding: 6px 6px 9px;\n      border-radius: 14px;\n    }\n\n\n    .spotlight-image-wrap {\n      border-radius: 11px;\n      aspect-ratio: 1 / 0.95;\n    }\n\n\n    .spotlight-image-wrap img {\n      width: 82%;\n      height: 82%;\n    }\n\n\n    .spotlight-label {\n      padding: 9px 3px 0;\n\n      justify-content: center;\n\n      font-size: 11px;\n      text-align: center;\n    }\n\n\n    /* Hide arrow on small screens\n       to keep the cards clean */\n\n    .spotlight-arrow {\n      display: none;\n    }\n\n  }\n\n\n  /* Very small phones */\n\n  @media (max-width: 370px) {\n\n    .spotlight {\n      padding-left: 10px;\n      padding-right: 10px;\n    }\n\n    .spotlight-grid {\n      gap: 6px;\n    }\n\n    .spotlight-item {\n      border-radius: 12px;\n    }\n\n    .spotlight-label {\n      font-size: 10px;\n    }\n\n  }\n\n</style>",
