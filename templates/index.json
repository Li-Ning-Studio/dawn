    "custom_liquid_jebebN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"launch-wrapper\">\n\n  <div class=\"glass-card\">\n\n    <div class=\"liquid-glow glow-one\"></div>\n    <div class=\"liquid-glow glow-two\"></div>\n\n\n    <div class=\"launch-status\">\n      <span class=\"pulse-dot\"></span>\n      LAUNCHING SOON\n    </div>\n\n\n    <h1 class=\"launch-title\">\n      THE NEXT MOVE<br>\nBEGINS HERE\n    </h1>\n\n\n    <p class=\"launch-subtitle\">\nBuilt for those who play beyond limits.    </p>\n\n\n    <div class=\"countdown\">\n\n\n      <div class=\"time-box\">\n\n        <div class=\"number\" id=\"days\">\n          00\n        </div>\n\n        <div class=\"label\">\n          DAYS\n        </div>\n\n      </div>\n\n\n      <div class=\"divider\">\n        :\n      </div>\n\n\n      <div class=\"time-box\">\n\n        <div class=\"number\" id=\"hours\">\n          00\n        </div>\n\n        <div class=\"label\">\n          HOURS\n        </div>\n\n      </div>\n\n\n      <div class=\"divider\">\n        :\n      </div>\n\n\n      <div class=\"time-box\">\n\n        <div class=\"number\" id=\"minutes\">\n          00\n        </div>\n\n        <div class=\"label\">\n          MINUTES\n        </div>\n\n      </div>\n\n\n      <div class=\"divider\">\n        :\n      </div>\n\n\n      <div class=\"time-box\">\n\n        <div class=\"number\" id=\"seconds\">\n          00\n        </div>\n\n        <div class=\"label\">\n          SECONDS\n        </div>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</div>\n\n\n\n<style>\n\n/* =========================================================\n   RESET\n========================================================= */\n\n*{\n  box-sizing:border-box;\n}\n\n\n/* =========================================================\n   MAIN WRAPPER\n========================================================= */\n\n.launch-wrapper{\n\n  width:100%;\n\n  padding:70px 20px;\n\n  display:flex;\n\n  justify-content:center;\n\n  align-items:center;\n\n  background:#fff;\n\n  font-family:\n  \"Helvetica Neue\",\n  Arial,\n  sans-serif;\n\n  overflow:hidden;\n\n}\n\n\n/* =========================================================\n   MAIN GLASS CARD\n========================================================= */\n\n.glass-card{\n\n  position:relative;\n\n  width:min(1250px,100%);\n\n  padding:75px 60px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  text-align:center;\n\n  border-radius:45px;\n\n  background:\n\n  linear-gradient(\n    145deg,\n    rgba(255,255,255,.95),\n    rgba(230,250,248,.75)\n  );\n\n  border:1px solid rgba(0,0,0,.08);\n\n  backdrop-filter:blur(45px);\n\n  -webkit-backdrop-filter:blur(45px);\n\n  box-shadow:\n\n  0 40px 100px rgba(0,0,0,.12),\n\n  inset\n  0 1px\n  rgba(255,255,255,.9);\n\n  overflow:hidden;\n\n}\n\n\n/* =========================================================\n   GLOWS\n========================================================= */\n\n.liquid-glow{\n\n  position:absolute;\n\n  border-radius:50%;\n\n  filter:blur(30px);\n\n  animation:\n  moveGlow\n  8s\n  infinite\n  alternate\n  ease-in-out;\n\n  pointer-events:none;\n\n}\n\n\n.glow-one{\n\n  width:420px;\n\n  height:420px;\n\n  right:-220px;\n\n  top:-220px;\n\n  background:\n\n  radial-gradient(\n    circle,\n    rgba(50,213,199,.35),\n    transparent 70%\n  );\n\n}\n\n\n.glow-two{\n\n  width:300px;\n\n  height:300px;\n\n  left:-150px;\n\n  bottom:-120px;\n\n  background:\n\n  radial-gradient(\n    circle,\n    rgba(50,213,199,.18),\n    transparent 70%\n  );\n\n}\n\n\n@keyframes moveGlow{\n\n  0%{\n    transform:\n    translate(0,0)\n    scale(1);\n  }\n\n  100%{\n    transform:\n    translate(-40px,40px)\n    scale(1.2);\n  }\n\n}\n\n\n/* =========================================================\n   STATUS\n========================================================= */\n\n.launch-status{\n\n  position:relative;\n\n  z-index:1;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:10px;\n\n  font-size:11px;\n\n  font-weight:700;\n\n  letter-spacing:.35em;\n\n  color:#788285;\n\n  margin-bottom:30px;\n\n}\n\n\n.pulse-dot{\n\n  width:8px;\n\n  height:8px;\n\n  flex:none;\n\n  border-radius:50%;\n\n  background:#32d5c7;\n\n  box-shadow:\n  0 0 18px #32d5c7;\n\n  animation:\n  pulse\n  1.5s\n  infinite;\n\n}\n\n\n@keyframes pulse{\n\n  50%{\n\n    transform:\n    scale(1.5);\n\n    opacity:.5;\n\n  }\n\n}\n\n\n/* =========================================================\n   TITLE\n========================================================= */\n\n.launch-title{\n\n  position:relative;\n\n  z-index:1;\n\n  margin:0;\n\n  font-size:\n  clamp(36px,6vw,64px);\n\n  font-weight:900;\n\n  line-height:1.05;\n\n  letter-spacing:-.05em;\n\n  color:#111;\n\n}\n\n\n/* =========================================================\n   SUBTITLE\n========================================================= */\n\n.launch-subtitle{\n\n  position:relative;\n\n  z-index:1;\n\n  margin:\n  25px 0 0;\n\n  font-size:16px;\n\n  color:#657074;\n\n}\n\n\n/* =========================================================\n   COUNTDOWN\n========================================================= */\n\n.countdown{\n\n  position:relative;\n\n  z-index:1;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  gap:15px;\n\n  margin-top:55px;\n\n}\n\n\n/* =========================================================\n   TIME BOX\n========================================================= */\n\n.time-box{\n\n  width:115px;\n\n  height:110px;\n\n  display:flex;\n\n  flex-direction:column;\n\n  align-items:center;\n\n  justify-content:center;\n\n  border-radius:26px;\n\n  background:\n\n  linear-gradient(\n    145deg,\n    rgba(255,255,255,.9),\n    rgba(230,248,246,.8)\n  );\n\n  border:\n  1px solid rgba(0,0,0,.08);\n\n  box-shadow:\n\n  0 20px 40px\n  rgba(0,0,0,.1),\n\n  inset\n  0 1px\n  white;\n\n}\n\n\n/* =========================================================\n   NUMBER\n========================================================= */\n\n.number{\n\n  position:relative;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  width:100%;\n\n  height:55px;\n\n  font-size:52px;\n\n  font-weight:800;\n\n  line-height:55px;\n\n  color:#111;\n\n  overflow:hidden;\n\n}\n\n\n.number span{\n\n  position:absolute;\n\n  left:0;\n\n  right:0;\n\n  top:0;\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n  width:100%;\n\n  height:100%;\n\n}\n\n\n.old-number{\n\n  animation:\n  slideOld\n  .32s\n  cubic-bezier(.4,0,.2,1)\n  forwards;\n\n}\n\n\n.new-number{\n\n  animation:\n  slideNew\n  .32s\n  cubic-bezier(.4,0,.2,1)\n  forwards;\n\n}\n\n\n@keyframes slideOld{\n\n  0%{\n\n    transform:\n    translateY(0);\n\n    opacity:1;\n\n  }\n\n  100%{\n\n    transform:\n    translateY(-100%);\n\n    opacity:0;\n\n  }\n\n}\n\n\n@keyframes slideNew{\n\n  0%{\n\n    transform:\n    translateY(100%);\n\n    opacity:0;\n\n  }\n\n  100%{\n\n    transform:\n    translateY(0);\n\n    opacity:1;\n\n  }\n\n}\n\n\n/* =========================================================\n   LABEL\n========================================================= */\n\n.label{\n\n  margin-top:10px;\n\n  font-size:8px;\n\n  font-weight:700;\n\n  letter-spacing:.25em;\n\n  color:#8b9598;\n\n}\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.divider{\n\n  font-size:38px;\n\n  font-weight:500;\n\n  color:#32d5c7;\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ACTUAL MAIN CARD HEIGHT INCREASE\n========================================================= */\n\n@media(max-width:700px){\n\n  .launch-wrapper{\n\n    padding:\n    30px 8px;\n\n  }\n\n\n  .glass-card{\n\n    width:100%;\n\n    /* ACTUAL CARD HEIGHT */\n\n    min-height:600px;\n\n    height:600px;\n\n    padding:\n    90px 18px;\n\n    border-radius:38px;\n\n  }\n\n\n  .launch-status{\n\n    font-size:10px;\n\n    margin-bottom:30px;\n\n  }\n\n\n  .launch-title{\n\n    font-size:36px;\n\n  }\n\n\n  .launch-subtitle{\n\n    font-size:15px;\n\n    margin-top:24px;\n\n  }\n\n\n  .countdown{\n\n    gap:7px;\n\n    margin-top:55px;\n\n    width:100%;\n\n  }\n\n\n  .time-box{\n\n    width:82px;\n\n    height:108px;\n\n    border-radius:22px;\n\n  }\n\n\n  .number{\n\n    font-size:34px;\n\n    height:44px;\n\n    line-height:44px;\n\n  }\n\n\n  .divider{\n\n    font-size:28px;\n\n    flex:none;\n\n  }\n\n\n  .label{\n\n    font-size:7px;\n\n    letter-spacing:.17em;\n\n    margin-top:10px;\n\n  }\n\n}\n\n\n/* =========================================================\n   SMALL PHONES\n   ACTUAL MAIN CARD HEIGHT\n========================================================= */\n\n@media(max-width:380px){\n\n  .launch-wrapper{\n\n    padding:\n    25px 7px;\n\n  }\n\n\n  .glass-card{\n\n    width:100%;\n\n    /* ACTUAL CARD HEIGHT */\n\n    min-height:500px;\n\n    height:500px;\n\n    padding:\n    80px 14px;\n\n    border-radius:34px;\n\n  }\n\n\n  .launch-status{\n\n    font-size:9px;\n\n    margin-bottom:27px;\n\n  }\n\n\n  .launch-title{\n\n    font-size:32px;\n\n  }\n\n\n  .launch-subtitle{\n\n    font-size:14px;\n\n  }\n\n\n  .countdown{\n\n    gap:5px;\n\n    margin-top:50px;\n\n  }\n\n\n  .time-box{\n\n    width:75px;\n\n    height:100px;\n\n    border-radius:20px;\n\n  }\n\n\n  .number{\n\n    font-size:31px;\n\n    height:42px;\n\n    line-height:42px;\n\n  }\n\n\n  .divider{\n\n    font-size:25px;\n\n  }\n\n\n  .label{\n\n    font-size:6px;\n\n    letter-spacing:.14em;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function(){\n\n  /* =======================================================\n     LAUNCH DATE\n  ======================================================= */\n\n  const launchDate =\n    new Date(\n      \"2026-09-05T12:00:00+05:30\"\n    ).getTime();\n\n\n  /* =======================================================\n     UPDATE TIMER\n  ======================================================= */\n\n  function updateTimer(){\n\n    let distance =\n      launchDate - Date.now();\n\n\n    if(distance < 0){\n\n      distance = 0;\n\n    }\n\n\n    const days =\n      Math.floor(\n        distance /\n        (1000 * 60 * 60 * 24)\n      );\n\n\n    const hours =\n      Math.floor(\n        (\n          distance %\n          (1000 * 60 * 60 * 24)\n        ) /\n        (1000 * 60 * 60)\n      );\n\n\n    const minutes =\n      Math.floor(\n        (\n          distance %\n          (1000 * 60 * 60)\n        ) /\n        (1000 * 60)\n      );\n\n\n    const seconds =\n      Math.floor(\n        (\n          distance %\n          (1000 * 60)\n        ) /\n        1000\n      );\n\n\n    change(\n      \"days\",\n      days\n    );\n\n\n    change(\n      \"hours\",\n      hours\n    );\n\n\n    change(\n      \"minutes\",\n      minutes\n    );\n\n\n    change(\n      \"seconds\",\n      seconds\n    );\n\n  }\n\n\n  /* =======================================================\n     CHANGE NUMBER\n  ======================================================= */\n\n  function change(\n    id,\n    value\n  ){\n\n    const element =\n      document.getElementById(id);\n\n\n    if(!element){\n\n      return;\n\n    }\n\n\n    const formatted =\n      String(value)\n      .padStart(2,\"0\");\n\n\n    const current =\n      element.textContent.trim();\n\n\n    if(\n      current === formatted\n    ){\n\n      return;\n\n    }\n\n\n    const oldValue =\n      current || \"00\";\n\n\n    element.innerHTML = `\n\n      <span class=\"old-number\">\n        ${oldValue}\n      </span>\n\n      <span class=\"new-number\">\n        ${formatted}\n      </span>\n\n    `;\n\n\n    setTimeout(\n      function(){\n\n        element.textContent =\n          formatted;\n\n      },\n      330\n    );\n\n  }\n\n\n  /* =======================================================\n     START\n  ======================================================= */\n\n  updateTimer();\n\n\n  setInterval(\n    updateTimer,\n    1000\n  );\n\n})();\n\n</script>",
