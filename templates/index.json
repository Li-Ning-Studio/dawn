    "custom_liquid_Q8rCj8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- BEAST MAX 1:1 VIDEO SHOWCASE SECTION (CLICKABLE VIDEO) -->\n<style>\n  /* Base Section Styling */\n  .bm-showcase {\n    background-color: transparent; \n    padding: 5rem 2rem;\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  }\n\n  /* Grid Layout Container */\n  .bm-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 4rem;\n    align-items: center;\n  }\n\n  /* --- Left Column: 1:1 Video --- */\n  .bm-video-col {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1 / 1; \n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.03);\n    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease;\n  }\n\n  /* Hover effect to show the video is clickable */\n  .bm-video-col:hover {\n    transform: translateY(-5px) scale(1.02);\n    box-shadow: 0 25px 50px rgba(255, 85, 0, 0.15), 0 0 0 1px rgba(255, 85, 0, 0.1);\n  }\n\n  /* Invisible overlay link that makes the whole video area clickable */\n  .bm-video-link {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 1;\n  }\n\n  /* Subtle glow behind the video */\n  .bm-video-col::before {\n    content: '';\n    position: absolute;\n    top: -20px; left: -20px; right: -20px; bottom: -20px;\n    background: radial-gradient(circle at center, rgba(255, 85, 0, 0.08) 0%, transparent 70%);\n    z-index: 0;\n  }\n\n  .bm-video-col video {\n    position: relative;\n    z-index: 1;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    background-color: #f3f4f6;\n  }\n\n  /* --- Right Column: Content --- */\n  .bm-content-col {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  /* Typography Styling */\n  .bm-intro {\n    font-size: 1.1rem;\n    font-weight: 800;\n    color: #4b5563;\n    text-transform: uppercase;\n    letter-spacing: 3px;\n    margin-bottom: 0.5rem;\n  }\n\n  .bm-title {\n    font-size: clamp(3.5rem, 6vw, 5.5rem);\n    font-weight: 900;\n    line-height: 0.95;\n    letter-spacing: -2px;\n    margin: 0 0 1.5rem 0;\n    text-transform: uppercase;\n    color: #0b0c10;\n  }\n\n  .bm-title .accent {\n    color: #ff5500;\n  }\n\n  .bm-subtitle {\n    font-size: clamp(1.5rem, 3vw, 2.2rem);\n    font-weight: 800;\n    color: #111111;\n    margin: 0 0 1rem 0;\n    line-height: 1.2;\n    letter-spacing: -0.5px;\n  }\n\n  .bm-description {\n    font-size: 1.15rem;\n    color: #4b5563;\n    line-height: 1.6;\n    margin: 0 0 2.5rem 0;\n    max-width: 90%;\n    font-weight: 500;\n  }\n\n  /* CTA Button */\n  .bm-cta {\n    align-self: flex-start;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 18px 40px;\n    background-color: #ff5500;\n    color: #ffffff;\n    font-size: 1.1rem;\n    font-weight: 800;\n    text-decoration: none;\n    border-radius: 8px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    transition: all 0.3s ease;\n    box-shadow: 0 4px 15px rgba(255, 85, 0, 0.25);\n  }\n\n  .bm-cta:hover {\n    background-color: #e04b00;\n    transform: translateY(-3px);\n    box-shadow: 0 8px 25px rgba(255, 85, 0, 0.35);\n  }\n\n  /* Responsive Design */\n  @media (max-width: 900px) {\n    .bm-showcase {\n      padding: 4rem 1.5rem;\n    }\n    \n    .bm-container {\n      grid-template-columns: 1fr;\n      gap: 3rem;\n    }\n\n    .bm-content-col {\n      order: 1; /* Text on top for mobile */\n    }\n    \n    .bm-video-col {\n      order: 2;\n    }\n\n    .bm-description {\n      max-width: 100%;\n    }\n\n    .bm-cta {\n      width: 100%;\n      justify-content: center;\n    }\n  }\n</style>\n\n<section class=\"bm-showcase\">\n  <div class=\"bm-container\">\n    \n    <!-- Left Column: Clickable 1:1 Video Container -->\n    <div class=\"bm-video-col\">\n      <!-- Invisible link covering the video -->\n      <a href=\"/pages/beast-max\" class=\"bm-video-link\" aria-label=\"View Beast Max Landing Page\">\n      \n      <video \n        autoplay \n        loop \n        muted \n        playsinline \n        \n      >\n        <!-- PASTE YOUR 1:1 VIDEO URL BELOW -->\n        <source src=\"https://cdn.shopify.com/videos/c/vp/c495e2c1f0e74c7e84742681d66168c4/c495e2c1f0e74c7e84742681d66168c4.HD-1080p-2.5Mbps-83002119.mp4\" />\n        Your browser does not support the video tag.\n      </video> </a>\n    </div>\n\n    <!-- Right Column: Product Content -->\n    <div class=\"bm-content-col\">\n      \n      <div class=\"bm-intro\">Introducing,</div>\n      \n      <h2 class=\"bm-title\">\n        Beast <span class=\"accent\">Max</span>\n      </h2>\n      \n      <h3 class=\"bm-subtitle\">The Beast Has Arrived.</h3>\n      \n      <p class=\"bm-description\">\n        Performance so fierce, it speaks for itself.\n      </p>\n\n      <!-- Updated CTA link -->\n      <a href=\"/pages/beast-max\" class=\"bm-cta\">\n        Enter The Beast\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n      </a>\n      \n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_CrnNx6": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* Base Section */\n  .hyper-showcase {\n    max-width: 1400px;\n    margin: 4rem auto;\n    padding: 0 1.5rem;\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    display: flex;\n    flex-direction: column;\n    gap: 2rem;\n  }\n\n  /* Image Container - Strictly separate from text */\n  .hyper-image-wrapper {\n    display: block;\n    width: 100%;\n    border-radius: 20px;\n    overflow: hidden;\n    position: relative;\n    /* Soft shadow for depth */\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);\n    transition: transform 0.4s ease, box-shadow 0.4s ease;\n  }\n\n  .hyper-image-wrapper:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 20px 45px rgba(255, 85, 0, 0.15);\n  }\n\n  /* HTML5 Picture element handles the different images automatically */\n  .hyper-image-wrapper img {\n    width: 100%;\n    height: auto;\n    display: block;\n    object-fit: cover;\n    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);\n  }\n\n  .hyper-image-wrapper:hover img {\n    transform: scale(1.02);\n  }\n\n  /* Desktop Image Ratio */\n  @media (min-width: 769px) {\n    .hyper-image-wrapper img {\n  \n    }\n  }\n\n  /* Mobile Image Ratio */\n  @media (max-width: 768px) {\n   \n  }\n\n  /* Editorial Layout for the Text Band Below the Image */\n  .hyper-content-band {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 2rem;\n    align-items: center;\n    padding: 1rem 0;\n  }\n\n  /* Left Side: Title & Tags */\n  .hyper-band-left {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n  }\n\n  .hyper-tags {\n    font-size: 1.25rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    color: #2D5109;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .hyper-tags span.dot {\n    width: 4px;\n    height: 4px;\n    background-color: #d1d5db;\n    border-radius: 50%;\n  }\n\n  .hyper-title {\n    font-size: clamp(4rem, 4vw, 5.5rem);\n    font-weight: 900;\n    line-height: 1.05;\n    text-transform: uppercase;\n    color: #111111;\n    margin: 0;\n    letter-spacing: -1px;\n  }\n\n  /* Right Side: Description & Button */\n  .hyper-band-right {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 1.5rem;\n    padding-left: 2rem;\n    border-left: 2px solid #f3f4f6;\n  }\n\n  .hyper-description {\n    font-size: 1.55rem;\n    color: #4b5563;\n    line-height: 1.6;\n    margin: 0;\n    font-weight: 500;\n    max-width: 90%;\n  }\n\n  .hyper-cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px 40px;\n    background-color: #111111;\n    color: #ffffff;\n    font-size: 1rem;\n    font-weight: 700;\n    text-decoration: none;\n    border-radius: 8px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    transition: all 0.3s ease;\n  }\n\n  .hyper-cta:hover {\n    background-color: #6B8B28;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 20px rgba(255, 85, 0, 0.25);\n  }\n\n  /* Responsive Adjustments */\n  @media (max-width: 900px) {\n    .hyper-content-band {\n      grid-template-columns: 1fr;\n      gap: 1.5rem;\n    }\n    \n    .hyper-band-right {\n      padding-left: 0;\n      border-left: none;\n      padding-top: 1.5rem;\n      border-top: 2px solid #f3f4f6;\n    }\n\n    .hyper-description {\n      max-width: 100%;\n    }\n  }\n</style>\n\n<section class=\"hyper-showcase\">\n  <!-- Image Frame (Standalone, not a background) -->\n  <a href=\"/pages/hyper-series\" class=\"hyper-image-wrapper\" aria-label=\"Shop the Hyper Series\">\n    <!-- The <picture> element swaps out the image file based on screen size automatically -->\n    <picture>\n      <!-- DESKTOP IMAGE: 16:9 (Loads on screens 769px and wider) -->\n      <source media=\"(min-width: 769px)\" srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_18bb475f-7732-4257-8592-ff27bf5b1485.jpg?v=1781522861\">\n      \n      <!-- MOBILE IMAGE: 1:1 (Loads on screens 768px and smaller) -->\n      <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/02_16987afa-8b34-4490-8f84-c948913b6f30.jpg?v=1781522802\" alt=\"Hyper Series: Hyperturf and Hyperdrive\">\n    </picture>\n  </a>\n\n  <!-- Editorial Style Content Band (Positioned strictly below the image) -->\n  <div class=\"hyper-content-band\">\n    \n    <!-- Left Column -->\n    <div class=\"hyper-band-left\">\n      <div class=\"hyper-tags\">\n        <span>Hyperturf</span>\n        <span class=\"dot\"></span>\n        <span>Hyperdrive</span>\n      </div>\n      <h2 class=\"hyper-title\">Last Longer<br>During Innings</h2>\n    </div>\n\n    <!-- Right Column -->\n    <div class=\"hyper-band-right\">\n      <p class=\"hyper-description\">\n        Light-weight and heavily cushioned to make your movements feels at ease.\n      </p>\n      <a href=\"/pages/hyper-series\" class=\"hyper-cta\">\n        Explore Now!\n      </a>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
