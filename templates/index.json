    "custom_liquid_3gkjyw": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>New Arrivals — Hundred</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  /* ============================================================\n     NEW ARRIVALS SECTION — scoped under .na- namespace\n     Drop-in Shopify section. Replace image srcs, hrefs, and the\n     spec-line copy marked TODO with live product data.\n     ============================================================ */\n\n  .na-section {\n    --na-black:   #0a0a0c;\n    --na-panel:   #151417;\n    --na-line:    #2a2830;\n    --na-ember:   #e8432c;\n    --na-ember-2: #ff8a3d;\n    --na-blood:   #c81e1e;\n    --na-gold:    #f2b705;\n    --na-bone:    #f5f1ea;\n    --na-fog:     #9a969c;\n\n    --na-display: 'Oswald', 'Arial Narrow', sans-serif;\n    --na-body:    'Barlow', 'Helvetica Neue', sans-serif;\n\n    background: ;\n    color: var(--na-bone);\n    padding: 0 0 clamp(56px, 8vw, 96px);\n    overflow: hidden;\n  }\n\n  .na-section * { box-sizing: border-box; }\n\n  /* ---------- Banner ---------- */\n  .na-banner {\n    width: 100%;\n    line-height: 0;\n    position: relative;\n  }\n  \n  .na-banner img {\n    width: 100%;\n    height: auto;\n    display: block;\n    transform: scale(1.015);\n    animation: na-settle 1.1s ease-out;\n  }\n  \n  @keyframes na-settle {\n    from { transform: scale(1.05); opacity: 0; }\n    to   { transform: scale(1.015); opacity: 1; }\n  }\n  \n  .na-banner::after {\n  \n  }\n\n  /* ---------- Intro copy ---------- */\n  .na-intro {\n    max-width: 780px;\n    margin: 0 auto;\n    padding: clamp(40px, 6vw, 64px) 24px clamp(32px, 5vw, 48px);\n    text-align: center;\n  }\n  \n  .na-eyebrow {\n   \n    font-weight: 600;\n    font-size: 13px;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--na-ember);\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n  }\n  \n  .na-eyebrow::before,\n  .na-eyebrow::after {\n    content: \"\";\n    width: 22px;\n    height: 1px;\n    background: var(--na-ember);\n    opacity: 0.6;\n  }\n  \n  .na-title {\n    \n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: clamp(30px, 4.6vw, 46px);\n    line-height: 1.05;\n    letter-spacing: 0.01em;\n    margin: 18px 0 16px;\n  }\n  \n  .na-title em {\n    font-style: normal;\n    background: linear-gradient(100deg, var(--na-ember-2), var(--na-ember) 55%, var(--na-blood));\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n  \n  .na-desc {\n   \n    font-size: 16px;\n    line-height: 1.65;\n    color: var(--gray-70);\n    margin: 0 auto;\n    max-width: 620px;\n  }\n\n  /* ---------- Cards ---------- */\n  .na-cards {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 0 24px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 28px;\n    position: relative;\n  }\n  \n  /* signature: diagonal seam echoing the banner's rock/collision split */\n  \n\n  .na-card {\n    position: relative;\n    background: var(--na-panel);\n    border: 1px solid var(--na-line);\n    border-radius: 2px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;\n  }\n  \n  .na-card:hover {\n    transform: translateY(-4px);\n    border-color: var(--na-ember);\n  }\n  \n  @media (prefers-reduced-motion: reduce) {\n    .na-card, .na-banner img { transition: none; animation: none; }\n    .na-card:hover { transform: none; }\n  }\n\n  .na-card-visual {\n    position: relative;\n    height: 450px;\n    /* diagonal color block — carried over from the banner's split motif */\n    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);\n  }\n  \n  .na-card--rock .na-card-visual {\n    background: radial-gradient(120% 140% at 15% 15%, var(--na-ember-2), var(--na-ember) 55%, #2a1208 100%);\n  }\n  \n  .na-card--aero .na-card-visual {\n    background: radial-gradient(120% 140% at 85% 20%, var(--na-blood), #290a0a 70%, var(--na-black) 100%);\n  }\n  \n  .na-card-visual img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: ;\n    object-fit: contain;\n    object-position: center 65%;\n    padding:  0;\n  }\n\n  .na-badge {\n    position: absolute;\n    top: 16px;\n    left: 16px;\n    z-index: 2;\n    font-family: var(--na-display);\n    font-weight: 600;\n    font-size: 11px;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: var(--na-black);\n    background: var(--na-gold);\n    padding: 5px 10px 4px;\n    border-radius: 2px;\n  }\n\n  .na-card-body {\n    padding: 22px 24px 26px;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n  }\n  \n  .na-card-name {\n   color: #fff;\n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: 24px;\n    letter-spacing: 0.01em;\n    margin: 0 0 6px;\n  }\n  \n  .na-card-tag {\n   \n    font-weight: 500;\n    font-size: 14px;\n    color: var(--na-ember-2);\n    margin: 0 0 12px;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n  \n  .na-card--aero .na-card-tag { color: #ff6b57; }\n\n  .na-card-spec {\n    \n    font-size: 14px;\n    line-height: 1.6;\n    color: var(--na-fog);\n    margin: 0 0 20px;\n    padding-top: 12px;\n    border-top: 1px solid var(--na-line);\n  }\n\n  .na-cta {\n    margin-top: auto;\n   \n    font-weight: 600;\n    font-size: 13px;\n   \n    text-transform: uppercase;\n    color: var(--na-bone);\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding-bottom: 3px;\n    border-bottom: 1px solid var(--na-line);\n    width: fit-content;\n    transition: border-color 0.25s ease, gap 0.25s ease, color 0.25s ease;\n  }\n  \n  .na-cta:hover {\n    border-color: var(--na-ember);\n    color: var(--na-ember-2);\n    gap: 12px;\n  }\n  \n  .na-cta:focus-visible,\n  .na-card:focus-within {\n    outline: 2px solid var(--na-ember);\n    outline-offset: 3px;\n  }\n\n  /* ---------- Mobile ---------- */\n  @media (max-width: 720px) {\n    .na-cards {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n    .na-cards::before { display: none; }\n    .na-card-visual { height: 294px; }\n  }\n</style>\n</head>\n<body>\n\n<section class=\"na-section\" aria-labelledby=\"na-heading\">\n\n <a href=\"/collections/new-arrival\" > <div class=\"na-banner\">\n    <picture>\n      <!-- Mobile Fallback Source -->\n      <source media=\"(max-width: 767px)\" srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/portrait.jpg\">\n      <!-- Desktop Source -->\n      <source media=\"(min-width: 768px)\" srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/landscape.jpg?v=1786606743\">\n      <img src=\"https://placehold.co/1800x544/151417/e8432c?text=Hundred+Badminton\" alt=\"Rock 80 and Aeroblast 7 badminton rackets, Hundred's new arrivals\" width=\"1800\" height=\"544\" loading=\"lazy\">\n    </picture>\n  </div> </a>\n\n  <div class=\"na-intro\">\n    <span class=\"na-eyebrow\">New Arrivals</span>\n    <h2 class=\"na-title\" id=\"na-heading\">Two New Ways To <em>Attack</em></h2>\n    <p class=\"na-desc\">\n      \n      Same intent, opposite plan, both just landed.\n    </p>\n  </div>\n\n  <div class=\"na-cards\">\n\n    <article class=\"na-card na-card--rock\">\n      <div class=\"na-card-visual\">\n        <span class=\"na-badge\">New</span>\n        <!-- LIVE DATA: Replace src with actual Shopify asset -->\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_ad171dc1-a98e-435e-a62d-3ebe129db454.jpg\" alt=\"Hundred Rock 80 Badminton Racket\">\n      </div>\n      <div class=\"na-card-body\">\n        <h3 class=\"na-card-name\">Rock 80</h3>\n        <p class=\"na-card-tag\">Nothing light about this.</p>\n        <p class=\"na-card-spec\">Weight: 5U<br>Balance: Head-Heavy<br>Frame Shape: Nano</p>\n        <a href=\"/products/rock-80\" class=\"na-cta\">Shop Rock 80 <span aria-hidden=\"true\">&rarr;</span></a>\n      </div>\n    </article>\n\n    <article class=\"na-card na-card--aero\">\n      <div class=\"na-card-visual\">\n        <span class=\"na-badge\">New</span>\n        <!-- LIVE DATA: Replace src with actual Shopify asset -->\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/02.1.jpg?v=1786616384\" alt=\"Hundred Aeroblast 7 Badminton Racket\">\n      </div>\n      <div class=\"na-card-body\">\n        <h3 class=\"na-card-name\">Aeroblast 7</h3>\n        <p class=\"na-card-tag\">Attack, locked in.</p>\n        <p class=\"na-card-spec\">Weight: 5U <br>Balance: Head-Heavy<br>Frame Shape:  Curve²</p>\n        <a href=\"https://vn.hndrd.co/products/aeroblast-7\" class=\"na-cta\">Shop Aeroblast 7 <span aria-hidden=\"true\">&rarr;</span></a>\n      </div>\n    </article>\n\n  </div>\n\n</section>\n\n</body>\n</html>",
