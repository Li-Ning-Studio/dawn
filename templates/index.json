    "custom_liquid_Q7GHFb": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!--\n  HNDRD — New Launches Section (Raze Pro II × Hyperspeed)\n  Standalone, Shopify-drop-in-compatible HTML/CSS block.\n  Transparent background — sits directly on your theme's page background.\n-->\n\n<!-- ============================================================\n     BANNER — sits above the product section.\n     Two independent \"reveal\" tiles, each with its own spotlight\n     glow behind the shoe. No versus framing — these are two\n     separate launches shown side by side, not compared.\n     Namespace: nlb- (New Launches Banner)\n============================================================= -->\n<section class=\"nlb-section\">\n  <div class=\"nlb-head\">\n    <span class=\"nlb-eyebrow\">New Arrivals</span>\n    <h2 class=\"nlb-title\">Two Launches. <br>\nOne Court.</h2>\n    <p class=\"nlb-sub\">Built for opposite ends of the rally — pick your side.</p>\n  </div>\n  <div class=\"nlb-grid\">\n\n    <!-- ============ REVEAL 1 : RAZE PRO II ============ -->\n    <a class=\"nlb-tile nlb-tile--razepro\" href=\"https://in.hndrd.co/pages/raze-pro-ii\">\n      <span class=\"nlb-badge\">New Launch</span>\n      <div class=\"nlb-glow\" aria-hidden=\"true\"></div>\n      <div class=\"nlb-imgwrap\">\n        <img class=\"nlb-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/01_Mobile.jpg?v=1780562996\" alt=\"Raze Pro II badminton shoe\" loading=\"lazy\">\n      </div>\n      <div class=\"nlb-info\">\n        <h3 class=\"nlb-name\">Raze Pro&nbsp;II</h3>\n        <p class=\"nlb-line\"><b>Feels light. Plays hard. </b> The Perfect Balance of Featherlight Comfort and Court Power</p>\n        <span class=\"nlb-cta\">Shop Raze Pro II <svg class=\"nlb-arrow\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- ============ REVEAL 2 : HYPERSPEED ============ -->\n    <a class=\"nlb-tile nlb-tile--hyperspeed\" href=\"https://in.hndrd.co/pages/hyperspeed\">\n      <span class=\"nlb-badge\">New Launch</span>\n      <div class=\"nlb-glow\" aria-hidden=\"true\"></div>\n      <div class=\"nlb-imgwrap\">\n        <img class=\"nlb-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_R_de0de414-91a0-4b2a-b22f-635e1919d315.png?v=1783486081\" alt=\"Hyperspeed badminton shoe\" loading=\"lazy\">\n      </div>\n      <div class=\"nlb-info\">\n        <h3 class=\"nlb-name\">Hyperspeed</h3>\n        <p class=\"nlb-line\"><b>Comfort that drives your game.</b> Defined by speed, driven by comfort.</p>\n        <span class=\"nlb-cta\">Shop Hyperspeed <svg class=\"nlb-arrow\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n    </a>\n\n\n  </div>\n</section>\n\n<style>\n  .nlb-section{\n    --nlb-raze: #e8501f;\n    --nlb-hyper: #0a7cc7;\n    --nlb-ink: #14171c;\n    --nlb-ink-dim: #767c86;\n    --nlb-hairline: #e4e2dc;\n\n    background: transparent;\n    color: var(--nlb-ink);\n    \n    \n    padding: 72px 24px 8px;\n  }\n\n  .nlb-head{ text-align: center; max-width: 1240px; margin: 0px auto 60px;}\n\n  .nlb-eyebrow{\n    display:inline-block;\n   \n    font-size: 12px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--nlb-ink-dim);\n    border: 1px solid var(--nlb-hairline);\n    border-radius: 999px;\n    padding: 6px 16px;\n    margin-bottom: 20px;\n  }\n\n  .nlb-title{\n  \n    font-weight: 900;\n    text-transform: uppercase;\n    font-size: clamp(32px, 5vw, 56px);\n    line-height: 1;\n    margin: 0 0 12px;\n    color: var(--nlb-ink);\n  }\n\n  .nlb-sub{\n    color: var(--nlb-ink-dim);\n    font-size: 16px;\n    margin: 0;\n  }\n\n  .nlb-grid{\n    max-width: 1240px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 32px;\n  }\n\n  .nlb-tile{\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    text-decoration: none;\n    color: var(--nlb-ink);\n    padding: 36px 32px 32px;\n    border-radius: 24px;\n    overflow: hidden;\n    isolation: isolate;\n    background: rgba(0,0,0,0.015);\n    border: 1px solid var(--nlb-hairline);\n    transition: transform 480ms cubic-bezier(.16,1,.3,1), border-color 480ms ease, box-shadow 480ms ease;\n  }\n\n  .nlb-tile:hover{\n    transform: translateY(-6px);\n    box-shadow: 0 24px 48px -28px rgba(0,0,0,0.2);\n  }\n  .nlb-tile--razepro:hover{ border-color: var(--nlb-raze); }\n  .nlb-tile--hyperspeed:hover{ border-color: var(--nlb-hyper); }\n\n  .nlb-badge{\n    align-self: flex-start;\n   \n    font-size: 11px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 6px 12px;\n    border-radius: 999px;\n    margin-bottom: 8px;\n    z-index: 2;\n  }\n  .nlb-tile--razepro .nlb-badge{ background: color-mix(in srgb, var(--nlb-raze) 12%, transparent); color: var(--nlb-raze); }\n  .nlb-tile--hyperspeed .nlb-badge{ background: color-mix(in srgb, var(--nlb-hyper) 12%, transparent); color: var(--nlb-hyper); }\n\n  /* spotlight glow behind the shoe — signals a fresh reveal,\n     not a matchup */\n  .nlb-glow{\n    position: absolute;\n    top: 8%;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 70%;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    filter: blur(48px);\n    opacity: 0.28;\n    z-index: -1;\n    transition: opacity 480ms ease, transform 480ms ease;\n  }\n  .nlb-tile--razepro .nlb-glow{ background: var(--nlb-raze); }\n  .nlb-tile--hyperspeed .nlb-glow{ background: var(--nlb-hyper); }\n  .nlb-tile:hover .nlb-glow{ opacity: 0.4; transform: translateX(-50%) scale(1.08); }\n\n  .nlb-imgwrap{\n    position: relative;\n    width: 100%;\n    aspect-ratio: 4 / 5;\n    border-radius: 16px;\n    overflow: hidden;\n    margin-bottom: 22px;\n  }\n\n  .nlb-img{\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 480ms cubic-bezier(.16,1,.3,1);\n  }\n  .nlb-tile:hover .nlb-img{ transform: scale(1.04); }\n\n  .nlb-info{ margin-top: auto; }\n\n  .nlb-name{\n   \n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: 28px;\n    line-height: 1;\n    margin: 0 0 8px;\n  }\n\n  .nlb-line{\n    color: var(--nlb-ink-dim);\n    font-size: 14px;\n    margin: 0 0 18px;\n  }\n\n  .nlb-cta{\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 14px;\n    font-weight: 600;\n  }\n  .nlb-tile--razepro .nlb-cta{ color: var(--nlb-raze); }\n  .nlb-tile--hyperspeed .nlb-cta{ color: var(--nlb-hyper); }\n\n  .nlb-arrow{ width: 16px; height: 16px; transition: transform 300ms ease; }\n  .nlb-tile:hover .nlb-arrow{ transform: translateX(4px); }\n\n  @media (max-width: 860px){\n    .nlb-section{ padding: 56px 18px 4px; }\n    .nlb-grid{ grid-template-columns: 1fr; gap: 20px; }\n    .nlb-tile{ padding: 28px 24px 26px; border-radius: 20px; }\n    .nlb-name{ font-size: 26px; }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .nlb-tile, .nlb-img, .nlb-arrow, .nlb-glow{ transition: none !important; }\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 84
      }
    },
