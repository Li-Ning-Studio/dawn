    "custom_liquid_ReR9YN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ================================================\n  HUNDRED INDIA — \"SHOP BY SPORT\" HOMEPAGE SECTION\n  Namespace: sbs- (Shop By Sport)\n  Drop-in ready: pure HTML/CSS, no JS, no external deps\n  Replace every [IMAGE_URL_...] placeholder with your asset links\n================================================= -->\n\n<section class=\"sbs-section\">\n  <div class=\"sbs-header\">\n    <span class=\"sbs-eyebrow\">Built for the game you play</span>\n    <h2 class=\"sbs-title\">Shop by Sport</h2>\n  </div>\n\n  <div class=\"sbs-grid\">\n\n    <!-- BADMINTON -->\n    <a href=\"/collections/badminton\" class=\"sbs-card sbs-card--badminton\">\n      <img class=\"sbs-card-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/1_45717e43-2943-481e-8014-390f40690824.jpg?v=1785757892\" alt=\"Badminton gear\" loading=\"lazy\">\n      <div class=\"sbs-card-overlay\"></div>\n      <div class=\"sbs-card-content\">\n        <span class=\"sbs-card-index\"></span>\n        <h3 class=\"sbs-card-title\">Badminton</h3>\n        <p class=\"sbs-card-sub\">Shop All</p>\n      </div>\n    \n    </a>\n\n    <!-- CRICKET -->\n    <a href=\"/collections/cricket\" class=\"sbs-card sbs-card--cricket\">\n      <img class=\"sbs-card-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/2-2.jpg?v=1785757891\" alt=\"Cricket gear\" loading=\"lazy\">\n      <div class=\"sbs-card-overlay\"></div>\n      <div class=\"sbs-card-content\">\n        <span class=\"sbs-card-index\"></span>\n        <h3 class=\"sbs-card-title\">Cricket</h3>\n        <p class=\"sbs-card-sub\">Shop All</p>\n      </div>\n     <!-- <div class=\"sbs-card-bar\">\n        <span>Shop Cricket</span>\n        <svg class=\"sbs-arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M5 12h14M13 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div> -->\n    </a>\n\n    <!-- PICKLEBALL -->\n    <a href=\"/collections/pickleball\" class=\"sbs-card sbs-card--pickleball\">\n      <img class=\"sbs-card-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/3-2.jpg?v=1785757892\" alt=\"Pickleball gear\" loading=\"lazy\">\n      <div class=\"sbs-card-overlay\"></div>\n      <div class=\"sbs-card-content\">\n        <span class=\"sbs-card-index\"></span>\n        <h3 class=\"sbs-card-title\">Pickleball</h3>\n        <p class=\"sbs-card-sub\">Shop All</p>\n      </div>\n     \n    </a>\n\n  </div>\n</section>\n\n<style>\n  .sbs-section{\n    --sbs-black:#0d0d0d;\n    --sbs-white:#ffffff;\n    --sbs-accent:#d8ff3e; /* swap for brand accent if different */\n    padding: 12px 24px;\n    background: transparent;\n    font-family: inherit;\n  }\n\n  .sbs-header{\n    max-width: 1280px;\n    margin: 0 auto 40px;\n    text-align: center;\n  }\n\n  .sbs-eyebrow{\n    display:inline-block;\n    font-size: 12px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #6b6b6b;\n    margin-bottom: 12px;\n    font-weight: 600;\n  }\n\n  .sbs-title{\n    font-size: clamp(32px, 5vw, 56px);\n    line-height: 1.05;\n    color: var(--sbs-black);\n    margin: 0;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    text-transform: uppercase;\n  }\n\n  .sbs-grid{\n    max-width: 1280px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n\n  .sbs-card{\n    position: relative;\n    display: block;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n    border-radius: 16px;\n    text-decoration: none;\n    isolation: isolate;\n    background: #1a1a1a;\n  }\n\n  .sbs-card-img{\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transform: scale(1.04);\n    filter: grayscale(35%) contrast(1.05);\n    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s ease;\n  }\n\n  .sbs-card-overlay{\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(13,13,13,0) 30%, rgba(13,13,13,0.95) 100%);\n    transition: opacity 0.4s ease;\n  }\n\n  .sbs-card-content{\n    position: relative;\n    z-index: 2;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 28px;\n  }\n\n  .sbs-card-index{\n    position: absolute;\n    top: 24px;\n    right: 24px;\n    font-size: 13px;\n    font-weight: 700;\n    color: rgba(255,255,255,0.55);\n    letter-spacing: 0.05em;\n  }\n\n  .sbs-card-title{\n    font-size: 28px;\n    font-weight: 800;\n    color: var(--sbs-white);\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    margin: 0 0 6px;\n  }\n\n  .sbs-card-sub{\n    font-size: 13px;\n    color: rgba(255,255,255,0.7);\n    margin: 0;\n    letter-spacing: 0.02em;\n  }\n\n  .sbs-card-bar{\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    height: 44px;\n    background: var(--sbs-accent);\n    color: var(--sbs-black);\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    transform: translateY(100%);\n    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .sbs-arrow{\n    transition: transform 0.3s ease;\n  }\n\n  /* hover state */\n  .sbs-card:hover .sbs-card-img{\n    transform: scale(1.12);\n    filter: grayscale(0%) contrast(1);\n  }\n  .sbs-card:hover .sbs-card-bar{\n    transform: translateY(0);\n  }\n  .sbs-card:hover .sbs-arrow{\n    transform: translateX(4px);\n  }\n\n  /* tablet */\n  @media (max-width: 900px){\n    .sbs-grid{\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n  }\n\n  /* mobile */\n  @media (max-width: 480px){\n    .sbs-section{\n      padding: 48px 16px;\n    }\n    .sbs-card-content{\n      padding: 20px;\n    }\n    .sbs-card-title{\n      font-size: 22px;\n    }\n  }\n\n  /* touch devices can't hover — keep the bar visible by default */\n  @media (hover: none){\n    .sbs-card-bar{\n      transform: translateY(0);\n    }\n  }\n</style>",
