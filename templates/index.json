rd__text\">\n\n            <span class=\"cat-card__kicker\">\n              Built To Move\n            </span>\n\n            <h3 class=\"cat-card__title\">\n              Apparel\n            </h3>\n\n          </div>\n\n          <span class=\"cat-card__arrow\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </span>\n\n        </div>\n\n      </a>\n\n\n      <!-- =====================================================\n           SHUTTLECOCKS\n      ====================================================== -->\n      <a\n        href=\"/collections/shuttlecocks\"\n        class=\"cat-card cat-card--shuttlecocks\"\n      >\n\n        <div class=\"cat-card__media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/ab9c5376-d9c9-4086-9589-b9144d4151f1.png?v=1787913079\"\n            alt=\"Badminton shuttlecocks\"\n            loading=\"lazy\"\n          >\n\n        </div>\n\n        <div class=\"cat-card__info\">\n\n          <div class=\"cat-card__text\">\n\n            <span class=\"cat-card__kicker\">\n              Built For Flight\n            </span>\n\n            <h3 class=\"cat-card__title\">\n              Shuttlecocks\n            </h3>\n\n          </div>\n\n          <span class=\"cat-card__arrow\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </span>\n\n        </div>\n\n      </a>\n\n\n      <!-- =====================================================\n           ACCESSORIES\n      ====================================================== -->\n      <a\n        href=\"/collections/accessories\"\n        class=\"cat-card cat-card--accessories\"\n      >\n\n        <div class=\"cat-card__media\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/9a6e1c36-e0f4-441f-a63e-3ea8140c510a.png?v=1787909655\"\n            alt=\"Badminton