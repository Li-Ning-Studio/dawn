: grid;\n\n  grid-template-columns:\n    repeat(12, minmax(0, 1fr));\n\n  grid-template-rows:\n    repeat(2, 345px);\n\n  gap: 14px;\n}\n\n\n/* =========================================================\n   DESKTOP POSITIONS\n========================================================= */\n\n/* TOP ROW */\n\n.cat-card--rackets {\n  grid-column: 1 / span 6;\n  grid-row: 1;\n}\n\n.cat-card--shoes {\n  grid-column: 7 / span 3;\n  grid-row: 1;\n}\n\n.cat-card--kitbags {\n  grid-column: 10 / span 3;\n  grid-row: 1;\n}\n\n\n/* BOTTOM ROW */\n\n.cat-card--backpacks {\n  grid-column: 1 / span 3;\n  grid-row: 2;\n}\n\n.cat-card--apparel {\n  grid-column: 4 / span 3;\n  grid-row: 2;\n}\n\n.cat-card--shuttlecocks {\n  grid-column: 7 / span 3;\n  grid-row: 2;\n}\n\n.cat-card--accessories {\n  grid-column: 10 / span 3;\n  grid-row: 2;\n}\n\n\n/* =========================================================\n   UNIFIED PREMIUM COLOR\n========================================================= */\n\n.cat-card--rackets,\n.cat-card--shoes,\n.cat-card--kitbags,\n.cat-card--backpacks,\n.cat-card--apparel,\n.cat-card--shuttlecocks,\n.cat-card--accessories {\n  --card-bg: #f5f8fc;\n}\n\n\n/* =========================================================\n   CARD\n========================================================= */\n\n.cat-card {\n  position: relative;\n\n  min-width: 0;\n\n  display: flex;\n  flex-direction: column;\n\n  overflow: hidden;\n\n  border-radius: 20px;\n\n  background: #ffffff;\n\n  color: #11151a;\n\n  text-decoration: none;\n\n  border:\n    1px solid\n    rgba(35, 65, 105, .07);\n\n  box-shadow:\n    0 2px 10px\n    rgba(20, 35, 55, .022);\n\n  -webkit-tap-highlight-color:\n    transparent;\n\n  transition:\n    transform .35s cubic-bezier(.2,.7,.2,1),\n    box-shadow .35s ease,\n    border-color .35s ease;\n}\n\n\n/* =========================================================\n   MEDIA\n========================================================= */\n\n.cat-card__media {\n  position: relative;\n\n  flex: 1;\n\n  min-height: 0;\n\n  overflow: hidden;\n\n  background: #ffffff;\n}\n\n.cat-card__media img {\n  position: absolute;\n\n  inset: 0;\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  object-position: center;\n\n  transition:\n    transform\n    .75s\n    cubic-bezier(.2,.72,.2,1);\n}\n\n\n/* =========================================================\n   PICTURE SUPPORT\n========================================================= */\n\n.cat-card__media picture {\n  position: absolute;\n\n  inset: 0;\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n}\n\n.cat-card__media picture img {\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  object-position: center;\n}\n\n\n/* =========================================================\n   INDIVIDUAL IMAGE POSITION\n========================================================= */\n\n.cat-card--rackets\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--shoes\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--kitbags\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--backpacks\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--apparel\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--shuttlecocks\n.cat-card__media img {\n  object-position: center center;\n}\n\n.cat-card--accessories\n.cat-card__media img {\n  object-position: center center;\n}\n\n\n/* =========================================================\n   SMALL PREMIUM FADE\n========================================================= */\n\n.cat-card__media::after {\n  content: \"\";\n\n  position: absolute;\n\n  left: 0;\n  right: 0;\n  bottom: 0;\n\n  height: 20px;\n\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      to bottom,\n      rgba(245, 248, 252, 0),\n      rgba(245, 248, 252, .58) 62%,\n      #f5f8fc 100%\n    );\n}\n\n\n/* =========================================================\n   INFO BAR\n========================================================= */\n\n.cat-card__info {\n  position: relative;\n\n  z-index: 3;\n\n  flex: 0 0 auto;\n\n  min-height: 74px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 12px;\n\n  padding:\n    11px\n    15px\n    12px\n    17px;\n\n  background: #f5f8fc;\n}\n\n\n/* RACKETS FEATURE */\n\n.cat-card--wide\n.cat-card__info {\n  min-height: 78px;\n\n  padding-left: 22px;\n  padding-right: 17px;\n}\n\n\n/* =========================================================\n   TEXT\n========================================================= */\n\n.cat-card__text {\n  min-width: 0;\n}\n\n.cat-card__kicker {\n  display: block;\n\n  margin-bottom: 4px;\n\n  color:\n    rgba(31, 45, 61, .50);\n\n  font-size: 8.5px;\n\n  line-height: 1.15;\n\n  font-weight: 600;\n\n  letter-spacing: .15px;\n}\n\n.cat-card__title {\n  margin: 0;\n\n  color: #11151a;\n\n  font-size:\n    clamp(\n      18px,\n      1.55vw,\n      24px\n    );\n\n  line-height: 1;\n\n  font-weight: 750;\n\n  letter-spacing: -.7px;\n}\n\n.cat-card--wide\n.cat-card__title {\n  font-size:\n    clamp(\n      24px,\n      2vw,\n      30px\n    );\n}\n\n\n/* =========================================================\n   ACTION\n========================================================= */\n\n.cat-card__action {\n  flex: 0 0 auto;\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 9px;\n}\n\n.cat-card__action-text {\n  color: #292929;\n\n  font-size: 8.5px;\n\n  line-height: 1;\n\n  font-weight: 700;\n\n  text-transform: uppercase;\n\n  letter-spacing: .8px;\n}\n\n\n/* =========================================================\n   ARROW\n========================================================= */\n\n.cat-card__arrow {\n  flex: 0 0 36px;\n\n  width: 36px;\n  height: 36px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: #ffffff;\n\n  color: #11151a;\n\n  border:\n    1px solid\n    rgba(24, 49, 80, .07);\n\n  box-shadow:\n    0 3px 10px\n    rgba(20, 35, 55, .03);\n\n  transition:\n    transform .3s ease,\n    background .3s ease,\n    color .3s ease,\n    box-shadow .3s ease;\n}\n\n.cat-card__arrow svg {\n  width: 14px;\n  height: 14px;\n\n  fill: none;\n\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* =========================================================\n   DESKTOP HOVER\n========================================================= */\n\n@media\n(hover:hover)\nand\n(pointer:fine) {\n\n  .cat-card:hover {\n    transform:\n      translateY(-4px);\n\n    border-color:\n      rgba(27,60,100,.12);\n\n    box-shadow:\n      0 16px 38px\n      rgba(25,45,70,.065);\n  }\n\n  .cat-card:hover\n  .cat-card__media img {\n    transform:\n      scale(1.025);\n  }\n\n  .cat-card:hover\n  .cat-card__arrow {\n    transform:\n      translateX(2px);\n\n    background: #11151a;\n\n    color: #ffffff;\n\n    box-shadow:\n      0 5px 14px\n      rgba(17,21,26,.12);\n  }\n\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media\nscreen and\n(max-width: 1000px) {\n\n  .cat-premium {\n    padding:\n      62px\n      18px\n      70px;\n  }\n\n  .cat-premium__grid {\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    grid-template-rows: none;\n\n    gap: 12px;\n  }\n\n  .cat-card,\n  .cat-card--wide {\n    grid-column:\n      auto !important;\n\n    grid-row:\n      auto !important;\n\n    height: 320px;\n  }\n\n\n  /* RACKETS FULL WIDTH */\n\n  .cat-card--rackets {\n    grid-column:\n      1 / -1 !important;\n\n    height: 355px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media\nscreen and\n(max-width: 600px) {\n\n  .cat-premium {\n    padding:\n      46px\n      12px\n      54px;\n  }\n\n\n  /* HEADER */\n\n  .cat-premium__header {\n    margin-bottom: 26px;\n  }\n\n  .cat-premium__eyebrow {\n    margin-bottom: 9px;\n\n    font-size: 8px;\n\n    letter-spacing: 1.6px;\n  }\n\n  .cat-premium__title {\n    font-size: 34px;\n\n    letter-spacing: -1.7px;\n  }\n\n  .cat-premium__intro {\n    max-width: 290px;\n\n    margin-top: 11px;\n\n    font-size: 12px;\n  }\n\n\n  /* GRID */\n\n  .cat-premium__grid {\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap: 8px;\n  }\n\n\n  /* CARDS */\n\n  .cat-card,\n  .cat-card--wide {\n    height: 265px;\n\n    border-radius: 15px;\n\n    grid-column:\n      auto !important;\n  }\n\n\n  /* RACKETS FEATURE */\n\n  .cat-card--rackets {\n    grid-column:\n      1 / -1 !important;\n\n    height: 310px;\n  }\n\n\n  /* MOBILE RACKET IMAGE */\n\n  .cat-card--rackets\n  .cat-card__media picture img {\n    object-position: center center;\n  }\n\n\n  /* FADE */\n\n  .cat-card__media::after {\n    height: 14px;\n  }\n\n\n  /* INFO */\n\n  .cat-card__info,\n  .cat-card--wide\n  .cat-card__info {\n\n    min-height: 64px;\n\n    padding:\n      9px\n      9px\n      10px\n      11px;\n  }\n\n\n  /* TEXT */\n\n  .cat-card__kicker {\n    margin-bottom: 3px;\n\n    font-size: 7px;\n  }\n\n  .cat-card__title,\n  .cat-card--wide\n  .cat-card__title {\n\n    font-size: 15px;\n\n    letter-spacing: -.45px;\n  }\n\n  .cat-card--rackets\n  .cat-card__title {\n\n    font-size: 21px;\n  }\n\n\n  /* HIDE SHOP TEXT */\n\n  .cat-card__action-text {\n    display: none;\n  }\n\n\n  /* ARROW */\n\n  .cat-card__arrow {\n    flex-basis: 30px;\n\n    width: 30px;\n    height: 30px;\n  }\n\n  .cat-card__arrow svg {\n    width: 12px;\n    height: 12px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media\nscreen and\n(max-width: 370px) {\n\n  .cat-premium {\n    padding-left: 9px;\n    padding-right: 9px;\n  }\n\n  .cat-premium__grid {\n    gap: 7px;\n  }\n\n  .cat-card,\n  .cat-card--wide {\n    height: 245px;\n  }\n\n  .cat-card--rackets {\n    height: 290px;\n  }\n\n  .cat-card__title,\n  .cat-card--wide\n  .cat-card__title {\n    font-size: 14px;\n  }\n\n  .cat-card--rackets\n  .cat-card__title {\n    font-size: 20px;\n  }\n\n}\n\n</style>",
