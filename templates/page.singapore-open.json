    "custom_liquid_kJF3aJ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SWIPEABLE PORTRAIT IMAGE SLIDER — 21 images\n     Shopify: Themes > Customize > Add Section > Custom HTML\n     Desktop: 4 visible | Tablet: 2 visible | Mobile: 1 visible\n================================================================ -->\n\n<style>\n  .sv-slider {\n    position: relative;\n    user-select: none;\n  }\n\n  .sv-slider__track-wrapper {\n    overflow: hidden;\n    cursor: grab;\n  }\n\n  .sv-slider__track-wrapper:active {\n    cursor: grabbing;\n  }\n\n  .sv-slider__track {\n    display: flex;\n    gap: 16px;\n    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    will-change: transform;\n  }\n\n  .sv-slider__track.is-dragging {\n    transition: none;\n  }\n\n  /* Desktop: 4 visible */\n  .sv-slider__slide {\n    flex: 0 0 calc((100% - 48px) / 4);\n    min-width: 0;\n  }\n\n  /* Tablet: 2 visible */\n  @media (max-width: 900px) {\n    .sv-slider__slide {\n      flex: 0 0 calc((100% - 16px) / 2);\n    }\n  }\n\n  /* Mobile: 1 visible */\n  @media (max-width: 540px) {\n    .sv-slider__slide {\n      flex: 0 0 100%;\n    }\n    .sv-slider__track {\n      gap: 0;\n    }\n  }\n\n  .sv-slider__slide img {\n    width: 100%;\n    height: auto;\n    display: block;\n    aspect-ratio: 3 / 4;\n    object-fit: cover;\n    pointer-events: none;\n    -webkit-user-drag: none;\n  }\n\n  /* ── Arrows ── */\n  .sv-slider__arrow {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 40px;\n    height: 40px;\n    background: rgba(0, 0, 0, 0.5);\n    border: none;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    z-index: 10;\n    transition: background 0.2s;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .sv-slider__arrow:hover {\n    background: rgba(0, 0, 0, 0.8);\n  }\n\n  .sv-slider__arrow svg {\n    width: 18px;\n    height: 18px;\n    display: block;\n  }\n\n  .sv-slider__arrow--prev { left: 8px; }\n  .sv-slider__arrow--next { right: 8px; }\n\n  @media (max-width: 540px) {\n    .sv-slider__arrow--prev { left: 8px; }\n    .sv-slider__arrow--next { right: 8px; }\n  }\n\n  /* ── Dots ── */\n  .sv-slider__dots {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 6px;\n    margin-top: 16px;\n    flex-wrap: wrap;\n  }\n\n  .sv-slider__dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: rgba(253, 253, 253, 0.2);\n    border: none;\n    cursor: pointer;\n    padding: 0;\n    transition: background 0.2s, width 0.25s;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .sv-slider__dot.is-active {\n    background: #F5C500;\n    width: 22px;\n    border-radius: 4px;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-slider__track { transition: none; }\n  }\n</style>\n\n<div class=\"sv-slider\" id=\"sv-slider\">\n\n  <div class=\"sv-slider__track-wrapper\" id=\"sv-wrapper\">\n    <div class=\"sv-slider__track\" id=\"sv-track\">\n\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_433dadd7-e767-43d8-8b0f-a031f9c6aff1.jpg?v=1781778522&width=400\" alt=\"Photo 1\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_2_0de66b80-9032-4083-a6e0-4ef4cc4beb30.jpg?v=1781778522&width=400\" alt=\"Photo 2\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_3_88e05dbc-2b9a-4594-9d8c-237b9249b967.jpg?v=1781778522&width=400\" alt=\"Photo 3\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_4_0d9ec949-e85e-444a-8b85-6542a5304565.jpg?v=1781778522&width=400\" alt=\"Photo 4\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_5_c2f97d04-7ad8-446a-ae20-eba890bc0598.jpg?v=1781778522&width=400\" alt=\"Photo 5\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_6_13c2bfe9-9760-4e21-8861-ffb36e2e1a8c.jpg?v=1781778523&width=400\" alt=\"Photo 6\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_7_24aaddb4-6be9-4560-b887-922520d1abd1.jpg?v=1781778523&width=400\" alt=\"Photo 7\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_8.jpg?v=1781778522&width=400\" alt=\"Photo 8\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_9_2ef72aa8-f5f7-4303-aa24-56c226559087.jpg?v=1781778522&width=400\" alt=\"Photo 9\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_10_f6170f95-c7c4-4cd5-a283-154c6a10ddec.jpg?v=1781778522&width=400\" alt=\"Photo 10\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_11.jpg?v=1781778523&width=400\" alt=\"Photo 11\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_12.jpg?v=1781778522&width=400\" alt=\"Photo 12\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_13.jpg?v=1781778522&width=400\" alt=\"Photo 13\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_14.jpg?v=1781778522&width=400\" alt=\"Photo 14\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_15.jpg?v=1781778522&width=400\" alt=\"Photo 15\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_16.jpg?v=1781778522&width=400\" alt=\"Photo 16\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_17.jpg?v=1781778522&width=400\" alt=\"Photo 17\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_18.jpg?v=1781778522&width=400\" alt=\"Photo 18\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_19.jpg?v=1781778522&width=400\" alt=\"Photo 19\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_20.jpg?v=1781778522&width=400\" alt=\"Photo 20\" loading=\"lazy\"></div>\n      <div class=\"sv-slider__slide\"><img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_21.jpg?v=1781778522&width=400\" alt=\"Photo 21\" loading=\"lazy\"></div>\n\n    </div>\n  </div>\n\n  <button class=\"sv-slider__arrow sv-slider__arrow--prev\" id=\"sv-prev\" aria-label=\"Previous\">\n    <svg viewBox=\"0 0 18 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M11 4L6.5 9 11 14\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n  </button>\n\n  <button class=\"sv-slider__arrow sv-slider__arrow--next\" id=\"sv-next\" aria-label=\"Next\">\n    <svg viewBox=\"0 0 18 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M7 4l4.5 5L7 14\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n  </button>\n\n</div>\n\n<div class=\"sv-slider__dots\" id=\"sv-dots\"></div>\n\n<script>\n(function () {\n\n  var wrapper  = document.getElementById('sv-wrapper');\n  var track    = document.getElementById('sv-track');\n  var dotsWrap = document.getElementById('sv-dots');\n  var prevBtn  = document.getElementById('sv-prev');\n  var nextBtn  = document.getElementById('sv-next');\n  var slides   = Array.prototype.slice.call(track.querySelectorAll('.sv-slider__slide'));\n  var total    = slides.length;\n  var current  = 0;\n\n  function visibleCount() {\n    var w = window.innerWidth;\n    if (w <= 540) return 1;\n    if (w <= 900) return 2;\n    return 4;\n  }\n\n  function stepCount() {\n    return Math.ceil(total / visibleCount());\n  }\n\n  function slideWidth() {\n    var gap = window.innerWidth <= 540 ? 0 : 16;\n    return slides[0].offsetWidth + gap;\n  }\n\n  function buildDots() {\n    dotsWrap.innerHTML = '';\n    var steps = stepCount();\n    for (var i = 0; i < steps; i++) {\n      var dot = document.createElement('button');\n      dot.className = 'sv-slider__dot' + (i === 0 ? ' is-active' : '');\n      dot.setAttribute('aria-label', 'Group ' + (i + 1));\n      dot.dataset.i = i;\n      dot.addEventListener('click', function (e) { goTo(+e.currentTarget.dataset.i); });\n      dotsWrap.appendChild(dot);\n    }\n  }\n\n  function goTo(n) {\n    var steps = stepCount();\n    if (n < 0) n = steps - 1;\n    if (n >= steps) n = 0;\n    current = n;\n    var slideIndex = current * visibleCount();\n    track.style.transform = 'translateX(-' + (slideIndex * slideWidth()) + 'px)';\n    dotsWrap.querySelectorAll('.sv-slider__dot').forEach(function (d, i) {\n      d.classList.toggle('is-active', i === current);\n    });\n  }\n\n  prevBtn.addEventListener('click', function () { goTo(current - 1); });\n  nextBtn.addEventListener('click', function () { goTo(current + 1); });\n\n  var resizeTimer;\n  window.addEventListener('resize', function () {\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(function () { buildDots(); goTo(0); }, 150);\n  });\n\n  /* Touch swipe */\n  var touchStartX = 0;\n  var touchStartY = 0;\n  var isScrolling = null;\n\n  track.addEventListener('touchstart', function (e) {\n    touchStartX = e.touches[0].clientX;\n    touchStartY = e.touches[0].clientY;\n    isScrolling = null;\n  }, { passive: true });\n\n  track.addEventListener('touchmove', function (e) {\n    var dx = e.touches[0].clientX - touchStartX;\n    var dy = e.touches[0].clientY - touchStartY;\n    if (isScrolling === null) isScrolling = Math.abs(dy) > Math.abs(dx);\n    if (!isScrolling) {\n      e.preventDefault();\n      track.classList.add('is-dragging');\n      var basePx = current * visibleCount() * slideWidth();\n      track.style.transform = 'translateX(' + (-basePx + dx) + 'px)';\n    }\n  }, { passive: false });\n\n  track.addEventListener('touchend', function (e) {\n    var dx = e.changedTouches[0].clientX - touchStartX;\n    track.classList.remove('is-dragging');\n    if (!isScrolling) {\n      if (dx < -50) goTo(current + 1);\n      else if (dx > 50) goTo(current - 1);\n      else goTo(current);\n    }\n  });\n\n  /* Mouse drag */\n  var mouseStartX = 0;\n  var mouseDX     = 0;\n  var isDragging  = false;\n\n  track.addEventListener('mousedown', function (e) {\n    mouseStartX = e.clientX;\n    isDragging  = true;\n    track.classList.add('is-dragging');\n    e.preventDefault();\n  });\n\n  window.addEventListener('mousemove', function (e) {\n    if (!isDragging) return;\n    mouseDX = e.clientX - mouseStartX;\n    var basePx = current * visibleCount() * slideWidth();\n    track.style.transform = 'translateX(' + (-basePx + mouseDX) + 'px)';\n  });\n\n  window.addEventListener('mouseup', function () {\n    if (!isDragging) return;\n    isDragging = false;\n    track.classList.remove('is-dragging');\n    if (mouseDX < -50) goTo(current + 1);\n    else if (mouseDX > 50) goTo(current - 1);\n    else goTo(current);\n    mouseDX = 0;\n  });\n\n  buildDots();\n  goTo(0);\n\n})();\n</script>",
