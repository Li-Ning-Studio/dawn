    "custom_liquid_LtnTJg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- 05 · HOW IT WORKS · standalone · namespace: cast-how -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  .cast-how {\n    --bg: #0a0a0a; --card: #151515; --line: #2a2a2a; --text: #f5f5f5; --mute: #a3a3a3; --accent: #FDA401;\n    padding: 72px 0;\n    border-top: 1px solid var(--line);\n    background: var(--bg); color: var(--text);\n    font-family: Inter, system-ui, sans-serif; line-height: 1.55;\n    -webkit-font-smoothing: antialiased; overflow-wrap: break-word;\n  }\n  :where(.cast-how *) { margin: 0; box-sizing: border-box; }\n  .cast-how__inner { max-width: 1080px; margin: 0 auto; padding: 0 20px; }\n  .cast-how__tag {\n    display: inline-block; margin-bottom: 14px;\n    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);\n  }\n  .cast-how__title {\n    margin-bottom: 28px;\n    font: 800 clamp(34px, 6vw, 60px)/.95 \"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif;\n    text-transform: uppercase; letter-spacing: .01em;\n  }\n\n  .cast-how__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 0; list-style: none; counter-reset: step; }\n  .cast-how__step { padding-top: 18px; border-top: 2px solid var(--accent); counter-increment: step; }\n  .cast-how__step::before {\n    content: \"0\" counter(step);\n    font: 800 36px/1 \"Barlow Condensed\", Impact, sans-serif; color: var(--accent);\n  }\n  .cast-how__name { display: block; margin: 4px 0; font-size: 18px; }\n  .cast-how__text { font-size: 15px; color: var(--mute); }\n\n  @media (min-width: 1400px) { .cast-how__inner { max-width: 1240px; } }\n  @media (max-width: 960px)  { .cast-how__inner { padding: 0 24px; } }\n  @media (max-width: 720px) {\n    .cast-how {\n      padding: 52px 0;\n    }\n    .cast-how__inner {\n      padding: 0 18px;\n    }\n    .cast-how__steps {\n      grid-template-columns: 1fr;\n      gap: 22px;\n    }\n  }\n</style>\n\n<section class=\"cast-how\">\n  <div class=\"cast-how__inner\">\n    <span class=\"cast-how__tag\">How it works</span>\n    <h2 class=\"cast-how__title\">Three steps.</h2>\n    <ol class=\"cast-how__steps\">\n      <li class=\"cast-how__step\"><b class=\"cast-how__name\">Apply</b><p class=\"cast-how__text\">Fill in the application form with your details and sport.</p></li>\n      <li class=\"cast-how__step\"><b class=\"cast-how__name\">Get shortlisted</b><p class=\"cast-how__text\">Our team reviews applications and reaches out to selected players.</p></li>\n      <li class=\"cast-how__step\"><b class=\"cast-how__name\">Hit the shoot</b><p class=\"cast-how__text\">Show up for the shoot.</p></li>\n    </ol>\n  </div>\n</section>",
        "color_scheme": "scheme-4",
