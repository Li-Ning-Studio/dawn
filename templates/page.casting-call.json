    "custom_liquid_hrTk3r": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- 08 · TERMS & CONDITIONS · standalone · namespace: cast-terms -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  .cast-terms {\n    --bg: #0a0a0a; --card: #151515; --line: #2a2a2a; --text: #f5f5f5; --mute: #a3a3a3; --accent: #FDA401;\n    padding: 72px 0;\n    border-top: 1px solid var(--line);\n    background: var(--bg); color: var(--text);\n    font-family: Inter, system-ui, sans-serif; line-height: 1.55;\n    -webkit-font-smoothing: antialiased; overflow-wrap: break-word;\n  }\n  :where(.cast-terms *) { margin: 0; box-sizing: border-box; }\n\n  .cast-terms__inner { max-width: 1080px; margin: 0 auto; padding: 0 20px; }\n  .cast-terms__tag {\n    display: inline-block; margin-bottom: 14px;\n    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);\n  }\n  .cast-terms__title {\n    margin-bottom: 28px;\n    font: 800 clamp(34px, 6vw, 60px)/.95 \"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif;\n    text-transform: uppercase; letter-spacing: .01em;\n  }\n\n  .cast-terms__list {\n    max-width: 760px; padding: 8px 28px;\n    background: var(--card); border: 1px solid var(--line); border-radius: 10px;\n    list-style: none; counter-reset: term;\n  }\n  .cast-terms__item {\n    display: flex; gap: 16px; padding: 20px 0;\n    border-bottom: 1px solid var(--line);\n    font-size: 16px; counter-increment: term;\n  }\n  .cast-terms__item:last-child { border-bottom: 0; }\n  .cast-terms__item::before {\n    content: counter(term, decimal-leading-zero);\n    flex: none; min-width: 28px;\n    font: 800 22px/1.2 \"Barlow Condensed\", Impact, sans-serif; color: var(--accent);\n  }\n\n  @media (min-width: 1400px) { .cast-terms__inner { max-width: 1240px; } }\n  @media (max-width: 960px)  { .cast-terms__inner { padding: 0 24px; } }\n  @media (max-width: 720px) {\n    .cast-terms {\n      padding: 52px 0;\n    }\n    .cast-terms__inner {\n      padding: 0 18px;\n    }\n    .cast-terms__list {\n      padding: 4px 18px;\n    }\n    .cast-terms__item {\n      gap: 12px;\n      font-size: 15px;\n    }\n  }\n</style>\n\n<section class=\"cast-terms\">\n  <div class=\"cast-terms__inner\">\n    <span class=\"cast-terms__tag\">Before you apply</span>\n    <h2 class=\"cast-terms__title\">Terms &amp; conditions</h2>\n    <ol class=\"cast-terms__list\">\n      <li class=\"cast-terms__item\">HNDRD will use your videos and photos for marketing purposes.</li>\n     \n      <li class=\"cast-terms__item\">All HNDRD promotional material is confidential.</li>\n    </ol>\n  </div>\n</section>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
