      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- 06-faq | scoped namespace: cast- | standalone Shopify section -->\n<style>\n.cast-sec{--bg:#0a0a0a;--card:#141414;--line:#262626;--tx:#f4f4f2;--mut:#9a9a96;--acc:#d7ff1f;--acc-tx:#0a0a0a;background:var(--bg);color:var(--tx);font-family:\"Inter\",\"Helvetica Neue\",Arial,sans-serif;line-height:1.55;padding:72px 0;border-top:1px solid var(--line);-webkit-font-smoothing:antialiased}\n.cast-sec *,.cast-sec *::before,.cast-sec *::after{box-sizing:border-box}\n.cast-sec h1,.cast-sec h2,.cast-sec h3,.cast-sec p,.cast-sec ul{margin:0}\n.cast-wrap{max-width:1080px;margin:0 auto;padding:0 20px}\n.cast-sec h2{font-size:clamp(30px,5vw,52px);line-height:1;font-weight:900;text-transform:uppercase;letter-spacing:-.02em;margin-bottom:12px;color:var(--tx)}\n.cast-lead{color:var(--mut);max-width:560px;margin-bottom:40px}\n.cast-btn{display:inline-block;background:var(--acc);color:var(--acc-tx);font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:14px;padding:16px 28px;border-radius:4px;text-decoration:none;border:0;cursor:pointer;font-family:inherit}\n.cast-btn:hover{filter:brightness(1.08)}\n.cast-faq{margin-top:24px}\n.cast-faq details{border-bottom:1px solid var(--line);padding:18px 0}\n.cast-faq summary{cursor:pointer;font-weight:700;font-size:17px;list-style:none;display:flex;justify-content:space-between;gap:16px;color:var(--tx)}\n.cast-faq summary::-webkit-details-marker{display:none}\n.cast-faq summary::after{content:\"+\";color:var(--acc);font-size:22px;line-height:1}\n.cast-faq details[open] summary::after{content:\"\\2013\"}\n.cast-faq details p{color:var(--mut);margin-top:10px;max-width:640px}\n</style>\n\n<section class=\"cast-sec cast-faqsec\">\n  <div class=\"cast-wrap\">\n<h2>FAQs</h2>\n    <div class=\"cast-faq\">\n      <details><summary>Do I need to be a professional player?</summary><p>No. We care about how you play and how you carry yourself. Club, academy and district players are all welcome.</p></details>\n      <details><summary>Is this paid?</summary><p>Yes. Shoots are paid, and you also get exposure and a certificate. Details are shared at shortlist stage.</p></details>\n      <details><summary>Where are the shoots?</summary><p>All shoots are in Bengaluru. This casting is open only to players based in Bengaluru.</p></details>\n      <details><summary>What is the age requirement?</summary><p>You must be 18 or older to apply.</p></details>\n    </div>\n  </div>\n</section>",
