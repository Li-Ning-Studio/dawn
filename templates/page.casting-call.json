ding: 0 18px;\n    }\n    .cast-sports__grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n    .cast-sports__card {\n      padding: 22px;\n    }\n    .cast-sports__name {\n      font-size: 36px;\n    }\n  }\n</style>\n\n<section class=\"cast-sports\">\n  <div class=\"cast-sports__inner\">\n    <span class=\"cast-sports__tag\">Who we're looking for</span>\n    <h2 class=\"cast-sports__title\">Two games.<br>One shoot.</h2>\n    <div class=\"cast-sports__grid\">\n      <div class=\"cast-sports__card\">\n        <div class=\"cast-sports__name\">Badminton</div>\n        <p class=\"cast-sports__text\">Club players, academy players, weekend warriors. If you're on court regularly, apply.</p>\n      </div>\n      <div class=\"cast-sports__card\">\n        <div class=\"cast-sports__name\">Cricket</div>\n        <p class=\"cast-sports__text\">Batters, bowlers, all-rounders. Gully to league, we want people who genuinely play.</p>\n      </div>\n    </div>\n  </div>\n</section>",
