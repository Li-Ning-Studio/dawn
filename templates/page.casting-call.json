r { padding: 0 24px; } }\n  @media (max-width: 720px) {\n    .cast-perks {\n      padding: 52px 0;\n    }\n    .cast-perks__inner {\n      padding: 0 18px;\n    }\n    .cast-perks__grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n  }\n</style>\n\n<section class=\"cast-perks\">\n  <div class=\"cast-perks__inner\">\n    <span class=\"cast-perks__tag\">What you get</span>\n    <h2 class=\"cast-perks__title\">Show up. Get paid.<br>Get seen.</h2>\n    <div class=\"cast-perks__grid\">\n      <div class=\"cast-perks__card\">\n        <b class=\"cast-perks__label\">Paid shoot</b>\n        <p class=\"cast-perks__text\">This is a paid gig, not a favour for exposure.</p>\n      </div>\n      <div class=\"cast-perks__card\">\n        <b class=\"cast-perks__label\">Exposure</b>\n        <p class=\"cast-perks__text\">Your face on Hundred's campaigns and channels.</p>\n      </div>\n      <div class=\"cast-perks__card\">\n        <b class=\"cast-perks__label\">Certificate</b>\n        <p class=\"cast-perks__text\">An official certificate for taking part in the shoot.</p>\n      </div>\n    </div>\n  </div>\n</section>",
