        "custom_liquid": "<!-- 04 · ELIGIBILITY · standalone · namespace: cast-elig -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  .cast-elig {\n    --bg: #0a0a0a; --card: #151515; --line: #2a2a2a; --text: #f5f5f5; --mute: #a3a3a3; --accent: #FDA401;\n    padding: 72px 0;\n    border-top: 1px solid var(--line);\n    background: var(--bg); color: var(--text);\n    font-family: Inter, system-ui, sans-serif; line-height: 1.55;\n    -webkit-font-smoothing: antialiased; overflow-wrap: break-word;\n  }\n  :where(.cast-elig *) { margin: 0; box-sizing: border-box; }\n  .cast-elig__inner { max-width: 1080px; margin: 0 auto; padding: 0 20px; }\n  .cast-elig__tag {\n    display: inline-block; margin-bottom: 14px;\n    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);\n  }\n  .cast-elig__title {\n    margin-bottom: 28px;\n    font: 800 clamp(34px, 6vw, 60px)/.95 \"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif;\n    text-transform: uppercase; letter-spacing: .01em;\n  }\n\n  .cast-elig__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: center; }\n  .cast-elig__item { padding: 28px 12px; border: 1px solid var(--line); border-radius: 10px; }\n  .cast-elig__value {\n    display: block;\n    font: 800 clamp(28px, 5vw, 48px)/1 \"Barlow Condensed\", Impact, sans-serif; text-transform: uppercase; color: var(--accent);\n  }\n  .cast-elig__label { font-size: 14px; color: var(--mute); }\n\n  @media (min-width: 1400px) { .cast-elig__inner { max-width: 1240px; } }\n  @media (max-width: 960px)  { .cast-elig__inner { padding: 0 24px; } }\n  @media (max-width: 720px) {\n    .cast-elig {\n      padding: 52px 0;\n    }\n    .cast-elig__inner {\n      padding: 0 18px;\n    }\n    .cast-elig__grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n    .cast-elig__item {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 12px;\n      padding: 18px 20px;\n      text-align: left;\n    }\n    .cast-elig__value {\n      font-size: 34px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    .cast-elig__item {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 2px;\n    }\n  }\n</style>\n\n<section class=\"cast-elig\">\n  <div class=\"cast-elig__inner\">\n    <span class=\"cast-elig__tag\">Eligibility</span>\n    <h2 class=\"cast-elig__title\">Check these three.</h2>\n    <div class=\"cast-elig__grid\">\n      <div class=\"cast-elig__item\"><strong class=\"cast-elig__value\">Above 18</strong><span class=\"cast-elig__label\">Age on the day you apply</span></div>\n      <div class=\"cast-elig__item\"><strong class=\"cast-elig__value\">Bengaluru</strong><span class=\"cast-elig__label\">Based in the city</span></div>\n      <div class=\"cast-elig__item\"><strong class=\"cast-elig__value\">Player</strong><span class=\"cast-elig__label\">Badminton or cricket</span></div>\n    </div>\n  </div>\n</section>",
