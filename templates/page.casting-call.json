x; margin-top: 36px; padding: 0; list-style: none; }\n  .cast-hero__chip { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 14px; font-weight: 500; }\n\n  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .cast-hero__btn { transition: none; } }\n  @media (min-width: 1400px) { .cast-hero__inner { max-width: 1240px; } }\n  @media (max-width: 960px)  { .cast-hero { padding: 72px 0 64px; } .cast-hero__inner { padding: 0 24px; } }\n  @media (max-width: 720px) {\n    .cast-hero { padding: 56px 0 48px; }\n    .cast-hero__inner { padding: 0 18px; }\n    .cast-hero__text { margin-bottom: 26px; }\n    .cast-hero__btn { display: block; width: 100%; text-align: center; }\n    .cast-hero__chips { margin-top: 28px; gap: 8px; }\n    .cast-hero__chip { padding: 6px 13px; font-size: 13px; }\n  }\n</style>\n\n<section class=\"cast-hero\">\n  <div class=\"cast-hero__inner\">\n    <span class=\"cast-hero__tag\">Casting call · Bengaluru</span>\n    <h1 class=\"cast-hero__title\">Get cast<br>by <span class=\"cast-hero__accent\">HNDRD</span></h1>\n    <p class=\"cast-hero__text\">We're casting badminton and cricket players for our next shoot. If you play, live in Bengaluru and are 18 or older, this is for you.</p>\n    <a class=\"cast-hero__btn\" href=\"#apply\">Apply now</a>\n    <ul class=\"cast-hero__chips\">\n      <li class=\"cast-hero__chip\">Badminton</li>\n      <li class=\"cast-hero__chip\">Cricket</li>\n      <li class=\"cast-hero__chip\">Above 18</li>\n      <li class=\"cast-hero__chip\">Bengaluru only</li>\n    </ul>\n  </div>\n</section>",
