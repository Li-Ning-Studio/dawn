    "custom_liquid_fUNC3B": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- =========================================================\n  PREMIUM RESPONSIVE SLIDESHOW\n\n  BANNER\n  ↓\n  CENTERED TITLE / DESCRIPTION\n  ↓\n  CTA\n  ↓\n  NAVIGATION\n\n  NO VISIBLE BORDERS\n========================================================= -->\n\n<style>\n\n#hndrd-slider-{{ section.id }} {\n  --slide-duration: 5000ms;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  margin: 0;\n  padding: 0;\n\n  border: 0 !important;\n  outline: 0 !important;\n\n  background: #000;\n}\n\n\n#hndrd-slider-{{ section.id }} *,\n#hndrd-slider-{{ section.id }} *::before,\n#hndrd-slider-{{ section.id }} *::after {\n  box-sizing: border-box;\n}\n\n\n.hndrd-slider {\n  position: relative;\n\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  overflow: hidden;\n\n  border: 0 !important;\n  outline: 0 !important;\n\n  background: #000;\n}\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hndrd-slider__track {\n  position: relative;\n\n  width: 100%;\n\n  margin: 0;\n\n  border: 0 !important;\n  outline: 0 !important;\n}\n\n\n/* =========================================================\n   SLIDE\n========================================================= */\n\n.hndrd-slider__slide {\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  opacity: 0;\n\n  visibility: hidden;\n\n  pointer-events: none;\n\n  border: 0 !important;\n  outline: 0 !important;\n\n  transition:\n    opacity .55s ease,\n    visibility .55s ease;\n}\n\n\n.hndrd-slider__slide.is-active {\n  position: relative;\n\n  opacity: 1;\n\n  visibility: visible;\n\n  pointer-events: auto;\n\n  z-index: 2;\n}\n\n\n/* =========================================================\n   BANNER\n========================================================= */\n\n.hndrd-slider__media {\n  position: relative;\n\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  overflow: hidden;\n\n  background: #111;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  box-shadow: none !important;\n}\n\n\n/* IMAGE */\n\n.hndrd-slider__image {\n  display: block;\n\n  width: 100%;\n\n  height: auto;\n\n  margin: 0;\n  padding: 0;\n\n  object-fit: cover;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  box-shadow: none !important;\n}\n\n\n.hndrd-slider__image--mobile {\n  display: none;\n}\n\n\n/* =========================================================\n   BLACK CONTENT SECTION\n========================================================= */\n\n.hndrd-slider__content {\n  position: relative;\n\n  width: 100%;\n\n  padding:\n    32px\n    24px\n    28px;\n\n  background: #000;\n\n  color: #fff;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n}\n\n\n.hndrd-slider__content-inner {\n  width: 100%;\n\n  max-width: 820px;\n\n  margin: 0 auto;\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n\n  text-align: center;\n}\n\n\n/* =========================================================\n   EYEBROW\n========================================================= */\n\n.hndrd-slider__eyebrow {\n  margin:\n    0\n    0\n    8px;\n\n  color:\n    rgba(\n      255,\n      255,\n      255,\n      .55\n    );\n\n  font-size: 10px;\n\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: 2px;\n\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   TITLE\n========================================================= */\n\n.hndrd-slider__heading {\n  max-width: 780px;\n\n  margin: 0;\n\n  color: #fff;\n\n  font-size:\n    clamp(\n      34px,\n      4vw,\n      58px\n    );\n\n  line-height: .96;\n\n  font-weight: 800;\n\n  letter-spacing: -2.2px;\n}\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.hndrd-slider__text {\n  max-width: 600px;\n\n  margin-top: 11px;\n\n  color:\n    rgba(\n      255,\n      255,\n      255,\n      .68\n    );\n\n  font-size: 14px;\n\n  line-height: 1.5;\n}\n\n\n/* =========================================================\n   CTA\n========================================================= */\n\n.hndrd-slider__cta {\n  display: inline-flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  min-width: 124px;\n\n  min-height: 41px;\n\n  margin-top: 17px;\n\n  padding:\n    10px\n    20px;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  border-radius: 999px;\n\n  background: #fff;\n\n  color: #111;\n\n  text-decoration: none;\n\n  font-size: 10px;\n\n  line-height: 1;\n\n  font-weight: 750;\n\n  letter-spacing: .5px;\n\n  box-shadow: none;\n\n  transition:\n    transform .25s ease,\n    background .25s ease;\n}\n\n\n.hndrd-slider__cta:hover {\n  transform:\n    translateY(-2px);\n\n  background: #ededed;\n}\n\n\n/* no ugly link outline */\n\n.hndrd-slider__cta:focus,\n.hndrd-slider__cta:active {\n  outline: 0 !important;\n\n  border: 0 !important;\n}\n\n\n/* =========================================================\n   NAVIGATION WRAPPER\n========================================================= */\n\n.hndrd-slider__controls-wrap {\n  width: 100%;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  margin-top: 18px;\n}\n\n\n/* =========================================================\n   NAVIGATION PILL\n========================================================= */\n\n.hndrd-slider__controls {\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 8px;\n\n  padding:\n    7px\n    7px\n    7px\n    12px;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  border-radius: 999px;\n\n  background:\n    rgba(\n      30,\n      31,\n      36,\n      .94\n    );\n\n  box-shadow:\n    0 7px 24px\n    rgba(\n      0,\n      0,\n      0,\n      .32\n    );\n\n  overflow: hidden;\n}\n\n\n/* =========================================================\n   PAGINATION\n========================================================= */\n\n.hndrd-slider__pagination {\n  display: flex;\n\n  align-items: center;\n\n  gap: 6px;\n}\n\n\n/* normal indicator */\n\n.hndrd-slider__dot {\n  position: relative;\n\n  width: 15px;\n\n  height: 4px;\n\n  margin: 0;\n\n  padding: 0;\n\n  overflow: hidden;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  border-radius: 999px;\n\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .23\n    );\n\n  box-shadow: none !important;\n\n  cursor: pointer;\n\n  appearance: none;\n\n  -webkit-appearance: none;\n\n  transition:\n    width .3s ease,\n    background .3s ease;\n}\n\n\n/* remove browser focus border */\n\n.hndrd-slider__dot:focus,\n.hndrd-slider__dot:active {\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  box-shadow: none !important;\n}\n\n\n/* active */\n\n.hndrd-slider__dot.is-active {\n  width: 44px;\n}\n\n\n/* progress */\n\n.hndrd-slider__dot-progress {\n  position: absolute;\n\n  inset: 0;\n\n  width: 0%;\n\n  border-radius: inherit;\n\n  background: #fff;\n}\n\n\n/* animation */\n\n.hndrd-slider.is-playing\n.hndrd-slider__dot.is-active\n.hndrd-slider__dot-progress {\n  animation:\n    hndrdProgress\n    var(--slide-duration)\n    linear forwards;\n}\n\n\n@keyframes hndrdProgress {\n\n  from {\n    width: 0%;\n  }\n\n  to {\n    width: 100%;\n  }\n\n}\n\n\n/* =========================================================\n   PLAY / PAUSE BUTTON\n========================================================= */\n\n.hndrd-slider__play {\n  flex:\n    0\n    0\n    36px;\n\n  width: 36px;\n\n  height: 36px;\n\n  margin: 0;\n\n  padding: 0;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  border-radius: 50%;\n\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .10\n    );\n\n  color: #fff;\n\n  box-shadow: none !important;\n\n  cursor: pointer;\n\n  appearance: none;\n\n  -webkit-appearance: none;\n\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\n\n.hndrd-slider__play:hover {\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .16\n    );\n\n  transform:\n    scale(1.03);\n}\n\n\n.hndrd-slider__play:focus,\n.hndrd-slider__play:active {\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  box-shadow: none !important;\n}\n\n\n/* PAUSE ICON */\n\n.hndrd-slider__pause-icon {\n  display: flex;\n\n  align-items: center;\n\n  gap: 4px;\n}\n\n\n.hndrd-slider__pause-icon span {\n  display: block;\n\n  width: 3px;\n\n  height: 11px;\n\n  border-radius: 2px;\n\n  background: #fff;\n}\n\n\n/* PLAY ICON */\n\n.hndrd-slider__play-icon {\n  display: none;\n\n  width: 0;\n\n  height: 0;\n\n  margin-left: 2px;\n\n  border-top:\n    6px solid transparent;\n\n  border-bottom:\n    6px solid transparent;\n\n  border-left:\n    9px solid #fff;\n}\n\n\n.hndrd-slider.is-paused\n.hndrd-slider__pause-icon {\n  display: none;\n}\n\n\n.hndrd-slider.is-paused\n.hndrd-slider__play-icon {\n  display: block;\n}\n\n\n/* =========================================================\n   PREV / NEXT ARROWS\n========================================================= */\n\n.hndrd-slider__arrow {\n  position: absolute;\n\n  top: 40%;\n\n  z-index: 20;\n\n  width: 44px;\n\n  height: 44px;\n\n  margin: 0;\n\n  padding: 0;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  transform:\n    translateY(-50%);\n\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  border-radius: 50%;\n\n  background:\n    rgba(\n      0,\n      0,\n      0,\n      .36\n    );\n\n  color: #fff;\n\n  box-shadow: none !important;\n\n  cursor: pointer;\n\n  appearance: none;\n\n  -webkit-appearance: none;\n\n  opacity: 0;\n\n  transition:\n    opacity .25s ease,\n    background .25s ease,\n    transform .25s ease;\n}\n\n\n.hndrd-slider:hover\n.hndrd-slider__arrow {\n  opacity: 1;\n}\n\n\n.hndrd-slider__arrow:hover {\n  background:\n    rgba(\n      0,\n      0,\n      0,\n      .62\n    );\n}\n\n\n.hndrd-slider__arrow:focus,\n.hndrd-slider__arrow:active {\n  border: 0 !important;\n\n  outline: 0 !important;\n\n  box-shadow: none !important;\n}\n\n\n.hndrd-slider__arrow--prev {\n  left: 18px;\n}\n\n\n.hndrd-slider__arrow--next {\n  right: 18px;\n}\n\n\n.hndrd-slider__arrow svg {\n  width: 17px;\n\n  height: 17px;\n\n  fill: none;\n\n  stroke: currentColor;\n\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n\n  stroke-linejoin: round;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width:1000px) {\n\n  .hndrd-slider__content {\n    padding:\n      29px\n      22px\n      25px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width:749px) {\n\n\n  /* MOBILE IMAGE */\n\n  .hndrd-slider__image--desktop {\n    display: none;\n  }\n\n\n  .hndrd-slider__image--mobile {\n    display: block;\n  }\n\n\n  /* BANNER */\n\n  .hndrd-slider__media {\n    min-height: 390px;\n\n    border: 0 !important;\n\n    outline: 0 !important;\n  }\n\n\n  .hndrd-slider__image {\n    width: 100%;\n\n    height: 390px;\n\n    object-fit: cover;\n\n    border: 0 !important;\n\n    outline: 0 !important;\n  }\n\n\n  /* BLACK PANEL */\n\n  .hndrd-slider__content {\n    padding:\n      23px\n      16px\n      21px;\n  }\n\n\n  /* EYEBROW */\n\n  .hndrd-slider__eyebrow {\n    margin-bottom: 7px;\n\n    font-size: 8px;\n\n    letter-spacing: 1.4px;\n  }\n\n\n  /* TITLE */\n\n  .hndrd-slider__heading {\n    max-width: 95%;\n\n    font-size:\n      clamp(\n        28px,\n        8.5vw,\n        38px\n      );\n\n    line-height: .97;\n\n    letter-spacing: -1.5px;\n  }\n\n\n  /* DESCRIPTION */\n\n  .hndrd-slider__text {\n    max-width: 92%;\n\n    margin-top: 9px;\n\n    font-size: 12px;\n\n    line-height: 1.45;\n  }\n\n\n  /* CTA */\n\n  .hndrd-slider__cta {\n    min-width: 106px;\n\n    min-height: 37px;\n\n    margin-top: 14px;\n\n    padding:\n      8px\n      16px;\n\n    font-size: 9px;\n  }\n\n\n  /* NAV */\n\n  .hndrd-slider__controls-wrap {\n    margin-top: 15px;\n  }\n\n\n  .hndrd-slider__controls {\n    gap: 6px;\n\n    padding:\n      6px\n      6px\n      6px\n      10px;\n\n    border: 0 !important;\n  }\n\n\n  .hndrd-slider__dot {\n    width: 12px;\n\n    height: 3px;\n  }\n\n\n  .hndrd-slider__dot.is-active {\n    width: 36px;\n  }\n\n\n  .hndrd-slider__play {\n    flex-basis: 32px;\n\n    width: 32px;\n\n    height: 32px;\n  }\n\n\n  /* REMOVE ARROWS ON MOBILE */\n\n  .hndrd-slider__arrow {\n    display: none;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width:390px) {\n\n  .hndrd-slider__media {\n    min-height: 360px;\n  }\n\n\n  .hndrd-slider__image {\n    height: 360px;\n  }\n\n\n  .hndrd-slider__heading {\n    font-size: 27px;\n  }\n\n}\n\n</style>\n\n\n\n<div\n  id=\"hndrd-slider-{{ section.id }}\"\n  class=\"hndrd-slider is-playing\"\n  data-duration=\"5000\"\n>\n\n\n  <div class=\"hndrd-slider__track\">\n\n\n    <!-- =====================================================\n         SLIDE 1\n    ====================================================== -->\n\n    <div class=\"hndrd-slider__slide is-active\">\n\n\n      <!-- BANNER -->\n\n      <div class=\"hndrd-slider__media\">\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--desktop\n          \"\n          src=\"https://in.hndrd.co/cdn/shop/files/2_f7d49388-07f3-4367-8b6a-dc8286802285.jpg?v=1786943076&width=2560\"\n          alt=\"Cosmo Gear\"\n          loading=\"eager\"\n        >\n\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--mobile\n          \"\n          src=\"https://in.hndrd.co/cdn/shop/files/1_3bb13bec-f4d7-4f49-9d26-874b9bbb9c60.jpg?v=1786709623&width=1536\"\n          alt=\"Cosmo Gear\"\n          loading=\"eager\"\n        >\n\n      </div>\n\n\n      <!-- CONTENT -->\n\n      <div class=\"hndrd-slider__content\">\n\n        <div class=\"hndrd-slider__content-inner\">\n\n\n          <div class=\"hndrd-slider__eyebrow\">\n            Introducing \n          </div>\n\n\n          <h2 class=\"hndrd-slider__heading\">\n            Nitrix 80 Bullet\n          </h2>\n\n\n          <div class=\"hndrd-slider__text\">\n            HNDRD's thinnest professional racket yet\n          </div>\n\n\n          <a\n            href=\"https://in.hndrd.co/pages/bullet80\"\n            class=\"hndrd-slider__cta\"\n          >\nCLAIM NOW          </a>\n\n\n          <div class=\"hndrd-slider__controls-wrap\"></div>\n\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         SLIDE 2\n    ====================================================== -->\n\n    <div class=\"hndrd-slider__slide\">\n\n\n      <div class=\"hndrd-slider__media\">\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--desktop\n          \"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_02.jpg?v=1786527389\"\n          alt=\"Performance Collection\"\n          loading=\"lazy\"\n        >\n\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--mobile\n          \"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_02.jpg?v=1786527389\"\n          alt=\"Performance Collection\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n\n      <div class=\"hndrd-slider__content\">\n\n        <div class=\"hndrd-slider__content-inner\">\n\n\n          <div class=\"hndrd-slider__eyebrow\">\n            PERFORMANCE\n          </div>\n\n\n          <h2 class=\"hndrd-slider__heading\">\n            SECOND SLIDE\n          </h2>\n\n\n          <div class=\"hndrd-slider__text\">\n            Add your second slide copy here.\n          </div>\n\n\n          <a\n            href=\"/collections/all\"\n            class=\"hndrd-slider__cta\"\n          >\n            EXPLORE\n          </a>\n\n\n          <div class=\"hndrd-slider__controls-wrap\"></div>\n\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         SLIDE 3\n    ====================================================== -->\n\n    <div class=\"hndrd-slider__slide\">\n\n\n      <div class=\"hndrd-slider__media\">\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--desktop\n          \"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_83a342dd-8ba1-4a03-aef6-f07a0cec8a69.jpg?v=1785733274\"\n          alt=\"Built for the court\"\n          loading=\"lazy\"\n        >\n\n\n        <img\n          class=\"\n            hndrd-slider__image\n            hndrd-slider__image--mobile\n          \"\n          src=\"YOUR-MOBILE-IMAGE-3.jpg\"\n          alt=\"Built for the court\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n\n      <div class=\"hndrd-slider__content\">\n\n        <div class=\"hndrd-slider__content-inner\">\n\n\n          <div class=\"hndrd-slider__eyebrow\">\n            BUILT FOR THE COURT\n          </div>\n\n\n          <h2 class=\"hndrd-slider__heading\">\n            THIRD SLIDE\n          </h2>\n\n\n          <div class=\"hndrd-slider__text\">\n            Add your third slide copy here.\n          </div>\n\n\n          <a\n            href=\"/collections/all\"\n            class=\"hndrd-slider__cta\"\n          >\n            DISCOVER\n          </a>\n\n\n          <div class=\"hndrd-slider__controls-wrap\"></div>\n\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       PREVIOUS\n  ====================================================== -->\n\n  <button\n    class=\"\n      hndrd-slider__arrow\n      hndrd-slider__arrow--prev\n    \"\n    aria-label=\"Previous slide\"\n  >\n\n    <svg viewBox=\"0 0 24 24\">\n      <path d=\"M15 18l-6-6 6-6\"/>\n    </svg>\n\n  </button>\n\n\n\n  <!-- =====================================================\n       NEXT\n  ====================================================== -->\n\n  <button\n    class=\"\n      hndrd-slider__arrow\n      hndrd-slider__arrow--next\n    \"\n    aria-label=\"Next slide\"\n  >\n\n    <svg viewBox=\"0 0 24 24\">\n      <path d=\"M9 6l6 6-6 6\"/>\n    </svg>\n\n  </button>\n\n\n\n  <!-- =====================================================\n       NAVIGATION\n  ====================================================== -->\n\n  <div\n    class=\"hndrd-slider__controls\"\n    data-slider-controls\n    style=\"display:none;\"\n  >\n\n    <div class=\"hndrd-slider__pagination\"></div>\n\n\n    <button\n      class=\"hndrd-slider__play\"\n      aria-label=\"Pause slideshow\"\n    >\n\n      <div class=\"hndrd-slider__pause-icon\">\n        <span></span>\n        <span></span>\n      </div>\n\n\n      <div class=\"hndrd-slider__play-icon\"></div>\n\n    </button>\n\n  </div>\n\n\n</div>\n\n\n\n<script>\n\n(function() {\n\n  const slider =\n    document.getElementById(\n      'hndrd-slider-{{ section.id }}'\n    );\n\n\n  if (\n    !slider ||\n    slider.dataset.initialized === 'true'\n  ) return;\n\n\n  slider.dataset.initialized = 'true';\n\n\n\n  /* =========================================================\n     ELEMENTS\n  ========================================================= */\n\n  const slides =\n    Array.from(\n      slider.querySelectorAll(\n        '.hndrd-slider__slide'\n      )\n    );\n\n\n  const controls =\n    slider.querySelector(\n      '[data-slider-controls]'\n    );\n\n\n  const pagination =\n    controls.querySelector(\n      '.hndrd-slider__pagination'\n    );\n\n\n  const playButton =\n    controls.querySelector(\n      '.hndrd-slider__play'\n    );\n\n\n  const prevButton =\n    slider.querySelector(\n      '.hndrd-slider__arrow--prev'\n    );\n\n\n  const nextButton =\n    slider.querySelector(\n      '.hndrd-slider__arrow--next'\n    );\n\n\n  const duration =\n    parseInt(\n      slider.dataset.duration\n    ) || 5000;\n\n\n  slider.style.setProperty(\n    '--slide-duration',\n    duration + 'ms'\n  );\n\n\n\n  /* =========================================================\n     STATE\n  ========================================================= */\n\n  let current = 0;\n\n  let timer = null;\n\n  let playing = true;\n\n  let touchStartX = 0;\n\n  let touchEndX = 0;\n\n\n\n  /* =========================================================\n     CREATE DOTS\n  ========================================================= */\n\n  slides.forEach(\n    function(slide, index) {\n\n\n      const dot =\n        document.createElement(\n          'button'\n        );\n\n\n      dot.className =\n        'hndrd-slider__dot';\n\n\n      dot.setAttribute(\n        'aria-label',\n        'Go to slide ' + (index + 1)\n      );\n\n\n      const progress =\n        document.createElement(\n          'span'\n        );\n\n\n      progress.className =\n        'hndrd-slider__dot-progress';\n\n\n      dot.appendChild(progress);\n\n\n      dot.addEventListener(\n        'click',\n        function() {\n\n\n          showSlide(index);\n\n\n          if (playing) {\n            restartAutoplay();\n          }\n\n        }\n      );\n\n\n      pagination.appendChild(dot);\n\n    }\n  );\n\n\n  const dots =\n    Array.from(\n      slider.querySelectorAll(\n        '.hndrd-slider__dot'\n      )\n    );\n\n\n\n  /* =========================================================\n     MOVE NAVIGATION UNDER ACTIVE CTA\n  ========================================================= */\n\n  function moveControls() {\n\n\n    const activeSlide =\n      slides[current];\n\n\n    if (!activeSlide) return;\n\n\n    const wrap =\n      activeSlide.querySelector(\n        '.hndrd-slider__controls-wrap'\n      );\n\n\n    if (!wrap) return;\n\n\n    controls.style.display =\n      'inline-flex';\n\n\n    wrap.appendChild(\n      controls\n    );\n\n  }\n\n\n\n  /* =========================================================\n     RESET PROGRESS\n  ========================================================= */\n\n  function resetProgress() {\n\n\n    dots.forEach(\n      function(dot) {\n\n\n        dot.classList.remove(\n          'is-active'\n        );\n\n\n        const progress =\n          dot.querySelector(\n            '.hndrd-slider__dot-progress'\n          );\n\n\n        if (progress) {\n\n\n          progress.style.animation =\n            'none';\n\n\n          void progress.offsetWidth;\n\n\n          progress.style.animation =\n            '';\n\n        }\n\n      }\n    );\n\n  }\n\n\n\n  /* =========================================================\n     SHOW SLIDE\n  ========================================================= */\n\n  function showSlide(index) {\n\n\n    if (index >= slides.length) {\n      index = 0;\n    }\n\n\n    if (index < 0) {\n      index =\n        slides.length - 1;\n    }\n\n\n    slides.forEach(\n      function(slide) {\n\n\n        slide.classList.remove(\n          'is-active'\n        );\n\n      }\n    );\n\n\n    resetProgress();\n\n\n    slides[index]\n      .classList.add(\n        'is-active'\n      );\n\n\n    dots[index]\n      .classList.add(\n        'is-active'\n      );\n\n\n    current = index;\n\n\n    moveControls();\n\n  }\n\n\n\n  /* =========================================================\n     NEXT\n  ========================================================= */\n\n  function nextSlide() {\n\n    showSlide(\n      current + 1\n    );\n\n  }\n\n\n\n  /* =========================================================\n     PREVIOUS\n  ========================================================= */\n\n  function prevSlide() {\n\n    showSlide(\n      current - 1\n    );\n\n  }\n\n\n\n  /* =========================================================\n     AUTOPLAY\n  ========================================================= */\n\n  function startAutoplay() {\n\n\n    clearInterval(timer);\n\n\n    if (!playing) return;\n\n\n    timer =\n      setInterval(\n        function() {\n\n\n          nextSlide();\n\n\n        },\n        duration\n      );\n\n  }\n\n\n\n  function restartAutoplay() {\n\n\n    clearInterval(timer);\n\n\n    startAutoplay();\n\n  }\n\n\n\n  /* =========================================================\n     PLAY / PAUSE\n  ========================================================= */\n\n  playButton.addEventListener(\n    'click',\n    function() {\n\n\n      playing = !playing;\n\n\n      if (playing) {\n\n\n        slider.classList.remove(\n          'is-paused'\n        );\n\n\n        slider.classList.add(\n          'is-playing'\n        );\n\n\n        playButton.setAttribute(\n          'aria-label',\n          'Pause slideshow'\n        );\n\n\n        showSlide(current);\n\n\n        startAutoplay();\n\n\n      } else {\n\n\n        slider.classList.remove(\n          'is-playing'\n        );\n\n\n        slider.classList.add(\n          'is-paused'\n        );\n\n\n        playButton.setAttribute(\n          'aria-label',\n          'Play slideshow'\n        );\n\n\n        clearInterval(timer);\n\n      }\n\n    }\n  );\n\n\n\n  /* =========================================================\n     ARROWS\n  ========================================================= */\n\n  nextButton.addEventListener(\n    'click',\n    function() {\n\n\n      nextSlide();\n\n\n      if (playing) {\n        restartAutoplay();\n      }\n\n    }\n  );\n\n\n  prevButton.addEventListener(\n    'click',\n    function() {\n\n\n      prevSlide();\n\n\n      if (playing) {\n        restartAutoplay();\n      }\n\n    }\n  );\n\n\n\n  /* =========================================================\n     SWIPE\n  ========================================================= */\n\n  slider.addEventListener(\n    'touchstart',\n    function(e) {\n\n\n      touchStartX =\n        e.changedTouches[0]\n        .screenX;\n\n\n    },\n    {\n      passive: true\n    }\n  );\n\n\n  slider.addEventListener(\n    'touchend',\n    function(e) {\n\n\n      touchEndX =\n        e.changedTouches[0]\n        .screenX;\n\n\n      const difference =\n        touchStartX -\n        touchEndX;\n\n\n      if (\n        Math.abs(\n          difference\n        ) < 45\n      ) return;\n\n\n      if (\n        difference > 0\n      ) {\n\n\n        nextSlide();\n\n\n      } else {\n\n\n        prevSlide();\n\n      }\n\n\n      if (playing) {\n        restartAutoplay();\n      }\n\n    },\n    {\n      passive: true\n    }\n  );\n\n\n\n  /* =========================================================\n     TAB VISIBILITY\n  ========================================================= */\n\n  document.addEventListener(\n    'visibilitychange',\n    function() {\n\n\n      if (\n        document.hidden\n      ) {\n\n\n        clearInterval(timer);\n\n\n      } else if (\n        playing\n      ) {\n\n\n        restartAutoplay();\n\n      }\n\n    }\n  );\n\n\n\n  /* =========================================================\n     INIT\n  ========================================================= */\n\n  showSlide(0);\n\n\n  startAutoplay();\n\n\n})();\n\n</script>",
