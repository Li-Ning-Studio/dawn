        "custom_liquid": "<style>\n  :root {\n    --color-bg: #fff;\n    --color-surface: #121212;\n    --color-text: #f5f5f7;\n    --color-text-muted: #86868b;\n    --color-accent: #000;\n    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    --transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .premium-customization-page {\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    font-family: var(--font-sans);\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n\n  /* --- Premium Hero Section --- */\n  .hero-premium {\n    min-height: 90vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 6rem 5%;\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 4rem;\n    align-items: center;\n    width: 100%;\n  }\n\n  .hero-copy h1 {\n    font-size: clamp(3.5rem, 6vw, 5.5rem);\n    font-weight: 700;\n    line-height: 1.05;\n    letter-spacing: -0.03em;\n    margin-bottom: 1.5rem;\n  }\n\n  .hero-copy p {\n    font-size: clamp(2.1rem, 2vw, 1.3rem);\n    color: var(--color-text-muted);\n    max-width: 480px;\n    line-height: 1.5;\n  }\n\n  .hero-video-wrapper {\n    display: flex;\n    justify-content: flex-end;\n    position: relative;\n  }\n\n  .hero-video-container {\n    width: 100%;\n    max-width: 380px;\n    aspect-ratio: 9/16;\n    border-radius: 24px;\n    overflow: hidden;\n    position: relative;\n    box-shadow: 0 30px 60px rgba(0,0,0,0.6);\n  }\n\n  .hero-video-container video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  /* --- Editorial Showcase Sections --- */\n  .editorial-showcase {\n    padding: 8rem 5%;\n    max-width: 1400px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 10rem;\n  }\n\n  .showcase-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 6rem;\n    align-items: center;\n  }\n\n  /* Reverse layout for alternating effect */\n  .showcase-row.reverse {\n    grid-template-columns: 1fr 1fr;\n    direction: rtl;\n  }\n\n  .showcase-row.reverse > * {\n    direction: ltr;\n  }\n\n  .showcase-visual {\n    position: relative;\n    border-radius: 20px;\n    overflow: hidden;\n    aspect-ratio: 4/5;\n    background: var(--color-surface);\n  }\n\n  .showcase-visual img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.5s ease;\n  }\n\n  .showcase-row:hover .showcase-visual img {\n    transform: scale(1.03);\n  }\n\n  .showcase-info {\n    padding: 2rem 0;\n  }\n\n  .step-number {\n    font-size: 1.3rem;\n    font-weight: 600;\n    color: var(--color-text-muted);\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    display: block;\n    margin-bottom: 1.5rem;\n  }\n\n  .showcase-info h2 {\n    font-size: clamp(3.5rem, 4vw, 3.5rem);\n    font-weight: 600;\n    letter-spacing: -0.02em;\n    margin-bottom: 1.5rem;\n    line-height: 1.1;\n  }\n\n  .showcase-info p {\n    font-size: 2.2rem;\n    color: var(--color-text-muted);\n    line-height: 1.6;\n    margin-bottom: 2.5rem;\n    max-width: 450px;\n  }\n\n  /* Premium CTA Button */\n  .premium-cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 1rem;\n    background-color: var(--color-accent);\n    color: #fff;\n    padding: 1rem 2rem;\n    border-radius: 50px;\n    font-size: 1.5rem;\n    font-weight: 600;\n    text-decoration: none;\n    transition: var(--transition);\n  }\n\n  .premium-cta:hover {\n    background-color: #d1d1d6;\n    transform: translateY(-2px);\ncolor: #000;\n  }\n\n  .premium-cta svg {\n    width: 18px;\n    height: 18px;\n    transition: transform 0.3s ease;\n  }\n\n  .premium-cta:hover svg {\n    transform: translateX(4px);\n  }\n\n  /* Responsive Design */\n  @media (max-width: 968px) {\n    .hero-grid {\n      grid-template-columns: 1fr;\n      text-align: center;\n      gap: 3rem;\n    }\n\n    .hero-copy p {\n      margin: 0 auto;\n    }\n\n    .hero-video-wrapper {\n      justify-content: center;\n    }\n\n    .editorial-showcase {\n      gap: 6rem;\n      padding: 4rem 5%;\n    }\n\n    .showcase-row, \n    .showcase-row.reverse {\n      grid-template-columns: 1fr;\n      direction: ltr;\n      gap: 3rem;\n      text-align: center;\n    }\n\n    .showcase-info p {\n      margin: 0 auto 2rem auto;\n    }\n\n    .showcase-visual {\n      aspect-ratio: 1/1;\n    }\n  }\n</style>\n\n<section class=\"premium-customization-page\">\n\n  <!-- Hero Section -->\n  <div class=\"hero-premium\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-copy\">\n        <h1>Leave Your Mark.</h1>\n        <p>Make your gear unmistakably yours. Add your name to our pro-grade equipment directly on the product page before you check out.</p>\n      </div>\n      <div class=\"hero-video-wrapper\">\n        <div class=\"hero-video-container\">\n          <video src=\"https://cdn.shopify.com/videos/c/vp/1326abffdd8646adabbb854dfa63778e/1326abffdd8646adabbb854dfa63778e.HD-1080p-7.2Mbps-90302738.mp4\" autoplay loop muted playsinline></video>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Editorial Product Showcase -->\n  <div class=\"editorial-showcase\">\n\n    <!-- Category 01: Badminton Racket -->\n    <div class=\"showcase-row\">\n      <div class=\"showcase-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/badminton_racket_customization.png?v=1785395220\" alt=\"Custom Badminton Racket\">\n      </div>\n      <div class=\"showcase-info\">\n        <span class=\"step-number\">Badminton Rackets</span>\n        <h2>Precision on the Shaft.</h2>\n        <p>Your name is permanently etched into the bottom of the shaft, sitting elegantly just above the grip for a clean, pro-tour aesthetic.</p>\n        <a href=\"/collections/badminton-rackets\" class=\"premium-cta\">\n          Shop Rackets \n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- Category 02: Kitbags (Reverse Layout) -->\n    <div class=\"showcase-row reverse\">\n      <div class=\"showcase-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/kitbag_customization.png?v=1785395342&width=500\" alt=\"Custom Badminton Kitbag\">\n      </div>\n      <div class=\"showcase-info\">\n        <span class=\"step-number\">Pro Kitbags</span>\n        <h2>Stand Out Upon Arrival.</h2>\n        <p>Premium vinyl printing applied directly above the front zipper on the right side. Easy to identify, impossible to ignore.</p>\n        <a href=\"/products/cosmogear-kit-bag\" class=\"premium-cta\">\n          Shop Kitbags\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n        </a>\n      </div>\n    </div>\n\n    <!-- Category 03: Pickleball Paddles -->\n    <div class=\"showcase-row\">\n      <div class=\"showcase-visual\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/paddle_customization.png?v=1785395110\" alt=\"Custom Pickleball Paddle\">\n      </div>\n      <div class=\"showcase-info\">\n        <span class=\"step-number\">Pickleball Paddles</span>\n        <h2>Claim Your Court.</h2>\n        <p>Expertly printed along the side of the paddle body, just above the grip handle. Flawless integration with the paddle's native design.</p>\n        <a href=\"/collections/pickleball-paddle\" class=\"premium-cta\">\n          Shop Paddles\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n        </a>\n      </div>\n    </div>\n\n  </div>\n\n</section>",
