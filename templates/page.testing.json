      "settings": {
        "custom_liquid": "<style>\n    /* =========================================\n       SECTION & BACKGROUND\n       ========================================= */\n    .tour-schedule-elite {\n        background-color: #030303;\n        color: #ffffff;\n        padding: 120px 20px;\n        position: relative;\n        overflow: hidden;\n        font-family: 'Inter', sans-serif;\n    }\n\n    /* Dynamic Grid Background */\n    .tour-schedule-elite::before {\n        content: '';\n        position: absolute;\n        top: 0; left: 0; right: 0; bottom: 0;\n        background-image: \n            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), \n            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n        background-size: 80px 80px;\n        background-position: center;\n        z-index: 0;\n    }\n\n    /* Red Ambient Glows */\n    .glow-left, .glow-right {\n        position: absolute;\n        width: 600px;\n        height: 600px;\n        background: radial-gradient(circle, rgba(255, 51, 51, 0.08) 0%, transparent 70%);\n        border-radius: 50%;\n        z-index: 0;\n        pointer-events: none;\n    }\n    .glow-left { top: 10%; left: -20%; }\n    .glow-right { bottom: 10%; right: -20%; }\n\n    .tour-container {\n        max-width: 1200px;\n        margin: 0 auto;\n        position: relative;\n        z-index: 1;\n    }\n\n    /* =========================================\n       HEADER\n       ========================================= */\n    .elite-header {\n        text-align: center;\n        margin-bottom: 100px;\n    }\n\n    .elite-header h2 {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 4.5rem;\n        font-weight: 900;\n        text-transform: uppercase;\n        line-height: 1;\n        margin: 0 0 15px 0;\n        letter-spacing: -2px;\n    }\n\n    .elite-header h2 span {\n        color: #ff3333;\n    }\n\n    .elite-header p {\n        color: #888;\n        font-size: 1.2rem;\n        max-width: 500px;\n        margin: 0 auto;\n    }\n\n    /* =========================================\n       CITY SECTIONS\n       ========================================= */\n    .city-block {\n        margin-bottom: 100px;\n    }\n\n    /* Massive Overlapping City Title */\n    .city-title-wrapper {\n        position: relative;\n        margin-bottom: 40px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .city-title-bg {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 8rem;\n        font-weight: 900;\n        color: transparent;\n        -webkit-text-stroke: 1px rgba(255, 51, 51, 0.15);\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        letter-spacing: 10px;\n        white-space: nowrap;\n        pointer-events: none;\n        z-index: -1;\n    }\n\n    .city-title-fg {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 2.5rem;\n        font-weight: 800;\n        color: #fff;\n        background: #ff3333;\n        padding: 5px 25px;\n        letter-spacing: 4px;\n        text-transform: uppercase;\n        transform: skewX(-10deg);\n    }\n\n    .city-title-fg span {\n        display: block;\n        transform: skewX(10deg); /* Counter-skew for text */\n    }\n\n    /* =========================================\n       TICKET GRID (Venues)\n       ========================================= */\n    .ticket-grid {\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));\n        gap: 30px;\n    }\n\n    /* Digital Ticket Card */\n    .ticket-card {\n        background: linear-gradient(135deg, #111111 0%, #080808 100%);\n        border: 1px solid #222;\n        display: flex;\n        align-items: stretch;\n        position: relative;\n        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);\n        /* Sporty chamfered corners */\n        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%);\n    }\n\n    .ticket-card::before {\n        content: '';\n        position: absolute;\n        bottom: 0; right: 0;\n        width: 20px; height: 20px;\n        background: #ff3333;\n        opacity: 0;\n        transition: opacity 0.4s ease;\n    }\n\n    .ticket-card:hover {\n        transform: translateY(-5px);\n        border-color: #ff3333;\n        box-shadow: 0 15px 35px rgba(255, 51, 51, 0.15);\n    }\n\n    .ticket-card:hover::before {\n        opacity: 1;\n    }\n\n    /* Date Stub (Left Side) */\n    .ticket-date {\n        padding: 30px 25px;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        align-items: center;\n        min-width: 130px;\n        background: rgba(255, 51, 51, 0.03);\n    }\n\n    .t-month {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 1.5rem;\n        font-weight: 700;\n        color: #ff3333;\n        letter-spacing: 2px;\n        text-transform: uppercase;\n    }\n\n    .t-day {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 3rem;\n        font-weight: 900;\n        color: #fff;\n        line-height: 1;\n    }\n\n    /* Ticket Tear Line (Dashed Divider) */\n    .ticket-divider {\n        width: 2px;\n        background-image: linear-gradient(to bottom, #333 50%, transparent 50%);\n        background-size: 100% 12px;\n        background-repeat: repeat-y;\n        position: relative;\n    }\n\n    .ticket-divider::before, .ticket-divider::after {\n        content: '';\n        position: absolute;\n        width: 16px; height: 16px;\n        background: #030303;\n        border-radius: 50%;\n        left: -7px;\n    }\n    .ticket-divider::before { top: -8px; }\n    .ticket-divider::after { bottom: -8px; }\n\n    /* Ticket Details (Middle) */\n    .ticket-info {\n        padding: 30px;\n        flex-grow: 1;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n    }\n\n    .ticket-info h4 {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 1.6rem;\n        font-weight: 700;\n        color: #ffffff;\n        margin: 0 0 12px 0;\n        line-height: 1.2;\n    }\n\n    .ticket-meta {\n        display: flex;\n        align-items: center;\n        flex-wrap: wrap;\n        gap: 15px;\n        margin-bottom: 10px;\n    }\n\n    .time-badge {\n        display: inline-flex;\n        align-items: center;\n        gap: 6px;\n        background: rgba(255, 51, 51, 0.1);\n        color: #ff3333;\n        padding: 6px 12px;\n        border-radius: 4px;\n        font-size: 0.9rem;\n        font-weight: 600;\n        border: 1px solid rgba(255, 51, 51, 0.2);\n    }\n\n    .time-badge svg {\n        width: 14px; height: 14px;\n        fill: currentColor;\n    }\n\n    .location-text {\n        color: #888;\n        font-size: 1rem;\n        display: flex;\n        align-items: center;\n        gap: 6px;\n    }\n\n    /* Action Button (Right Side) */\n    .ticket-action {\n        padding: 30px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .btn-directions {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        width: 55px; height: 55px;\n        border-radius: 50%;\n        background: #1a1a1a;\n        color: #fff;\n        text-decoration: none;\n        border: 1px solid #333;\n        transition: all 0.3s ease;\n    }\n\n    .btn-directions svg {\n        width: 22px; height: 22px;\n        fill: none;\n        stroke: currentColor;\n        stroke-width: 2;\n        transition: transform 0.3s ease;\n    }\n\n    .ticket-card:hover .btn-directions {\n        background: #ff3333;\n        border-color: #ff3333;\n    }\n    \n    .ticket-card:hover .btn-directions svg {\n        transform: rotate(-45deg) scale(1.1);\n    }\n\n    /* =========================================\n       RESPONSIVE DESIGN\n       ========================================= */\n    @media (max-width: 1024px) {\n        .ticket-grid { grid-template-columns: 1fr; }\n        .city-title-bg { font-size: 6rem; }\n    }\n\n    @media (max-width: 768px) {\n        .elite-header h2 { font-size: 3rem; }\n        .city-title-bg { display: none; } /* Hide large bg text on mobile */\n        .city-title-fg { font-size: 2rem; }\n        \n        .ticket-card {\n            flex-direction: column;\n            clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%);\n        }\n\n        .ticket-date {\n            flex-direction: row;\n            justify-content: flex-start;\n            gap: 15px;\n            padding: 20px;\n            border-bottom: 1px dashed #333;\n            background: transparent;\n        }\n\n        .ticket-divider { display: none; } /* Remove vertical divider */\n\n        .t-month { font-size: 1.2rem; }\n        .t-day { font-size: 2rem; }\n\n        .ticket-info { padding: 20px; }\n        .ticket-info h4 { font-size: 1.4rem; }\n\n        .ticket-action {\n            padding: 0 20px 20px 20px;\n            justify-content: flex-start;\n        }\n\n        .btn-directions {\n            width: 100%;\n            border-radius: 4px;\n            height: 50px;\n            gap: 10px;\n            background: #ff3333;\n            border-color: #ff3333;\n        }\n\n        .btn-directions::after {\n            content: 'GET DIRECTIONS';\n            font-family: 'Montserrat', sans-serif;\n            font-weight: 700;\n            font-size: 1rem;\n            letter-spacing: 1px;\n        }\n        \n        .btn-directions svg { display: none; }\n    }\n</style>\n\n<section class=\"tour-schedule-elite\">\n    <div class=\"glow-left\"></div>\n    <div class=\"glow-right\"></div>\n\n    <div class=\"tour-container\">\n        \n        <!-- HEADER -->\n        <div class=\"elite-header\">\n            <h2>TOUR <span>LOCATIONS