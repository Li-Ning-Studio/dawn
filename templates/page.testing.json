        "custom_liquid": "<!-- ============================================================\n     INTRO SECTION — place directly below your hero banner\n     Self-contained: scoped styles + optional scroll-reveal JS.\n     Uses the same design tokens (Space Grotesk / Inter / hs- palette)\n     as the hero, so it reads as one continuous page.\n     ============================================================ -->\n\n<section class=\"hs-intro\" id=\"hsIntro\">\n  <p class=\"hs-intro-eyebrow\"><span class=\"hs-intro-dot\"></span>Exclusive Launch Offer</p>\n  <h2 class=\"hs-intro-heading\">\n    Speed isn't a feature.<br>It's the <em>whole point.</em>\n  </h2>\n  <p class=\"hs-intro-desc\">\n    Join the list and lock in a launch-day reward reserved only for the players who signed up before it ever went public.\n  </p>\n</section>\n\n<style>\n  :root{\n    --hs-emerald-deep:#0A4A3A;\n    --hs-mist:#FAFAF7;\n    --hs-ink:#0B0F0D;\n    --hs-ink-soft:#41473F;\n    --hs-blush:#F0C7DA;\n    --hs-sky:#A9DEEA;\n    --hs-amber:#EFC15F;\n    --hs-periwinkle:#93A6E6;\n    --hs-signal:#FF5A36;\n    --hs-line: rgba(11,15,13,0.12);\n  }\n\n  .hs-intro{\n    background:;\n    padding:88px 6vw 76px;\n    text-align:center;\n    max-width:720px;\n    margin:0 auto;\n    opacity:0;\n    transform:translateY(18px);\n    transition:opacity 0.7s ease, transform 0.7s cubic-bezier(.2,.8,.2,1);\n  }\n  .hs-intro.hs-in-view{\n    opacity:1;\n    transform:translateY(0);\n  }\n\n  .hs-intro-eyebrow{\n    font-family:'IBM Plex Mono', 'Space Grotesk', monospace;\n    font-size:11.5px;\n    font-weight:600;\n    letter-spacing:0.2em;\n    text-transform:uppercase;\n    color:var(--hs-emerald-deep);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:8px;\n    margin-bottom:18px;\n  }\n  .hs-intro-dot{\n    width:6px; height:6px;\n    border-radius:50%;\n    background:var(--hs-signal);\n  }\n\n  .hs-intro-heading{\n    font-family:'Space Grotesk', sans-serif;\n    font-weight:600;\n    font-size:clamp(1.7rem, 4.2vw, 2.7rem);\n    line-height:1.14;\n    letter-spacing:-0.01em;\n    color:var(--hs-ink);\n  }\n  .hs-intro-heading em{\n    font-style:normal;\n    background:linear-gradient(90deg, var(--hs-periwinkle), var(--hs-blush) 45%, var(--hs-amber) 85%);\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n  }\n\n  .hs-intro-desc{\n    margin-top:18px;\n    font-family:'Inter', sans-serif;\n    font-size:16px;\n    line-height:1.65;\n    color:var(--hs-ink-soft);\n    max-width:520px;\n    margin-left:auto;\n    margin-right:auto;\n  }\n\n  @media (max-width: 720px){\n    .hs-intro{ padding:64px 6vw 56px; }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .hs-intro{\n      opacity:1;\n      transform:none;\n      transition:none;\n    }\n  }\n</style>\n\n<script>\n  // Fades the section in the first time it scrolls into view.\n  // Safe to include multiple times on a page — checks before re-adding.\n  (function(){\n    var el = document.getElementById('hsIntro');\n    if (!el || !('IntersectionObserver' in window)) {\n      if (el) el.classList.add('hs-in-view');\n      return;\n    }\n    var observer = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if (entry.isIntersecting){\n          entry.target.classList.add('hs-in-view');\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.25 });\n    observer.observe(el);\n  })();\n</script>",
