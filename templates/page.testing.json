    "custom_liquid_MyMBhm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n    /* Section & Background */\n    .tour-schedule-premium {\n        background-color: #030303; /* Deepest black */\n        color: #ffffff;\n        padding: 120px 20px;\n        position: relative;\n        overflow: hidden;\n        font-family: 'Inter', sans-serif;\n    }\n\n    /* Subtle Background Grid/Glow */\n    .tour-schedule-premium::before {\n        content: '';\n        position: absolute;\n        top: 0; left: 0; right: 0; bottom: 0;\n        background-image: linear-gradient(#1a1a1a 1px, transparent 1px), linear-gradient(90deg, #1a1a1a 1px, transparent 1px);\n        background-size: 100px 100px;\n        opacity: 0.1;\n        z-index: 0;\n    }\n\n    .tour-schedule-premium::after {\n        content: '';\n        position: absolute;\n        top: -20%; right: -10%;\n        width: 600px; height: 600px;\n        background: radial-gradient(circle, rgba(255, 51, 51, 0.08) 0%, transparent 70%);\n        border-radius: 50%;\n        z-index: 0;\n    }\n\n    .tour-container {\n        max-width: 1200px;\n        margin: 0 auto;\n        position: relative;\n        z-index: 1;\n    }\n\n    /* Header */\n    .schedule-header-dark {\n        margin-bottom: 80px;\n        border-bottom: 1px solid #222;\n        padding-bottom: 30px;\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-end;\n    }\n\n    .schedule-header-dark h2 {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 4rem;\n        font-weight: 900;\n        text-transform: uppercase;\n        line-height: 0.9;\n        margin: 0;\n        letter-spacing: -2px;\n    }\n\n    .schedule-header-dark h2 span {\n        color: #ff3333; /* Hundred Red */\n    }\n\n    .schedule-header-dark p {\n        color: #888;\n        font-size: 1.1rem;\n        max-width: 300px;\n        text-align: right;\n        margin: 0;\n    }\n\n    /* City Group Layout */\n    .city-group {\n        display: grid;\n        grid-template-columns: 280px 1fr;\n        gap: 40px;\n        margin-bottom: 60px;\n        align-items: flex-start;\n    }\n\n    /* City Title (Left Column) */\n    .city-meta {\n        position: sticky;\n        top: 100px;\n    }\n\n    .city-index {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 1rem;\n        color: #ff3333;\n        font-weight: 700;\n        letter-spacing: 2px;\n        display: block;\n        margin-bottom: 10px;\n    }\n\n    .city-name {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 3rem;\n        font-weight: 800;\n        color: #fff;\n        line-height: 1;\n        letter-spacing: -1px;\n        margin: 0;\n    }\n\n    /* Venue List (Right Column) */\n    .venue-list {\n        display: flex;\n        flex-direction: column;\n        gap: 15px;\n    }\n\n    /* Individual Venue Row */\n    .venue-row {\n        display: grid;\n        grid-template-columns: auto 1fr auto;\n        gap: 30px;\n        align-items: center;\n        background: #0a0a0a;\n        border: 1px solid #1a1a1a;\n        padding: 30px;\n        border-radius: 4px;\n        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);\n        position: relative;\n        overflow: hidden;\n    }\n\n    /* Red Accent Line on Hover */\n    .venue-row::before {\n        content: '';\n        position: absolute;\n        left: 0; top: 0; bottom: 0;\n        width: 4px;\n        background-color: #ff3333;\n        transform: scaleY(0);\n        transform-origin: bottom;\n        transition: transform 0.4s ease;\n    }\n\n    .venue-row:hover {\n        background: #111111;\n        border-color: #333;\n        transform: translateX(10px);\n        box-shadow: -10px 10px 30px rgba(0,0,0,0.5);\n    }\n\n    .venue-row:hover::before {\n        transform: scaleY(1);\n    }\n\n    /* Date Block */\n    .venue-date-block {\n        text-align: center;\n        padding-right: 30px;\n        border-right: 1px solid #222;\n        min-width: 120px;\n    }\n\n    .v-month {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 1.9rem;\n        font-weight: 700;\n        color: #ff3333;\n        letter-spacing: 2px;\n        text-transform: uppercase;\n        display: block;\n    }\n\n    .v-day {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 2.5rem;\n        font-weight: 900;\n        color: #fff;\n        line-height: 1.1;\n    }\n\n    /* Venue Details */\n    .venue-details h4 {\n        font-family: 'Montserrat', sans-serif;\n        font-size: 2.1rem;\n        font-weight: 700;\n        color: #ffffff;\n        margin-bottom: 8px;\n    }\n\n    .venue-details p {\n        color: #888;\n        font-size: 1.2rem;\n        margin: 0;\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }\n\n    .time-badge {\n        display: inline-block;\n        background: #1a1a1a;\n        color: #ccc;\n        padding: 4px 10px;\n        border-radius: 4px;\n        font-size: 1.85rem;\n        margin-left: 10px;\n        border: 1px solid #333;\n    }\n\n    /* Action Button */\n    .btn-get-directions {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        width: 50px;\n        height: 50px;\n        border-radius: 50%;\n        background: transparent;\n        border: 1px solid #333;\n        color: #fff;\n        transition: all 0.3s ease;\ntext-decoration:none;\n    }\n\n    .btn-get-directions svg {\n        width: 20px;\n        height: 20px;\n        fill: none;\n        stroke: currentColor;\n        stroke-width: 2;\n        transition: transform 0.3s ease;\n    }\n\n    .venue-row:hover .btn-get-directions {\n        background: #ff3333;\n        border-color: #ff3333;\n        color: #fff;\n    }\n\n    .venue-row:hover .btn-get-directions svg {\n        transform: rotate(-45deg);\n    }\n\n    /* Responsive Design */\n    @media (max-width: 992px) {\n        .city-group {\n            grid-template-columns: 1fr;\n            gap: 20px;\n        }\n        .city-meta {\n            position: relative;\n            top: 0;\n            margin-bottom: 10px;\n        }\n        .schedule-header-dark {\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 20px;\n        }\n        .schedule-header-dark p {\n            text-align: left;\n        }\n    }\n\n    @media (max-width: 600px) {\n        .venue-row {\n            grid-template-columns: 1fr;\n            gap: 20px;\n            padding: 25px 20px;\n        }\n        .venue-date-block {\n            border-right: none;\n            border-bottom: 1px solid #222;\n            padding-right: 0;\n            padding-bottom: 20px;\n            text-align: left;\n            display: flex;\n            align-items: baseline;\n            gap: 10px;\n        }\n        .v-day {\n            font-size: 2rem;\n        }\n        .venue-details h4 {\n            line-height: 1.3;\n        }\n        .time-badge {\n            margin-left: 0;\n            margin-top: 8px;\n            display: inline-block;\n        }\n        .venue-details p {\n            align-items: flex-start;\n            flex-direction: column;\n        }\n        .btn-get-directions {\n            width: 100%;\n            border-radius: 4px;\n            height: 45px;\n            gap: 10px;\n        }\n        .btn-get-directions::after {\n            content: 'Get Directions';\n            font-family: 'Montserrat', sans-serif;\n            font-weight: 600;\n            font-size: 1.3rem;\n            text-transform: uppercase;\n        }\n        .btn-get-directions svg {\n            display: none; \n        }\n    }\n</style>\n\n<section class=\"tour-schedule-premium\">\n    <div class=\"tour-container\">\n        \n        <!-- Section Header -->\n        <div class=\"schedule-header-dark\">\n            <h2>TOUR <br><span>LOCATIONS</span></h2>\n            <p>Select your c