        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>HNDRD — Customer Reviews Section (transparent bg)</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#121210;\n    --ink-soft:#5b584f;\n    --gold:#c99a2e;\n    --gold-deep:#8a6b1f;\n    --red:#d43b26;\n    --line:rgba(18,18,16,0.12);\n    --card-line:rgba(255,255,255,0.10);\n  }\n  *{box-sizing:border-box;margin:0;padding:0;}\n  body{font-family:'Work Sans',sans-serif;color:var(--ink);\n    /* preview-only backdrop so the section isn't invisible in this standalone file —\n       remove this body rule entirely when you paste the section into the real page */\n    background:#fbfaf7;\n  }\n  .display{font-family:'Anton',sans-serif;font-weight:400;letter-spacing:0.5px;text-transform:uppercase;}\n  .wrap{max-width:1240px;margin:0 auto;padding:0 28px;}\n  a{color:inherit;text-decoration:none;}\n\n  /* ============ SECTION — background intentionally transparent ============ */\n  .reviews-section{\n    background:transparent;\n    padding:78px 0 88px;\n  }\n\n  .section-head{\n    display:flex;justify-content:space-between;align-items:flex-end;\n    margin-bottom:38px;flex-wrap:wrap;gap:18px;\n  }\n  .eyebrow{\n    font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:3px;text-transform:uppercase;\n    color:var(--red);display:flex;align-items:center;gap:10px;\n  }\n  .eyebrow::before{content:\"\";width:26px;height:2px;background:var(--red);display:inline-block;}\n  .section-head h2{font-size:clamp(28px,3.4vw,42px);margin-top:10px;max-width:560px;line-height:1.04;color:var(--ink);}\n  .section-head p{color:var(--ink-soft);font-size:14.5px;max-width:360px;margin-top:12px;line-height:1.55;}\n  .head-actions{display:flex;flex-direction:column;align-items:flex-end;gap:14px;}\n  .rail-nav{display:flex;gap:8px;}\n  .rail-btn{\n    width:40px;height:40px;border:1px solid var(--line);\n    display:flex;align-items:center;justify-content:center;cursor:pointer;\n    background:transparent;color:var(--ink);transition:all .15s;\n  }\n  .rail-btn:hover{background:var(--ink);color:#fff;border-color:var(--ink);}\n  .view-all{\n    font-family:'Oswald',sans-serif;font-size:12.5px;letter-spacing:1px;text-transform:uppercase;\n    color:var(--ink);border-bottom:1px solid var(--gold);padding-bottom:2px;\n  }\n\n  /* ---------- RAIL ---------- */\n  .reel-rail{\n    display:flex;gap:20px;overflow-x:auto;padding:6px 2px 26px;\n    scroll-snap-type:x mandatory;scrollbar-width:none;\n  }\n  .reel-rail::-webkit-scrollbar{display:none;}\n\n  .reel-card{\n    position:relative;flex:0 0 auto;\n    width:230px;aspect-ratio:9/16;\n    background:#0c0c0a;border-radius:18px;overflow:hidden;\n    scroll-snap-align:start;\n    border:1px solid var(--card-line);\n    box-shadow:0 20px 40px -20px rgba(18,18,16,0.35);\n    transition:transform .25s ease, box-shadow .25s ease;\n  }\n  .reel-card:hover{transform:translateY(-6px);box-shadow:0 26px 48px -18px rgba(18,18,16,0.45);}\n\n  /* placeholder poster art — drawn in CSS so the card looks intentional before\n     you drop in a real thumbnail/poster image */\n  .reel-poster{\n    position:absolute;inset:0;\n    background:\n      radial-gradient(circle at 30% 20%, rgba(201,154,46,0.30), transparent 55%),\n      linear-gradient(160deg,#1e1c17,#0c0c0a 75%);\n  }\n  .reel-scrim{\n    position:absolute;inset:0;\n    background:linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 24%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.88) 100%);\n  }\n\n  .reel-video{\n    position:absolute;inset:0;width:100%;height:100%;\n    object-fit:cover;background:#000;\n  }\n\n  .verified-tag{\n    position:absolute;top:12px;right:12px;z-index:3;\n    background:var(--gold);color:#1c1500;\n    font-family:'Oswald',sans-serif;font-size:9.5px;letter-spacing:0.5px;text-transform:uppercase;\n    padding:5px 8px;border-radius:20px;\n  }\n  .duration-tag{\n    position:absolute;top:12px;left:12px;z-index:3;\n    background:rgba(12,12,10,0.55);backdrop-filter:blur(6px);color:#e9e7dd;\n    font-family:'Oswald',sans-serif;font-size:9.5px;letter-spacing:0.5px;\n    padding:5px 8px;border-radius:20px;\n  }\n\n  .play-btn{\n    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:3;\n    width:52px;height:52px;border-radius:50%;\n    background:rgba(255,255,255,0.14);backdrop-filter:blur(6px);\n    border:1px solid rgba(255,255,255,0.5);\n    display:flex;align-items:center;justify-content:center;cursor:pointer;\n    transition:transform .15s ease, background .15s ease;\n  }\n  .reel-card:hover .play-btn{transform:translate(-50%,-50%) scale(1.08);background:rgba(255,255,255,0.22);}\n  .play-btn svg{width:16px;height:16px;margin-left:2px;}\n\n  .reel-side-icons{\n    position:absolute;right:10px;bottom:80px;z-index:3;\n    display:flex;flex-direction:column;gap:16px;align-items:center;\n  }\n  .reel-side-icons .ic{display:flex;flex-direction:column;align-items:center;gap:4px;}\n  .reel-side-icons svg{width:19px;height:19px;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.5));}\n  .reel-side-icons span{font-size:10px;font-family:'Oswald',sans-serif;color:#e9e7dd;}\n\n  .reel-foot{\n    position:absolute;left:0;right:0;bottom:0;z-index:3;\n    padding:14px 14px 16px;display:flex;flex-direction:column;gap:6px;\n  }\n  .reel-handle{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:#fff;}\n  .reel-avatar{\n    width:20px;height:20px;border-radius:50%;\n    background:linear-gradient(135deg,var(--gold),var(--red));\n    flex:0 0 auto;\n  }\n  .reel-caption{font-size:11.5px;color:#e9e7dd;line-height:1.4;}\n  .reel-tag{\n    align-self:flex-start;margin-top:2px;\n    font-family:'Oswald',sans-serif;font-size:9.5px;letter-spacing:0.4px;text-transform:uppercase;\n    background:rgba(255,255,255,0.14);color:#fff;padding:4px 8px;border-radius:20px;\n  }\n  .reel-stars{font-size:10px;color:var(--gold);letter-spacing:1.5px;}\n\n  .reviews-footnote{\n    display:flex;align-items:center;justify-content:space-between;\n    margin-top:8px;padding-top:26px;border-top:1px solid var(--line);\n    flex-wrap:wrap;gap:14px;\n  }\n  .reviews-footnote p{font-size:12.5px;color:var(--ink-soft);max-width:560px;line-height:1.6;}\n  .reviews-footnote code{background:rgba(18,18,16,0.06);padding:2px 6px;border-radius:4px;font-size:11.5px;}\n  .submit-cta{\n    display:inline-flex;align-items:center;gap:8px;\n    font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:1px;text-transform:uppercase;\n    padding:12px 22px;border:2px solid var(--ink);color:var(--ink);white-space:nowrap;\n    transition:all .15s;\n  }\n  .submit-cta:hover{background:var(--ink);color:#fff;}\n\n  @media (max-width:640px){\n    .reel-card{width:170px;}\n    .section-head{flex-direction:column;align-items:flex-start;}\n    .head-actions{align-items:flex-start;}\n  }\n</style>\n</head>\n<body>\n\n<section class=\"reviews-section\">\n  <div class=\"wrap\">\n\n    <div class=\"section-head\">\n      <div>\n        <div class=\"eyebrow\">Player reviews</div>\n        <h2 class=\"display\">Real players. Real gear.<br></h2>\n        <p>Video reviews from customers who bought and played in HNDRD gear.</p>\n      </div>\n      <div class=\"head-actions\">\n        <div class=\"rail-nav\">\n          <button class=\"rail-btn\" onclick=\"document.getElementById('reviewRail').scrollBy({left:-260,behavior:'smooth'})\" aria-label=\"Scroll left\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n          </button>\n          <button class=\"rail-btn\" onclick=\"document.getElementById('reviewRail').scrollBy({left:260,behavior:'smooth'})\" aria-label=\"Scroll right\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M9 18l6-6-6-6\"/></svg>\n          </button>\n        </div>\n       \n      </div>\n    </div>\n\n    <div class=\"reel-rail\" id=\"reviewRail\">\n\n      <!-- ============ REVIEW CARD TEMPLATE ============\n        To add a real review: replace data-video with a direct link to your\n        hosted file (mp4/webm — Shopify Files, or any CDN link works).\n        Optionally set data-poster to a thumbnail image URL; if left blank,\n        the drawn placeholder art is used until the video is played.\n      -->\n\n      <div class=\"reel-card\" data-video=\"PASTE_VIDEO_LINK_1.mp4\" data-poster=\"\">\n        <div class=\"reel-poster\"></div>\n        <div class=\"reel-scrim\"></div>\n        <span class=\"duration-tag\">0:34</span>\n        <span class=\"verified-tag\">Verified buyer</span>\n        <div class=\"play-btn\" onclick=\"playReview(this)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </div>\n        <div class=\"reel-side-icons\">\n          <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z\"/></svg><span>Helpful</span></div>\n        </div>\n        <div class=\"reel-foot\">\n          <div class=\"reel-handle\"><span class=\"reel-avatar\"></span>Rohit S.</div>\n          <div class=\"reel-stars\">★★★★★</div>\n          <div class=\"reel-caption\">\"Switched from a Yonex to the Nitrix Thunder — noticeably faster swing, and half the price.\"</div>\n          <span class=\"reel-tag\">Wearing: Nitrix Thunder — 5U</span>\n        </div>\n      </div>\n\n      <div class=\"reel-card\" data-video=\"PASTE_VIDEO_LINK_2.mp4\" data-poster=\"\">\n        <div class=\"reel-poster\"></div>\n        <div class=\"reel-scrim\"></div>\n        <span class=\"duration-tag\">0:22</span>\n        <span class=\"verified-tag\">Verified buyer</span>\n        <div class=\"play-btn\" onclick=\"playReview(this)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </div>\n        <div class=\"reel-side-icons\">\n          <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z\"/></svg><span>Helpful</span></div>\n        </div>\n        <div class=\"reel-foot\">\n          <div class=\"reel-handle\"><span class=\"reel-avatar\"></span>Ananya K.</div>\n          <div class=\"reel-stars\">★★★★★</div>\n          <div class=\"reel-caption\">\"Grip held even on my academy's worn mats mid-rally. Ordering a second pair already.\"</div>\n          <span class=\"reel-tag\">Wearing: Raze Pro</span>\n        </div>\n      </div>\n\n      <div class=\"reel-card\" data-video=\"PASTE_VIDEO_LINK_3.mp4\" data-poster=\"\">\n        <div class=\"reel-poster\"></div>\n        <div class=\"reel-scrim\"></div>\n        <span class=\"duration-tag\">0:41</span>\n        <span class=\"verified-tag\">Verified buyer</span>\n        <div class=\"play-btn\" onclick=\"playReview(this)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </div>\n        <div class=\"reel-side-icons\">\n          <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z\"/></svg><span>Helpful</span></div>\n        </div>\n        <div class=\"reel-foot\">\n          <div class=\"reel-handle\"><span class=\"reel-avatar\"></span>Faizan A.</div>\n          <div class=\"reel-stars\">★★★★☆</div>\n          <div class=\"reel-caption\">\"COD and a WhatsApp number that actually replies. The shoes have great court traction too.\"</div>\n          <span class=\"reel-tag\">Wearing: Court Star Pro</span>\n        </div>\n      </div>\n\n      <div class=\"reel-card\" data-video=\"PASTE_VIDEO_LINK_4.mp4\" data-poster=\"\">\n        <div class=\"reel-poster\"></div>\n        <div class=\"reel-scrim\"></div>\n        <span class=\"duration-tag\">0:18</span>\n        <span class=\"verified-tag\">Verified buyer</span>\n        <div class=\"play-btn\" onclick=\"playReview(this)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </div>\n        <div class=\"reel-side-icons\">\n          <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z\"/></svg><span>Helpful</span></div>\n        </div>\n        <div class=\"reel-foot\">\n          <div class=\"reel-handle\"><span class=\"reel-avatar\"></span>Priya M.</div>\n          <div class=\"reel-stars\">★★★★★</div>\n          <div class=\"reel-caption\">\"Footwork drills feel lighter in these — barely notice I'm wearing shoes by the third set.\"</div>\n          <span class=\"reel-tag\">Wearing: Blade Pro</span>\n        </div>\n      </div>\n\n      <div class=\"reel-card\" data-video=\"PASTE_VIDEO_LINK_5.mp4\" data-poster=\"\">\n        <div class=\"reel-poster\"></div>\n        <div class=\"reel-scrim\"></div>\n        <span class=\"duration-tag\">0:27</span>\n        <span class=\"verified-tag\">Verified buyer</span>\n        <div class=\"play-btn\" onclick=\"playReview(this)\">\n          <svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n        </div>\n        <div class=\"reel-side-icons\">\n          <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z\"/></svg><span>Helpful</span></div>\n        </div>\n        <div class=\"reel-foot\">\n          <div class=\"reel-handle\"><span class=\"reel-avatar\"></span>Kabir D.</div>\n          <div class=\"reel-stars\">★★★★★</div>\n          <div class=\"reel-caption\">\"Deception shots feel completely different — the frame flex is noticeably faster than my last racket.\"</div>\n          <span class=\"reel-tag\">Wearing: Hyfonic 7 — 4U</span>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"reviews-footnote\">\n    <!--\n      <a class=\"submit-cta\" href=\"#\">Submit your video review →</a>-->\n    </div>\n\n  </div>\n</section>\n\n<script>\n  function playReview(btn){\n    const card = btn.closest('.reel-card');\n    const src = card.getAttribute('data-video');\n    const poster = card.getAttribute('data-poster') || '';\n\n    let video = card.querySelector('.reel-video');\n    if(!video){\n      video = document.createElement('video');\n      video.className = 'reel-video';\n      video.setAttribute('controls','');\n      video.setAttribute('playsinline','');\n      if(poster) video.setAttribute('poster', poster);\n      const source = document.createElement('source');\n      source.src = src;\n      video.appendChild(source);\n      card.appendChild(video);\n    }\n    video.play();\n\n    card.querySelector('.reel-poster').style.display = 'none';\n    card.querySelector('.reel-scrim').style.display = 'none';\n    btn.style.display = 'none';\n    card.querySelector('.reel-side-icons').style.display = 'none';\n    card.querySelector('.reel-foot').style.display = 'none';\n    card.querySelector('.duration-tag').style.display = 'none';\n  }\n</script>\n\n</body>\n</html>",
