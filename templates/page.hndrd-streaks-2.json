     0 0 0 1px rgba(255, 255, 255, 0.03) inset,\n      0 1px 0 rgba(255, 255, 255, 0.22) inset;\n\n    animation:\n      hndrd-premium-breathe 3.8s ease-in-out infinite,\n      hndrd-gradient-shift 7s ease-in-out infinite;\n\n    transition:\n      transform 0.22s ease,\n      box-shadow 0.22s ease,\n      filter 0.22s ease;\n  }\n\n  /* premium moving shine */\n  .hndrd-final-cta__btn::before {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n\n    top: -60%;\n    left: -45%;\n\n    width: 34%;\n    height: 220%;\n\n    transform: rotate(18deg);\n\n    background: linear-gradient(\n      90deg,\n      transparent 0%,\n      rgba(255,255,255,0.08) 30%,\n      rgba(255,255,255,0.48) 50%,\n      rgba(255,255,255,0.08) 70%,\n      transparent 100%\n    );\n\n    filter: blur(2px);\n    opacity: 0;\n\n    animation: hndrd-shine 4.8s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  /* soft inner glass highlight */\n  .hndrd-final-cta__btn::after {\n    content: \"\";\n    position: absolute;\n    inset: 1px;\n    border-radius: 11px;\n    pointer-events: none;\n\n    background: linear-gradient(\n      180deg,\n      rgba(255,255,255,0.10) 0%,\n      rgba(255,255,255,0.025) 34%,\n      rgba(0,0,0,0.035) 100%\n    );\n\n    z-index: -1;\n  }\n\n  .hndrd-final-cta__btn:hover {\n    transform: translateY(-3px);\n\n    box-shadow:\n      0 16px 38px rgba(236, 170, 40, 0.22),\n      0 0 24px rgba(236, 170, 40, 0.10),\n      0 1px 0 rgba(255, 255, 255, 0.28) inset;\n\n    filter: brightness(1.035);\n  }\n\n  .hndrd-final-cta__btn:active {\n    transform: translateY(-1px) scale(0.995);\n  }\n\n  .hndrd-final-cta__btn-left {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    text-align: left;\n    position: relative;\n    z-index: 2;\n  }\n\n  .hndrd-final-cta__icon {\n    width: 46px;\n    height: 46px;\n    flex-shrink: 0;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 10px;\n\n    background:\n      linear-gradient(\n        145deg,\n        #160079,\n        #10005c\n      );\n\n    box-shadow:\n      0 7px 18px rgba(16, 0, 92, 0.24),\n      0 1px 0 rgba(255,255,255,0.08) inset;\n\n    font-size: 24px;\n  }\n\n  .hndrd-final-cta__btn-small {\n    display: block;\n    margin-bottom: 2px;\n    color: rgba(16, 0, 92, 0.68);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n\n  .hndrd-final-cta__btn-name {\n    display: block;\n    color: #10005c;\n    font-size: 25px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: -0.5px;\n    text-transform: uppercase;\n  }\n\n  .hndrd-final-cta__btn-action {\n    position: relative;\n    z-index: 2;\n\n    display: flex;\n    align-items: center;\n    gap: 8px;\n\n    padding: 10px 14px;\n    border-radius: 8px;\n\n    background:\n      linear-gradient(\n        145deg,\n        #160079,\n        #10005c\n      );\n\n    box-shadow:\n      0 6px 16px rgba(16, 0, 92, 0.20),\n      0 1px 0 rgba(255,255,255,0.08) inset;\n  }\n\n  .hndrd-final-cta__btn-action-text {\n    color: #ffffff;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .hndrd-final-cta__btn-action svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n    transition: transform 0.2s ease;\n  }\n\n  .hndrd-final-cta__btn:hover .hndrd-final-cta__btn-action svg {\n    transform: translateX(3px);\n  }\n\n  .hndrd-final-cta__urgency {\n    margin-bottom: 28px;\n    color: #ecaa28;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 800;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n  }\n\n  .hndrd-final-cta__terms {\n    margin: 0 auto;\n    max-width: 560px;\n    color: #777777;\n    font-size: 12px;\n    line-height: 1.65;\n    font-weight: 400;\n  }\n\n  @keyframes hndrd-shine {\n    0% {\n      left: -45%;\n      opacity: 0;\n    }\n\n    12% {\n      opacity: 0;\n    }\n\n    20% {\n      opacity: 0.75;\n    }\n\n    42% {\n      left: 115%;\n      opacity: 0;\n    }\n\n    100% {\n      left: 115%;\n      opacity: 0;\n    }\n  }\n\n  @keyframes hndrd-premium-breathe {\n    0%,\n    100% {\n      box-shadow:\n        0 10px 30px rgba(236, 170, 40, 0.11),\n        0 0 0 1px rgba(255,255,255,0.03) inset,\n        0 1px 0 rgba(255,255,255,0.20) inset;\n    }\n\n    50% {\n      box-shadow:\n        0 13px 34px rgba(236, 170, 40, 0.18),\n        0 0 18px rgba(236, 170, 40, 0.06),\n        0 1px 0 rgba(255,255,255,0.25) inset;\n    }\n  }\n\n  @keyframes hndrd-gradient-shift {\n    0%,\n    100% {\n      background-position: 0% 50%;\n    }\n\n    50% {\n      background-position: 100% 50%;\n    }\n  }\n\n  @media screen and (max-width: 767px) {\n    .hndrd-final-cta {\n      padding: 54px 18px 48px;\n    }\n\n    .hndrd-final-cta__eyebrow {\n      font-size: 11px;\n      padding: 6px 13px;\n      margin-bottom: 18px;\n    }\n\n    .hndrd-final-cta__headline {\n      font-size: 48px;\n      line-height: 0.98;\n      letter-spacing: -2px;\n    }\n\n    .hndrd-final-cta__sub {\n      margin-top: 18px;\n      margin-bottom: 28px;\n      font-size: 16px;\n      line-height: 1.5;\n    }\n\n    .hndrd-final-cta__btn {\n      padding: 15px;\n      border-radius: 10px;\n    }\n\n    .hndrd-final-cta__btn::after {\n      border-radius: 9px;\n    }\n\n    .hndrd-final-cta__icon {\n      width: 42px;\n      height: 42px;\n      font-size: 21px;\n    }\n\n    .hndrd-final-cta__btn-name {\n      font-size: 21px;\n    }\n\n    .hndrd-final-cta__btn-action {\n      padding: 9px 11px;\n    }\n\n    .hndrd-final-cta__btn-action-text {\n      display: none;\n    }\n\n    .hndrd-final-cta__urgency {\n      font-size: 11px;\n      letter-spacing: 0.1em;\n      margin-bottom: 24px;\n    }\n\n    .hndrd-final-cta__terms {\n      font-size: 10px;\n      line-height: 1.6;\n    }\n  }\n\n  @media screen and (max-width: 380px) {\n    .hndrd-final-cta__headline {\n      font-size: 42px;\n    }\n\n    .hndrd-final-cta__btn-left {\n      gap: 10px;\n    }\n\n    .hndrd-final-cta__btn-name {\n      font-size: 19px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hndrd-final-cta__btn {\n      animation: none;\n      transition: none;\n    }\n\n    .hndrd-final-cta__btn::before {\n      animation: none;\n      display: none;\n    }\n\n    .hndrd-final-cta__btn-action svg {\n      transition: none;\n    }\n  }\n</style>\n\n<section class=\"hndrd-final-cta\" id=\"sv-register\">\n\n  <div class=\"hndrd-final-cta__inner\">\n\n    <span class=\"hndrd-final-cta__eyebrow\">\n      28 Aug · Bangalore\n    </span>\n\n    <h2 class=\"hndrd-final-cta__headline\">\n      JOIN FOR<br>\n      <span>₹199</span>\n    </h2>\n\n    <p class=\"hndrd-final-cta__sub\">\n      Lock in your spot for HNDRD Streaks and get ready for round-by-round competition.\n    </p>\n\n    <div class=\"hndrd-final-cta__platform\">\n\n      <a\n        href=\"https://offlyn.life/e/BtLqBJC\"\n        class=\"hndrd-final-cta__btn\"\n        target=\"_blank\"\n        rel=\"noopener\"\n      >\n\n        <div class=\"hndrd-final-cta__btn-left\">\n\n          <span class=\"hndrd-final-cta__icon\" aria-hidden=\"true\">\n            🎟\n          </span>\n\n          <div>\n\n            <span class=\"hndrd-final-cta__btn-small\">\n              Register on\n            </span>\n\n            <span class=\"hndrd-final-cta__btn-name\">\n              OFFLYN\n            </span>\n\n          </div>\n\n        </div>\n\n        <div class=\"hndrd-final-cta__btn-action\">\n\n          <span class=\"hndrd-final-cta__btn-action-text\">\n            Register Now\n          </span>\n\n          <svg\n            viewBox=\"0 0 14 14\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d=\"M2.5 7h9M8 3.5L11.5 7 8 10.5\"\n       