event-venue\">Raghurai Endo Sports Complex</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/xywb1kGVaHoEKc7U8\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">07</div><div class=\"hxad-event-time\">6–8<br>PM</div></div>\n              <div class=\"hxad-event-venue\">Raghurai Endo Sports Complex</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/xywb1kGVaHoEKc7U8\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"hxad-card\" data-idx=\"4\">\n        <div class=\"hxad-inner\">\n          <span class=\"hxad-badge\">05/06</span>\n          <div class=\"hxad-glare\"></div>\n          <h3 class=\"hxad-city\">Ajmer</h3>\n          <p class=\"hxad-range\">8 Sep · 1 Event</p>\n          <div class=\"hxad-events\">\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">08</div><div class=\"hxad-event-time\">4–6<br>PM</div></div>\n              <div class=\"hxad-event-venue\">Indoor Badminton Academy, Patel Stadium</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/XhraqCzZE2FK6ipe6\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"hxad-card\" data-idx=\"5\">\n        <div class=\"hxad-inner\">\n          <span class=\"hxad-badge\">06/06</span>\n          <div class=\"hxad-glare\"></div>\n          <h3 class=\"hxad-city\">Jaipur</h3>\n          <p class=\"hxad-range\">9–11 Sep · 4 Events</p>\n          <div class=\"hxad-events\">\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">09</div><div class=\"hxad-event-time\">4–6<br>PM</div></div>\n              <div class=\"hxad-event-venue\">Achievers Badminton Academy</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/ecVbzWVCUYHrHjTR7\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">10</div><div class=\"hxad-event-time\">7–9<br>AM</div></div>\n              <div class=\"hxad-event-venue\">Achievers Badminton Academy</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/ecVbzWVCUYHrHjTR7\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">10</div><div class=\"hxad-event-time\">4–6<br>PM</div></div>\n              <div class=\"hxad-event-venue\">AIM Badminton Academy, Jaipur</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/Rqr21DfurbRRaZpr7\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n            <div class=\"hxad-event\">\n              <div class=\"hxad-event-when\"><div class=\"hxad-event-date\">11</div><div class=\"hxad-event-time\">7–9<br>AM</div></div>\n              <div class=\"hxad-event-venue\">AIM Badminton Academy, Jaipur</div>\n              <a class=\"hxad-event-go\" href=\"https://maps.app.goo.gl/Rqr21DfurbRRaZpr7\" target=\"_blank\" rel=\"noopener\" aria-label=\"Get directions\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M7 7h10v10\"/></svg></a>\n            </div>\n          </div>\n        </div>\n      </article>\n\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      var root = document.getElementById('hndrd-rajasthan-tour');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.hxad-card'));\n      var canHover = window.matchMedia && window.matchMedia('(pointer: fine)').matches;\n\n      // staggered 3D flip-in on scroll\n      if ('IntersectionObserver' in window) {\n        var obs = new IntersectionObserver(function (entries) {\n          entries.forEach(function (entry) {\n            if (entry.isIntersecting) {\n              var idx = parseInt(entry.target.getAttribute('data-idx'), 10) || 0;\n              entry.target.style.transitionDelay = (idx * 90) + 'ms';\n              entry.target.classList.add('hxad-in');\n              obs.unobserve(entry.target);\n            }\n          });\n        }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n        cards.forEach(function (c) { obs.observe(c); });\n      } else {\n        cards.forEach(function (c) { c.classList.add('hxad-in'); });\n      }\n\n      cards.forEach(function (card) {\n        var inner = card.querySelector('.hxad-inner');\n\n        if (canHover) {\n          card.addEventListener('pointermove', function (e) {\n            var r = card.getBoundingClientRect();\n            var px = (e.clientX - r.left) / r.width;\n            var py = (e.clientY - r.top) / r.height;\n            var rotY = (px - 0.5) * 14;\n            var rotX = (0.5 - py) * 12;\n            inner.style.transition = 'none';\n            inner.style.transform = 'rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) translateZ(0)';\n            inner.style.setProperty('--mx', (px * 100) + '%');\n            inner.style.setProperty('--my', (py * 100) + '%');\n          });\n          card.addEventListener('pointerleave', function () {\n            inner.style.transition = 'transform 0.5s cubic-bezier(.2,.8,.2,1)';\n            inner.style.transform = 'rotateX(0deg) rotateY(0deg)';\n          });\n        } else {\n          card.classList.add('hxad-idle-float');\n          card.style.animationDelay = (parseInt(card.getAttribute('data-idx'), 10) * 0.3) + 's';\n        }\n      });\n    })();\n  </script>\n\n</section>",
