ks-info,\n    .hndrd-streaks-info::before {\n      animation: none !important;\n    }\n\n    .hndrd-board-row {\n      transition: none !important;\n    }\n  }\n</style>\n\n\n<section class=\"hndrd-streaks-section\">\n\n  <div class=\"hndrd-streaks-hero\">\n\n\n    <!-- BACKGROUND LEADERBOARD -->\n\n    <div class=\"hndrd-leaderboard\" aria-hidden=\"true\">\n\n      <div class=\"hndrd-board-head\">\n\n        <span>RANK</span>\n        <span>TEAM</span>\n        <span>WINS</span>\n        <span>STREAK</span>\n\n      </div>\n\n\n      <div\n        class=\"hndrd-board-rows\"\n        id=\"hndrdLiveLeaderboard\"\n      >\n\n\n        <div class=\"hndrd-board-row is-leader\">\n\n          <span class=\"hndrd-row-rank\">\n            #01\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM ALPHA\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            05\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            🔥🔥🔥\n          </span>\n\n        </div>\n\n\n        <div class=\"hndrd-board-row\">\n\n          <span class=\"hndrd-row-rank\">\n            #02\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM BRAVO\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            04\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            🔥🔥\n          </span>\n\n        </div>\n\n\n        <div class=\"hndrd-board-row\">\n\n          <span class=\"hndrd-row-rank\">\n            #03\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM COBRA\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            03\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            🔥\n          </span>\n\n        </div>\n\n\n        <div class=\"hndrd-board-row\">\n\n          <span class=\"hndrd-row-rank\">\n            #04\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM DRIFT\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            03\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            —\n          </span>\n\n        </div>\n\n\n        <div class=\"hndrd-board-row\">\n\n          <span class=\"hndrd-row-rank\">\n            #05\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM EDGE\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            02\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            🔥\n          </span>\n\n        </div>\n\n\n        <div class=\"hndrd-board-row\">\n\n          <span class=\"hndrd-row-rank\">\n            #06\n          </span>\n\n          <span class=\"hndrd-row-team\">\n            TEAM FLARE\n          </span>\n\n          <span class=\"hndrd-row-wins\">\n            01\n          </span>\n\n          <span class=\"hndrd-row-streak\">\n            —\n          </span>\n\n        </div>\n\n\n      </div>\n\n    </div>\n\n\n    <!-- MAIN CONTENT -->\n\n    <div class=\"hndrd-streaks-content\">\n\n      <div class=\"hndrd-streaks-kicker\">\n        Leaderboard\n      </div>\n\n\n      <h2 class=\"hndrd-streaks-title\">\n        HNDRD STREAKS🔥\n      </h2>\n\n\n      <div class=\"hndrd-streaks-copy\">\n\n        <strong>\n          8 teams. New opponents every round.\n          One leaderboard to climb.\n        </strong>\n\n        <br>\n\n        Win your games,\n        <strong class=\"hndrd-orange\">\n          keep your streak alive\n        </strong>,\n        and fight your way to the top.\n\n        <br>\n\n        Finish\n        <strong class=\"hndrd-orange\">\n          #1\n        </strong>\n        and take home a\n        <strong>\n          free pair of HNDRD badminton shoes. 🏆\n        </strong>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <!-- EVENT INFORMATION -->\n\n  <div class=\"hndrd-streaks-info\">\n\n    <div class=\"hndrd-streaks-info-inner\">\n\n\n      <div class=\"hndrd-streaks-item\">\n\n        <div class=\"hndrd-streaks-label\">\n          Date\n        </div>\n\n        <div class=\"hndrd-streaks-value\">\n          28 AUG 2026\n        </div>\n\n      </div>\n\n\n      <div class=\"hndrd-streaks-item\">\n\n        <div class=\"hndrd-streaks-label\">\n          Venue\n        </div>\n\n        <div class=\"hndrd-streaks-value venue\">\n          Machaxi LBS Nagar Sports,\n          Health &amp; Fitness Club,\n          Kaggadasapura\n        </div>\n\n      </div>\n\n\n      <div class=\"hndrd-streaks-item\">\n\n        <div class=\"hndrd-streaks-label\">\n          Reporting\n        </div>\n\n        <div class=\"hndrd-streaks-value\">\n          6:30 PM onwards\n        </div>\n\n      </div>\n\n\n      <div class=\"hndrd-streaks-item\">\n\n        <div class=\"hndrd-streaks-label\">\n          Duration\n        </div>\n\n        <div class=\"hndrd-streaks-value\">\n          2 HOURS\n        </div>\n\n      </div>\n\n\n      <div class=\"hndrd-streaks-item\">\n\n        <div class=\"hndrd-streaks-label\">\n          Entry Fee\n        </div>\n\n        <div class=\"hndrd-streaks-value\">\n          ₹199/- PER PERSON\n        </div>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<script>\n(function () {\n\n  const board =\n    document.getElementById(\"hndrdLiveLeaderboard\");\n\n  if (!board) return;\n\n\n  const reduceMotion =\n    window.matchMedia &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n\n  if (reduceMotion) return;\n\n\n  let running = false;\n\n\n  function updateRanks() {\n\n    const rows =\n      Array.from(\n        board.querySelectorAll(\".hndrd-board-row\")\n      );\n\n\n    rows.forEach(function(row, index) {\n\n      const rank =\n        row.querySelector(\".hndrd-row-rank\");\n\n\n      if (rank) {\n\n        rank.textContent =\n          \"#\" +\n          String(index + 1).padStart(2, \"0\");\n\n      }\n\n\n      row.classList.toggle(\n        \"is-leader\",\n        index === 0\n      );\n\n    });\n\n  }\n\n\n  function shuffleLeaderboard() {\n\n    if (running) return;\n\n    running = true;\n\n\n    const rows =\n      Array.from(\n        board.querySelectorAll(\".hndrd-board-row\")\n      );\n\n\n    if (rows.length < 2) {\n\n      running = false;\n\n      return;\n\n    }\n\n\n    const positions =\n      new Map();\n\n\n    rows.forEach(function(row) {\n\n      positions.set(\n        row,\n        row.getBoundingClientRect().top\n      );\n\n    });\n\n\n    const topRow =\n      rows[0];\n\n\n    const bottomRow =\n      rows[rows.length - 1];\n\n\n    board.insertBefore(\n      bottomRow,\n      board.firstElementChild\n    );\n\n\n    board.appendChild(\n      topRow\n    );\n\n\n    const newRows =\n      Array.from(\n        board.querySelectorAll(\".hndrd-board-row\")\n      );\n\n\n    newRows.forEach(function(row) {\n\n      const oldTop =\n        positions.get(row);\n\n\n      const newTop =\n        row.getBoundingClientRect().top;\n\n\n      const distance =\n        oldTop - newTop;\n\n\n      row.style.transition =\n        \"none\";\n\n\n      row.style.transform =\n        \"translateY(\" +\n        distance +\n        \"px)\";\n\n    });\n\n\n    board.offsetHeight;\n\n\n    requestAnimationFrame(function() {\n\n      newRows.forEach(function(row) {\n\n        row.style.transition =\n          \"transform 700ms cubic-bezier(.22,.8,.25,1),\" +\n          \"background 400ms ease,\" +\n          \"color 400ms ease,\" +\n          \"box-shadow 400ms ease\";\n\n\n        row.style.transform =\n          \"translateY(0)\";\n\n      });\n\n    });\n\n\n    setTimeout(function() {\n\n      updateRanks();\n\n    }, 350);\n\n\n    setTimeout(function() {\n\n      running = false;\n\n    }, 780);\n\n  }\n\n\n  updateRanks();\n\n\n  setInterval(\n    shuffleLeaderboard,\n    3000\n  );\n\n})();\n</script>",
