 none !important;\n    display: none !important;\n    background: none !important;\n  }\n\n  .ti-flex-cta span {\n    position: relative;\n  }\n\n  /* HOVER — STILL TRANSPARENT */\n  .ti-flex-cta:hover {\n    background: transparent !important;\n    background-image: none !important;\n\n    color: #FFFFFF;\n    border-color: #7C7872;\n\n    transform: translateY(-2px);\n  }\n\n  /* CLICK / FOCUS — STILL TRANSPARENT */\n  .ti-flex-cta:focus,\n  .ti-flex-cta:active {\n    background: transparent !important;\n    background-image: none !important;\n\n    color: #7C7872;\n    border-color: #7C7872;\n  }\n\n\n  /* =========================\n     TABLET\n  ========================= */\n\n  @media screen and (max-width: 990px) {\n\n    .ti-flex-section {\n      padding: 55px 22px 52px;\n    }\n\n    .ti-flex-title {\n      font-size: clamp(43px, 6vw, 65px);\n      letter-spacing: -2px;\n    }\n\n    .ti-flex-description {\n      max-width: 720px;\n      font-size: 18px;\n    }\n\n    .ti-flex-cta-wrap {\n      margin-top: 30px;\n    }\n  }\n\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media screen and (max-width: 749px) {\n\n    .ti-flex-section {\n      padding: 42px 18px 40px;\n    }\n\n    .ti-flex-inner {\n      max-width: 100%;\n    }\n\n    .ti-flex-title {\n      font-size: clamp(34px, 10.5vw, 48px);\n      line-height: 1.02;\n      letter-spacing: -1.6px;\n    }\n\n    .ti-flex-description {\n      max-width: 355px;\n      margin-top: 15px;\n\n      font-size: 15px;\n      font-weight: 500;\n      line-height: 1.45;\n      letter-spacing: 0;\n    }\n\n    .ti-flex-cta-wrap {\n      margin-top: 27px;\n    }\n\n    .ti-flex-cta {\n      min-width: 260px;\n      height: 56px;\n      padding: 0 28px;\n\n      border-width: 1.5px;\n\n      font-size: 12px;\n      letter-spacing: 1.8px;\n    }\n  }\n\n\n  /* =========================\n     SMALL MOBILE\n  ========================= */\n\n  @media screen and (max-width: 390px) {\n\n