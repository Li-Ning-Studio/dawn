ight:auto;overflow:visible;padding:0;margin:0;background:transparent!important;border:0!important;vertical-align:baseline;isolation:isolate;--word:#43c97a}\n#hnps-{{sid}} .rsr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n#hnps-{{sid}} .rw{display:inline-flex;align-items:baseline;white-space:nowrap;width:auto;height:auto;padding:0;margin:0;overflow:visible;line-height:.92;background:transparent!important;box-shadow:none!important}\n#hnps-{{sid}} .rch{display:inline-block;padding:0;margin:0;line-height:.92;letter-spacing:-.035em;color:var(--word)!important;-webkit-text-fill-color:var(--word)!important;background:none!important;text-shadow:none!important;filter:none!important;opacity:0;transform:translateY(115%) rotate(6deg);animation:hnpsRotIn-{{sid}} .72s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d);animation-play-state:paused!important}\n#hnps-{{sid}} .rw.is-ready .rch{animation-play-state:running!important}\n@keyframes hnpsRotIn-{{sid}}{0%{opacity:0;transform:translateY(115%) rotate(6deg)}100%{opacity:1;transform:translateY(0) rotate(0)}}\n#hnps-{{sid}} .sub{font-size:clamp(14px,1.15vw,17px);font-weight:500;color:rgba(255,255,255,.62);max-width:580px;line-height:1.45;margin:0}\n\n#hnps-{{sid}} .star{display:inline-block;position:relative;border-radius:999px;overflow:hidden;padding:1px 0;color:#fff;background:transparent;isolation:isolate;box-shadow:0 0 20px rgba(var(--sr,255,255,255),.14),0 0 42px rgba(var(--sr,255,255,255),.08);animation:hnpsOuter-{{sid}} 2.8s ease-in-out infinite}\n#hnps-{{sid}} .star:after{content:\"\";position:absolute;inset:-18px;z-index:-1;background:radial-gradient(circle,rgba(var(--sr,255,255,255),.22),transparent 62%);opacity:.5;filter:blur(18px);animation:hnpsHalo-{{sid}} 2.8s ease-in-out infinite}\n#hnps-{{sid}} .bgb,#hnps-{{sid}} .bgt{position:absolute;width:300%;height:50%;opacity:.85;border-radius:50%;background:radial-gradient(circle,var(--sc,#fff),transparent 10%);anima