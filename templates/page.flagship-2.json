ps-{{sid}} .spec b{font-size:19px}\n#hnps-{{sid}} .spec span{font-size:8px}\n#hnps-{{sid}} .product-btn{width:auto;display:inline-flex;min-width:210px}\n#hnps-{{sid}} .thread{display:block;position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.07);transform:translateX(-50%);z-index:1}\n#hnps-{{sid}} .thread:before{content:\"\";position:absolute;inset:0 0 auto;width:1px;height:100%;background:var(--ac);box-shadow:0 0 18px var(--ac),0 0 38px rgba(var(--rgb),.28);transform:scaleY(var(--line-progress,0));transform-origin:top;transition:transform .18s linear}\n#hnps-{{sid}} .thread i{position:absolute;left:50%;top:0;width:8px;height:8px;border-radius:50%;background:var(--ac);box-shadow:0 0 18px var(--ac),0 0 42px rgba(var(--rgb),.38);transform:translate(-50%,var(--dot-y,50%)) translateY(-50%)}\n#hnps-{{sid}} .mobile-tabs-wrap{display:none}\n#hnps-{{sid}} .quiz{align-items:center;padding:24px}\n#hnps-{{sid}} .modal{width:min(520px,92vw);padding:42px;border:1px solid rgba(255,255,255,.1);border-radius:26px;transform:translateY(20px) scale(.94)}\n#hnps-{{sid}} .quiz.on .modal{transform:none}\n#hnps-{{sid}} .sheet-handle{display:none}\n}\n\n@media(max-width:380px){\n#hnps-{{sid}} .hero{padding-left:10px;padding-right:10px}\n#hnps-{{sid}} .intro{padding:50px 16px 42px}\n#hnps-{{sid}} .intro h2{font-size:32px}\n#hnps-{{sid}} .intro>p:last-child{font-size:12.8px;max-width:290px}\n#hnps-{{sid}} .title{font-size:clamp(27px,8.6vw,31px);letter-spacing:-.06em}\n#hnps-{{sid}} .chap{padding-left:13px;padding-right:13px;padding-top:56px;padding-bottom:70px}\n#hnps-{{sid}} .mobile-tabs{grid-template-columns:repeat(4,minmax(0,1fr)) 48px}\n#hnps-{{sid}} .mobile-tabs a{font-size:8.35px;letter-spacing:.025em;gap:4px}\n#hnps-{{sid}} .mobile-tabs a:before{width:4px;height:4px}\n#hnps-{{sid}} .quiz-word{font-size:8px}\n}\n\n@media(max-width:380px){\n#hnps-{{sid}} .modal{padding-left:15px;padding-right:15px}\n#hnps-{{sid}} .step h3{font-size:25px}\n#hnps-{{sid}} .qsub{font-size:12px}\n#hnps-{{sid}} .choice{min-height:54px;padding:12px 13px;gap:10px}\n#hnps-{{sid}} .choice span:first-child{font-size:13px}\n#hnps-{{sid}} .choice span:last-child{font-size:8px;letter-spacing:.1em}\n}\n\n@supports not (color:color-mix(in srgb,red 50%,blue)){\n#hnps-{{sid}} .primary-btn{border-color:var(--hero-cta-ac)}\n}\n\n@media(prefers-reduced-motion:reduce){\n#hnps-{{sid}} *,#hnps-{{sid}} *:before,#hnps-{{sid}} *:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}\n}\n\n/* DESKTOP NATIVE CURSOR: disables theme/plugin custom cursor overlays on this page */\n@media (hover:hover) and (pointer:fine){\nhtml.hnps-native-cursor,html.hnps-native-cursor body,html.hnps-native-cursor body *{cursor:default!important}\nhtml.hnps-native-cursor a[href],html.hnps-native-cursor button,html.hnps-native-cursor summary,html.hnps-native-cursor select,html.hnps-native-cursor label[for],html.hnps-native-cursor [role=\"button\"],html.hnps-native-cursor [data-jump],html.hnps-native-cursor [data-compare-jump]{cursor:pointer!important}\nhtml.hnps-native-cursor input:not([type=\"button\"]):not([type=\"submit\"]):not([type=\"reset\"]):not([type=\"checkbox\"]):not([type=\"radio\"]):not([type=\"range\"]),html.hnps-native-cursor textarea,html.hnps-native-cursor [contenteditable=\"true\"]{cursor:text!important}\nhtml.hnps-native-cursor input[type=\"range\"]{cursor:grab!important}\nhtml.hnps-native-cursor input[type=\"range\"]:active{cursor:grabbing!important}\nhtml.hnps-native-cursor .custom-cursor,\nhtml.hnps-native-cursor .custom-cursor-dot,\nhtml.hnps-native-cursor .custom-cursor-follower,\nhtml.hnps-native-cursor .cursor-dot,\nhtml.hnps-native-cursor .cursor-follower,\nhtml.hnps-native-cursor .mouse-cursor,\nhtml.hnps-native-cursor [data-custom-cursor],\nhtml.hnps-native-cursor [data-cursor-dot],\nhtml.hnps-native-cursor [data-cursor-follower],\nhtml.hnps-native-cursor body>.cursor{display:none!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important}\n}\n\n</style>\n<section class=\"intro\">\n  <p class=\"intro-label\">The Lineup</p>\n  <h2><span>One standard.</span><span>Four strengths.</span></h2>\n  <p>Each Racket is tuned to do one thing exceptionally well.</p>\n</section>\n\n<div class=\"mobile-tabs-wrap\">\n  <nav class=\"mobile-tabs\" aria-label=\"Quick product navigation\">\n    <a href=\"#hnps-venom\" data-dock=\"0\" data-jump class=\"is-active\" style=\"--dock:#22c55e\"><span>Venom</span></a>\n    <a href=\"#hnps-volta\" data-dock=\"1\" data-jump style=\"--dock:#3b82f6\"><span>Volta</span></a>\n    <a href=\"#hnps-hyfonic\" data-dock=\"2\" data-jump style=\"--dock:#a855f7\"><span>Hyfonic</span></a>\n    <a href=\"#hnps-flareon\" data-dock=\"3\" data-jump style=\"--dock:#ef4444\"><span>Flareon</span></a>\n    <button type=\"button\" data-open aria-label=\"Open racket quiz\"><span class=\"quiz-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"7\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg></span><span class=\"quiz-word\" aria-hidden=\"true\">Quiz</span><span class=\"sr-only\">Open racket quiz</span></button>\n  </nav>\n</div>\n\n<section id=\"hnps-venom\" class=\"chap\" data-chapter=\"0\" style=\"--ac:#22c55e;--rgb:34,197,94\">\n  <div class=\"thread\"><i></i></div>\n  <div class=\"inner\">\n    <div class=\"chapter-top\"><span class=\"chapter-count\">01 / 04</span><span class=\"chapter-series\">Attack Series</span></div>\n    <div class=\"vis\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=720\" srcset=\"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=480 480w, https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=720 720w, https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=960 960w\" sizes=\"(max-width:768px) calc(100vw - 32px), 480px\" alt=\"Nitrix 70 Venom\" width=\"900\" height=\"900\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\"></div>\n    <div class=\"copy\"><h2>Nitrix 70 Venom</h2><h3>Heavy Smashes. Clean Finish.</h3><p class=\"desc\">Crafted for heavy smashes and offensive play. It loads up each swing with momentum, while its ultra-slim 6.1mm shaft creates a whip-like effect on contact. M46X carbon fiber ensures superior power transfer and responsiveness, while CNTRL Foam absorbs shock and keeps each shot stable.</p><div class=\"spec\"><div><b>6.1mm</b><span>Shaft Dia.</span></div><div><b>Hard</b><span>Flex</span></div><div><b>32 Lbs</b><span>Max Tension</span></div></div><a href=\"https://in.hndrd.co/products/nitrix-70-venom\" class=\"product-btn\">Enter Attack Mode <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>\n  </div>\n</section>\n\n<section id=\"hnps-volta\" class=\"chap\" data-chapter=\"1\" style=\"--ac:#3b82f6;--rgb:59,130,246\">\n  <div class=\"thread\"><i></i></div>\n  <div class=\"inner rev\">\n    <div class=\"chapter-top\"><span class=\"chapter-count\">02 / 04</span><span class=\"chapter-series\">Power Series</span></div>\n    <div class=\"copy\"><h2>Nitrix 70 Volta</h2><h3>Clean Power. Faster Swing.</h3><p class=\"desc\">Manufactured for clean, aggressive power. Its aerodynamic frame cuts through the air and generates maximum force in every swing. M46X carbon fiber boosts energy transfer, AECG+ carbon fibre creates a sharp snap-back, and T-Fuse strengthens the racket's core.</p><div class=\"spec\"><div><b>7.0mm</b><span>Shaft Dia.</span></div><div><b>Flexible</b><span>Flex</span></div><div><b>32 Lbs</b><span>Max Tension</span></div></div><a href=\"https://in.hndrd.co/products/nitrix-70-volta\" class=\"product-btn\">Enter Power Mode <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>\n    <div class=\"vis\"><img src=\"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=720\" srcset=\"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=480 480w, https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=720 720w, https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=960 960w\" sizes=\"(max-width:768px) calc(100vw - 32px), 480px\" alt=\"Nitrix 70 Volta\" width=\"900\" height=\"900\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\"></div>\n  </div>\n</section>\n\n<section id=\"hnps-hyfonic\" class=\"chap\" data-chapter=\"2\" style=\"--ac:#a855f7;--rgb:168,85,247\">\n  <div class=\"thread\"><i></i></div>\n  <div class=\"inner\">\n    <div class=\"chapter-top\"><span class=\"chapter-count\">03 / 04</span><span class=\"chapter-series\">Precision Series</span></div>\n    <div class=\"vis\"><img src=\"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=720\" srcset=\"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=480 480w, https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=720 720w, https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=960 960w\" sizes=\"(max-width:768px) calc(100vw - 32px), 480px\" alt=\"Hyfonic 7\" width=\"900\" height=\"900\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\"></div>\n    <div class=\"copy\"><h2>Hyfonic 7</h2><h3>Control Every Inch.</h3><p class=\"desc\">Hyfonic 7 responds with sharp, deliberate feedback on every stroke. Its Dual Aerodynamic Frame reduces drag, Torsion Stop Technology resists unwanted twisting, and CNTRL Foam cushions vibrations for a stable, composed hit.</p><div class=\"spec\"><div><b>7.0mm</b><span>Shaft Dia.</span></div><div><b>Flexible</b><span>Flex</span></div><div><b>32 Lbs</b><span>Max Tension</span></div></div><a href=\"https://in.hndrd.co/products/hyfonic-7-4u\" class=\"product-btn\">Enter Precision Mode <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>\n  </div>\n</section>\n\n<section id=\"hnps-flareon\" class=\"chap\" data-chapter=\"3\" style=\"--ac:#ef4444;--rgb:239,68,68\">\n  <div class=\"thread\"><i></i></div>\n  <div class=\"inner rev\">\n    <div class=\"chapter-top\"><span class=\"chapter-count\">04 / 04</span><span class=\"chapter-series\">Speed Series</span></div>\n    <div class=\"copy\"><h2>Flareon 700</h2><h3>Move First. Hit Faster.</h3><p class=\"desc\">Built for lightning-fast hands, rapid reactions and early interceptions. The Torsion Stop System limits unwanted twisting, AECG+ carbon fibre maintains stability, CNTRL Foam absorbs shock, and VaporShaft keeps handling quick and precise.</p><div class=\"spec\"><div><b>7.0mm</b><span>Shaft Dia.</span></div><div><b>Hard</b><span>Flex</span></div><div><b>32 Lbs</b><span>Max Tension</span></div></div><a href=\"https://in.hndrd.co/products/flareon-700-3u\" class=\"product-btn\">Enter Speed Mode <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>\n    <div class=\"vis\"><img src=\"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941&width=720\" srcset=\"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941&width=480 480w, https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941&width=720 720w, https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941&width=960 960w\" sizes=\"(max-width:768px) calc(100vw - 32px), 480px\" alt=\"Flareon 700\" width=\"900\" height=\"900\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\"></div>\n  </div>\n</section>\n\n\n<div class=\"quiz\" aria-hidden=\"true\">\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Find your racket\">\n    <div class=\"sheet-handle\"></div><button class=\"close\" type=\"button\" data-close aria-label=\"Close\">&times;</button>\n    <div class=\"step on\" data-step=\"1\"><p class=\"qeyebrow\">Quick Match</p><h3>What is your playing style?</h3><p class=\"qsub\">Choose one. We will match your racket.</p><div class=\"choice-grid\"><button class=\"choice\" type=\"button\" data-res=\"venom\" style=\"--q:34,197,94\"><span>Heavy Smashes</span><span>Attack</span></button><button class=\"choice\" type=\"button\" data-res=\"volta\" style=\"--q:59,130,246\"><span>Clean Power</span><span>Power</span></button><button class=\"choice\" type=\"button\" data-res=\"hyfonic\" style=\"--q:168,85,247\"><span>Sharp Placement</span><span>Precision</span></button><button class=\"choice\" type=\"button\" data-res=\"flareon\" style=\"--q:239,68,68\"><span>Fast Reactions</span><span>Speed</span></button></div></div>\n    <div class=\"step\" data-step=\"result\"><div class=\"res\"></div></div>\n  </div>\n</div>\n\n<script>\n(function(){\nconst root=document.getElementById('hnps-{{sid}}');if(!root||root.dataset.ready)return;root.dataset.ready='1';\ndocument.documentElement.classList.add('hnps-native-cursor');\nconst motion=!matchMedia('(prefers-reduced-motion: reduce)').matches;\nconst chapters=[...root.querySelectorAll('.chap')],tabsWrap=root.querySelector('.mobile-tabs-wrap'),dock=[...root.querySelectorAll('[data-dock]')];\nlet active=-1,headers=[],lastMeasure=0;\nfunction refreshHeaders(){\n const s='#shopify-section-header,.section-header,header.header,header,sticky-header,.header-wrapper,.shopify-section-group-header-group,.shopify-section-header-sticky,.announcement-bar-section,[data-header]';\n headers=[...new Set([...document.querySelectorAll(s)])].filter(el=>!root.contains(el)&&['fixed','sticky'].includes(getComputedStyle(el).position))\n}\nfunction measure(){\n let bottom=0;\n headers.forEach(el=>{const r=el.getBoundingClientRect(),cs=getComputedStyle(el);\n  if(cs.display==='none'||cs.visibility==='hidden'||+cs.opacity===0||r.width<innerWidth*.7||r.height<=0||r.height>180||r.bottom<=0||r.top>10)return;\n  bottom=Math.max(bottom,Math.min(r.bottom,240))\n });\n root.style.setProperty('--hnps-header-offset',Math.max(0,Math.round(bottom))+'px')\n}\nfunction setActive(i){if(i===active)return;active=i;dock.forEach((a,n)=>a.classList.toggle('is-active',n===i))}\nnew IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{rootMargin:'420px 0px 260px 0px',threshold:.01}).observe(chapters[0]);\nconst reveal=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{rootMargin:'420px 0px 260px 0px',threshold:.01});\nchapters.forEach(c=>reveal.observe(c));\nfunction update(){\n if(!chapters.length)return;\n const mobile=innerWidth<769,header=parseFloat(getComputedStyle(root).getPropertyValue('--hnps-header-offset'))||0,tabs=mobile&&tabsWrap?tabsWrap.offsetHeight:0,trigger=mobile?header+tabs+36:innerHeight*.48;\n let current=0,closest=Infinity;\n chapters.forEach((sec,i)=>{const r=sec.getBoundingClientRect(),anchor=mobile?r.top:r.top+r.height/2,dist=Math.abs(anchor-trigger);\n  if(dist<closest){closest=dist;current=i}\n  if(!mobile){const p=Math.max(0,Math.min(1,(innerHeight*.5-r.top)/r.height)),thread=sec.querySelector('.thread');\n   if(thread){sec.style.setProperty('--line-progress',p.toFixed(3));sec.style.setProperty('--dot-y',(p*thread.offsetHeight).toFixed(0)+'px')}}\n });\n setActive(current)\n}\nlet ticking=false;\nfunction onScroll(){const now=performance.now();if(now-lastMeasure>180){measure();lastMeasure=now}if(ticking)return;ticking=true;requestAnimationFrame(()=>{update();ticking=false})}\nfunction onResize(){refreshHeaders();measure();update()}\naddEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onResize,{passive:true});visualViewport?.addEventListener('resize',onResize,