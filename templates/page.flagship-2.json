") ||\n        el.style.getPropertyValue(\"--accent\") ||\n        style.getPropertyValue(\"--focus\") ||\n        style.getPropertyValue(\"--btn\") ||\n        style.getPropertyValue(\"--sc\") ||\n        style.getPropertyValue(\"--accent\") ||\n        style.borderTopColor ||\n        style.color ||\n        \"#ffffff\";\n\n      color = (color || \"\").trim();\n\n      if (\n        !color ||\n        color === \"initial\" ||\n        color === \"inherit\" ||\n        color === \"transparent\" ||\n        color === \"rgba(0, 0, 0, 0)\"\n      ) {\n        color = \"#ffffff\";\n      }\n\n      return color;\n    }\n\n    function placeCorners(el) {\n      if (!el || !corners.length) return;\n\n      var rect = el.getBoundingClientRect();\n\n      if (rect.width <= 0 || rect.height <= 0) {\n        layer.classList.remove(\"is-active\");\n        return;\n      }\n\n      var gap = 7;\n      var size = 18;\n\n      var points = [\n        [rect.left - gap, rect.top - gap],\n        [rect.right + gap - size, rect.top - gap],\n        [rect.right + gap - size, rect.bottom + gap - size],\n        [rect.left - gap, rect.bottom + gap - size]\n      ];\n\n      corners.forEach(function (corner, index) {\n        corner.style.left = points[index][0] + \"px\";\n        corner.style.top = points[index][1] + \"px\";\n      });\n\n      document.documentElement.style.setProperty(\"--hndrd-site-focus-color\", getColor(el));\n      layer.classList.add(\"is-active\");\n    }\n\n    function activate(el) {\n      activeTarget = el;\n\n      if (raf) cancelAnimationFrame(raf);\n\n      raf = requestAnimationFrame(function () {\n        placeCorners(activeTarget);\n      });\n    }\n\n    function deactivate() {\n      activeTarget = null;\n      layer.classList.remove(\"is-active\");\n    }\n\n    document.addEventListener(\"mousemove\", function (event) {\n      var target = getTarget(event.target);\n\n      if (target) activate(target);\n      else deactivate();\n    }, true);\n\n    document.addEventListener(\"mouseover\", function (event) {\n      var target = getTarget(event.target);\n\n      if (target) activate(target);\n    }, true);\n\n    document.addEventListener(\"mouseout\", function (event) {\n      if (!activeTarget) return;\n\n      var next = event.relatedTarget;\n\n      if (!next || !activeTarget.contains(next)) {\n        deactivate();\n      }\n    }, true);\n\n    document.addEventListener(\"focusin\", function (event) {\n      var target = getTarget(event.target);\n\n      if (target) activate(target);\n    }, true);\n\n    document.addEventListener(\"focusout\", function () {\n      deactivate();\n    }, true);\n\n    document.addEventListener(\"click\", function (event) {\n      var target = getTarget(event.target);\n\n      if (target) activate(target);\n    }, true);\n\n    window.addEventListener(\"scroll\", function () {\n      if (activeTarget) placeCorners(activeTarget);\n    }, { passive: true });\n\n    window.addEventListener(\"resize\", function () {\n      if (activeTarget) placeCorners(activeTarget);\n    });\n  });\n})();\n</script>",
