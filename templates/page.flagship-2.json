        "custom_liquid": "{% assign sid = section.id | default: 'static' %}\n\n<section id=\"hnps-{{ sid }}\" class=\"hnps\">\n  <style>\n    #hnps-{{ sid }},\n    #hnps-{{ sid }} *,\n    #hnps-{{ sid }}::before,\n    #hnps-{{ sid }} *::before,\n    #hnps-{{ sid }} *::after {\n      box-sizing: border-box;\n    }\n\n    #hnps-{{ sid }} {\n      font-family: var(--font-body-family, Inter, Arial, sans-serif);\n      background: #050505;\n      color: #ffffff;\n      overflow: hidden;\n      position: relative;\n    }\n\n    #hnps-{{ sid }} a {\n      color: inherit;\n      text-decoration: none;\n      cursor: pointer !important;\n    }\n\n    #hnps-{{ sid }} button {\n      cursor: pointer !important;\n    }\n\n    #hnps-{{ sid }} svg {\n      width: 16px;\n      height: 16px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 2;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    #hnps-{{ sid }} .hero {\n      min-height: min(86svh, 760px);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: clamp(78px, 9vw, 118px) 24px clamp(56px, 7vw, 88px);\n      position: relative;\n      background:\n        radial-gradient(circle at 50% 8%, rgba(255, 0, 102, .055), transparent 34%),\n        #000000;\n      overflow: hidden;\n    }\n\n    #hnps-{{ sid }} .hero::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      opacity: .08;\n      pointer-events: none;\n      mix-blend-mode: overlay;\n      background-image:\n        repeating-radial-gradient(circle at 20% 30%, rgba(255,255,255,.22) 0 1px, transparent 1px 4px),\n        repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 9px);\n    }\n\n    #hnps-{{ sid }} .hero > * {\n      position: relative;\n      z-index: 2;\n    }\n\n    #hnps-{{ sid }} .kick {\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: 5px;\n      text-transform: uppercase;\n      color: rgba(255,255,255,.42);\n      margin: 0 0 24px;\n    }\n\n    #hnps-{{ sid }} .title {\n      width: 100%;\n      max-width: 1040px;\n      margin: 0 0 24px;\n      font-size: clamp(3rem, 7vw, 6.7rem);\n      font-weight: 950;\n      line-height: .94;\n      letter-spacing: -.06em;\n      text-transform: none;\n      color: #ffffff !important;\n      -webkit-text-fill-color: #ffffff !important;\n      background: transparent !important;\n      background-image: none !important;\n    }\n\n    #hnps-{{ sid }} .tlx {\n      display: inline-flex;\n      align-items: baseline;\n      justify-content: center;\n      gap: .14em;\n      flex-wrap: wrap;\n      white-space: normal;\n      color: #ffffff !important;\n      -webkit-text-fill-color: #ffffff !important;\n      background: transparent !important;\n      background-image: none !important;\n      line-height: .95;\n    }\n\n    #hnps-{{ sid }} .rot {\n      position: relative;\n      display: inline-flex;\n      align-items: baseline;\n      justify-content: center;\n      min-width: 0;\n      width: auto;\n      height: auto;\n      overflow: visible;\n      padding: 0;\n      margin: 0;\n      background: transparent !important;\n      border: 0 !important;\n      vertical-align: baseline;\n      isolation: isolate;\n    }\n\n    #hnps-{{ sid }} .rsr {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n      clip: rect(0,0,0,0);\n      white-space: nowrap;\n    }\n\n    #hnps-{{ sid }} .rw {\n      display: inline-flex;\n      align-items: baseline;\n      white-space: nowrap;\n      width: auto;\n      height: auto;\n      padding: 0;\n      margin: 0;\n      overflow: visible;\n      line-height: .95;\n      background: transparent !important;\n      box-shadow: none !important;\n    }\n\n    #hnps-{{ sid }} .rch {\n      display: inline-block;\n      padding: 0;\n      margin: 0;\n      line-height: .95;\n      letter-spacing: -.035em;\n      background-image: linear-gradient(90deg, var(--word-a), var(--word-b)) !important;\n      background-size: var(--word-w, 100%) 100% !important;\n      background-position: var(--word-x, 0px) 0 !important;\n      background-repeat: no-repeat !important;\n      -webkit-background-clip: text !important;\n      background-clip: text !important;\n      -webkit-text-fill-color: transparent !important;\n      color: transparent !important;\n      opacity: 0;\n      transform: translateY(115%) rotate(6deg);\n      animation: hnStyleRotIn-{{ sid }} .72s cubic-bezier(.16,1,.3,1) forwards;\n      animation-delay: var(--d);\n      animation-play-state: paused !important;\n    }\n\n    #hnps-{{ sid }} .rw.is-ready .rch {\n      animation-play-state: running !important;\n    }\n\n    @keyframes hnStyleRotIn-{{ sid }} {\n      0% {\n        opacity: 0;\n        transform: translateY(115%) rotate(6deg);\n        filter: blur(8px);\n      }\n\n      100% {\n        opacity: 1;\n        transform: translateY(0) rotate(0);\n        filter:\n          drop-shadow(0 0 8px var(--word-glow-a))\n          drop-shadow(0 0 18px var(--word-glow-b));\n      }\n    }\n\n    #hnps-{{ sid }} .sub {\n      font-size: clamp(1rem, 1.5vw, 1.22rem);\n      font-weight: 300;\n      color: rgba(255,255,255,.6);\n      max-width: 570px;\n      line-height: 1.55;\n      margin: 0 0 42px;\n    }\n\n    #hnps-{{ sid }} .star {\n      display: inline-block;\n      position: relative;\n      border-radius: 22px;\n      overflow: hidden;\n      padding: 1px 0;\n      color: #ffffff;\n      background: transparent;\n      isolation: isolate;\n      box-shadow:\n        0 0 20px rgba(var(--sr,255,255,255),.18),\n        0 0 60px rgba(var(--sr,255,255,255),.12);\n      animation: hnpsOuterGlow-{{ sid }} 2.8s ease-in-out infinite;\n    }\n\n    #hnps-{{ sid }} .star::after {\n      content: \"\";\n      position: absolute;\n      inset: -18px;\n      z-index: -1;\n      background: radial-grad