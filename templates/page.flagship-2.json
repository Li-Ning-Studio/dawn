pg?v=1752848941\" alt=\"Flareon 700\"></div>\n  </div>\n</section>\n\n<div class=\"qt\"><button type=\"button\" data-open>Find Your Racket</button></div>\n<div class=\"quiz\"><div class=\"modal\"><button class=\"close\" type=\"button\" data-close>&times;</button><div class=\"step on\" data-step=\"1\"><p class=\"qeyebrow\">Quick Match</p><h3>Choose your style.</h3><p class=\"qsub\">We’ll suggest your racket.</p><button type=\"button\" data-res=\"venom\" style=\"--q:rgba(34,197,94,.9)\"><span>Attack</span></button><button type=\"button\" data-res=\"volta\" style=\"--q:rgba(59,130,246,.9)\"><span>Power</span></button><button type=\"button\" data-res=\"hyfonic\" style=\"--q:rgba(168,85,247,.9)\"><span>Precision</span></button><button type=\"button\" data-res=\"flareon\" style=\"--q:rgba(239,68,68,.9)\"><span>Speed</span></button></div><div class=\"step\" data-step=\"result\"><div class=\"res\"></div></div></div></div>\n\n<script>\n(function(){\nconst root=document.getElementById(\"hnps-{{sid}}\");if(!root||root.dataset.r)return;root.dataset.r=1;\nconst rot=root.querySelector(\".rot\");\nif(rot){\nconst words=[\n{text:\"Attack\",c:\"#43c97a\"},\n{text:\"Power\",c:\"#4e82e8\"},\n{text:\"Precision\",c:\"#9d5de0\"},\n{text:\"Speed\",c:\"#d94a52\"}\n];let index=0;\nfunction split(t){if(window.Intl&&Intl.Segmenter){const s=new Intl.Segmenter(\"en\",{granularity:\"grapheme\"});return Array.from(s.segment(t),x=>x.segment)}return Array.from(t)}\nfunction draw(item){rot.innerHTML=\"\";rot.style.setProperty(\"--word\",item.c);const sr=document.createElement(\"span\");sr.className=\"rsr\";sr.textContent=item.text;const wr=document.createElement(\"span\");wr.className=\"rw\";wr.setAttribute(\"aria-hidden\",\"true\");split(item.text).forEach((char,n)=>{const sp=document.createElement(\"span\");sp.className=\"rch\";sp.textContent=char;sp.style.setProperty(\"--d\",((item.text.length-1-n)*25)+\"ms\");wr.appendChild(sp)});rot.append(sr,wr);requestAnimationFrame(()=>wr.classList.add(\"is-ready\"))}\ndraw(words[index]);root.__hnStyleRotTimer=setInterval(()=>{index=(index+1)%words.length;draw(words[index])},2000)}\nconst rv=root.querySelector(\".rtext\");if(rv){const raw=rv.textContent.trim();const lines=raw.split(\"|\").map(l=>l.trim()).filter(Boolean);rv.innerHTML=lines.map(line=>\"<span class='line'>\"+line.split(/\\s+/).map(w=>\"<span class='word'>\"+w+\"</span>\").join(\" \")+\"</span>\").join(\"\");const words=[...rv.querySelectorAll(\".word\")];const ob=new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting){words.forEach((w,i)=>setTimeout(()=>w.classList.add(\"show\"),i*55));ob.unobserve(en.target)}})},{threshold:.3});ob.observe(rv)}\nconst ch=[...root.querySelectorAll(\".chap\")];const co=new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting)en.target.classList.add(\"visible\");const r=en.intersectionRatio;en.target.classList.toggle(\"blurring\",r<.3&&r>0)})},{threshold:[0,.15,.3,.5,.8,1]});ch.forEach(c=>co.observe(c));\nconst qt=root.querySelector(\".qt\");function toggleFloating(){if(!ch.length)return;const first=ch[0].getBoundingClientRect(),last=ch[ch.length-1].getBoundingClientRect(),trigger=innerHeight*.5,show=first.top<=trigger&&last.bottom>=trigger;if(qt)qt.classList.toggle(\"visible\",show)}\nfunction updateProgress(){if(!ch.length)return;const trigger=innerHeight*.5;let active=0,close=999999;ch.forEach((sec,i)=>{const r=sec.getBoundingClientRect(),center=r.top+r.height/2,dist=Math.abs(center-trigger);if(dist<close){close=dist;active=i}let p=(trigger-r.top)/r.height;p=Math.max(0,Math.min(1,p));const thread=sec.querySelector(\".thread\");const h=thread?thread.offsetHeight:r.height;sec.style.setProperty(\"--line-progress\",p.toFixed(4));sec.style.setProperty(\"--dot-progress\",p.toFixed(4));sec.style.setProperty(\"--dot-y\",(p*h).toFixed(2)+\"px\");sec.classList.toggle(\"passed\",p>=.98)});ch.forEach((sec,i)=>sec.classList.toggle(\"active\",i===active));toggleFloating()}\nlet tick=false;function onScroll(){if(tick)return;tick=true;requestAnimationFrame(()=>{updateProgress();tick=false})}\naddEventListener(\"scroll\",onScroll,{passive:true});addEventListener(\"resize\",updateProgress);updateProgress();\nconst q=root.querySelector(\".quiz\"),steps=[...root.querySelectorAll(\".step\")],res=root.querySelector(\".res\");function show(n){steps.forEach(s=>s.classList.toggle(\"on\",s.dataset.step==n))}function reset(){show(1)}function open(){q.classList.add(\"on\");document.body.style.overflow=\"hidden\";reset()}function close(){q.classList.remove(\"on\");document.body.style.overflow=\"\"}\nroot.querySelector(\"[data-open]\")?.addEventListener(\"click\",open);root.querySelector(\"[data-close]\")?.addEventListener(\"click\",close);q?.addEventListener(\"click\",e=>{if(e.target===q)close()});\nconst data={venom:[\"Nitrix 70 Venom\",\"Attack\",\"#22c55e\",\"34,197,94\",\"For aggressive players who want heavier smashes and stronger follow-through.\",\"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=900\",\"https://in.hndrd.co/products/nitrix-70-venom\"],volta:[\"Nitrix 70 Volta\",\"Power\",\"#3b82f6\",\"59,130,246\",\"For players who want fast swing speed, crisp impact and clean attacking power.\",\"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=900\",\"https://in.hndrd.co/products/nitrix-70-volta\"],hyfonic:[\"Hyfonic 7\",\"Precision\",\"#a855f7\",\"168,85,247\",\"For players who want stable control, sharp placement and composed feedback.\",\"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=900\",\"https://in.hndrd.co/products/hyfonic-7-4u\"],flareon:[\"Flareon 700\",\"Speed\",\"#ef4444\",\"239,68,68\",\"For players who win through reactions, fast hands and quick exchanges.\",\"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941\",\"https://in.hndrd.co/products/flareon-700-3u\"]};\nroot.querySelectorAll(\"[data-res]\").forEach(button=>{button.addEventListener(\"click\",()=>{const r=data[button.dataset.res]||data.venom;show(\"result\");res.innerHTML=`<img src=\"${r[5]}\" alt=\"${r[0]}\"><p style=\"color:${r[2]}\">${r[1]} Series</p><h3>${r[0]}</h3><span class=\"rdesc\">${r[4]}</span><a href=\"${r[6]}\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:${r[2]};--sr:${r[3]}\"><span class=\"bgb\"></span><span class=\"bgt\"></span><span class=\"inn\">Shop Now <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></span></a>`})});\ndocument.addEventListener(\"keydown\",e=>{if(e.key===\"Escape\")close()});\n})();\n</script>\n<style>\n  /* HERO SUBHEADING SIZE FIX */\n  #hnps-{{ sid }} .sub {\n    font-size: clamp(16px, 1.28vw, 18px) !important;\n    line-height: 1.45 !important;\n    font-weight: 600 !important;\n    letter-spacing: -0.02em !important;\n    color: rgba(255, 255, 255, 0.64) !important;\n    max-width: 620px !important;\n    margin: 0 !important;\n  }\n\n  @media screen and (max-width: 640px) {\n    #hnps-{{ sid }} .sub {\n      font-size: 14.5px !important;\n      line-height: 1.42 !important;\n      max-width: 320px !important;\n    }\n  }\n</style>\n<style>\n  /* DARK SOLID ROTATING WORD COLORS — NO GLOW */\n  #hnps-{{ sid }} .rot {\n    --hn-word-dark: #22c55e;\n  }\n\n  #hnps-{{ sid }} .rch {\n    color: var(--hn-word-dark) !important;\n    -webkit-text-fill-color: var(--hn-word-dark) !important;\n    background: none !important;\n    background-image: none !important;\n    text-shadow: none !important;\n    filter: none !important;\n  }\n</style>\n\n<script>\n(function () {\n  var root = document.getElementById(\"hnps-{{ sid }}\");\n  if (!root) return;\n\n  var rot = root.querySelector(\".rot\");\n  if (!rot) return;\n\n  function applyDarkColor() {\n    var sr = rot.querySelector(\".rsr\");\n    var word = sr ? sr.textContent.trim().toLowerCase() : \"\";\n\n    var color = \"#22c55e\";\n\n    if (word === \"attack\") color = \"#22c55e\";\n    if (word === \"power\") color = \"#3b82f6\";\n    if (word === \"precision\") color = \"#a855f7\";\n    if (word === \"speed\") color = \"#ef4444\";\n\n    rot.style.setProperty(\"--hn-word-dark\", color);\n  }\n\n  applyDarkColor();\n\n  var obs = new MutationObserver(applyDarkColor);\n  obs.observe(rot, {\n    childList: true,\n    subtree: true,\n    characterData: true\n  });\n})();\n</script>\n</section>",
