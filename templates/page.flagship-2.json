portant;\n  }\n\n  #hnps-{{ sid }} .qt button {\n    padding: 18px 8px !important;\n    font-size: 8.8px !important;\n    letter-spacing: 1.75px !important;\n  }\n\n  #hnps-{{ sid }} .inner,\n  #hnps-{{ sid }} .inner.rev {\n    padding-left: 34px !important;\n    padding-right: 56px !important;\n  }\n\n  #hnps-{{ sid }} .copy h2 {\n    font-size: 2.05rem !important;\n  }\n\n  #hnps-{{ sid }} .desc {\n    font-size: 13.5px !important;\n    line-height: 1.62 !important;\n  }\n}\n\n@media screen and (max-width: 380px) {\n  #hnps-{{ sid }} .inner,\n  #hnps-{{ sid }} .inner.rev {\n    padding-left: 32px !important;\n    padding-right: 52px !important;\n  }\n\n  #hnps-{{ sid }} .qt button {\n    padding: 17px 7px !important;\n    font-size: 8.2px !important;\n    letter-spacing: 1.6px !important;\n  }\n}\n  </style>\n\n  <section class=\"hero\">\n    <p class=\"kick\">HNDRD PRO SERIES</p>\n\n    <h1 class=\"title\">\n      <span class=\"tlx\">\n        Built For\n        <span class=\"rot\" data-rotate='[\"Attack\",\"Power\",\"Precision\",\"Speed\"]'>Attack</span>\n      </span>\n    </h1>\n\n    <p class=\"sub\">Four rackets. Four match styles. Find the frame that fits how you win.</p>\n\n    <a href=\"#v-{{ sid }}\" class=\"star cursor-target\" style=\"--sc:white;--sr:255,255,255\">\n      <span class=\"bgb\"></span>\n      <span class=\"bgt\"></span>\n      <span class=\"inn\">\n        Explore The Series\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M5 12h14\"/>\n          <path d=\"m12 5 7 7-7 7\"/>\n        </svg>\n      </span>\n    </a>\n  </section>\n\n  <section class=\"reveal\">\n    <p class=\"rtext\">Attack hard. Strike clean. Place sharp. Move first.|Pro Series gives every player a clear weapon.</p>\n  </section>\n\n  <div class=\"div\"></div>\n\n  <section id=\"v-{{ sid }}\" class=\"chap\" style=\"--ac:#22c55e;--rgb:34,197,94;--gl:rgba(34,197,94,.15)\">\n    <div class=\"bg\"></div>\n    <div class=\"blur\"></div>\n    <div class=\"thread\"><i></i></div>\n\n    <div class=\"inner\">\n      <div class=\"vis\">\n        <span class=\"orb\"></span>\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=900\" alt=\"Nitrix 70 Venom\">\n      </div>\n\n      <div class=\"copy\">\n        <p class=\"ser\">Attack Series</p>\n        <h2>Nitrix 70 Venom</h2>\n        <h3>Heavy Smashes. Clean Finish.</h3>\n\n        <p class=\"desc\">\n          Built for aggressive players who want heavier attacks, stronger follow-through and a sharper hit on contact.\n        </p>\n\n        <div class=\"spec\">\n          <div>\n            <b>6.1mm</b>\n            <span>Shaft Dia.</span>\n          </div>\n          <div>\n            <b>Hard</b>\n            <span>Flex</span>\n          </div>\n          <div>\n            <b>32 Lbs</b>\n            <span>Max Tension</span>\n          </div>\n        </div>\n\n        <a href=\"https://in.hndrd.co/products/nitrix-70-venom\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:#22c55e;--sr:34,197,94\">\n          <span class=\"bgb\"></span>\n          <span class=\"bgt\"></span>\n          <span class=\"inn\">\n            Enter Attack Mode\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"/>\n              <path d=\"m12 5 7 7-7 7\"/>\n            </svg>\n          </span>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"div\"></div>\n\n  <section class=\"chap\" style=\"--ac:#3b82f6;--rgb:59,130,246;--gl:rgba(59,130,246,.15)\">\n    <div class=\"bg\"></div>\n    <div class=\"blur\"></div>\n    <div class=\"thread\"><i></i></div>\n\n    <div class=\"inner rev\">\n      <div class=\"copy\">\n        <p class=\"ser\">Power Series</p>\n        <h2>Nitrix 70 Volta</h2>\n        <h3>Clean Power. Faster Swing.</h3>\n\n        <p class=\"desc\">\n          Made for players who want crisp energy transfer, fast air cuts and a confident attacking rhythm.\n        </p>\n\n        <div class=\"spec\">\n          <div>\n            <b>7.0mm</b>\n            <span>Shaft Dia.</span>\n          </div>\n          <div>\n            <b>Flexible</b>\n            <span>Flex</span>\n          </div>\n          <div>\n            <b>32 Lbs</b>\n            <span>Max Tension</span>\n          </div>\n        </div>\n\n        <a href=\"https://in.hndrd.co/products/nitrix-70-volta\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:#3b82f6;--sr:59,130,246\">\n          <span class=\"bgb\"></span>\n          <span class=\"bgt\"></span>\n          <span class=\"inn\">\n            Enter Power Mode\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"/>\n              <path d=\"m12 5 7 7-7 7\"/>\n            </svg>\n          </span>\n        </a>\n      </div>\n\n      <div class=\"vis\">\n        <span class=\"orb\"></span>\n        <img src=\"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=900\" alt=\"Nitrix 70 Volta\">\n      </div>\n    </div>\n  </section>\n\n  <div class=\"div\"></div>\n\n  <section class=\"chap\" style=\"--ac:#a855f7;--rgb:168,85,247;--gl:rgba(168,85,247,.15)\">\n    <div class=\"bg\"></div>\n    <div class=\"blur\"></div>\n    <div class=\"thread\"><i></i></div>\n\n    <div class=\"inner\">\n      <div class=\"vis\">\n        <span class=\"orb\"></span>\n        <img src=\"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=900\" alt=\"Hyfonic 7\">\n      </div>\n\n      <div class=\"copy\">\n        <p class=\"ser\">Precision Series</p>\n        <h2>Hyfonic 7</h2>\n        <h3>Control Every Inch.</h3>\n\n        <p class=\"desc\">\n          Built for sharp placement, composed feedback and steady control through quick changes in the rally.\n        </p>\n\n        <div class=\"spec\">\n          <div>\n            <b>7.0mm</b>\n            <span>Shaft Dia.</span>\n          </div>\n          <div>\n            <b>Flexible</b>\n            <span>Flex</span>\n          </div>\n          <div>\n            <b>32 Lbs</b>\n            <span>Max Tension</span>\n          </div>\n        </div>\n\n        <a href=\"https://in.hndrd.co/products/hyfonic-7-4u\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:#a855f7;--sr:168,85,247\">\n          <span class=\"bgb\"></span>\n          <span class=\"bgt\"></span>\n          <span class=\"inn\">\n            Enter Precision Mode\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"/>\n              <path d=\"m12 5 7 7-7 7\"/>\n            </svg>\n          </span>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"div\"></div>\n\n  <section class=\"chap\" style=\"--ac:#ef4444;--rgb:239,68,68;--gl:rgba(239,68,68,.15)\">\n    <div class=\"bg\"></div>\n    <div class=\"blur\"></div>\n    <div class=\"thread\"><i></i></div>\n\n    <div class=\"inner rev\">\n      <div class=\"copy\">\n        <p class=\"ser\">Speed Series</p>\n        <h2>Flareon 700</h2>\n        <h3>Move First. Hit Faster.</h3>\n\n        <p class=\"desc\">\n          Designed for quick hands, sharp reactions and rapid-fire exchanges when the rally gets fast.\n        </p>\n\n        <div class=\"spec\">\n          <div>\n            <b>7.0mm</b>\n            <span>Shaft Dia.</span>\n          </div>\n          <div>\n            <b>Hard</b>\n            <span>Flex</span>\n          </div>\n          <div>\n            <b>32 Lbs</b>\n            <span>Max Tension</span>\n          </div>\n        </div>\n\n        <a href=\"https://in.hndrd.co/products/flareon-700-3u\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:#ef4444;--sr:239,68,68\">\n          <span class=\"bgb\"></span>\n          <span class=\"bgt\"></span>\n          <span class=\"inn\">\n            Enter Speed Mode\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"/>\n              <path d=\"m12 5 7 7-7 7\"/>\n            </svg>\n          </span>\n        </a>\n      </div>\n\n      <div class=\"vis\">\n        <span class=\"orb\"></span>\n        <img src=\"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941\" alt=\"Flareon 700\">\n      </div>\n    </div>\n  </section>\n\n  <div class=\"qt\">\n    <button type=\"button\" data-open>Find Your Racket</button>\n  </div>\n\n  <div class=\"quiz\">\n    <div class=\"modal\">\n      <button class=\"close\" type=\"button\" data-close>&times;</button>\n\n      <div class=\"step on\" data-step=\"1\">\n        <p class=\"qeyebrow\">Quick Match</p>\n        <h3>Choose your style.</h3>\n        <p class=\"qsub\">We’ll suggest your racket.</p>\n\n        <button type=\"button\" data-res=\"venom\" style=\"--q:rgba(34,197,94,.9)\">\n          <span>Attack</span>\n        </button>\n\n        <button type=\"button\" data-res=\"volta\" style=\"--q:rgba(59,130,246,.9)\">\n          <span>Power</span>\n        </button>\n\n        <button type=\"button\" data-res=\"hyfonic\" style=\"--q:rgba(168,85,247,.9)\">\n          <span>Precision</span>\n        </button>\n\n        <button type=\"button\" data-res=\"flareon\" style=\"--q:rgba(239,68,68,.9)\">\n          <span>Speed</span>\n        </button>\n      </div>\n\n      <div class=\"step\" data-step=\"result\">\n        <div class=\"res\"></div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      const root = document.getElementById(\"hnps-{{ sid }}\");\n      if (!root || root.dataset.r) return;\n      root.dataset.r = 1;\n\n      const rot = root.querySelector(\".rot\");\n\n      if (rot) {\n        if (root.__hnStyleRotTimer) clearInterval(root.__hnStyleRotTimer);\n\n        const words = [\n          {\n            text: \"Attack\",\n            a: \"#22c55e\",\n            b: \"#86efac\",\n            glowA: \"rgba(34,197,94,.34)\",\n            glowB: \"rgba(34,197,94,.18)\"\n          },\n          {\n            text: \"Power\",\n            a: \"#3b82f6\",\n            b: \"#60a5fa\",\n            glowA: \"rgba(59,130,246,.34)\",\n            glowB: \"rgba(59,130,246,.18)\"\n          },\n          {\n            text: \"Precision\",\n            a: \"#a855f7\",\n            b: \"#d946ef\",\n            glowA: \"rgba(168,85,247,.34)\",\n            glowB: \"rgba(217,70,239,.18)\"\n          },\n          {\n            text: \"Speed\",\n            a: \"#ef4444\",\n            b: \"#fb7185\",\n            glowA: \"rgba(239,68,68,.34)\",\n            glowB: \"rgba(239,68,68,.18)\"\n          }\n        ];\n\n        let index = 0;\n\n        function splitText(text) {\n          if (window.Intl && Intl.Segmenter) {\n            const segmenter = new Intl.Segmenter(\"en\", { granularity: \"grapheme\" });\n            return Array.from(segmenter.segment(text), x => x.segment);\n          }\n\n          return Array.from(text);\n        }\n\n        function applyWholeWordColor(wrapper) {\n          if (!wrapper) return;\n\n          const wrapperRect = wrapper.getBoundingClientRect();\n          const wrapperWidth = Math.max(1, wrapperRect.width);\n          const letters = Array.prototype.slice.call(wrapper.querySelectorAll(\".rch\"));\n\n          letters.forEach(letter => {\n            const letterRect = letter.getBoundingClientRect();\n            const x = letterRect.left - wrapperRect.left;\n\n            letter.style.setProperty(\"--word-w\", wrapperWidth + \"px\");\n            letter.style.setProperty(\"--word-x\", (-x) + \"px\");\n          });\n\n          wrapper.classList.add(\"is-ready\");\n        }\n\n        function draw(item) {\n          rot.innerHTML = \"\";\n\n          rot.style.setProperty(\"--word-a\", item.a);\n          rot.style.setProperty(\"--word-b\", item.b);\n          rot.style.setProperty(\"--word-glow-a\", item.glowA);\n          rot.style.setProperty(\"--word-glow-b\", item.glowB);\n\n          const sr = document.createElement(\"span\");\n          sr.className = \"rsr\";\n          sr.textContent = item.text;\n\n          const wrapper = document.createElement(\"span\");\n          wrapper.className = \"rw\";\n          wrapper.setAttribute(\"aria-hidden\", \"true\");\n\n          const chars = splitText(item.text);\n\n          chars.forEach((char, n) => {\n            const span = document.createElement(\"span\");\n            span.className = \"rch\";\n            span.textContent = char;\n            span.style.setProperty(\"--d\", ((chars.length - 1 - n) * 25) + \"ms\");\n            wrapper.appendChild(span);\n          });\n\n          rot.appendChild(sr);\n          rot.appendChild(wrapper);\n\n          requestAnimationFrame(() => {\n            requestAnimationFrame(() => {\n              applyWholeWordColor(wrapper);\n            });\n          });\n        }\n\n        draw(words[index]);\n\n        root.__hnStyleRotTimer = setInterval(() => {\n          index = (index + 1) % words.length;\n          draw(words[index]);\n        }, 2000);\n\n        window.addEventListener(\"resize\", () => {\n          const wrapper = rot.querySelector(\".rw\");\n          applyWholeWordColor(wrapper);\n        });\n      }\n\n      const rv = root.querySelector(\".rtext\");\n\n      if (rv) {\n        const raw = rv.textContent.trim();\n        const lines = raw.split(\"|\").map(line => line.trim()).filter(Boolean);\n\n        rv.innerHTML = lines.map(line => {\n          const words = line.split(/\\s+/).map(word => \"<span class='word'>\" + word + \"</span>\").join(\" \");\n          return \"<span class='line'>\" + words + \"</span>\";\n        }).join(\"\");\n\n        const words = [...rv.querySelectorAll(\".word\")];\n\n        const ob = new IntersectionObserver(entries => {\n          entries.forEach(entry => {\n            if (entry.isIntersecting) {\n              words.forEach((word, i) => {\n                setTimeout(() => word.classList.add(\"show\"), i * 55);\n              });\n              ob.unobserve(entry.target);\n            }\n          });\n        }, { threshold: .3 });\n\n        ob.observe(rv);\n      }\n\n      const ch = [...root.querySelectorAll(\".chap\")];\n\n      const co = new IntersectionObserver(entries => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) entry.target.classList.add(\"visible\");\n\n          const r = entry.intersectionRatio;\n          entry.target.classList.toggle(\"blurring\", r < .3 && r > 0);\n        });\n      }, { threshold: [0, .15, .3, .5, .8, 1] });\n\n      ch.forEach(c => co.observe(c));\n\n      const qt = root.querySelector(\".qt\");\n\n      function toggleFloating() {\n        if (!ch.length) return;\n\n        const first = ch[0].getBoundingClientRect();\n        const lastChap = ch[ch.length - 1].getBoundingClientRect();\n        const trigger = innerHeight * .5;\n        const show = first.top <= trigger && lastChap.bottom >= trigger;\n\n        if (qt) qt.classList.toggle(\"visible\", show);\n      }\n\n      function updateProgress() {\n        if (!ch.length) return;\n\n        const trigger = innerHeight * .5;\n        let active = 0;\n        let close = 999999;\n\n        ch.forEach((sec, i) => {\n          const r = sec.getBoundingClientRect();\n          const center = r.top + r.height / 2;\n          const dist = Math.abs(center - trigger);\n\n          if (dist < close) {\n            close = dist;\n            active = i;\n          }\n\n          let p = (trigger - r.top) / r.height;\n          p = Math.max(0, Math.min(1, p));\n\n          const thread = sec.querySelector(\".thread\");\n          const threadHeight = thread ? thread.offsetHeight : r.height;\n          const dotY = p * threadHeight;\n\n          sec.style.setProperty(\"--line-progress\", p.toFixed(4));\n          sec.style.setProperty(\"--dot-progress\", p.toFixed(4));\n          sec.style.setProperty(\"--dot-y\", dotY.toFixed(2) + \"px\");\n          sec.classList.toggle(\"passed\", p >= .98);\n        });\n\n        ch.forEach((sec, i) => sec.classList.toggle(\"active\", i === active));\n\n        toggleFloating();\n      }\n\n      let tick = false;\n\n      function onScroll() {\n        if (tick) return;\n\n        tick = true;\n\n        requestAnimationFrame(() => {\n          updateProgress();\n          tick = false;\n        });\n      }\n\n      addEventListener(\"scroll\", onScroll, { passive: true });\n      addEventListener(\"resize\", updateProgress);\n      updateProgress();\n\n      const q = root.querySelector(\".quiz\");\n      const steps = [...root.querySelectorAll(\".step\")];\n      const res = root.querySelector(\".res\");\n\n      function show(n) {\n        steps.forEach(s => s.classList.toggle(\"on\", s.dataset.step == n));\n      }\n\n      function reset() {\n        show(1);\n      }\n\n      function open() {\n        q.classList.add(\"on\");\n        document.body.style.overflow = \"hidden\";\n        reset();\n      }\n\n      function close() {\n        q.classList.remove(\"on\");\n        document.body.style.overflow = \"\";\n      }\n\n      root.querySelector(\"[data-open]\")?.addEventListener(\"click\", open);\n      root.querySelector(\"[data-close]\")?.addEventListener(\"click\", close);\n\n      q?.addEventListener(\"click\", e => {\n        if (e.target === q) close();\n      });\n\n      const data = {\n        venom: [\n          \"Nitrix 70 Venom\",\n          \"Attack\",\n          \"#22c55e\",\n          \"34,197,94\",\n          \"For aggressive players who want heavier smashes and stronger follow-through.\",\n          \"https://in.hndrd.co/cdn/shop/files/1_958d5bed-b55e-4cf4-9900-2052ba8b5bea.jpg?v=1752848941&width=900\",\n          \"https://in.hndrd.co/products/nitrix-70-venom\"\n        ],\n        volta: [\n          \"Nitrix 70 Volta\",\n          \"Power\",\n          \"#3b82f6\",\n          \"59,130,246\",\n          \"For players who want fast swing speed, crisp impact and clean attacking power.\",\n          \"https://in.hndrd.co/cdn/shop/files/2_ab549237-062a-4026-8105-a47ab014588a.jpg?v=1752848941&width=900\",\n          \"https://in.hndrd.co/products/nitrix-70-volta\"\n        ],\n        hyfonic: [\n          \"Hyfonic 7\",\n          \"Precision\",\n          \"#a855f7\",\n          \"168,85,247\",\n          \"For players who want stable control, sharp placement and composed feedback.\",\n          \"https://in.hndrd.co/cdn/shop/files/3_e578f9d6-1504-49c4-bc96-0e25abc4ac49.jpg?v=1752848941&width=900\",\n          \"https://in.hndrd.co/products/hyfonic-7-4u\"\n        ],\n        flareon: [\n          \"Flareon 700\",\n          \"Speed\",\n          \"#ef4444\",\n          \"239,68,68\",\n          \"For players who win through reactions, fast hands and quick exchanges.\",\n          \"https://in.hndrd.co/cdn/shop/files/4_b0b1f2b3-af1c-4c20-ad1f-db083c6f53f5.jpg?v=1752848941\",\n          \"https://in.hndrd.co/products/flareon-700-3u\"\n        ]\n      };\n\n      root.querySelectorAll(\"[data-res]\").forEach(button => {\n        button.addEventListener(\"click\", () => {\n          const r = data[button.dataset.res] || data.venom;\n\n          show(\"result\");\n\n          res.innerHTML =\n            `<img src=\"${r[5]}\" alt=\"${r[0]}\">\n            <p style=\"color:${r[2]}\">${r[1]} Series</p>\n            <h3>${r[0]}</h3>\n            <span class=\"rdesc\">${r[4]}</span>\n            <a href=\"${r[6]}\" target=\"_blank\" class=\"star cursor-target\" style=\"--sc:${r[2]};--sr:${r[3]}\">\n              <span class=\"bgb\"></span>\n              <span class=\"bgt\"></span>\n              <span class=\"inn\">\n                Shop Now\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M5 12h14\"/>\n                  <path d=\"m12 5 7 7-7 7\"/>\n                </svg>\n              </span>\n            </a>`;\n        });\n      });\n\n      document.addEventListener(\"keydown\", e => {\n        if (e.key === \"Escape\") close();\n      });\n    })();\n  </script>\n</section>",
