      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign sid = section.id | default: 'pro-lineup' %}\n<section id=\"hnps-{{ sid }}\" class=\"hnps\">\n<style>\n#hnps-{{sid}},#hnps-{{sid}} *,#hnps-{{sid}}:before,#hnps-{{sid}} *:before,#hnps-{{sid}} *:after{box-sizing:border-box}\n#hnps-{{sid}}{--bg:#050505;--panel:#0b0b0b;--muted:rgba(255,255,255,.58);--line:rgba(255,255,255,.09);--hero-cta-ac:#22c55e;font-family:var(--font-body-family,Inter,Arial,sans-serif);display:block;flex:0 0 100%;width:100%;min-width:0;max-width:100%;margin:0;background:var(--bg);color:#fff;overflow:visible;position:relative;z-index:0;-webkit-font-smoothing:antialiased}\n#hnps-{{sid}} a{color:inherit;text-decoration:none}\n#hnps-{{sid}} button{font:inherit}\n#hnps-{{sid}} a,#hnps-{{sid}} button{cursor:pointer;-webkit-tap-highlight-color:transparent}\n#hnps-{{sid}} a[href],#hnps-{{sid}} button,#hnps-{{sid}} [data-jump],#hnps-{{sid}} [data-compare-jump],#hnps-{{sid}} [data-open],#hnps-{{sid}} [data-close],#hnps-{{sid}} [data-res]{cursor:pointer!important;touch-action:manipulation;-webkit-user-select:none;user-select:none}\n#hnps-{{sid}} a[href] *,#hnps-{{sid}} button *,#hnps-{{sid}} [data-jump] *,#hnps-{{sid}} [data-compare-jump] *,#hnps-{{sid}} [data-open] *,#hnps-{{sid}} [data-close] *,#hnps-{{sid}} [data-res] *{cursor:pointer!important}\n#hnps-{{sid}} a:focus-visible,#hnps-{{sid}} button:focus-visible{outline:2px solid rgba(255,255,255,.9);outline-offset:3px}\n#hnps-{{sid}} svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n#hnps-{{sid}} .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n#hnps-{{sid}}>.hero,#hnps-{{sid}}>.intro,#hnps-{{sid}}>.mobile-tabs-wrap,#hnps-{{sid}}>.chap{display:block;width:100%;min-width:0;max-width:100%}\n#hnps-{{sid}} img{max-width:100%}\n#hnps-{{sid}} .inner,#hnps-{{sid}} .copy,#hnps-{{sid}} .vis,#hnps-{{sid}} .compare-wrap,#hnps-{{sid}} .hero-copy{min-width:0;max-width:100%}\n\n\n/* MOBILE-FIRST HERO */\n#hnps-{{sid}} .hero{position:relative;z-index:1;width:100%;min-width:0;padding:42px 14px 30px;text-align:center;background:#000;overflow:hidden;isolation:isolate}\n#hnps-{{sid}} .hero:before{content:\"\";position:absolute;inset:0;pointer-events:none;opacity:.05;background-image:radial-gradient(circle at 50% 16%,rgba(255,255,255,.1),transparent 38%),repeating-linear-gradient(90deg,transparent 0 8px,rgba(255,255,255,.025) 8px 9px)}\n#hnps-{{sid}} .hero-copy{position:relative;z-index:2;max-width:420px;margin:0 auto}\n#hnps-{{sid}} .kick{margin:0 0 14px;font-size:9px;font-weight:900;letter-spacing:.34em;text-transform:uppercase;color:rgba(255,255,255,.38)}\n#hnps-{{sid}} .title{display:flex;align-items:baseline;justify-content:center;gap:.12em;width:100%;margin:0;font-size:clamp(29px,8.8vw,46px);font-weight:950;line-height:.92;letter-spacing:-.068em;white-space:nowrap}\n#hnps-{{sid}} .title-static,#hnps-{{sid}} .rot{display:inline-flex;align-items:baseline;flex:none}\n#hnps-{{sid}} .title-static{color:#fff}\n#hnps-{{sid}} .rot{min-width:0;min-height:.92em;margin:0;--word:#22c55e}\n#hnps-{{sid}} .rsr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}\n#hnps-{{sid}} .rw{display:inline-flex;white-space:nowrap;overflow:hidden;vertical-align:bottom}\n#hnps-{{sid}} .rch{display:inline-block;color:var(--word)!important;-webkit-text-fill-color:var(--word)!important;opacity:0;transform:translateY(105%) rotate(5deg);animation:hnpsWord-{{sid}} .62s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d);animation-play-state:paused}\n#hnps-{{sid}} .rw.is-ready .rch{animation-play-state:running}\n@keyframes hnpsWord-{{sid}}{to{opacity:1;transform:translateY(0) rotate(0)}}\n#hnps-{{sid}} .sub{max-width:330px;margin:16px auto 0;font-size:13px;font-weight:550;line-height:1.5;letter-spacing:-.012em;color:rgba(255,255,255,.61)}\n#hnps-{{sid}} .hero-actions{display:grid;gap:9