      "settings": {
        "custom_liquid": "<style>\n  .story-container {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px; padding: 20px;\n  }\n  .story-card {\n    aspect-ratio: 1; width: 100%;\n    position: relative; overflow: hidden;\n    border-radius: 16px; cursor: pointer;\n  }\n  .story-card img, .story-img {\n    width: 100%; height: 100%;\n    object-fit: cover; display: block;\n  }\n  @media (max-width: 768px) {\n    .story-container {\n      display: flex; overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n    }\n    .story-card {\n      flex: 0 0 80%;\n      scroll-snap-align: center;\n    }\n  }\n  .story-modal {\n    position: fixed; inset: 0;\n    width: 100vw; height: 100vh;\n    background: rgba(0,0,0,0.95);\n    display: none; flex-direction: column;\n    align-items: center; justify-content: center;\n    z-index: 9999;\n  }\n  .story-content {\n    position: relative;\n    max-width: 90%; width: 400px; height: 70vh;\n    background: #000; border-radius: 20px;\n    overflow: hidden; display: flex;\n    align-items: center; justify-content: center;\n  }\n  .story-content.paused img {\n    opacity: 0.6;\n    transition: opacity 0.2s;\n  }\n  .story-progress-container {\n    display: flex; gap: 5px;\n    width: 90%; max-width: 400px;\n    margin: 20px auto 10px;\n  }\n  .story-progress-bar {\n    flex: 1; height: 4px;\n    background: rgba(255,255,255,0.2);\n    border-radius: 2px; overflow: hidden;\n    position: relative;\n  }\n  .progress-fill {\n    position: absolute; top: 0; left: 0;\n    height: 100%; width: 0%;\n    background: #4ecdc4;\n  }\n  .story-close {\n    position: absolute; top: 10px; right: 10px;\n    background: rgba(255,255,255,0.1);\n    color: white; font-size: 24px;\n    border: none; border-radius: 50%;\n    width: 40px; height: 40px;\n    cursor: pointer; z-index: 10;\n  }\n  .story-error {\n    color: white; font-size: 16px;\n    padding: 20px; text-align: center;\n    display: none;\n  }\n  .tap-zone {\n    position: absolute;\n    top: 0; bottom: 0;\n    width: 50%;\n    z-index: 2;\n    pointer-events: auto !important;\n  }\n  .tap-left { left: 0; }\n  .tap-right { right: 0; }\n</style>\n\n<div class=\"story-container\">\n  {% assign card_images = \n    \"2_69ae8d96-d7ac-48c3-9755-bc783097df68.png,1_97ad914f-3b4d-4aa0-9774-a65125900844.png,3_f34e7773-4fa3-465b-8493-1a2c81a6ed75.png,4.png\"\n    | split: \",\" %}\n  {% for img in card_images %}\n  <div class=\"story-card\" onclick=\"openStory({{ forloop.index0 }})\" role=\"button\" aria-label=\"Open story {{ forloop.index }}\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/{{ img }}?v=1752212834\" alt=\"Story {{ forloop.index }}\">\n  </div>\n  {% endfor %}\n</div>\n\n<div id=\"storyModal\" class=\"story-modal\">\n  <div class=\"story-progress-container\" id=\"progressContainer\"></div>\n  <div class=\"story-content\" id=\"storyContent\">\n    <div class=\"story-error\" id=\"storyError\">Image failed to load</div>\n  </div>\n  <button class=\"story-close\" onclick=\"closeStory()\">×</button>\n</div>\n\n<script>\n(function waitForDOM() {\n  if (document.readyState !== 'complete') {\n    return setTimeout(waitForDOM, 50);\n  }\n\n  console.log(\"✅ Story script loaded\");\n\n  const storyData = [\n    [\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/1_b3e909ef-dd98-46db-ad67-7499570c1524.png?v=1752213198\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/2_25fa1ae4-98d4-4023-b4b3-4d38ef13efef.png?v=1752213198\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/4_1bbdc1ac-4f98-4378-92a5-fa820d0550fb.png?v=1752213198\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/3_7350ae88-5bb9-491d-b9a7-1dc5f41035eb.png?v=1752213197\" }\n    ],\n    [\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/3_a7ce3c25-bdc8-4ed5-955b-358f192779e7.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/1_458be614-351d-47e7-941d-2530563f8a94.png?v=1752213752\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/2_816cfea0-e878-41bc-ae52-df0e2185dcf6.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/4_ff08ecb2-c532-4c7f-b51a-8d9e7e761af3.png?v=1752213751\" }\n    ],\n    [\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/7.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/8.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/5.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/6.png?v=1752213751\" }\n    ],\n    [\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/11.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/10.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/9.png?v=1752213751\" },\n      { image: \"https://cdn.shopify.com/s/files/1/0580/4880/6984/files/12.png?v=1752213751\" }\n    ]\n  ];\n\n  let currentStory = 0, currentSlide = 0;\n  const modal = document.getElementById('storyModal'),\n        content = document.getElementById('storyContent'),\n        error = document.getElementById('storyError'),\n        progress = document.getElementById('progressContainer');\n\n  let animationFrameId, isPaused = false, pauseStart = 0, pauseAccum = 0, holdTimeout;\n\n  window.openStory = function(i) {\n    [currentStory, currentSlide] = [i, 0];\n    modal.style.display = 'flex';\n    renderProgress();\n    showSlide();\n  }\n\n  window.closeStory = function() {\n    cancelAnimationFrame(animationFrameId);\n    modal.style.display = 'none';\n    content.innerHTML = error.outerHTML;\n    removeTapZones();\n  }\n\n  function renderProgress() {\n    progress.innerHTML = storyData[currentStory].map((_, i) =>\n      `<div class=\"story-progress-bar\"><div class=\"progress-fill\" id=\"progress-${i}\"></div></div>`\n    ).join('');\n  }\n\n  function updateProgress() {\n    document.querySelectorAll('.progress-fill').forEach((el, i) => {\n      el.style.width = i < currentSlide ? '100%' : '0%';\n    });\n  }\n\n  function showSlide() {\n    cancelAnimationFrame(animationFrameId);\n    const slide = storyData[currentStory][currentSlide];\n    content.innerHTML = error.outerHTML;\n    updateProgress();\n\n    const el = document.createElement('img');\n    el.className = 'story-img';\n    el.src = slide.image;\n    el.onload = () => {\n      content.innerHTML = '';\n      content.appendChild(el);\n      addTapZones();\n      startProgress(8000);\n    };\n    el.onerror = () => error.style.display = 'block';\n  }\n\n  function startProgress(duration) {\n    const fill = document.getElementById(`progress-${currentSlide}`);\n    let startTime;\n    pauseAccum = 0;\n\n    function animate(timestamp) {\n      if (!startTime) startTime = timestamp;\n\n      if (isPaused) {\n        if (!pauseStart) pauseStart = timestamp;\n        content.classList.add('paused');\n        animationFrameId = requestAnimationFrame(animate);\n        return;\n      }\n\n      content.classList.remove('paused');\n\n      if (pauseStart) {\n        pauseAccum += timestamp - pauseStart;\n        pauseStart = 0;\n      }\n\n      let progressTime = timestamp - startTime - pauseAccum;\n      let percent = Math.min((progressTime / duration) * 100, 100);\n      fill.style.width = percent + \"%\";\n\n      document.querySelectorAll('.progress-fill').forEach((bar, i) => {\n        if (i < currentSlide) bar.style.width = \"100%\";\n      });\n\n      if (percent < 100) {\n        animationFrameId = requestAnimationFrame(animate);\n      } else {\n        nextSlide();\n      }\n    }\n\n    requestAnimationFrame(animate);\n  }\n\n  function nextSlide() {\n    currentSlide++;\n    currentSlide < storyData[currentStory].length ? showSlide() : closeStory();\n  }\n\n  function prevSlide() {\n    if (currentSlide > 0) {\n      currentSlide--;\n      showSlide();\n    } else {\n      closeStory();\n    }\n  }\n\n  function addTapZones() {\n    removeTapZones();\n    const left = document.createElement('div');\n    const right = document.createElement('div');\n    left.className = 'tap-zone tap-left';\n    right.className = 'tap-zone tap-right';\n\n    function handlePointerDown() {\n      holdTimeout = setTimeout(() => {\n        isPaused = true;\n      }, 200);\n    }\n\n    function handlePointerUp(callback) {\n      return function () {\n        clearTimeout(holdTimeout);\n        if (!isPaused) callback();\n        isPaused = false;\n      }\n    }\n\n    left.addEventListener('pointerdown', handlePointerDown);\n    right.addEventListener('pointerdown', handlePointerDown);\n    left.addEventListener('pointerup', handlePointerUp(prevSlide));\n    right.addEventListener('pointerup', handlePointerUp(nextSlide));\n\n    content.appendChild(left);\n    content.appendChild(right);\n  }\n\n  function removeTapZones() {\n    content.querySelectorAll('.tap-zone').forEach(el => el.remove());\n  }\n})();\n</script>",
