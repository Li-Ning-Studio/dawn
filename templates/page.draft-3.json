        "custom_liquid": "<section class=\"hnk-hub\" aria-labelledby=\"hnk-hub-title\">\n  <div class=\"hnk-hub__ambient\"></div>\n\n  <div class=\"hnk-hub__inner\">\n\n    <!-- HERO -->\n    <header class=\"hnk-hub__intro\">\n      <div class=\"hnk-hub__eyebrow\">\n        \n      </div>\n\n      <h2 id=\"hnk-hub-title\" class=\"hnk-hub__title\">\n        Kerala,<br>\n        <span>it's your move.</span>\n      </h2>\n\n      <p class=\"hnk-hub__description\">\n        Three HNDRD experiences. One place to start.\n      </p>\n    </header>\n\n    <!-- EVENT LINKS -->\n    <div class=\"hnk-hub__list\">\n\n      <div class=\"hnk-hub__list-head\">\n        <span>CHOOSE YOUR EXPERIENCE</span>\n        \n      </div>\n\n      <nav class=\"hnk-hub__links\" aria-label=\"HNDRD events in Kerala\">\n\n        <!-- EXPERIENCE TOUR -->\n        <a class=\"hnk-hub__link\"\n           href=\"https://in.hndrd.co/pages/kerala-exp-tour\">\n\n          <span class=\"hnk-hub__number\"></span>\n\n          <span class=\"hnk-hub__content\">\n            <span class=\"hnk-hub__category\">DISCOVER</span>\n            <strong class=\"hnk-hub__name\">Experience Tour</strong>\n            <span class=\"hnk-hub__detail\">\n              Get hands-on with the gear.\n            </span>\n          </span>\n\n          <span class=\"hnk-hub__action\" aria-hidden=\"true\">\n            <span class=\"hnk-hub__action-label\">EXPLORE</span>\n            <span class=\"hnk-hub__arrow\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"\n                   stroke=\"currentColor\" stroke-width=\"1.6\"\n                   stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n              </svg>\n            </span>\n          </span>\n        </a>\n\n        <!-- STREAKS -->\n        <a class=\"hnk-hub__link\"\n           href=\"https://in.hndrd.co/pages/hndrd-streaks\">\n\n          <span class=\"hnk-hub__number\"></span>\n\n          <span class=\"hnk-hub__content\">\n            <span class=\"hnk-hub__category\">COMPETE</span>\n            <strong class=\"hnk-hub__name\">Streaks</strong>\n            <span class=\"hnk-hub__detail\">\n              Bring your game to the court.\n            </span>\n          </span>\n\n          <span class=\"hnk-hub__action\" aria-hidden=\"true\">\n            <span class=\"hnk-hub__action-label\">EXPLORE</span>\n            <span class=\"hnk-hub__arrow\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"\n                   stroke=\"currentColor\" stroke-width=\"1.6\"\n                   stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n              </svg>\n            </span>\n          </span>\n        </a>\n\n        <!-- SHUTTLEVERSE -->\n        <a class=\"hnk-hub__link\"\n           href=\"https://in.hndrd.co/pages/shuttleverse\">\n\n          <span class=\"hnk-hub__number\"></span>\n\n          <span class=\"hnk-hub__content\">\n            <span class=\"hnk-hub__category\">CONNECT</span>\n            <strong class=\"hnk-hub__name\">Shuttleverse</strong>\n            <span class=\"hnk-hub__detail\">\n              Find your people. Play your way.\n            </span>\n          </span>\n\n          <span class=\"hnk-hub__action\" aria-hidden=\"true\">\n            <span class=\"hnk-hub__action-label\">EXPLORE</span>\n            <span class=\"hnk-hub__arrow\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"\n                   stroke=\"currentColor\" stroke-width=\"1.6\"\n                   stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n              </svg>\n            </span>\n          </span>\n        </a>\n\n      </nav>\n    </div>\n\n    <!-- FOOTER -->\n    <footer class=\"hnk-hub__footer\">\n      <span class=\"hnk-hub__footer-line\"></span>\n      <span>LIVE HUNDRED PERCENT.</span>\n      <span class=\"hnk-hub__footer-line\"></span>\n    </footer>\n\n  </div>\n</section>\n\n<style>\n/* =========================================\n   HNDRD KERALA EXPERIENCE HUB\n   ========================================= */\n\n.hnk-hub {\n  --hnk-white: #f5f5f7;\n  --hnk-muted: #929298;\n  --hnk-orange: #ffa300;\n\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  width: 100%;\n  padding: clamp(76px, 9vw, 124px) 20px 65px;\n  background: #050505;\n  color: var(--hnk-white);\n  font-family: var(--font-body-family, inherit);\n}\n\n.hnk-hub *,\n.hnk-hub *::before,\n.hnk-hub *::after {\n  box-sizing: border-box;\n}\n\n/* AMBIENT LIGHT */\n\n.hnk-hub__ambient {\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(\n      ellipse 65% 40% at 50% 0%,\n      rgba(255,255,255,.075),\n      transparent 75%\n    ),\n    radial-gradient(\n      ellipse 50% 45% at 100% 85%,\n      rgba(255,163,0,.055),\n      transparent 75%\n    );\n}\n\n/* MAIN WIDTH */\n\n.hnk-hub__inner {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 880px;\n  margin: 0 auto;\n}\n\n/* =========================================\n   HERO\n   ========================================= */\n\n.hnk-hub__intro {\n  text-align: center;\n  animation: hnkHeroIn .9s cubic-bezier(.2,.7,.2,1) both;\n}\n\n.hnk-hub__eyebrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  margin-bottom: 30px;\n  color: #a5a5aa;\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 1.4;\n  letter-spacing: .19em;\n}\n\n.hnk-hub__dot {\n  width: 6px;\n  height: 6px;\n  flex: none;\n  border-radius: 50%;\n  background: var(--hnk-orange);\n  box-shadow: 0 0 12px rgba(255,163,0,.45);\n}\n\n.hnk-hub__title {\n  margin: 0;\n  color: #f5f5f7;\n  font-family: var(--font-heading-family, inherit);\n  font-size: clamp(52px, 7.8vw, 84px);\n  font-weight: 600;\n  line-height: .99;\n  letter-spacing: -.065em;\n  text-transform: none;\n}\n\n.hnk-hub__title span {\n  display: inline-block;\n  color: #85858b;\n}\n\n.hnk-hub__description {\n  margin: 23px auto 0;\n  color: #99999f;\n  font-size: 15px;\n  font-weight: 400;\n  line-height: 1.65;\n  letter-spacing: -.015em;\n}\n\n/* =========================================\n   EVENT LIST\n   ========================================= */\n\n.hnk-hub__list {\n  margin-top: clamp(54px, 6vw, 76px);\n}\n\n.hnk-hub__list-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 15px;\n  padding: 0 4px;\n  color: #77777d;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .15em;\n}\n\n.hnk-hub__links {\n  display: grid;\n  gap: 12px;\n}\n\n/* =========================================\n   GLASS CARDS\n   ========================================= */\n\n.hnk-hub__link {\n  position: relative;\n  overflow: hidden;\n\n  display: grid;\n  grid-template-columns: 42px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 21px;\n\n  min-height: 132px;\n  padding: 25px 28px;\n\n  border: 1px solid rgba(255,255,255,.105);\n  border-radius: 20px;\n\n  background:\n    linear-gradient(\n      115deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025) 65%,\n      rgba(255,255,255,.035)\n    );\n\n  -webkit-backdrop-filter: blur(22px) saturate(120%);\n  backdrop-filter: blur(22px) saturate(120%);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.10),\n    0 12px 35px rgba(0,0,0,.18);\n\n  color: #f5f5f7;\n  text-decoration: none;\n\n  opacity: 0;\n  animation: hnkCardIn .8s cubic-bezier(.2,.7,.2,1) forwards;\n\n  transition:\n    transform .45s cubic-bezier(.2,.7,.2,1),\n    border-color .35s ease,\n    background .35s ease,\n    box-shadow .35s ease;\n}\n\n.hnk-hub__link:nth-child(1) {\n  animation-delay: .15s;\n}\n\n.hnk-hub__link:nth-child(2) {\n  animation-delay: .28s;\n}\n\n.hnk-hub__link:nth-child(3) {\n  animation-delay: .41s;\n}\n\n/* SUBTLE LIGHT SWEEP */\n\n.hnk-hub__link::before {\n  content: \"\";\n  position: absolute;\n  z-index: 0;\n  top: 0;\n  left: -120%;\n  width: 75%;\n  height: 100%;\n\n  background: linear-gradient(\n    105deg,\n    transparent,\n    rgba(255,255,255,.055),\n    transparent\n  );\n\n  transform: skewX(-15deg);\n  pointer-events: none;\n  transition: left .8s cubic-bezier(.2,.7,.2,1);\n}\n\n.hnk-hub__link::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 28px;\n  right: 28px;\n  height: 1px;\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(255,255,255,.23),\n    transparent\n  );\n  opacity: .5;\n  pointer-events: none;\n}\n\n.hnk-hub__link:hover {\n  transform: translateY(-4px);\n  border-color: rgba(255,255,255,.24);\n\n  background: linear-gradient(\n    115deg,\n    rgba(255,255,255,.115),\n    rgba(255,255,255,.045) 65%,\n    rgba(255,255,255,.055)\n  );\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.16),\n    0 22px 55px rgba(0,0,0,.32);\n}\n\n.hnk-hub__link:hover::before {\n  left: 140%;\n}\n\n.hnk-hub__link:focus-visible {\n  outline: 2px solid var(--hnk-orange);\n  outline-offset: 4px;\n}\n\n/* =========================================\n   CARD CONTENT\n   ========================================= */\n\n.hnk-hub__number,\n.hnk-hub__content,\n.hnk-hub__action {\n  position: relative;\n  z-index: 1;\n}\n\n.hnk-hub__number {\n  align-self: start;\n  padding-top: 4px;\n  color: #77777e;\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: .04em;\n  font-variant-numeric: tabular-nums;\n}\n\n.hnk-hub__content {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  min-width: 0;\n}\n\n.hnk-hub__category {\n  margin-bottom: 7px;\n  color: #9b9ba1;\n  font-size: 9px;\n  font-weight: 650;\n  line-height: 1.3;\n  letter-spacing: .17em;\n}\n\n.hnk-hub__name {\n  color: #f5f5f7;\n  font-family: var(--font-heading-family, inherit);\n  font-size: clamp(23px, 2.7vw, 29px);\n  font-weight: 600;\n  line-height: 1.12;\n  letter-spacing: -.04em;\n}\n\n.hnk-hub__detail {\n  margin-top: 8px;\n  color: #919198;\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 1.5;\n  letter-spacing: -.005em;\n}\n\n/* =========================================\n   PREMIUM CTA\n   ========================================= */\n\n.hnk-hub__action {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 13px;\n  flex: none;\n}\n\n.hnk-hub__action-label {\n  color: #a7a7ad;\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: .14em;\n  transition: color .3s ease;\n}\n\n/* CIRCULAR ARROW */\n\n.hnk-hub__arrow {\n  display: grid;\n  place-items: center;\n\n  width: 43px;\n  height: 43px;\n\n  border: 1px solid rgba(255,255,255,.19);\n  border-radius: 50%;\n\n  background: rgba(255,255,255,.045);\n\n  color: #f5f5f7;\n\n  transition:\n    background .35s ease,\n    color .35s ease,\n    border-color .35s ease,\n    transform .4s cubic-bezier(.2,.7,.2,1),\n    box-shadow .35s ease;\n}\n\n.hnk-hub__arrow svg {\n  width: 18px;\n  height: 18px;\n  transition: transform .35s cubic-bezier(.2,.7,.2,1);\n}\n\n.hnk-hub__link:hover .hnk-hub__action-label {\n  color: #fff;\n}\n\n.hnk-hub__link:hover .hnk-hub__arrow {\n  background: #f5f5f7;\n  color: #080808;\n  border-color: #f5f5f7;\n  transform: scale(1.06);\n  box-shadow: 0 3px 18px rgba(255,255,255,.12);\n}\n\n.hnk-hub__link:hover .hnk-hub__arrow svg {\n  transform: translateX(2px);\n}\n\n/* =========================================\n   FOOTER\n   ========================================= */\n\n.hnk-hub__footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 17px;\n  margin-top: 48px;\n\n  color: #707077;\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: .18em;\n}\n\n.hnk-hub__footer-line {\n  width: 35px;\n  height: 1px;\n  background: rgba(255,255,255,.13);\n}\n\n/* =========================================\n   ANIMATIONS\n   ========================================= */\n\n@keyframes hnkHeroIn {\n  from {\n    opacity: 0;\n    transform: translateY(22px);\n    filter: blur(5px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n    filter: blur(0);\n  }\n}\n\n@keyframes hnkCardIn {\n  from {\n    opacity: 0;\n    transform: translateY(22px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* =========================================\n   MOBILE\n   ========================================= */\n\n@media screen and (max-width: 749px) {\n\n  .hnk-hub {\n    padding: 72px 16px 55px;\n  }\n\n  .hnk-hub__eyebrow {\n    margin-bottom: 25px;\n    font-size: 9px;\n  }\n\n  .hnk-hub__title {\n    font-size: clamp(45px, 11.5vw, 63px);\n    letter-spacing: -.06em;\n  }\n\n  .hnk-hub__description {\n    max-width: 290px;\n    margin-top: 18px;\n    font-size: 13px;\n  }\n\n  .hnk-hub__list {\n    margin-top: 42px;\n  }\n\n  .hnk-hub__list-head {\n    font-size: 9px;\n    margin-bottom: 12px;\n  }\n\n  .hnk-hub__links {\n    gap: 10px;\n  }\n\n  .hnk-hub__link {\n    grid-template-columns: 23px minmax(0,1fr) auto;\n    gap: 12px;\n    min-height: 112px;\n    padding: 19px 14px;\n    border-radius: 17px;\n  }\n\n  .hnk-hub__number {\n    font-size: 10px;\n  }\n\n  .hnk-hub__category {\n    margin-bottom: 5px;\n    font-size: 8px;\n  }\n\n  .hnk-hub__name {\n    font-size: clamp(20px, 5.2vw, 25px);\n  }\n\n  .hnk-hub__detail {\n    margin-top: 6px;\n    font-size: 12px;\n  }\n\n  .hnk-hub__action {\n    gap: 0;\n  }\n\n  .hnk-hub__action-label {\n    display: none;\n  }\n\n  .hnk-hub__arrow {\n    width: 38px;\n    height: 38px;\n  }\n\n  .hnk-hub__arrow svg {\n    width: 16px;\n    height: 16px;\n  }\n\n  .hnk-hub__footer {\n    margin-top: 35px;\n    gap: 12px;\n    font-size: 8px;\n  }\n\n  .hnk-hub__footer-line {\n    width: 23px;\n  }\n}\n\n/* VERY SMALL SCREENS */\n\n@media screen and (max-width: 360px) {\n  .hnk-hub {\n    padding-inline: 12px;\n  }\n\n  .hnk-hub__link {\n    gap: 9px;\n    padding-inline: 11px;\n  }\n\n  .hnk-hub__arrow {\n    width: 35px;\n    height: 35px;\n  }\n}\