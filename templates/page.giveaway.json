 (!g) return; var r = g.getBoundingClientRect(); g.style.setProperty('--mx', (e.clientX - r.left) + 'px'); g.style.setProperty('--my', (e.clientY - r.top) + 'px'); }, { passive: true });\n  if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n  root.classList.add('hn-js');\n  var TARGETS = ['.hn-h2', '.hn-pz'];\n  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (!e.isIntersecting) return; e.target.classList.add('hn-in'); e.target.querySelectorAll('.hn-cnt').forEach(countUp); io.unobserve(e.target); }); }, { threshold: .2, rootMargin: '0px 0px -6% 0px' });\n  var seen = new Map();\n  TARGETS.forEach(function (sel) { root.querySelectorAll(sel).forEach(function (n) { var i = seen.get(n.parentNode) || 0; seen.set(n.parentNode, i + 1); n.classList.add('hn-rv'); n.style.transitionDelay = (i * 70) + 'ms'; io.observe(n); }); });\n  function countUp(c) { var to = +c.dataset.to, t0 = null; c.textContent = '0'; function f(ts) { if (!t0) t0 = ts; var t = Math.min(1, (ts - t0) / 900); c.textContent = Math.round(to * (1 - Math.pow(1 - t, 3))); if (t < 1) requestAnimationFrame(f); } requestAnimationFrame(f); }\n  var svgs = root.querySelectorAll('.hn-pz svg');\n  function frame() { var vh = window.innerHeight; svgs.forEach(function (sv) { var r = sv.parentNode.getBoundingClientRect(); sv.style.transform = 'translateY(' + ((r.top + r.height / 2 - vh / 2) * (+sv.dataset.s)) + 'px)'; }); }\n  var tk = false; window.addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(function () { tk = false; frame(); }); } }, { passive: true }); window.addEventListener('resize', frame); frame();\n})();\n</script>",
