        "custom_liquid": "<style>\n  @font-face {\n    font-family: 'HNDRD Prize Figtree';\n    src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n    font-weight: 400;\n    font-style: normal;\n    font-display: swap;\n  }\n\n  @font-face {\n    font-family: 'HNDRD Prize Figtree';\n    src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n    font-weight: 700 900;\n    font-style: normal;\n    font-display: swap;\n  }\n\n  .hndrd-gwp {\n    --gold: #d18b25;\n    --ink: #141414;\n    --muted: #6e6e73;\n    position: relative;\n    isolation: isolate;\n    overflow: hidden;\n    padding: clamp(58px, 7vw, 105px) 22px clamp(66px, 7vw, 105px);\n    background: #ffffff;\n    color: var(--ink);\n    font-family: 'HNDRD Prize Figtree', Figtree, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .hndrd-gwp *,\n  .hndrd-gwp *::before,\n  .hndrd-gwp *::after { box-sizing: border-box; }\n\n  .hndrd-gwp__inner { position: relative; max-width: 1200px; margin: 0 auto; }\n  .hndrd-gwp__header { max-width: 820px; margin: 0 auto 47px; text-align: center; }\n  .hndrd-gwp__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin-bottom: 19px;\n    color: #956018;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n\n  .hndrd-gwp__eyebrow::before { content: ''; width: 21px; height: 2px; background: var(--gold); }\n\n  .hndrd-gwp h2 {\n    margin: 0;\n    color: var(--ink);\n    font-family: inherit;\n    font-size: clamp(36px, 5.4vw, 76px);\n    font-weight: 900;\n    letter-spacing: -.055em;\n    line-height: 1.04;\n    text-transform: uppercase;\n  }\n\n  .hndrd-gwp h2 span { color: var(--gold); }\n  .hndrd-gwp__sub {\n    margin: 16px auto 0;\n    color: var(--muted);\n    font-size: clamp(13px, 1.4vw, 16px);\n    font-weight: 400;\n    letter-spacing: .01em;\n    line-height: 1.6;\n  }\n  .hndrd-gwp__sub strong { font-weight: 700; }\n\n  .hndrd-gwp__track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px); }\n  .hndrd-gwp__card {\n    min-width: 0;\n    margin: 0;\n    padding: 9px 9px 0;\n    border: 1px solid rgba(214, 214, 218, .76);\n    border-radius: 30px;\n    background: linear-gradient(145deg, rgba(255, 255, 255, .94), rgba(248, 248, 250, .75));\n    -webkit-backdrop-filter: blur(22px) saturate(150%);\n    backdrop-filter: blur(22px) saturate(150%);\n    box-shadow: 0 2px 5px rgba(20, 20, 25, .025), 0 18px 45px rgba(20, 20, 25, .065);\n    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;\n  }\n  .hndrd-gwp__frame {\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n    aspect-ratio: 4 / 5;\n    border-radius: 22px;\n    background: #061213;\n    box-shadow: none;\n  }\n\n  .hndrd-gwp__frame img { display: block; width: 100%; height: 100%; object-fit: contain; }\n  .hndrd-gwp__caption { padding: 19px 15px 22px; }\n  .hndrd-gwp__caption small {\n    display: block;\n    margin-bottom: 5px;\n    color: #a36b21;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n  .hndrd-gwp__caption h3 {\n    margin: 0;\n    color: var(--ink);\n    font-family: inherit;\n    font-size: clamp(16px, 1.55vw, 21px);\n    font-weight: 700;\n    letter-spacing: -.025em;\n    line-height: 1.26;\n    text-transform: none;\n  }\n\n  .hndrd-gwp__nav { display: none; }\n\n  @media (hover: hover) and (pointer: fine) {\n    .hndrd-gwp__card:hover {\n      transform: translateY(-5px);\n      border-color: rgba(209, 139, 37, .27);\n      box-shadow: 0 7px 18px rgba(20, 20, 25, .04), 0 25px 55px rgba(20, 20, 25, .11);\n    }\n  }\n\n  @media (max-width: 749px) {\n    .hndrd-gwp { padding: 62px 20px 67px; }\n    .hndrd-gwp__header { margin-bottom: 32px; }\n    .hndrd-gwp__eyebrow { margin-bottom: 15px; font-size: 10px; }\n    .hndrd-gwp h2 { font-size: clamp(35px, 8.5vw, 54px); letter-spacing: -.048em; }\n    .hndrd-gwp__sub { max-width: 320px; margin-top: 13px; font-size: 13px; }\n    .hndrd-gwp__track {\n      display: flex;\n      gap: 14px;\n      margin: 0 -20px;\n      padding: 0 20px 10px;\n      overflow-x: auto;\n      overflow-y: hidden;\n      overscroll-behavior-x: contain;\n      scroll-padding-inline: 20px;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none;\n      -webkit-overflow-scrolling: touch;\n    }\n    .hndrd-gwp__track::-webkit-scrollbar { display: none; }\n    .hndrd-gwp__card { flex: 0 0 min(82vw, 360px); scroll-snap-align: start; border-radius: 27px; }\n    .hndrd-gwp__frame { border-radius: 20px; }\n    .hndrd-gwp__caption { padding: 16px 12px 19px; }\n    .hndrd-gwp__caption h3 { font-size: 18px; }\n    .hndrd-gwp.is-ready .hndrd-gwp__nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 14px;\n      margin-top: 18px;\n    }\n    .hndrd-gwp__arrows { display: flex; gap: 9px; }\n    .hndrd-gwp__arrow {\n      display: grid;\n      place-items: center;\n      width: 43px;\n      height: 43px;\n      padding: 0;\n      border: 1px solid #dedee2;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, .82);\n      -webkit-backdrop-filter: blur(15px);\n      backdrop-filter: blur(15px);\n      color: #161514;\n      cursor: pointer;\n      transition: background .2s ease, opacity .2s ease;\n    }\n    .hndrd-gwp__arrow:disabled { opacity: .32; cursor: default; }\n    .hndrd-gwp__arrow:not(:disabled):active { background: #faf2e7; }\n    .hndrd-gwp__arrow svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 1.8; fill: none; }\n    .hndrd-gwp__dots { display: flex; align-items: center; gap: 7px; }\n    .hndrd-gwp__dot { width: 7px; height: 7px; padding: 0; border: none; border-radius: 20px; background: #d1d1d6; cursor: pointer; transition: background .25s ease, width .25s ease; }\n    .hndrd-gwp__dot[aria-current='true'] { width: 27px; background: var(--gold); }\n  }\n\n  .hndrd-gwp button:focus-visible { outline: 2px solid #79501b; outline-offset: 4px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hndrd-gwp *, .hndrd-gwp *::before, .hndrd-gwp *::after { scroll-behavior: auto !important; transition: none !important; }\n  }\n/* MATCH HNDRD GIVEAWAY BACKGROUND */\n\nhndrd-retail-preview {\n  background: #FFFAF0 !important;\n}\n\n@media (max-width: 767px) {\n  hndrd-retail-preview {\n    background: #FFFAF0 !important;\n  }\n}\n/* ==========================================\n   HNDRD GIVEAWAY\n   EXACT BRAND COLOURS\n========================================== */\n\n.hndrd-gwp {\n  --gold: #FFA300;\n  --orange: #FFA300;\n\n  background: #FFFAF0 !important;\n}\n\n/* MAIN HEADING */\n\n.hndrd-gwp h2 span {\n  color: #FFA300 !important;\n}\n\n/* EYEBROW ACCENT */\n\n.hndrd-gwp__eyebrow {\n  color: #FFA300 !important;\n}\n\n.hndrd-gwp__eyebrow::before {\n  background: #FFA300 !important;\n}\n\n/* PRODUCT CATEGORY LABELS */\n\n.hndrd-gwp__caption small {\n  color: #FFA300 !important;\n}\n\n/* PRODUCT CARD HOVER */\n\n@media (hover: hover) and (pointer: fine) {\n  .hndrd-gwp__card:hover {\n    border-color: rgba(255,163,0,.4) !important;\n  }\n}\n\n/* CAROUSEL ACTIVE INDICATOR */\n\n.hndrd-gwp__dot[aria-current='true'] {\n  background: #FFA300 !important;\n}\n\n/* FOCUS STATES */\n\n.hndrd-gwp button:focus-visible {\n  outline-color: #FFA300 !important;\n}\n\n/* MOBILE */\n\n@media (max-width: 749px) {\n  .hndrd-gwp {\n    background: #FFFAF0 !important;\n  }\n}\n\n/* HNDRD GIVEAWAY — REMOVE MOBILE CARD SHADOWS */\n\n@media (max-width: 749px) {\n  .hndrd-gwp .hndrd-gwp__card,\n  .hndrd-gwp .hndrd-gwp__card:hover,\n  .hndrd-gwp .hndrd-gwp__card:active {\n    box-shadow: none !important;\n    filter: none !important;\n    transform: none !important;\n  }\n\n  .hndrd-gwp .hndrd-gwp__frame {\n    box-shadow: none !important;\n    filter: none !important;\n  }\n\n  .hndrd-gwp .hndrd-gwp__track {\n    box-shadow: none !important;\n  }\n}\n\n/* RESTORE ORIGINAL DESKTOP LAYOUT ONLY */\n\n@media (min-width: 768px) {\n\n  hndrd-retail-preview .hn-container {\n    max-width: 1300px;\n  }\n\n  hndrd-retail-preview .hn-layout {\n    display: grid;\n    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);\n    align-items: center;\n    gap: clamp(45px, 6vw, 100px);\n    padding: clamp(30px, 4vw, 55px);\n\n    background: #ffffff;\n    border: 1px solid rgba(0,0,0,.035);\n    border-radius: 28px;\n    box-shadow: 0 10px 38px rgba(0,0,0,.035);\n  }\n\n  hndrd-retail-preview .hn-content {\n    display: block;\n    text-align: left;\n    padding: 0;\n  }\n\n  hndrd-retail-preview .hn-eyebrow {\n    justify-content: flex-start;\n  }\n\n  hndrd-retail-preview .hn-title {\n    text-align: left;\n    font-size: clamp(39px, 4.25vw, 62px) !important;\n  }\n\n  hndrd-retail-preview .hn-description {\n    max-width: 360px;\n    margin: 19px 0 28px !important;\n    text-align: left;\n  }\n\n  hndrd-retail-preview .hn-primary {\n    margin: 0;\n  }\n\n  hndrd-retail-preview .hn-map-shell {\n    height: 365px;\n    border-radius: 20px;\n  }\n}\n\n@media (min-width: 768px) and (max-width: 1024px) {\n  hndrd-retail-preview .hn-layout {\n    gap: 28px;\n    padding: 25px;\n  }\n\n  hndrd-retail-preview .hn-map-shell {\n    height: 330px;\n  }\n}\n\n</style>\n\n<section class=\"hndrd-gwp\" data-hndrd-gwp aria-labelledby=\"hndrd-gwp-title\">\n  <div class=\"hndrd-gwp__inner\">\n    <header class=\"hndrd-gwp__header\">\n      <div class=\"hndrd-gwp__eyebrow\"></div>\n      <h2 id=\"hndrd-gwp-title\">WHAT CAN YOU <span>WIN?</span></h2>\n      <p class=\"hndrd-gwp__sub\"><strong>3 LUCKY WINNERS.</strong> Each winner receives all three prizes.</p>\n    </header>\n\n    <div class=\"hndrd-gwp__track\" data-gwp-track aria-label=\"Three prizes included in each giveaway package\">\n      <figure class=\"hndrd-gwp__card\">\n        <div class=\"hndrd-gwp__frame\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0934/2822/0217/files/A_1.png?v=1792999271\" width=\"1080\" height=\"1350\" alt=\"HNDRD NITRIX 80 BULLET badminton racket\" loading=\"eager\" decoding=\"async\">\n        </div>\n        <figcaption class=\"hndrd-gwp__caption\"><small>Racket</small><h3>1 x HNDRD NITRIX 80 BULLET</h3></figcaption>\n      </figure>\n\n      <figure class=\"hndrd-gwp__card\">\n        <div class=\"hndrd-gwp__frame\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0934/2822/0217/files/A_2.png?v=1792999274\" width=\"1080\" height=\"1350\" alt=\"Black HNDRD AERIS PACK kit bag\" loading=\"lazy\" decoding=\"async\">\n        </div>\n        <figcaption class=\"hndrd-gwp__caption\"><small>Kit Bag</small><h3>1 x HNDRD AERIS PACK KIT BAG</h3></figcaption>\n      </figure>\n\n      <figure class=\"hndrd-gwp__card\">\n        <div class=\"hndrd-gwp__frame\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0934/2822/0217/files/A_3.png?v=1792999278\" width=\"1080\" height=\"1350\" alt=\"Black HNDRD Tournament T-shirt\" loading=\"lazy\" decoding=\"async\">\n        </div>\n        <figcaption class=\"hndrd-gwp__caption\"><small>Apparel</small><h3>1 x  HNDRD TOURNAMENT T-SHIRT</h3></figcaption>\n      </figure>\n    </div>\n\n    <div class=\"hndrd-gwp__nav\" aria-label=\"Prize carousel controls\">\n      <div class=\"hndrd-gwp__dots\" aria-label=\"Choose prize\">\n        <button class=\"hndrd-gwp__dot\" type=\"button\" aria-label=\"Show prize 1\" aria-current=\"true\" data-gwp-dot=\"0\"></button>\n        <button class=\"hndrd-gwp__dot\" type=\"button\" aria-label=\"Show prize 2\" aria-current=\"false\" data-gwp-dot=\"1\"></button>\n        <button class=\"hndrd-gwp__dot\" type=\"button\" aria-label=\"Show prize 3\" aria-current=\"false\" data-gwp-dot=\"2\"></button>\n      </div>\n      <div class=\"hndrd-gwp__arrows\">\n        <button class=\"hndrd-gwp__arrow\" type=\"button\" aria-label=\"Previous prize\" data-gwp-prev disabled><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 5-7 7 7 7\"/></svg></button>\n        <button class=\"hndrd-gwp__arrow\" type=\"button\" aria-label=\"Next prize\" data-gwp-next><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m10 5 7 7-7 7\"/></svg></button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-hndrd-gwp]').forEach(function (root) {\n      if (root.dataset.gwpReady) return;\n      root.dataset.gwpReady = 'true';\n      var track = root.querySelector('[data-gwp-track]');\n      var cards = Array.from(track.querySelectorAll('.hndrd-gwp__card'));\n      var dots = Array.from(root.querySelectorAll('[data-gwp-dot]'));\n      var prev = root.querySelector('[data-gwp-prev]');\n      var next = root.querySelector('[data-gwp-next]');\n      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n      var current = 0;\n      var ticking = false;\n\n      function setCurrent(index) {\n        current = Math.max(0, Math.min(cards.length - 1, index));\n        dots.forEach(function (dot, i) { dot.setAttribute('aria-current', i === current ? 'true' : 'false'); });\n        prev.disabled = current === 0;\n        next.disabled = current === cards.length - 1;\n      }\n\n      function goTo(index) {\n        index = Math.max(0, Math.min(cards.length - 1, index));\n        setCurrent(index);\n        track.scrollTo({\n          left: cards[index].offsetLeft - cards[0].offsetLeft,\n          behavior: reduceMotion.matches ? 'auto' : 'smooth'\n        });\n      }\n\n      function updateFromScroll() {\n        ticking = false;\n        var step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : 1;\n        setCurrent(Math.round(track.scrollLeft / step));\n      }\n\n      track.addEventListener('scroll', function () {\n        if (!ticking) {\n          ticking = true;\n          requestAnimationFrame(updateFromScroll);\n        }\n      }, { passive: true });\n      prev.addEventListener('click', function () { goTo(current - 1); });\n      next.addEventListener('click', function () { goTo(current + 1); });\n      dots.forEach(function (dot, index) {\n        cfdot.addEventListener('click', function () { goTo(index); });\n      });\n      root.classList.add('is-ready');\n      setCurrent(0);\n    });\n  })();\n</script>",
