      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD USA — ULTIMATE GIVEAWAY\n  HOW TO ENTER\n\n  Brand Orange: #FFA300\n  Background: #FFFAF0\n  Responsive entry table\n{% endcomment %}\n\n<style>\n@font-face {\n  font-family: 'HNDRD Guide';\n  src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n  font-weight: 400;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD Guide';\n  src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n  font-weight: 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD Guide';\n  src: url(\"{{ 'Figtree-ExtraBold.ttf' | file_url }}\") format('truetype');\n  font-weight: 800;\n  font-display: swap;\n}\n\n/* FOUNDATION */\n\n.h80-how {\n  --orange: #FFA300;\n  --black: #080808;\n  --ink: #1c1c1c;\n  --muted: #74716a;\n  --line: #e9e3d8;\n\n  width: 100%;\n  padding: clamp(55px, 7vw, 92px) 22px;\n\n  background: #FFFAF0;\n  color: var(--ink);\n\n  font-family: 'HNDRD Guide', Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\n.h80-how,\n.h80-how *,\n.h80-how *::before,\n.h80-how *::after {\n  box-sizing: border-box;\n}\n\n.h80-how h2,\n.h80-how h3,\n.h80-how p {\n  margin: 0;\n  padding: 0;\n  font-family: inherit;\n  color: inherit;\n}\n\n.h80-how__container {\n  max-width: 1160px;\n  margin: 0 auto;\n}\n\n/* HEADER */\n\n.h80-how__header {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n\n  gap: 32px;\n  margin-bottom: 30px;\n}\n\n.h80-how__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin-bottom: 15px;\n\n  color: #79736b;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .13em;\n  text-transform: uppercase;\n}\n\n.h80-how__eyebrow::before {\n  content: '';\n\n  width: 7px;\n  height: 7px;\n\n  border-radius: 50%;\n  background: #FFA300;\n}\n\n.h80-how__title {\n  font-size: clamp(43px, 6vw, 72px);\n  line-height: 1;\n  letter-spacing: -.065em;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n/* EXACT HNDRD ORANGE */\n\n.h80-how__title span {\n  color: #FFA300;\n}\n\n.h80-how__subtitle {\n  max-width: 430px;\n  margin-top: 15px !important;\n\n  color: #76716a !important;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n/* ENTRY CAP */\n\n.h80-how__cap {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  flex-shrink: 0;\n\n  padding: 15px 18px;\n\n  border: 1px solid #eadfcd;\n  border-radius: 13px;\n  background: rgba(255,255,255,.55);\n}\n\n.h80-how__cap-number {\n  font-size: 35px;\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -.07em;\n}\n\n.h80-how__cap-label {\n  max-width: 105px;\n\n  color: #777167;\n  font-size: 10px;\n  font-weight: 700;\n  line-height: 1.35;\n  text-transform: uppercase;\n  letter-spacing: .055em;\n}\n\n/* MAIN TABLE */\n\n.h80-how__table {\n  overflow: hidden;\n  border-radius: 18px;\n\n  border: 1px solid #e7dfd3;\n  background: #fffdf8;\n\n  box-shadow:\n    0 10px 35px rgba(45,28,0,.035);\n}\n\n/* BLACK TABLE HEADER */\n\n.h80-how__table-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 115px;\n  align-items: center;\n  gap: 20px;\n\n  padding: 19px 26px;\n\n  background: var(--black);\n  color: #fff;\n}\n\n.h80-how__table-head strong {\n  color: #FFA300;\n\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: .095em;\n  text-transform: uppercase;\n}\n\n.h80-how__table-head span {\n  color: #a9a9a9;\n\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .11em;\n  text-transform: uppercase;\n  text-align: right;\n}\n\n/* CATEGORIES */\n\n.h80-how__category {\n  display: grid;\n  grid-template-columns: 255px minmax(0, 1fr);\n\n  gap: clamp(22px, 4vw, 55px);\n  padding: 28px 27px;\n}\n\n.h80-how__category + .h80-how__category {\n  border-top: 1px solid var(--line);\n}\n\n.h80-how__category-info {\n  padding-top: 4px;\n}\n\n/* CATEGORY LABEL — HNDRD ORANGE */\n\n.h80-how__category-tag {\n  display: inline-block;\n  margin-bottom: 10px;\n\n  color: #FFA300;\n\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: .095em;\n  text-transform: uppercase;\n}\n\n.h80-how__category-title {\n  color: #171717;\n\n  font-size: 26px;\n  font-weight: 800;\n  line-height: 1.13;\n  letter-spacing: -.055em;\n}\n\n.h80-how__category-description {\n  max-width: 225px;\n  margin-top: 10px !important;\n\n  color: #868078 !important;\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n/* ENTRY ROWS */\n\n.h80-how__entries {\n  min-width: 0;\n}\n\n.h80-how__entry {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 100px;\n  align-items: center;\n  gap: 20px;\n\n  min-height: 65px;\n  padding: 10px 0;\n}\n\n.h80-how__entry + .h80-how__entry {\n  border-top: 1px solid #eee8dd;\n}\n\n.h80-how__entry-name {\n  color: #242424;\n\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\n.h80-how__entry-detail {\n  margin-top: 4px !important;\n\n  color: #8a847c !important;\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n/* REWARDS — EXACT HNDRD ORANGE */\n\n.h80-how__reward {\n  display: flex;\n  align-items: baseline;\n  justify-content: flex-end;\n  gap: 6px;\n  white-space: nowrap;\n}\n\n.h80-how__reward strong {\n  color: #FFA300;\n\n  font-size: 30px;\n  font-weight: 800;\n  letter-spacing: -.07em;\n  line-height: 1;\n}\n\n.h80-how__reward span {\n  color: #8b857e;\n\n  font-size: 10px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n/* FOOTNOTE */\n\n.h80-how__footer {\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n\n  max-width: 900px;\n  margin-top: 20px !important;\n\n  color: #888076 !important;\n  font-size: 11px;\n  line-height: 1.6;\n}\n\n.h80-how__footer::before {\n  content: '';\n\n  width: 5px;\n  height: 5px;\n  margin-top: 6px;\n  flex: 0 0 5px;\n\n  border-radius: 50%;\n  background: #FFA300;\n}\n\n/* TABLET */\n\n@media (max-width: 900px) {\n  .h80-how__category {\n    grid-template-columns: 210px minmax(0, 1fr);\n    gap: 24px;\n  }\n\n  .h80-how__category-title {\n    font-size: 23px;\n  }\n}\n\n/* MOBILE */\n\n@media (max-width: 700px) {\n\n  .h80-how {\n    padding: 42px 14px 48px;\n    background: #FFFAF0;\n  }\n\n  .h80-how__header {\n    display: block;\n    margin-bottom: 23px;\n  }\n\n  .h80-how__eyebrow {\n    margin-bottom: 12px;\n    font-size: 9px;\n  }\n\n  .h80-how__title {\n    font-size: clamp(39px, 10vw, 52px);\n    line-height: 1.02;\n  }\n\n  .h80-how__subtitle {\n    margin-top: 11px !important;\n    font-size: 12px;\n    line-height: 1.55;\n  }\n\n  /* MAXIMUM ENTRIES BADGE */\n\n  .h80-how__cap {\n    display: inline-flex;\n    gap: 9px;\n\n    margin-top: 17px;\n    padding: 9px 12px;\n    border-radius: 9px;\n  }\n\n  .h80-how__cap-number {\n    font-size: 22px;\n  }\n\n  .h80-how__cap-label {\n    max-width: none;\n    font-size: 9px;\n  }\n\n  /* TABLE */\n\n  .h80-how__table {\n    border-radius: 13px;\n  }\n\n  .h80-how__table-head {\n    grid-template-columns: minmax(0, 1fr) 55px;\n    gap: 10px;\n    padding: 14px 15px;\n  }\n\n  .h80-how__table-head strong {\n    font-size: 10px;\n    color: #FFA300;\n  }\n\n  .h80-how__table-head span {\n    font-size: 9px;\n  }\n\n  /* CATEGORY */\n\n  .h80-how__category {\n    display: block;\n    padding: 18px 15px 13px;\n  }\n\n  .h80-how__category-info {\n    padding: 0 0 9px;\n  }\n\n  .h80-how__category-tag {\n    margin-bottom: 5px;\n    font-size: 9px;\n    color: #FFA300;\n  }\n\n  .h80-how__category-title {\n    font-size: 21px;\n    line-height: 1.15;\n  }\n\n  .h80-how__category-description {\n    display: none;\n  }\n\n  /* COMPACT ROWS */\n\n  .h80-how__entry {\n    grid-template-columns: minmax(0, 1fr) 68px;\n    gap: 10px;\n\n    min-height: 0;\n    padding: 11px 0;\n  }\n\n  .h80-how__entry-name {\n    font-size: 12px;\n    line-height: 1.38;\n  }\n\n  .h80-how__entry-detail {\n    margin-top: 3px !important;\n    font-size: 10px;\n    line-height: 1.4;\n  }\n\n  /* ORANGE REWARDS */\n\n  .h80-how__reward {\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 2px;\n  }\n\n  .h80-how__reward strong {\n    font-size: 25px;\n    color: #FFA300;\n  }\n\n  .h80-how__reward span {\n    font-size: 8px;\n  }\n\n  .h80-how__footer {\n    margin-top: 15px !important;\n    font-size: 10px;\n    line-height: 1.55;\n  }\n}\n\n/* SMALL PHONES */\n\n@media (max-width: 360px) {\n  .h80-how {\n    padding-left: 10px;\n    padding-right: 10px;\n  }\n\n  .h80-how__category {\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n\n  .h80-how__entry-name {\n    font-size: 11px;\n  }\n}\n/* ==========================================\n   HNDRD GIVEAWAY — CENTERED HEADER\n========================================== */\n\n.h80-how__header {\n  display: flex !important;\n  flex-direction: column;\n  align-items: center !important;\n  justify-content: center !important;\n\n  width: 100%;\n  gap: 0;\n\n  margin-bottom: 36px;\n  text-align: center !important;\n}\n\n.h80-how__header > div:first-child {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n\n  width: 100%;\n  text-align: center;\n}\n\n/* EYEBROW */\n\n.h80-how__eyebrow {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: fit-content;\n  margin: 0 auto 16px !important;\n\n  text-align: center;\n}\n\n/* TITLE */\n\n.h80-how__title {\n  width: 100%;\n  margin: 0 auto !important;\n  text-align: center !important;\n}\n\n/* DESCRIPTION */\n\n.h80-how__subtitle {\n  max-width: 520px;\n  margin: 20px auto 0 !important;\n\n  text-align: center !important;\n}\n\n/* MAXIMUM ENTRIES BADGE */\n\n.h80-how__cap {\n  margin: 25px auto 0 !important;\n  align-self: center;\n}\n\n/* MOBILE */\n\n@media (max-width: 700px) {\n\n  .h80-how__header {\n    align-items: center !important;\n    gap: 0;\n    margin-bottom: 26px;\n  }\n\n  .h80-how__eyebrow {\n    margin-bottom: 13px !important;\n    font-size: 9px;\n  }\n\n  .h80-how__title {\n    font-size: clamp(36px, 9vw, 48px);\n    text-align: center !important;\n  }\n\n  .h80-how__subtitle {\n    max-width: 340px;\n    margin: 14px auto 0 !important;\n\n    font-size: 12px;\n    line-height: 1.6;\n    text-align: center !important;\n  }\n\n  .h80-how__cap {\n    margin: 19px auto 0 !important;\n  }\n}\n\n/* SLIGHTLY LARGER MOBILE TYPOGRAPHY */\n\n@media (max-width: 700px) {\n\n  .h80-how__table-head strong {\n    font-size: 11px;\n  }\n\n  .h80-how__table-head span {\n    font-size: 10px;\n  }\n\n  .h80-how__category-tag {\n    font-size: 10px;\n  }\n\n  .h80-how__category-title {\n    font-size: 23px;\n  }\n\n  .h80-how__entry-name {\n    font-size: 14px;\n    line-height: 1.4;\n  }\n\n  .h80-how__entry-detail {\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  .h80-how__reward strong {\n    font-size: 27px;\n  }\n\n  .h80-how__reward span {\n    font-size: 9px;\n  }\n\n  .h80-how__footer {\n    font-size: 11px;\n  }\n}\n\n</style>\n\n<section class=\"h80-how\" aria-labelledby=\"h80-how-title\">\n\n  <div class=\"h80-how__container\">\n\n    <!-- HEADER -->\n\n    <header class=\"h80-how__header\">\n\n      <div>\n\n     <div class=\"h80-how__eyebrow\">\n          HNDRD USA / Ultimate Giveaway\n        </div></center>\n\n        <center><h2 class=\"h80-how__title\" id=\"h80-how-title\">\n          HOW TO <span>ENTER.</span>\n        </h2>\n\n        <p class=\"h80-how__subtitle\">\n          Start with a free entry. Earn more through\n          social sharing and qualifying purchases.\n        </p>\n\n      </div>\n\n      <div class=\"h80-how__cap\">\n        <strong class=\"h80-how__cap-number\">\n          100\n        </strong>\n\n        <span class=\"h80-how__cap-label\">\n          Maximum entries per participant\n        </span>\n      </div>\n\n    </header>\n\n    <!-- TABLE -->\n\n    <div class=\"h80-how__table\">\n\n      <div class=\"h80-how__table-head\">\n        <strong>Ways to enter</strong>\n        <span>Entries</span>\n      </div>\n\n      <!-- FREE ENTRY -->\n\n      <div class=\"h80-how__category\">\n\n        <div class=\"h80-how__category-info\">\n\n          <span class=\"h80-how__category-tag\">\n            No purchase necessary\n          </span>\n\n          <h3 class=\"h80-how__category-title\">\n            Enter for free.\n          </h3>\n\n          <p class=\"h80-how__category-description\">\n            Complete the official entry form\n            to participate.\n          </p>\n\n        </div>\n\n        <div class=\"h80-how__entries\">\n\n          <div class=\"h80-how__entry\">\n\n            <div>\n              <div class=\"h80-how__entry-name\">\n                Complete the official entry form\n              </div>\n\n              <p class=\"h80-how__entry-detail\">\n                Available once per day\n              </p>\n              <p class=\"h80-how__entry-detail\">\n                <strong>BONUS: Earn +40 entries when you enter all 30 days!</strong>\n              </p>\n            </div>\n\n            <div class=\"h80-how__reward\">\n              <strong>+2</strong>\n              <span>Per day</span>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      <!-- SOCIAL ENTRIES -->\n\n      <div class=\"h80-how__category\">\n\n        <div class=\"h80-how__category-info\">\n\n          <span class=\"h80-how__category-tag\">\n            Social bonus entries\n          </span>\n\n          <h3 class=\"h80-how__category-title\">\n            Follow &amp; share.\n          </h3>\n\n          <p class=\"h80-how__category-description\">\n            Follow HNDRD USA and share\n            your gear on Instagram.\n          </p>\n\n        </div>\n\n        <div class=\"h80-how__entries\">\n\n          <div class=\"h80-how__entry\">\n\n            <div>\n              <div class=\"h80-how__entry-name\">\n                Follow @hndrd.us on Instagram\n              </div>\n\n              <p class=\"h80-how__entry-detail\">\n                Follow the official HNDRD USA account\n              </p>\n            </div>\n\n            <div class=\"h80-how__reward\">\n              <strong>+2</strong>\n              <span>Entries</span>\n            </div>\n\n          </div>\n\n          <div class=\"h80-how__entry\">\n\n            <div>\n              <div class=\"h80-how__entry-name\">\n                Share your HNDRD gear\n              </div>\n\n              <p class=\"h80-how__entry-detail\">\n                Post or Instagram Story. Tag @hndrd.us\n              </p>\n            </div>\n\n            <div class=\"h80-how__reward\">\n              <strong>+5</strong>\n              <span>Entries</span>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      <!-- PURCHASE ENTRIES -->\n\n      <div class=\"h80-how__category\">\n\n        <div class=\"h80-how__category-info\">\n\n          <span class=\"h80-how__category-tag\">\n            Purchase bonus entries\n          </span>\n\n          <h3 class=\"h80-how__category-title\">\n            Shop HNDRD.\n          </h3>\n\n          <p class=\"h80-how__category-description\">\n            Earn additional entries through\n            qualifying retailer purchases.\n          </p>\n\n        </div>\n\n        <div class=\"h80-how__entries\">\n\n          <div class=\"h80-how__entry\">\n\n            <div>\n              <div class=\"h80-how__entry-name\">\n                Purchase Any HNDRD Strings\n              </div>\n\n              <p class=\"h80-how__entry-detail\">\n                At authorized HNDRD USA retailers\n              </p>\n            </div>\n\n            <div class=\"h80-how__reward\">\n              <strong>+5</strong>\n              <span>Entries</span>\n            </div>\n\n          </div>\n\n          <div class=\"h80-how__entry\">\n\n            <div>\n              <div class=\"h80-how__entry-name\">\n                Purchase Any HNDRD Rackets and Shoes\n              </div>\n\n              <p class=\"h80-how__entry-detail\">\n                At authorized HNDRD USA retailers\n              </p>\n            </div>\n\n            <div class=\"h80-how__reward\">\n              <strong>+20</strong>\n              <span>Entries</span>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- FOOTNOTE -->\n\n    <p class=\"h80-how__footer\">\n      Maximum 100 entries per participant.\n      No purchase necessary. Eligibility, verification,\n      entry limits and other conditions are subject\n      to the Official Giveaway Rules.\n      Purchases made on us.hndrd.co are not eligible for giveaway entries.\n    </p>\n\n  </div>\n\n</section>",
