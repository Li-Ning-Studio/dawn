        "custom_liquid": "{% comment %}\n  HNDRD USA — RETAILER PREVIEW\n  Premium minimal layout\n  Mobile-first\n  Real Shopify retailer metaobjects\n  MapLibre + OpenFreeMap\n\n  Attribution uses a custom disclosure button.\n  It never expands automatically.\n{% endcomment %}\n\n{% assign hn_locator_url = 'https://us.hndrd.co/pages/hndrd-store-locator' %}\n\n<link\n  rel=\"stylesheet\"\n  href=\"https://cdn.jsdelivr.net/npm/maplibre-gl@5.12.0/dist/maplibre-gl.css\"\n>\n\n<style>\n@font-face {\n  font-family: 'HN-Retail';\n  src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n  font-weight: 400;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HN-Retail';\n  src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n  font-weight: 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HN-Retail';\n  src: url(\"{{ 'Figtree-ExtraBold.ttf' | file_url }}\") format('truetype');\n  font-weight: 800;\n  font-display: swap;\n}\n\n/* BASE */\n\nhndrd-retail-preview {\n  --hn-accent: #FFA300;\n  --hn-ink: #111113;\n  --hn-muted: #69696f;\n  --hn-line: #e7e7e9;\n\n  display: block;\n  width: 100%;\n  padding: 56px 5%;\n  background: #f5f5f5;\n  color: var(--hn-ink);\n\n  font-family: 'HN-Retail', Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\nhndrd-retail-preview,\nhndrd-retail-preview * {\n  box-sizing: border-box;\n}\n\nhndrd-retail-preview [hidden] {\n  display: none !important;\n}\n\nhndrd-retail-preview .hn-container {\n  max-width: 1300px;\n  margin: auto;\n}\n\n/* MAIN LAYOUT */\n\nhndrd-retail-preview .hn-layout {\n  display: grid;\n  grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);\n  align-items: center;\n  gap: clamp(45px, 6vw, 100px);\n\n  padding: clamp(30px, 4vw, 55px);\n\n  background: #fff;\n  border: 1px solid rgba(0,0,0,.035);\n  border-radius: 28px;\n\n  box-shadow:\n    0 10px 38px rgba(0,0,0,.035);\n}\n\n/* TEXT CONTENT */\n\nhndrd-retail-preview .hn-content {\n  min-width: 0;\n}\n\nhndrd-retail-preview .hn-eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n\n  margin-bottom: 22px;\n\n  color: #77777b;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n\nhndrd-retail-preview .hn-eyebrow::before {\n  content: '';\n  width: 7px;\n  height: 7px;\n\n  border-radius: 50%;\n  background: var(--hn-accent);\n}\n\nhndrd-retail-preview .hn-title {\n  margin: 0 0 19px !important;\n  padding: 0;\n\n  color: var(--hn-ink);\n  font-family: 'HN-Retail', Arial, sans-serif;\n\n  font-size: clamp(39px, 4.25vw, 62px);\n  font-weight: 800;\n  line-height: 1.045;\n  letter-spacing: -.055em;\n  text-transform: none;\n}\n\nhndrd-retail-preview .hn-title span {\n  color: var(--hn-accent);\n}\n\nhndrd-retail-preview .hn-description {\n  max-width: 360px;\n  margin: 0 0 28px !important;\n\n  color: var(--hn-muted);\n  font-size: 15px;\n  line-height: 1.65;\n}\n\n/* PRIMARY BUTTON */\n\nhndrd-retail-preview .hn-primary {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 32px;\n\n  min-height: 50px;\n  padding: 13px 21px;\n\n  border-radius: 999px;\n  border: 1px solid transparent;\n\n  background: var(--hn-accent);\n  color: #fff !important;\n\n  font-family: 'HN-Retail', Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: .025em;\n  text-decoration: none !important;\n\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\nhndrd-retail-preview .hn-primary:hover {\n  background: #f2a000;\n  transform: translateY(-1px);\n}\n\nhndrd-retail-preview .hn-primary svg {\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n}\n\n/* MAP */\n\nhndrd-retail-preview .hn-map-shell {\n  position: relative;\n  isolation: isolate;\n\n  width: 100%;\n  min-width: 0;\n  height: 365px;\n\n  overflow: hidden;\n  border-radius: 20px;\n\n  background: #eceff0;\n  border: 1px solid rgba(0,0,0,.045);\n}\n\nhndrd-retail-preview .hn-map {\n  position: absolute;\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n}\n\nhndrd-retail-preview .maplibregl-map {\n  font-family: 'HN-Retail', Arial, sans-serif;\n}\n\n/* MAP LINK */\n\nhndrd-retail-preview .hn-map-link {\n  position: absolute;\n  z-index: 5;\n\n  right: 12px;\n  bottom: 12px;\n\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n\n  min-height: 38px;\n  padding: 10px 14px;\n\n  border-radius: 999px;\n  border: 1px solid rgba(0,0,0,.045);\n\n  background: rgba(255,255,255,.97);\n  color: #171717 !important;\n\n  font-size: 11px;\n  font-weight: 700;\n  text-decoration: none !important;\n  white-space: nowrap;\n\n  box-shadow: 0 3px 11px rgba(0,0,0,.075);\n}\n\nhndrd-retail-preview .hn-map-link svg {\n  width: 14px;\n  height: 14px;\n}\n\n/* ======================================\n   CUSTOM MAP ATTRIBUTION\n   ALWAYS CLOSED INITIALLY\n====================================== */\n\nhndrd-retail-preview .hn-attribution {\n  position: absolute;\n  z-index: 8;\n\n  left: 10px;\n  bottom: 10px;\n}\n\n/* Tiny info button */\n\nhndrd-retail-preview .hn-attribution-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 25px;\n  height: 25px;\n  min-width: 25px;\n  min-height: 25px;\n\n  padding: 0;\n  margin: 0;\n\n  border: 1px solid rgba(0,0,0,.13);\n  border-radius: 50%;\n\n  background: rgba(255,255,255,.97);\n  color: #666;\n\n  font-family: Georgia, serif;\n  font-size: 14px;\n  font-style: italic;\n  font-weight: 700;\n  line-height: 1;\n\n  box-shadow: 0 2px 8px rgba(0,0,0,.11);\n  cursor: pointer;\n\n  transition:\n    background .2s ease,\n    color .2s ease;\n}\n\nhndrd-retail-preview .hn-attribution-toggle:hover {\n  background: #fff;\n  color: #111;\n}\n\n/* Hidden by default. Only JS click opens it. */\n\nhndrd-retail-preview .hn-attribution-content {\n  position: absolute;\n\n  left: 0;\n  bottom: 34px;\n\n  width: max-content;\n  max-width: min(235px, 68vw);\n\n  padding: 12px 13px;\n\n  border-radius: 12px;\n  border: 1px solid rgba(0,0,0,.055);\n\n  background: rgba(255,255,255,.98);\n\n  box-shadow:\n    0 7px 25px rgba(0,0,0,.13);\n\n  color: #555;\n  font-size: 10px;\n  line-height: 1.65;\n}\n\nhndrd-retail-preview .hn-attribution-content a {\n  color: #373737;\n  text-decoration: underline;\n  text-underline-offset: 2px;\n}\n\nhndrd-retail-preview .hn-attribution-title {\n  display: block;\n  margin-bottom: 5px;\n\n  color: #111;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n/* MAP ZOOM */\n\nhndrd-retail-preview .maplibregl-ctrl-top-right {\n  top: 11px;\n  right: 11px;\n}\n\nhndrd-retail-preview .maplibregl-ctrl-top-right .maplibregl-ctrl {\n  margin: 0;\n}\n\nhndrd-retail-preview .maplibregl-ctrl-group {\n  overflow: hidden;\n\n  border: 1px solid rgba(0,0,0,.06);\n  border-radius: 11px;\n\n  background: rgba(255,255,255,.96);\n  box-shadow: 0 3px 12px rgba(0,0,0,.075);\n}\n\nhndrd-retail-preview .maplibregl-ctrl-group button {\n  width: 34px;\n  height: 34px;\n  border-radius: 0;\n}\n\n/* MAP STATUS */\n\nhndrd-retail-preview .hn-map-status {\n  position: absolute;\n  z-index: 4;\n\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n\n  width: calc(100% - 40px);\n  max-width: 280px;\n  padding: 16px;\n\n  border-radius: 12px;\n  background: rgba(255,255,255,.96);\n\n  color: #555;\n  font-size: 12px;\n  line-height: 1.5;\n  text-align: center;\n}\n\n/* POPUPS */\n\nhndrd-retail-preview .maplibregl-popup-content {\n  min-width: 195px;\n  padding: 17px;\n\n  border-radius: 15px;\n  background: rgba(255,255,255,.98);\n\n  font-family: 'HN-Retail', Arial, sans-serif;\n  box-shadow: 0 12px 32px rgba(0,0,0,.16);\n}\n\nhndrd-retail-preview .maplibregl-popup-close-button {\n  top: 8px;\n  right: 8px;\n\n  width: 26px;\n  height: 26px;\n\n  border-radius: 50%;\n  background: #f2f2f3;\n\n  font-size: 17px;\n}\n\nhndrd-retail-preview .hn-store-name {\n  margin: 0 22px 7px 0;\n\n  color: #111;\n  font-size: 14px;\n  font-weight: 800;\n  line-heig