t-size: clamp(35px, 8.9vw, 42px);\n    line-height: 1.065;\n    letter-spacing: -.055em;\n  }\n\n  hndrd-retail-preview .hn-description {\n    max-width: 310px;\n    margin-bottom: 21px !important;\n\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  /* Better button proportions */\n\n  hndrd-retail-preview .hn-primary {\n    width: 100%;\n    min-height: 47px;\n\n    padding: 12px 18px;\n    justify-content: space-between;\n\n    font-size: 11px;\n  }\n\n  hndrd-retail-preview .hn-primary svg {\n    width: 16px;\n    height: 16px;\n  }\n\n  /* Cleaner map */\n\n  hndrd-retail-preview .hn-map-shell {\n    height: 265px;\n    min-height: 265px;\n\n    border-radius: 15px;\n  }\n\n  /* Map action */\n\n  hndrd-retail-preview .hn-map-link {\n    right: 9px;\n    bottom: 9px;\n\n    min-height: 34px;\n    padding: 9px 12px;\n\n    font-size: 10px;\n    gap: 6px;\n  }\n\n  hndrd-retail-preview .hn-map-link svg {\n    width: 12px;\n    height: 12px;\n  }\n\n  /* Small info control */\n\n  hndrd-retail-preview .hn-attribution {\n    left: 9px;\n    bottom: 9px;\n  }\n\n  hndrd-retail-preview .hn-attribution-toggle {\n    width: 24px;\n    height: 24px;\n    min-width: 24px;\n    min-height: 24px;\n\n    font-size: 13px;\n  }\n\n  hndrd-retail-preview .hn-attribution-content {\n    bottom: 32px;\n    max-width: min(215px, 67vw);\n  }\n\n  /* Small zoom controls */\n\n  hndrd-retail-preview .maplibregl-ctrl-top-right {\n    top: 8px;\n    right: 8px;\n  }\n\n  hndrd-retail-preview .maplibregl-ctrl-group button {\n    width: 29px;\n    height: 29px;\n  }\n\n  /* Popup */\n\n  hndrd-retail-preview .maplibregl-popup-content {\n    max-width: calc(100vw - 75px);\n    padding: 14px;\n    border-radius: 13px;\n  }\n}\n\n/* SMALL PHONES */\n\n@media (max-width: 380px) {\n\n  hndrd-retail-preview {\n    padding: 14px 9px;\n  }\n\n  hndrd-retail-preview .hn-layout {\n    padding: 20px 14px 14px;\n  }\n\n  hndrd-retail-preview .hn-title {\n    font-size: 34px;\n  }\n\n  hndrd-retail-preview .hn-map-shell {\n    height: 245px;\n    min-height: 245px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  hndrd-retail-preview *,\n  hndrd-retail-preview *::before,\n  hndrd-retail-preview *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n/* ==========================================\n   HNDRD GIVEAWAY — COLOUR CONSISTENCY\n========================================== */\n\n/* SECTION BACKGROUND */\n\nhndrd-retail-preview {\n  --hn-accent: #FFA300;\n\n  background: #FFFAF0 !important;\n}\n\n/* PRIMARY CTA */\n\nhndrd-retail-preview .hn-primary,\nhndrd-retail-preview .hn-primary:link,\nhndrd-retail-preview .hn-primary:visited,\nhndrd-retail-preview .hn-primary:hover,\nhndrd-retail-preview .hn-primary:active {\n  background: #FFA300 !important;\n  color: #FFFFFF !important;\n  border-color: #FFA300 !important;\n}\n\n/* KEEP CTA TEXT AND ARROW WHITE */\n\nhndrd-retail-preview .hn-primary span,\nhndrd-retail-preview .hn-primary svg {\n  color: #FFFFFF !important;\n  stroke: currentColor;\n}\n\n/* NO COLOUR CHANGE ON HOVER */\n\nhndrd-retail-preview .hn-primary:hover {\n  background: #FFA300 !important;\n  transform: translateY(-1px);\n}\n\n/* MOBILE */\n\n@media (max-width: 767px) {\n  hndrd-retail-preview {\n    background: #FFFAF0 !important;\n  }\n\n  hndrd-retail-preview .hn-primary {\n    background: #FFA300 !important;\n    color: #FFFFFF !important;\n  }\n}\n/* ==========================================\n   HNDRD PREMIUM GLASS CTA\n   WHITE PILL + ORANGE ARROW\n========================================== */\n\nhndrd-retail-preview .hn-primary,\nhndrd-retail-preview .hn-primary:link,\nhndrd-retail-preview .hn-primary:visited {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 30px;\n\n  min-width: 258px;\n  min-height: 58px;\n  padding: 7px 8px 7px 25px;\n\n  background: rgba(255,255,255,.78) !important;\n  color: #111111 !important;\n\n  border: 1px solid rgba(0,0,0,