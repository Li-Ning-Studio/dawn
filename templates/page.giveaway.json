        "custom_liquid": "{% comment %}\n  HNDRD NITRIX 80 BULLET\n  HOW TO ENTER\n  Apple-style premium glassmorphism version\n{% endcomment %}\n\n<style>\n@font-face {\n  font-family: 'HN-Figtree';\n  src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'HN-Figtree';\n  src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'HN-Figtree';\n  src: url(\"{{ 'Figtree-ExtraBold.ttf' | file_url }}\") format('truetype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n.hndrd-apple-how,\n.hndrd-apple-how *,\n.hndrd-apple-how *::before,\n.hndrd-apple-how *::after {\n  box-sizing: border-box;\n}\n\n.hndrd-apple-how {\n  --hn-orange: #FFA300;\n  --hn-black: #000000;\n  --hn-grey: #444445;\n  --hn-soft: rgba(255,255,255,0.50);\n  --hn-border: rgba(255,255,255,0.90);\n  --hn-line: rgba(0,0,0,0.08);\n\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n  background: #ededed;\n  padding: 28px 5%;\n  color: var(--hn-black);\n  font-family: 'HN-Figtree', 'Figtree', Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\n.hndrd-apple-how::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(500px 260px at 8% 8%, rgba(255,163,0,0.12), transparent 70%),\n    radial-gradient(420px 220px at 92% 10%, rgba(255,255,255,0.45), transparent 68%);\n}\n\n.hndrd-apple-how-inner {\n  position: relative;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n/* HEADER */\n\n.hndrd-apple-how-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 24px;\n  margin-bottom: 22px;\n}\n\n.hndrd-apple-how-title {\n  margin: 0;\n  font-size: clamp(34px, 3.8vw, 56px);\n  font-weight: 800;\n  line-height: 1.08;\n  letter-spacing: -1.5px;\n  text-transform: uppercase;\n  color: #000;\n}\n\n.hndrd-apple-how-title span {\n  color: var(--hn-orange);\n}\n\n.hndrd-apple-how-sub {\n  max-width: 350px;\n  margin: 0 0 4px;\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--hn-grey);\n}\n\n/* MAIN GLASS WRAP */\n\n.hndrd-apple-how-shell {\n  position: relative;\n  overflow: hidden;\n  border-radius: 28px;\n  border: 1px solid var(--hn-border);\n  background: rgba(255,255,255,0.42);\n  -webkit-backdrop-filter: blur(24px) saturate(150%);\n  backdrop-filter: blur(24px) saturate(150%);\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,0.95),\n    0 14px 34px rgba(0,0,0,0.05),\n    0 3px 10px rgba(0,0,0,0.03);\n}\n\n.hndrd-apple-how-shell::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: linear-gradient(\n    130deg,\n    rgba(255,255,255,0.36) 0%,\n    rgba(255,255,255,0.08) 48%,\n    rgba(255,255,255,0.02) 100%\n  );\n}\n\n/* TOP INFO BAR */\n\n.hndrd-apple-how-topbar {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 20px 28px;\n  border-bottom: 1px solid var(--hn-line);\n}\n\n.hndrd-apple-how-topbar-text {\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--hn-grey);\n}\n\n.hndrd-apple-how-cap {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 8px;\n  white-space: nowrap;\n}\n\n.hndrd-apple-how-cap strong {\n  font-size: 34px;\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -1.2px;\n  color: #000;\n}\n\n.hndrd-apple-how-cap span {\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--hn-grey);\n}\n\n/* CARD GRID */\n\n.hndrd-apple-how-grid {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0;\n}\n\n.hndrd-apple-how-card {\n  position: relative;\n  min-width: 0;\n  padding: 28px 26px 30px;\n}\n\n.hndrd-apple-how-card + .hndrd-apple-how-card {\n  border-left: 1px solid var(--hn-line);\n}\n\n.hndrd-apple-how-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity .25s ease;\n  background: linear-gradient(\n    180deg,\n    rgba(255,255,255,0.14),\n    rgba(255,255,255,0.03)\n  );\n}\n\n.hndrd-apple-how-card:hover::after {\n  opacity: 1;\n}\n\n/* CARD TOP */\n\n.hndrd-apple-how-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  margin-bottom: 18px;\n}\n\n.hndrd-apple-how-step {\n  font-size: 30px;\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -1px;\n  color: var(--hn-orange);\n}\n\n.hndrd-apple-how-icon {\n  width: 30px;\n  height: 30px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: #000;\n}\n\n.hndrd-apple-how-icon svg {\n  width: 26px;\n  height: 26px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* CARD TEXT */\n\n.hndrd-apple-how-card-title {\n  margin: 0 0 8px;\n  font-size: clamp(20px, 1.7vw, 24px);\n  font-weight: 700;\n  line-height: 1.2;\n  letter-spacing: -0.4px;\n  text-transform: uppercase;\n  color: #000;\n}\n\n.hndrd-apple-how-card-subtitle {\n  margin: 0 0 14px;\n  font-size: 12px;\n  font-weight: 800;\n  line-height: 1.4;\n  text-transform: uppercase;\n  letter-spacing: .03em;\n  color: var(--hn-orange);\n}\n\n.hndrd-apple-how-card-desc {\n  margin: 0;\n  font-size: 13px;\n  line-height: 1.7;\n  color: var(--hn-grey);\n}\n\n/* TASK LIST */\n\n.hndrd-apple-how-list {\n  margin-top: 18px;\n  border-top: 1px solid var(--hn-line);\n}\n\n.hndrd-apple-how-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 14px;\n  padding: 16px 0;\n}\n\n.hndrd-apple-how-item + .hndrd-apple-how-item {\n  border-top: 1px solid var(--hn-line);\n}\n\n.hndrd-apple-how-item-text {\n  min-width: