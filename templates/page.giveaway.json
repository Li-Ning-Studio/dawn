      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD NITRIX 80 BULLET Ultimate Giveaway - Section 4: Ready to enter? (orange call-to-action)\n  Paste this whole file into a Shopify \"Custom Liquid\" section. Nothing else is needed.\n{% endcomment %}\n{% comment %} EDIT THIS {% endcomment %}\n{% assign hn_form_url = 'https://forms.gle/vUTcGrcT1Ri7NH5S9' %}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\">\n<style>\n.hn-sec { --fg:#1D1D1F; --fg-2:#6E6E73; --fg-3:#A1A1A6; --hot:#F2480F; --hot-hi:#FF6A33; --glass:rgba(255,255,255,.55); --glass-edge:rgba(255,255,255,.95); --hair:rgba(29,29,31,.09); --shadow:0 1px 0 rgba(255,255,255,.95) inset, 0 24px 60px -24px rgba(29,29,31,.22), 0 1px 3px rgba(29,29,31,.05); --f:-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Inter\", \"Helvetica Neue\", Arial, sans-serif; position:relative; isolation:isolate; overflow:hidden; background:#fff; color:var(--fg); font:400 16px/1.5 var(--f); letter-spacing:-.01em; -webkit-font-smoothing:antialiased; padding-left:max(16px, env(safe-area-inset-left, 0px)); padding-right:max(16px, env(safe-area-inset-right, 0px)); }\n.hn-sec *, .hn-sec *::before, .hn-sec *::after { box-sizing:border-box; }\n.hn-sec h1, .hn-sec h2, .hn-sec h3, .hn-sec p, .hn-sec figure, .hn-sec ul { margin:0; padding:0; font-family:inherit; color:inherit; text-transform:none; }\n.hn-sec a { color:inherit; }\n.hn-sec :focus-visible { outline:3px solid rgba(242,72,15,.45); outline-offset:3px; border-radius:10px; }\n.hn-inner { max-width:1120px; margin:0 auto; }\n.hn-glass { position:relative; background:var(--glass); -webkit-backdrop-filter:blur(30px) saturate(190%); backdrop-filter:blur(30px) saturate(190%); border:1px solid var(--glass-edge); box-shadow:var(--shadow); }\n.hn-glass::after { content:\"\"; position:absolute; inset:0; border-radius:inherit; pointer-events:none; opacity:0; transition:opacity .4s ease; background:radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.75), rgba(255,160,120,.14) 45%, rgba(255,160,120,0) 72%); }\n.hn-glass:hover::after { opacity:1; }\n.hn-btn { display:inline-flex; align-items:center; justify-content:center; height:50px; padding:0 28px; border-radius:999px; font:600 16px/1 var(--f); letter-spacing:-.01em; text-decoration:none; border:0; cursor:pointer; transition:transform .2s ease, box-shadow .2s ease, background .2s ease; }\n.hn-btn:active { transform:scale(.97); }\n.hn-btn-hot { background:var(--hot); color:#fff !important; box-shadow:0 10px 24px -10px rgba(242,72,15,.7); }\n.hn-btn-hot:hover { background:var(--hot-hi); transform:translateY(-1px); }\n.hn-btn-glass { background:rgba(255,255,255,.7); color:var(--fg); border:1px solid var(--glass-edge); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); box-shadow:0 1px 0 #fff inset, 0 8px 20px -10px rgba(29,29,31,.28); }\n.hn-btn-glass:hover { background:#fff; transform:translateY(-1px); }\n.hn-h2 { font-weight:800; font-size:clamp(32px, 4.4vw, 52px); line-height:1.04; letter-spacing:-.04em; text-wrap:balance; }\n.hn-js .hn-rv { opacity:0; transform:translateY(26px); filter:blur(6px); transition:opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1), filter .9s cubic-bezier(.2,.7,.2,1); }\n.hn-js .hn-rv.hn-in { opacity:1; transform:none; filter:none; }\n.hn-enter-sec { padding-top:56px; padding-bottom:56px; }\n.hn-enter { position:relative; display:flex; align-items:center; justify-content:space-between; gap:32px; flex-wrap:wrap; padding:56px; border-radius:36px; overflow:hidden; color:#fff; background:var(--hot); box-shadow:0 1px 0 rgba(255,255,255,.45) inset, 0 36px 70px -34px rgba(242,72,15,.7); isolation:isolate; will-change:transform; transform-origin:50% 60%; }\n.hn-enter::before { content:\"\"; position:absolute; width:480px; height:480px; right:-80px; top:-240px; border-radius:50%; background:rgba(255,255,255,.2); filter:blur(34px); z-index:-1; }\n.hn-enter .hn-h2 { color:#fff; max-width:14ch; }\n.hn-enter p { margin-top:12px; font-size:17px; color:rgba(255,255,255,.92); max-width:36ch; }\n.hn-side { display:flex; flex-direction:column; align-items:flex-start; gap:10px; }\n.hn-enter .hn-btn { background:#fff; color:var(--hot) !important; box-shadow:0 14px 30px -14px rgba(0,0,0,.4); }\n.hn-enter small { font-size:13px; color:rgba(255,255,255,.85); }\n@media (max-width: 700px) {\n  .hn-enter-sec { padding-top:44px; padding-bottom:44px; }\n  .hn-enter { flex-direction:column; align-items:flex-start; gap:24px; padding:44px 26px; border-radius:32px; }\n  .hn-enter .hn-h2 { font-size:40px; max-width:10ch; }\n  .hn-enter p { font-size:16px; }\n  .hn-side { width:100%; align-items:stretch; text-align:center; }\n  .hn-enter .hn-btn { width:100%; }\n}\n</style>\n<section class=\"hn-sec hn-enter-sec\" id=\"hn-enter\">\n  <div class=\"hn-inner\">\n    <div class=\"hn-enter\" id=\"hn-enter-card\">\n      <div>\n        <h2 class=\"hn-h2\">Ready to enter?</h2>\n        <p>Don't miss your chance to win. Enter the HNDRD NITRIX 80 BULLET Ultimate Giveaway today.</p>\n      </div>\n      <div class=\"hn-side\">\n        <a class=\"hn-btn\" href=\"{{ hn_form_url }}\" target=\"_blank\" rel=\"noopener\">Enter giveaway</a>\n        <small>No purchase necessary</small>\n      </div>\n    </div>\n  </div>\n</section>\n<script>\n(function () {\n  var card = document.getElementById('hn-enter-card'); if (!card) return;\n  if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };\n  function frame() { var vh = window.innerHeight, r = card.getBoundingClientRect(); var t = clamp((vh - r.top) / (vh * .85), 0, 1); card.style.transform = 'scale(' + (.9 + .1 * (1 - Math.pow(1 - t, 3))) + ')'; }\n  var tk = false; window.addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(function () { tk = false; frame(); }); } }, { passive: true }); window.addEventListener('resize', frame); frame();\n})();\n</script>",
