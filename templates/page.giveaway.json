reens */\n\nhndrd-retail-preview .hn-layout {\n  background: transparent !important;\n  border: none !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n}\n\n/* Keep the map as the only card */\n\nhndrd-retail-preview .hn-map-shell {\n  background: #ffffff !important;\n  border: 1px solid rgba(0, 0, 0, .08) !important;\n  border-radius: 22px !important;\n  overflow: hidden !important;\n  box-shadow: 0 12px 32px rgba(0, 0, 0, .06) !important;\n}\n\n/* Desktop: text left, map right */\n\n@media (min-width: 768px) {\n  hndrd-retail-preview .hn-layout {\n    display: grid !important;\n    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr) !important;\n    align-items: center !important;\n    gap: clamp(40px, 6vw, 90px) !important;\n    padding: 30px 0 !important;\n  }\n\n  hndrd-retail-preview .hn-content {\n    display: block !important;\n    text-align: left !important;\n  }\n\n  hndrd-retail-preview .hn-eyebrow {\n    justify-content: flex-start !important;\n  }\n\n  hndrd-retail-preview .hn-title,\n  hndrd-retail-preview .hn-description {\n    text-align: left !important;\n  }\n\n  hndrd-retail-preview .hn-description {\n    margin-left: 0 !important;\n    margin-right: 0 !important;\n  }\n\n  hndrd-retail-preview .hn-primary {\n    margin-left: 0 !important;\n  }\n}\n\n/* Mobile: centered content, map below */\n\n@media (max-width: 767px) {\n  hndrd-retail-preview .hn-layout {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 28px !important;\n    padding: 0 !important;\n  }\n\n  hndrd-retail-preview .hn-content {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center !important;\n  }\n\n  hndrd-retail-preview .hn-eyebrow {\n    justify-content: center !important;\n  }\n\n  hndrd-retail-preview .hn-title,\n  hndrd-retail-preview .hn-description {\n    text-align: center !important;\n  }\n\n  hndrd-retail-preview .hn-map-shell {\n    border-radius: 18px !important;\n    box-shadow: none !important;\n  }\n}\n\n/* HNDRD RETAIL CTA — MATCH ENTRY BUTTON */\n\nhndrd-retail-preview .hn-primary,\nhndrd-retail-preview .hn-primary:link,\nhndrd-retail-preview .hn-primary:visited {\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n\n  width: min(100%, 340px) !important;\n  min-width: 0 !important;\n  min-height: 60px !important;\n\n  padding: 7px 8px 7px 25px !important;\n  gap: 20px !important;\n\n  background: #F7F8FA !important;\n  color: #111111 !important;\n\n  border: 1px solid #DFE2E7 !important;\n  border-radius: 999px !important;\n\n  box-shadow: 0 10px 25px rgba(0,0,0,.045) !important;\n\n  text-decoration: none !important;\n  transform: none !important;\n}\n\n/* BLACK UPPERCASE TEXT */\n\nhndrd-retail-preview .hn-primary span {\n  color: #111111 !important;\n  font-size: 14px !important;\n  font-weight: 800 !important;\n  letter-spacing: 0 !important;\n  text-transform: uppercase !important;\n  white-space: nowrap;\n}\n\n/* ORANGE CIRCULAR ARROW */\n\nhndrd-retail-preview .hn-primary svg {\n  width: 46px !important;\n  height: 46px !important;\n  min-width: 46px !important;\n\n  padding: 12px !important;\n  border-radius: 50% !important;\n\n  background: #FFA300 !important;\n  color: #111111 !important;\n  stroke: #111111 !important;\n}\n\n/* KEEP SAME COLOUR ON HOVER */\n\nhndrd-retail-preview .hn-primary:hover {\n  background: #F7F8FA !important;\n  color: #111111 !important;\n  border-color: #DFE2E7 !important;\n  box-shadow: 0 10px 25px rgba(0,0,0,.045) !important;\n  transform: none !important;\n}\n\n/* MOBILE */\n\n@media (max-width: 767px) {\n  hndrd-retail-preview .hn-primary {\n    width: min(100%, 340px) !important;\n    min-height: 60px !important;\n    padding: 7px 8px 7px 22px !important;\n  }\n\n  hndrd-retail-preview .hn-primary span {\n    font-size: 13px !important;\n  }\n\n  hndrd-retail-preview .hn-primary svg {\n    width: 46px !important;\n    height: 46px !important;\n    min-width: 46px !important;\n  }\n}\n\n\n</style>\n\n<hndrd-retail-preview>\n\n  <div class=\"hn-container\">\n\n    <div class=\"hn-layout\">\n\n      <!-- TEXT -->\n\n      <div class=\"hn-content\">\n\n        <div class=\"hn-eyebrow\">\n          HNDRD retail network\n        </div>\n\n        <h2 class=\"hn-title\">\n          FIND HNDRD<br>\n          <span>NEAR YOU.</span>\n        </h2>\n\n        <p class=\"hn-description\">\n          Find your nearest HNDRD retailer\n          and explore our products in person.\n        </p>\n\n        <a\n          href=\"{{ hn_locator_url }}\"\n          class=\"hn-primary\"\n        >\n          <span>FIND A RETAILER</span>\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M5 12h14\"/>\n            <path d=\"m13 6 6 6-6 6\"/>\n          </svg>\n        </a>\n\n      </div>\n\n      <!-- MAP -->\n\n      <div class=\"hn-map-shell\">\n\n        <div\n          class=\"hn-map\"\n          role=\"region\"\n          aria-label=\"Interactive map of HNDRD USA retailers\"\n        ></div>\n\n        <div class=\"hn-map-status\" role=\"status\">\n          Loading retailer map…\n        </div>\n\n        <!-- CUSTOM ATTRIBUTION -->\n\n        <div class=\"hn-attribution\">\n\n          <button\n            type=\"button\"\n            class=\"hn-attribution-toggle\"\n            aria-label=\"Show map attribution\"\n            aria-expanded=\"false\"\n            aria-controls=\"hn-map-attribution-{{ section.id }}\"\n          >i</button>\n\n          <div\n            id=\"hn-map-attribution-{{ section.id }}\"\n            class=\"hn-attribution-content\"\n            hidden\n          >\n            <span class=\"hn-attribution-title\">\n              Map information\n            </span>\n\n            <a\n              href=\"https://openfreemap.org/\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n            >OpenFreeMap</a>\n\n            ·\n\n            <a\n              href=\"https://openmaptiles.org/\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n            >OpenMapTiles</a>\n\n            <div>\n              ©\n              <a\n                href=\"https://www.openstreetmap.org/copyright\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >OpenStreetMap contributors</a>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- FULL LOCATOR -->\n\n        <a\n          class=\"hn-map-link\"\n          href=\"{{ hn_locator_url }}\"\n        >\n          Explore full map\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M7 17 17 7\"/>\n            <path d=\"M8 7h9v9\"/>\n          </svg>\n        </a>\n\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- RETAILER DATA -->\n\n  {% paginate shop.metaobjects.hndrd_retail_location.values by 250 %}\n    <script type=\"application/json\" data-hn-preview-stores>\n    [\n      {% for store in shop.metaobjects.hndrd_retail_location.values %}\n      {\n        \"name\": {{ store.name.value | json }},\n        \"address1\": {{ store.address_line_1.value | json }},\n        \"address2\": {{ store.address_line_2.value | json }},\n        \"city\": {{ store.city.value | json }},\n        \"state\": {{ store.state.value | json }},\n        \"zip\": {{ store.zip.value | json }},\n        \"website\": {{ store.website.value | json }},\n        \"lat\": {{ store.latitude.value | json }},\n        \"lon\": {{ store.longitude.value | json }},\n        \"enabled\": {{ store.enabled.value | json }}\n      }{% unless forloop.last %},{% endunless %}\n      {% endfor %}\n    ]\n    </script>\n  {% endpaginate %}\n\n</hndrd-retail-preview>\n\n<script>\n(() => {\n  'use strict';\n\n  const TAG = 'hndrd-retail-preview';\n\n  if (customElements.get(TAG)) return;\n\n  let libraryPromise = null;\n\n  function loadMapLibre() {\n    if (window.maplibregl) {\n      return Promise.resolve(window.maplibregl);\n    }\n\n    if (libraryPromise) return libraryPromise;\n\n    libraryPromise = new Promise((resolve, reject) => {\n      const script = document.createElement('script');\n\n      script.src =\n        'https://cdn.jsdelivr.net/npm/maplibre-gl@5.12.0/dist/maplibre-gl.js';\n\n      script.async = true;\n\n      script.onload = () => {\n        if (window.maplibregl) {\n          resolve(window.maplibregl);\n        } else {\n          reject(new Error('MapLibre unavailable'));\n        }\n      };\n\n      script.onerror = () => {\n        reject(new Error('MapLibre failed to load'));\n      };\n\n      document.head.appendChild(script);\n    }).catch(error => {\n      libraryPromise = null;\n      throw error;\n    });\n\n    return libraryPromise;\n  }\n\n  function coordinate(value, max) {\n    if (\n      value === null ||\n      value === undefined ||\n      String(value).trim() === ''\n    ) return null;\n\n    const number = Number(value);\n\n    return Number.isFinite(number) && Math.abs(number) <= max\n      ? number\n      : null;\n  }\n\n  function safeUrl(value) {\n    try {\n      const url = new URL(value);\n\n      return ['https:', 'http:'].includes(url.protocol)\n        ? url.href\n        : '';\n    } catch {\n      return '';\n    }\n  }\n\n  function address(store) {\n    return [\n      store.address1,\n      store.address2,\n      store.city,\n      [store.state, store.zip].filter(Boolean).join(' ')\n    ].filter(Boolean).join(', ');\n  }\n\n  function directions(store) {\n    return 'https://www.google.com/maps/dir/?' +\n      new URLSearchParams({\n        api: '1',\n        destination: [\n          store.name,\n          address(store),\n          'USA'\n        ].filter(Boolean).join(', '),\n        travelmode: 'driving'\n      });\n  }\n\n  class HNRetailPreview extends HTMLElement {\n\n    connectedCallback() {\n      if (this.initialized) return;\n\n      this.initialized = true;\n\n      this.canvas = this.querySelector('.hn-map');\n      this.status = this.querySelector('.hn-map-status');\n\n      /* ATTRIBUTION DISCLOSURE */\n\n      this.infoButton = this.querySelector(\n        '.hn-attribution-toggle'\n      );\n\n      this.infoPanel = this.querySelector(\n        '.hn-attribution-content'\n      );\n\n      /* Always close on initialization */\n\n      this.closeAttribution();\n\n      this.onInfoClick = event => {\n        event.stopPropagation();\n\n        const isOpen = !this.infoPanel.hidden;\n\n        if (isOpen) {\n          this.closeAttribution();\n        } else {\n          this.openAttribution();\n        }\n      };\n\n      this.onOutsideClick = event => {\n        if (!this.querySelector('.hn-attribution').contains(event.target)) {\n          this.closeAttribution();\n        }\n      };\n\n      this.onKeyDown = event => {\n        if (event.key === 'Escape') {\n          this.closeAttribution();\n        }\n      };\n\n      this.infoButton.addEventListener(\n        'click',\n        this.onInfoClick\n      );\n\n      document.addEventListener(\n        'click',\n        this.onOutsideClick\n      );\n\n      document.addEventListener(\n        'keydown',\n        this.onKeyDown\n      );\n\n      /* STORES */\n\n      try {\n        const data = JSON.parse(\n          this.querySelector('[data-hn-preview-stores]')\n            ?.textContent || '[]'\n        );\n\n        this.stores = data\n          .filter(s => s.enabled !== false && s.enabled !== 'false')\n          .map(s => ({\n            ...s,\n            lat: coordinate(s.lat, 90),\n            lon: coordinate(s.lon, 180),\n            website: safeUrl(s.website)\n          }))\n          .filter(s =>\n            s.name &&\n            s.lat !== null &&\n            s.lon !== null\n          );\n\n      } catch {\n        this.stores = [];\n      }\n\n      if (!this.stores.length) {\n        this.showError(\n          'No mapped retailers are available. Open the full locator to browse stores.'\n        );\n        return;\n      }\n\n      if ('IntersectionObserver' in window) {\n        this.visibilityObserver = new IntersectionObserver(\n          entries => {\n            if (entries.some(entry => entry.isIntersecting)) {\n              this.visibilityObserver.disconnect();\n              this.initMap();\n            }\n          },\n          { rootMargin: '250px' }\n        );\n\n        this.visibilityObserver.observe(this);\n      } else {\n        this.initMap();\n      }\n    }\n\n    openAttribution() {\n      if (!this.infoPanel || !this.infoButton) return;\n\n      this.infoPanel.hidden = false;\n      this.infoButton.setAttribute('aria-expanded', 'true');\n      this.infoButton.setAttribute(\n        'aria-label',\n        'Hide map attribution'\n      );\n    }\n\n    closeAttribution() {\n      if (!this.infoPanel || !this.infoButton) return;\n\n      this.infoPanel.hidden = true;\n      this.infoButton.setAttribute('aria-expanded', 'false');\n      this.infoButton.setAttribute(\n        'aria-label',\n        'Show map attribution'\n      );\n    }\n\n    disconnectedCallback() {\n      this.visibilityObserver?.disconnect();\n      this.resizeObserver?.disconnect();\n\n      this.infoButton?.removeEventListener(\n        'click',\n        this.onInfoClick\n      );\n\n      document.removeEventListener(\n        'click',\n        this.onOutsideClick\n      );\n\n      document.removeEventListener(\n        'keydown',\n        this.onKeyDown\n      );\n\n      this.map?.remove();\n      this.map = null;\n      this.initialized = false;\n    }\n\n    showError(message) {\n      this.status.textContent = message;\n      this.status.hidden = false;\n    }\n\n    async initMap() {\n      if (this.map || this.mapStarting) return;\n\n      this.mapStarting = true;\n\n      try {\n        const lib = await loadMapLibre();\n\n        if (!this.isConnected) return;\n\n        const features = this.stores.map((store, index) => ({\n          type: 'Feature',\n          geometry: {\n            type: 'Point',\n            coordinates: [store.lon, store.lat]\n          },\n          properties: {\n            index\n          }\n        }));\n\n        const map = this.map = new lib.Map({\n          container: this.canvas,\n\n          style:\n            'https://tiles.openfreemap.org/styles/positron',\n\n          center: [-98.5, 38.5],\n          zoom: 3,\n\n          minZoom: 2,\n          maxZoom: 18,\n\n          attributionControl: false,\n\n          dragRotate: false,\n          pitchWithRotate: false,\n          renderWorldCopies: false\n        });\n\n        map.touchZoomRotate.disableRotation();\n        map.scrollZoom.disable();\n\n        map.addControl(\n          new lib.NavigationControl({\n            showCompass: false\n          }),\n          'top-right'\n        );\n\n        /* No native attribution control.\n           Our custom info disclosure handles it. */\n\n        if ('ResizeObserver' in window) {\n          this.resizeObserver = new ResizeObserver(() => {\n            map.resize();\n          });\n\n          this.resizeObserver.observe(this.canvas);\n        }\n\n        map.on('load', () => {\n          if (!this.isConnected || this.map !== map) return;\n\n          map.addSource('hn-retailers', {\n            type: 'geojson',\n            data: {\n              type: 'FeatureCollection',\n              features\n            },\n            cluster: true,\n            clusterRadius: 43,\n            clusterMaxZoom: 11\n          });\n\n          map.addLayer({\n            id: 'hn-clusters',\n            type: 'circle',\n            source: 'hn-retailers',\n            filter: ['has', 'point_count'],\n            paint: {\n              'circle-color': '#111114',\n              'circle-radius': [\n                'step',\n                ['get', 'point_count'],\n                17,\n                10, 20,\n                35, 24\n              ],\n              'circle-stroke-color': '#fff',\n              'circle-stroke-width': 2\n            }\n          });\n\n          map.addLayer({\n            id: 'hn-cluster-labels',\n            type: 'symbol',\n            source: 'hn-retailers',\n            filter: ['has', 'point_count'],\n            layout: {\n              'text-field': ['get', 'point_count_abbreviated'],\n              'text-size': 12\n            },\n            paint: {\n              'text-color': '#fff'\n            }\n          });\n\n          map.addLayer({\n            id: 'hn-stores',\n            type: 'circle',\n            source: 'hn-retailers',\n            filter: ['!', ['has', 'point_count']],\n            paint: {\n              'circle-color': '#FFA300',\n              'circle-radius': 7,\n              'circle-stroke-color': '#111114',\n              'circle-stroke-width': 1.5\n            }\n          });\n\n          /* STORE POPUPS */\n\n          map.on('click', 'hn-stores', event => {\n            const feature = event.features?.[0];\n            if (!feature) return;\n\n            const store = this.stores[\n              Number(feature.properties.index)\n            ];\n\n            if (!store) return;\n\n            const popup = document.createElement('div');\n\n            const name = document.createElement('h3');\n            name.className = 'hn-store-name';\n            name.textContent = store.name;\n\n            const location = document.createElement('p');\n            location.className = 'hn-store-address';\n            location.textContent = address(store);\n\n            const links = document.createElement('div');\n            links.className = 'hn-store-links';\n\n            const directionLink = document.createElement('a');\n            directionLink.href = directions(store);\n            directionLink.target = '_blank';\n            directionLink.rel = 'noopener noreferrer';\n            directionLink.textContent = 'Directions';\n\n            links.appendChild(directionLink);\n\n            if (store.website) {\n              const websiteLink = document.createElement('a');\n\n              websiteLink.href = store.website;\n              websiteLink.target = '_blank';\n              websiteLink.rel = 'noopener noreferrer';\n              websiteLink.textContent = 'Website';\n\n              links.appendChild(websiteLink);\n            }\n\n            popup.append(name, location, links);\n\n            new lib.Popup({\n              offset: 14,\n              closeButton: true,\n              maxWidth: '260px'\n            })\n              .setLngLat(feature.geometry.coordinates)\n              .setDOMContent(popup)\n              .addTo(map);\n          });\n\n          /* CLUSTER CLICK */\n\n          map.on('click', 'hn-clusters', async event => {\n            const feature = event.features?.[0];\n\n            if (!feature) return;\n\n            const source = map.getSource('hn-retailers');\n\n            try {\n              const zoom =\n                await source.getClusterExpansionZoom(\n                  feature.properties.cluster_id\n                );\n\n              map.easeTo({\n                center: feature.geometry.coordinates,\n                zoom,\n                duration: window.matchMedia(\n                  '(prefers-reduced-motion: reduce)'\n                ).matches ? 0 : 400\n              });\n            } catch {\n              /* Keep map position */\n            }\n          });\n\n          /* POINTER */\n\n          ['hn-stores', 'hn-clusters'].forEach(layer => {\n            map.on('mouseenter', layer, () => {\n              map.getCanvas().style.cursor = 'pointer';\n            });\n\n            map.on('mouseleave', layer, () => {\n              map.getCanvas().style.cursor = '';\n            });\n          });\n\n          /* FIT USA STORE LOCATIONS */\n\n          const bounds = new lib.LngLatBounds();\n\n          this.stores.forEach(store => {\n            bounds.extend([store.lon, store.lat]);\n          });\n\n          map.resize();\n\n          map.fitBounds(bounds, {\n            padding: window.innerWidth <= 767 ? 24 : 35,\n            maxZoom: this.stores.length === 1 ? 11 : 4.5,\n            duration: 0\n          });\n\n          this.status.hidden = true;\n        });\n\n      } catch (error) {\n        if (this.isConnected) {\n          this.showError(\n            'Map could not load. Use Explore full map to find a retailer.'\n          );\n        }\n      } finally {\n        this.mapStarting = false;\n      }\n    }\n  }\n\n  customElements.define(TAG, HNRetailPreview);\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_VEz8WA": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign hn_rules_url = 'https://us.hndrd.co/pages/official-sweepstakes-rules' %}\n{% assign hn_instagram_url = 'https://www.instagram.com/hndrd.us?vrfl=MTY3a3FzdHZ0bmlnYQ%3D%3D&utm_source=qr' %}\n\n<style>\n  @font-face {\n    font-family: 'HN-Footer-Figtree';\n    src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n    font-weight: 400;\n    font-display: swap;\n  }\n  @font-face {\n    font-family: 'HN-Footer-Figtree';\n    src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n    font-weight: 700;\n    font-display: swap;\n  }\n  .hn-giveaway-legal, .hn-giveaway-legal * { box-sizing:border-box; }\n  .hn-giveaway-legal {\n    --hn-orange:#FFA300;\n    --hn-black:#171717;\n    --hn-muted:#77736D;\n    position:relative;\n    isolation:isolate;\n    background:#FFFAF0;\n    padding:50px 22px 64px;\n    font-family:'HN-Footer-Figtree',Figtree,Arial,sans-serif;\n    -webkit-font-smoothing:antialiased;\n  }\n  .hn-giveaway-legal__shell {\n    max-width:1060px;\n    margin:0 auto;\n    padding:36px 44px 30px;\n    border:1px solid rgba(135,105,45,.12);\n    border-radius:26px;\n    background:linear-gradient(140deg,rgba(255,255,255,.73),rgba(255,250,240,.50));\n    box-shadow:0 16px 44px rgba(88,65,27,.045),inset 0 1px 0 rgba(255,255,255,.78);\n    -webkit-backdrop-filter:blur(18px) saturate(135%);\n    backdrop-filter:blur(18px) saturate(135%);\n  }\n  .hn-giveaway-legal__topline {\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:9px;\n    margin-bottom:16px;\n    color:#77736D;\n    font-size:10px;\n    font-weight:700;\n    line-height:1.5;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n  }\n  .hn-giveaway-legal__topline::before {\n    content:'';\n    display:block;\n    width:6px;\n    height:6px;\n    border-radius:50%;\n    background:var(--hn-orange);\n  }\n  .hn-giveaway-legal__notice {\n    max-width:680px;\n    margin:0 auto;\n    color:var(--hn-black);\n    font-size:clamp(13px,1.5vw,16px);\n    font-weight:700;\n    line-height:1.55;\n    letter-spacing:-.012em;\n    text-align:center;\n  }\n  .hn-giveaway-legal__links {\n    display:flex;\n    flex-wrap:wrap;\n    align-items:center;\n    justify-content:center;\n    gap:10px;\n    margin-top:27px;\n  }\n  .hn-giveaway-legal .hn-giveaway-legal__link,\n  .hn-giveaway-legal .hn-giveaway-legal__link:visited {\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    gap:10px;\n    min-height:45px;\n    padding:11px 20px;\n    border:1px solid rgba(135,105,45,.16);\n    border-radius:999px;\n    background:rgba(255,255,255,.64);\n    box-shadow:0 2px 8px rgba(0,0,0,.018);\n    color:#242424;\n    font-family:inherit;\n    font-size:12px;\n    font-weight:700;\n    line-height:1.2;\n    text-decoration:none;\n    transition:background .18s ease,border-color .18s ease,box-shadow .18s ease;\n  }\n  .hn-giveaway-legal .hn-giveaway-legal__link--rules {\n    background:#FFA300;\n    border-color:#FFA300;\n    color:#171717;\n  }\n  .hn-giveaway-legal__link svg {\n    display:block;\n    width:17px;\n    height:17px;\n    flex:none;\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.8;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n  .hn-giveaway-legal__link:focus-visible { outline:2px solid var(--hn-orange); outline-offset:3px; }\n  .hn-giveaway-legal__bottom {\n    margin:27px auto 0;\n    padding-top:17px;\n    border-top:1px solid rgba(135,105,45,.12);\n    color:#898989;\n    font-size:10px;\n    line-height:1.5;\n    text-align:center;\n    letter-spacing:.02em;\n  }\n  @media(hover:hover) {\n    .hn-giveaway-legal .hn-giveaway-legal__link:hover { border-color:rgba(23,23,23,.25); background:#fff; box-shadow:0 4px 12px rgba(0,0,0,.045); }\n    .hn-giveaway-legal .hn-giveaway-legal__link--rules:hover { background:#f2a000; border-color:#f2a000; color:#171717; }\n  }\n  @media(max-width:749px) {\n    .hn-giveaway-l