items: center;\n  gap: 10px;\n}\n\n.hn-legal-instagram svg {\n  width: 22px;\n  height: 22px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.hn-legal-instagram span {\n  font-weight: 700;\n}\n\n/* MOBILE */\n\n@media (max-width: 767px) {\n  .hn-legal-footer {\n    padding: 25px 16px 30px;\n  }\n\n  .hn-legal-heading {\n    font-size: 12px;\n    line-height: 1.6;\n    margin-bottom: 22px;\n  }\n\n  .hn-legal-links {\n    gap: 14px 18px;\n  }\n\n  .hn-legal-link {\n    font-size: 12px;\n  }\n\n  .hn-legal-separator {\n    height: 14px;\n  }\n\n  .hn-legal-instagram {\n    gap: 7px;\n  }\n\n  .hn-legal-instagram svg {\n    width: 19px;\n    height: 19px;\n  }\n}\n\n@media (max-width: 420px) {\n  .hn-legal-separator {\n    display: none;\n  }\n\n  .hn-legal-links {\n    gap: 14px 20px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-legal-link {\n    transition: none;\n  }\n}\n</style>\n\n<section class=\"hn-legal-footer\">\n  <div class=\"hn-legal-inner\">\n\n    <p class=\"hn-legal-heading\">\n      NO PURCHASE NECESSARY TO ENTER OR WIN.\n      A PURCHASE WILL NOT INCREASE YOUR CHANCES OF WINNING.\n    </p>\n\n    <nav class=\"hn-legal-links\" aria-label=\"Giveaway legal and social links\">\n\n      <!-- OFFICIAL RULES -->\n\n      <a\n        href=\"{{ hn_rules_url }}\"\n        class=\"hn-legal-link\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n      >\n        Official Sweepstakes Rules\n      </a>\n\n      <span class=\"hn-legal-separator\" aria-hidden=\"true\"></span>\n\n      <!-- PRIVACY POLICY -->\n\n      <a\n        href=\"{{ hn_privacy_url }}\"\n        class=\"hn-legal-link\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n      >\n        Privacy Policy\n      </a>\n\n      <span class=\"hn-legal-separator\" aria-hidden=\"true\"></span>\n\n      <!-- INSTAGRAM -->\n\n      <a\n        href=\"{{ hn_instagram_url }}\"\n        class=\"hn-legal-link\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n      >\n        Follow Us on Instagram\n      </a>\n\n      <a\n        href=\"{{ hn_instagram_url }}\"\n        class=\"hn-legal-link hn-legal-instagram\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"HNDRD USA Instagram\"\n      >\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"/>\n          <circle cx=\"12\" cy=\"12\" r=\"4\"/>\n          <path d=\"M17.5 6.5h.01\"/>\n        </svg>\n\n        <span>@hndrd.us</span>\n      </a>\n\n    </nav>\n\n  </div>\n</section>",
