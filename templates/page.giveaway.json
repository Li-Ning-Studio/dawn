ss=\"hx-head hx-reveal\">\n      <h2 class=\"hx-title\" id=\"hx-entry-heading\">HOW TO <em>ENTER.</em></h2>\n      <p class=\"hx-intro\">Three simple ways to take part. Start for free, then earn additional entries.</p>\n    </div>\n\n    <div class=\"hx-grid\">\n      <article class=\"hx-glass hx-feature hx-reveal\">\n        <div>\n          <div class=\"hx-index\">01 &nbsp;/&nbsp; START HERE</div>\n          <div class=\"hx-tag\"><span class=\"hx-mini-circle\"></span> FREE · NO PURCHASE NECESSARY</div>\n          <h3>Complete the giveaway form.</h3>\n          <p>Submit the official form once a day for another chance to win.</p>\n        </div>\n        <div class=\"hx-feature-score\" aria-label=\"2 entries per day\">\n          <strong>+2</strong><small>ENTRIES / DAY</small>\n        </div>\n      </article>\n\n      <article class=\"hx-glass hx-side hx-reveal\">\n        <div class=\"hx-card-head\">\n          <div class=\"hx-index\">02 &nbsp;/&nbsp; CONNECT</div>\n          <span class=\"hx-symbol\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M17.5 6.6h.01\"/></svg>\n          </span>\n        </div>\n        <h3>Follow &amp; share.</h3>\n        <p class=\"hx-support\">Show your HNDRD side on Instagram.</p>\n        <div class=\"hx-rows\">\n          <div class=\"hx-row\">\n            <div><p class=\"hx-row-name\">Follow @hndrd.us</p><p class=\"hx-row-note\">On Instagram</p></div>\n            <span class=\"hx-points\" aria-label=\"2 entries\">+2</span>\n          </div>\n          <div class=\"hx-row\">\n            <div><p class=\"hx-row-name\">Share your HNDRD gear</p><p class=\"hx-row-note\">Post or Story · Tag @hndrd.us</p></div>\n            <span class=\"hx-points\" aria-label=\"5 entries\">+5</span>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"hx-glass hx-side hx-reveal\">\n        <div class=\"hx-card-head\">\n          <div class=\"hx-index\">03 &nbsp;/&nbsp; GEAR UP</div>\n          <span class=\"hx-symbol\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M4 9h16l-1 12H5L4 9Z\"/><path d=\"M9 10V7a3 3 0 0 1 6 0v3\"/></svg>\n          </span>\n        </div>\n        <h3>Shop HNDRD.</h3>\n        <p class=\"hx-support\">Eligible purchases at authorized HNDRD USA retailers.</p>\n        <div class=\"hx-rows\">\n          <div class=\"hx-row\">\n            <p class=\"hx-row-name\">Any HNDRD racket</p>\n            <span class=\"hx-points\" aria-label=\"20 entries\">+20</span>\n          </div>\n          <div class=\"hx-row\">\n            <p class=\"hx-row-name\">Any HNDRD shoes</p>\n            <span class=\"hx-points\" aria-label=\"20 entries\">+20</span>\n          </div>\n          <div class=\"hx-row\">\n            <p class=\"hx-row-name\">Any HNDRD strings</p>\n            <span class=\"hx-points\" aria-label=\"5 entries\">+5</span>\n          </div>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"hx-cap hx-reveal\">\n      <div class=\"hx-cap-label\">Maximum entries per participant<span>More entries. More chances.</span></div>\n      <div class=\"hx-cap-count\"><b>100</b><small>ENTRIES</small></div>\n    </div>\n    <p class=\"hx-disclaimer\">No purchase necessary. Entry eligibility, limits and verification are subject to the official giveaway rules.</p>\n  </div>\n</section>\n\n<script>\n(function () {\n  var root = document.getElementById('hndrd-how-to-enter');\n  if (!root || root.dataset.hxReady === '1') return;\n  root.dataset.hxReady = '1';\n  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var finePointer = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;\n\n  // Ambient spotlight follows the cursor only while a card is hovered.\n  if (finePointer && !reduce) {\n    root.querySelectorAll('.hx-glass').forEach(function (card) {\n      var raf = 0;\n      card.addEventListener('pointermove', function (event) {\n        if (raf) return;\n        var x = event.clientX, y = event.clientY;\n        raf = requestAnimationFrame(function () {\n          var rect = card.getBoundingClientRect();\n          card.style.setProperty('--pointer-x', (x - rect.left) + 'px');\n          card.style.setProperty('--pointer-y', (y - rect.top) + 'px');\n          raf = 0;\n        });\n      }, { passive: true });\n    });\n  }\n\n  // Reveal only offscreen items. All content remains visible if JS is unavailable.\n  if (!reduce && 'IntersectionObserver' in window) {\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (!entry.isIntersecting) return;\n        entry.target.classList.add('hx-shown');\n        entry.target.classList.remove('hx-pending');\n        observer.unobserve(entry.target);\n      });\n    }, { threshold: .08, rootMargin: '0px 0px -25px 0px' });\n\n    root.querySelectorAll('.hx-reveal').forEach(function (el, index) {\n      var rect = el.getBoundingClientRect();\n      if (rect.top < window.innerHeight && rect.bottom > 0) return;\n      el.classList.add('hx-pending');\n      el.style.transitionDelay = Math.min(index * 80, 320) + 'ms';\n      observer.observe(el);\n    });\n  }\n})();\n</script>",
