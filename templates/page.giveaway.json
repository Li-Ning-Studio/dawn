height: 218px;\n\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 40px;\n\n  padding: 44px 50px;\n\n  background: rgba(255,255,255,0.53);\n\n  -webkit-backdrop-filter: blur(24px) saturate(145%);\n  backdrop-filter: blur(24px) saturate(145%);\n\n  border: 1px solid rgba(255,255,255,0.9);\n  border-radius: 24px;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,0.95),\n    0 12px 34px rgba(0,0,0,0.045),\n    0 2px 6px rgba(0,0,0,0.025);\n\n  transition:\n    box-shadow .35s ease,\n    border-color .35s ease;\n}\n\n/* SUBTLE GLASS LIGHTING */\n\n.hn-retail-glass-panel::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  pointer-events: none;\n\n  inset: 0;\n\n  background: linear-gradient(\n    120deg,\n    rgba(255,255,255,0.35) 0%,\n    rgba(255,255,255,0.08) 50%,\n    rgba(255,255,255,0.02) 100%\n  );\n}\n\n.hn-retail-glass-panel:hover {\n  border-color: rgba(255,255,255,1);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,1),\n    0 18px 42px rgba(0,0,0,0.065),\n    0 3px 8px rgba(0,0,0,0.025);\n}\n\n/* GLASS HIGHLIGHT */\n\n.hn-retail-glass-panel::after {\n  content: \"\";\n  position: absolute;\n  pointer-events: none;\n\n  top: 0;\n  left: 12%;\n  right: 12%;\n\n  height: 1px;\n\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(255,255,255,1),\n    transparent\n  );\n}\n\n/* ==========================================\n   LEFT CONTENT\n========================================== */\n\n.hn-retail-glass-content {\n  position: relative;\n  z-index: 1;\n  flex: 1;\n  min-width: 0;\n}\n\n.hn-retail-glass .hn-retail-glass-title {\n  margin: 0 0 13px;\n  padding: 0;\n\n  font-family: 'HN-Retail-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: clamp(30px, 3.2vw, 46px);\n  font-weight: 800;\n  font-style: normal;\n\n  line-height: 1.12;\n  letter-spacing: -1.4px;\n  text-transform: uppercase;\n\n  color: #000000;\n}\n\n.hn-retail-glass-title span {\n  color: var(--hn-orange);\n}\n\n.hn-retail-glass .hn-retail-glass-description {\n  margin: 0;\n  padding: 0;\n\n  font-family: 'HN-Retail-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: 16px;\n  font-weight: 400;\n\n  line-height: 1.6;\n  letter-spacing: 0;\n\n  color: var(--hn-grey);\n}\n\n/* ==========================================\n   RIGHT CTA\n========================================== */\n\n.hn-retail-glass .hn-retail-glass-button {\n  position: relative;\n  z-index: 1;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n\n  min-height: 48px;\n  padding: 14px 25px;\n  flex-shrink: 0;\n\n  background: var(--hn-orange);\n\n  border: 1px solid rgba(0,0,0,0.04);\n  border-radius: 12px;\n\n  color: #000000 !important;\n\n  font-family: 'HN-Retail-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.2;\n\n  text-decoration: none !important;\n  white-space: nowrap;\n\n  cursor: pointer;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,0.28),\n    0 4px 12px rgba(0,0,0,0.055);\n\n  transition:\n    background .2s ease,\n    transform .2s ease,\n    box-shadow .2s ease;\n}\n\n/* HOVER */\n\n.hn-retail-glass .hn-retail-glass-button:hover {\n  background: #f4a000;\n  color: #000000 !important;\n\n  transform: translateY(-1px);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,0.4),\n    0 7px 17px rgba(0,0,0,0.09);\n}\n\n.hn-retail-glass .hn-retail-glass-button:active {\n  transform: translateY(0);\n}\n\n.hn-retail-glass .hn-retail-glass-button:focus-visible {\n  outline: 2px solid #000000;\n  outline-offset: 4px;\n}\n\n/* ARROW */\n\n.hn-retail-glass-button svg {\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .2s ease;\n}\n\n.hn-retail-glass-button:hover svg {\n  transform: translateX(3px);\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (max-width: 1024px) {\n\n  .hn-retail-glass {\n    padding: 25px 4%;\n  }\n\n  .hn-retail-glass-panel {\n    min-height: 190px;\n    padding: 36px 32px;\n    gap: 22px;\n    border-radius: 20px;\n  }\n\n  .hn-retail-glass .hn-retail-glass-title {\n    font-size: clamp(27px,3vw,38px);\n  }\n\n  .hn-retail-glass .hn-retail-glass-description {\n    font-size: 15px;\n  }\n}\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 767px) {\n\n  .hn-retail-glass {\n    padding: 18px 16px;\n  }\n\n  .hn-retail-glass-panel {\n    flex-direction: column;\n    align-items: flex-start;\n\n    min-height: 0;\n    gap: 28px;\n\n    padding: 30px 24px;\n\n    border-radius: 18px;\n  }\n\n  .hn-retail-glass .hn-retail-glass-title {\n    font-size: clamp(27px, 8vw, 36px);\n    letter-spacing: -.9px;\n    line-height: 1.13;\n    margin-bottom: 12px;\n  }\n\n  .hn-retail-glass .hn-retail-glass-description {\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .hn-retail-glass .hn-retail-glass-button {\n    width: 100%;\n    min-height: 48px;\n    border-radius: 10px;\n  }\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-retail-glass-panel,\n  .hn-retail-glass-button,\n  .hn-retail-glass-button svg {\n    transition: none !important;\n  }\n\n  .hn-retail-glass-button:hover {\n    transform: none !important;\n  }\n}\n\n</style>\n\n<section class=\"hn-retail-glass\" id=\"hn-retailers\">\n\n  <div class=\"hn-retail-glass-container\">\n\n    <div class=\"hn-retail-glass-panel\">\n\n      <!-- LEFT CONTENT -->\n\n      <div class=\"hn-retail-glass-content\">\n\n        <h2 class=\"hn-retail-glass-title\">\n          FIND HNDRD <span>NEAR YOU</span>\n        </h2>\n\n        <p class=\"hn-retail-glass-description\">\n          Visit an authorized HNDRD retailer near you.\n        </p>\n\n      </div>\n\n      <!-- RIGHT CTA -->\n\n      <a\n        class=\"hn-retail-glass-button\"\n        href=\"{{ hn_locator_url }}\"\n        aria-label=\"Find an authorized HNDRD retailer\"\n      >\n        Find a retailer\n\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.8\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <path d=\"M5 12h14\"/>\n          <path d=\"m13 6 6 6-6 6\"/>\n        </svg>\n\n      </a>\n\n    </div>\n\n  </div>\n\n</section>",
