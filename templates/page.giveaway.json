        "custom_liquid": "{% comment %}\n  HNDRD | NITRIX 80 BULLET | How to Enter\n  Paste this complete block into ONE Shopify Custom Liquid section.\n  Uses your uploaded Anita_semi_square.ttf and Gilroy-Regular.ttf files.\n  No external CSS, scripts, font services or assets.\n{% endcomment %}\n\n<style>\n@font-face{font-family:\"HN-Display\";src:url(\"{{ 'Anita_semi_square.ttf' | file_url }}\") format(\"truetype\");font-display:swap}\n@font-face{font-family:\"HN-Body\";src:url(\"{{ 'Gilroy-Regular.ttf' | file_url }}\") format(\"truetype\");font-display:swap}\n\n.hx-entry{--hx-accent:#FFA300;--hx-ink:#171717;--hx-muted:#707078;--hx-line:rgba(20,20,24,.095);position:relative;isolation:isolate;overflow:hidden;background:#f6f6f8;color:var(--hx-ink);font-family:\"HN-Body\",Arial,sans-serif;-webkit-font-smoothing:antialiased;padding:clamp(68px,8.5vw,116px) 22px 82px}\n.hx-entry *,.hx-entry *::before,.hx-entry *::after{box-sizing:border-box}\n.hx-entry h2,.hx-entry h3,.hx-entry p{margin:0;padding:0;color:inherit;font-family:inherit;text-transform:none}\n.hx-entry .hx-shell{position:relative;z-index:2;max-width:1120px;margin:0 auto}\n.hx-entry .hx-aurora{position:absolute;z-index:0;inset:-20%;pointer-events:none;background:radial-gradient(ellipse 38% 36% at 10% 17%,rgba(255,163,0,.25),transparent 76%),radial-gradient(ellipse 34% 36% at 90% 50%,rgba(255,193,106,.29),transparent 75%),radial-gradient(ellipse 32% 26% at 44% 95%,rgba(228,225,238,.73),transparent 80%);filter:blur(10px);animation:hx-breathe 16s ease-in-out infinite alternate}\n.hx-entry .hx-dots{position:absolute;z-index:0;inset:0;pointer-events:none;opacity:.23;background-image:radial-gradient(#96969d .7px,transparent .7px);background-size:22px 22px;-webkit-mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent 78%);mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent 78%)}\n@keyframes hx-breathe{0%{transform:translate3d(-2%,0,0) scale(1)}100%{transform:translate3d(2%,2%,0) scale(1.05)}}\n\n/* Editorial header */\n.hx-entry .hx-overline{display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:#69696e}\n.hx-entry .hx-overline i{width:7px;height:7px;border-radius:50%;background:var(--hx-accent);box-shadow:0 0 0 5px rgba(255,163,0,.13);animation:hx-pulse 2.8s ease-in-out infinite}\n@keyframes hx-pulse{50%{box-shadow:0 0 0 9px rgba(255,163,0,0)}}\n.hx-entry .hx-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin:17px 0 38px}\n.hx-entry .hx-title{font-family:\"HN-Display\",Arial,sans-serif;font-size:clamp(43px,6.1vw,78px);font-weight:400;letter-spacing:-.045em;line-height:1.02;text-transform:uppercase}\n.hx-entry .hx-title em{font-style:normal;color:#d28a00}\n.hx-entry .hx-intro{max-width:294px;font-size:15px;line-height:1.65;color:var(--hx-muted)!important;padding-bottom:5px}\n\n/* One restrained glass system, not stacked boxes */\n.hx-entry .hx-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;perspective:1200px}\n.hx-entry .hx-glass{--pointer-x:50%;--pointer-y:50%;position:relative;min-width:0;overflow:hidden;border:1px solid rgba(255,255,255,.96);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.79),rgba(255,255,255,.43));-webkit-backdrop-filter:blur(34px) saturate(175%);backdrop-filter:blur(34px) saturate(175%);box-shadow:inset 0 1px 0 rgba(255,255,255,1),0 2px 3px rgba(31,30,32,.035),0 22px 65px -35px rgba(36,35,43,.23);transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s cubic-bezier(.2,.8,.2,1),border-color .4s ease}\n.hx-entry .hx-glass:before{content:\"\";position:absolute;z-index:0;inset:0;pointer-events:none;background:radial-gradient(340px circle at var(--pointer-x) var(--pointer-y),rgba(255,255,255,.96),rgba(255,218,162,.23) 32%,transparent 74%);opacity:0;transition:opacity .35s ease}\n.hx-entry .hx-glass:after{content:\"\";position:absolute;z-index:0;left:-70%;top:-90%;height:240%;width:60%;pointer-events:none;transform:rotate(24deg) translateX(-60%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.30),transparent);transition:transform .9s cubic-bezier(.18,.72,.3,1)}\n.hx-entry .hx-glass:hover{transform:translateY(-5px);box-shadow:inset 0 1px 0 #fff,0 30px 75px -34px rgba(44,38,31,.26),0 12px 27px -22px rgba(255,163,0,.33)}\n.hx-entry .hx-glass:hover:before{opacity:1}\n.hx-entry .hx-glass:hover:after{transform:rotate(24deg) translateX(370%)}\n.hx-entry .hx-glass>*{position:relative;z-index:1}\n\n/* First and most important instruction */\n.hx-entry .hx-feature{grid-column:1/-1;min-height:266px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:48px;padding:38px 46px;background:linear-gradient(115deg,rgba(255,255,255,.88),rgba(255,255,255,.52) 68%,rgba(255,241,215,.55))}\n.hx-entry .hx-tag{display:inline-flex;align-items:center;gap:8px;width:fit-content;color:#88600f;background:rgba(255,163,0,.12);border:1px solid rgba(255,163,0,.16);border-radius:100px;padding:7px 12px;font-size:11px;font-weight:700;letter-spacing:.055em}\n.hx-entry .hx-mini-circle{width:6px;height:6px;background:var(--hx-accent);border-radius:50%}\n.hx-entry .hx-index{margin-bottom:15px;font-size:11px;letter-spacing:.15em;font-weight:700;color:#8c8b8f}\n.hx-entry .hx-feature h3{font-family:\"HN-Display\",Arial,sans-serif;font-size:clamp(27px,3.3vw,42px);font-weight:400;line-height:1.12;letter-spacing:-.027em;text-transform:uppercase;margin:17px 0 12px;max-width:650px}\n.hx-entry .hx-feature p{max-width:430px;font-size:15px;line-height:1.65;color:var(--hx-muted)!important}\n.hx-entry .hx-feature-score{width:190px;height:190px;border-radius:50%;background:linear-gradient(145deg,rgba(255,255,255,.90),rgba(255,255,255,.34));border:1px solid rgba(255,255,255,.95);box-shadow:inset 0 2px 3px #fff,0 17px 37px -25px rgba(94,61,17,.36);display:flex;flex-direction:column;justify-content:center;align-items:center;flex-shrink:0;position:relative}\n.hx-entry .hx-feature-score:before{content:\"\";position:absolute;inset:10px;border:1px solid rgba(255,163,0,.18);border-radius:50%}\n.hx-entry .hx-feature-score strong{font-family:\"HN-Display\",Arial,sans-serif;color:#ce8200;font-size:72px;line-height:1.05;font-weight:400;letter-spacing:-.06em;font-variant-numeric:tabular-nums}\n.hx-entry .hx-feature-score small{font-size:11px;letter-spacing:.08em;color:#747178;font-weight:700}\n\n/* Two clear paths */\n.hx-entry .hx-side{min-height:330px;padding:30px 32px 25px;display:flex;flex-direction:column}\n.hx-entry .hx-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:8px}\n.hx-entry .hx-symbol{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;flex-shrink:0;background:rgba(255,163,0,.105);border:1px solid rgba(255,163,0,.14);color:#a97107;transition:transform .4s cubic-bezier(.2,.8,.2,1),background .3s ease}\n.hx-entry .hx-glass:hover .hx-symbol{transform:rotate(-6deg) scale(1.06);background:rgba(255,163,0,.18)}\n.hx-entry .hx-symbol svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}\n.hx-entry .hx-side h3{font-family:\"HN-Display\",Arial,sans-serif;font-size:clamp(24px,2.8vw,33px);font-weight:400;line-height:1.18;text-transform:uppercase;letter-spacing:-.025em}\n.hx-entry .hx-support{font-size:13px;color:var(--hx-muted)!important;line-height:1.6;margin:7px 0 21px!important}\n.hx-entry .hx-rows{margin-top:auto;border-top:1px solid var(--hx-line)}\n.hx-entry .hx-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0}\n.hx-entry .hx-row+.hx-row{border-top:1px solid var(--hx-line)}\n.hx-entry .hx-row-name{font-weight:700;font-size:14px;line-height:1.45}\n.hx-entry .hx-row-note{font-size:12px;line-height:1.55;color:var(--hx-muted)!important;margin-top:4px!important}\n.hx-entry .hx-points{font-family:\"HN-Display\",Arial,sans-serif;color:#be7c