        "custom_liquid": "{% comment %}\n  HNDRD NITRIX 80 BULLET\n  GIVEAWAY ENTRY SECTION\n\n  Premium Frosted Glass Design\n  Brand Guidelines v1.0.3\n{% endcomment %}\n\n<style>\n\n/* ==========================================\n   HNDRD BRAND FONTS\n========================================== */\n\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-ExtraBold.ttf' | file_url }}\") format('truetype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* ==========================================\n   MAIN SECTION\n========================================== */\n\n.hndrd-entry-section,\n.hndrd-entry-section *,\n.hndrd-entry-section *::before,\n.hndrd-entry-section *::after {\n  box-sizing: border-box;\n}\n\n.hndrd-entry-section {\n  --hn-orange: #FFA300;\n  --hn-black: #000000;\n  --hn-grey: #444445;\n\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n\n  background: #ededed;\n  color: var(--hn-black);\n\n  padding: 45px 5%;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\n.hndrd-entry-container {\n  position: relative;\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n\n  display: grid;\n  grid-template-columns: minmax(0, 45%) minmax(0, 55%);\n  align-items: center;\n  gap: 30px;\n}\n\n/* ==========================================\n   LEFT CONTENT\n========================================== */\n\n.hndrd-entry-content {\n  min-width: 0;\n}\n\n.hndrd-entry-section .hndrd-entry-title {\n  margin: 0 0 18px;\n  padding: 0;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: clamp(30px, 3.5vw, 52px);\n  font-weight: 800;\n  font-style: normal;\n\n  line-height: 1.15;\n  letter-spacing: -1.5px;\n  text-transform: uppercase;\n\n  color: #000000;\n}\n\n.hndrd-entry-section .hndrd-entry-title span {\n  color: var(--hn-orange);\n}\n\n.hndrd-entry-section .hndrd-entry-description {\n  max-width: 430px;\n  margin: 0;\n  padding: 0;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: clamp(14px, 1.2vw, 17px);\n  font-weight: 400;\n  line-height: 1.6;\n\n  color: var(--hn-grey);\n}\n\n.hndrd-entry-accent {\n  width: 55px;\n  height: 3px;\n  margin-top: 25px;\n  background: var(--hn-orange);\n}\n\n/* ==========================================\n   FROSTED GLASS FORM CARD\n========================================== */\n\n.hndrd-entry-form {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  min-width: 0;\n  overflow: hidden;\n\n  background: rgba(255, 255, 255, .56);\n\n  -webkit-backdrop-filter: blur(24px) saturate(145%);\n  backdrop-filter: blur(24px) saturate(145%);\n\n  border: 1px solid rgba(255, 255, 255, .92);\n  border-radius: 24px;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.98),\n    0 12px 34px rgba(0,0,0,.045),\n    0 2px 6px rgba(0,0,0,.025);\n\n  transition:\n    border-color .3s ease,\n    box-shadow .3s ease;\n}\n\n/* SOFT GLASS HIGHLIGHT */\n\n.hndrd-entry-form::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  pointer-events: none;\n\n  background: linear-gradient(\n    120deg,\n    rgba(255,255,255,.35) 0%,\n    rgba(255,255,255,.08) 55%,\n    rgba(255,255,255,.02) 100%\n  );\n}\n\n.hndrd-entry-form::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 12%;\n  right: 12%;\n  height: 1px;\n  pointer-events: none;\n\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(255,255,255,1),\n    transparent\n  );\n}\n\n.hndrd-entry-form:hover {\n  border-color: #ffffff;\n  box-shadow:\n    inset 0 1px 0 #ffffff,\n    0 18px 42px rgba(0,0,0,.065),\n    0 3px 8px rgba(0,0,0,.025);\n}\n\n/* BRAND ORANGE LINE */\n\n.hndrd-form-topline {\n  width: 100%;\n  height: 4px;\n  background: var(--hn-orange);\n}\n\n/* FORM CONTENT */\n\n.hndrd-form-body {\n  position: relative;\n  z-index: 1;\n  padding: 38px 42px 42px;\n}\n\n/* FORM HEADING */\n\n.hndrd-entry-section .hndrd-form-title {\n  margin: 0 0 12px;\n  padding: 0;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: clamp(20px, 1.8vw, 26px);\n  font-weight: 700;\n  line-height: 1.35;\n  letter-spacing: -.5px;\n\n  color: #000000;\n}\n\n/* DESCRIPTION */\n\n.hndrd-entry-section .hndrd-form-description {\n  margin: 0 0 26px;\n  padding: 0;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 1.65;\n\n  color: var(--hn-grey);\n}\n\n/* DIVIDER */\n\n.hndrd-form-divider {\n  width: 100%;\n  height: 1px;\n  margin-bottom: 26px;\n  background: rgba(0,0,0,.10);\n}\n\n/* ==========================================\n   FORM CTA\n========================================== */\n\n.hndrd-entry-section .hndrd-form-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 13px;\n\n  min-height: 48px;\n  padding: 14px 25px;\n\n  background: var(--hn-orange);\n  border: 1px solid rgba(0,0,0,.04);\n  border-radius: 12px;\n\n  color: #000000 !important;\n\n  font-family: 'HNDRD-Figtree', 'Figtree', Arial, sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.2;\n\n  text-decoration: none !important;\n  cursor: pointer;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.28),\n    0 4px 12px rgba(0,0,0,.055);\n\n  transition:\n    background .2s ease,\n    transform .2s ease,\n    box-shadow .2s ease;\n}\n\n.hndrd-entry-section .hndrd-form-button:hover {\n  background: #f4a000;\n  color: #000000 !important;\n  transform: translateY(-1px);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.4),\n    0 7px 17px rgba(0,0,0,.09);\n}\n\n.hndrd-entry-section .hndrd-form-button:active {\n  transform: translateY(0);\n}\n\n.hndrd-entry-section .hndrd-form-button:focus-visible {\n  outline: 2px solid #000000;\n  outline-offset: 4px;\n}\n\n.hndrd-form-button svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .2s ease;\n}\n\n.hndrd-form-button:hover svg {\n  transform: translateX(3px);\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (max-width: 1024px) {\n  .hndrd-entry-section {\n    padding: 38px 4%;\n  }\n\n  .hndrd-entry-container {\n    grid-template-columns: minmax(0, 43%) minmax(0, 57%);\n    gap: 16px;\n  }\n\n  .hndrd-entry-section .hndrd-entry-title {\n    font-size: clamp(27px, 3vw, 38px);\n  }\n\n  .hndrd-form-body {\n    padding: 32px 28px 34px;\n  }\n\n  .hndrd-entry-form {\n    border-radius: 20px;\n  }\n}\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 767px) {\n  .hndrd-entry-section {\n    padding: 30px 16px;\n  }\n\n  .hndrd-entry-container {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 28px;\n  }\n\n  .hndrd-entry-section .hndrd-entry-title {\n    font-size: clamp(29px, 8vw, 40px);\n    letter-spacing: -1px;\n    margin-bottom: 14px;\n  }\n\n  .hndrd-entry-section .hndrd-entry-description {\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .hndrd-entry-accent {\n    width: 48px;\n    margin-top: 20px;\n  }\n\n  .hndrd-entry-form {\n    border-radius: 18px;\n  }\n\n  .hndrd-form-body {\n    padding: 29px 25px 30px;\n  }\n\n  .hndrd-entry-section .hndrd-form-title {\n    font-size: 21px;\n    margin-bottom: 11px;\n  }\n\n  .hndrd-entry-section .hndrd-form-description {\n    font-size: 13px;\n    margin-bottom: 22px;\n  }\n\n  .hndrd-form-divider {\n    margin-bottom: 22px;\n  }\n\n  .hndrd-entry-section .hndrd-form-button {\n    min-height: 48px;\n    border-radius: 10px;\n  }\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .hndrd-entry-form,\n  .hndrd-form-button,\n  .hndrd-form-button svg {\n    transition: none !important;\n  }\n\n  .hndrd-form-button:hover {\n    transform: none !important;\n  }\n}\n\n</style>\n\n<section class=\"hndrd-entry-section\" id=\"hndrd-giveaway-entry\">\n\n  <div class=\"hndrd-entry-container\">\n\n    <!-- LEFT CONTENT -->\n\n    <div class=\"hndrd-entry-content\">\n\n      <h2 class=\"hndrd-entry-title\">\n        READY <span>TO ENTER?</span>\n      </h2>\n\n      <p class=\"hndrd-entry-description\">\n        Don't miss your chance to win the\n        HNDRD NITRIX 80 BULLET Ultimate Giveaway!\n      </p>\n\n      <div class=\"hndrd-entry-accent\"></div>\n\n    </div>\n\n    <!-- RIGHT GLASS CARD -->\n\n    <div class=\"hndrd-entry-form\">\n\n      <div class=\"hndrd-form-topline\"></div>\n\n      <div class=\"hndrd-form-body\">\n\n        <h3 class=\"hndrd-form-title\">\n          HNDRD NITRIX 80 BULLET Ultimate Giveaway Entry Form\n        </h3>\n\n        <p class=\"hndrd-form-description\">\n          Complete the entry form to participate\n          in the giveaway.\n        </p>\n\n        <div class=\"hndrd-form-divider\"></div>\n\n        <a\n          class=\"hndrd-form-button\"\n          href=\"https://forms.gle/vUTcGrcT1Ri7NH5S9\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          aria-label=\"Fill out HNDRD giveaway entry form\"\n        >\n          Fill Out Entry Form\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          