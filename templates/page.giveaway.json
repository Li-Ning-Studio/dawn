    "custom_liquid_UdNHeX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD NITRIX 80 BULLET\n  ULTIMATE GIVEAWAY — ENTRY CTA\n\n  Centered uppercase title\n  Premium frosted glass button\n  Brand colors and Figtree fonts\n{% endcomment %}\n\n<style>\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-Regular.ttf' | file_url }}\") format('truetype');\n  font-weight: 400;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-Bold.ttf' | file_url }}\") format('truetype');\n  font-weight: 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNDRD-Figtree';\n  src: url(\"{{ 'Figtree-ExtraBold.ttf' | file_url }}\") format('truetype');\n  font-weight: 800;\n  font-display: swap;\n}\n\n/* FOUNDATION */\n\n.h80-mini,\n.h80-mini *,\n.h80-mini *::before,\n.h80-mini *::after {\n  box-sizing: border-box;\n}\n\n.h80-mini {\n  --accent: #FFA300;\n  --ink: #111111;\n  --background: #FFFAF0;\n\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n\n  width: 100%;\n  padding: 76px 20px 80px;\n\n  background: var(--background);\n  color: var(--ink);\n\n  font-family: 'HNDRD-Figtree', Arial, sans-serif;\n  text-align: center;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* SOFT BACKGROUND ACCENT */\n\n.h80-mini::before {\n  content: \"\";\n\n  position: absolute;\n  z-index: -1;\n\n  left: 50%;\n  top: 10px;\n  transform: translateX(-50%);\n\n  width: min(720px, 105vw);\n  height: 290px;\n\n  border-radius: 50%;\n\n  background: radial-gradient(\n    ellipse at center,\n    rgba(255,163,0,.09) 0%,\n    rgba(255,163,0,.025) 38%,\n    transparent 72%\n  );\n\n  pointer-events: none;\n}\n\n/* CENTERED CONTENT */\n\n.h80-mini__inner {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  max-width: 1000px;\n  margin: 0 auto;\n\n  text-align: center;\n}\n\n/* FULLY UPPERCASE TITLE */\n\n.h80-mini .h80-mini__title {\n  display: block;\n  width: 100%;\n\n  margin: 0 auto !important;\n  padding: 0 !important;\n\n  color: var(--ink) !important;\n  font-family: 'HNDRD-Figtree', Arial, sans-serif !important;\n\n  font-size: clamp(36px, 7.2vw, 88px) !important;\n  font-weight: 800 !important;\n\n  letter-spacing: -.065em !important;\n  line-height: 1.12 !important;\n\n  text-align: center !important;\n  text-transform: uppercase !important;\n\n  white-space: nowrap;\n\n  animation: h80-rise .8s cubic-bezier(.22,1,.36,1) both;\n}\n\n.h80-mini .h80-mini__title .h80-mini__accent {\n  color: #FFA300 !important;\n  text-transform: uppercase !important;\n}\n\n/* DESCRIPTION */\n\n.h80-mini .h80-mini__desc {\n  max-width: 445px;\n\n  margin: 22px auto 0 !important;\n  padding: 0 !important;\n\n  color: #706d68 !important;\n  font-family: 'HNDRD-Figtree', Arial, sans-serif !important;\n\n  font-size: 16px !important;\n  font-weight: 400 !important;\n  line-height: 1.6 !important;\n\n  letter-spacing: -.012em;\n  text-align: center !important;\n\n  animation: h80-rise .8s .12s both;\n}\n\n/* CTA CONTAINER */\n\n.h80-mini__action {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  margin-top: 31px;\n\n  animation: h80-rise .8s .22s both;\n}\n\n/* PREMIUM GLASS CTA */\n\n.h80-mini .h80-mini__cta,\n.h80-mini .h80-mini__cta:visited {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 28px;\n\n  min-height: 58px;\n  min-width: 258px;\n\n  padding: 7px 8px 7px 25px;\n  overflow: hidden;\n\n  background: rgba(255,255,255,.76) !important;\n  color: #111111 !important;\n\n  border: 1px solid rgba(0,0,0,.09) !important;\n  border-radius: 100px !important;\n\n  -webkit-backdrop-filter: blur(20px) saturate(160%);\n  backdrop-filter: blur(20px) saturate(160%);\n\n  box-shadow:\n    0 7px 28px rgba(0,0,0,.045),\n    inset 0 1px 0 rgba(255,255,255,.95);\n\n  font-family: 'HNDRD-Figtree', Arial, sans-serif !important;\n\n  font-size: 14px !important;\n  font-weight: 700 !important;\n  letter-spacing: -.01em;\n\n  line-height: 1.2;\n  text-decoration: none !important;\n  text-transform: none !important;\n\n  cursor: pointer;\n\n  transition:\n    transform .35s cubic-bezier(.22,1,.36,1),\n    box-shadow .35s ease,\n    border-color .35s ease;\n}\n\n/* SUBTLE LIGHT REFLECTION */\n\n.h80-mini__cta::before {\n  content: \"\";\n\n  position: absolute;\n  inset: 0;\n\n  background: linear-gradient(\n    115deg,\n    transparent 25%,\n    rgba(255,255,255,.75) 46%,\n    transparent 68%\n  );\n\n  transform: translateX(-140%);\n  transition: transform .8s ease;\n  pointer-events: none;\n}\n\n/* CTA TEXT */\n\n.h80-mini__cta-label {\n  position: relative;\n  z-index: 1;\n\n  color: #111111;\n  white-space: nowrap;\n}\n\n/* ORANGE ARROW */\n\n.h80-mini__arrow {\n  position: relative;\n  z-index: 1;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 43px;\n  height: 43px;\n  flex: 0 0 43px;\n\n  border-radius: 50%;\n  background: #FFA300;\n  color: #111111;\n\n  transition:\n    transform .35s cubic-bezier(.22,1,.36,1);\n}\n\n.h80-mini__arrow svg {\n  width: 18px;\n  height: 18px;\n\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* HOVER */\n\n@media (hover: hover) {\n  .h80-mini .h80-mini__cta:hover {\n    transform: translateY(-3px);\n\n    border-color: rgba(255,163,0,.38) !important;\n\n    box-shadow:\n      0 15px 35px rgba(0,0,0,.07),\n      0 2px 5px rgba(0,0,0,.025),\n      inset 0 1px 0 #fff;\n  }\n\n  .h80-mini__cta:hover::before {\n    transform: translateX(140%);\n  }\n\n  .h80-mini__cta:hover .h80-mini__arrow {\n    transform: translateX(2px);\n  }\n}\n\n/* ACTIVE + FOCUS */\n\n.h80-mini .h80-mini__cta:active {\n  transform: scale(.98);\n}\n\n.h80-mini .h80-mini__cta:focus-visible {\n  outline: 2px solid #111111;\n  outline-offset: 4px;\n}\n\n/* ENTRANCE ANIMATION */\n\n@keyframes h80-rise {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* MOBILE */\n\n@media (max-width: 767px) {\n  .h80-mini {\n    padding: 59px 16px 65px;\n    background: #FFFAF0;\n  }\n\n  .h80-mini::before {\n    top: 0;\n    width: 430px;\n    height: 230px;\n  }\n\n  .h80-mini .h80-mini__title {\n    font-size: clamp(30px, 8.5vw, 58px) !important;\n    letter-spacing: -.06em !important;\n    line-height: 1.16 !important;\n\n    text-align: center !important;\n    text-transform: uppercase !important;\n  }\n\n  .h80-mini .h80-mini__desc {\n    max-width: 335px;\n    margin-top: 17px !important;\n\n    font-size: 14px !important;\n    line-height: 1.6 !important;\n\n    text-align: center !important;\n  }\n\n  .h80-mini__action {\n    margin-top: 26px;\n  }\n\n  .h80-mini .h80-mini__cta {\n    min-width: 248px;\n    min-height: 55px;\n\n    gap: 23px;\n    padding: 6px 7px 6px 23px;\n\n    font-size: 13px !important;\n  }\n\n  .h80-mini__arrow {\n    width: 41px;\n    height: 41px;\n    flex-basis: 41px;\n  }\n}\n\n/* SMALL PHONES */\n\n@media (max-width: 360px) {\n  .h80-mini {\n    padding: 52px 12px 57px;\n  }\n\n  .h80-mini .h80-mini__title {\n    font-size: 29px !important;\n  }\n\n  .h80-mini .h80-mini__desc {\n    max-width: 290px;\n    font-size: 13px !important;\n  }\n}\n\n/* REDUCED MOTION */\n\n@media (prefers-reduced-motion: reduce) {\n  .h80-mini *,\n  .h80-mini *::before,\n  .h80-mini *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* HNDRD ENTRY CTA — MATCH RETAILER BUTTON */\n\n.h80-mini .h80-mini__cta,\n.h80-mini .h80-mini__cta:link,\n.h80-mini .h80-mini__cta:visited {\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n\n  width: min(100%, 340px) !important;\n  min-width: 0 !important;\n  min-height: 60px !important;\n\n  gap: 20px !important;\n  padding: 7px 8px 7px 25px !important;\n\n  background: #F7F8FA !important;\n  color: #111111 !important;\n\n  border: 1px solid #E1E3E7 !important;\n  border-radius: 999px !important;\n\n  box-shadow: 0 10px 25px rgba(0,0,0,.045) !important;\n\n  text-decoration: none !important;\n  transform: none;\n\n  -webkit-backdrop-filter: blur(16px);\n  backdrop-filter: blur(16px);\n}\n\n/* BOLD UPPERCASE LABEL */\n\n.h80-mini .h80-mini__cta-label {\n  color: #111111 !important;\n  font-size: 14px !important;\n  font-weight: 800 !important;\n  letter-spacing: .005em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap;\n}\n\n/* ORANGE CIRCLE */\n\n.h80-mini .h80-mini__arrow {\n  width: 46px !important;\n  height: 46px !important;\n  flex: 0 0 46px !important;\n\n  background: #FFA300 !important;\n  color: #111111 !important;\n  border-radius: 50% !important;\n}\n\n/* ARROW */\n\n.h80-mini .h80-mini__arrow svg {\n  width: 20px !important;\n  height: 20px !important;\n}\n\n/* KEEP THE SAME LOOK ON HOVER */\n\n@media (hover: hover) {\n  .h80-mini .h80-mini__cta:hover {\n    background: #F7F8FA !important;\n    border-color: #E1E3E7 !important;\n    box-shadow: 0 10px 25px rgba(0,0,0,.045) !important;\n    transform: none !important;\n  }\n}\n\n/* MOBILE — WIDER BUTTON */\n\n@media (max-width: 767px) {\n  .h80-mini .h80-mini__cta {\n    width: min(100%, 340px) !important;\n    min-height: 60px !important;\n    padding: 7px 8px 7px 22px !important;\n  }\n\n  .h80-mini .h80-mini__cta-label {\n    font-size: 13px !important;\n  }\n\n  .h80-mini .h80-mini__arrow {\n    width: 46px !important;\n    height: 46px !important;\n    flex-basis: 46px !important;\n  }\n}\n\n/* REDUCE DESKTOP SECTION PADDING ONLY */\n\n@media (min-width: 768px) {\n  .h80-mini {\n    padding-top: 4px !important;\n    padding-bottom: 19px !important;\n  }\n}\n\n</style>\n\n<section\n  class=\"h80-mini\"\n  id=\"hndrd-giveaway-entry\"\n  aria-labelledby=\"h80-mini-heading\"\n>\n  <div class=\"h80-mini__inner\">\n\n    <h2\n      class=\"h80-mini__title\"\n      id=\"h80-mini-heading\"\n    >\n      READY TO\n      <span class=\"h80-mini__accent\">ENTER?</span>\n    </h2>\n\n    <p class=\"h80-mini__desc\">\n      Your chance to win the HNDRD Nitrix 80 Bullet\n      starts here. Complete the official entry form\n      to participate.\n    </p>\n\n    <div class=\"h80-mini__action\">\n\n      <a\n        class=\"h80-mini__cta\"\n        href=\"https://forms.gle/vUTcGrcT1Ri7NH5S9\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"Complete your giveaway entry, opens in a new tab\"\n      >\n\n        <span class=\"h80-mini__cta-label\">\n          Complete your entry\n        </span>\n\n        <span\n          class=\"h80-mini__arrow\"\n          aria-hidden=\"true\"\n        >\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M5 12h14\"></path>\n            <path d=\"m13 6 6 6-6 6\"></path>\n          </svg>\n        </span>\n\n      </a>\n\n    </div>\n\n  </div>\n</section>",
