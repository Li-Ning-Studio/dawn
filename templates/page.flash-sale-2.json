    "custom_liquid_eHfdCT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 1b: Summer's Final Countdown (text-only). Paste into a Shopify \"Custom Liquid\" section, right below the hero. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  .hb-final-countdown{\n    --orange-1:#ff5a1f; --orange-2:#ff8a1f; --orange-3:#ffc61f; --ink:#0b0b0c; --white:#ffffff;\n    position:relative;\n    background:var(--ink);\n    padding:60px 24px;\n    text-align:center;\n    overflow:hidden;\n    font-family:'Inter',sans-serif;\n    box-sizing:border-box;\n  }\n  .hb-final-countdown *{box-sizing:border-box;}\n\n  /* subtle moving diagonal streaks, no images used */\n  .hb-final-countdown::before{\n    content:\"\";\n    position:absolute; inset:-20%;\n    background:repeating-linear-gradient(115deg, rgba(255,90,31,.06) 0 2px, transparent 2px 90px);\n    pointer-events:none;\n  }\n  .hb-final-countdown::after{\n    content:\"\";\n    position:absolute; left:50%; top:50%; width:900px; height:900px;\n    transform:translate(-50%,-50%);\n    background:radial-gradient(circle, rgba(255,138,31,.14) 0%, transparent 65%);\n    pointer-events:none;\n  }\n\n  .hb-fc-inner{position:relative; z-index:2; max-width:820px; margin:0 auto;}\n\n  .hb-fc-eyebrow{\n    display:inline-flex; align-items:center; gap:8px;\n    font-size:12px; font-weight:800; letter-spacing:2px; text-transform:uppercase;\n    color:var(--orange-2); margin-bottom:22px;\n  }\n  .hb-fc-eyebrow .hb-dot{\n    width:7px; height:7px; border-radius:50%; background:var(--orange-1);\n    box-shadow:0 0 0 4px rgba(255,90,31,.22);\n    animation:hb-fc-pulse 1.6s ease-in-out infinite;\n  }\n  @keyframes hb-fc-pulse{ 0%,100%{ box-shadow:0 0 0 4px rgba(255,90,31,.22);} 50%{ box-shadow:0 0 0 8px rgba(255,90,31,.06);} }\n\n  .hb-fc-heading{\n    font-family:'Anton',sans-serif;\n    text-transform:uppercase;\n    line-height:1.2;\n    font-size:clamp(44px, 7vw, 92px);\n    color:var(--white);\n    margin:0;\n  }\n  .hb-fc-heading .hb-hl{\n    background:linear-gradient(180deg,#fff6c8 0%, #ffb31f 45%, #ff4d00 100%);\n    -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n\n  .hb-fc-sub{\n    margin:26px auto 20px;\n    max-width:460px;\n    font-size:clamp(16px, 2vw, 20px);\n    font-weight:600;\n    color:#c9c9cd;\n  }\n  .hb-fc-sub b{color:var(--white); font-weight:800;}\n\n  .hb-fc-rule{\n    width:60px; height:3px; background:var(--orange-1); margin:34px auto; border-radius:2px;\n  }\n\n  .hb-fc-cta{\n    display:inline-flex; align-items:center; gap:10px;\n    background:var(--orange-1); color:var(--white);\n    font-weight:800; font-size:16px; letter-spacing:.4px;\n    padding:18px 42px; border-radius:50px;\n    text-decoration:none;\n    box-shadow:0 10px 28px rgba(255,90,31,.35);\n    transition:transform .18s ease, box-shadow .18s ease;\n  }\n  .hb-fc-cta:hover{ transform:translateY(-2px); box-shadow:0 14px 34px rgba(255,90,31,.45); }\n  .hb-fc-cta svg{width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2.5;}\n\n  @media (max-width:640px){\n    .hb-final-countdown{padding:80px 20px;}\n  }\n</style>\n\n<section class=\"hb-final-countdown\">\n  <div class=\"hb-fc-inner\">\n    <div class=\"hb-fc-eyebrow\"><span class=\"hb-dot\"></span>24 hours only</div>\n    <h2 class=\"hb-fc-heading\">Summer's <span class=\"hb-hl\">Final</span> Countdown</h2>\n    <p class=\"hb-fc-sub\">One day. <b>The biggest deals of summer.</b> Then they're gone.</p>\n    <div class=\"hb-fc-rule\"></div>\n    <a href=\"#products\" class=\"hb-fc-cta\">\n      Don't Wait\n      <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n    </a>\n  </div>\n</section>",
