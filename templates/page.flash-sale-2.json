    "custom_liquid_NJk9xG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 5: Freebies / Gift Vault (offer construct). Paste into a Shopify \"Custom Liquid\" section. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n .hb-freebies{\n    --orange-1:#ff5a1f; --orange-2:#ff8a1f; --orange-3:#ffc61f; --ink:#0b0b0c; --white:#ffffff;\n    background:linear-gradient(180deg,#0b0b0c 0%, #141416 100%); padding:90px 24px; position:relative;\n    font-family:'Inter',sans-serif; box-sizing:border-box;\n  }\n  .hb-freebies *{box-sizing:border-box;}\n  .hb-freebies-inner{max-width:1200px; margin:0 auto;}\n  .hb-gift-lead{display:inline-block; background:var(--orange-1); color:#fff; font-weight:800; font-size:12px; letter-spacing:1px; text-transform:uppercase; padding:6px 14px; border-radius:20px; margin-bottom:14px;}\n  .hb-freebies-title{font-family:'Anton',sans-serif; font-size:clamp(32px,5vw,52px); text-transform:uppercase; line-height:1.2; color:var(--white);}\n  .hb-freebies-title span{color:var(--orange-2);}\n  .hb-freebies-desc{color:#a9a9ad; max-width:520px; margin-top:10px; font-size:14px;}\n\n \n\n\n  .hb-tier-strip{margin-top:20px; background:#151517; border:1px solid #232326; border-radius:16px; padding:26px 30px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;}\n  .hb-tier-strip .hb-tlabel{display:flex; align-items:center; gap:12px;}\n  .hb-tier-strip .hb-tlabel .hb-badge8k{font-family:'Anton',sans-serif; font-size:26px; background:linear-gradient(160deg,var(--orange-3),var(--orange-1)); -webkit-background-clip:text; background-clip:text; color:transparent; -webkit-text-stroke:1px var(--ink);}\n  .hb-tier-strip p{font-size:13px; color:#a9a9ad; max-width:480px; margin:0;}\n  .hb-tier-strip .hb-tcta{background:var(--orange-1); color:#fff; font-weight:800; font-size:13px; padding:12px 24px; border-radius:30px; text-decoration:none; white-space:nowrap;}\n\n  @media (max-width:900px){\n    .hb-gift-grid{grid-template-columns:repeat(2,1fr);}\n    .hb-bonus-row{grid-template-columns:1fr;}\n    .hb-tier-strip{flex-direction:column; align-items:flex-start;}\n  }\n</style>\n\n<section class=\"hb-freebies\">\n  <div class=\"hb-freebies-inner\">\n    <span class=\"hb-gift-lead\">Buy more, get more</span>\n    <div class=\"hb-freebies-title\">Every Buy Comes <span>With A Gift</span></div>\n    <p class=\"hb-freebies-desc\">Shop the sale and walk away with a freebie on top — no code needed, it's added the moment the matching item hits your cart.</p>\n\n  \n\n    <div class=\"hb-tier-strip\">\n      <div class=\"hb-tlabel\">\n        <span class=\"hb-badge8k\">₹8K+</span>\n        <p>Spend over ₹8,000 on rackets and unlock a <strong style=\"color:#FF8A1F;\">FREE COSMOGEAR KIT BAG </strong>with your order.</p>\n      </div>\n      <a href=\"#products\" class=\"hb-tcta\">Unlock This Gift</a>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
