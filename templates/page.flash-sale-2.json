    "custom_liquid_XWmPHf": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 2b: Sticky bottom countdown bar (alt style). Paste into a Shopify \"Custom Liquid\" section. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  .hb-sticky-bar{\n    --orange-1:#ff5a1f; --orange-2:#ff8a1f; --blue-1:#0a3fb0; --blue-2:#1f6bff; --ink:#0b0b0c; --white:#ffffff;\n    position:fixed; left:0; right:0; bottom:0; z-index:999;\n    display:flex; align-items:center; justify-content:center; gap:22px; flex-wrap:wrap;\n    background:linear-gradient(90deg, var(--ink) 0%, #1a1a1d 100%);\n    border-top:3px solid var(--orange-1);\n    padding:12px 20px;\n    font-family:'Inter',sans-serif;\n    box-shadow:0 -10px 30px rgba(0,0,0,.35);\n    transform:translateY(0);\n    transition:transform .3s ease;\n    box-sizing:border-box;\n  }\n  .hb-sticky-bar *{box-sizing:border-box;}\n  .hb-sticky-bar.hb-hide{transform:translateY(100%);}\n\n  .hb-sb-msg{display:flex; align-items:center; gap:10px;}\n  .hb-sb-dot{width:9px; height:9px; border-radius:50%; background:var(--orange-1); box-shadow:0 0 0 4px rgba(255,90,31,.25); animation:hb-pulse 1.4s ease-in-out infinite;}\n  @keyframes hb-pulse{ 0%,100%{ box-shadow:0 0 0 4px rgba(255,90,31,.25);} 50%{ box-shadow:0 0 0 8px rgba(255,90,31,.08);} }\n  .hb-sb-msg span{font-weight:700; font-size:13px; color:var(--white); letter-spacing:.2px;}\n  .hb-sb-msg strong{color:var(--orange-2); font-weight:800;}\n\n  .hb-sb-timer{display:flex; align-items:center; gap:6px;}\n  .hb-sb-seg{\n    background:linear-gradient(160deg, var(--blue-2), var(--blue-1));\n    border-radius:8px; padding:6px 10px; min-width:44px; text-align:center;\n  }\n  .hb-sb-seg .hb-n{font-family:'Anton',sans-serif; font-size:18px; color:var(--white); line-height:1;}\n  .hb-sb-seg .hb-u{font-size:8px; font-weight:700; letter-spacing:.5px; color:#cfe0ff; text-transform:uppercase;}\n  .hb-sb-colon{font-family:'Anton',sans-serif; color:#555; font-size:16px;}\n\n  .hb-sb-cta{\n    background:var(--orange-1); color:var(--white); font-weight:800; font-size:13px;\n    letter-spacing:.3px; padding:11px 24px; border-radius:30px; text-decoration:none;\n    white-space:nowrap;\n  }\n  .hb-sb-close{\n    background:none; border:none; color:#7a7a80; font-size:18px; cursor:pointer; line-height:1;\n    padding:4px 6px;\n  }\n  .hb-sb-close:hover{color:#fff;}\n\n  body{padding-bottom:70px;} /* keeps page content clear of the fixed bar */\n\n  @media (max-width:640px){\n    .hb-sticky-bar{gap:12px; padding:10px 14px;}\n    .hb-sb-msg span{font-size:11.5px;}\n    .hb-sb-seg{min-width:36px; padding:5px 7px;}\n    .hb-sb-seg .hb-n{font-size:15px;}\n    .hb-sb-cta{padding:9px 16px; font-size:12px;}\n  }\n</style>\n\n<div class=\"hb-sticky-bar\" id=\"hb-sticky-bar\">\n  <div class=\"hb-sb-msg\">\n    <span class=\"hb-sb-dot\"></span>\n    <span><strong>BEAT THE HEAT</strong> ends in</span>\n  </div>\n\n  <div class=\"hb-sb-timer\" id=\"hb-sticky-timer\">\n    <div class=\"hb-sb-seg\"><div class=\"hb-n\" data-unit=\"hrs\">14</div><div class=\"hb-u\">Hrs</div></div>\n    <span class=\"hb-sb-colon\">:</span>\n    <div class=\"hb-sb-seg\"><div class=\"hb-n\" data-unit=\"min\">32</div><div class=\"hb-u\">Min</div></div>\n    <span class=\"hb-sb-colon\">:</span>\n    <div class=\"hb-sb-seg\"><div class=\"hb-n\" data-unit=\"sec\">08</div><div class=\"hb-u\">Sec</div></div>\n  </div>\n\n \n  \n</div>\n\n<script>\n (function(){\n    // Countdown target: July 6, 2026, 12:00 AM (local time)\n    var end = new Date(2026, 6, 6, 0, 0, 0);\n    var bar = document.getElementById('hb-sticky-bar');\n \n    function tick(){\n      var diff = Math.max(0, end - new Date());\n      var h = String(Math.floor(diff/3600000)).padStart(2,'0');\n      var m = String(Math.floor((diff%3600000)/60000)).padStart(2,'0');\n      var s = String(Math.floor((diff%60000)/1000)).padStart(2,'0');\n      bar.querySelector('[data-unit=\"hrs\"]').textContent = h;\n      bar.querySelector('[data-unit=\"min\"]').textContent = m;\n      bar.querySelector('[data-unit=\"sec\"]').textContent = s;\n      if(diff <= 0){ bar.classList.add('hb-hide'); clearInterval(timer); }\n    }\n    tick();\n    var timer = setInterval(tick, 1000);\n \n    document.getElementById('hb-sticky-close').addEventListener('click', function(){\n      bar.classList.add('hb-hide');\n      document.body.style.paddingBottom = '0';\n    });\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
