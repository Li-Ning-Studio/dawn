      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 4: Scrolling marquee strip. Paste into a Shopify \"Custom Liquid\" section. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&display=swap\" rel=\"stylesheet\">\n<style>\n  .hb-strip{\n    --blue-1:#0a3fb0; --blue-2:#1f6bff; --ink:#0b0b0c; --white:#ffffff;\n    background:linear-gradient(90deg,var(--blue-1),var(--blue-2)); padding:16px 0; overflow:hidden; white-space:nowrap;\n    border-top:3px solid var(--ink); border-bottom:3px solid var(--ink); box-sizing:border-box;\n  }\n  .hb-strip *{box-sizing:border-box;}\n  .hb-strip-track{display:inline-flex; gap:40px; animation:hb-scroll 22s linear infinite;}\n  .hb-strip-track span{font-family:'Anton',sans-serif; font-size:22px; text-transform:uppercase; letter-spacing:1px; color:var(--white);}\n  @keyframes hb-scroll{ from{transform:translateX(0);} to{transform:translateX(-50%);} }\n  @media (prefers-reduced-motion: reduce){ .hb-strip-track{animation:none;} }\n</style>\n\n<div class=\"hb-strip\">\n  <div class=\"hb-strip-track\">\n    <span>BEAT THE HEAT ★ UPTO 70% OFF ★ 24 HRS ONLY ★  COMBO OFFERS ★</span>\n    <span>BEAT THE HEAT ★ UPTO 70% OFF ★ 24 HRS ONLY ★  COMBO OFFERS ★</span>\n<span>BEAT THE HEAT ★ UPTO 70% OFF ★ 24 HRS ONLY ★ COMBO OFFERS ★</span>\n  </div>\n</div>",
