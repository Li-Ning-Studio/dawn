        "custom_liquid": "<div class=\"pbt\" id=\"pbt-prebook\">\n<style>\n.pbt{background:#000;color:#f5f5f7;padding:64px 20px;font-family:-apple-system,BlinkMacSystemFont,\"Inter\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\n.pbt *{box-sizing:border-box}\n.pbt-card{max-width:460px;margin:0 auto;padding:32px;border-radius:28px;background:linear-gradient(180deg,#262628,#101012);border:1px solid #ffffff1f}\n.pbt h2{margin:0 0 6px;font-size:28px;font-weight:700;letter-spacing:-.03em;color:#f5f5f7;text-transform:none}\n.pbt p{margin:0 0 22px;color:#a1a1a6;font-size:15px;line-height:1.5}\n.pbt label{display:block;margin:0 0 10px}\n.pbt label span{display:block;font-size:13px;color:#a1a1a6;margin-bottom:6px}\n.pbt input,.pbt select{display:block;width:100%;height:52px;margin:0;padding:0 14px;border-radius:14px;border:1px solid #ffffff1a;background:#ffffff0f;color:#f5f5f7;font:400 16px var(--f,inherit);outline:0;-webkit-appearance:none;appearance:none}\n.pbt input:focus,.pbt select:focus{border-color:#ff453ad9}\n.pbt select option{color:#000}\n.pbt-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.pbt-err{min-height:20px;margin:8px 2px 10px!important;font-size:13px;color:#ff6961}\n.pbt button{width:100%;height:54px;border:0;border-radius:999px;cursor:pointer;font-size:16px;font-weight:600;color:#fff;background:linear-gradient(180deg,#ff2d20,#e10600 55%,#c20500)}\n.pbt button[disabled]{opacity:.6;cursor:default}\n.pbt-msg{padding:14px 16px;border-radius:14px;margin-bottom:18px;font-size:15px}\n.pbt-msg.ok{background:#30d1581f;color:#30d158}\n.pbt-msg.no{background:#ff453a1f;color:#ff6961}\n</style>\n<div class=\"pbt-card\">\n  <div class=\"pbt-msg\" data-msg hidden></div>\n  <h2>Pre-book Hypercourt Adapt</h2>\n  <p>Pick your colour and size. <span data-amt></span></p>\n  <form data-form novalidate>\n    <label><span>Full name</span><input name=\"name\" autocomplete=\"name\" required></label>\n    <label><span>Email</span><input name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" required></label>\n    <label><span>Mobile number (+91)</span><input name=\"phone\" type=\"tel\" autocomplete=\"tel-national\" inputmode=\"numeric\" maxlength=\"10\" required></label>\n    <div class=\"pbt-row\">\n      <label><span>Colour</span><select name=\"colour\" required><option value=\"\">…</option></select></label>\n      <label><span>Size</span><select name=\"size\" required><option value=\"\">…</option></select></label>\n    </div>\n    <p class=\"pbt-err\" data-err role=\"alert\"></p>\n    <button type=\"submit\" data-go>Pre-book &amp; pay</button>\n  </form>\n</div>\n<script>\n(function () {\n  var root = document.getElementById('pbt-prebook');\n  // CHANGE THIS to your tunnel / server URL (no trailing slash)\nvar API = 'https://1950-171-76-87-209.ngrok-free.app'\n  var form = root.querySelector('[data-form]'), err = root.querySelector('[data-err]'),\n      go = root.querySelector('[data-go]'), msg = root.querySelector('[data-msg]');\n\n  // result after easebuzz sends the customer back (?prebook=success|failed)\n  var result = new URLSearchParams(location.search).get('prebook');\n  if (result) {\n    msg.hidden = false;\n    msg.className = 'pbt-msg ' + (result === 'success' ? 'ok' : 'no');\n    msg.textContent = result === 'success'\n      ? 'Payment received. Your pre-booking is confirmed.'\n      : 'Payment was not completed. Please try again.';\n  }\n\n  function fill(select, values, label) {\n    select.innerHTML = '<option value=\"\">' + label + '</option>' +\n      values.map(function (v) { return '<option>' + v + '</option>'; }).join('');\n  }\n\n  // must match PRE_BOOK_OPTIONS on the server, it rejects anything else\n  fill(form.colour, ['Grey / White', 'Black / Dk Grey / White', 'Grey / Black / Multi'], 'Choose colour');\n  fill(form.size, ['5', '6', '7', '8', '9', '10', '11'], 'Choose size');\n  root.querySelector('[data-amt]').textContent = 'Pre-book amount: ₹1.';\n\n  form.phone.addEventListener('input', function () {\n    this.value = this.value.replace(/\\D/g, '').slice(0, 10);\n  });\n\n  function check(d) {\n    if (d.name.length < 2) return 'Please enter your name.';\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(d.email)) return 'Please enter a valid email address.';\n    if (!/^[6-9]\\d{9}$/.test(d.phone)) return 'Please enter a valid 10-digit mobile number.';\n    if (!d.colour) return 'Please choose a colour.';\n    if (!d.size) return 'Please choose a size.';\n    return '';\n  }\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var d = {\n      name: form.name.value.trim().replace(/\\s+/g, ' '),\n      email: form.email.value.trim(),\n      phone: form.phone.value.replace(/\\D/g, ''),\n      colour: form.colour.value,\n      size: form.size.value\n    };\n    var problem = check(d);\n    err.textContent = problem;\n    if (problem) return;\n\n    go.disabled = true;\n    go.textContent = 'Taking you to payment…';\n    fetch(API + '/pre-book/initiate', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(d)\n    })\n      .then(function (r) { return r.json(); })\n      .then(function (res) {\n        if (res.payment_url) { location.href = res.payment_url; return; }\n        throw new Error(res.message);\n      })\n      .catch(function (e2) {\n        err.textContent = (e2 && e2.message) || 'Something went wrong, please try again.';\n        go.disabled = false;\n        go.textContent = 'Pre-book & pay';\n      });\n  });\n})();\n</script>\n</div>",
