      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 6: WHO CAN PLAY + WHAT TO BRING -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n/* --- WHO CAN PLAY --- */\n.sv6a{background:#1A0640;padding:80px 24px;text-align:center;}\n.sv6a .in{max-width:700px;margin:0 auto;}\n.sv6a .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv6a .ti{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.4rem,6vw,4.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv6a .desc{margin-top:20px;font-family:'Inter',sans-serif;font-size:1rem;color:#F0EAF8;opacity:.75;line-height:1.7;}\n.sv6a .pills{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:36px;}\n.sv6a .pill{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.05rem;letter-spacing:.1em;text-transform:uppercase;padding:14px 32px;border:2px solid;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:background .2s,color .2s;cursor:default;}\n.sv6a .pill-b{border-color:#F5C500;color:#F5C500;}\n.sv6a .pill-i{border-color:#fff;color:#fff;background:rgba(255,255,255,.08);}\n.sv6a .pill-a{border-color:#9B59CC;color:#9B59CC;}\n.sv6a .pill:hover{background:#F5C500;color:#1A0640;border-color:#F5C500;}\n.sv6a .note{margin-top:20px;font-family:'Inter',sans-serif;font-size:.88rem;color:#F0EAF8;opacity:.55;}\n\n/* --- WHAT TO BRING --- */\n.sv6b{background:linear-gradient(135deg,#2A0960,#3A0D7A);padding:80px 24px;position:relative;overflow:hidden;}\n.sv6b::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(-55deg,transparent,transparent 40px,rgba(245,197,0,.025) 40px,rgba(245,197,0,.025) 41px);}\n.sv6b .in{max-width:1100px;margin:0 auto;position:relative;z-index:1;}\n.sv6b .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv6b .ti{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.4rem,6vw,4.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv6b .gr{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:40px;}\n.sv6b .it{background:rgba(255,255,255,.05);border:1px solid rgba(245,197,0,.2);padding:24px 20px;text-align:center;clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);}\n.sv6b .ic{font-size:1.8rem;margin-bottom:8px;display:block;}\n.sv6b .nm{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.95rem;letter-spacing:.08em;text-transform:uppercase;color:#F0EAF8;}\n@media(max-width:600px){.sv6a .pills{gap:10px;}.sv6a .pill{padding:12px 22px;font-size:.9rem;}.sv6b .gr{grid-template-columns:1fr 1fr;}.sv6a,.sv6b{padding:60px 20px;}}\n</style>\n\n<!-- WHO CAN PLAY -->\n<section class=\"sv6a\">\n  <div class=\"in\">\n    <span class=\"ey\">Who Can Play</span>\n    <h2 class=\"ti\">All levels.<br>One court.</h2>\n    <p class=\"desc\">ShuttleVerse is built for everyone aged 16 and above. Whether you have never played a competitive match or you have been smashing since school — there is a spot for you.</p>\n    <div class=\"pills\">\n      <div class=\"pill pill-b\">🌱 Beginner</div>\n      <div class=\"pill pill-i\">⚡ Intermediate</div>\n      <div class=\"pill pill-a\">🔥 Advanced</div>\n    </div>\n    <p class=\"note\">No skill-level restrictions. Right-handed or left-handed. Just show up ready.</p>\n  </div>\n</section>\n\n<!-- WHAT TO BRING -->\n<section class=\"sv6b\">\n  <div class=\"in\">\n    <span class=\"ey\">Pack Your Bag</span>\n    <h2 class=\"ti\">What to bring</h2>\n    <div class=\"gr\">\n      <div class=\"it\"><span class=\"ic\">🏸</span><div class=\"nm\">Your Racket</div></div>\n      <div class=\"it\"><span class=\"ic\">👟</span><div class=\"nm\">Non-Marking Sports Shoes</div></div>\n      <div class=\"it\"><span class=\"ic\">💧</span><div class=\"nm\">Water Bottle</div></div>\n      <div class=\"it\"><span class=\"ic\">👕</span><div class=\"nm\">Comfortable Sportswear</div></div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_GwyNeF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 7: FAQ ACCORDION -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n.sv7{background:#1A0640;padding:80px 24px 100px;}\n.sv7 .in{max-width:800px;margin:0 auto;}\n.sv7 .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv7 .ti{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.4rem,6vw,4.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv7 .list{margin-top:48px;}\n.sv7 .fi{border-bottom:1px solid rgba(255,255,255,.1);}\n.sv7 .fq{width:100%;background:none;border:none;color:#fff;text-align:left;padding:20px 0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;letter-spacing:.03em;text-transform:uppercase;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;transition:color .2s;}\n.sv7 .fq:hover{color:#F5C500;}\n.sv7 .fa-arrow{flex-shrink:0;width:22px;height:22px;border:2px solid #F5C500;display:flex;align-items:center;justify-content:center;font-size:.9rem;color:#F5C500;transition:transform .25s;clip-path:polygon(4px 0%,100% 0%,calc(100% - 4px) 100%,0% 100%);line-height:1;}\n.sv7 .fi.open .fa-arrow{transform:rotate(45deg);}\n.sv7 .fa{max-height:0;overflow:hidden;font-family:'Inter',sans-serif;font-size:.95rem;color:#F0EAF8;opacity:.8;line-height:1.7;transition:max-height .35s ease,padding-bottom .35s ease;padding-bottom:0;}\n.sv7 .fi.open .fa{max-height:200px;padding-bottom:20px;}\n@media(max-width:600px){.sv7{padding:60px 20px 80px;}.sv7 .fq{font-size:1rem;}}\n</style>\n\n<section class=\"sv7\">\n  <div class=\"in\">\n    <span class=\"ey\">FAQ</span>\n    <h2 class=\"ti\">Got questions?</h2>\n    <div class=\"list\">\n\n      <div class=\"fi\">\n        <button class=\"fq\">Is the registration fee refundable?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">No. Registrations once confirmed are non-refundable and non-transferable unless the event is cancelled by HNDRD.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What happens after I pay?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">You will receive a confirmation message or email from the HNDRD team with your full registration details. Keep it handy on event day.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Can I register on the day?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">On-spot registrations may be available if slots remain open — but we strongly recommend registering in advance to secure your place.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Will shuttles be provided?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes. Event shuttles are provided by the organizers. Just bring your racket.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What if I arrive late?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Late arrivals may forfeit their scheduled matches or activities. Please report by 10:30 AM to make the most of the day.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Is there a skill-level restriction?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">No. ShuttleVerse is designed for players across all skill levels — Beginner, Intermediate, and Advanced. Everyone aged 16 and above is welcome.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Can spectators attend?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes, spectators are welcome subject to venue regulations and available space at Sportfit, JP Nagar.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Will there be prizes?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes. Winners and standout performers may receive prizes, merchandise, and exclusive HNDRD rewards.</div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var items = document.querySelectorAll('.sv7 .fi');\n  items.forEach(function(item){\n    item.querySelector('.fq').addEventListener('click', function(){\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.sv7 .fi.open').forEach(function(o){ o.classList.remove('open'); });\n      if(!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_LjMxTE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 8: FINAL CTA -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<!-- IMPORTANT: Replace href=\"YOUR_REGISTRATION_URL\" with your actual product/form URL.\n     The id=\"sv-register\" anchor is referenced by the sticky bar and hero buttons. -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n.sv8{background:linear-gradient(135deg,#5B1FA8,#3A0D7A);text-align:center;padding:100px 24px 120px;position:relative;overflow:hidden;clip-path:polygon(0 40px,100% 0,100% 100%,0 100%);}\n.sv8-bg{position:absolute;bottom:-20px;left:50%;transform:translateX(-50%);font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(6rem,20vw,16rem);letter-spacing:-.02em;color:rgba(255,255,255,.04);text-transform:uppercase;white-space:nowrap;pointer-events:none;line-height:1;user-select:none;}\n.sv8 .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:8px;display:block;position:relative;z-index:1;}\n.sv8-price{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(4rem,12vw,8rem);color:#F5C500;line-height:1;letter-spacing:-.01em;position:relative;z-index:1;}\n.sv8-sub{font-family:'Barlow Condensed',sans-serif;font-size:clamp(1.5rem,4vw,2.5rem);font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#fff;margin-top:4px;position:relative;z-index:1;}\n.sv8-body{font-family:'Inter',sans-serif;font-size:.95rem;color:#F0EAF8;opacity:.8;margin-top:16px;max-width:440px;margin-left:auto;margin-right:auto;line-height:1.6;position:relative;z-index:1;}\n.sv8-btn{display:inline-block;margin-top:36px;background:#F5C500;color:#1A0640;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.4rem;letter-spacing:.1em;text-transform:uppercase;padding:18px 56px;clip-path:polygon(14px 0%,100% 0%,calc(100% - 14px) 100%,0% 100%);cursor:pointer;border:none;text-decoration:none;transition:transform .15s,box-shadow .15s;position:relative;z-index:1;}\n.sv8-btn:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(245,197,0,.5);color:#1A0640;}\n.sv8-slots{margin-top:14px;font-family:'Barlow Condensed',sans-serif;font-size:.85rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#F0EAF8;opacity:.55;position:relative;z-index:1;}\n.sv8-tc{margin-top:32px;font-family:'Inter',sans-serif;font-size:.75rem;color:#F0EAF8;opacity:.35;line-height:1.6;max-width:560px;margin-left:auto;margin-right:auto;position:relative;z-index:1;}\n@media(max-width:600px){.sv8{clip-path:none;padding:70px 20px 100px;}.sv8-btn{padding:15px 36px;font-size:1.2rem;}}\n@media(prefers-reduced-motion:reduce){.sv8-btn{transition:none;}}\n</style>\n\n<section class=\"sv8\" id=\"sv-register\">\n  <div class=\"sv8-bg\" aria-hidden=\"true\">SHUTTLEVERSE</div>\n  <span class=\"ey\">Ready to play?</span>\n  <div class=\"sv8-price\">₹199</div>\n  <div class=\"sv8-sub\">Secure your slot now</div>\n  <p class=\"sv8-body\">Court access, organized gameplay, community experience, giveaways, prizes, and HNDRD access — all in one day.</p>\n  <!-- Replace href with your Shopify product page or registration form URL -->\n  <a href=\"YOUR_REGISTRATION_URL\" class=\"sv8-btn\">Register form BookMyShow</a> <a href=\"YOUR_REGISTRATION_URL\" class=\"sv8-btn\">Register form District</a> <a href=\"YOUR_REGISTRATION_URL\" class=\"sv8-btn\">Register for Swiggy Sceans</a>\n  <div class=\"sv8-slots\">⚠ Limited Slots · First Come, First Served</div>\n  <p class=\"sv8-tc\">Registration confirmed only after successful payment. Participants must follow venue and event rules. HNDRD reserves the right to modify schedules. Participants may be photographed or filmed for promotional purposes. Any misconduct may result in disqualification without refund. Event decisions made by organizers are final.</p>\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
