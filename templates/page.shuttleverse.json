    "custom_liquid_wEr9EG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 2: HERO (CTA ONLY)\n     Banner with event name sits ABOVE this section in Shopify.\n     This section contains only the tagline, CTA button, and price.\n     HOW TO ADD IN SHOPIFY:\n     Online Store → Themes → Customize → Add Section → Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sv-hero {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    padding: 60px 24px 100px;\n    text-align: center;\n    background: linear-gradient(135deg, #6D188C 0%, #2B0960 50%, #6D188C 100%);\n  }\n\n  /* Diagonal cut at bottom — transitions into gold quickfacts band */\n  .sv-hero__clip {\n    position: absolute;\n    bottom: -2px; left: 0; right: 0;\n    height: 80px;\n    background: #FFD400;\n    clip-path: polygon(0 100%, 100% 0, 100% 100%);\n    z-index: 3;\n  }\n\n  .sv-hero__content {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .sv-hero__tagline {\n    font-family: Figtree;\n    font-size: clamp(2rem, 2vw, 2.2rem);\n    color: #F0EAF8;\n    opacity: 0.85;\nmax-width: 600px;\n    line-height: 1.65;\n    margin: 0;\n  }\n\n  .sv-hero__cta {\n    display: inline-block;\n    margin-top: 36px;\n    background: #F5C500;\n    color: #1A0640;\n    font-family:Figtree;\n    font-weight: 800;\n    font-size: 1.9rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 16px 48px;\n    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);\n    cursor: pointer;\n    border: none;\n    text-decoration: none;\n    transition: transform 0.15s, box-shadow 0.15s;\n  }\n  .sv-hero__cta:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 32px rgba(245,197,0,0.45);\n    color: #1A0640;\n  }\n.tl_highlight{\ncolor:#F5C500;\nfont-weight: 600;\n}\n  .sv-hero__price {\n    margin-top: 14px;\n    font-family: Figtree;\n    font-size: 1.5rem;\n    color: #F5C500;\n    letter-spacing: 0.05em;\n    opacity: 0.9;\n  }\n  .sv-hero__price strong { font-size: 1.4rem; }\n\n  @media (max-width: 600px) {\n    .sv-hero { padding: 48px 20px 90px; }\n    .sv-hero__cta { font-size: 1.8rem; padding: 14px 36px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-hero__cta { transition: none; }\n  }\n</style>\n\n<section class=\"sv-hero\">\n  <div class=\"sv-hero__content\">\n    <p class=\"sv-hero__tagline\">\n      Step into <span class=\"tl_highlight\"> HNDRD Shuttleverse</span>, a gamified badminton experience filled with <span class=\"tl_highlight\"> exciting games, rewards, music, </span> and <span class=\"tl_highlight\"> a community </span> that loves the sport as much as you do. \n    </p>\n    <!-- Replace href with your registration URL -->\n    <a href=\"#sv-register\" class=\"sv-hero__cta\">Claim Your Spot</a>\n    <div class=\"sv-hero__price\">Only <strong>₹299</strong> per participant &nbsp;·&nbsp; Limited slots</div>\n  </div>\n  <div class=\"sv-hero__clip\" aria-hidden=\"true\"></div>\n</section>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_THcEDW": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 3: QUICKFACTS BAND\n     HOW TO ADD IN SHOPIFY:\n     Online Store → Themes → Customize → Add Section → Custom HTML\n     Place this section immediately below the Hero section.\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sv-qf {\n    background: #F5C500;\n    color: #1A0640;\n    padding: 28px 40px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 0;\n    position: relative;\n    z-index: 2;\n  }\n\n  .sv-qf__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 0 36px;\n    border-right: 2px solid rgba(58,13,122,0.2);\n  }\n  .sv-qf__item:last-child { border-right: none; }\n\n  .sv-qf__label {\n    font-family: 'Inter', sans-serif;\n    font-size: 1.62rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;\n    opacity: 0.6;\n    color: #1A0640;\n  }\n\n  .sv-qf__value {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 2.2rem;\n    letter-spacing: 0.03em;\n    line-height: 1.1;\n    margin-top: 2px;\n    color: #1A0640;\n  }\n\n  @media (max-width: 600px) {\n    .sv-qf {\n      flex-direction: column;\n      gap: 14px;\n      padding: 24px 20px;\n    }\n    .sv-qf__item {\n      border-right: none;\n      border-bottom: 1px solid rgba(58,13,122,0.15);\n      padding: 12px 0;\n      width: 100%;\n      text-align: center;\n    }\n    .sv-qf__item:last-child { border-bottom: none; }\n  }\n</style>\n\n<div class=\"sv-qf\">\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Date</span>\n    <span class=\"sv-qf__value\">28 JUN 2026</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Venue</span>\n    <span class=\"sv-qf__value\">SPORTFIT, JP NAGAR</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Reporting</span>\n    <span class=\"sv-qf__value\">10:30 AM</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Duration</span>\n    <span class=\"sv-qf__value\">4–5 HOURS</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Entry Fee</span>\n    <span class=\"sv-qf__value\">₹199</span>\n  </div>\n</div>",
