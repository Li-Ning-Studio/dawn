      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 5: EVENT DETAILS -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n.sv5{background:#3A0D7A;position:relative;overflow:hidden;clip-path:polygon(0 40px,100% 0,100% calc(100% - 40px),0 100%);padding:100px 24px;}\n.sv5 .in{max-width:1100px;margin:0 auto;}\n.sv5 .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv5 .ti{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.4rem,6vw,4.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv5 .gr{display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:48px;align-items:start;}\n.sv5 .bl{margin-bottom:28px;}\n.sv5 .bl:last-child{margin-bottom:0;}\n.sv5 .lb{font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:#F5C500;opacity:.8;margin-bottom:4px;display:block;}\n.sv5 .vl{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3.5vw,2.4rem);letter-spacing:.01em;line-height:1.1;color:#fff;}\n.sv5 .sb{font-family:'Inter',sans-serif;font-size:.9rem;color:#F0EAF8;opacity:.7;margin-top:4px;}\n.sv5 .dv{width:40px;height:3px;background:#F5C500;margin:10px 0 0;}\n@media(max-width:680px){.sv5 .gr{grid-template-columns:1fr;gap:0;}.sv5{clip-path:none;padding:70px 20px;}}\n</style>\n<section class=\"sv5\"><div class=\"in\">\n  <span class=\"ey\">Event Details</span>\n  <h2 class=\"ti\">Mark the<br>calendar</h2>\n  <div class=\"gr\">\n    <div>\n      <div class=\"bl\"><span class=\"lb\">Date</span><div class=\"vl\">Saturday, 28 June 2026</div><div class=\"dv\"></div></div>\n      <div class=\"bl\"><span class=\"lb\">Reporting Time</span><div class=\"vl\">10:30 AM onwards</div><div class=\"sb\">Arrive on time — late arrivals may forfeit their first matches</div><div class=\"dv\"></div></div>\n      <div class=\"bl\"><span class=\"lb\">Duration</span><div class=\"vl\">4–5 Hours</div><div class=\"dv\"></div></div>\n    </div>\n    <div>\n      <div class=\"bl\"><span class=\"lb\">Venue</span><div class=\"vl\">Sportfit, JP Nagar</div><div class=\"sb\">Bangalore 560078</div><div class=\"dv\"></div></div>\n      <div class=\"bl\"><span class=\"lb\">Organized By</span><div class=\"vl\">HNDRD</div><div class=\"dv\"></div></div>\n      <div class=\"bl\"><span class=\"lb\">Spectators</span><div class=\"vl\">Welcome</div><div class=\"sb\">Subject to venue regulations and available space</div><div class=\"dv\"></div></div>\n    </div>\n  </div>\n</div></section>",
