      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 2: HERO\n     HOW TO ADD IN SHOPIFY:\n     Online Store → Themes → Customize → Add Section → Custom HTML\n     Paste this entire block.\n     NOTE: The font import is included here. If Section 1 (Sticky Bar)\n     is already on the page, you can remove the duplicate <link> tag\n     at the top of this section to keep the page clean.\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sv-hero {\n    position: relative;\n    min-height: 00vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    padding: 80px 24px 120px;\n    text-align: center;\n    background: linear-gradient(135deg, #1A0640 0%, #3A0D7A 40%, #5B1FA8 70%, #3A0D7A 100%);\n  }\n\n  /* Diagonal slash background — brand signature */\n  .sv-hero__slashes {\n    position: absolute; inset: 0;\n    z-index: 1;\n    overflow: hidden;\n    pointer-events: none;\n  }\n  .sv-hero__slashes svg {\n    width: 100%; height: 100%;\n    position: absolute; inset: 0;\n  }\n\n  /* Diagonal cut at bottom */\n  .sv-hero__clip {\n    position: absolute;\n    bottom: -2px; left: 0; right: 0;\n    height: 80px;\n    background: #F5C500; /* matches quickfacts band below */\n    clip-path: polygon(0 100%, 100% 0, 100% 100%);\n    z-index: 3;\n  }\n\n  .sv-hero__content {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .sv-hero__lockup {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 20px;\n  }\n\n  .sv-hero__presents {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(0.7rem, 1.5vw, 0.95rem);\n    letter-spacing: 0.4em;\n    color: #F5C500;\n    text-transform: uppercase;\n  }\n\n  .sv-hero__mark svg {\n    width: 56px; height: 40px;\n    display: block;\n  }\n\n  .sv-hero__title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(5rem, 18vw, 14rem);\n    line-height: 0.88;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    text-shadow: 0 0 80px rgba(245,197,0,0.25);\n    margin: 0;\n  }\n  .sv-hero__title .sv-shuttle { color: #F5C500; display: block; }\n  .sv-hero__title .sv-verse   { color: #ffffff; display: block; }\n\n  .sv-hero__year {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: clamp(1.2rem, 3vw, 1.8rem);\n    letter-spacing: 0.5em;\n    color: #F5C500;\n    margin-top: 8px;\n  }\n\n  .sv-hero__tagline {\n    font-family: 'Inter', sans-serif;\n    font-size: clamp(1rem, 2vw, 1.15rem);\n    color: #F0EAF8;\n    opacity: 0.85;\n    margin-top: 28px;\n    max-width: 480px;\n    line-height: 1.65;\n  }\n\n  .sv-hero__cta {\n    display: inline-block;\n    margin-top: 36px;\n    background: #F5C500;\n    color: #1A0640;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 1.3rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 16px 48px;\n    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);\n    cursor: pointer;\n    border: none;\n    text-decoration: none;\n    transition: transform 0.15s, box-shadow 0.15s;\n  }\n  .sv-hero__cta:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 32px rgba(245,197,0,0.45);\n    color: #1A0640;\n  }\n\n  .sv-hero__price {\n    margin-top: 14px;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 1rem;\n    color: #F5C500;\n    letter-spacing: 0.05em;\n    opacity: 0.9;\n  }\n  .sv-hero__price strong { font-size: 1.4rem; }\n\n  @media (max-width: 600px) {\n    .sv-hero { padding: 60px 20px 100px; min-height: 90vh; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-hero__cta { transition: none; }\n  }\n</style>\n\n<section class=\"sv-hero\">\n\n  <!-- Decorative diagonal slashes + floating shuttlecocks -->\n  <div class=\"sv-hero__slashes\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 1440 900\" preserveAspectRatio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- Subtle beam bands -->\n      <line x1=\"300\" y1=\"900\" x2=\"1000\" y2=\"-100\" stroke=\"rgba(255,255,255,0.04)\" stroke-width=\"80\"/>\n      <line x1=\"900\" y1=\"900\" x2=\"1600\" y2=\"-100\" stroke=\"rgba(91,31,168,0.4)\" stroke-width=\"120\"/>\n      <!-- Gold slash lines -->\n      <line x1=\"-100\" y1=\"900\" x2=\"600\"  y2=\"-100\" stroke=\"rgba(245,197,0,0.12)\" stroke-width=\"2\"/>\n      <line x1=\"100\"  y1=\"900\" x2=\"800\"  y2=\"-100\" stroke=\"rgba(245,197,0,0.06)\" stroke-width=\"1\"/>\n      <line x1=\"800\"  y1=\"900\" x2=\"1500\" y2=\"-100\" stroke=\"rgba(245,197,0,0.08)\" stroke-width=\"1.5\"/>\n      <line x1=\"1000\" y1=\"900\" x2=\"1700\" y2=\"-100\" stroke=\"rgba(245,197,0,0.05)\" stroke-width=\"1\"/>\n      <!-- Shuttlecock top-left -->\n      <g transform=\"translate(60,80) rotate(-35)\" opacity=\"0.15\">\n        <ellipse cx=\"0\" cy=\"0\" rx=\"18\" ry=\"24\" fill=\"#F5C500\"/>\n        <rect x=\"-3\" y=\"24\" width=\"6\" height=\"50\" fill=\"#F5C500\"/>\n        <ellipse cx=\"0\" cy=\"24\" rx=\"8\" ry=\"5\" fill=\"#C49A00\"/>\n      </g>\n      <!-- Shuttlecock bottom-right -->\n      <g transform=\"translate(1360,760) rotate(20)\" opacity=\"0.12\">\n        <ellipse cx=\"0\" cy=\"0\" rx=\"22\" ry=\"30\" fill=\"#F5C500\"/>\n        <rect x=\"-4\" y=\"30\" width=\"8\" height=\"60\" fill=\"#F5C500\"/>\n        <ellipse cx=\"0\" cy=\"30\" rx=\"10\" ry=\"6\" fill=\"#C49A00\"/>\n      </g>\n    </svg>\n  </div>\n\n  <div class=\"sv-hero__content\">\n    <div class=\"sv-hero__lockup\">\n      <!-- HNDRD mark (SVG racket-slash logo) -->\n      <div class=\"sv-hero__mark\" aria-label=\"HNDRD\">\n        <svg viewBox=\"0 0 56 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M8 32 L28 8 L48 32\" stroke=\"white\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <path d=\"M16 24 L28 8\" stroke=\"#F5C500\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        </svg>\n      </div>\n      <div class=\"sv-hero__presents\">HNDRD presents</div>\n    </div>\n\n    <h1 class=\"sv-hero__title\">\n      <span class=\"sv-shuttle\">Shuttle</span>\n      <span class=\"sv-verse\">Verse</span>\n    </h1>\n    <div class=\"sv-hero__year\">2026</div>\n\n    <p class=\"sv-hero__tagline\">\n      The ultimate badminton community experience — where competition meets community. All skill levels welcome.\n    </p>\n\n    <!-- Replace href with your registration URL -->\n    <a href=\"#sv-register\" class=\"sv-hero__cta\">Claim Your Spot</a>\n    <div class=\"sv-hero__price\">Only <strong>₹199</strong> per participant &nbsp;·&nbsp; Limited slots</div>\n  </div>\n\n  <div class=\"sv-hero__clip\" aria-hidden=\"true\"></div>\n</section>",
