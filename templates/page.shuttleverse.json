    "custom_liquid_HfFkYp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 4: WHATS INCLUDED -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n.sv4{background:linear-gradient(180deg,#1A0640,#2A0960);padding:80px 24px;position:relative;overflow:hidden;}\n.sv4::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:#F5C500;}\n.sv4 .in{max-width:1100px;margin:0 auto;}\n.sv4 .ey{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv4 .ti{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.4rem,6vw,4.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv4 .gr{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;margin-top:48px;background:rgba(255,255,255,.05);}\n.sv4 .ca{background:rgba(91,31,168,.25);padding:32px 28px;border-left:3px solid transparent;position:relative;overflow:hidden;transition:border-color .2s,background .2s;opacity:0;transform:translateY(20px);}\n.sv4 .ca::after{content:'';position:absolute;top:0;right:0;width:0;height:0;border-style:solid;border-width:0 32px 32px 0;border-color:transparent #F5C500 transparent transparent;opacity:0;transition:opacity .2s;}\n.sv4 .ca:hover{border-left-color:#F5C500;background:rgba(91,31,168,.5);}\n.sv4 .ca:hover::after{opacity:1;}\n.sv4 .ic{font-size:2rem;margin-bottom:14px;display:block;}\n.sv4 .ct{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;letter-spacing:.05em;text-transform:uppercase;color:#fff;margin-bottom:8px;}\n.sv4 .cd{font-family:'Inter',sans-serif;font-size:.88rem;color:#F0EAF8;opacity:.75;line-height:1.6;}\n@media(max-width:600px){.sv4 .gr{grid-template-columns:1fr;}.sv4{padding:60px 20px;}}\n@media(prefers-reduced-motion:reduce){.sv4 .ca{opacity:1!important;transform:none!important;}}\n</style>\n<div class=\"sv4\"><div class=\"in\">\n  <span class=\"ey\">What's Included</span>\n  <h2 class=\"ti\">Everything<br>you need to play</h2>\n  <div class=\"gr\">\n    <div class=\"ca\"><span class=\"ic\">🏸</span><div class=\"ct\">Event Entry</div><p class=\"cd\">Full day access to all scheduled matches, challenges, and court activities.</p></div>\n    <div class=\"ca\"><span class=\"ic\">🎯</span><div class=\"ct\">Shuttles Provided</div><p class=\"cd\">Official event shuttles supplied by organizers — just bring your racket.</p></div>\n    <div class=\"ca\"><span class=\"ic\">🏆</span><div class=\"ct\">Prizes and Giveaways</div><p class=\"cd\">Prizes, merchandise, and exclusive HNDRD rewards for standout performers.</p></div>\n    <div class=\"ca\"><span class=\"ic\">🤝</span><div class=\"ct\">Community Access</div><p class=\"cd\">Network with fellow enthusiasts and get exclusive HNDRD experiences and offers.</p></div>\n    <div class=\"ca\"><span class=\"ic\">🎪</span><div class=\"ct\">Brand Activations</div><p class=\"cd\">Interactive brand zones, product experiences, and exclusive HNDRD drops.</p></div>\n    <div class=\"ca\"><span class=\"ic\">🍱</span><div class=\"ct\">Lunch Available</div><p class=\"cd\">Food available at the venue. Additional charges apply.</p></div>\n  </div>\n</div></div>\n<script>\n(function(){var cs=document.querySelectorAll('.sv4 .ca');if(!cs.length)return;var ob=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var el=e.target,i=Array.prototype.indexOf.call(cs,el);setTimeout(function(){el.style.opacity='1';el.style.transform='translateY(0)';el.style.transition='opacity .45s ease,transform .45s ease,border-color .2s,background .2s';},i*70);ob.unobserve(el);}});},{threshold:.1});cs.forEach(function(c){ob.observe(c);});})();\n</script>",
