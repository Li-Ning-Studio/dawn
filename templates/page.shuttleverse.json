    "custom_liquid_HfFkYp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 4: WHAT'S INCLUDED\n     Shopify: Themes > Customize > Add Section > Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* ── Section wrapper ── */\n  .sv-included {\n    background: linear-gradient(180deg, #4E1164 0%, #2A0960 100%);\n    padding: 80px 24px;\n    position: relative;\n  }\n\n  /* Gold top accent line */\n  .sv-included::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 4px;\n    background: #F5C500;\n  }\n\n  .sv-included__inner {\n    max-width: 860px;\n    margin: 0 auto;\n  }\n\n  /* ── Section header ── */\n  .sv-included__eyebrow {\n    display: block;\n    font-family: Figtree;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #F5C500;\n    margin-bottom: 12px;\n  }\n\n  .sv-included__title {\n    font-family: Figtree;\n    font-weight: 900;\n    font-size: clamp(3.8rem, 6vw, 4.5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0;\n  }\n\n  /* ── 2-column card grid ── */\n  .sv-included__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 48px;\n  }\n\n  /* ── Individual card ── */\n  .sv-included__card {\n    background: rgba(91, 31, 168, 0.25);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-left: 3px solid transparent;\n    padding: 32px 28px;\n    position: relative;\n    overflow: hidden;\n    transition: border-left-color 0.2s, background 0.2s;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  /* Gold corner tag on hover */\n  .sv-included__card::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    border-style: solid;\n    border-width: 0 28px 28px 0;\n    border-color: transparent #F5C500 transparent transparent;\n    opacity: 0;\n    transition: opacity 0.2s;\n  }\n\n  .sv-included__card:hover {\n    border-left-color: #F5C500;\n    background: rgba(91, 31, 168, 0.45);\n  }\n\n  .sv-included__card:hover::after {\n    opacity: 1;\n  }\n\n  .sv-included__icon {\n    font-size: 2.5rem;\n    display: block;\n    margin-bottom: 14px;\n  }\n\n  .sv-included__card-title {\n    font-family: Figtree;\n    font-weight: 800;\n    font-size: 2.15rem;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 8px 0;\n  }\n\n  .sv-included__card-desc {\n    font-family: Figtree;\n    font-size: 1.49rem;\n    color: #F0EAF8;\n    opacity: 0.75;\n    line-height: 1.65;\n    margin: 0;\n  }\n\n  /* ── Responsive ── */\n  @media (max-width: 600px) {\n    .sv-included { padding: 60px 20px; }\n    .sv-included__grid { grid-template-columns: 1fr; gap: 12px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-included__card {\n      opacity: 1 !important;\n      transform: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<section class=\"sv-included\">\n  <div class=\"sv-included__inner\">\n\n    <span class=\"sv-included__eyebrow\">What's Included</span>\n    <h2 class=\"sv-included__title\">Everything<br>you need to play</h2>\n\n    <div class=\"sv-included__grid\">\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Event Entry</h3>\n        <p class=\"sv-included__card-desc\">Full day access to all scheduled matches, challenges, and court activities.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Shuttles & Rackets Provided</h3>\n        <p class=\"sv-included__card-desc\">Official event shuttles & rackets provided by the organizers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Prizes </h3>\n        <p class=\"sv-included__card-desc\">Prizes, merchandise, and exclusive HNDRD rewards for standout performers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Community Access</h3>\n        <p class=\"sv-included__card-desc\">Network with fellow enthusiasts and get exclusive HNDRD experiences and offers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Brand Activations</h3>\n        <p class=\"sv-included__card-desc\">Interactive brand zones, product experiences, and exclusive HNDRD drops on the day.</p>\n      </div>\n\n     <!-- <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Food Stalls Available</h3>\n        <p class=\"sv-included__card-desc\">Food available at the venue. <i>Additional charges apply, Based on venue.</i></p>\n      </div> -->\n\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var cards = document.querySelectorAll('.sv-included__card');\n    if (!cards.length) return;\n\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          var card = entry.target;\n          var index = Array.prototype.indexOf.call(cards, card);\n          setTimeout(function () {\n            card.style.opacity = '1';\n            card.style.transform = 'translateY(0)';\n            card.style.transition = 'opacity 0.45s ease, transform 0.45s ease, border-left-color 0.2s, background 0.2s';\n          }, index * 80);\n          observer.unobserve(card);\n        }\n      });\n    }, { threshold: 0.1 });\n\n    cards.forEach(function (card) {\n      observer.observe(card);\n    });\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_UndVHN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 5: EVENT DETAILS\n     Shopify: Themes > Customize > Add Section > Custom HTML\n\n     Design: Vertical info strip. Each detail is a full-width row\n     with an SVG icon, label, and value — all connected by a gold\n     vertical timeline line. Mobile-first: reads perfectly as a\n     single column on any screen size. The date row is hero-sized\n     to anchor the section. Alternating row tints add rhythm.\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n  /* ── Section wrapper ── */\n  .sv-details {\n    background: #4E1164;\n    padding: 80px 24px;\n  }\n\n  .sv-details__inner {\n    max-width: 640px;\n    margin: 0 auto;\n  }\n\n  /* ── Section header ── */\n  .sv-details__eyebrow {\n    display: block;\n    font-family:Figtree;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #FFD400;\n    margin-bottom: 12px;\n  }\n\n  .sv-details__title {\n    font-family: Figtree;\n    font-weight: 900;\n    font-size: clamp(4.4rem, 8vw, 5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 48px 0;\n  }\n\n  /* ── Timeline container ── */\n  .sv-details__timeline {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* The vertical gold line running through all rows */\n  .sv-details__timeline::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 27px;\n    width: 2px;\n    background: linear-gradient(\n      to bottom,\n      transparent 0%,\n      #F5C500 8%,\n      #F5C500 92%,\n      transparent 100%\n    );\n    z-index: 0;\n  }\n\n  /* ── Individual row ── */\n  .sv-details__row {\n    display: flex;\n    align-items: flex-start;\n    gap: 24px;\n    padding: 24px 20px 24px 0;\n    position: relative;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n    transition: background 0.2s;\n  }\n\n  .sv-details__row:first-child { padding-top: 0; }\n  .sv-details__row:last-child  { border-bottom: none; padding-bottom: 0; }\n\n  .sv-details__row:hover {\n    background: rgba(245, 197, 0, 0.04);\n   \n  }\n\n  /* ── Icon node on the timeline ── */\n  .sv-details__node {\n    flex-shrink: 0;\n    width: 56px;\n    height: 56px;\n    background: #6D188C;\n    border: 2px solid rgba(245, 197, 0, 0.35);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    z-index: 1;\n    transition: border-color 0.2s, background 0.2s;\n  }\n\n  .sv-details__row:hover .sv-details__node {\n    border-color: #F5C500;\n    background: #3A0D7A;\n  }\n\n  .sv-details__node svg {\n    width: 22px;\n    height: 22px;\n  }\n\n  /* ── Text block ── */\n  .sv-details__text {\n    flex: 1;\n    padding-top: 10px;\n  }\n\n  .sv-details__label {\n    display: block;\n    font-family: Figtree;\n    font-size: 1.265rem;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #F5C500;\n    opacity: 0.75;\n    margin-bottom: 4px;\n  }\n\n  .sv-details__value {\n    font-family: Figtree;\n    font-weight: 700;\n    font-size: clamp(2.8rem, 4vw, 4rem);\n    line-height: 1;\n    text-transform: uppercase;\n    color: #ffffff;\n    letter-spacing: 0.02em;\n  }\n\n  .sv-details__sub {\n    display: block;\n    font-family: Figtree;\n    font-size: 1.28rem;\n    color: #F0EAF8;\n    opacity: 0.5;\n    margin-top: 5px;\n    line-height: 1.5;\n  }\n\n  /* ── Hero date row — visually dominant ── */\n  .sv-details__row--date .sv-details__node {\n    width: 56px;\n    height: 56px;\n    background: #F5C500;\n    border-color: #F5C500;\n  }\n\n  .sv-details__row--date .sv-details__node svg {\n    color: #1A0640;\n  }\n\n  .sv-details__row--date .sv-details__value {\n    font-size: clamp(2rem, 7vw, 3rem);\n    color: #F5C500;\n  }\n\n  @media (max-width: 480px) {\n    .sv-details { padding: 60px 20px; }\n    .sv-details__row { gap: 18px; }\n    .sv-details__node { width: 48px; height: 48px; }\n    .sv-details__node svg { width: 18px; height: 18px; }\n    .sv-details__timeline::before { left: 23px; }\n  }\n\n</style>\n\n<section class=\"sv-details\">\n  <div class=\"sv-details__inner\">\n\n    <span class=\"sv-details__eyebrow\">Event Details</span>\n    <h2 class=\"sv-details__title\">Mark the<br>calendar</h2>\n\n    <div class=\"sv-details__timeline\">\n\n      <!-- DATE — hero row -->\n      <div class=\"sv-details__row sv-details__row--date\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1A0640\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/>\n            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n            <line x1=\"8\"  y1=\"2\" x2=\"8\"  y2=\"6\"/>\n            <line x1=\"3\"  y1=\"10\" x2=\"21\" y2=\"10\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Date</span>\n          <div class=\"sv-details__value\">Sunday, 27th Sept 2026</div>\n        </div>\n      </div>\n\n      <!-- TIME -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n            <polyline points=\"12 7 12 12 15 15\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Reporting Time</span>\n          <div class=\"sv-details__value\">5:00 PM onwards</div>\n          <span class=\"sv-details__sub\">Late arrivals may forfeit their first matches</span>\n        </div>\n      </div>\n\n      <!-- VENUE -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z\"/>\n            <circle cx=\"12\" cy=\"9\" r=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Venue</span>\n          <div class=\"sv-details__value\">Fly16 Arena (Vinode Nagar),Pune</div>\n        <a  href=\"https://maps.app.goo.gl/V252nN7VUWEnvYzz6\" style=\"color: red; text-decoration: none; font-size: 20px;\">  <span class=\"\" >Get Directions -></span></a>\n        </div>\n      </div>\n\n      <!-- DURATION -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Duration</span>\n          <div class=\"sv-details__value\">3 Hours</div>\n          <span class=\"sv-details__sub\">Approximately</span>\n        </div>\n      </div>\n\n      <!-- ENTRY FEE -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"2\" y=\"6\" width=\"20\" height=\"13\" rx=\"2\"/>\n            <path d=\"M2 10h20\"/>\n            <circle cx=\"12\" cy=\"15\" r=\"1.5\" fill=\"#F5C500\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Entry Fee</span>\n          <div class=\"sv-details__value\">₹299</div>\n          <span class=\"sv-details__sub\">Per participant · Limited slots available</span>\n        </div>\n      </div>\n\n      <!-- ORGANIZED BY -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/>\n            <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n            <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/>\n            <path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Organized By</span>\n          <div class=\"sv-details__value\">HNDRD</div>\n          <span class=\"sv-details__sub\">Spectators welcome · Subject to venue capacity</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
