    "custom_liquid_cFMhfJ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 6: WHO CAN PLAY + WHAT TO BRING\n     Shopify: Themes > Customize > Add Section > Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<!-- ═══════════════════════════════════════════\n     PART A — WHO CAN PLAY\n     Three level cards side by side, each with\n     a large number rank, level name, and a short\n     description of what that player looks like.\n════════════════════════════════════════════ -->\n<style>\n  .sv-who {\n    background: #2A0960;\n    padding: 80px 24px;\n  }\n\n  .sv-who__inner {\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  .sv-who__eyebrow {\n    display: block;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #F5C500;\n    margin-bottom: 12px;\n  }\n\n  .sv-who__title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(4.4rem, 6vw, 5.5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 48px 0;\n  }\n\n  /* Three level cards in a row */\n  .sv-who__levels {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 2px;\n  }\n\n  .sv-who__level {\n    position: relative;\n    padding: 40px 28px 36px;\n    background: rgba(91, 31, 168, 0.2);\n    border-top: 3px solid transparent;\n    overflow: hidden;\n    transition: background 0.25s, border-top-color 0.25s;\n  }\n\n  /* Accent colour per level via modifier */\n  .sv-who__level--beginner     { border-top-color: #F5C500; }\n  .sv-who__level--intermediate { border-top-color: rgba(255,255,255,0.4); }\n  .sv-who__level--advanced     { border-top-color: #9B59CC; }\n\n  .sv-who__level:hover { background: rgba(91, 31, 168, 0.45); }\n\n  /* Ghost number watermark */\n  .sv-who__level-num {\n    position: absolute;\n    top: -10px;\n    right: 16px;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 10rem;\n    line-height: 1;\n    color: rgba(255, 255, 255, 0.04);\n    user-select: none;\n    pointer-events: none;\n  }\n\n  .sv-who__level-icon {\n    font-size: 2.5rem;\n    display: block;\n    margin-bottom: 16px;\n  }\n\n  .sv-who__level-name {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 2.4rem;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 10px 0;\n  }\n\n  .sv-who__level-desc {\n    font-family: 'Inter', sans-serif;\n    font-size: 1.3rem;\n    color: #F0EAF8;\n    opacity: 0.65;\n    line-height: 1.65;\n    margin: 0;\n  }\n\n  .sv-who__footnote {\n    margin-top: 24px;\n    font-family: 'Inter', sans-serif;\n    font-size: 1.482rem;\n    color: #F0EAF8;\n    opacity: 0.45;\n    letter-spacing: 0.02em;\n  }\n\n  @media (max-width: 680px) {\n    .sv-who__levels { grid-template-columns: 1fr; gap: 2px; }\n    .sv-who { padding: 60px 20px; }\n  }\n</style>\n<!--\n<section class=\"sv-who\">\n  <div class=\"sv-who__inner\">\n\n    <span class=\"sv-who__eyebrow\">Who Can Play</span>\n    <h2 class=\"sv-who__title\">All levels.<br>One court.</h2>\n\n    <div class=\"sv-who__levels\">\n\n      <div class=\"sv-who__level sv-who__level--beginner\">\n        <span class=\"sv-who__level-num\" aria-hidden=\"true\">01</span>\n        <span class=\"sv-who__level-icon\">🌱</span>\n        <h3 class=\"sv-who__level-name\">Beginner</h3>\n        <p class=\"sv-who__level-desc\">New to badminton or just getting started. You play for fun, fitness, and the love of the game. No experience needed — just show up.</p>\n      </div>\n\n      <div class=\"sv-who__level sv-who__level--intermediate\">\n        <span class=\"sv-who__level-num\" aria-hidden=\"true\">02</span>\n        <span class=\"sv-who__level-icon\">⚡</span>\n        <h3 class=\"sv-who__level-name\">Intermediate</h3>\n        <p class=\"sv-who__level-desc\">You know your way around the court. Consistent rallies, basic smashes, and an appetite to compete. Ready to be challenged.</p>\n      </div>\n\n      <div class=\"sv-who__level sv-who__level--advanced\">\n        <span class=\"sv-who__level-num\" aria-hidden=\"true\">03</span>\n        <span class=\"sv-who__level-icon\">🔥</span>\n        <h3 class=\"sv-who__level-name\">Advanced</h3>\n        <p class=\"sv-who__level-desc\">Tournament-ready. Strong footwork, tactical play, and serious intent. Come to compete and leave your mark at ShuttleVerse.</p>\n      </div>\n\n    </div>\n\n    <p class=\"sv-who__footnote\">Open to all players aged 16 and above · Right or left-handed welcome</p>\n\n  </div>\n</section>\n-->\n\n<!-- ═══════════════════════════════════════════\n     PART B — WHAT TO BRING\n     Locker-tag style: each item is a hanging\n     tag with a punched hole, item number, icon,\n     and name. Tags are strung on a gold rail.\n════════════════════════════════════════════ -->\n<style>\n  .sv-bring {\n    background: #2A0960;\n    padding: 64px 24px 72px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .sv-bring__inner {\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  /* Section header */\n  .sv-bring__eyebrow {\n    display: block;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #F5C500;\n    margin-bottom: 10px;\n  }\n\n  .sv-bring__title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(4.4rem, 6vw, 5.5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 52px 0;\n  }\n\n  /* The horizontal gold rail tags hang from */\n  .sv-bring__rail {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    gap: 24px;\n    flex-wrap: wrap;\n    padding-top: 24px;\n  }\n\n  .sv-bring__rail::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 2px;\n    background: linear-gradient(\n      90deg,\n      transparent 0%,\n      #F5C500 15%,\n      #F5C500 85%,\n      transparent 100%\n    );\n  }\n\n  /* Individual tag */\n  .sv-bring__tag {\n    position: relative;\n    width: 180px;\n    background: #F5C500;\n    color: #1A0640;\n    padding: 36px 20px 24px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    /* Slightly rotated — each tag tilts differently via nth-child */\n    transform: rotate(-1.5deg);\n    transition: transform 0.2s, box-shadow 0.2s;\n    box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.4);\n  }\n\n  .sv-bring__tag:nth-child(2) { transform: rotate(1deg); }\n  .sv-bring__tag:nth-child(3) { transform: rotate(-0.5deg); }\n  .sv-bring__tag:nth-child(4) { transform: rotate(1.5deg); }\n\n  .sv-bring__tag:hover {\n    transform: rotate(0deg) translateY(-6px) !important;\n    box-shadow: 4px 12px 32px rgba(0, 0, 0, 0.5);\n  }\n\n  /* Punched hole at top of tag */\n  .sv-bring__tag::before {\n    content: '';\n    position: absolute;\n    top: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: #1A0640;\n    border: 2px solid rgba(0, 0, 0, 0.2);\n  }\n\n  /* String from hole to rail */\n  .sv-bring__tag::after {\n    content: '';\n    position: absolute;\n    top: -24px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 1px;\n    height: 24px;\n    background: #F5C500;\n    opacity: 0.6;\n  }\n\n  .sv-bring__tag-number {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 1.7rem;\n    letter-spacing: 0.2em;\n    opacity: 0.4;\n    margin-bottom: 12px;\n  }\n\n  .sv-bring__tag-icon {\n    font-size: 3.2rem;\n    margin-bottom: 10px;\n    line-height: 1;\n    display: block;\n  }\n\n  .sv-bring__tag-name {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 1.8rem;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    line-height: 1.2;\n    color: #1A0640;\n  }\n\n  @media (max-width: 600px) {\n    .sv-bring { padding: 52px 20px 60px; }\n    .sv-bring__tag { width: 140px; padding: 32px 14px 20px; }\n    .sv-bring__tag-icon { font-size: 2.8rem; }\n    .sv-bring__tag-name { font-size: 1.88rem; }\n    .sv-bring__rail { gap: 14px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-bring__tag,\n    .sv-bring__tag:hover { transform: none !important; transition: none; }\n  }\n</style>\n\n<section class=\"sv-bring\">\n  <div class=\"sv-bring__inner\">\n\n    <span class=\"sv-bring__eyebrow\">Pack Your Bag</span>\n    <h2 class=\"sv-bring__title\">What to bring</h2>\n\n    <div class=\"sv-bring__rail\">\n\n      <div class=\"sv-bring__tag\">\n        <span class=\"sv-bring__tag-number\">01</span>\n        <span class=\"sv-bring__tag-icon\">🏸</span>\n        <span class=\"sv-bring__tag-name\">Your Racket <br> (Not Required)</span>\n      </div>\n\n      <div class=\"sv-bring__tag\">\n        <span class=\"sv-bring__tag-number\">02</span>\n        <span class=\"sv-bring__tag-icon\">👟</span>\n        <span class=\"sv-bring__tag-name\">Non-Marking Sports Shoes</span>\n      </div>\n\n      <div class=\"sv-bring__tag\">\n        <span class=\"sv-bring__tag-number\">03</span>\n        <span class=\"sv-bring__tag-icon\">🥤</span>\n        <span class=\"sv-bring__tag-name\">Water Bottle</span>\n      </div>\n\n      <div class=\"sv-bring__tag\">\n        <span class=\"sv-bring__tag-number\">04</span>\n        <span class=\"sv-bring__tag-icon\">👕</span>\n        <span class=\"sv-bring__tag-name\">Comfortable Sportswear</span>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_qb69YF": {
      "type": "custom-liquid",
