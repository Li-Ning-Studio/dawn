        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_LjMxTE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 8: FINAL CTA\n     OFFLYN + DISTRICT\n     Shopify Custom Liquid / Custom HTML\n================================================================ -->\n\n<style>\n  .sv-cta,\n  .sv-cta * {\n    box-sizing: border-box;\n  }\n\n  .sv-cta {\n    background: #2A0960;\n    padding: 76px 24px 66px;\n    text-align: center;\n    overflow: hidden;\n    position: relative;\n    isolation: isolate;\n  }\n\n  /* ============================================================\n     BACKGROUND EFFECTS\n  ============================================================ */\n\n  .sv-cta::before {\n    content: \"\";\n    position: absolute;\n    width: 520px;\n    height: 520px;\n    left: 50%;\n    top: -310px;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: rgba(107, 58, 245, 0.24);\n    filter: blur(90px);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .sv-cta::after {\n    content: \"\";\n    position: absolute;\n    width: 380px;\n    height: 380px;\n    right: -220px;\n    bottom: -180px;\n    border-radius: 50%;\n    background: rgba(245, 197, 0, 0.08);\n    filter: blur(90px);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .sv-cta__inner {\n    max-width: 540px;\n    margin: 0 auto;\n    position: relative;\n    z-index: 2;\n\n    animation: svContentEnter 0.8s cubic-bezier(.2,.8,.2,1) both;\n  }\n\n  @keyframes svContentEnter {\n    from {\n      opacity: 0;\n      transform: translateY(18px);\n    }\n\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  /* ============================================================\n     EYEBROW\n  ============================================================ */\n\n  .sv-cta__eyebrow {\n    display: inline-block;\n\n    font-family: \"Figtree\", sans-serif;\n    font-weight: 600;\n    font-size: 1.72rem;\n\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n\n    color: #F5C500;\n\n    border: 1px solid rgba(245, 197, 0, 0.35);\n\n    padding: 6px 15px;\n    border-radius: 100px;\n\n    margin-bottom: 22px;\n\n    background: rgba(245, 197, 0, 0.04);\n\n    box-shadow:\n      inset 0 0 18px rgba(245, 197, 0, 0.03),\n      0 0 25px rgba(245, 197, 0, 0.03);\n  }\n\n  /* ============================================================\n     HEADLINE\n  ============================================================ */\n\n  .sv-cta__headline {\n    font-family: \"Figtree\", sans-serif;\n    font-weight: 900;\n\n    font-size: clamp(3rem, 13vw, 6rem);\n    line-height: 0.9;\n\n    letter-spacing: -0.04em;\n    text-transform: uppercase;\n\n    color: #ffffff;\n\n    margin: 0;\n  }\n\n  .sv-cta__headline em {\n    font-style: normal;\n    color: #F5C500;\n\n    text-shadow:\n      0 0 30px rgba(245, 197, 0, 0.12);\n  }\n\n  .sv-cta__sub {\n    font-family: \"Figtree\", sans-serif;\n\n    font-size: 1.3rem;\n    font-weight: 500;\n\n    color: #F0EAF8;\n\n    opacity: 0.72;\n\n    line-height: 1.6;\n\n    margin: 18px auto 38px;\n\n    max-width: 440px;\n  }\n\n  /* ============================================================\n     BOOKING OPTIONS\n  ============================================================ */\n\n  .sv-cta__platforms {\n    display: flex;\n    flex-direction: column;\n\n    width: 100%;\n  }\n\n  .sv-cta__btn {\n    position: relative;\n\n    width: 100%;\n    min-height: 82px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    padding: 16px 18px;\n\n    border-radius: 14px;\n\n    text-decoration: none;\n\n    border: 1px solid rgba(255,255,255,0.10);\n\n    cursor: pointer;\n\n    overflow: hidden;\n\n    transform: translateZ(0);\n\n    transition:\n      transform 0.32s cubic-bezier(.2,.8,.2,1),\n      filter 0.32s ease,\n      box-shadow 0.32s ease,\n      border-color 0.32s ease;\n  }\n\n  /* SHINE SWEEP */\n\n  .sv-cta__btn::before {\n    content: \"\";\n\n    position: absolute;\n\n    top: -50%;\n    left: -100%;\n\n    width: 50%;\n    height: 200%;\n\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,0.16),\n      transparent\n    );\n\n    transform: rotate(18deg);\n\n    pointer-events: none;\n\n    transition: left 0.75s cubic-bezier(.2,.8,.2,1);\n\n    z-index: 1;\n  }\n\n  .sv-cta__btn:hover::before {\n    left: 145%;\n  }\n\n  .sv-cta__btn:hover {\n    transform: translateY(-4px);\n  }\n\n  .sv-cta__btn:active {\n    transform: translateY(-1px) scale(0.995);\n  }\n\n  .sv-cta__btn-left,\n  .sv-cta__btn-action {\n    position: relative;\n    z-index: 2;\n  }\n\n  /* ============================================================\n     OFFLYN BUTTON\n  ============================================================ */\n\n  .sv-cta__btn--offlyn {\n    background:\n      linear-gradient(\n        135deg,\n        #7041F6 0%,\n        #6332E8 100%\n      );\n\n    box-shadow:\n      0 14px 32px rgba(0,0,0,0.18),\n      0 5px 20px rgba(107,58,245,0.14),\n      inset 0 1px 0 rgba(255,255,255,0.14);\n  }\n\n  .sv-cta__btn--offlyn:hover {\n    border-color: rgba(255,255,255,0.24);\n\n    box-shadow:\n      0 20px 42px rgba(0,0,0,0.24),\n      0 8px 30px rgba(107,58,245,0.26),\n      inset 0 1px 0 rgba(255,255,255,0.18);\n  }\n\n  /* ============================================================\n     DISTRICT BUTTON\n  ============================================================ */\n\n  .sv-cta__btn--district {\n    background: #ffffff;\n\n    border-color: rgba(255,255,255,0.2);\n\n    box-shadow:\n      0 14px 32px rgba(0,0,0,0.18),\n      inset 0 1px 0 rgba(255,255,255,0.8);\n  }\n\n  .sv-cta__btn--district::before {\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(107,58,245,0.08),\n      transparent\n    );\n  }\n\n  .sv-cta__btn--district:hover {\n    border-color: rgba(255,255,255,0.65);\n\n    box-shadow:\n      0 20px 42px rgba(0,0,0,0.22),\n      0 8px 26px rgba(0,0,0,0.08),\n      inset 0 1px 0 rgba(255,255,255,1);\n  }\n\n  /* ============================================================\n     BUTTON LEFT SIDE\n  ============================================================ */\n\n  .sv-cta__btn-left {\n    display: flex;\n    align-items: center;\n\n    gap: 15px;\n\n    text-align: left;\n\n    min-width: 0;\n  }\n\n  /* ============================================================\n     OFFLYN LOGO\n     NO BOX / NO BACKGROUND / NO BORDER\n  ============================================================ */\n\n  .sv-cta__offlyn-logo {\n    display: block;\n\n    width: 50px;\n    height: 50px;\n\n    object-fit: contain;\n\n    flex-shrink: 0;\n\n    background: transparent !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n\n    transition:\n      transform 0.35s cubic-bezier(.2,.8,.2,1),\n      filter 0.35s ease;\n  }\n\n  .sv-cta__btn--offlyn:hover .sv-cta__offlyn-logo {\n    transform: scale(1.07);\n    filter: drop-shadow(0 5px 10px rgba(0,0,0,0.12));\n  }\n\n  /* ============================================================\n     DISTRICT LOGO\n     NO HOLDER / NO BOX / NO BLACK SQUARE\n  ============================================================ */\n\n  .sv-cta__district-logo {\n    display: block;\n\n    width: 50px;\n    height: 50px;\n\n    object-fit: contain;\n\n    flex-shrink: 0;\n\n    background: transparent !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n\n    transition:\n      transform 0.35s cubic-bezier(.2,.8,.2,1),\n      filter 0.35s ease;\n  }\n\n  .sv-cta__btn--district:hover .sv-cta__district-logo {\n    transform: scale(1.07);\n  }\n\n  /* ============================================================\n     PLATFORM TEXT\n  ============================================================ */\n\n  .sv-cta__btn-platform {\n    display: block;\n\n    font-family: \"Figtree\", sans-serif;\n\n    font-weight: 500;\n    font-size: 1.12rem;\n\n    letter-spacing: 0.08em;\n\n    text-transform: uppercase;\n\n    margin-bottom: 3px;\n  }\n\n  .sv-cta__btn--offlyn .sv-cta__btn-platform {\n    color: rgba(255,255,255,0.68);\n  }\n\n  .sv-cta__btn--district .sv-cta__btn-platform {\n    color: rgba(0,0,0,0.48);\n  }\n\n  .sv-cta__btn-name {\n    display: block;\n\n    font-family: \"Figtree\", sans-serif;\n\n    font-weight: 800;\n    font-size: 2.35rem;\n\n    letter-spacing: 0.01em;\n\n    text-transform: uppercase;\n\n    line-height: 1;\n  }\n\n  .sv-cta__btn--offlyn .sv-cta__btn-name {\n    color: #ffffff;\n  }\n\n  .sv-cta__btn--district .sv-cta__btn-name {\n    color: #111111;\n  }\n\n  /* ============================================================\n     BOOK NOW ACTION\n  ============================================================ */\n\n  .sv-cta__btn-action {\n    display: flex;\n    align-items: center;\n\n    gap: 7px;\n\n    border-radius: 9px;\n\n    padding: 9px 13px;\n\n    flex-shrink: 0;\n\n    transition:\n      transform 0.3s cubic-bezier(.2,.8,.2,1),\n      background 0.3s ease;\n  }\n\n  .sv-cta__btn--offlyn .sv-cta__btn-action {\n    background: rgba(0,0,0,0.18);\n  }\n\n  .sv-cta__btn--offlyn:hover .sv-cta__btn-action {\n    background: rgba(0,0,0,0.25);\n  }\n\n  .sv-cta__btn--district .sv-cta__btn-action {\n    background: #111111;\n  }\n\n  .sv-cta__btn:hover .sv-cta__btn-action {\n    transform: translateX(3px);\n  }\n\n  .sv-cta__btn-action-text {\n    font-family: \"Figtree\", sans-serif;\n\n    font-weight: 700;\n    font-size: 1.25rem;\n\n    letter-spacing: 0.04em;\n\n    text-transform: uppercase;\n\n    color: #ffffff;\n\n    white-space: nowrap;\n  }\n\n  .sv-cta__btn-action svg {\n    width: 14px;\n    height: 14px;\n\n    flex-shrink: 0;\n\n    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);\n  }\n\n  .sv-cta__btn:hover .sv-cta__btn-action svg {\n    transform: translateX(3px);\n  }\n\n  /* ============================================================\n     OR DIVIDER\n  ============================================================ */\n\n  .sv-cta__or {\n    display: flex;\n    align-items: center;\n\n    gap: 14px;\n\n    width: 100%;\n\n    margin: 15px 0;\n\n    font-family: \"Figtree\", sans-serif;\n\n    font-size: 1.05rem;\n    font-weight: 700;\n\n    letter-spacing: 0.18em;\n\n    text-transform: uppercase;\n\n    color: rgba(255,255,255,0.46);\n  }\n\n  .sv-cta__or::before,\n  .sv-cta__or::after {\n    content: \"\";\n\n    height: 1px;\n\n    flex: 1;\n\n    background:\n      linear-gradient(\n        90deg,\n        transparent,\n        rgba(255,255,255,0.18)\n      );\n  }\n\n  .sv-cta__or::after {\n    background:\n      linear-gradient(\n        90deg,\n        rgba(255,255,255,0.18),\n        transparent\n      );\n  }\n\n  /* ============================================================\n     BOTTOM COPY\n  ============================================================ */\n\n  .sv-cta__booking-note {\n    font-family: \"Figtree\", sans-serif;\n\n    font-size: 1.12rem;\n    font-weight: 500;\n\n    color: rgba(240,234,248,0.58);\n\n    margin: 20px 0 0;\n  }\n\n  .sv-cta__urgency {\n    font-family: \"Figtree\", sans-serif;\n\n    font-weight: 700;\n    font-size: 1.45rem;\n\n    letter-spacing: 0.14em;\n\n    text-transform: uppercase;\n\n    color: #F5C500;\n\n    margin: 30px 0 30px;\n\n    animation: svUrgencyGlow 2.5s ease-in-out infinite;\n  }\n\n  @keyframes svUrgencyGlow {\n    0%,\n    100% {\n      opacity: 0.82;\n      text-shadow: 0 0 0 rgba(245,197,0,0);\n    }\n\n    50% {\n      opacity: 1;\n      text-shadow: 0 0 18px rgba(245,197,0,0.18);\n    }\n  }\n\n  .sv-cta__terms {\n    font-family: \"Figtree\", sans-serif;\n\n    font-size: 1.18rem;\n\n    color: #F0EAF8;\n\n    opacity: 0.28;\n\n    line-height: 1.65;\n\n    max-width: 490px;\n\n    margin: 0 auto;\n  }\n\n  /* ============================================================\n     