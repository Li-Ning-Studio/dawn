      <span>\n          <span class=\"sbs-tile-name\">Hyfonic</span>\n          <span class=\"sbs-tile-tag\">Precision</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- Nuclear -->\n    <a class=\"sbs-tile sbs-nuclear\" href=\"/collections/nuclear\" aria-label=\"Shop Nuclear\">\n      <div class=\"sbs-tile-media\">\n        <!-- IMAGE SLOT: replace with --> <img class=\"sbs-tile-img\" src=\"https://in.hndrd.co/cdn/shop/files/HBRX_2_U029_1_01_eeb8d84dce.png?v=1745480547\" alt=\"Nuclear racket\">\n        <!-- <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\"/>\n          <rect x=\"80\" y=\"284\" width=\"40\" height=\"20\" rx=\"5\" fill=\"currentColor\" opacity=\"0.55\"/>\n        </svg> -->\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">Nuclear</span>\n          <span class=\"sbs-tile-tag\">Power</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- Atomic -->\n    <a class=\"sbs-tile sbs-atomic\" href=\"/collections/atomic\" aria-label=\"Shop Atomic\">\n      <div class=\"sbs-tile-media\">\n        <!-- IMAGE SLOT: replace with --> <img class=\"sbs-tile-img\" src=\"https://in.hndrd.co/cdn/shop/files/1_49d74b9274.png?v=1745480358\" alt=\"Atomic racket\">\n      <!--  <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\"/>\n          <rect x=\"80\" y=\"284\" width=\"40\" height=\"20\" rx=\"5\" fill=\"currentColor\" opacity=\"0.55\"/>\n        </svg>  -->\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">Atomic</span>\n          <span class=\"sbs-tile-tag\">Power</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- Flutter — wide tile -->\n    <a class=\"sbs-tile sbs-flutter sbs-t--wide\" href=\"/collections/flutter\" aria-label=\"Shop Flutter\">\n      <div class=\"sbs-tile-media\">\n        <!-- IMAGE SLOT: replace with --> <img class=\"sbs-tile-img\" src=\"https://in.hndrd.co/cdn/shop/files/1_07889a0527.png?v=1749011588\" alt=\"Flutter racket\"> \n      <!--  <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\"/>\n          <rect x=\"80\" y=\"284\" width=\"40\" height=\"20\" rx=\"5\" fill=\"currentColor\" opacity=\"0.55\"/>\n        </svg> -->\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">Flutter</span>\n          <span class=\"sbs-tile-tag\">Control</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n  </div>\n\n  <!-- Explore more: all other rackets, same tile language, neutral colorway -->\n  <div class=\"sbs-more\">\n    <a class=\"sbs-tile sbs-explore\" href=\"/collections/rackets\" aria-label=\"Explore all rackets\">\n      <div class=\"sbs-tile-media\">\n        <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" opacity=\"0.8\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\" opacity=\"0.8\"/>\n        </svg>\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">All rackets</span>\n          <span class=\"sbs-tile-tag\">Explore the full range</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n  </div>\n</section>",
