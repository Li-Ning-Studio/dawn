      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!--\n  HUNDRED INDIA — \"Shop by Series\" section (v4, product-card layout)\n  Standalone HTML/CSS. Namespace: sbs- (matches convention). Zero JS.\n\n  ADDING YOUR PRODUCT PHOTOS\n  Each tile has an image zone with a placeholder line-art racket inside\n  an \"IMAGE SLOT\" comment block. To drop in a real photo, delete\n  the placeholder svg.sbs-product element and replace it with:\n      <img class=\"sbs-tile-img\" src=\"YOUR-LINK-HERE\" alt=\"Nitrix racket\">\n  One image per series is enough — a single cutout on a transparent\n  background (PNG/WEBP), shot straight-on. It's shown with object-fit:\n  contain and floats centered over the tile's colorway, so it doesn't\n  need a banner crop or a separate mobile crop — the same image works\n  at every size, it just scales down.\n-->\n<section class=\"sbs-root\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500&display=swap');\n\n    .sbs-root {\n      --ink-dark: #14181C;\n      --ink-light: #F5F3EF;\n      background: #0E0F11;\n      padding: 64px 4vw 88px;\n      font-family: 'Space Grotesk', -apple-system, sans-serif;\n    }\n    .sbs-root * { box-sizing: border-box; }\n\n    .sbs-head {\n      max-width: 1320px;\n      margin: 0 auto 28px;\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 16px;\n    }\n    .sbs-eyebrow {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: #6B7278;\n    }\n    .sbs-head h1 {\n      font-weight: 700;\n      font-size: clamp(32px, 4vw, 52px);\n      letter-spacing: -0.01em;\n      text-transform: uppercase;\n      color: var(--ink-light);\n      margin: 6px 0 0;\n      line-height: 1;\n    }\n    .sbs-head-hint {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n      color: #6B7278;\n      white-space: nowrap;\n    }\n\n    .sbs-grid {\n      max-width: 1320px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      grid-auto-rows: 260px;\n      grid-auto-flow: dense;\n      gap: 10px;\n    }\n    .sbs-t--lg { grid-column: span 2; grid-row: span 2; }\n    .sbs-t--wide { grid-column: span 2; grid-row: span 1; }\n\n    /* ---- shared tile component ---- */\n    .sbs-tile {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      border-radius: 8px;\n      text-decoration: none;\n      background: var(--c);\n      color: var(--ink);\n      isolation: isolate;\n    }\n    .sbs-tile::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(120% 90% at 10% 0%, rgba(255,255,255,0.22), rgba(255,255,255,0) 55%);\n      pointer-events: none;\n      z-index: 0;\n    }\n\n    .sbs-tile-media {\n      position: relative;\n      z-index: 1;\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 14px;\n      min-height: 0;\n    }\n    .sbs-tile-media img,\n    .sbs-tile-media .sbs-product {\n      max-width: 74%;\n      max-height: 74%;\n      width: auto;\n      height: auto;\n      object-fit: contain;\n      filter: drop-shadow(0 16px 18px rgba(0,0,0,0.25));\n      transition: transform 0.3s cubic-bezier(.2,.8,.2,1);\n    }\n    .sbs-t--lg .sbs-tile-media img,\n    .sbs-t--lg .sbs-tile-media .sbs-product { max-width: 60%; max-height: 78%; }\n    .sbs-tile:hover .sbs-tile-media img,\n    .sbs-tile:hover .sbs-tile-media .sbs-product { transform: translateY(-5px) scale(1.045); }\n\n    .sbs-tile-info {\n      position: relative;\n      z-index: 1;\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 10px;\n      padding: 0 20px 18px;\n    }\n    .sbs-t--lg .sbs-tile-info { padding: 0 28px 24px; }\n\n    .sbs-tile-name {\n      display: block;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: -0.01em;\n      font-size: 21px;\n      line-height: 1.05;\n    }\n    .sbs-t--lg .sbs-tile-name { font-size: 36px; }\n    .sbs-t--wide .sbs-tile-name { font-size: 24px; }\n\n    .sbs-tile-tag {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      margin-top: 6px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10.5px;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      opacity: 0.72;\n    }\n\n    .sbs-tile-arrow {\n      flex: none;\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      border: 1.5px solid currentColor;\n      opacity: 0;\n      transform: translateY(4px);\n      transition: opacity 0.25s ease, transform 0.25s ease;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .sbs-tile:hover .sbs-tile-arrow { opacity: 0.9; transform: translateY(0); }\n    .sbs-tile-arrow svg { width: 13px; height: 13px; }\n\n    .sbs-tile:focus-visible { outline: 2px solid var(--ink-light); outline-offset: 2px; }\n\n    /* ---- colorways ---- */\n    .sbs-nitrix   { --c: #21D9C3; --ink: var(--ink-dark); }\n    .sbs-flareon  { --c: #FF5A1F; --ink: var(--ink-light); }\n    .sbs-hyfonic  { --c: #3A63FF; --ink: var(--ink-light); }\n    .sbs-predator { --ink: var(--ink-light); background: linear-gradient(150deg, #C81E3A 0%, #4A0917 80%); }\n    .sbs-atomic   { --c: #FFC72C; --ink: var(--ink-dark); }\n    .sbs-nuclear  { --c: #A6FF3D; --ink: var(--ink-dark); }\n    .sbs-flutter  { --c: #FF9ED2; --ink: var(--ink-dark); }\n\n    /* ---- explore-more banner ---- */\n    .sbs-more { max-width: 1320px; margin: 10px auto 0; }\n    .sbs-explore {\n      --c: #1B1D21; --ink: var(--ink-light);\n      flex-direction: row;\n      align-items: center;\n      height: 130px;\n    }\n    .sbs-explore .sbs-tile-media { flex: 0 0 140px; padding: 10px 0 10px 24px; justify-content: flex-start; }\n    .sbs-explore .sbs-tile-media .sbs-product { max-width: 90%; max-height: 90%; }\n    .sbs-explore .sbs-tile-info { flex: 1; align-items: center; padding: 0 24px 0 0; }\n    .sbs-explore .sbs-tile-name { font-size: 24px; }\n\n    @media (max-width: 980px) {\n      .sbs-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 220px; }\n    }\n\n    @media (max-width: 620px) {\n      .sbs-root { padding: 48px 5vw 64px; }\n      .sbs-head { flex-direction: column; align-items: flex-start; gap: 6px; }\n      .sbs-grid { grid-template-columns: 1fr; grid-auto-rows: unset; }\n      .sbs-t--lg, .sbs-t--wide { grid-column: span 1; grid-row: span 1; }\n      .sbs-grid .sbs-tile { aspect-ratio: 1 / 1; }\n      .sbs-t--lg .sbs-tile-name { font-size: 28px; }\n      .sbs-explore { height: 118px; }\n      .sbs-explore .sbs-tile-media { flex-basis: 100px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .sbs-tile-media img, .sbs-tile-media .sbs-product, .sbs-tile-arrow { transition: none; }\n    }\n  </style>\n\n  <div class=\"sbs-head\">\n    <div>\n      <div class=\"sbs-eyebrow\">Series</div>\n      <h1>Shop by series</h1>\n    </div>\n    <div class=\"sbs-head-hint\">7 series →</div>\n  </div>\n\n  <div class=\"sbs-grid\">\n\n    <!-- Predator — flagship, large tile -->\n    <a class=\"sbs-tile sbs-predator sbs-t--lg\" href=\"/collections/predator\" aria-label=\"Shop Predator\">\n      <div class=\"sbs-tile-media\">\n        <!-- IMAGE SLOT: replace the svg below with-->\n             <img class=\"sbs-tile-img\" src=\"https://in.hndrd.co/cdn/shop/files/Template_01_7fb8c6213a.png?v=1749011522\" alt=\"Predator racket\"> \n       <!-- <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"/>\n          <ellipse cx=\"100\" cy=\"90\" rx=\"58\" ry=\"66\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" opacity=\"0.5\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\"/>\n          <rect x=\"80\" y=\"284\" width=\"40\" height=\"20\" rx=\"5\" fill=\"currentColor\" opacity=\"0.55\"/>\n        </svg>-->\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">Predator</span>\n          <span class=\"sbs-tile-tag\">Power</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- Flareon -->\n    <a class=\"sbs-tile sbs-flareon\" href=\"/collections/flareon\" aria-label=\"Shop Flareon\">\n      <div class=\"sbs-tile-media\">\n        <!-- IMAGE SLOT: replace with --><img class=\"sbs-tile-img\" src=\"https://in.hndrd.co/cdn/shop/files/1_6adad46c-7d0b-4f3b-80ef-25f8d3b47976.png?v=1752639888\" alt=\"Flareon racket\"> \n       <!-- <svg class=\"sbs-product\" viewBox=\"0 0 200 320\" xmlns=\"http://www.w3.org/2000/svg\">\n          <ellipse cx=\"100\" cy=\"90\" rx=\"72\" ry=\"82\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"/>\n          <rect x=\"88\" y=\"168\" width=\"24\" height=\"120\" rx=\"6\" fill=\"currentColor\"/>\n          <rect x=\"80\" y=\"284\" width=\"40\" height=\"20\" rx=\"5\" fill=\"currentColor\" opacity=\"0.55\"/>\n        </svg> -->\n      </div>\n      <div class=\"sbs-tile-info\">\n        <span>\n          <span class=\"sbs-tile-name\">Flareon</span>\n          <span class=\"sbs-tile-tag\">Speed</span>\n        </span>\n        <span class=\"sbs-tile-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n      </div>\n    </a>\n\n    <!-- Nitrix -->\n    <a class=\"sbs-tile sbs-nitrix\" href=\"/collection