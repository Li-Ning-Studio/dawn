    "custom_liquid_MfRRKw": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!--\n  HUNDRED INDIA — \"Shop by Series\" section (v5, poster shelf)\n  Standalone HTML/CSS. Namespace: sbs- (matches convention). Zero JS.\n\n  Different direction from the colorway-tile version: one continuous\n  dark surface, all 9 cards laid out in a static grid (no scrolling\n  or dragging required). Each card carries its series color only as\n  a soft background glow + a giant outlined wordmark, not a solid\n  fill. Product photos are already wired to your CDN links below.\n-->\n<section class=\"sbs-root\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500&display=swap');\n\n    .sbs-root {\n      background: #101113;\n      padding: 60px 0 80px;\n      font-family: 'Space Grotesk', -apple-system, sans-serif;\n    }\n    .sbs-root * { box-sizing: border-box; }\n\n    .sbs-head {\n      max-width: 1320px;\n      margin: 0 auto 30px;\n      padding: 0 4vw;\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 16px;\n    }\n    .sbs-eyebrow {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: #6B7278;\n    }\n    .sbs-head h1 {\n      font-weight: 700;\n      font-size: clamp(32px, 4vw, 52px);\n      letter-spacing: -0.01em;\n      text-transform: uppercase;\n      color: #F5F3EF;\n      margin: 6px 0 0;\n      line-height: 1;\n    }\n    .sbs-head-hint {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n      color: #6B7278;\n      white-space: nowrap;\n    }\n\n    /* ---- grid ---- */\n    .sbs-shelf {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 14px;\n      padding: 4px 4vw 0;\n      max-width: 1320px;\n      margin: 0 auto;\n    }\n\n    .sbs-card {\n      position: relative;\n      height: 420px;\n      border-radius: 10px;\n      overflow: hidden;\n      background:\n       radial-gradient(80% 70% at 53% 38%, var(--glow) 0%, rgba(16,17,19,0) 68%),\n        #15161A;\n      text-decoration: none;\n      display: block;\n    }\n\n    .sbs-card-word {\n      position: absolute;\n      left: 4px;\n      top: 50%;\n      transform: translateY(-50%) rotate(-90deg);\n      transform-origin: left center;\n      font-weight: 700;\n      font-size: 88px;\n      letter-spacing: -0.01em;\n      text-transform: uppercase;\n      white-space: nowrap;\n      color: transparent;\n      -webkit-text-stroke: 1px rgba(245,243,239,0.16);\n      line-height: 1;\n      pointer-events: none;\n      z-index: 0;\n    }\n\n    .sbs-card-img {\n      position: absolute;\n      inset: 0;\n      z-index: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 26px 20px;\n    }\n    .sbs-card-img img {\n      max-width: 78%;\n      max-height: 84%;\n      object-fit: contain;\n      filter: drop-shadow(0 20px 22px rgba(0,0,0,0.45));\n      transition: transform 0.35s cubic-bezier(.2,.8,.2,1);\n    }\n    .sbs-card:hover .sbs-card-img img { transform: translateY(-6px) scale(1.04); }\n\n    /* ---- mini grid of all rackets, used only on the \"All rackets\" card ---- */\n    .sbs-fan {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      grid-template-rows: repeat(2, 1fr);\n      align-items: center;\n      justify-items: center;\n      padding: 24px 22px 82px;\n      gap: 4px;\n    }\n    .sbs-fan img {\n      max-width: 72%;\n      max-height: 72%;\n      width: auto;\n      height: auto;\n      object-fit: contain;\n      filter: drop-shadow(0 8px 10px rgba(0,0,0,0.45));\n      transition: transform 0.3s ease, filter 0.3s ease;\n    }\n    .sbs-fan img:nth-child(odd) { transform: rotate(-4deg); }\n    .sbs-fan img:nth-child(even) { transform: rotate(4deg); }\n    .sbs-card.sbs-explore:hover .sbs-fan img:nth-child(odd) { transform: rotate(-6deg) translateY(-3px); }\n    .sbs-card.sbs-explore:hover .sbs-fan img:nth-child(even) { transform: rotate(6deg) translateY(-3px); }\n\n    .sbs-card-label {\n      position: absolute;\n      left: 20px;\n      bottom: 18px;\n      z-index: 2;\n    }\n    .sbs-card-code {\n      display: block;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10.5px;\n      letter-spacing: 0.1em;\n      color: #6B7278;\n      margin-bottom: 6px;\n    }\n    .sbs-card-name {\n      display: block;\n      font-weight: 700;\n      font-size: 24px;\n      letter-spacing: -0.01em;\n      text-transform: uppercase;\n      color: #F5F3EF;\n      line-height: 1;\n    }\n    .sbs-card-tag {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      margin-top: 7px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10.5px;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      color: rgba(245,243,239,0.65);\n    }\n    .sbs-card-tag::before {\n      content: \"\";\n      width: 7px; height: 7px;\n      border-radius: 50%;\n      background: var(--glow);\n      flex: none;\n    }\n\n    .sbs-card-arrow {\n      position: absolute;\n      right: 16px;\n      top: 16px;\n      z-index: 2;\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      border: 1.5px solid rgba(245,243,239,0.55);\n      color: #F5F3EF;\n      opacity: 0;\n      transform: translateY(-4px);\n      transition: opacity 0.25s ease, transform 0.25s ease;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .sbs-card:hover .sbs-card-arrow { opacity: 1; transform: translateY(0); }\n    .sbs-card-arrow svg { width: 13px; height: 13px; }\n\n    .sbs-card:focus-visible { outline: 2px solid #F5F3EF; outline-offset: 2px; }\n\n    /* ---- glow per series (accent only, never a fill) ---- */\n    .sbs-nitrix   { --glow: rgba(33, 217, 195, 0.55); }\n    .sbs-flareon  { --glow: rgba(255, 90, 31, 0.55); }\n    .sbs-hyfonic  { --glow: rgba(58, 99, 255, 0.55); }\n    .sbs-predator { --glow: rgba(200, 30, 58, 0.6); }\n    .sbs-nuclear  { --glow: rgba(166, 255, 61, 0.5); }\n    .sbs-atomic   { --glow: rgba(255, 199, 44, 0.55); }\n    .sbs-flutter  { --glow: rgba(255, 158, 210, 0.5); }\n    .sbs-battle   { --glow: rgba(123, 76, 255, 0.55); }\n\n    /* ---- explore-more card, no glow, matches shelf ---- */\n    .sbs-explore { --glow: rgba(245, 243, 239, 0.08); }\n    .sbs-explore .sbs-card-word { -webkit-text-stroke: 1px rgba(245,243,239,0.22); }\n\n    @media (max-width: 980px) {\n      .sbs-shelf { grid-template-columns: repeat(2, 1fr); }\n    }\n\n    @media (max-width: 620px) {\n      .sbs-root { padding: 48px 0 64px; }\n      .sbs-head { padding: 0 5vw; flex-direction: column; align-items: flex-start; gap: 6px; }\n      .sbs-shelf { grid-template-columns: 1fr; padding: 4px 5vw 0; gap: 10px; }\n      .sbs-card { height: 380px; }\n      .sbs-card-word { font-size: 68px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .sbs-card-img img, .sbs-card-arrow { transition: none; }\n    }\n  </style>\n\n  <div class=\"sbs-head\">\n    <div>\n      <div class=\"sbs-eyebrow\">Series</div>\n      <h1>Shop by series</h1>\n    </div>\n    <div class=\"sbs-head-hint\">8 series</div>\n  </div>\n\n  <div class=\"sbs-shelf\">\n\n    <a class=\"sbs-card sbs-nitrix\" href=\"/collections/nitrix\" aria-label=\"Shop Nitrix\">\n      <span class=\"sbs-card-word\">Nitrix</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_c86ed9ef-2244-4e51-85a3-b24c5f45d54b.png?v=1752643003\" alt=\"Nitrix racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.01</span>\n        <span class=\"sbs-card-name\">Nitrix</span>\n        <span class=\"sbs-card-tag\">Attack</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-flareon\" href=\"/collections/flareon-series\" aria-label=\"Shop Flareon\">\n      <span class=\"sbs-card-word\">Flareon</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_6adad46c-7d0b-4f3b-80ef-25f8d3b47976.png?v=1752639888\" alt=\"Flareon racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.02</span>\n        <span class=\"sbs-card-name\">Flareon</span>\n        <span class=\"sbs-card-tag\">Speed</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-hyfonic\" href=\"/collections/hyfonic-series\" aria-label=\"Shop Hyfonic\">\n      <span class=\"sbs-card-word\">Hyfonic</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_7b591617-0c20-4c43-9455-4231e378055b.png?v=1752642870\" alt=\"Hyfonic racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.03</span>\n        <span class=\"sbs-card-name\">Hyfonic</span>\n        <span class=\"sbs-card-tag\">Precision</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-predator\" href=\"/collections/predator\" aria-label=\"Shop Predator\">\n      <span class=\"sbs-card-word\">Predator</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_7fb8c6213a.png?v=1749011522\" alt=\"Predator racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.04</span>\n        <span class=\"sbs-card-name\">Predator</span>\n        <span class=\"sbs-card-tag\">Power</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-nuclear\" href=\"/collections/nuclear-rackets\" aria-label=\"Shop Nuclear\">\n      <span class=\"sbs-card-word\">Nuclear</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/HBRX_2_U029_1_01_eeb8d84dce.png?v=1745480547\" alt=\"Nuclear racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.05</span>\n        <span class=\"sbs-card-name\">Nuclear</span>\n        <span class=\"sbs-card-tag\">Power</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-atomic\" href=\"/collections/atomic-x\" aria-label=\"Shop Atomic\">\n      <span class=\"sbs-card-word\">Atomic</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_49d74b9274.png?v=1745480358\" alt=\"Atomic racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.06</span>\n        <span class=\"sbs-card-name\">Atomic</span>\n        <span class=\"sbs-card-tag\">Attack</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-flutter\" href=\"/collections/flutter\" aria-label=\"Shop Flutter\">\n      <span class=\"sbs-card-word\">Flutter</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_07889a0527.png?v=1749011588\" alt=\"Flutter racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.07</span>\n        <span class=\"sbs-card-name\">Flutter</span>\n        <span class=\"sbs-card-tag\">Control</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-battle\" href=\"/collections/battle-series\" aria-label=\"Shop Battle\">\n      <span class=\"sbs-card-word\">Battle</span>\n      <span class=\"sbs-card-img\"><img src=\"https://in.hndrd.co/cdn/shop/files/1_0daf02f499.png?v=1745482938\" alt=\"Battle racket\" loading=\"lazy\"></span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.08</span>\n        <span class=\"sbs-card-name\">Battle</span>\n        <span class=\"sbs-card-tag\">Power</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n    <a class=\"sbs-card sbs-explore\" href=\"/collections/explore-more\" aria-label=\"Explore all rackets\">\n      <span class=\"sbs-card-word\">All</span>\n      <span class=\"sbs-card-img sbs-fan\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_c86ed9ef-2244-4e51-85a3-b24c5f45d54b.png?v=1752643003\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_6adad46c-7d0b-4f3b-80ef-25f8d3b47976.png?v=1752639888\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_7b591617-0c20-4c43-9455-4231e378055b.png?v=1752642870\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_7fb8c6213a.png?v=1749011522\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/HBRX_2_U029_1_01_eeb8d84dce.png?v=1745480547\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_49d74b9274.png?v=1745480358\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_07889a0527.png?v=1749011588\" alt=\"\" loading=\"lazy\">\n        <img src=\"https://in.hndrd.co/cdn/shop/files/1_0daf02f499.png?v=1745482938\" alt=\"\" loading=\"lazy\">\n      </span>\n      <span class=\"sbs-card-label\">\n        <span class=\"sbs-card-code\">S.09</span>\n        <span class=\"sbs-card-name\">EXPLORE MORE</span>\n        <span class=\"sbs-card-tag\">Explore the full range</span>\n      </span>\n      <span class=\"sbs-card-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17L17 7M17 7H9M17 7v8\"/></svg></span>\n    </a>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
