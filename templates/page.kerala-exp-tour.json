    "custom_liquid_UGHTwX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section id=\"hndrd-kerala-experience\">\n  <style>\n    #hndrd-kerala-experience {\n      --bg: #08070a;\n      --panel: #16130f;\n      --gold: #cda45e;\n      --gold-light: #f4dda0;\n      --white: #f6f4ef;\n      --muted: #a39a8a;\n      position: relative;\n      isolation: isolate;\n      overflow: hidden;\n      background: var(--bg);\n      color: var(--white);\n      padding: clamp(54px, 8vw, 110px) 20px;\n      font-family: var(--font-body-family);\n    }\n\n    #hndrd-kerala-experience *,\n    #hndrd-kerala-experience *::before,\n    #hndrd-kerala-experience *::after {\n      box-sizing: border-box;\n    }\n\n    #hndrd-kerala-experience .kt-glow {\n      position: absolute;\n      width: 450px;\n      height: 450px;\n      border-radius: 50%;\n      background: radial-gradient(\n        circle,\n        rgba(205,164,94,.18),\n        transparent 70%\n      );\n      filter: blur(60px);\n      pointer-events: none;\n      top: -190px;\n      left: -160px;\n      z-index: -1;\n    }\n\n    #hndrd-kerala-experience .kt-wrap {\n      width: 100%;\n      max-width: 1050px;\n      margin: auto;\n    }\n\n    #hndrd-kerala-experience .kt-eyebrow {\n      color: var(--gold);\n      font-size: 11px;\n      font-weight: 600;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n      margin: 0 0 18px;\n    }\n\n    #hndrd-kerala-experience .kt-title {\n      color: var(--white);\n      font-family: var(--font-heading-family);\n      font-size: clamp(36px, 6vw, 72px);\n      font-weight: 700;\n      letter-spacing: -.045em;\n      line-height: 1.05;\n      margin: 0;\n    }\n\n    #hndrd-kerala-experience .kt-subtitle {\n      color: var(--muted);\n      font-size: clamp(14px, 2vw, 16px);\n      margin: 18px 0 42px;\n    }\n\n    #hndrd-kerala-experience .kt-card {\n      position: relative;\n      overflow: hidden;\n      background: linear-gradient(\n        145deg,\n        #211a12 0%,\n        #16130f 52%,\n        #100e0c 100%\n      );\n      border: 1px solid rgba(205,164,94,.25);\n      border-radius: 20px;\n      padding: clamp(24px, 5vw, 44px);\n      box-shadow: 0 22px 65px rgba(0,0,0,.3);\n    }\n\n    #hndrd-kerala-experience .kt-card::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(\n        circle at top right,\n        rgba(205,164,94,.1),\n        transparent 55%\n      );\n      pointer-events: none;\n    }\n\n    #hndrd-kerala-experience .kt-card-head {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      gap: 16px;\n      position: relative;\n    }\n\n    #hndrd-kerala-experience .kt-city {\n      font-family: var(--font-heading-family);\n      font-size: clamp(30px, 5vw, 48px);\n      font-weight: 700;\n      letter-spacing: -.035em;\n      line-height: 1.1;\n      margin: 0;\n      color: var(--white);\n    }\n\n    #hndrd-kerala-experience .kt-range {\n      font-size: 13px;\n      color: var(--gold-light);\n      margin: 12px 0 0;\n      letter-spacing: .02em;\n    }\n\n    #hndrd-kerala-experience .kt-badge {\n      border: 1px solid rgba(205,164,94,.35);\n      border-radius: 50px;\n      color: var(--gold);\n      padding: 7px 13px;\n      font-size: 11px;\n      white-space: nowrap;\n    }\n\n    #hndrd-kerala-experience .kt-events {\n      margin-top: 35px;\n      border-top: 1px solid rgba(255,255,255,.1);\n    }\n\n    #hndrd-kerala-experience .kt-event {\n      display: grid;\n      grid-template-columns: 110px minmax(0,1fr) 48px;\n      align-items: center;\n      gap: 24px;\n      padding: 26px 0;\n      border-bottom: 1px solid rgba(255,255,255,.1);\n    }\n\n    #hndrd-kerala-experience .kt-date {\n      font-size: 42px;\n      font-weight: 700;\n      line-height: 1;\n      letter-spacing: -.05em;\n    }\n\n    #hndrd-kerala-experience .kt-month {\n      color: var(--gold);\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: .13em;\n      margin-top: 6px;\n    }\n\n    #hndrd-kerala-experience .kt-time {\n      color: var(--muted);\n      font-size: 12px;\n      margin-top: 8px;\n    }\n\n    #hndrd-kerala-experience .kt-venue {\n      color: var(--white);\n      font-size: clamp(17px, 2.3vw, 22px);\n      font-weight: 600;\n      line-height: 1.3;\n      margin: 0;\n    }\n\n    #hndrd-kerala-experience .kt-place {\n      color: var(--muted);\n      font-size: 12px;\n      margin: 8px 0 0;\n    }\n\n    #hndrd-kerala-experience .kt-map {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      width: 46px;\n      height: 46px;\n      border-radius: 50%;\n      border: 1px solid rgba(205,164,94,.5);\n      color: var(--gold-light);\n      text-decoration: none;\n      transition: .25s ease;\n    }\n\n    #hndrd-kerala-experience .kt-map:hover {\n      background: var(--gold);\n      color: #08070a;\n      transform: translateY(-3px);\n    }\n\n    #hndrd-kerala-experience .kt-map svg {\n      width: 19px;\n      height: 19px;\n    }\n\n    @media(max-width: 600px) {\n      #hndrd-kerala-experience {\n        padding: 52px 16px;\n      }\n\n      #hndrd-kerala-experience .kt-subtitle {\n        margin-bottom: 28px;\n      }\n\n      #hndrd-kerala-experience .kt-card {\n        padding: 24px 20px;\n        border-radius: 16px;\n      }\n\n      #hndrd-kerala-experience .kt-event {\n        grid-template-columns: 64px minmax(0,1fr) 38px;\n        gap: 12px;\n        padding: 24px 0;\n      }\n\n      #hndrd-kerala-experience .kt-date {\n        font-size: 34px;\n      }\n\n      #hndrd-kerala-experience .kt-venue {\n        font-size: 16px;\n      }\n\n      #hndrd-kerala-experience .kt-map {\n        width: 38px;\n        height: 38px;\n      }\n\n      #hndrd-kerala-experience .kt-map svg {\n        width: 16px;\n        height: 16px;\n      }\n    }\n  </style>\n\n  <div class=\"kt-glow\"></div>\n\n  <div class=\"kt-wrap\">\n    <p class=\"kt-eyebrow\">\n      HNDRD India Tour · November 2026\n    </p>\n\n    <h2 class=\"kt-title\">\n      The Kerala Experience\n    </h2>\n\n    <p class=\"kt-subtitle\">\n      2 evening sessions in Trivandrum.\n    </p>\n\n    <article class=\"kt-card\">\n      <div class=\"kt-card-head\">\n        <div>\n          <h3 class=\"kt-city\">Trivandrum</h3>\n          <p class=\"kt-range\">\n            20–21 Nov · 2 Sessions\n          </p>\n        </div>\n        \n      </div>\n\n      <div class=\"kt-events\">\n\n        <!-- FRIDAY, 20 NOVEMBER -->\n        <div class=\"kt-event\">\n          <div>\n            <div class=\"kt-date\">20</div>\n            <div class=\"kt-month\">FRI · NOV</div>\n            <div class=\"kt-time\">5–7 PM</div>\n          </div>\n\n          <div>\n            <h4 class=\"kt-venue\">\n              Smash Zone Badminton Academy\n            </h4>\n            <p class=\"kt-place\">\n              Kazhakkoottam, Trivandrum\n            </p>\n          </div>\n\n          <a\n            class=\"kt-map\"\n            href=\"https://maps.app.goo.gl/t2GuqUDt6htLwpsdA\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"Find Smash Zone Badminton Academy on Google Maps\"\n            title=\"View on Google Maps\"\n          >\n            <svg viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\">\n              <path d=\"M7 17L17 7M7 7h10v10\"/>\n            </svg>\n          </a>\n        </div>\n\n        <!-- SATURDAY, 21 NOVEMBER -->\n        <div class=\"kt-event\">\n          <div>\n            <div class=\"kt-date\">21</div>\n            <div class=\"kt-month\">SAT · NOV</div>\n            <div class=\"kt-time\">5–6:30 PM</div>\n          </div>\n\n          <div>\n            <h4 class=\"kt-venue\">\n              Saaga Badminton Academy\n            </h4>\n            <p class=\"kt-place\">\n              Ambalathara, Trivandrum\n            </p>\n          </div>\n\n          <a\n            class=\"kt-map\"\n            href=\"https://www.google.com/maps/search/?api=1&amp;query=SAAGA+Badminton+Academy+Opposite+Milma+Ambalathara+Thiruvananthapuram+Kerala\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label=\"Find Saga Badminton Academy on Google Maps\"\n            title=\"View on Google Maps\"\n          >\n            <svg viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\">\n              <path d=\"M7 17L17 7M7 7h10v10\"/>\n            </svg>\n          </a>\n        </div>\n\n      </div>\n    </article>\n  </div>\n</section>",
        "color_scheme": "",
