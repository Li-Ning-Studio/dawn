        "custom_liquid": "<!-- HNDRD PREDATOR - ENGINEERED FEATURES SECTION -->\n<section class=\"hn-predator-engineered\" aria-label=\"What's inside the Predator\">\n  <div class=\"hn-predator-engineered__inner\">\n\n    <p class=\"hn-predator-engineered__eyebrow\">\n      What's inside the Predator\n    </p>\n\n    <h2 class=\"hn-predator-engineered__heading\">\n      Engineered to end rallies.\n    </h2>\n\n    <div class=\"hn-predator-engineered__features\" role=\"list\">\n\n      <div class=\"hn-predator-engineered__feature\" role=\"listitem\">\n        <div class=\"hn-predator-engineered__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 48 48\">\n            <path d=\"M28.55 3.5 9.35 28.35h13.1l-2.2 16.15 18.4-25.85h-13l2.9-15.15Z\"></path>\n          </svg>\n        </div>\n        <h3 class=\"hn-predator-engineered__title\">Vapour Shaft</h3>\n        <p class=\"hn-predator-engineered__copy\">More speed. Same swing.</p>\n      </div>\n\n      <div class=\"hn-predator-engineered__feature\" role=\"listitem\">\n        <div class=\"hn-predator-engineered__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 48 48\">\n            <circle cx=\"24\" cy=\"24\" r=\"13.2\"></circle>\n            <circle cx=\"24\" cy=\"24\" r=\"5.6\"></circle>\n            <path d=\"M24 3.5v8.2M24 36.3v8.2M3.5 24h8.2M36.3 24h8.2\"></path>\n            <path d=\"M24 14.5v-3.2M24 36.7v-3.2M14.5 24h-3.2M36.7 24h-3.2\"></path>\n          </svg>\n        </div>\n        <h3 class=\"hn-predator-engineered__title\">Japan Graphite</h3>\n        <p class=\"hn-predator-engineered__copy\">7-layer. Built to last.</p>\n      </div>\n\n      <div class=\"hn-predator-engineered__feature\" role=\"listitem\">\n        <div class=\"hn-predator-engineered__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 48 48\">\n            <path d=\"M24 7v29\"></path>\n            <path d=\"M12.5 15.5h23\"></path>\n            <path d=\"M15 15.5 8.5 31.2M15 15.5l6.5 15.7M33 15.5l-6.5 15.7M33 15.5l6.5 15.7\"></path>\n            <path d=\"M6.5 31.2h17c-.7 4.3-4 7.3-8.5 7.3s-7.8-3-8.5-7.3Z\"></path>\n            <path d=\"M24.5 31.2h17c-.7 4.3-4 7.3-8.5 7.3s-7.8-3-8.5-7.3Z\"></path>\n            <path d=\"M18.2 41h11.6\"></path>\n          </svg>\n        </div>\n        <h3 class=\"hn-predator-engineered__title\">Head Heavy 305mm</h3>\n        <p class=\"hn-predator-engineered__copy\">Attack from anywhere.</p>\n      </div>\n\n      <div class=\"hn-predator-engineered__feature\" role=\"listitem\">\n        <div class=\"hn-predator-engineered__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 48 48\">\n            <path d=\"M11 8.5h26v13.8c0 10.2-6.2 17.6-13 21.2-6.8-3.6-13-11-13-21.2V8.5Z\"></path>\n            <path d=\"M24 9v34\"></path>\n            <path d=\"M11.8 22.5h24.4\"></path>\n          </svg>\n        </div>\n        <h3 class=\"hn-predator-engineered__title\">Curve² Frame</h3>\n        <p class=\"hn-predator-engineered__copy\">32lbs. Holds every shot.</p>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hn-predator-engineered {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 50% 118%, rgba(0, 165, 95, 0.18) 0%, rgba(0, 165, 95, 0.06) 22%, rgba(0, 0, 0, 0) 48%),\n      linear-gradient(180deg, #050505 0%, #050505 100%);\n    color: #ffffff;\n    padding: 48px 0 86px;\n  }\n\n  .hn-predator-engineered *,\n  .hn-predator-engineered *::before,\n  .hn-predator-engineered *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-engineered__inner {\n    width: 100%;\n    max-width: 1500px;\n    margin: 0 auto;\n    padding: 0 64px;\n    text-align: center;\n  }\n\n  .hn-predator-engineered__eyebrow {\n    margin: 0 0 18px;\n    color: #f3f3f3;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 20px;\n    font-weight: 400;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-predator-engineered__heading {\n    margin: 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(40px, 2.55vw, 52px);\n    font-weight: 800;\n    line-height: 1.08;\n    letter-spacing: -0.04em;\n  }\n\n  .hn-predator-engineered__features {\n    width: 100%;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    column-gap: 72px;\n    align-items: start;\n    margin-top: 61px;\n  }\n\n  .hn-predator-engineered__feature {\n    min-width: 0;\n    text-align: center;\n  }\n\n  .hn-predator-engineered__icon {\n    width: 42px;\n    height: 42px;\n    margin: 0 auto 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #00bfd4;\n  }\n\n  .hn-predator-engineered__icon svg {\n    width: 42px;\n    height: 42px;\n    display: block;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 3.2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .hn-predator-engineered__feature:first-child .hn-predator-engineered__icon svg {\n    fill: currentColor;\n    stroke: none;\n  }\n\n  .hn-predator-engineered__title {\n    margin: 0 0 8px;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 600;\n    line-height: 1.15;\n    letter-spacing: -0.025em;\n  }\n\n  .hn-predator-engineered__copy {\n    margin: 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.25;\n    letter-spacing: -0.025em;\n  }\n\n  @media screen and (max-width: 1100px) {\n    .hn-predator-engineered {\n      padding: 46px 0 72px;\n    }\n\n    .hn-predator-engineered__inner {\n      padding: 0 34px;\n    }\n\n    .hn-predator-engineered__features {\n      grid-template-columns: repeat(2, 1fr);\n      row-gap: 48px;\n      column-gap: 42px;\n      margin-top: 56px;\n    }\n  }\n\n  @media screen and (max-width: 640px) {\n    .hn-predator-engineered {\n      padding: 42px 0 58px;\n    }\n\n    .hn-predator-engineered__inner {\n      padding: 0 20px;\n    }\n\n    .hn-predator-engineered__eyebrow {\n      margin-bottom: 14px;\n      font-size: 16px;\n    }\n\n    .hn-predator-engineered__heading {\n      max-width: 340px;\n      margin: 0 auto;\n      font-size: 34px;\n      line-height: 1.08;\n    }\n\n    .hn-predator-engineered__features {\n      grid-template-columns: 1fr;\n      row-gap: 36px;\n      margin-top: 46px;\n    }\n\n    .hn-predator-engineered__icon,\n    .hn-predator-engineered__icon svg {\n      width: 38px;\n      height: 38px;\n    }\n\n    .hn-predator-engineered__title,\n    .hn-predator-engineered__copy {\n      font-size: 16px;\n    }\n  }\n</style>",
