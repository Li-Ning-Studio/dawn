a-btn {\n    display: inline-block;\n    background-color: #ffffff;\n    color: #000000;\n    font-size: 17px;\n    font-weight: 600;\n    padding: 20px 56px;\n    border-radius: 100px; \n    text-decoration: none;\n    transition: all 0.3s ease;\n    opacity: 0;\n    animation: strikeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;\n  }\n\n  .predator-ultra-btn:hover {\n    transform: scale(1.03);\n    background-color: #e5e5ea;\n  }\n\n  @keyframes strikeUp {\n    0% { opacity: 0; transform: translateY(40px) scale(0.98); }\n    100% { opacity: 1; transform: translateY(0) scale(1); }\n  }\n\n  @keyframes slowZoom {\n    0% { transform: scale(1); }\n    100% { transform: scale(1.08); }\n  }\n\n  @media (max-width: 768px) {\n    .predator-ultra-sub { margin-top: 24px; margin-bottom: 40px; }\n    .predator-ultra-btn { padding: 18px 40px; }\n  }\n</style>\n\n<div class=\"predator-ultra-hero\">\n  <div class=\"predator-ultra-bg\"></div>\n  <div class=\"predator-ultra-overlay\"></div>\n  \n  <div class=\"predator-ultra-content\">\n    <p class=\"predator-ultra-pre\">The Predator Series</p>\n    <h1 class=\"predator-ultra-title\">Unforgiving.</h1>\n    <p class=\"predator-ultra-sub\">The rally ends when you say it does.<br>Pure, undeniable force.</p>\n    <a href=\"#\" class=\"predator-ultra-btn\">Shop Predator</a>\n  </div>\n</div>",
