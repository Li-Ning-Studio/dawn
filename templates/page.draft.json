      "settings": {
        "custom_liquid": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Nitrix Bullet 80 — Impact Physics Preview</title>\n<style>html,body{margin:0;background:#020202;color:#f4f1e9}body{min-height:100%;overflow-x:hidden;font-family:Arial,Helvetica,sans-serif}.preview-next{height:70vh;display:grid;place-items:center;background:#f4f1e9;color:#050505;font:700 clamp(32px,6vw,92px)/.9 Arial,sans-serif;text-transform:uppercase;letter-spacing:-.05em}.preview-next small{display:block;font:600 10px/1.4 Arial,sans-serif;letter-spacing:.18em;text-align:center;margin-top:20px}</style>\n</head>\n<body>\n<div id=\"shopify-section-demo\">\n<style>\n  #shopify-section-demo {\n    margin: 0 !important;\n    overflow: visible !important;\n  }\n\n  #shopify-section-demo .page-width,\n  #shopify-section-demo .section-demo-padding {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .b80-impact,\n  .b80-impact * {\n    box-sizing: border-box;\n  }\n\n  .b80-impact {\n    --b80-black: #020202;\n    --b80-paper: #f4f1e9;\n    --b80-muted: rgba(244, 241, 233, .48);\n    --b80-blue: #42a5ff;\n    --b80-ice: #c9edff;\n    --b80-orange: #ffa400;\n    --b80-impact-x: 76%;\n    --b80-impact-y: 36.5%;\n    --b80-build: 0;\n    --b80-after: 0;\n\n    position: relative;\n    left: 50%;\n    width: 100vw;\n    height: 260vh;\n    margin-left: -50vw;\n    overflow: visible;\n    color: var(--b80-paper);\n    background: var(--b80-black);\n    font-family: Figtree, var(--font-heading-family, Arial), Helvetica, sans-serif;\n  }\n\n  .b80-impact button {\n    font: inherit;\n  }\n\n  .b80-impact__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    height: 100svh;\n    overflow: hidden;\n    isolation: isolate;\n    background: var(--b80-black);\n  }\n\n  .b80-impact__world {\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n    overflow: hidden;\n    will-change: transform;\n    transform: translateZ(0);\n    background: var(--b80-black);\n  }\n\n  .b80-impact__world::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    inset: -12%;\n    pointer-events: none;\n    opacity: .62;\n    background:\n      radial-gradient(circle at var(--b80-impact-x) var(--b80-impact-y), rgba(66, 165, 255, .095) 0, rgba(66, 165, 255, .028) 13%, transparent 30%),\n      linear-gradient(116deg, transparent 0 46%, rgba(255, 255, 255, .012) 48%, transparent 51%),\n      #020202;\n  }\n\n  .b80-impact__world::after {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    inset: 0;\n    pointer-events: none;\n    opacity: .18;\n    background-image:\n      repeating-linear-gradient(0deg, transparent 0 3px, rgba(255, 255, 255, .018) 4px),\n      radial-gradient(circle at 50% 50%, transparent 0 55%, rgba(0, 0, 0, .68) 100%);\n    mix-blend-mode: screen;\n  }\n\n  .b80-impact__topline {\n    position: absolute;\n    z-index: 5;\n    top: clamp(24px, 4vw, 58px);\n    left: clamp(22px, 4.2vw, 70px);\n    right: clamp(22px, 4.2vw, 70px);\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n    pointer-events: none;\n  }\n\n  .b80-impact__identity,\n  .b80-impact__serial {\n    margin: 0;\n    text-transform: uppercase;\n    letter-spacing: .16em;\n    font-size: clamp(10px, .76vw, 13px);\n    line-height: 1.35;\n  }\n\n  .b80-impact__identity {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-weight: 760;\n    color: var(--b80-paper);\n  }\n\n  .b80-impact__identity::before {\n    content: \"\";\n    width: 7px;\n    height: 7px;\n    background: var(--b80-orange);\n    clip-path: polygon(0 0, 100% 50%, 0 100%);\n    box-shadow: 0 0 14px rgba(255, 164, 0, .35);\n  }\n\n  .b80-impact__serial {\n    text-align: right;\n    color: rgba(244, 241, 233, .38);\n  }\n\n  .b80-impact__trajectory {\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    opacity: calc(.08 + var(--b80-build) * .14);\n  }\n\n  .b80-impact__trajectory path {\n    fill: none;\n    stroke: rgba(151, 216, 255, .6);\n    stroke-width: .8;\n    stroke-linecap: round;\n    stroke-dasharray: .025 .018;\n    filter: drop-shadow(0 0 5px rgba(66, 165, 255, .35));\n  }\n\n  .b80-impact__impact-aura {\n    position: absolute;\n    z-index: 1;\n    left: var(--b80-impact-x);\n    top: var(--b80-impact-y);\n    width: clamp(150px, 18vw, 310px);\n    aspect-ratio: 1;\n    border-radius: 50%;\n    pointer-events: none;\n    opacity: calc(.16 + var(--b80-build) * .28);\n    transform: translate(-50%, -50%) scale(calc(.72 + var(--b80-build) * .2));\n    background: radial-gradient(circle, rgba(146, 219, 255, .12) 0, rgba(66, 165, 255, .045) 28%, transparent 70%);\n    filter: blur(3px);\n  }\n\n  .b80-impact__racket-anchor {\n    position: absolute;\n    z-index: 4;\n    left: 50%;\n    top: 56%;\n    width: 1px;\n    height: 1px;\n    pointer-events: none;\n    will-change: transform;\n  }\n\n  .b80-impact__recoil {\n    position: absolute;\n    inset: 0;\n    will-change: transform;\n  }\n\n  .b80-impact__racket {\n    position: absolute;\n    left: 0;\n    top: 0;\n    height: min(80vh, 820px);\n    height: min(80svh, 820px);\n    width: auto;\n    transform-origin: 50% 82%;\n    will-change: transform;\n    filter: drop-shadow(0 26px 35px rgba(0, 0, 0, .7));\n  }\n\n  .b80-impact__racket::before {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    left: 50%;\n    top: 15.5%;\n    width: 104%;\n    aspect-ratio: 1 / 1.25;\n    border-radius: 50%;\n    opacity: calc(.28 + var(--b80-build) * .18);\n    transform: translate(-50%, -50%);\n    background: radial-gradient(circle, rgba(79, 178, 255, .22) 0, rgba(42, 126, 222, .07) 42%, transparent 72%);\n    filter: blur(17px);\n  }\n\n  .b80-impact__racket img,\n  .b80-impact__racket svg {\n    display: block;\n    width: auto;\n    height: 100%;\n    max-width: none;\n    user-select: none;\n    -webkit-user-drag: none;\n  }\n\n  .b80-impact__shuttle {\n    position: absolute;\n    z-index: 6;\n    left: var(--b80-impact-x);\n    top: var(--b80-impact-y);\n    width: clamp(42px, 4.4vw, 74px);\n    pointer-events: none;\n    opacity: calc(.22 + var(--b80-build) * .27);\n    transform: translate(-50%, -50%) rotate(-18deg) scale(.86);\n    filter: drop-shadow(0 0 11px rgba(147, 220, 255, .28));\n    will-change: transform, opacity;\n  }\n\n  .b80-impact__shuttle svg {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  .b80-impact__copy {\n    position: absolute;\n    z-index: 3;\n    left: clamp(22px, 4.2vw, 70px);\n    bottom: clamp(30px, 5.2vw, 78px);\n    width: min(61vw, 920px);\n    pointer-events: none;\n  }\n\n  .b80-impact__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    margin: 0 0 clamp(12px, 1.5vw, 22px);\n    color: rgba(244, 241, 233, .44);\n    font-size: clamp(10px, .78vw, 13px);\n    font-weight: 650;\n    line-height: 1.25;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .b80-impact__eyebrow::before {\n    content: \"01\";\n    color: var(--b80-orange);\n  }\n\n  .b80-impact__title {\n    position: relative;\n    margin: 0;\n    width: 100%;\n    font-size: clamp(60px, 8.7vw, 148px);\n    font-weight: 850;\n    line-height: .76;\n    letter-spacing: -.065em;\n    text-transform: uppercase;\n  }\n\n  .b80-impact__title span {\n    display: block;\n  }\n\n  .b80-impact__title-outline,\n  .b80-impact__title-fill {\n    position: relative;\n  }\n\n  .b80-impact__title-outline {\n    color: transparent;\n    opacity: calc(.28 - var(--b80-after) * .19);\n    -webkit-text-stroke: 1px rgba(244, 241, 233, .55);\n    text-stroke: 1px rgba(244, 241, 233, .55);\n  }\n\n  .b80-impact__title-fill {\n    position: absolute;\n    inset: 0;\n    color: var(--b80-paper);\n    opacity: var(--b80-after);\n    transform: translateY(calc((1 - var(--b80-after)) * 7px));\n    filter: blur(calc((1 - var(--b80-after)) * .7px));\n  }\n\n  .b80-impact__subline {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 20px;\n    margin: clamp(18px, 2.2vw, 30px) 0 0;\n    color: rgba(244, 241, 233, calc(.34 + var(--b80-after) * .46));\n    font-size: clamp(10px, .82vw, 14px);\n    font-weight: 610;\n    line-height: 1.35;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .b80-impact__subline span + span::before {\n    content: \"/\";\n    margin-right: 20px;\n    color: rgba(244, 241, 233, .22);\n  }\n\n  .b80-impact__force {\n    position: absolute;\n    z-index: 5;\n    right: clamp(22px, 4.2vw, 70px);\n    bottom: clamp(34px, 5.6vw, 84px);\n    width: min(250px, 25vw);\n    text-align: right;\n    pointer-events: none;\n  }\n\n  .b80-impact__force strong,\n  .b80-impact__force small {\n    display: block;\n    text-transform: uppercase;\n  }\n\n  .b80-impact__force strong {\n    color: rgba(201, 237, 255, .88);\n    font-size: clamp(11px, .9vw, 15px);\n    font-weight: 760;\n    line-height: 1.2;\n    letter-spacing: .16em;\n  }\n\n  .b80-impact__force small {\n    margin-top: 8px;\n    color: rgba(244, 241, 233, .29);\n    font-size: clamp(8px, .62vw, 10px);\n    line-height: 1.4;\n    letter-spacing: .16em;\n  }\n\n  .b80-impact__force-line {\n    display: block;\n    width: 100%;\n    height: 1px;\n    margin: 13px 0 0;\n    overflow: hidden;\n    background: rgba(244, 241, 233, .1);\n  }\n\n  .b80-impact__force-line::after {\n    content: \"\";\n    display: block;\n    width: calc(18% + var(--b80-build) * 82%);\n    height: 100%;\n    transform-origin: left;\n    background: linear-gradient(90deg, rgba(66, 165, 255, .45), rgba(201, 237, 255, .92));\n    box-shadow: 0 0 12px rgba(66, 165, 255, .35);\n  }\n\n  .b80-impact__sound {\n    position: absolute;\n    z-index: 12;\n    top: clamp(68px, 8vw, 112px);\n    right: clamp(22px, 4.2vw, 70px);\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    min-width: 34px;\n    min-height: 34px;\n    padding: 0;\n    border: 0;\n    color: rgba(244, 241, 233, .58);\n    background: transparent;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .b80-impact__sound svg {\n    width: 25px;\n    height: 25px;\n    overflow: visible;\n  }\n\n  .b80-impact__sound path,\n  .b80-impact__sound line {\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .b80-impact__sound-label {\n    white-space: nowrap;\n    font-size: 10px;\n    font-weight: 650;\n    line-height: 1;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    opacity: 1;\n    transform: translateX(0);\n    transition: opacity .35s ease, transform .35s ease;\n    animation: b80-sound-nudge 2.7s ease-in-out 1;\n  }\n\n  .b80-impact__sound.is-quiet .b80-impact__sound-label {\n    opacity: 0;\n    transform: translateX(6px);\n  }\n\n  .b80-impact__sound:hover .b80-impact__sound-label,\n  .b80-impact__sound:focus-visible .b80-impact__sound-label {\n    opacity: 1;\n    transform: translateX(0);\n  }\n\n  .b80-impact__sound[aria-pressed=\"true\"] {\n    color: var(--b80-ice);\n  }\n\n  .b80-impact__sound[aria-pressed=\"false\"] .b80-impact__sound-wave {\n    opacity: .18;\n  }\n\n  .b80-impact__sound:focus-visible {\n    outline: 1px solid rgba(201, 237, 255, .65);\n    outline-offset: 8px;\n  }\n\n  .b80-impact__flash,\n  .b80-impact__cracks,\n  .b80-impact__waves,\n  .b80-impact__particles {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  .b80-impact__flash {\n    z-index: 10;\n    opacity: 0;\n    background: #f7fcff;\n    will-change: opacity;\n  }\n\n  .b80-impact__cracks {\n    z-index: 9;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n\n  .b80-impact__cracks path {\n    fill: none;\n    stroke: rgba(201, 237, 255, .92);\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    vector-effect: non-scaling-stroke;\n    filter: drop-shadow(0 0 3px rgba(66, 165, 255, .58));\n  }\n\n  .b80-impact__waves {\n    z-index: 7;\n  }\n\n  .b80-impact__wave {\n    position: absolute;\n    left: var(--b80-impact-x);\n    top: var(--b80-impact-y);\n    width: clamp(78px, 9vmin, 150px);\n    aspect-ratio: 1;\n    border: 1px solid rgba(185, 230, 255, .78);\n    border-radius: 50%;\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(.08);\n    box-shadow: 0 0 16px rgba(66, 165, 255, .18), inset 0 0 13px rgba(66, 165, 255, .11);\n    will-change: transform, opacity;\n  }\n\n  .b80-impact__wave--secondary {\n    border-color: rgba(86, 176, 255, .46);\n  }\n\n  .b80-impact__particles {\n    z-index: 8;\n  }\n\n  .b80-impact__particles i {\n    position: absolute;\n    left: var(--b80-impact-x);\n    top: var(--b80-impact-y);\n    width: 2px;\n    height: 8px;\n    opacity: 0;\n    background: rgba(210, 240, 255, .92);\n    box-shadow: 0 0 7px rgba(66, 165, 255, .66);\n    transform-origin: 50% 0;\n    will-change: transform, opacity;\n  }\n\n  @keyframes b80-sound-nudge {\n    0%, 100% { opacity: .64; transform: translateX(0); }\n    45% { opacity: 1; transform: translateX(-3px); }\n  }\n\n  @media (max-width: 749px) {\n    .b80-impact {\n      --b80-impact-x: 78%;\n      --b80-impact-y: 33%;\n      height: 155vh;\n    }\n\n    .b80-impact__topline {\n      top: 22px;\n      left: 18px;\n      right: 18px;\n    }\n\n    .b80-impact__serial {\n      max-width: 124px;\n    }\n\n    .b80-impact__sound {\n      top: 70px;\n      right: 18px;\n    }\n\n    .b80-impact__racket-anchor {\n      top: 60%;\n    }\n\n    .b80-impact__racket {\n      height: min(62vh, 570px);\n      height: min(62svh, 570px);\n    }\n\n    .b80-impact__shuttle {\n      width: 42px;\n    }\n\n    .b80-impact__copy {\n      left: 18px;\n      right: 18px;\n      bottom: 82px;\n      width: auto;\n    }\n\n    .b80-impact__eyebrow {\n      margin-bottom: 11px;\n      font-size: 9px;\n    }\n\n    .b80-impact__title {\n      width: 96%;\n      font-size: clamp(54px, 17.2vw, 92px);\n      line-height: .78;\n    }\n\n    .b80-impact__subline {\n      gap: 5px 11px;\n      max-width: 320px;\n      margin-top: 16px;\n      font-size: 9px;\n      letter-spacing: .12em;\n    }\n\n    .b80-impact__subline span + span::before {\n      margin-right: 11px;\n    }\n\n    .b80-impact__force {\n      right: 18px;\n      bottom: 24px;\n      width: 164px;\n    }\n\n    .b80-impact__force small {\n      display: none;\n    }\n\n    .b80-impact__force-line {\n      margin-top: 9px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .b80-impact {\n      height: 100vh;\n      height: 100svh;\n      --b80-build: 1;\n      --b80-after: 1;\n    }\n\n    .b80-impact__sound,\n    .b80-impact__trajectory,\n    .b80-impact__force {\n      display: none;\n    }\n\n    .b80-impact__shuttle {\n      opacity: 0;\n    }\n\n    .b80-impact__racket-anchor,\n    .b80-impact__racket,\n    .b80-impact__world {\n      will-change: auto;\n    }\n  }\n</style>\n\n<section\n  class=\"b80-impact\"\n  data-b80-impact\n  data-sound-soft=\"sounds/b80-thock-soft.mp3\"\n  data-sound-medium=\"sounds/b80-thock-medium.mp3\"\n  data-sound-hard=\"sounds/b80-thock-hard.mp3\"\n  aria-labelledby=\"b80-impact-title-demo\"\n>\n  <div class=\"b80-impact__sticky\" data-b80-viewport>\n    <div class=\"b80-impact__world\" data-b80-world>\n      <div class=\"b80-impact__topline\">\n        <p class=\"b80-impact__identity\">Nitrix Bullet 80</p>\n        <p class=\"b80-impact__serial\">B80 / 5.8 MM / Professional attack</p>\n      </div>\n\n      <svg class=\"b80-impact__trajectory\" viewBox=\"0 0 1000 1000\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <path data-b80-trajectory pathLength=\"1\" d=\"M375 342 C 475 128, 660 122, 760 365\"></path>\n      </svg>\n\n      <div class=\"b80-impact__impact-aura\" aria-hidden=\"true\"></div>\n\n      <div class=\"b80-impact__racket-anchor\" data-b80-racket-anchor aria-hidden=\"true\">\n        <div class=\"b80-impact__recoil\" data-b80-recoil>\n          <div class=\"b80-impact__racket\" data-b80-racket>\n            <svg viewBox=\"0 0 240 860\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Nitrix Bullet 80 racket placeholder\">\n                <defs>\n                  <linearGradient id=\"b80-frame-demo\" x1=\"30\" y1=\"35\" x2=\"205\" y2=\"278\" gradientUnits=\"userSpaceOnUse\">\n                    <stop offset=\"0\" stop-color=\"#edf7fb\"/>\n                    <stop offset=\".22\" stop-color=\"#53616a\"/>\n                    <stop offset=\".5\" stop-color=\"#0d1114\"/>\n                    <stop offset=\".73\" stop-color=\"#b9c9d1\"/>\n                    <stop offset=\"1\" stop-color=\"#28323a\"/>\n                  </linearGradient>\n                  <linearGradient id=\"b80-shaft-demo\" x1=\"100\" y1=\"260\" x2=\"141\" y2=\"713\" gradientUnits=\"userSpaceOnUse\">\n                    <stop offset=\"0\" stop-color=\"#dce7ec\"/>\n                    <stop offset=\".28\" stop-color=\"#202a31\"/>\n                    <stop offset=\".58\" stop-color=\"#87959d\"/>\n                    <stop offset=\"1\" stop-color=\"#101417\"/>\n                  </linearGradient>\n                  <linearGradient id=\"b80-grip-demo\" x1=\"91\" y1=\"682\" x2=\"151\" y2=\"850\" gradientUnits=\"userSpaceOnUse\">\n                    <stop offset=\"0\" stop-color=\"#1d2225\"/>\n                    <stop offset=\"1\" stop-color=\"#050606\"/>\n                  </linearGradient>\n                  <pattern id=\"b80-strings-demo\" width=\"12\" height=\"12\" patternUnits=\"userSpaceOnUse\">\n                    <path d=\"M0 0H12M0 0V12\" fill=\"none\" stroke=\"#dbe8ee\" stroke-opacity=\".58\" stroke-width=\".65\"/>\n                  </pattern>\n                  <filter id=\"b80-racket-glow-demo\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n                    <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n                    <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n                  </filter>\n                </defs>\n                <g transform=\"rotate(-2 120 155)\">\n                  <ellipse cx=\"120\" cy=\"152\" rx=\"89\" ry=\"126\" fill=\"rgba(1,3,5,.7)\" stroke=\"url(#b80-frame-demo)\" stroke-width=\"10\"/>\n                  <ellipse cx=\"120\" cy=\"152\" rx=\"78\" ry=\"114\" fill=\"url(#b80-strings-demo)\" stroke=\"rgba(205,226,236,.42)\" stroke-width=\"1.2\"/>\n                  <path d=\"M52 86C74 34 122 21 160 36\" fill=\"none\" stroke=\"#ffa400\" stroke-width=\"4.5\" stroke-linecap=\"round\" filter=\"url(#b80-racket-glow-demo)\"/>\n                  <path d=\"M184 72C207 114 207 180 187 220\" fill=\"none\" stroke=\"#42a5ff\" stroke-width=\"3.5\" stroke-linecap=\"round\" opacity=\".92\"/>\n                  <path d=\"M80 262C96 281 105 292 107 313H133C135 292 144 281 160 262\" fill=\"none\" stroke=\"url(#b80-frame-demo)\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n                  <path d=\"M120 302L121 695\" stroke=\"url(#b80-shaft-demo)\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n                  <path d=\"M124 330L125 616\" stroke=\"#ffa400\" stroke-width=\"2.3\" stroke-linecap=\"round\" opacity=\".9\"/>\n                  <path d=\"M102 682C111 674 132 674 140 682L145 841C134 852 107 852 96 841Z\" fill=\"url(#b80-grip-demo)\"/>\n                  <g stroke=\"#596168\" stroke-width=\"2\" opacity=\".72\">\n                    <path d=\"M100 704L141 722M99 724L142 742M98 744L143 762M98 764L143 782M97 784L144 802M97 804L144 822\"/>\n                  </g>\n                  <path d=\"M103 694H139\" stroke=\"#e7edf0\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n                  <path d=\"M105 844H137\" stroke=\"#ffa400\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n                  <text x=\"130\" y=\"515\" fill=\"#f0f5f7\" font-size=\"13\" font-family=\"Arial, sans-serif\" font-weight=\"700\" letter-spacing=\"2\" transform=\"rotate(90 130 515)\">BULLET 80</text>\n                </g>\n              </svg>\n            \n          </div>\n        </div>\n      </div>\n\n      <div class=\"b80-impact__shuttle\" data-b80-shuttle aria-hidden=\"true\">\n        <svg viewBox=\"0 0 88 124\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <linearGradient id=\"b80-shuttle-cork-demo\" x1=\"24\" y1=\"91\" x2=\"65\" y2=\"121\" gradientUnits=\"userSpaceOnUse\">\n              <stop stop-color=\"#f8f2dd\"/>\n              <stop offset=\"1\" stop-color=\"#a99c7c\"/>\n            </linearGradient>\n          </defs>\n          <g fill=\"none\" stroke=\"#dff3ff\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".92\">\n            <path d=\"M12 5L32 91M27 3L37 91M44 2L44 91M61 3L51 91M76 5L56 91\"/>\n            <path d=\"M12 5C29 17 59 17 76 5M17 27C32 37 56 37 71 27M22 51C34 58 54 58 66 51M27 72C37 77 51 77 61 72\" opacity=\".58\"/>\n          </g>\n          <path d=\"M31 88H57L66 111C58 123 30 123 22 111Z\" fill=\"url(#b80-shuttle-cork-demo)\" stroke=\"#f7f0d8\" stroke-width=\"1.2\"/>\n          <path d=\"M25 103H63\" stroke=\"#ffa400\" stroke-width=\"2.3\" opacity=\".82\"/>\n        </svg>\n      </div>\n\n      <div class=\"b80-impact__copy\">\n        <p class=\"b80-impact__eyebrow\">Impact physics / velocity becomes force</p>\n        <h1 class=\"b80-impact__title\" id=\"b80-impact-title-demo\">\n          <span class=\"b80-impact__title-outline\" aria-hidden=\"true\">\n            <span>Your</span><span>license</span><span>to kill.</span>\n          </span>\n          <span class=\"b80-impact__title-fill\">\n            <span>Your</span><span>license</span><span>to kill.</span>\n          </span>\n        </h1>\n        <p class=\"b80-impact__subline\">\n          <span>5