      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR LANDING PAGE SECTION - CTA BEFORE CARDS + MARQUEE AT BOTTOM -->\n\n<section class=\"hn-predator-rally-section\" aria-label=\"Predator racket rally winner section\">\n  <div class=\"hn-predator-rally__inner\">\n\n    <div class=\"hn-predator-rally__heading-wrap\">\n      <p class=\"hn-predator-rally__eyebrow\">Predator Series</p>\n\n      <h2 class=\"hn-predator-rally__headline\">\n        Every rally has a winner. <br>Make sure it's you.\n      </h2>\n    </div>\n\n    <!-- CTA BEFORE CARDS -->\n    <div class=\"hn-predator-rally__cta-wrap\">\n      <p class=\"hn-predator-rally__cta-kicker\">\n        Trusted by attacking players who don’t hold back\n      </p>\n\n      <a class=\"hn-predator-rally__cta\" href=\"/collections/predator\">\n        Enter Predator Mode\n      </a>\n    </div>\n\n    <div class=\"hn-predator-rally__grid\">\n\n      <!-- LEFT IMAGE -->\n      <div class=\"hn-predator-rally__image-card\">\n        <img\n          class=\"hn-predator-rally__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Predcator_Extra_Strong_X_Extreme_Poster_a581b87b-c8bb-45b9-b709-e3abf3f22c78.jpg?v=1782988066\"\n          alt=\"Two Predator badminton rackets crossed on a dark energy background\"\n          loading=\"eager\"\n          width=\"1200\"\n          height=\"1200\"\n        >\n      </div>\n\n      <!-- RIGHT CONTENT -->\n      <div class=\"hn-predator-rally__content-card\">\n        <div class=\"hn-predator-rally__content-wrap\">\n\n          <h3 class=\"hn-predator-rally__title\">\n            Built for players who decide rallies.\n          </h3>\n\n          <p class=\"hn-predator-rally__body\">\n            The Predator is built for one type of player. The kind who doesn't wait for the rally to open up, they force it open. Japanese graphite. Vapour Shaft. Head-heavy attack balance. Everything on this racket has a reason. Nothing is decoration.\n          </p>\n\n          <h4 class=\"hn-predator-rally__subhead\">\n            Why the Predator wins rallies?\n          </h4>\n\n          <ul class=\"hn-predator-rally__points\" role=\"list\">\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M13.35 2.35 4.65 13.85h6.45l-1.1 7.8 9.35-12.55h-6.55l.55-6.75Z\"></path>\n                </svg>\n              </span>\n              <span>Vapour Shaft. More speed. Same swing.</span>\n            </li>\n\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <circle cx=\"12\" cy=\"12\" r=\"7.1\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"2.45\"></circle>\n                  <path d=\"M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3\"></path>\n                </svg>\n              </span>\n              <span>Japan Graphite. Built for 10,000 impacts.</span>\n            </li>\n\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M7 5.2h10v3.6c0 2.95-2.15 5.25-5 5.25s-5-2.3-5-5.25V5.2Z\"></path>\n                  <path d=\"M5.1 7.1H3.55c0 3.05 1.55 5.1 4.15 5.55M18.9 7.1h1.55c0 3.05-1.55 5.1-4.15 5.55M12 14.05v3.1M8.75 20h6.5M10 17.15h4\"></path>\n                </svg>\n              </span>\n              <span>310mm Head Heavy. Smash from anywhere.</span>\n            </li>\n          </ul>\n\n          <div class=\"hn-predator-rally__gold-line\" aria-hidden=\"true\"></div>\n\n          <div class=\"hn-predator-rally__trust-row\">\n            <span class=\"hn-predator-rally__stars\" aria-label=\"5 star rating\">\n              ★★★★★\n            </span>\n            <span class=\"hn-predator-rally__rating-text\">\n              4.5/5 · Trusted by 1,200+ players across India\n            </span>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n\n    <!-- MARQUEE MOVED TO BOTTOM -->\n    <section class=\"hn-tech-marquee\" aria-label=\"Predator racket technologies\">\n      <div class=\"hn-tech-marquee__viewport\">\n        <div class=\"hn-tech-marquee__track\">\n\n          <!-- SET 1 -->\n          <div class=\"hn-tech-marquee__group\">\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                  <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Head Heavy - 310mm Balance</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon hn-tech-marquee__icon--cyan\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M13 2L4 14h7l-1 8 10-13h-7l0-7z\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text hn-tech-marquee__text--cyan\">Vapour Shaft Technology</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n                  <path d=\"M8 7h8M8 11h8M9 7l3 4 3-4M12 11v6\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Japan Made Graphit