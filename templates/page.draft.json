    "custom_liquid_zmMzbC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .pc2-root *, .pc2-root *::before, .pc2-root *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  .pc2-root {\n    background: #000;\n    width: 100%;\n    overflow: hidden;\n    font-family: 'Inter', sans-serif;\n    padding: 100px 0 92px;\n    opacity: 0;\n    transform: translateY(28px);\n    transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1);\n    position: relative;\n  }\n  .pc2-root.pc2-in { opacity: 1; transform: translateY(0); }\n\n  .pc2-root::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 55% 45% at 18% 50%, rgba(34,197,94,0.06) 0%, transparent 65%),\n      radial-gradient(ellipse 55% 45% at 82% 50%, rgba(34,197,94,0.04) 0%, transparent 65%);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  /* label */\n  .pc2-label {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 5px;\n    text-transform: uppercase;\n    color: rgba(74,222,128,0.5);\n    margin-bottom: 56px;\n    position: relative;\n    z-index: 1;\n  }\n  .pc2-label::before, .pc2-label::after {\n    content: '';\n    width: 28px; height: 1px;\n    background: rgba(74,222,128,0.25);\n    display: block;\n  }\n\n  /* outer */\n  .pc2-outer {\n    position: relative;\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 0 72px;\n    z-index: 1;\n  }\n\n  .pc2-clip {\n    overflow: hidden;\n    border-radius: 16px;\n  }\n\n  .pc2-track {\n    display: flex;\n    transition: transform 0.62s cubic-bezier(0.77,0,0.175,1);\n    will-change: transform;\n  }\n\n  /* glass card */\n  .pc2-card {\n    min-width: 100%;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    background: rgba(255,255,255,0.03);\n    backdrop-filter: blur(24px) saturate(160%);\n    -webkit-backdrop-filter: blur(24px) saturate(160%);\n    border: 1px solid rgba(255,255,255,0.07);\n    border-radius: 16px;\n    overflow: hidden;\n    min-height: 520px;\n    position: relative;\n  }\n  .pc2-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1) 25%, rgba(74,222,128,0.2) 50%, rgba(255,255,255,0.1) 75%, transparent);\n    z-index: 3;\n  }\n\n  /* image pane */\n  .pc2-img {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    padding: 60px 44px;\n    background: rgba(0,0,0,0.25);\n  }\n  .pc2-img::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse 70% 60% at 50% 55%, rgba(34,197,94,0.12) 0%, transparent 65%);\n    pointer-events: none;\n  }\n  .pc2-img img {\n    width: 100%;\n    max-width: 260px;\n    height: auto;\n    object-fit: contain;\n    position: relative;\n    z-index: 1;\n    transition: transform 0.7s cubic-bezier(0.22,1,0.36,1), filter 0.5s ease;\n    display: block;\n    filter: drop-shadow(0 8px 32px rgba(34,197,94,0.15));\n  }\n  .pc2-card.pc2-active .pc2-img img {\n    transform: scale(1.06) translateY(-4px);\n    filter: drop-shadow(0 16px 48px rgba(34,197,94,0.28));\n  }\n  .pc2-badge {\n    position: absolute;\n    top: 22px; left: 22px;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 11px;\n    letter-spacing: 3px;\n    color: rgba(74,222,128,0.3);\n    z-index: 2;\n  }\n\n  /* divider */\n  .pc2-divider {\n    width: 1px;\n    flex-shrink: 0;\n    background: linear-gradient(180deg, transparent 0%, rgba(74,222,128,0.14) 25%, rgba(74,222,128,0.14) 75%, transparent 100%);\n  }\n\n  /* content */\n  .pc2-content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 64px 56px;\n    background: rgba(0,0,0,0.15);\n    position: relative;\n  }\n  .pc2-content::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    width: 180px; height: 180px;\n    background: radial-gradient(ellipse at top right, rgba(74,222,128,0.05) 0%, transparent 65%);\n    pointer-events: none;\n  }\n\n  .pc2-num {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 11px;\n    letter-spacing: 4px;\n    color: rgba(74,222,128,0.32);\n    margin-bottom: 18px;\n    display: block;\n  }\n  .pc2-headline {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: clamp(38px, 3.8vw, 56px);\n    line-height: 0.96;\n    letter-spacing: 0.5px;\n    color: #fff;\n    margin-bottom: 22px;\n  }\n  .pc2-headline em {\n    font-style: normal;\n    color: #4ade80;\n    display: block;\n  }\n  .pc2-body {\n    font-size: 15px;\n    font-weight: 400;\n    color: rgba(180,180,180,0.8);\n    line-height: 1.8;\n    max-width: 290px;\n    margin-bottom: 36px;\n  }\n  .pc2-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: rgba(74,222,128,0.8);\n    padding: 9px 18px;\n    background: rgba(74,222,128,0.06);\n    border: 1px solid rgba(74,222,128,0.15);\n    border-radius: 100px;\n    width: fit-content;\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n  }\n  .pc2-tag::before {\n    content: '';\n    width: 5px; height: 5px;\n    border-radius: 50%;\n    background: #4ade80;\n    box-shadow: 0 0 6px rgba(74,222,128,0.6);\n    flex-shrink: 0;\n  }\n\n  /* arrows */\n  .pc2-arrow {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 46px; height: 46px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.1);\n    background: rgba(255,255,255,0.05);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    color: rgba(255,255,255,0.7);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    z-index: 10;\n    transition: border-color 0.25s, background 0.25s, color 0.25s, transform 0.2s;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .pc2-arrow:hover {\n    border-color: rgba(74,222,128,0.4);\n    background: rgba(74,222,128,0.1);\n    color: #4ade80;\n    transform: translateY(-50%) scale(1.1);\n  }\n  .pc2-arrow:active { transform: translateY(-50%) scale(0.94); }\n  .pc2-arrow[disabled] { opacity: 0.18; pointer-events: none; }\n  .pc2-arrow svg { width: 16px; height: 16px; pointer-events: none; }\n  .pc2-arrow--prev { left: 10px; }\n  .pc2-arrow--next { right: 10px; }\n\n  /* ── PROGRESS BARS ── */\n  .pc2-dots {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 44px;\n    position: relative;\n    z-index: 1;\n  }\n\n  .pc2-dot {\n    position: relative;\n    width: 64px;\n    height: 3px;\n    border-radius: 100px;\n    background: rgba(255,255,255,0.1);\n    border: none;\n    cursor: pointer;\n    padding: 0;\n    overflow: hidden;\n    -webkit-tap-highlight-color: transparent;\n    flex-shrink: 0;\n  }\n\n  /* the animated fill — JS drives width via requestAnimationFrame */\n  .pc2-dot__fill {\n    position: absolute;\n    top: 0; left: 0;\n    height: 100%;\n    width: 0%;\n    border-radius: 100px;\n    background: linear-gradient(90deg, #22c55e, #4ade80);\n    box-shadow: 0 0 8px rgba(74,222,128,0.55);\n    will-change: width;\n    pointer-events: none;\n  }\n\n  /* mobile */\n  @media (max-width: 768px) {\n    .pc2-root { padding: 72px 0 64px; }\n    .pc2-outer { padding: 0 16px; }\n    .pc2-card { grid-template-columns: 1fr; min-height: unset; }\n    .pc2-img { padding: 48px 40px; min-height: 260px; }\n    .pc2-img img { max-width: 200px; }\n    .pc2-divider {\n      width: 100%; height: 1px;\n      background: linear-gradient(90deg, transparent 5%, rgba(74,222,128,0.12) 50%, transparent 95%);\n    }\n    .pc2-content { padding: 44px 32px 52px; }\n    .pc2-body { max-width: 100%; font-size: 14px; }\n    .pc2-arrow { display: none; }\n    .pc2-dot { width: 44px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pc2-root { opacity:1!important; transform:none!important; transition:none!important; }\n    .pc2-track { transition:none!important; }\n    .pc2-img img { transition:none!important; }\n  }\n</style>\n\n<section class=\"pc2-root\" aria-label=\"Predator Identity Carousel\">\n\n  <p class=\"pc2-label\">What You Play For</p>\n\n  <div class=\"pc2-outer\">\n    <button class=\"pc2-arrow pc2-arrow--prev\" aria-label=\"Previous\" disabled>\n      <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M10 3L5 8l5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n    <div class=\"pc2-clip\">\n      <div class=\"pc2-track\">\n\n        <div class=\"pc2-card pc2-active\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">01 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-black.png\" alt=\"Predator 82 Black\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">01</span>\n            <h2 class=\"pc2-headline\">The Smash That <em>Ends the Point.</em></h2>\n            <p class=\"pc2-body\">Not a shot. A statement. One swing and the rally is over before they even move.</p>\n            <span class=\"pc2-tag\">Pure Aggression</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">02 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-red.png\" alt=\"Predator 82 Red\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">02</span>\n            <h2 class=\"pc2-headline\">Your Arm Wants <em>to Swing.</em></h2>\n            <p class=\"pc2-body\">We made sure it can. Every frame angle engineered so your speed never lies — less drag, more devastation.</p>\n            <span class=\"pc2-tag\">Fast Strike</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">03 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-blue.png\" alt=\"Predator 82 Blue\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">03</span>\n            <h2 class=\"pc2-headline\">Built for the Player <em>Who Goes First.</em></h2>\n            <p class=\"pc2-body\">Always. No hesitation. No waiting. You step in — the Predator holds up every single time.</p>\n            <span class=\"pc2-tag\">Point Finisher</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">04 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-84.png\" alt=\"Predator 84\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">04</span>\n            <h2 class=\"pc2-headline\">Every Gram <em>Is Accountable.</em></h2>\n            <p class=\"pc2-body\">Nothing wasted. Nothing soft. Built light so you swing twice before they recover once.</p>\n            <span class=\"pc2-tag\">Clean Power</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <button class=\"pc2-arrow pc2-arrow--next\" aria-label=\"Next\">\n      <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M6 3l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"pc2-dots\" role=\"tablist\">\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 1\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 2\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 3\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 4\"><span class=\"pc2-dot__fill\"></span></button>\n  </div>\n\n</section>\n\n<script>\n(function () {\n  var DURATION = 4500; // ms per slide\n\n  var root  = document.querySelector('.pc2-root');\n  var track = document.querySelector('.pc2-track');\n  var cards = document.querySelectorAll('.pc2-card');\n  var dots  = document.querySelectorAll('.pc2-dot');\n  var btnP  = document.querySelector('.pc2-arrow--prev');\n  var btnN  = document.querySelector('.pc2-arrow--next');\n  if (!root || !track) return;\n\n  var total   = cards.length;\n  var cur     = 0;\n  var paused  = false;\n\n  // rAF-based timer state\n  var rafId       = null;\n  var startTs     = null;   // when current slide timer started\n  var elapsed     = 0;      // ms already consumed before a pause\n\n  /* ── get fill el for dot i ── */\n  function fill(i) { return dots[i].querySelector('.pc2-dot__fill'); }\n\n  /* ── set fill width instantly ── */\n  function setFill(i, pct) {\n    fill(i).style.width = pct + '%';\n  }\n\n  /* ── cancel rAF loop ── */\n  function cancelLoop() {\n    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }\n  }\n\n  /* ── rAF loop: animates active dot fill in real time ── */\n  function startLoop(fromElapsed) {\n    elapsed  = fromElapsed || 0;\n    startTs  = null;\n\n    function tick(ts) {\n      if (!startTs) startTs = ts;\n      var delta = ts - startTs + elapsed;\n\n      // update fill\n      var pct = Math.min(delta / DURATION * 100, 100);\n      setFill(cur, pct);\n\n      if (delta >= DURATION) {\n        // auto-advance\n        advance();\n        return;\n      }\n      rafId = requestAnimationFrame(tick);\n    }\n    rafId = requestAnimationFrame(tick);\n  }\n\n  /* ── advance to next slide ── */\n  function advance() {\n    cancelLoop();\n    var next_i = cur < total - 1 ? cur + 1 : 0;\n    goTo(next_i);\n  }\n\n  /* ── go to slide ── */\n  function goTo(i) {\n    cancelLoop();\n\n    // outgoing card\n    cards[cur].classList.remove('pc2-active');\n\n    // fill all before i as 100%, after i as 0%\n    for (var d = 0; d < total; d++) {\n      setFill(d, d < i ? 100 : 0);\n    }\n\n    cur = i;\n    track.style.transform = 'translateX(-' + (cur * 100) + '%)';\n    cards[cur].classList.add('pc2-active');\n    btnP.disabled = cur === 0;\n    btnN.disabled = cur === total - 1;\n\n    if (!paused) startLoop(0);\n  }\n\n  /* ── pause: freeze fill in place ── */\n  function pause() {\n    if (paused) return;\n    paused = true;\n    cancelLoop();\n    // record how much time has passed so we can resume from here\n    // fill width % → ms\n    var currentPct = parseFloat(fill(cur).style.width) || 0;\n    elapsed = currentPct / 100 * DURATION;\n  }\n\n  /* ── resume: continue from frozen point ── */\n  function resume() {\n    if (!paused) return;\n    paused = false;\n    startLoop(elapsed);\n  }\n\n  /* ── hover pause/resume on the card area ── */\n  var clip = document.querySelector('.pc2-clip');\n  clip.addEventListener('mouseenter', pause);\n  clip.addEventListener('mouseleave', resume);\n\n  /* ── touch ── */\n  var touchStartX = 0;\n  clip.addEventListener('touchstart', function (e) {\n    pause();\n    touchStartX = e.touches[0].clientX;\n  }, { passive: true });\n  clip.addEventListener('touchend', function (e) {\n    var diff = touchStartX - e.changedTouches[0].clientX;\n    if (Math.abs(diff) > 44) {\n      goTo(diff > 0 ? Math.min(cur + 1, total - 1) : Math.max(cur - 1, 0));\n    } else {\n      resume();\n    }\n  }, { passive: true });\n\n  /* ── arrows ── */\n  btnP.addEventListener('click', function () { goTo(Math.max(cur - 1, 0)); });\n  btnN.addEventListener('click', function () { goTo(Math.min(cur + 1, total - 1)); });\n\n  /* ── dots ── */\n  dots.forEach(function (dot, i) {\n    dot.addEventListener('click', function () { goTo(i); });\n  });\n\n  /* ── keyboard ── */\n  document.addEventListener('keydown', function (e) {\n    if (!root.matches(':hover') && !root.contains(document.activeElement)) return;\n    if (e.key === 'ArrowLeft')  goTo(Math.max(cur - 1, 0));\n    if (e.key === 'ArrowRight') goTo(Math.min(cur + 1, total - 1));\n  });\n\n  /* ── entrance ── */\n  new IntersectionObserver(function (entries) {\n    if (entries[0].isIntersecting) {\n      root.classList.add('pc2-in');\n      startLoop(0); // kick off\n    }\n  }, { threshold: 0.12 }).observe(root);\n\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_VV4Xn6": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #120603 !important;\n  }\n\n  .px-look {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    padding: clamp(48px, 6vw, 86px) 20px;\n    background:\n      radial-gradient(circle at 70% 0%, rgba(255, 91, 31, 0.14), transparent 32%),\n      linear-gradient(180deg, #120603 0%, #1b0803 48%, #080201 100%);\n    color: #fff0cf;\n    font-family: Arial, Helvetica, sans-serif;\n    overflow: hidden;\n  }\n\n  .px-look__head {\n    width: min(1320px, 100%);\n    margin: 0 auto 34px;\n    opacity: 0;\n    transform: translateY(28px);\n    transition: opacity 0.8s ease, transform 0.8s ease;\n  }\n\n  .px-look.is-inview .px-look__head {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .px-look__eyebrow {\n    margin: 0 0 12px;\n    color: #f4b15f;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 3.6px;\n    text-transform: uppercase;\n  }\n\n  .px-look__title {\n    margin: 0;\n    max-width: 880px;\n    font-size: clamp(42px, 5.7vw, 88px);\n    line-height: 0.9;\n    letter-spacing: -3px;\n    font-weight: 950;\n    color: #fff0cf;\n  }\n\n  .px-look__title span {\n    color: #ff6422;\n    text-shadow: 0 0 34px rgba(255, 100, 34, 0.38);\n  }\n\n  .px-look__sub {\n    margin: 18px 0 0;\n    color: rgba(255, 231, 196, 0.74);\n    font-size: clamp(16px, 1.5vw, 21px);\n    line-height: 1.3;\n    font-weight: 800;\n  }\n\n  .px-look__stage {\n    position: relative;\n    width: min(1320px, 100%);\n    min-height: 760px;\n    margin: 0 auto;\n    border-radius: 34px;\n    overflow: hidden;\n    isolation: isolate;\n    background:\n      radial-gradient(circle at 64% 42%, rgba(255, 95, 26, 0.22), transparent 29%),\n      radial-gradient(circle at 70% 84%, rgba(246, 199, 109, 0.11), transparent 42%),\n      linear-gradient(135deg, #030100 0%, #120401 50%, #030100 100%);\n    box-shadow:\n      inset 0 0 0 1px rgba(246, 199, 109, 0.12),\n      0 44px 140px rgba(0, 0, 0, 0.78);\n    opacity: 0;\n    transform: translateY(42px) scale(0.985);\n    transition: opacity 0.9s ease 0.12s, transform 0.9s ease 0.12s;\n  }\n\n  .px-look.is-inview .px-look__stage {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  .px-look__stage::before {\n    content: \"EXTREME\";\n    position: absolute;\n    right: -8%;\n    bottom: 8%;\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: clamp(128px, 18vw, 310px);\n    line-height: 0.8;\n    letter-spacing: 10px;\n    color: transparent;\n    -webkit-text-stroke: 1px rgba(246, 199, 109, 0.09);\n    pointer-events: none;\n    z-index: -3;\n  }\n\n  .px-look__close {\n    position: absolute;\n    right: 22px;\n    top: 22px;\n    z-index: 20;\n    width: 42px;\n    height: 42px;\n    border: 0;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.12);\n    color: #fff;\n    font-size: 28px;\n    line-height: 1;\n    font-weight: 800;\n    cursor: pointer;\n    opacity: 0;\n    pointer-events: none;\n    transition: 0.2s ease;\n  }\n\n  .px-look__stage.has-active .px-look__close {\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .px-look__visual {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    padding: 80px 70px 90px 390px;\n    z-index: 2;\n  }\n\n  .px-look__image-wrap {\n    position: relative;\n    width: min(58vw, 780px);\n    height: min(45vw, 520px);\n    max-height: 520px;\n    display: grid;\n    place-items: center;\n  }\n\n  .px-look__image-wrap::before {\n    content: \"\";\n    position: absolute;\n    inset: 12% 5%;\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(255, 95, 26, 0.28), transparent 62%);\n    filter: blur(24px);\n  }\n\n  .px-look__image {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: center;\n    filter:\n      drop-shadow(0 0 38px rgba(255, 95, 26, 0.32))\n      drop-shadow(0 48px 110px rgba(0, 0, 0, 0.98));\n    transform: rotate(-5deg) scale(0.96);\n    opacity: 0;\n    transition: opacity 0.28s ease, transform 0.42s ease;\n  }\n\n  .px-look.is-inview .px-look__image {\n    opacity: 1;\n    transform: rotate(-5deg) scale(1);\n    transition: opacity 0.9s ease 0.38s, transform 0.9s cubic-bezier(.16,.84,.22,1) 0.38s;\n  }\n\n  .px-look__stage.is-changing .px-look__image {\n    opacity: 0;\n    transform: rotate(-12deg) scale(0.92) translateY(16px);\n    transition: opacity 0.28s ease, transform 0.42s ease;\n  }\n\n  .px-look__list {\n    position: absolute;\n    left: clamp(24px, 5vw, 78px);\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 9;\n    width: min(440px, 34vw);\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .px-look__item {\n    width: 100%;\n  }\n\n  .px-look__btn {\n    width: max-content;\n    min-width: 178px;\n    border: 1px solid rgba(246, 199, 109, 0.14);\n    border-radius: 999px;\n    padding: 14px 22px 14px 14px;\n    background: rgba(36, 34, 35, 0.74);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    color: rgba(255, 247, 230, 0.92);\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    font-size: 15px;\n    font-weight: 950;\n    cursor: pointer;\n    transition: 0.25s ease;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .px-look__btn:hover {\n    transform: translateX(6px);\n    background: rgba(55, 48, 45, 0.86);\n  }\n\n  .px-look__mark {\n    width: 28px;\n    height: 28px;\n    flex: 0 0 28px;\n    border-radius: 999px;\n    display: grid;\n    place-items: center;\n    border: 1px solid rgba(255, 247, 230, 0.68);\n    color: #fff7e6;\n    font-size: 18px;\n  }\n\n  .px-look__item.is-active .px-look__btn {\n    display: none;\n  }\n\n  .px-look__panel {\n    display: none;\n    width: min(440px, 100%);\n    border-radius: 30px;\n    background: rgba(35, 35, 37, 0.82);\n    backdrop-filter: blur(26px);\n    -webkit-backdrop-filter: blur(26px);\n    padding: 28px 30px 30px;\n    color: #f5f5f7;\n    box-shadow:\n      inset 0 0 0 1px rgba(255, 255, 255, 0.06),\n      0 28px 80px rgba(0, 0, 0, 0.58);\n  }\n\n  .px-look__item.is-active .px-look__panel {\n    display: block;\n    animation: px-panel-in 0.25s ease-out;\n  }\n\n  .px-look__copy {\n    margin: 0;\n    color: rgba(245, 245, 247, 0.94);\n    font-size: 17px;\n    line-height: 1.45;\n    font-weight: 800;\n    letter-spacing: -0.25px;\n  }\n\n  .px-look__copy strong {\n    color: #fff;\n    font-weight: 950;\n  }\n\n  .px-look__chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 18px;\n  }\n\n  .px-look__chip {\n    border-radius: 999px;\n    border: 1px solid rgba(244, 177, 95, 0.32);\n    background: rgba(244, 177, 95, 0.09);\n    color: #f7dcc1;\n    padding: 8px 11px;\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .px-look__swatches {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-top: 20px;\n  }\n\n  .px-look__swatch {\n    width: 42px;\n    height: 42px;\n    border-radius: 999px;\n    border: 2px solid rgba(255, 240, 207, 0.22);\n    cursor: pointer;\n    transition: 0.2s ease;\n  }\n\n  .px-look__swatch.is-active {\n    border-color: #f6c76d;\n    transform: scale(1.08);\n    box-shadow:\n      0 0 0 3px rgba(246, 199, 109, 0.16),\n      0 0 28px rgba(255, 100, 34, 0.4);\n  }\n\n  .px-look__swatch.black { background: #000; }\n  .px-look__swatch.white { background: #f7f4ec; }\n  .px-look__swatch.cyan-grey {\n    background: linear-gradient(135deg, #18dfe6 0%, #18dfe6 48%, #9a9a9a 49%, #9a9a9a 100%);\n  }\n\n  .px-look__arrow {\n    position: absolute;\n    z-index: 18;\n    width: 48px;\n    height: 48px;\n    border: 0;\n    border-radius: 999px;\n    background: rgba(34, 34, 36, 0.86);\n    color: #fff;\n    font-size: 32px;\n    cursor: pointer;\n    display: none;\n    place-items: center;\n  }\n\n  @keyframes px-panel-in {\n    from { opacity: 0; transform: translateY(-8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (max-width: 900px) {\n    .px-look {\n      padding: 44px 0 58px;\n    }\n\n    .px-look__head {\n      width: min(430px, calc(100% - 36px));\n      margin-bottom: 18px;\n    }\n\n    .px-look__title {\n      font-size: clamp(38px, 11vw, 56px);\n      letter-spacing: -1.8px;\n    }\n\n    .px-look__stage {\n      width: min(430px, 100vw);\n      min-height: 720px;\n      border-radius: 0;\n      background: #000;\n      display: flex;\n      flex-direction: column;\n      margin: 0 auto;\n    }\n\n    .px-look__stage::before {\n      display: none;\n    }\n\n    .px-look__close {\n      right: 18px;\n      top: 18px;\n      width: 38px;\n      height: 38px;\n      font-size: 25px;\n      background: rgba(255,255,255,0.12);\n    }\n\n    .px-look__visual {\n      position: relative;\n      inset: auto;\n      height: 470px;\n      padding: 54px 16px 0;\n      order: 1;\n    }\n\n    .px-look__image-wrap {\n      width: 100%;\n      height: 390px;\n    }\n\n    .px-look.is-inview .px-look__image {\n      transform: rotate(-4deg) scale(1.02);\n    }\n\n    .px-look__list {\n      position: absolute;\n      left: 0 !important;\n      right: 0 !important;\n      top: auto !important;\n      bottom: 22px !important;\n      transform: none !important;\n      width: 100% !important;\n      flex-direction: row;\n      overflow-x: auto;\n      overflow-y: hidden;\n      gap: 12px;\n      padding: 0 18px;\n      scrollbar-width: none;\n      scroll-snap-type: x mandatory;\n      scroll-padding-left: 18px;\n      z-index: 11;\n    }\n\n    .px-look__list::-webkit-scrollbar {\n      display: none;\n    }\n\n    .px-look__item {\n      flex: 0 0 auto;\n      width: auto;\n      scroll-snap-align: start;\n    }\n\n    .px-look__item.is-active {\n      display: none;\n    }\n\n    .px-look__btn {\n      height: 54px;\n      min-width: 150px;\n      max-width: none;\n      padding: 12px 18px 12px 12px;\n      border-radius: 999px;\n      gap: 12px;\n      font-size: 13px;\n      line-height: 1;\n      letter-spacing: 0;\n      white-space: nowrap;\n      overflow: visible;\n      text-overflow: unset;\n      display: inline-flex;\n      align-items: center;\n      justify-content: flex-start;\n      background: rgba(35,35,37,0.9);\n    }\n\n    .px-look__btn:hover {\n      transform: none;\n    }\n\n    .px-look__mark {\n      width: 24px;\n      height: 24px;\n      min-width: 24px;\n      flex: 0 0 24px;\n      font-size: 16px;\n    }\n\n    .px-look__mobile-panel {\n      position: absolute;\n      left: 38px;\n      right: 38px;\n      bottom: 98px;\n      z-index: 12;\n      border-radius: 26px;\n      background: rgba(35,35,37,0.9);\n      backdrop-filter: blur(26px);\n      -webkit-backdrop-filter: blur(26px);\n      padding: 25px 25px 27px;\n      color: #f5f5f7;\n      box-shadow:\n        inset 0 0 0 1px rgba(255,255,255,0.06),\n        0 28px 80px rgba(0,0,0,0.58);\n      opacity: 0;\n      pointer-events: none;\n      transform: translateY(12px);\n      transition: 0.25s ease;\n    }\n\n    .px-look__stage.has-active .px-look__mobile-panel {\n      opacity: 1;\n      pointer-events: auto;\n      transform: translateY(0);\n    }\n\n    .px-look__copy {\n      font-size: 15px;\n      line-height: 1.42;\n    }\n\n    .px-look__stage.has-active .px-look__arrow {\n      display: grid;\n    }\n\n    .px-look__arrow {\n      bottom: 118px;\n    }\n\n    .px-look__arrow.prev {\n      left: 10px;\n    }\n\n    .px-look__arrow.next {\n      right: 10px;\n    }\n\n    .px-look__arrow.is-hidden {\n      display: none !important;\n    }\n\n    .px-look__swatch {\n      width: 34px;\n      height: 34px;\n    }\n\n    .px-look__chip {\n      font-size: 9px;\n      padding: 7px 9px;\n    }\n  }\n\n  @media (min-width: 901px) {\n    .px-look__mobile-panel {\n      display: none;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .px-look__head,\n    .px-look__stage,\n    .px-look__image,\n    .px-look__panel,\n    .px-look__mobile-panel {\n      transition: none !important;\n      animation: none !important;\n      opacity: 1 !important;\n      transform: none !important;\n    }\n  }\n</style>\n\n<section class=\"px-look\" id=\"px-look-{{ section.id }}\" aria-label=\"Predator 84 Extreme close look\">\n  <div class=\"px-look__head\">\n    <p class=\"px-look__eyebrow\">Predator 84 Extreme</p>\n    <h2 class=\"px-look__title\">Take a closer look at <span>attack.</span></h2>\n    <p class=\"px-look__sub\">The build that turns pressure into points.</p>\n  </div>\n\n  <div class=\"px-look__stage\">\n    <button class=\"px-look__close\" type=\"button\" aria-label=\"Close detail\">×</button>\n    <button class=\"px-look__arrow prev\" type=\"button\" aria-label=\"Previous detail\">‹</button>\n    <button class=\"px-look__arrow next\" type=\"button\" aria-label=\"Next detail\">›</button>\n\n    <div class=\"px-look__visual\">\n      <div class=\"px-look__image-wrap\">\n        <img\n          class=\"px-look__image\"\n          src=\"https://in.hndrd.co/cdn/shop/files/Template_03_e8e601ee62.png?v=1745484137&width=1200\"\n          alt=\"Predator 84 Extreme badminton racket\"\n        >\n      </div>\n    </div>\n\n    <div class=\"px-look__mobile-panel\">\n      <p class=\"px-look__copy\"></p>\n      <div class=\"px-look__swatches\"></div>\n      <div class=\"px-look__chips\"></div>\n    </div>\n\n    <div class=\"px-look__list\" aria-label=\"Detail selector\">\n      <div class=\"px-look__item\" data-index=\"0\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Tension</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n      <div class=\"px-look__item\" data-index=\"1\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Colours</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n      <div class=\"px-look__item\" data-index=\"2\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Balance</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n      <div class=\"px-look__item\" data-index=\"3\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Shaft</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n      <div class=\"px-look__item\" data-index=\"4\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Frame</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n      <div class=\"px-look__item\" data-index=\"5\">\n        <button class=\"px-look__btn\" type=\"button\"><span class=\"px-look__mark\">+</span> Build</button>\n        <div class=\"px-look__panel\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  (() => {\n    const root = document.querySelector('#px-look-{{ section.id }}');\n    if (!root) return;\n\n    const stage = root.querySelector('.px-look__stage');\n    const image = root.querySelector('.px-look__image');\n    const items = [...root.querySelectorAll('.px-look__item')];\n    const close = root.querySelector('.px-look__close');\n    const prev = root.querySelector('.px-look__arrow.prev');\n    const next = root.querySelector('.px-look__arrow.next');\n    const mobilePanel = root.querySelector('.px-look__mobile-panel');\n    const list = root.querySelector('.px-look__list');\n\n    let activeIndex = -1;\n\n    const defaultImage = 'https://in.hndrd.co/cdn/shop/files/Template_03_e8e601ee62.png?v=1745484137&width=1200';\n\n    const colourImages = {\n      black: 'https://in.hndrd.co/cdn/shop/files/Template_04_7ccbb55a71.png?v=1745484137&width=1200',\n      white: 'https://in.hndrd.co/cdn/shop/files/Template_02_129d426a5b.png?v=1745484140&width=1200',\n      cyanGrey: 'https://in.hndrd.co/cdn/shop/files/Template_03_e8e601ee62.png?v=1745484137&width=1200'\n    };\n\n    const details = [\n      {\n        image: defaultImage,\n        copy: '<strong>Tension.</strong> Built for a tight string bed and a harder exit off every clean hit.',\n        chips: ['Max 32 LBS', 'Clean Impact']\n      },\n      {\n        image: colourImages.cyanGrey,\n        copy: '<strong>Colours.</strong> Pick the face of your attack. Black, White, or Cyan/Dark Grey.',\n        chips: ['Black', 'White', 'Cyan / Dark Grey'],\n        colours: true\n      },\n      {\n        image: 'https://in.hndrd.co/cdn/shop/files/Template_04_7ccbb55a71.png?v=1745484137&width=1200',\n        copy: '<strong>Balance.</strong> Head heavy feel puts more weight behind the finish.',\n        chips: ['Head Heavy', '310 MM BP']\n      },\n      {\n        image: 'https://in.hndrd.co/cdn/shop/files/Template_05_b90612d96f.png?v=1745484137&width=1200',\n        copy: '<strong>Shaft.</strong> Flexible Vaporshaft 7.0 loads energy, then snaps it back.',\n        chips: ['Flexible', '7.0 MM']\n      },\n      {\n        image: 'https://in.hndrd.co/cdn/shop/files/Template_06_b808791384.png?v=1745484137&width=1200',\n        copy: '<strong>Frame.</strong> Curve² cuts through air for a faster, cleaner swing.',\n        chips: ['Curve²', 'Air Cut']\n      },\n      {\n        image: 'https://in.hndrd.co/cdn/shop/files/Template_07_7d520cd38f.png?v=1745484137&width=1200',\n        copy: '<strong>Build.</strong> Japan Made Graphite keeps the frame steady under pressure.',\n        chips: ['Japan Graphite', '84G 4U', 'G6 Grip']\n      }\n    ];\n\n    const isMobile = () => window.matchMedia('(max-width: 900px)').matches;\n\n    const setImage = (src) => {\n      stage.classList.add('is-changing');\n      setTimeout(() => {\n        image.src = src;\n        stage.classList.remove('is-changing');\n      }, 150);\n    };\n\n    const chipHTML = (chips) => chips.map((chip) => `<span class=\"px-look__chip\">${chip}</span>`).join('');\n\n    const swatchHTML = () => `\n      <div class=\"px-look__swatches\" style=\"display:flex;\">\n        <button class=\"px-look__swatch black\" type=\"button\" data-colour=\"black\" aria-label=\"Black colour\"></button>\n        <button class=\"px-look__swatch white\" type=\"button\" data-colour=\"white\" aria-label=\"White colour\"></button>\n        <button class=\"px-look__swatch cyan-grey is-active\" type=\"button\" data-colour=\"cyanGrey\" aria-label=\"Cyan Dark Grey colour\"></button>\n      </div>\n    `;\n\n    const bindSwatches = (scope) => {\n      const swatches = [...scope.querySelectorAll('.px-look__swatch')];\n\n      swatches.forEach((swatch) => {\n        swatch.addEventListener('click', (event) => {\n          event.stopPropagation();\n          swatches.forEach((item) => item.classList.remove('is-active'));\n          swatch.classList.add('is-active');\n          setImage(colourImages[swatch.dataset.colour]);\n        });\n      });\n    };\n\n    const updateArrows = () => {\n      prev.classList.toggle('is-hidden', activeIndex <= 0);\n      next.classList.toggle('is-hidden', activeIndex >= details.length - 1 || activeIndex < 0);\n    };\n\n    const scrollMobileList = () => {\n      if (!isMobile()) return;\n\n      if (activeIndex < 0) {\n        list.scrollTo({ left: 0, behavior: 'smooth' });\n        return;\n      }\n\n      if (activeIndex >= details.length - 1) {\n        list.scrollTo({\n          left: list.scrollWidth - list.clientWidth,\n          behavior: 'smooth'\n        });\n        return;\n      }\n\n      const nextVisible = items.find((item) => {\n        return Number(item.dataset.index) > activeIndex && !item.classList.contains('is-active');\n      });\n\n      if (nextVisible) {\n        const targetLeft = nextVisible.offsetLeft - list.offsetLeft - 18;\n        list.scrollTo({ left: targetLeft, behavior: 'smooth' });\n      }\n    };\n\n    const openItem = (index) => {\n      activeIndex = Math.max(0, Math.min(index, details.length - 1));\n      const detail = details[activeIndex];\n\n      items.forEach((item) => {\n        item.classList.remove('is-active');\n        item.querySelector('.px-look__panel').innerHTML = '';\n      });\n\n      const activeItem = items[activeIndex];\n      activeItem.classList.add('is-active');\n\n      const html = `\n        <p class=\"px-look__copy\">${detail.copy}</p>\n        ${detail.colours ? swatchHTML() : ''}\n        <div class=\"px-look__chips\">${chipHTML(detail.chips)}</div>\n      `;\n\n      if (isMobile()) {\n        mobilePanel.innerHTML = html;\n        bindSwatches(mobilePanel);\n      } else {\n        const panel = activeItem.querySelector('.px-look__panel');\n        panel.innerHTML = html;\n        bindSwatches(panel);\n      }\n\n      stage.classList.add('has-active');\n      setImage(detail.image);\n      updateArrows();\n\n      if (isMobile()) {\n        requestAnimationFrame(scrollMobileList);\n      } else {\n        activeItem.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });\n      }\n    };\n\n    const reset = () => {\n      activeIndex = -1;\n      stage.classList.remove('has-active');\n\n      items.forEach((item) => {\n        item.classList.remove('is-active');\n        item.querySelector('.px-look__panel').innerHTML = '';\n      });\n\n      mobilePanel.innerHTML = '<p class=\"px-look__copy\"></p><div class=\"px-look__swatches\"></div><div class=\"px-look__chips\"></div>';\n      setImage(defaultImage);\n      updateArrows();\n\n      if (isMobile()) {\n        list.scrollTo({ left: 0, behavior: 'smooth' });\n      }\n    };\n\n    items.forEach((item) => {\n      item.querySelector('.px-look__btn').addEventListener('click', () => {\n        openItem(Number(item.dataset.index));\n      });\n    });\n\n    prev.addEventListener('click', () => {\n      if (activeIndex > 0) openItem(activeIndex - 1);\n    });\n\n    next.addEventListener('click', () => {\n      if (activeIndex < details.length - 1) openItem(activeIndex + 1);\n    });\n\n    close.addEventListener('click', reset);\n\n    window.addEventListener('resize', () => {\n      if (activeIndex >= 0) openItem(activeIndex);\n    });\n\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) {\n          root.classList.add('is-inview');\n          observer.unobserve(root);\n        }\n      });\n    }, { threshold: 0.28 });\n\n    observer.observe(root);\n    updateArrows();\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_QTkpbn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #050100 !important;\n  }\n\n  .pred-family {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    padding: clamp(56px, 7vw, 110px) 20px;\n    background:\n      radial-gradient(circle at 70% 0%, rgba(255, 99, 31, 0.15), transparent 34%),\n      radial-gradient(circle at 16% 92%, rgba(246, 186, 92, 0.09), transparent 32%),\n      linear-gradient(180deg, #050100 0%, #120401 52%, #050100 100%);\n    color: #fff0cf;\n    font-family: Arial, Helvetica, sans-serif;\n    overflow: hidden;\n  }\n\n  .pred-family__head {\n    width: min(1320px, 100%);\n    margin: 0 auto clamp(34px, 5vw, 70px);\n  }\n\n  .pred-family__eyebrow {\n    margin: 0 0 12px;\n    color: #f4b15f;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 3.6px;\n    text-transform: uppercase;\n  }\n\n  .pred-family__title {\n    margin: 0;\n    max-width: 920px;\n    font-size: clamp(44px, 6vw, 94px);\n    line-height: 0.9;\n    letter-spacing: -3px;\n    font-weight: 950;\n    color: #fff0cf;\n  }\n\n  .pred-family__title span {\n    color: #ff6422;\n    text-shadow: 0 0 34px rgba(255, 100, 34, 0.38);\n  }\n\n  .pred-family__sub {\n    margin: 18px 0 0;\n    max-width: 620px;\n    color: rgba(255, 231, 196, 0.74);\n    font-size: clamp(16px, 1.5vw, 21px);\n    line-height: 1.35;\n    font-weight: 800;\n  }\n\n  .pred-family__desktop-scroll {\n    width: min(1320px, 100%);\n    height: 420vh;\n    margin: 0 auto;\n    position: relative;\n  }\n\n  .pred-family__sticky {\n    position: sticky;\n    top: 0;\n    min-height: 100vh;\n    display: grid;\n    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);\n    gap: clamp(36px, 6vw, 90px);\n    align-items: center;\n  }\n\n  .pred-family__visual {\n    position: relative;\n    min-height: 620px;\n    display: grid;\n    place-items: center;\n    border-radius: 34px;\n    background:\n      radial-gradient(circle at 50% 45%, rgba(255, 100, 34, 0.22), transparent 34%),\n      linear-gradient(135deg, #050100, #140501 55%, #050100);\n    box-shadow:\n      inset 0 0 0 1px rgba(246, 199, 109, 0.12),\n      0 42px 120px rgba(0, 0, 0, 0.7);\n    overflow: hidden;\n  }\n\n  .pred-family__visual::before {\n    content: \"PREDATOR\";\n    position: absolute;\n    left: 50%;\n    top: 56%;\n    transform: translate(-50%, -50%);\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: clamp(130px, 17vw, 280px);\n    letter-spacing: 9px;\n    color: transparent;\n    -webkit-text-stroke: 1px rgba(246, 199, 109, 0.09);\n    white-space: nowrap;\n  }\n\n  .pred-family__visual::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px);\n    background-size: 54px 54px;\n    mask-image: radial-gradient(circle at center, black 0%, transparent 72%);\n    opacity: 0.44;\n    pointer-events: none;\n  }\n\n  .pred-family__image {\n    position: relative;\n    z-index: 2;\n    width: min(78%, 760px);\n    max-height: 540px;\n    object-fit: contain;\n    filter:\n      drop-shadow(0 0 40px rgba(255, 100, 34, 0.34))\n      drop-shadow(0 48px 110px rgba(0, 0, 0, 0.98));\n    transform: rotate(-5deg) scale(1);\n    transition: opacity 0.28s ease, transform 0.45s ease;\n  }\n\n  .pred-family__visual.is-changing .pred-family__image {\n    opacity: 0;\n    transform: rotate(-13deg) scale(0.9) translateY(16px);\n  }\n\n  .pred-family__meteor {\n    position: absolute;\n    width: 2px;\n    height: 190px;\n    background: linear-gradient(180deg, transparent, #f4b15f, #ff6422, transparent);\n    box-shadow: 0 0 30px rgba(255, 100, 34, 0.72);\n    transform: rotate(42deg);\n    opacity: 0;\n    animation: pred-family-meteor 5s linear infinite;\n    z-index: 1;\n  }\n\n  .pred-family__meteor.one { left: 78%; top: -20%; animation-delay: 0s; }\n  .pred-family__meteor.two { left: 58%; top: -22%; animation-delay: 1.4s; }\n  .pred-family__meteor.three { left: 88%; top: -24%; animation-delay: 2.7s; }\n\n  @keyframes pred-family-meteor {\n    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(42deg); }\n    12% { opacity: 0.85; }\n    44% { opacity: 0; transform: translate3d(-420px, 620px, 0) rotate(42deg); }\n    100% { opacity: 0; }\n  }\n\n  .pred-family__info {\n    position: relative;\n  }\n\n  .pred-family__scroll-hint {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin-bottom: 22px;\n    color: rgba(255, 231, 196, 0.62);\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 2.2px;\n    text-transform: uppercase;\n  }\n\n  .pred-family__scroll-hint::before {\n    content: \"\";\n    width: 36px;\n    height: 1px;\n    background: #f4b15f;\n    box-shadow: 0 0 20px rgba(244, 177, 95, 0.5);\n  }\n\n  .pred-family__selector {\n    display: flex;\n    gap: 10px;\n    margin-bottom: 28px;\n  }\n\n  .pred-family__tab {\n    border: 0;\n    border-radius: 16px;\n    padding: 13px 15px;\n    background: rgba(45, 45, 48, 0.88);\n    color: rgba(255, 255, 255, 0.86);\n    font-size: 12px;\n    font-weight: 950;\n    cursor: pointer;\n    transition: 0.2s ease;\n    text-transform: uppercase;\n  }\n\n  .pred-family__tab.is-active {\n    background: linear-gradient(135deg, #f4b15f, #ff6422);\n    color: #170602;\n    box-shadow: 0 0 30px rgba(255, 100, 34, 0.38);\n    transform: translateY(-3px);\n  }\n\n  .pred-family__name,\n  .pred-family__hook,\n  .pred-family__desc,\n  .pred-family__chips,\n  .pred-family__cta {\n    transition: opacity 0.35s ease, transform 0.35s ease;\n  }\n\n  .pred-family__info.is-changing .pred-family__name,\n  .pred-family__info.is-changing .pred-family__hook,\n  .pred-family__info.is-changing .pred-family__desc,\n  .pred-family__info.is-changing .pred-family__chips,\n  .pred-family__info.is-changing .pred-family__cta {\n    opacity: 0;\n    transform: translateY(14px);\n  }\n\n  .pred-family__name {\n    margin: 0;\n    font-size: clamp(38px, 4vw, 68px);\n    line-height: 0.92;\n    letter-spacing: -2.2px;\n    font-weight: 950;\n    color: #fff;\n  }\n\n  .pred-family__hook {\n    margin: 18px 0 0;\n    max-width: 450px;\n    color: rgba(255, 240, 207, 0.9);\n    font-size: clamp(20px, 2vw, 30px);\n    line-height: 1.08;\n    letter-spacing: -0.8px;\n    font-weight: 900;\n  }\n\n  .pred-family__desc {\n    margin: 18px 0 0;\n    max-width: 460px;\n    color: rgba(255, 231, 196, 0.72);\n    font-size: 16px;\n    line-height: 1.45;\n    font-weight: 800;\n  }\n\n  .pred-family__chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-top: 26px;\n  }\n\n  .pred-family__chip {\n    border-radius: 999px;\n    border: 1px solid rgba(244, 177, 95, 0.3);\n    background: rgba(244, 177, 95, 0.08);\n    color: #f7dcc1;\n    padding: 10px 13px;\n    font-size: 11px;\n    font-weight: 900;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .pred-family__cta {\n    margin-top: 30px;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 16px 24px;\n    border-radius: 999px;\n    background: #fff0cf;\n    color: #160501;\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: 950;\n    letter-spacing: 0.6px;\n    text-transform: uppercase;\n    box-shadow: 0 0 34px rgba(255, 100, 34, 0.28);\n  }\n\n  .pred-family__progress {\n    position: absolute;\n    right: 0;\n    bottom: -42px;\n    left: 0;\n    height: 4px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    overflow: hidden;\n  }\n\n  .pred-family__progress-fill {\n    display: block;\n    width: 0%;\n    height: 100%;\n    border-radius: 999px;\n    background: linear-gradient(90deg, #f4b15f, #ff6422);\n    box-shadow: 0 0 20px rgba(255, 100, 34, 0.6);\n  }\n\n  .pred-family__mobile {\n    display: none;\n  }\n\n  @media (max-width: 900px) {\n    .pred-family {\n      padding: 48px 0 72px;\n    }\n\n    .pred-family__head {\n      width: min(430px, calc(100% - 36px));\n      margin-bottom: 36px;\n    }\n\n    .pred-family__title {\n      font-size: clamp(40px, 12vw, 62px);\n      letter-spacing: -2px;\n    }\n\n    .pred-family__desktop-scroll {\n      display: none;\n    }\n\n    .pred-family__mobile {\n      display: grid;\n      gap: 62px;\n      width: min(430px, 100%);\n      margin: 0 auto;\n      background: #000;\n      padding: 44px 18px 54px;\n    }\n\n    .pred-m-card {\n      text-align: center;\n    }\n\n    .pred-m-card__image-wrap {\n      min-height: 270px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 28px;\n      border-radius: 28px;\n      background:\n        radial-gradient(circle at 50% 48%, rgba(255, 100, 34, 0.20), transparent 42%),\n        #050100;\n      overflow: hidden;\n    }\n\n    .pred-m-card__image {\n      width: 100%;\n      max-height: 270px;\n      object-fit: contain;\n      filter:\n        drop-shadow(0 0 28px rgba(255, 100, 34, 0.34))\n        drop-shadow(0 32px 80px rgba(0, 0, 0, 0.95));\n      transform: rotate(-4deg);\n    }\n\n    .pred-m-card__badge {\n      width: max-content;\n      margin: 0 auto 20px;\n      padding: 14px 16px;\n      border-radius: 16px;\n      background: linear-gradient(135deg, #f4b15f, #ff6422);\n      color: #150501;\n      font-weight: 950;\n      font-size: 12px;\n      text-transform: uppercase;\n      box-shadow: 0 0 30px rgba(255, 100, 34, 0.38);\n    }\n\n    .pred-m-card__name {\n      margin: 0 auto;\n      max-width: 330px;\n      color: #fff;\n      font-size: clamp(28px, 8vw, 38px);\n      line-height: 0.98;\n      letter-spacing: -1.2px;\n      font-weight: 950;\n    }\n\n    .pred-m-card__hook {\n      margin: 16px auto 0;\n      max-width: 340px;\n      color: rgba(255, 240, 207, 0.9);\n      font-size: 20px;\n      line-height: 1.12;\n      font-weight: 900;\n      letter-spacing: -0.5px;\n    }\n\n    .pred-m-card__desc {\n      margin: 14px auto 0;\n      max-width: 340px;\n      color: rgba(255, 231, 196, 0.72);\n      font-size: 15px;\n      line-height: 1.4;\n      font-weight: 800;\n    }\n\n    .pred-m-card__meta {\n      margin-top: 18px;\n      color: #f4b15f;\n      font-size: 14px;\n      font-weight: 900;\n    }\n\n    .pred-m-card__chips {\n      justify-content: center;\n      margin-top: 20px;\n    }\n\n    .pred-m-card__cta {\n      margin-top: 24px;\n    }\n  }\n</style>\n\n<section class=\"pred-family\" id=\"pred-family-{{ section.id }}\" aria-label=\"Predator racket range\">\n  <div class=\"pred-family__head\">\n    <p class=\"pred-family__eyebrow\">Predator Range</p>\n    <h2 class=\"pred-family__title\">Three ways to <span>attack.</span></h2>\n    <p class=\"pred-family__sub\">\n      Scroll through the range. Pick the Predator that matches your game.\n    </p>\n  </div>\n\n  <div class=\"pred-family__desktop-scroll\">\n    <div class=\"pred-family__sticky\">\n      <div class=\"pred-family__visual\">\n        <span class=\"pred-family__meteor one\"></span>\n        <span class=\"pred-family__meteor two\"></span>\n        <span class=\"pred-family__meteor three\"></span>\n\n        <img class=\"pred-family__image\" src=\"IMAGE_URL_79\" alt=\"Predator racket\">\n      </div>\n\n      <div class=\"pred-family__info\">\n        <div class=\"pred-family__scroll-hint\">Scroll to compare</div>\n\n        <div class=\"pred-family__selector\" aria-label=\"Predator range selector\">\n          <button class=\"pred-family__tab is-active\" type=\"button\" data-index=\"0\">79</button>\n          <button class=\"pred-family__tab\" type=\"button\" data-index=\"1\">82</button>\n          <button class=\"pred-family__tab\" type=\"button\" data-index=\"2\">82 Extreme</button>\n        </div>\n\n        <h3 class=\"pred-family__name\">Predator 79 Extra Strong</h3>\n        <p class=\"pred-family__hook\">Light in hand. Hungry on court.</p>\n        <p class=\"pred-family__desc\">\n          For intermediate attackers who want speed first, without losing the head-heavy bite.\n        </p>\n\n        <div class=\"pred-family__chips\">\n          <span class=\"pred-family__chip\">79g</span>\n          <span class=\"pred-family__chip\">Head Heavy</span>\n          <span class=\"pred-family__chip\">32 lbs</span>\n          <span class=\"pred-family__chip\">Intermediate</span>\n        </div>\n\n        <a class=\"pred-family__cta\" href=\"/products/predator-79-extra-strong\">Choose Predator 79 +</a>\n\n        <div class=\"pred-family__progress\" aria-hidden=\"true\">\n          <span class=\"pred-family__progress-fill\"></span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pred-family__mobile\">\n    <article class=\"pred-m-card\">\n      <div class=\"pred-m-card__image-wrap\">\n        <img class=\"pred-m-card__image\" src=\"IMAGE_URL_79\" alt=\"Predator 79 Extra Strong\">\n      </div>\n      <div class=\"pred-m-card__badge\">Fastest Strike</div>\n      <h3 class=\"pred-m-card__name\">Predator 79 Extra Strong</h3>\n      <p class=\"pred-m-card__hook\">Light in hand. Hungry on court.</p>\n      <p class=\"pred-m-card__desc\">For intermediate attackers who want speed first, without losing the head-heavy bite.</p>\n      <div class=\"pred-m-card__meta\">79g · Head Heavy · 32 lbs</div>\n      <div class=\"pred-family__chips pred-m-card__chips\">\n        <span class=\"pred-family__chip\">Intermediate</span>\n        <span class=\"pred-family__chip\">Attacking</span>\n        <span class=\"pred-family__chip\">G6 Grip</span>\n      </div>\n      <a class=\"pred-family__cta pred-m-card__cta\" href=\"/products/predator-79-extra-strong\">Choose Predator 79 +</a>\n    </article>\n\n    <article class=\"pred-m-card\">\n      <div class=\"pred-m-card__image-wrap\">\n        <img class=\"pred-m-card__image\" src=\"IMAGE_URL_82\" alt=\"Predator 82 Extra Strong\">\n      </div>\n      <div class=\"pred-m-card__badge\">Harder Hit</div>\n      <h3 class=\"pred-m-card__name\">Predator 82 Extra Strong</h3>\n      <p class=\"pred-m-card__hook\">More weight. More bite.</p>\n      <p class=\"pred-m-card__desc\">For players who want the same fast attacking build with a heavier, stronger hit.</p>\n      <div class=\"pred-m-card__meta\">82g · Head Heavy · 32 lbs</div>\n      <div class=\"pred-family__chips pred-m-card__chips\">\n        <span class=\"pred-family__chip\">Intermediate</span>\n        <span class=\"pred-family__chip\">Curve²</span>\n        <span class=\"pred-family__chip\">Japan Graphite</span>\n      </div>\n      <a class=\"pred-family__cta pred-m-card__cta\" href=\"/products/predator-82-extra-strong\">Choose Predator 82 +</a>\n    </article>\n\n    <article class=\"pred-m-card\">\n      <div class=\"pred-m-card__image-wrap\">\n        <img class=\"pred-m-card__image\" src=\"IMAGE_URL_82_EXTREME\" alt=\"Predator 82 Extreme\">\n      </div>\n      <div class=\"pred-m-card__badge\">Extreme Finish</div>\n      <h3 class=\"pred-m-card__name\">Predator 82 Extreme</h3>\n      <p class=\"pred-m-card__hook\">Pressure in. Punishment out.</p>\n      <p class=\"pred-m-card__desc\">For advanced attackers who want the most serious Predator build in the range.</p>\n      <div class=\"pred-m-card__meta\">82g 4U · 310mm BP · Advanced</div>\n      <div class=\"pred-family__chips pred-m-card__chips\">\n        <span class=\"pred-family__chip\">Head Heavy</span>\n        <span class=\"pred-family__chip\">Flexible 7.0</span>\n        <span class=\"pred-family__chip\">Graphite Lab</span>\n      </div>\n      <a class=\"pred-family__cta pred-m-card__cta\" href=\"/products/predator-82-extreme\">Choose Extreme +</a>\n    </article>\n  </div>\n</section>\n\n<script>\n  (() => {\n    const root = document.querySelector('#pred-family-{{ section.id }}');\n    if (!root) return;\n\n    const scrollWrap = root.querySelector('.pred-family__desktop-scroll');\n    const visual = root.querySelector('.pred-family__visual');\n    const info = root.querySelector('.pred-family__info');\n    const image = root.querySelector('.pred-family__image');\n    const tabs = [...root.querySelectorAll('.pred-family__tab')];\n    const name = root.querySelector('.pred-family__name');\n    const hook = root.querySelector('.pred-family__hook');\n    const desc = root.querySelector('.pred-family__desc');\n    const chips = root.querySelector('.pred-family__info .pred-family__chips');\n    const cta = root.querySelector('.pred-family__info .pred-family__cta');\n    const progress = root.querySelector('.pred-family__progress-fill');\n\n    let activeProduct = 0;\n    let activePhase = 0;\n\n    const products = [\n      {\n        image: 'IMAGE_URL_79',\n        name: 'Predator 79 Extra Strong',\n        hook: 'Light in hand. Hungry on court.',\n        desc: 'For intermediate attackers who want speed first, without losing the head-heavy bite.',\n        chips: ['79g', 'Head Heavy', '32 lbs', 'Intermediate'],\n        link: '/products/predator-79-extra-strong',\n        cta: 'Choose Predator 79 +'\n      },\n      {\n        image: 'IMAGE_URL_82',\n        name: 'Predator 82 Extra Strong',\n        hook: 'More weight. More bite.',\n        desc: 'For players who want the same fast attacking build with a heavier, stronger hit.',\n        chips: ['82g', 'Head Heavy', '32 lbs', 'Intermediate'],\n        link: '/products/predator-82-extra-strong',\n        cta: 'Choose Predator 82 +'\n      },\n      {\n        image: 'IMAGE_URL_82_EXTREME',\n        name: 'Predator 82 Extreme',\n        hook: 'Pressure in. Punishment out.',\n        desc: 'For advanced attackers who want the most serious Predator build in the range.',\n        chips: ['82g 4U', '310mm BP', 'Advanced', 'Graphite Lab'],\n        link: '/products/predator-82-extreme',\n        cta: 'Choose Extreme +'\n      }\n    ];\n\n    const renderChips = (items) => {\n      chips.innerHTML = items.map((chip) => `<span class=\"pred-family__chip\">${chip}</span>`).join('');\n    };\n\n    const setProduct = (index) => {\n      if (index === activeProduct) return;\n\n      activeProduct = index;\n      const product = products[index];\n\n      tabs.forEach((tab, i) => tab.classList.toggle('is-active', i === index));\n      visual.classList.add('is-changing');\n      info.classList.add('is-changing');\n\n      setTimeout(() => {\n        image.src = product.image;\n        name.textContent = product.name;\n        hook.textContent = product.hook;\n        desc.textContent = product.desc;\n        renderChips(product.chips);\n        cta.href = product.link;\n        cta.textContent = product.cta;\n        visual.classList.remove('is-changing');\n        info.classList.remove('is-changing');\n      }, 180);\n    };\n\n    const setPhase = (phase) => {\n      if (phase === activePhase) return;\n      activePhase = phase;\n\n      hook.style.opacity = phase >= 0 ? '1' : '0';\n      desc.style.opacity = phase >= 1 ? '1' : '0';\n      chips.style.opacity = phase >= 1 ? '1' : '0';\n      cta.style.opacity = phase >= 2 ? '1' : '0';\n\n      hook.style.transform = phase >= 0 ? 'translateY(0)' : 'translateY(14px)';\n      desc.style.transform = phase >= 1 ? 'translateY(0)' : 'translateY(14px)';\n      chips.style.transform = phase >= 1 ? 'translateY(0)' : 'translateY(14px)';\n      cta.style.transform = phase >= 2 ? 'translateY(0)' : 'translateY(14px)';\n    };\n\n    const updateByScroll = () => {\n      if (window.matchMedia('(max-width: 900px)').matches) return;\n\n      const rect = scrollWrap.getBoundingClientRect();\n      const maxScroll = scrollWrap.offsetHeight - window.innerHeight;\n      const raw = Math.min(Math.max(-rect.top, 0), maxScroll);\n      const progressValue = maxScroll > 0 ? raw / maxScroll : 0;\n\n      const totalSegments = products.length * 3;\n      const step = Math.min(totalSegments - 1, Math.floor(progressValue * totalSegments));\n      const productIndex = Math.min(products.length - 1, Math.floor(step / 3));\n      const phaseIndex = step % 3;\n\n      setProduct(productIndex);\n      setPhase(phaseIndex);\n\n      if (progress) {\n        progress.style.width = `${Math.min(progressValue * 100, 100)}%`;\n      }\n    };\n\n    tabs.forEach((tab) => {\n      tab.addEventListener('click', () => {\n        const index = Number(tab.dataset.index);\n        const maxScroll = scrollWrap.offsetHeight - window.innerHeight;\n        const targetProgress = (index * 3) / (products.length * 3);\n        const targetTop = scrollWrap.offsetTop + maxScroll * targetProgress + 8;\n\n        window.scrollTo({\n          top: targetTop,\n          behavior: 'smooth'\n        });\n      });\n    });\n\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) {\n          root.classList.add('is-inview');\n        }\n      });\n    }, { threshold: 0.22 });\n\n    observer.observe(root);\n\n    window.addEventListener('scroll', updateByScroll, { passive: true });\n    window.addEventListener('resize', updateByScroll);\n    setPhase(0);\n    updateByScroll();\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_6ErPVe": {
      "type": "custom-liquid",
      "disabled": true,
