n        }, sharedStart);\n\n        syncedAnimation(recoil, [\n          { transform: 'translate3d(0,0,0) rotate(0deg)' },\n          { transform: 'translate3d(' + (4 + level * 2) + 'px,' + (-2 - level) + 'px,0) rotate(' + (1 + level * .45) + 'deg)' },\n          { transform: 'translate3d(0,0,0) rotate(0deg)' }\n        ], {\n          duration: [145, 175, 205][level],\n          easing: 'cubic-bezier(.2,.7,.2,1)',\n          fill: 'none'\n        }, sharedStart);\n\n        resetShuttle();\n        currentShuttleAnimation = syncedAnimation(shuttle, [\n          { opacity: .88, transform: 'translate(-50%, -50%) rotate(-18deg) scale(.86)' },\n          { opacity: .75, offset: .2, transform: 'translate(calc(-50% + ' + (shuttleX * .22).toFixed(1) + 'px), calc(-50% + ' + (shuttleY * .18).toFixed(1) + 'px)) rotate(' + (105 + level * 35) + 'deg) scale(.8)' },\n          { opacity: 0, transform: 'translate(calc(-50% + ' + shuttleX.toFixed(1) + 'px), calc(-50% + ' + shuttleY.toFixed(1) + 'px)) rotate(' + (430 + level * 90) + 'deg) scale(.46)' }\n        ], {\n          duration: [330, 405, 480][level],\n          easing: 'cubic-bezier(.08,.7,.14,1)',\n          fill: 'forwards'\n        }, sharedStart);\n\n        animateParticles(level, sharedStart);\n        setForceText(['Controlled impact', 'Heavy impact', 'Full smash'][level]);\n      }\n\n      function getVelocityLevel(value) {\n        var adjusted = value * (mobileQuery.matches ? .56 : 1);\n        if (adjusted < 9) return 0;\n        if (adjusted < 27) return 1;\n        return 2;\n      }\n\n      function updateFrame(now) {\n        if (!active) return;\n\n        var deltaTime = clamp(now - lastTime, 8, 42);\n        var scrollPosition = window.scrollY;\n        var deltaScroll = scrollPosition - lastScroll;\n        var frameVelocity = Math.max(0, deltaScroll) * (16.667 / deltaTime);\n        var alpha = 1 - Math.exp(-deltaTime / 100);\n        velocity += (frameVelocity - velocity) * alpha;\n\n        var progress = clamp((scrollPosition - sectionTop) / runway, 0, 1);\n        var swing = clamp(progress / impactThreshold, 0, 1);\n        var after = clamp((progress - .78) / .12, 0, 1);\n        var width = viewport.clientWidth;\n        var height = viewport.clientHeight;\n        var mobile = mobileQuery.matches;\n        var idle = Math.sin(now / 650) * (mobile ? 1.7 : 2.7) * (1 - swing);\n        var curve = Math.sin(Math.PI * swing);\n        var x = lerp(mobile ? 6 : -4, mobile ? -8 : 4, swing) * width / 100 + curve * width * (mobile ? .009 : .018);\n        var y = lerp(mobile ? 3 : 4, mobile ? -10 : -4, swing) * height / 100 - curve * height * (mobile ? .014 : .02) + idle;\n        var angle = lerp(mobile ? -11 : -14, mobile ? 25 : 40, swing);\n        var scale = 1 + Math.sin(Math.PI * swing) * .012;\n\n        racketAnchor.style.transform = 'translate3d(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px,0)';\n        racket.style.transform = 'translate3d(-50%,-50%,0) rotate(' + angle.toFixed(2) + 'deg) scale(' + scale.toFixed(4) + ')';\n        trajectory.style.strokeDashoffset = String(1 - swing);\n        root.style.setProperty('--b80-build', swing.toFixed(4));\n        root.style.setProperty('--b80-after', after.toFixed(4));\n\n        if (!initializedPosition) {\n          initializedPosition = true;\n          lastProgress = progress;\n          if (progress >= impactThreshold) {\n            readyToImpact = false;\n            buildCracks(1, 0, true);\n            shuttle.style.opacity = '0';\n          }\n        } else {\n          if (readyToImpact && lastProgress < impactThreshold && progress >= impactThreshold && deltaScroll >= 0) {\n            readyToImpact = false;\n            triggerImpact(getVelocityLevel(velocity));\n          }\n\n          if (!readyToImpact && progress < resetThreshold) {\n            readyToImpact = true;\n            resetShuttle();\n          }\n        }\n\n        if (progress < impactThreshold) {\n          setForceText(['Controlled force', 'Heavy force', 'Aggressive force'][getVelocityLevel(velocity)]);\n        }\n\n        lastProgress = progress;\n        lastScroll = scrollPosition;\n        lastTime = now;\n        rafId = window.requestAnimationFrame(updateFrame);\n      }\n\n      function startLoop() {\n        if (active || reducedMotion) return;\n        active = true;\n        lastTime = performance.now();\n        lastScroll = window.scrollY;\n        rafId = window.requestAnimationFrame(updateFrame);\n      }\n\n      function stopLoop() {\n        active = false;\n        if (rafId) window.cancelAnimationFrame(rafId);\n        rafId = 0;\n      }\n\n      layout();\n\n      if (reducedMotion) {\n        var width = viewport.clientWidth;\n        var height = viewport.clientHeight;\n        racketAnchor.style.transform = 'translate3d(' + (width * .04).toFixed(1) + 'px,' + (-height * .04).toFixed(1) + 'px,0)';\n        racket.style.transform = 'translate3d(-50%,-50%,0) rotate(40deg) scale(1)';\n        buildCracks(1, 0, true);\n        shuttle.style.opacity = '0';\n      }\n\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) startLoop();\n          else stopLoop();\n        });\n      }, { rootMargin: '20% 0px 20% 0px', threshold: 0 });\n\n      observer.observe(root);\n\n      function onResize() {\n        window.clearTimeout(resizeTimer);\n        resizeTimer = window.setTimeout(function () {\n          layout();\n        }, 90);\n      }\n\n      window.addEventListener('resize', onResize, { passive: true });\n\n      root._b80Destroy = function () {\n        stopLoop();\n        observer.disconnect();\n        window.removeEventListener('resize', onResize);\n        window.clearTimeout(resizeTimer);\n        window.clearTimeout(quietTimer);\n        if (audioContext && typeof audioContext.close === 'function') {\n          audioContext.close().catch(function () {});\n        }\n      };\n    }\n\n    function initAll(scope) {\n      var roots = (scope || document).querySelectorAll(ROOT_SELECTOR);\n      Array.prototype.forEach.call(roots, initImpactHero);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', function () { initAll(document); });\n    } else {\n      initAll(document);\n    }\n\n    document.addEventListener('shopify:section:load', function (event) {\n      initAll(event.target);\n    });\n\n    document.addEventListener('shopify:section:unload', function (event) {\n      var roots = event.target.querySelectorAll(ROOT_SELECTOR);\n      Array.prototype.forEach.call(roots, function (root) {\n        if (root._b80Destroy) root._b80Destroy();\n      });\n    });\n  })();\n</script>\n\n</div>\n<section class=\"preview-next\"><div>Impact registered.<small>Next section begins here</small></div></section>\n</body>\n</html>",
