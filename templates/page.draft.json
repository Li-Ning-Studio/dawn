      border-radius: 16px;\n    }\n\n    .hn-predator-find__hero {\n      aspect-ratio: auto;\n    }\n\n    .hn-predator-find__cards-wrap {\n      width: 100%;\n      overflow: visible;\n      touch-action: auto;\n    }\n\n    .hn-predator-find__cards {\n      display: flex;\n      flex-direction: row;\n      gap: 12px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      padding: 0 58px 4px 0;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      touch-action: auto;\n      overscroll-behavior-x: contain;\n      overscroll-behavior-y: auto;\n    }\n\n    .hn-predator-find__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-predator-find__card {\n      flex: 0 0 calc(100vw - 104px);\n      width: calc(100vw - 104px);\n      max-width: 360px;\n      display: flex;\n      flex-direction: column;\n      min-height: unset;\n      border-radius: 14px;\n      scroll-snap-align: start;\n    }\n\n    .hn-predator-find__card-media {\n      height: 315px;\n      flex: 0 0 315px;\n    }\n\n    .hn-predator-find__card-content {\n      padding: 18px 18px 20px;\n    }\n\n    .hn-predator-find__card-title {\n      font-size: 19px;\n      line-height: 1.12;\n    }\n\n    .hn-predator-find__card-rule {\n      margin: 14px 0 14px;\n    }\n\n    .hn-predator-find__card-copy {\n      font-size: 14px;\n      line-height: 1.35;\n    }\n\n    .hn-predator-find__dots {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      margin-top: 10px;\n    }\n\n    .hn-predator-find__dot {\n      width: 10px;\n      height: 10px;\n      padding: 0;\n      border: 0;\n      border-radius: 999px;\n      background: #d8d8d8;\n      cursor: pointer;\n      transition: background-color 0.2s ease, transform 0.2s ease;\n    }\n\n    .hn-predator-find__dot.is-active {\n      background: #8c5b33;\n      transform: scale(1.05)