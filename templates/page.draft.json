er-spacing: -0.06em !important;\n  text-align: center !important;\n\n  background-image: linear-gradient(\n    to right,\n    #008a36 0%,\n    #008a36 34%,\n    #3f8724 44%,\n    #8c7214 52%,\n    #d85f07 62%,\n    #ff5c00 72%,\n    #ff5c00 100%\n  ) !important;\n\n  background-size: 100% 100% !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  color: transparent !important;\n  -webkit-text-fill-color: transparent !important;\n}\n\n.hn-predator-find__dots {\n  background: transparent !important;\n}\n\n.hn-predator-find__dot {\n  background: #2d2d2d !important;\n}\n\n.hn-predator-find__dot.is-active {\n  background: #ffffff !important;\n}\n\n@media screen and (max-width: 900px) {\n  .hn-predator-find {\n    background: #000000 !important;\n    background-color: #000000 !important;\n    padding-top: 38px !important;\n  }\n\n  .hn-predator-find__heading-wrap {\n    margin-bottom: 30px !important;\n  }\n\n  .hn-predator-find__eyebrow {\n    font-size: 15px !important;\n    margin-bottom: 16px !important;\n    line-height: 1.15 !important;\n  }\n\n  .hn-predator-find__heading {\n    font-size: clamp(36px, 11vw, 58px) !important;\n    line-height: 1 !important;\n    letter-spacing: -0.055em !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-find {\n    padding-top: 34px !important;\n  }\n\n  .hn-predator-find__eyebrow {\n    font-size: 14px !important;\n    margin-bottom: 14px !important;\n  }\n\n  .hn-predator-find__heading {\n    font-size: clamp(34px, 10.5vw, 48px) !important;\n  }\n}\n/* REDUCE FIND YOUR PREDATOR HEADING SIZE */\n.hn-predator-find__heading {\n  font-size: clamp(34px, 4.2vw, 66px) !important;\n  line-height: 0.98 !important;\n  letter-spacing: -0.055em !important;\n}\n\n.hn-predator-find__heading-wrap {\n  margin-bottom: 34px !important;\n}\n\n@media screen and (max-width: 900px) {\n  .hn-predator-find__heading {\n    font-size: clamp(30px, 8.8vw, 44px) !important;\n    line-height: 1.02 !important;\n    letter-spacing: -0.052em !important;\n  }\n\n  .hn-predator-find__heading-wrap {\n    margin-bottom: 26px !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-find__heading {\n    font-size: clamp(29px, 8.2vw, 38px) !important;\n  }\n}\n</style>\n\n<script>\n  (function() {\n    function initPredatorFindCarousel(root) {\n      if (!root || root.dataset.carouselReady === 'true') return;\n\n      var track = root.querySelector('[data-hn-predator-carousel]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-find__card'));\n      var dots = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-find__dot'));\n\n      if (!track || !cards.length || !dots.length) return;\n\n      root.dataset.carouselReady = 'true';\n\n      var rafId = null;\n\n      function setActiveDot(index) {\n        dots.forEach(function(dot, i) {\n          dot.classList.toggle('is-active', i === index);\n        });\n      }\n\n      function getActiveIndex() {\n        var scrollLeft = track.scrollLeft;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.offsetLeft - scrollLeft);\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function updateDots() {\n        if (rafId) return;\n\n        rafId = window.requestAnimationFrame(function() {\n          setActiveDot(getActiveIndex());\n          rafId = null;\n        });\n      }\n\n      function scrollToCard(index) {\n        if (!cards[index]) return;\n\n        track.scrollTo({\n          left: cards[index].offsetLeft,\n          behavior: 'smooth'\n        });\n\n        setActiveDot(index);\n      }\n\n      track.addEventListener('scroll', updateDots, { passive: true });\n\n      dots.forEach(function(dot) {\n        dot.addEventListener('click', function() {\n          var index = Number(dot.getAttribute('data-index'));\n          if (Number.isNaN(index)) return;\n          scrollToCard(index);\n        });\n      });\n\n      window.addEventListener('resize', updateDots, { passive: true });\n\n      setActiveDot(0);\n    }\n\n    function initAllPredatorFindCarousels() {\n      document.querySelectorAll('[data-hn-predator-find]').forEach(initPredatorFindCarousel);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllPredatorFindCarousels);\n    } else {\n      initAllPredatorFindCarousels();\n    }\n\n    document.addEventListener('shopify:section:load', initAllPredatorFindCarousels);\n  })();\n</script>",
