    "custom_liquid_zmMzbC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .pc2-root *, .pc2-root *::before, .pc2-root *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  .pc2-root {\n    background: #000;\n    width: 100%;\n    overflow: hidden;\n    font-family: 'Inter', sans-serif;\n    padding: 100px 0 92px;\n    opacity: 0;\n    transform: translateY(28px);\n    transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1);\n    position: relative;\n  }\n  .pc2-root.pc2-in { opacity: 1; transform: translateY(0); }\n\n  .pc2-root::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 55% 45% at 18% 50%, rgba(34,197,94,0.06) 0%, transparent 65%),\n      radial-gradient(ellipse 55% 45% at 82% 50%, rgba(34,197,94,0.04) 0%, transparent 65%);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  /* label */\n  .pc2-label {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 5px;\n    text-transform: uppercase;\n    color: rgba(74,222,128,0.5);\n    margin-bottom: 56px;\n    position: relative;\n    z-index: 1;\n  }\n  .pc2-label::before, .pc2-label::after {\n    content: '';\n    width: 28px; height: 1px;\n    background: rgba(74,222,128,0.25);\n    display: block;\n  }\n\n  /* outer */\n  .pc2-outer {\n    position: relative;\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 0 72px;\n    z-index: 1;\n  }\n\n  .pc2-clip {\n    overflow: hidden;\n    border-radius: 16px;\n  }\n\n  .pc2-track {\n    display: flex;\n    transition: transform 0.62s cubic-bezier(0.77,0,0.175,1);\n    will-change: transform;\n  }\n\n  /* glass card */\n  .pc2-card {\n    min-width: 100%;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    background: rgba(255,255,255,0.03);\n    backdrop-filter: blur(24px) saturate(160%);\n    -webkit-backdrop-filter: blur(24px) saturate(160%);\n    border: 1px solid rgba(255,255,255,0.07);\n    border-radius: 16px;\n    overflow: hidden;\n    min-height: 520px;\n    position: relative;\n  }\n  .pc2-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1) 25%, rgba(74,222,128,0.2) 50%, rgba(255,255,255,0.1) 75%, transparent);\n    z-index: 3;\n  }\n\n  /* image pane */\n  .pc2-img {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    padding: 60px 44px;\n    background: rgba(0,0,0,0.25);\n  }\n  .pc2-img::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(ellipse 70% 60% at 50% 55%, rgba(34,197,94,0.12) 0%, transparent 65%);\n    pointer-events: none;\n  }\n  .pc2-img img {\n    width: 100%;\n    max-width: 260px;\n    height: auto;\n    object-fit: contain;\n    position: relative;\n    z-index: 1;\n    transition: transform 0.7s cubic-bezier(0.22,1,0.36,1), filter 0.5s ease;\n    display: block;\n    filter: drop-shadow(0 8px 32px rgba(34,197,94,0.15));\n  }\n  .pc2-card.pc2-active .pc2-img img {\n    transform: scale(1.06) translateY(-4px);\n    filter: drop-shadow(0 16px 48px rgba(34,197,94,0.28));\n  }\n  .pc2-badge {\n    position: absolute;\n    top: 22px; left: 22px;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 11px;\n    letter-spacing: 3px;\n    color: rgba(74,222,128,0.3);\n    z-index: 2;\n  }\n\n  /* divider */\n  .pc2-divider {\n    width: 1px;\n    flex-shrink: 0;\n    background: linear-gradient(180deg, transparent 0%, rgba(74,222,128,0.14) 25%, rgba(74,222,128,0.14) 75%, transparent 100%);\n  }\n\n  /* content */\n  .pc2-content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 64px 56px;\n    background: rgba(0,0,0,0.15);\n    position: relative;\n  }\n  .pc2-content::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    width: 180px; height: 180px;\n    background: radial-gradient(ellipse at top right, rgba(74,222,128,0.05) 0%, transparent 65%);\n    pointer-events: none;\n  }\n\n  .pc2-num {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 11px;\n    letter-spacing: 4px;\n    color: rgba(74,222,128,0.32);\n    margin-bottom: 18px;\n    display: block;\n  }\n  .pc2-headline {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: clamp(38px, 3.8vw, 56px);\n    line-height: 0.96;\n    letter-spacing: 0.5px;\n    color: #fff;\n    margin-bottom: 22px;\n  }\n  .pc2-headline em {\n    font-style: normal;\n    color: #4ade80;\n    display: block;\n  }\n  .pc2-body {\n    font-size: 15px;\n    font-weight: 400;\n    color: rgba(180,180,180,0.8);\n    line-height: 1.8;\n    max-width: 290px;\n    margin-bottom: 36px;\n  }\n  .pc2-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: rgba(74,222,128,0.8);\n    padding: 9px 18px;\n    background: rgba(74,222,128,0.06);\n    border: 1px solid rgba(74,222,128,0.15);\n    border-radius: 100px;\n    width: fit-content;\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n  }\n  .pc2-tag::before {\n    content: '';\n    width: 5px; height: 5px;\n    border-radius: 50%;\n    background: #4ade80;\n    box-shadow: 0 0 6px rgba(74,222,128,0.6);\n    flex-shrink: 0;\n  }\n\n  /* arrows */\n  .pc2-arrow {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 46px; height: 46px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.1);\n    background: rgba(255,255,255,0.05);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    color: rgba(255,255,255,0.7);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    z-index: 10;\n    transition: border-color 0.25s, background 0.25s, color 0.25s, transform 0.2s;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .pc2-arrow:hover {\n    border-color: rgba(74,222,128,0.4);\n    background: rgba(74,222,128,0.1);\n    color: #4ade80;\n    transform: translateY(-50%) scale(1.1);\n  }\n  .pc2-arrow:active { transform: translateY(-50%) scale(0.94); }\n  .pc2-arrow[disabled] { opacity: 0.18; pointer-events: none; }\n  .pc2-arrow svg { width: 16px; height: 16px; pointer-events: none; }\n  .pc2-arrow--prev { left: 10px; }\n  .pc2-arrow--next { right: 10px; }\n\n  /* ── PROGRESS BARS ── */\n  .pc2-dots {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 44px;\n    position: relative;\n    z-index: 1;\n  }\n\n  .pc2-dot {\n    position: relative;\n    width: 64px;\n    height: 3px;\n    border-radius: 100px;\n    background: rgba(255,255,255,0.1);\n    border: none;\n    cursor: pointer;\n    padding: 0;\n    overflow: hidden;\n    -webkit-tap-highlight-color: transparent;\n    flex-shrink: 0;\n  }\n\n  /* the animated fill — JS drives width via requestAnimationFrame */\n  .pc2-dot__fill {\n    position: absolute;\n    top: 0; left: 0;\n    height: 100%;\n    width: 0%;\n    border-radius: 100px;\n    background: linear-gradient(90deg, #22c55e, #4ade80);\n    box-shadow: 0 0 8px rgba(74,222,128,0.55);\n    will-change: width;\n    pointer-events: none;\n  }\n\n  /* mobile */\n  @media (max-width: 768px) {\n    .pc2-root { padding: 72px 0 64px; }\n    .pc2-outer { padding: 0 16px; }\n    .pc2-card { grid-template-columns: 1fr; min-height: unset; }\n    .pc2-img { padding: 48px 40px; min-height: 260px; }\n    .pc2-img img { max-width: 200px; }\n    .pc2-divider {\n      width: 100%; height: 1px;\n      background: linear-gradient(90deg, transparent 5%, rgba(74,222,128,0.12) 50%, transparent 95%);\n    }\n    .pc2-content { padding: 44px 32px 52px; }\n    .pc2-body { max-width: 100%; font-size: 14px; }\n    .pc2-arrow { display: none; }\n    .pc2-dot { width: 44px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pc2-root { opacity:1!important; transform:none!important; transition:none!important; }\n    .pc2-track { transition:none!important; }\n    .pc2-img img { transition:none!important; }\n  }\n</style>\n\n<section class=\"pc2-root\" aria-label=\"Predator Identity Carousel\">\n\n  <p class=\"pc2-label\">What You Play For</p>\n\n  <div class=\"pc2-outer\">\n    <button class=\"pc2-arrow pc2-arrow--prev\" aria-label=\"Previous\" disabled>\n      <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M10 3L5 8l5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n    <div class=\"pc2-clip\">\n      <div class=\"pc2-track\">\n\n        <div class=\"pc2-card pc2-active\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">01 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-black.png\" alt=\"Predator 82 Black\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">01</span>\n            <h2 class=\"pc2-headline\">The Smash That <em>Ends the Point.</em></h2>\n            <p class=\"pc2-body\">Not a shot. A statement. One swing and the rally is over before they even move.</p>\n            <span class=\"pc2-tag\">Pure Aggression</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">02 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-red.png\" alt=\"Predator 82 Red\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">02</span>\n            <h2 class=\"pc2-headline\">Your Arm Wants <em>to Swing.</em></h2>\n            <p class=\"pc2-body\">We made sure it can. Every frame angle engineered so your speed never lies — less drag, more devastation.</p>\n            <span class=\"pc2-tag\">Fast Strike</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">03 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-82-blue.png\" alt=\"Predator 82 Blue\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">03</span>\n            <h2 class=\"pc2-headline\">Built for the Player <em>Who Goes First.</em></h2>\n            <p class=\"pc2-body\">Always. No hesitation. No waiting. You step in — the Predator holds up every single time.</p>\n            <span class=\"pc2-tag\">Point Finisher</span>\n          </div>\n        </div>\n\n        <div class=\"pc2-card\">\n          <div class=\"pc2-img\">\n            <span class=\"pc2-badge\">04 / 04</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0674/2428/7297/files/predator-84.png\" alt=\"Predator 84\" loading=\"lazy\" onerror=\"this.style.opacity='0'\">\n          </div>\n          <div class=\"pc2-divider\"></div>\n          <div class=\"pc2-content\">\n            <span class=\"pc2-num\">04</span>\n            <h2 class=\"pc2-headline\">Every Gram <em>Is Accountable.</em></h2>\n            <p class=\"pc2-body\">Nothing wasted. Nothing soft. Built light so you swing twice before they recover once.</p>\n            <span class=\"pc2-tag\">Clean Power</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <button class=\"pc2-arrow pc2-arrow--next\" aria-label=\"Next\">\n      <svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M6 3l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"pc2-dots\" role=\"tablist\">\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 1\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 2\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 3\"><span class=\"pc2-dot__fill\"></span></button>\n    <button class=\"pc2-dot\" role=\"tab\" aria-label=\"Slide 4\"><span class=\"pc2-dot__fill\"></span></button>\n  </div>\n\n</section>\n\n<script>\n(function () {\n  var DURATION = 4500; // ms per slide\n\n  var root  = document.querySelector('.pc2-root');\n  var track = document.querySelector('.pc2-track');\n  var cards = document.querySelectorAll('.pc2-card');\n  var dots  = document.querySelectorAll('.pc2-dot');\n  var btnP  = document.querySelector('.pc2-arrow--prev');\n  var btnN  = document.querySelector('.pc2-arrow--next');\n  if (!root || !track) return;\n\n  var total   = cards.length;\n  var cur     = 0;\n  var paused  = false;\n\n  // rAF-based timer state\n  var rafId       = null;\n  var startTs     = null;   // when current slide timer started\n  var elapsed     = 0;      // ms already consumed before a pause\n\n  /* ── get fill el for dot i ── */\n  function fill(i) { return dots[i].querySelector('.pc2-dot__fill'); }\n\n  /* ── set fill width instantly ── */\n  function setFill(i, pct) {\n    fill(i).style.width = pct + '%';\n  }\n\n  /* ── cancel rAF loop ── */\n  function cancelLoop() {\n    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }\n  }\n\n  /* ── rAF loop: animates active dot fill in real time ── */\n  function startLoop(fromElapsed) {\n    elapsed  = fromElapsed || 0;\n    startTs  = null;\n\n    function tick(ts) {\n      if (!startTs) startTs = ts;\n      var delta = ts - startTs + elapsed;\n\n      // update fill\n      var pct = Math.min(delta / DURATION * 100, 100);\n      setFill(cur, pct);\n\n      if (delta >= DURATION) {\n        // auto-advance\n        advance();\n        return;\n      }\n      rafId = requestAnimationFrame(tick);\n    }\n    rafId = requestAnimationFrame(tick);\n  }\n\n  /* ── advance to next slide ── */\n  function advance() {\n    cancelLoop();\n    var next_i = cur < total - 1 ? cur + 1 : 0;\n    goTo(next_i);\n  }\n\n  /* ── go to slide ── */\n  function goTo(i) {\n    cancelLoop();\n\n    // outgoing card\n    cards[cur].classList.remove('pc2-active');\n\n    // fill all before i as 100%, after i as 0%\n    for (var d = 0; d < total; d++) {\n      setFill(d, d < i ? 100 : 0);\n    }\n\n    cur = i;\n    track.style.transform = 'translateX(-' + (cur * 100) + '%)';\n    cards[cur].classList.add('pc2-active');\n    btnP.disabled = cur === 0;\n    btnN.disabled = cur === total - 1;\n\n    if (!paused) startLoop(0);\n  }\n\n  /* ── pause: freeze fill in place ── */\n  function pause() {\n    if (paused) return;\n    paused = true;\n    cancelLoop();\n    // record how much time has passed so we can resume from here\n    // fill width % → ms\n    var currentPct = parseFloat(fill(cur).style.width) || 0;\n    elapsed = currentPct / 100 * DURATION;\n  }\n\n  /* ── resume: continue from frozen point ── */\n  function resume() {\n    if (!paused) return;\n    paused = false;\n    startLoop(elapsed);\n  }\n\n  /* ── hover pause/resume on the card area ── */\n  var clip = document.querySelector('.pc2-clip');\n  clip.addEventListener('mouseenter', pause);\n  clip.addEventListener('mouseleave', resume);\n\n  /* ── touch ── */\n  var touchStartX = 0;\n  clip.addEventListener('touchstart', function (e) {\n    pause();\n    touchStartX = e.touches[0].clientX;\n  }, { passive: true });\n  clip.addEventListener('touchend', function (e) {\n    var diff = touchStartX - e.changedTouches[0].clientX;\n    if (Math.abs(diff) > 44) {\n      goTo(diff > 0 ? Math.min(cur + 1, total - 1) : Math.max(cur - 1, 0));\n    } else {\n      resume();\n    }\n  }, { passive: true });\n\n  /* ── arrows ── */\n  btnP.addEventListener('click', function () { goTo(Math.max(cur - 1, 0)); });\n  btnN.addEventListener('click', function () { goTo(Math.min(cur + 1, total - 1)); });\n\n  /* ── dots ── */\n  dots.forEach(function (dot, i) {\n    dot.addEventListener('click', function () { goTo(i); });\n  });\n\n  /* ── keyboard ── */\n  document.addEventListener('keydown', function (e) {\n    if (!root.matches(':hover') && !root.contains(document.activeElement)) return;\n    if (e.key === 'ArrowLeft')  goTo(Math.max(cur - 1, 0));\n    if (e.key === 'ArrowRight') goTo(Math.min(cur + 1, total - 1));\n  });\n\n  /* ── entrance ── */\n  new IntersectionObserver(function (entries) {\n    if (entries[0].isIntersecting) {\n      root.classList.add('pc2-in');\n      startLoop(0); // kick off\n    }\n  }, { threshold: 0.12 }).observe(root);\n\n})();\n</script>",
