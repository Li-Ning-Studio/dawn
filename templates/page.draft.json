      "settings": {
        "custom_liquid": "<div class=\"cct\">\n    <a href=\"#shopify-section-template--26670945075493__swipeable_products_EUex9n\" class=\"bbtn1\"><i class=\"animation\"></i><b>Extra Strong\n    </a>\n     <a href=\"#shopify-section-template--26670945075493__swipeable_products_WTtDxj\" class=\"bbtn2\"><i class=\"animation\"></i>Extreme<i class=\"animation\"></i>\n    </a>\n    \n</div>\n<style>\n.cct{\ndisplay: flex;\njustify-content:space-around;\nalign-items:center;\ncolumn-gap: 0px;\n}\n@media screen and (min-width: 800px) {\n.cct{\ndisplay:none;\n}\n}\n.cct{\ntext-align:center;\n}\n.bbtn1, .bbtn2  {\n  outline: 0;\n  display: inline-flex;\n  align-items: center;\n \n  justify-content: space-between;\n  background: #003801;\n  min-width: 100px;\n  border: 0;\n  border-radius: 500px;\n  box-shadow: 0 4px 12px rgba(0, 0, 0, .1);\n  box-sizing: border-box;\n  padding: 12px 17px;\n  color: #fff;\n  font-size: 11px;\n  letter-spacing: 1.2px;\n  text-transform: uppercase;\n  overflow: hidden;\n  cursor: pointer;\n  text-decoration:none;\nfont-weight:1000px;\n}\n.bbtn2{\nbackground: #4b1208;\n}\n\n\n.bbtn1 .animation, .bbtn2 .animation , .bbtn3 .animation  {\n  border-radius: 100%;\n  animation: 2s linear infinite;\n}\n\n@keyframes ripple {\n  0% {\n    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.1), 0 0 0 20px rgba(255, 255, 255, 0.1), 0 0 0 40px rgba(255, 255, 255, 0.1), 0 0 0 60px rgba(255, 255, 255, 0.1);\n  }\n\n  100% {\n    box-shadow: 0 0 0 20px rgba(255, 255, 255, 0.1), 0 0 0 40px rgba(255, 255, 255, 0.1), 0 0 0 60px rgba(255, 255, 255, 0.1), 0 0 0 80px rgba(255, 255, 255, 0);\n  }\n}\n</style>",
