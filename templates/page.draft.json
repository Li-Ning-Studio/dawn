n<style>\n  /* ONLY FIXES: remove Best For rows + equal card height */\n\n  .hn-predator-shop__grid {\n    align-items: stretch !important;\n  }\n\n  .hn-predator-shop__card {\n    height: 100% !important;\n    min-height: 820px !important;\n  }\n\n  .hn-predator-shop__content {\n    height: 100% !important;\n  }\n\n  .hn-predator-shop__features {\n    min-height: 150px !important;\n  }\n\n  .hn-predator-shop__desc {\n    min-height: 130px !important;\n  }\n\n  .hn-predator-shop__button {\n    margin-top: auto !important;\n  }\n\n  @media screen and (max-width: 1280px) {\n    .hn-predator-shop__card {\n      min-height: 800px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 140px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 125px !important;\n    }\n  }\n\n  @media screen and (max-width: 990px) {\n    .hn-predator-shop__card {\n      min-height: 740px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 132px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 118px !important;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-predator-shop__card {\n      min-height: 730px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 128px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 112px !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function removeBestForRows() {\n      document.querySelectorAll('.hn-predator-shop__features li').forEach(function (item) {\n        var text = item.textContent.trim().toLowerCase();\n\n        if (\n          text.includes('best for serious attackers') ||\n          text.includes('best for full attack players') ||\n          text.includes('best for sweet spot') ||\n          text.includes('best for first upgrade')\n        ) {\n          item.remove();\n        }\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', removeBestForRows);\n    } else {\n      removeBestForRows();\n    }\n\n    document.addEventListener('shopify:section:load', removeBestForRows);\n  })();\n</script>\n</style>\n\n<script>\n  (function() {\n    function initPredatorShop(root) {\n      if (!root || root.dataset.predatorShopReady === 'true') return;\n\n      var track = root.querySelector('[data-predator-track]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-product-card]'));\n      var prev = root.querySelector('[data-predator-prev]');\n      var next = root.querySelector('[data-predator-next]');\n\n      if (!track || !cards.length) return;\n\n      root.dataset.predatorShopReady = 'true';\n\n      function activeIndex() {\n        var trackLeft = track.getBoundingClientRect().left;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.getBoundingClientRect().left - trackLeft);\n\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function updateNav(index) {\n        var current = typeof index === 'number' ? index : activeIndex();\n\n        if (prev) prev.classList.toggle('is-disabled', current <= 0);\n        if (next) next.classList.toggle('is-disabled', current >= cards.length - 1);\n      }\n\n      function scrollToIndex(index) {\n        if (!cards[index]) return;\n\n        var scrollLeft = cards[index].offsetLeft;\n\n        if ('requestAnimationFrame' in window) {\n          requestAnimationFrame(function() {\n            track.scrollTo({\n              left: scrollLeft,\n              behavior: 'smooth'\n            });\n          });\n        } else {\n          track.scrollLeft = scrollLeft;\n        }\n\n        updateNav(index);\n      }\n\n      var scrollTimer;\n\n      track.addEventListener('scroll', function() {\n        window.clearTimeout(scrollTimer);\n        scrollTimer = window.setTimeout(function() {\n          updateNav();\n        }, 80);\n      }, { passive: true });\n\n      if (prev) {\n        prev.addEventListener('click', function() {\n          scrollToIndex(Math.max(activeIndex() - 1, 0));\n        });\n      }\n\n      if (next) {\n        next.addEventListener('click', function() {\n          scrollToIndex(Math.min(activeIndex() + 1, cards.length - 1));\n        });\n      }\n\n      window.addEventListener('resize', function() {\n        updateNav();\n      }, { passive: true });\n\n      updateNav(0);\n    }\n\n    function initAllPredatorShopSections() {\n      document.querySelectorAll('[data-hn-predator-shop]').forEach(initPredatorShop);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllPredatorShopSections);\n    } else {\n      initAllPredatorShopSections();\n    }\n\n    document.addEventListener('shopify:section:load', initAllPredatorShopSections);\n  })();\n</script>",
