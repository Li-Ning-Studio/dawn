-slash-pulse {\n    0%, 100% { opacity: 0.25; }\n    50% { opacity: 0.62; }\n  }\n\n  @media (max-width: 768px) {\n    .pred-reveal-hero {\n      min-height: 100svh;\n    }\n\n    .pred-reveal-hero__product {\n      width: 112vw;\n      top: 35%;\n    }\n\n    .pred-reveal-hero__strike {\n      top: 35%;\n      width: 130vw;\n    }\n\n    .pred-reveal-hero__copy {\n      left: 22px;\n      right: 22px;\n      bottom: 132px;\n    }\n\n    .pred-reveal-hero__headline {\n      font-size: clamp(46px, 15vw, 74px);\n      letter-spacing: -1.7px;\n    }\n\n    .pred-reveal-hero__sub {\n      font-size: 21px;\n    }\n\n    .pred-reveal-hero__buy {\n      left: 18px;\n      right: 18px;\n      bottom: 28px;\n      justify-content: space-between;\n    }\n\n    .pred-reveal-hero__price {\n      font-size: 13px;\n    }\n\n    .pred-reveal-hero__btn {\n      min-width: 64px;\n      height: 44px;\n      font-size: 14px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pred-reveal-hero__product,\n    .pred-reveal-hero__strike,\n    .pred-reveal-hero__slashes span,\n    .pred-reveal-hero__copy,\n    .pred-reveal-hero__buy {\n      animation: none !important;\n      opacity: 1;\n    }\n\n    .pred-reveal-hero__product--entry {\n      display: none;\n    }\n\n    .pred-reveal-hero__product--final {\n      transform: translate(-50%, -50%) scale(1) rotateZ(0deg);\n      filter:\n        blur(0)\n        drop-shadow(0 0 34px rgba(82,255,143,0.34))\n        drop-shadow(0 42px 115px rgba(0,0,0,1));\n    }\n  }\n</style>\n\n<section class=\"pred-reveal-hero\" aria-label=\"Predator Series\">\n  <div class=\"pred-reveal-hero__slashes\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"pred-reveal-hero__strike\" aria-hidden=\"true\"></div>\n\n  <div class=\"pred-reveal-hero__stage\">\n    <img\n      class=\"pred-reveal-hero__product pred-reveal-hero__product--entry\"\n      src=\"https://cdn.shopify.com/s/files/1/0933/9