        },
        "collapsible_row_VRGWUG": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which Predator is right for my level?",
            "open_by_default": false,
            "icon": "question_mark",
            "row_content": "<p><br/>The 79 and 82 Extra Strong are built for intermediate players stepping up their game. The 82 and 84 Extreme are for advanced players who attack first and defend later.</p>",
            "page": ""
          }
        },
