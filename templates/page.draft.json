      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR - FIND YOUR PREDATOR SECTION FIXED MOBILE SCROLL -->\n<section class=\"hn-predator-find\" data-hn-predator-find aria-label=\"Find your Predator\">\n  <div class=\"hn-predator-find__inner\">\n\n    <div class=\"hn-predator-find__heading-wrap\">\n      <p class=\"hn-predator-find__eyebrow\">4 Rackets. 1 Obsession.</p>\n      <h2 class=\"hn-predator-find__heading\">Find your Predator.</h2>\n    </div>\n\n    <div class=\"hn-predator-find__layout\">\n\n      <div class=\"hn-predator-find__hero-wrap\">\n        <img\n          class=\"hn-predator-find__hero\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Jun_30_2026_12_18_33_PM_b502802d-a1e8-4856-9f54-6398b489f5da.png?v=1782810409\"\n          alt=\"Predator racket lineup with orange and green split lightning background\"\n          loading=\"lazy\"\n          width=\"1200\"\n          height=\"1200\"\n        >\n      </div>\n\n      <div class=\"hn-predator-find__cards-wrap\">\n        <div class=\"hn-predator-find__cards\" data-hn-predator-carousel>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--green\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Untitled_design_24ffd79e-b12a-4cf8-b819-a994f85600d5.png?v=1782806024\"\n                alt=\"Predator 79 Extra Strong racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 79 Extra Strong</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                Your first serious racket. 88g frame, pre-strung at 28lbs and ready to play the moment it arrives. No setup. Just smash.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--green\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/03_a1f7800f-b98b-4509-a1e9-b0e90d7f237a.jpg?v=1782806024\"\n                alt=\"Predator 82 Extra Strong racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 82 Extra Strong</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                The sweet spot of the series. Lighter at 85g, 32lbs max tension, Japan graphite that outlasts every rally. Most players stop here.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--orange\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/U2ntitled_design.png?v=1782810552\"\n                alt=\"Predator 82 Extreme racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 82 Extreme</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                Built for players who've already decided. Vapour Shaft 7.0mm loads every swing and snaps back harder. 32lbs. Attacking only.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--orange\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Untiewtled_design.png?v=1782806024\"\n                alt=\"Predator 84 Extreme racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 84 Extreme</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                The ceiling. 38lbs string tension, 310mm balance point, Nano Frame cutting through air. This isn't an upgrade, it's a statement.\n              </p>\n            </div>\n          </article>\n\n        </div>\n\n        <div class=\"hn-predator-find__dots\" aria-label=\"Product slider navigation\">\n          <button class=\"hn-predator-find__dot is-active\" type=\"button\" aria-label=\"Go to product 1\" data-index=\"0\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 2\" data-index=\"1\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 3\" data-index=\"2\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 4\" data-index=\"3\"></button>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-predator-find,\n  .hn-predator-find *,\n  .hn-predator-find *::before,\n  .hn-predator-find *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-find {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #f3f3f3;\n    padding: 24px 0 68px;\n    color: #000000;\n  }\n\n  .hn-predator-find__inner {\n    width: 100%;\n    max-width: 1900px;\n    margin: 0 auto;\n    padding: 0 68px;\n  }\n\n  .hn-predator-find__heading-wrap {\n    width: 100%;\n    text-align: center;\n    margin: 0 0 24px;\n  }\n\n  .hn-predator-find__eyebrow {\n    margin: 0 0 18px;\n    color: #00b8c9;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(20px, 1.35vw, 26px);\n    font-weight: 400;\n    line-height: 1.1;\n    letter-spacing: -0.03em;\n  }\n\n  .hn-predator-find__heading {\n    margin: 0;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(40px, 2.65vw, 56px);\n    font-weight: 800;\n    line-height: 1.05;\n    letter-spacing: -0.045em;\n  }\n\n  .hn-predator-find__layout {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 742px;\n    gap: 24px;\n    align-items: start;\n  }\n\n  .hn-predator-find__hero-wrap {\n    width: 100%;\n    overflow: hidden;\n    border-radius: 16px;\n    background: #0b0b0b;\n  }\n\n  .hn-predator-find__hero {\n    width: 100%;\n    height: auto;\n    display: block;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hn-predator-find__cards-wrap {\n    width: 100%;\n    min-width: 0;\n    overflow: hidden;\n  }\n\n  .hn-predator-find__cards {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .hn-predator-find__card {\n    width: 100%;\n    min-height: 177px;\n    display: grid;\n    grid-template-columns: 181px minmax(0, 1fr);\n    overflow: hidden;\n    border-radius: 14px;\n  }\n\n  .hn-predator-find__card--green {\n    background: #49b119;\n  }\n\n  .hn-predator-find__card--orange {\n    background: #f58443;\n  }\n\n  .hn-predator-find__card-media {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #111111;\n  }\n\n  .hn-predator-find__card-media img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hn-predator-find__card