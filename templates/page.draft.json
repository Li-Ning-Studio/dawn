      "settings": {
        "custom_liquid": "<div class=\"nav\">\n  <div class=\"container\">\n  <div class=\"btn\"><a href=\"#shopify-section-template--26670945075493__swipeable_products_EUex9n\" class=\"aa1\">Extra Strong</a></div>\n    <div class=\"btn\"><a href=\"#shopify-section-template--26670945075493__swipeable_products_WTtDxj\" class=\"aa2\">Extreme</a></div>\n   \n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      viewBox=\"0 0 400 60\"\n      height=\"60\"\n      width=\"400\"\n      overflow=\"visible\"\n      class=\"outline\"\n    >\n     \n    </svg>\n  </div>\n</div>\n<style>\nhtml {\n  scroll-behavior: smooth;\n}\n\n.nav{\ndisplay:none;\n}\n\n@media screen and (min-width: 800px) {\n   \n.outline {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n.rect {\n  stroke-dashoffset: 7.5;\n  stroke-dasharray: 0 0 10 40 10 40;\n  transition: 0.5s;\n  stroke: #ffffff;\n}\n\n.nav {\ndisplay:block;\n  position: relative;\n  width: 60%;\n  height: 60px;\n  border-radius: 50px;\n  margin:0 auto;\n}\n.nav a {\ntext-decoration:none;\n  transition: 0.5s ease;\n}\n.aa1{\ncolor:#3bc400;\n}\n.aa2{\ncolor: #fa742b;\n}\n\n\n.container {\n  position: absolute;\n  inset: 0;\n  background: transparent;\n  display: flex;\n  flex-direction: row;\n  justify-content: space-around;\n  align-items: center;\n  padding: 0.5em;\n}\n\n.btn {\n  padding: 0.5em 1.5em;\n  \n  cursor: pointer;\nfont-size: 2rem;\nfont-weight: bolder;\n  transition: 0.5s ease;\n\nborder-radius: 0px;\n}\n.btn:nth-child(1){\nborder-bottom: 1px solid #3bc400;\n}\n\n.btn:nth-child(2){\nborder-bottom: 1px solid #fa742b;\n}\n.btn:nth-child(1):hover{\n  background: #003801;\n  border-radius: 500px;\n}\n.btn:nth-child(1):hover .aa1{\ncolor: white;\n}\n.btn:nth-child(2):hover .aa2{\ncolor: white;\n}\n.btn:nth-child(2):hover {\n  background: #571a09;\n  border-radius: 500px;\n}\n.btn:nth-child(3):hover {\n  background: #09b859;\n  border-radius: 500px;\n}\n\n}\n</style>",
