        "custom_liquid": "<!-- HNDRD PREDATOR - FIND YOUR PREDATOR SECTION FIXED MOBILE SCROLL -->\n<section class=\"hn-predator-find\" data-hn-predator-find aria-label=\"Find your Predator\">\n  <div class=\"hn-predator-find__inner\">\n\n    <div class=\"hn-predator-find__heading-wrap\">\n      <p class=\"hn-predator-find__eyebrow\">4 Rackets. 1 Obsession.</p>\n      <h2 class=\"hn-predator-find__heading\">Find your Predator.</h2>\n    </div>\n\n    <div class=\"hn-predator-find__layout\">\n\n      <div class=\"hn-predator-find__hero-wrap\">\n        <img\n          class=\"hn-predator-find__hero\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Jun_30_2026_12_18_33_PM_b502802d-a1e8-4856-9f54-6398b489f5da.png?v=1782810409\"\n          alt=\"Predator racket lineup with orange and green split lightning background\"\n          loading=\"lazy\"\n          width=\"1200\"\n          height=\"1200\"\n        >\n      </div>\n\n      <div class=\"hn-predator-find__cards-wrap\">\n        <div class=\"hn-predator-find__cards\" data-hn-predator-carousel>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--green\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Untitled_design_24ffd79e-b12a-4cf8-b819-a994f85600d5.png?v=1782806024\"\n                alt=\"Predator 79 Extra Strong racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 79 Extra Strong</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                Your first serious racket. 88g frame, pre-strung at 28lbs and ready to play the moment it arrives. No setup. Just smash.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--green\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/03_a1f7800f-b98b-4509-a1e9-b0e90d7f237a.jpg?v=1782806024\"\n                alt=\"Predator 82 Extra Strong racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 82 Extra Strong</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                The sweet spot of the series. Lighter at 85g, 32lbs max tension, Japan graphite that outlasts every rally. Most players stop here.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--orange\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/U2ntitled_design.png?v=1782810552\"\n                alt=\"Predator 82 Extreme racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 82 Extreme</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                Built for players who've already decided. Vapour Shaft 7.0mm loads every swing and snaps back harder. 32lbs. Attacking only.\n              </p>\n            </div>\n          </article>\n\n          <article class=\"hn-predator-find__card hn-predator-find__card--orange\">\n            <div class=\"hn-predator-find__card-media\">\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Untiewtled_design.png?v=1782806024\"\n                alt=\"Predator 84 Extreme racket\"\n                loading=\"lazy\"\n                width=\"500\"\n                height=\"500\"\n              >\n            </div>\n            <div class=\"hn-predator-find__card-content\">\n              <h3 class=\"hn-predator-find__card-title\">Predator 84 Extreme</h3>\n              <div class=\"hn-predator-find__card-rule\"></div>\n              <p class=\"hn-predator-find__card-copy\">\n                The ceiling. 38lbs string tension, 310mm balance point, Nano Frame cutting through air. This isn't an upgrade, it's a statement.\n              </p>\n            </div>\n          </article>\n\n        </div>\n\n        <div class=\"hn-predator-find__dots\" aria-label=\"Product slider navigation\">\n          <button class=\"hn-predator-find__dot is-active\" type=\"button\" aria-label=\"Go to product 1\" data-index=\"0\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 2\" data-index=\"1\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 3\" data-index=\"2\"></button>\n          <button class=\"hn-predator-find__dot\" type=\"button\" aria-label=\"Go to product 4\" data-index=\"3\"></button>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-predator-find,\n  .hn-predator-find *,\n  .hn-predator-find *::before,\n  .hn-predator-find *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-find {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #f3f3f3;\n    padding: 24px 0 68px;\n    color: #000000;\n  }\n\n  .hn-predator-find__inner {\n    width: 100%;\n    max-width: 1900px;\n    margin: 0 auto;\n    padding: 0 68px;\n  }\n\n  .hn-predator-find__heading-wrap {\n    width: 100%;\n    text-align: center;\n    margin: 0 0 24px;\n  }\n\n  .hn-predator-find__eyebrow {\n    margin: 0 0 18px;\n    color: #00b8c9;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(20px, 1.35vw, 26px);\n    font-weight: 400;\n    line-height: 1.1;\n    letter-spacing: -0.03em;\n  }\n\n  .hn-predator-find__heading {\n    margin: 0;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(40px, 2.65vw, 56px);\n    font-weight: 800;\n    line-height: 1.05;\n    letter-spacing: -0.045em;\n  }\n\n  .hn-predator-find__layout {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 742px;\n    gap: 24px;\n    align-items: start;\n  }\n\n  .hn-predator-find__hero-wrap {\n    width: 100%;\n    overflow: hidden;\n    border-radius: 16px;\n    background: #0b0b0b;\n  }\n\n  .hn-predator-find__hero {\n    width: 100%;\n    height: auto;\n    display: block;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hn-predator-find__cards-wrap {\n    width: 100%;\n    min-width: 0;\n    overflow: hidden;\n  }\n\n  .hn-predator-find__cards {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .hn-predator-find__card {\n    width: 100%;\n    min-height: 177px;\n    display: grid;\n    grid-template-columns: 181px minmax(0, 1fr);\n    overflow: hidden;\n    border-radius: 14px;\n  }\n\n  .hn-predator-find__card--green {\n    background: #49b119;\n  }\n\n  .hn-predator-find__card--orange {\n    background: #f58443;\n  }\n\n  .hn-predator-find__card-media {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #111111;\n  }\n\n  .hn-predator-find__card-media img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hn-predator-find__card-content {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 24px 28px 20px 20px;\n  }\n\n  .hn-predator-find__card-title {\n    margin: 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 22px;\n    font-weight: 500;\n    line-height: 1.08;\n    letter-spacing: -0.035em;\n  }\n\n  .hn-predator-find__card-rule {\n    width: 100%;\n    height: 1px;\n    margin: 13px 0 9px;\n    background: rgba(255, 255, 255, 0.48);\n  }\n\n  .hn-predator-find__card-copy {\n    margin: 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 15px;\n    font-style: italic;\n    font-weight: 400;\n    line-height: 1.28;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-predator-find__dots {\n    display: none;\n  }\n\n  @media screen and (max-width: 1400px) {\n    .hn-predator-find__inner {\n      padding: 0 34px;\n    }\n\n    .hn-predator-find__layout {\n      grid-template-columns: minmax(0, 1fr) 640px;\n      gap: 18px;\n    }\n\n    .hn-predator-find__card {\n      grid-template-columns: 170px minmax(0, 1fr);\n      min-height: 168px;\n    }\n\n    .hn-predator-find__card-content {\n      padding: 20px 22px 18px 18px;\n    }\n\n    .hn-predator-find__card-title {\n      font-size: 19px;\n    }\n\n    .hn-predator-find__card-copy {\n      font-size: 14px;\n    }\n  }\n\n  @media screen and (max-width: 900px) {\n    .hn-predator-find {\n      padding: 22px 0 48px;\n    }\n\n    .hn-predator-find__inner {\n      padding: 0 16px;\n    }\n\n    .hn-predator-find__heading-wrap {\n      margin-bottom: 18px;\n    }\n\n    .hn-predator-find__eyebrow {\n      margin-bottom: 16px;\n      font-size: 20px;\n    }\n\n    .hn-predator-find__heading {\n      font-size: 34px;\n      line-height: 1.04;\n    }\n\n    .hn-predator-find__layout {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n\n    .hn-predator-find__hero-wrap {\n      border-radius: 16px;\n    }\n\n    .hn-predator-find__hero {\n      aspect-ratio: auto;\n    }\n\n    .hn-predator-find__cards-wrap {\n      width: 100%;\n      overflow: visible;\n      touch-action: auto;\n    }\n\n    .hn-predator-find__cards {\n      display: flex;\n      flex-direction: row;\n      gap: 12px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      padding: 0 58px 4px 0;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      touch-action: auto;\n      overscroll-behavior-x: contain;\n      overscroll-behavior-y: auto;\n    }\n\n    .hn-predator-find__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-predator-find__card {\n      flex: 0 0 calc(100vw - 104px);\n      width: calc(100vw - 104px);\n      max-width: 360px;\n      display: flex;\n      flex-direction: column;\n      min-height: unset;\n      border-radius: 14px;\n      scroll-snap-align: start;\n    }\n\n    .hn-predator-find__card-media {\n      height: 315px;\n      flex: 0 0 315px;\n    }\n\n    .hn-predator-find__card-content {\n      padding: 18px 18px 20px;\n    }\n\n    .hn-predator-find__card-title {\n      font-size: 19px;\n      line-height: 1.12;\n    }\n\n    .hn-predator-find__card-rule {\n      margin: 14px 0 14px;\n    }\n\n    .hn-predator-find__card-copy {\n      font-size: 14px;\n      line-height: 1.35;\n    }\n\n    .hn-predator-find__dots {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      margin-top: 10px;\n    }\n\n    .hn-predator-find__dot {\n      width: 10px;\n      height: 10px;\n      padding: 0;\n      border: 0;\n      border-radius: 999px;\n      background: #d8d8d8;\n      cursor: pointer;\n      transition: background-color 0.2s ease, transform 0.2s ease;\n    }\n\n    .hn-predator-find__dot.is-active {\n      background: #8c5b33;\n      transform: scale(1.05);\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-predator-find {\n      padding-top: 20px;\n    }\n\n    .hn-predator-find__inner {\n      padding: 0 16px;\n    }\n\n    .hn-predator-find__eyebrow {\n      font-size: 20px;\n      margin-bottom: 14px;\n    }\n\n    .hn-predator-find__heading {\n      font-size: 33px;\n    }\n\n    .hn-predator-find__card {\n      flex-basis: calc(100vw - 104px);\n      width: calc(100vw - 104px);\n      max-width: 326px;\n    }\n\n    .hn-predator-find__card-media {\n      height: 308px;\n      flex-basis: 308px;\n    }\n\n    .hn-predator-find__card-content {\n      padding: 17px 16px 18px;\n    }\n\n    .hn-predator-find__card-title {\n      font-size: 18px;\n    }\n\n    .hn-predator-find__card-copy {\n      font-size: 13px;\n    }\n  }\n/* FINAL FIND YOUR PREDATOR BLACK BG + YOUR EXACT GRADIENT */\n.hn-predator-find {\n  background: #000000 !important;\n  background-color: #000000 !important;\n  padding-top: 44px !important;\n}\n\n.hn-predator-find__inner,\n.hn-predator-find__layout,\n.hn-predator-find__cards-wrap,\n.hn-predator-find__heading-wrap {\n  background: transparent !important;\n}\n\n.hn-predator-find__heading-wrap {\n  width: 100% !important;\n  text-align: center !important;\n  margin: 0 0 38px !important;\n}\n\n.hn-predator-find__eyebrow {\n  margin: 0 0 22px !important;\n  color: #ffffff !important;\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: 18px !important;\n  font-weight: 400 !important;\n  line-height: 1.1 !important;\n  letter-spacing: -0.02em !important;\n  text-align: center !important;\n}\n\n.hn-predator-find__heading {\n  display: inline-block !important;\n  width: fit-content !important;\n  max-width: 100% !important;\n  margin: 0 auto !important;\n\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: clamp(42px, 5.7vw, 92px) !important;\n  font-weight: 900 !important;\n  line-height: 0.95 !important;\n  letter-spacing: -0.06em !important;\n  text-align: center !important;\n\n  background-image: linear-gradient(\n    to right,\n    #008a36 0%,\n    #008a36 34%,\n    #3f8724 44%,\n    #8c7214 52%,\n    #d85f07 62%,\n    #ff5c00 72%,\n    #ff5c00 100%\n  ) !important;\n\n  background-size: 100% 100% !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  color: transparent !important;\n  -webkit-text-fill-color: transparent !important;\n}\n\n.hn-predator-find__dots {\n  background: transparent !important;\n}\n\n.hn-predator-find__dot {\n  background: #2d2d2d !important;\n}\n\n.hn-predator-find__dot.is-active {\n  background: #ffffff !important;\n}\n\n@media screen and (max-width: 900px) {\n  .hn-predator-find {\n    background: #000000 !important;\n    background-color: #000000 !important;\n    padding-top: 38px !important;\n  }\n\n  .hn-predator-find__heading-wrap {\n    margin-bottom: 30px !important;\n  }\n\n  .hn-predator-find__eyebrow {\n    font-size: 15px !important;\n    margin-bottom: 16px !important;\n    line-height: 1.15 !important;\n  }\n\n  .hn-predator-find__heading {\n    font-size: clamp(36px, 11vw, 58px) !important;\n    line-height: 1 !important;\n    letter-spacing: -0.055em !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-find {\n    padding-top: 34px !important;\n  }\n\n  .hn-predator-find__eyebrow {\n    font-size: 14px !important;\n    margin-bottom: 14px !important;\n  }\n\n  .hn-predator-find__heading {\n    font-size: clamp(34px, 10.5vw, 48px) !important;\n  }\n}\n/* REDUCE FIND YOUR PREDATOR HEADING SIZE */\n.hn-predator-find__heading {\n  font-size: clamp(34px, 4.2vw, 66px) !important;\n  line-height: 0.98 !important;\n  letter-spacing: -0.055em !important;\n}\n\n.hn-predator-find__heading-wrap {\n  margin-bottom: 34px !important;\n}\n\n@media screen and (max-width: 900px) {\n  .hn-predator-find__heading {\n    font-size: clamp(30px, 8.8vw, 44px) !important;\n    line-height: 1.02 !important;\n    letter-spacing: -0.052em !important;\n  }\n\n  .hn-predator-find__heading-wrap {\n    margin-bottom: 26px !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-find__heading {\n    font-size: clamp(29px, 8.2vw, 38px) !important;\n  }\n}\n</style>\n\n<script>\n  (function() {\n    function initPredatorFindCarousel(root) {\n      if (!root || root.dataset.carouselReady === 'true') return;\n\n      var track = root.querySelector('[data-hn-predator-carousel]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-find__card'));\n      var dots = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-find__dot'));\n\n      if (!track || !cards.length || !dots.length) return;\n\n      root.dataset.carouselReady = 'true';\n\n      var rafId = null;\n\n      function setActiveDot(index) {\n        dots.forEach(function(dot, i) {\n          dot.classList.toggle('is-active', i === index);\n        });\n      }\n\n      function getActiveIndex() {\n        var scrollLeft = track.scrollLeft;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.offsetLeft - scrollLeft);\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function updateDots() {\n        if (rafId) return;\n\n        rafId = window.requestAnimationFrame(function() {\n          setActiveDot(getActiveIndex());\n          rafId = null;\n        });\n      }\n\n      function scrollToCard(index) {\n        if (!cards[index]) return;\n\n        track.scrollTo({\n          left: cards[index].offsetLeft,\n          behavior: 'smooth'\n        });\n\n        setActiveDot(index);\n      }\n\n      track.addEventListener('scroll', updateDots, { passive: true });\n\n      dots.forEach(function(dot) {\n        dot.addEventListener('click', function() {\n          var index = Number(dot.getAttribute('data-index'));\n          if (Number.isNaN(index)) return;\n          scrollToCard(index);\n        });\n      });\n\n      window.addEventListener('resize', updateDots, { passive: true });\n\n      setActiveDot(0);\n    }\n\n    function initAllPredatorFindCarousels() {\n      document.querySelectorAll('[data-hn-predator-find]').forEach(initPredatorFindCarousel);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllPredatorFindCarousels);\n    } else {\n      initAllPredatorFindCarousels();\n    }\n\n    document.addEventListener('shopify:section:load', initAllPredatorFindCarousels);\n  })();\n</script>",
