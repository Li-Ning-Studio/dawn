        "custom_liquid": "<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #080b09 !important;\n  }\n\n  .pred-hl {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    padding: clamp(52px, 7vw, 96px) 0;\n    background:\n      radial-gradient(circle at 50% 0%, rgba(82,255,143,0.12), transparent 34%),\n      linear-gradient(180deg, #080b09 0%, #111513 48%, #080b09 100%);\n    color: #f4fff7;\n    overflow: hidden;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  .pred-hl__head {\n    width: min(1280px, calc(100% - 40px));\n    margin: 0 auto 34px;\n    display: flex;\n    align-items: end;\n    justify-content: space-between;\n    gap: 22px;\n  }\n\n  .pred-hl__eyebrow {\n    margin: 0 0 12px;\n    color: #5cff98;\n    font-size: 12px;\n    font-weight: 900;\n    letter-spacing: 3.5px;\n    text-transform: uppercase;\n  }\n\n  .pred-hl__title {\n    margin: 0;\n    max-width: 760px;\n    font-size: clamp(42px, 5.5vw, 82px);\n    line-height: 0.92;\n    font-weight: 950;\n    letter-spacing: -3px;\n    color: #f4fff7;\n  }\n\n  .pred-hl__title span {\n    color: #5cff98;\n    text-shadow: 0 0 34px rgba(92,255,152,0.26);\n  }\n\n  .pred-hl__link {\n    color: #0b130e;\n    background: #5cff98;\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: 900;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n    white-space: nowrap;\n    padding: 14px 20px;\n    border-radius: 999px;\n    box-shadow: 0 0 34px rgba(92,255,152,0.26);\n  }\n\n  .pred-hl__track {\n    display: flex;\n    gap: 24px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    padding: 0 max(20px, calc((100vw - 1280px) / 2)) 28px;\n    scrollbar-width: none;\n  }\n\n  .pred-hl__track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .pred-card {\n    position: relative;\n    flex: 0 0 min(1120px, calc(100vw - 74px));\n    height: clamp(560px, 70vh, 700px);\n    border-radius: 30px;\n    overflow: hidden;\n    scroll-snap-align: center;\n    background: #020403;\n    isolation: isolate;\n    transform: scale(0.955);\n    opacity: 0.54;\n    transition: transform 0.45s ease, opacity 0.45s ease, box-shadow 0.45s ease;\n    box-shadow: 0 30px 90px rgba(0,0,0,0.55);\n  }\n\n  .pred-card.is-active {\n    transform: scale(1);\n    opacity: 1;\n    box-shadow:\n      0 0 0 1px rgba(92,255,152,0.16),\n      0 42px 120px rgba(0,0,0,0.88),\n      0 0 70px rgba(92,255,152,0.12);\n  }\n\n  .pred-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(circle at 70% 48%, rgba(92,255,152,0.23), transparent 28%),\n      radial-gradient(circle at 58% 78%, rgba(0,110,50,0.28), transparent 44%),\n      linear-gradient(135deg, rgba(92,255,152,0.08), transparent 30%, rgba(92,255,152,0.05)),\n      #020403;\n    z-index: -6;\n  }\n\n  .pred-card::after {\n    content: \"PREDATOR\";\n    position: absolute;\n    right: -5%;\n    bottom: -2%;\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: clamp(105px, 15vw, 240px);\n    line-height: 0.8;\n    letter-spacing: 7px;\n    color: transparent;\n    -webkit-text-stroke: 1px rgba(92,255,152,0.085);\n    text-stroke: 1px rgba(92,255,152,0.085);\n    white-space: nowrap;\n    z-index: -3;\n  }\n\n  .pred-card__copy {\n    position: absolute;\n    left: clamp(28px, 4.4vw, 68px);\n    top: clamp(30px, 4.4vw, 62px);\n    max-width: 540px;\n    z-index: 6;\n  }\n\n  .pred-card__kicker {\n    margin: 0 0 12px;\n    color: #5cff98;\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: 3.4px;\n    text-transform: uppercase;\n  }\n\n  .pred-card__title {\n    margin: 0;\n    font-size: clamp(38px, 4.6vw, 76px);\n    line-height: 0.9;\n    font-weight: 950;\n    letter-spacing: -2.6px;\n    color: #f4fff7;\n    text-shadow: 0 20px 60px rgba(0,0,0,0.8);\n  }\n\n  .pred-card__title span {\n    color: #5cff98;\n  }\n\n  .pred-card__line {\n    margin: 16px 0 0;\n    max-width: 390px;\n    color: rgba(224, 255, 234, 0.76);\n    font-size: clamp(16px, 1.45vw, 21px);\n    line-height: 1.24;\n    font-weight: 800;\n    letter-spacing: -0.4px;\n  }\n\n  .pred-card__media {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    padding: clamp(132px, 12vw, 180px) clamp(30px, 6vw, 90px) 44px;\n    z-index: 2;\n  }\n\n  .pred-card__frame {\n    position: relative;\n    width: min(64vw, 720px);\n    height: min(43vw, 430px);\n    max-height: 430px;\n    border-radius: 32px;\n    border: 1px solid rgba(92,255,152,0.28);\n    background:\n      radial-gradient(circle at 50% 48%, rgba(92,255,152,0.19), transparent 42%),\n      linear-gradient(140deg, rgba(92,255,152,0.12), transparent 28%),\n      rgba(2, 8, 5, 0.92);\n    box-shadow:\n      inset 0 0 52px rgba(92,255,152,0.07),\n      0 0 78px rgba(92,255,152,0.18),\n      0 48px 135px rgba(0,0,0,0.95);\n    overflow: hidden;\n    display: grid;\n    place-items: center;\n    transform: rotate(-1.8deg);\n  }\n\n  .pred-card__frame::before {\n    content: \"\";\n    position: absolute;\n    inset: -45%;\n    background: linear-gradient(110deg, transparent 32%, rgba(255,255,255,0.20) 48%, transparent 64%);\n    transform: translateX(-70%);\n    opacity: 0;\n  }\n\n  .pred-card.is-active .pred-card__frame {\n    animation: pred-frame-live 4.8s ease-in-out infinite;\n  }\n\n  .pred-card.is-active .pred-card__frame::before {\n    animation: pred-shine 4.2s ease-in-out infinite;\n  }\n\n  .pred-card__image {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: center;\n    display: block;\n    padding: clamp(20px, 3.2vw, 38px);\n    filter:\n      drop-shadow(0 0 32px rgba(92,255,152,0.30))\n      drop-shadow(0 34px 80px rgba(0,0,0,0.92));\n  }\n\n  .pred-card__impact {\n    position: absolute;\n    right: clamp(24px, 4vw, 58px);\n    bottom: clamp(28px, 4vw, 54px);\n    z-index: 4;\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: clamp(86px, 11vw, 184px);\n    line-height: 0.8;\n    color: transparent;\n    -webkit-text-stroke: 1px rgba(92,255,152,0.18);\n    text-stroke: 1px rgba(92,255,152,0.18);\n    opacity: 0.82;\n  }\n\n  .pred-card__slash {\n    position: absolute;\n    width: 4px;\n    height: 680px;\n    background: linear-gradient(180deg, transparent, #5cff98, transparent);\n    box-shadow: 0 0 36px rgba(92,255,152,0.72);\n    transform: rotate(28deg);\n    opacity: 0.32;\n    z-index: 5;\n  }\n\n  .pred-card__slash.one {\n    left: 14%;\n    top: -20%;\n  }\n\n  .pred-card__slash.two {\n    right: 15%;\n    bottom: -26%;\n    opacity: 0.2;\n  }\n\n  .pred-card.is-active .pred-card__slash {\n    animation: pred-slash-live 3.3s ease-in-out infinite;\n  }\n\n  .pred-hl__controls {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    margin-top: -2px;\n  }\n\n  .pred-hl__dots {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 16px 24px;\n    border-radius: 999px;\n    background: rgba(32, 36, 34, 0.92);\n    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);\n  }\n\n  .pred-hl__dot {\n    width: 8px;\n    height: 8px;\n    border: 0;\n    padding: 0;\n    border-radius: 999px;\n    background: rgba(244,255,247,0.58);\n    cursor: pointer;\n    transition: 0.25s ease;\n  }\n\n  .pred-hl__dot.is-active {\n    width: 48px;\n    background: #5cff98;\n    box-shadow: 0 0 22px rgba(92,255,152,0.55);\n  }\n\n  .pred-hl__nav,\n  .pred-hl__play {\n    width: 54px;\n    height: 54px;\n    border: 0;\n    border-radius: 999px;\n    background: rgba(32, 36, 34, 0.92);\n    color: #f4fff7;\n    cursor: pointer;\n    display: grid;\n    place-items: center;\n    transition: 0.2s ease;\n  }\n\n  .pred-hl__nav:hover,\n  .pred-hl__play:hover {\n    background: #5cff98;\n    color: #071109;\n    transform: scale(1.04);\n  }\n\n  .pred-hl__nav svg,\n  .pred-hl__play svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  @keyframes pred-frame-live {\n    0%, 100% { transform: rotate(-1.8deg) scale(1); }\n    50% { transform: rotate(-0.4deg) scale(1.026); }\n  }\n\n  @keyframes pred-shine {\n    0%, 45% { opacity: 0; transform: translateX(-70%); }\n    62% { opacity: 1; }\n    100% { opacity: 0; transform: translateX(70%); }\n  }\n\n  @keyframes pred-slash-live {\n    0%, 100% { opacity: 0.18; }\n    50% { opacity: 0.66; }\n  }\n\n  @media (max-width: 768px) {\n    .pred-hl {\n      padding: 46px 0 56px;\n    }\n\n    .pred-hl__head {\n      width: calc(100% - 36px);\n      margin-bottom: 28px;\n      display: block;\n    }\n\n    .pred-hl__title {\n      font-size: clamp(40px, 12vw, 60px);\n      letter-spacing: -2px;\n    }\n\n    .pred-hl__link {\n      display: inline-block;\n      margin-top: 18px;\n      font-size: 12px;\n      padding: 13px 18px;\n    }\n\n    .pred-hl__track {\n      gap: 16px;\n      padding: 0 18px 24px;\n    }\n\n    .pred-card {\n      flex-basis: calc(100vw - 36px);\n      height: 590px;\n      border-radius: 24px;\n      transform: scale(0.98);\n    }\n\n    .pred-card__copy {\n      left: 24px;\n      right: 24px;\n      top: 28px;\n    }\n\n    .pred-card__title {\n      font-size: clamp(38px, 12vw, 56px);\n      letter-spacing: -1.7px;\n    }\n\n    .pred-card__line {\n      max-width: 310px;\n      font-size: 17px;\n    }\n\n    .pred-card__media {\n      padding: 210px 20px 48px;\n    }\n\n    .pred-card__frame {\n      width: 82vw;\n      height: 315px;\n      border-radius: 24px;\n      transform: rotate(-1deg);\n    }\n\n    .pred-card__image {\n      padding: 22px;\n    }\n\n    .pred-card__impact {\n      right: 22px;\n      bottom: 28px;\n      font-size: 94px;\n    }\n\n    .pred-card::after {\n      right: -45%;\n      bottom: 3%;\n      font-size: 132px;\n    }\n\n    .pred-hl__nav {\n      display: none;\n    }\n\n    .pred-hl__dots {\n      padding: 14px 20px;\n    }\n\n    .pred-hl__play {\n      width: 50px;\n      height: 50px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pred-hl__track {\n      scroll-behavior: auto;\n    }\n\n    .pred-card,\n    .pred-card__frame,\n    .pred-card__frame::before,\n    .pred-card__slash {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<section class=\"pred-hl\" id=\"pred-hl-{{ section.id }}\" aria-label=\"Predator Series highlights\">\n  <div class=\"pred-hl__head\">\n    <div>\n      <p class=\"pred-hl__eyebrow\">Section 02</p>\n      <h2 class=\"pred-hl__title\">Feel the <span>attack.</span></h2>\n    </div>\n    <a class=\"pred-hl__link\" href=\"/collections/predator\">Explore Predator</a>\n  </div>\n\n  <div class=\"pred-hl__track\">\n    <article class=\"pred-card is-active\">\n      <div class=\"pred-card__copy\">\n        <p class=\"pred-card__kicker\">Moment 01</p>\n        <h3 class=\"pred-card__title\"><span>Point</span> over.</h3>\n        <p class=\"pred-card__line\">One clean smash. The rally shuts down.</p>\n      </div>\n      <div class=\"pred-card__media\">\n        <div class=\"pred-card__frame\">\n          <img class=\"pred-card__image\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Gemini_Generated_Image_xoh6unxoh6unxoh6_1.png?v=1782383542\" alt=\"Predator Series racket\">\n        </div>\n      </div>\n      <div class=\"pred-card__impact\">01</div>\n      <span class=\"pred-card__slash one\"></span>\n      <span class=\"pred-card__slash two\"></span>\n    </article>\n\n    <article class=\"pred-card\">\n      <div class=\"pred-card__copy\">\n        <p class=\"pred-card__kicker\">Moment 02</p>\n        <h3 class=\"pred-card__title\"><span>Swing</span> free.</h3>\n        <p class=\"pred-card__line\">Your arm wants speed. Predator answers.</p>\n      </div>\n      <div class=\"pred-card__media\">\n        <div class=\"pred-card__frame\">\n          <img class=\"pred-card__image\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Gemini_Generated_Image_xoh6unxoh6unxoh6_1.png?v=1782383542\" alt=\"Predator Series racket\">\n        </div>\n      </div>\n      <div class=\"pred-card__impact\">02</div>\n      <span class=\"pred-card__slash one\"></span>\n      <span class=\"pred-card__slash two\"></span>\n    </article>\n\n    <article class=\"pred-card\">\n      <div class=\"pred-card__copy\">\n        <p class=\"pred-card__kicker\">Moment 03</p>\n        <h3 class=\"pred-card__title\"><span>Go</span> first.</h3>\n        <p class=\"pred-card__line\">Step in early. Take the rally before it opens.</p>\n      </div>\n      <div class=\"pred-card__media\">\n        <div class=\"pred-card__frame\">\n          <img class=\"pred-card__image\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Gemini_Generated_Image_xoh6unxoh6unxoh6_1.png?v=1782383542\" alt=\"Predator Series racket\">\n        </div>\n      </div>\n      <div class=\"pred-card__impact\">03</div>\n      <span class=\"pred-card__slash one\"></span>\n      <span class=\"pred-card__slash two\"></span>\n    </article>\n\n    <article class=\"pred-card\">\n      <div class=\"pred-card__copy\">\n        <p class=\"pred-card__kicker\">Moment 04</p>\n        <h3 class=\"pred-card__title\"><span>No</span> waste.</h3>\n        <p class=\"pred-card__line\">Every gram has a job. Every swing has intent.</p>\n      </div>\n      <div class=\"pred-card__media\">\n        <div class=\"pred-card__frame\">\n          <img class=\"pred-card__image\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Gemini_Generated_Image_xoh6unxoh6unxoh6_1.png?v=1782383542\" alt=\"Predator Series racket\">\n        </div>\n      </div>\n      <div class=\"pred-card__impact\">04</div>\n      <span class=\"pred-card__slash one\"></span>\n      <span class=\"pred-card__slash two\"></span>\n    </article>\n  </div>\n\n  <div class=\"pred-hl__controls\">\n    <button class=\"pred-hl__nav pred-hl__prev\" type=\"button\" aria-label=\"Previous highlight\">\n      <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M12.5 4.5L7 10L12.5 15.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n    <div class=\"pred-hl__dots\" aria-label=\"Highlight navigation\">\n      <button class=\"pred-hl__dot is-active\" type=\"button\" aria-label=\"Go to highlight 1\"></button>\n      <button class=\"pred-hl__dot\" type=\"button\" aria-label=\"Go to highlight 2\"></button>\n      <button class=\"pred-hl__dot\" type=\"button\" aria-label=\"Go to highlight 3\"></button>\n      <button class=\"pred-hl__dot\" type=\"button\" aria-label=\"Go to highlight 4\"></button>\n    </div>\n\n    <button class=\"pred-hl__play\" type=\"button\" aria-label=\"Pause carousel\" data-playing=\"true\">\n      <svg class=\"pred-pause\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path d=\"M6 4h3v12H6V4Zm5 0h3v12h-3V4Z\"/></svg>\n      <svg class=\"pred-play\" viewBox=\"0 0 20 20\" fill=\"currentColor\" style=\"display:none;\"><path d=\"M6.5 4.5v11l9-5.5-9-5.5Z\"/></svg>\n    </button>\n\n    <button class=\"pred-hl__nav pred-hl__next\" type=\"button\" aria-label=\"Next highlight\">\n      <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M7.5 4.5L13 10L7.5 15.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n</section>\n\n<script>\n  (() => {\n    const root = document.querySelector('#pred-hl-{{ section.id }}');\n    if (!root) return;\n\n    const track = root.querySelector('.pred-hl__track');\n    const cards = [...root.querySelectorAll('.pred-card')];\n    const dots = [...root.querySelectorAll('.pred-hl__dot')];\n    const prev = root.querySelector('.pred-hl__prev');\n    const next = root.querySelector('.pred-hl__next');\n    const playBtn = root.querySelector('.pred-hl__play');\n    const playIcon = root.querySelector('.pred-play');\n    const pauseIcon = root.querySelector('.pred-pause');\n\n    let index = 0;\n    let playing = true;\n    let timer;\n\n    const setActive = (i) => {\n      index = (i + cards.length) % cards.length;\n      cards.forEach((card, n) => card.classList.toggle('is-active', n === index));\n      dots.forEach((dot, n) => dot.classList.toggle('is-active', n === index));\n    };\n\n    const goTo = (i) => {\n      setActive(i);\n      cards[index].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });\n    };\n\n    const start = () => {\n      stop();\n      timer = setInterval(() => goTo(index + 1), 4600);\n    };\n\n    const stop = () => {\n      if (timer) clearInterval(timer);\n    };\n\n    dots.forEach((dot, i) => {\n      dot.addEventListener('click', () => {\n        goTo(i);\n        if (playing) start();\n      });\n    });\n\n    prev.addEventListener('click', () => {\n      goTo(index - 1);\n      if (playing) start();\n    });\n\n    next.addEventListener('click', () => {\n      goTo(index + 1);\n      if (playing) start();\n    });\n\n    playBtn.addEventListener('click', () => {\n      playing = !playing;\n      playBtn.setAttribute('aria-label', playing ? 'Pause carousel' : 'Play carousel');\n      playIcon.style.display = playing ? 'none' : 'block';\n      pauseIcon.style.display = playing ? 'block' : 'none';\n      playing ? start() : stop();\n    });\n\n    let ticking = false;\n    track.addEventListener('scroll', () => {\n      if (ticking) return;\n      ticking = true;\n\n      requestAnimationFrame(() => {\n        const center = track.scrollLeft + track.offsetWidth / 2;\n        let closest = 0;\n        let distance = Infinity;\n\n        cards.forEach((card, i) => {\n          const cardCenter = card.offsetLeft + card.offsetWidth / 2;\n          const currentDistance = Math.abs(center - cardCenter);\n\n          if (currentDistance < distance) {\n            closest = i;\n            distance = currentDistance;\n          }\n        });\n\n        setActive(closest);\n        ticking = false;\n      });\n    }, { passive: true });\n\n    root.addEventListener('mouseenter', stop);\n    root.addEventListener('mouseleave', () => {\n      if (playing) start();\n    });\n\n    start();\n  })();\n</script>",
