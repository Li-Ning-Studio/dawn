    "custom_liquid_jA6bpj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  NITRIX BULLET 80 — PRECISION HUNT + CONTINUOUS PRODUCT REVEAL\n  ----------------------------------------------------------------\n  Paste into ONE Shopify Custom Liquid section.\n\n  EXPERIENCE:\n  1. Desktop: the precision sight follows the mouse.\n  2. Mobile: drag the sight with one finger.\n  3. Hold the sight over the hidden racket to acquire it.\n  4. The racket is carried into the centre of Section 02.\n  5. Minimal Swiss specifications appear on both sides.\n\n  MEDIA:\n  Upload the background media and transparent racket PNG to Shopify Files,\n  then paste their CDN URLs below.\n\n  TARGET POSITION:\n  Adjust the four percentage values until the hidden racket sits exactly\n  where you want it in the hero environment.\n{%- endcomment -%}\n\n{%- liquid\n  assign b80_video_desktop = ''\n  assign b80_video_mobile = ''\n\n  assign b80_background_desktop = ''\n  assign b80_background_mobile = ''\n\n  assign b80_racket_png = ''\n\n  assign b80_product_url = '/products/nitrix-bullet-80'\n\n  assign b80_target_x_desktop = 73\n  assign b80_target_y_desktop = 43\n\n  assign b80_target_x_mobile = 67\n  assign b80_target_y_mobile = 36\n-%}\n\n<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    overflow: visible;\n  }\n\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .b80-hunt,\n  .b80-hunt * {\n    box-sizing: border-box;\n  }\n\n  .b80-hunt {\n    --orange: #ffa400;\n    --black: #050505;\n    --paper: #f2efe7;\n    --ink: #101010;\n\n    --target-x: {{ b80_target_x_desktop }}%;\n    --target-y: {{ b80_target_y_desktop }}%;\n    --lock: 0;\n\n    position: relative;\n    width: 100%;\n    overflow: clip;\n    font-family: Figtree, var(--font-body-family), Arial, sans-serif;\n  }\n\n  .b80-hunt a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  /* ============================================================\n     SECTION 01 — SEARCH ENVIRONMENT\n  ============================================================ */\n\n  .b80-hunt__hero {\n    position: relative;\n    width: 100%;\n    min-height: 760px;\n    height: 100svh;\n    max-height: 1080px;\n    overflow: hidden;\n    isolation: isolate;\n    color: var(--paper);\n    background: var(--black);\n    cursor: none;\n    touch-action: none;\n  }\n\n  .b80-hunt__media,\n  .b80-hunt__fallback,\n  .b80-hunt__shade,\n  .b80-hunt__grain,\n  .b80-hunt__flash {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  .b80-hunt__media,\n  .b80-hunt__fallback {\n    z-index: 0;\n    overflow: hidden;\n    background: #080808;\n  }\n\n  .b80-hunt__media video,\n  .b80-hunt__media picture,\n  .b80-hunt__media img {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .b80-hunt__media video,\n  .b80-hunt__media img {\n    object-fit: cover;\n    object-position: center;\n    filter: grayscale(1) contrast(1.13) brightness(.55);\n    transform: scale(1.045);\n    transition:\n      filter .75s ease,\n      transform 1.1s cubic-bezier(.16, 1, .3, 1);\n    will-change: transform;\n  }\n\n  .b80-hunt__fallback {\n    background:\n      linear-gradient(90deg, transparent 0 49.8%, rgba(255,255,255,.04) 50%, transparent 50.2%),\n      linear-gradient(transparent 0 49.8%, rgba(255,255,255,.04) 50%, transparent 50.2%),\n      radial-gradient(circle at 73% 43%, rgba(255,164,0,.06), transparent 16%),\n      linear-gradient(132deg, #151515 0%, #070707 48%, #11100e 100%);\n  }\n\n  .b80-hunt__fallback::before,\n  .b80-hunt__fallback::after {\n    content: \"\";\n    position: absolute;\n    border: 1px solid rgba(255,255,255,.06);\n    transform: rotate(-17deg);\n  }\n\n  .b80-hunt__fallback::before {\n    top: 8%;\n    right: 8%;\n    width: 44%;\n    height: 72%;\n  }\n\n  .b80-hunt__fallback::after {\n    right: 25%;\n    bottom: -8%;\n    width: 56%;\n    height: 60%;\n  }\n\n  .b80-hunt__shade {\n    z-index: 1;\n    background:\n      linear-gradient(90deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.2) 46%, rgba(0,0,0,.26) 100%),\n      linear-gradient(180deg, rgba(0,0,0,.72) 0%, transparent 25%, transparent 60%, rgba(0,0,0,.84) 100%);\n  }\n\n  .b80-hunt__grain {\n    z-index: 2;\n    opacity: .11;\n    background-image:\n      url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E\");\n    mix-blend-mode: soft-light;\n  }\n\n  .b80-hunt__flash {\n    z-index: 10;\n    background: var(--paper);\n    opacity: 0;\n  }\n\n  .b80-hunt.is-found .b80-hunt__flash {\n    animation: b80-hunt-flash .42s ease forwards;\n  }\n\n  .b80-hunt.is-found .b80-hunt__media video,\n  .b80-hunt.is-found .b80-hunt__media img {\n    filter: grayscale(1) contrast(1.22) brightness(.34);\n    transform: scale(1.075);\n  }\n\n  .b80-hunt__chrome {\n    position: absolute;\n    z-index: 7;\n    top: clamp(24px, 3.4vw, 52px);\n    right: clamp(24px, 3.4vw, 52px);\n    left: clamp(24px, 3.4vw, 52px);\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    pointer-events: none;\n  }\n\n  .b80-hunt__brand {\n    display: grid;\n    gap: 8px;\n  }\n\n  .b80-hunt__brand strong {\n    font-size: 11px;\n    font-weight: 850;\n    line-height: 1;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__brand span,\n  .b80-hunt__code {\n    color: rgba(242,239,231,.44);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__instruction {\n    position: absolute;\n    z-index: 7;\n    bottom: clamp(30px, 4vw, 58px);\n    left: clamp(24px, 3.4vw, 52px);\n    max-width: 430px;\n    pointer-events: none;\n  }\n\n  .b80-hunt__instruction-index {\n    display: block;\n    margin-bottom: 15px;\n    color: var(--orange);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .18em;\n  }\n\n  .b80-hunt__instruction h1 {\n    max-width: 430px;\n    margin: 0;\n    font-family: Figtree, var(--font-heading-family), Arial, sans-serif;\n    font-size: clamp(40px, 4.6vw, 76px);\n    font-weight: 850;\n    line-height: .92;\n    letter-spacing: -.055em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__instruction p {\n    margin: 17px 0 0;\n    color: rgba(242,239,231,.55);\n    font-size: 10px;\n    font-weight: 650;\n    line-height: 1.5;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__skip {\n    position: absolute;\n    z-index: 12;\n    right: clamp(24px, 3.4vw, 52px);\n    bottom: clamp(30px, 4vw, 58px);\n    padding: 7px 0;\n    border: 0;\n    border-bottom: 1px solid rgba(242,239,231,.28);\n    border-radius: 0;\n    color: rgba(242,239,231,.52);\n    background: transparent;\n    font: inherit;\n    font-size: 8px;\n    font-weight: 750;\n    line-height: 1;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: color .24s ease, border-color .24s ease;\n  }\n\n  .b80-hunt__skip:hover {\n    color: var(--paper);\n    border-color: var(--orange);\n  }\n\n  /* Hidden product target */\n\n  .b80-hunt__target {\n    position: absolute;\n    z-index: 5;\n    top: var(--target-y);\n    left: var(--target-x);\n    width: clamp(54px, 5vw, 82px);\n    height: clamp(168px, 19vh, 242px);\n    transform: translate(-50%, -50%) rotate(-8deg);\n    opacity: .14;\n    filter: grayscale(1) brightness(.5);\n    pointer-events: none;\n    transition:\n      opacity .28s ease,\n      filter .28s ease,\n      transform .38s cubic-bezier(.16, 1, .3, 1);\n  }\n\n  .b80-hunt.is-near .b80-hunt__target {\n    opacity: .48;\n    filter: grayscale(.5) brightness(.8);\n  }\n\n  .b80-hunt.is-found .b80-hunt__target {\n    opacity: 1;\n    filter:\n      grayscale(0)\n      brightness(1)\n      drop-shadow(0 0 18px rgba(255,164,0,.26));\n    transform: translate(-50%, -50%) rotate(-8deg) scale(1.12);\n  }\n\n  .b80-racket-art {\n    position: relative;\n    display: grid;\n    place-items: center;\n    width: 100%;\n    height: 100%;\n  }\n\n  .b80-racket-art img,\n  .b80-racket-art svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n\n  .b80-racket-art svg {\n    overflow: visible;\n  }\n\n  /* Precision sight */\n\n  .b80-sight {\n    --sight-size: clamp(82px, 7vw, 116px);\n\n    position: absolute;\n    z-index: 9;\n    top: 0;\n    left: 0;\n    width: var(--sight-size);\n    height: var(--sight-size);\n    transform: translate3d(\n      calc(var(--sight-size) * -.5),\n      calc(var(--sight-size) * -.5),\n      0\n    );\n    pointer-events: none;\n    will-change: transform;\n  }\n\n  .b80-sight__axis {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    opacity: .64;\n    transition: opacity .2s ease;\n  }\n\n  .b80-sight__axis--x {\n    width: 220vw;\n    height: 1px;\n    transform: translate(-50%, -50%);\n    background:\n      repeating-linear-gradient(\n        90deg,\n        rgba(255,255,255,.58) 0 10px,\n        transparent 10px 21px\n      );\n  }\n\n  .b80-sight__axis--y {\n    width: 1px;\n    height: 220vh;\n    transform: translate(-50%, -50%);\n    background:\n      repeating-linear-gradient(\n        180deg,\n        rgba(255,255,255,.58) 0 10px,\n        transparent 10px 21px\n      );\n  }\n\n  .b80-sight__core {\n    position: absolute;\n    inset: 0;\n    border: 1px solid rgba(255,255,255,.34);\n    border-radius: 50%;\n    transform: scale(.88);\n    transition:\n      border-color .24s ease,\n      transform .32s cubic-bezier(.16, 1, .3, 1),\n      background .24s ease;\n  }\n\n  .b80-sight__core::before,\n  .b80-sight__core::after {\n    content: \"\";\n    position: absolute;\n    background: var(--paper);\n  }\n\n  .b80-sight__core::before {\n    top: 50%;\n    left: -10px;\n    right: -10px;\n    height: 1px;\n    transform: translateY(-50%);\n  }\n\n  .b80-sight__core::after {\n    top: -10px;\n    bottom: -10px;\n    left: 50%;\n    width: 1px;\n    transform: translateX(-50%);\n  }\n\n  .b80-sight__diamond {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 11px;\n    height: 11px;\n    border: 2px solid var(--paper);\n    background: var(--orange);\n    transform: translate(-50%, -50%) rotate(45deg);\n    box-shadow: 0 0 0 3px rgba(0,0,0,.58);\n  }\n\n  .b80-sight__progress {\n    position: absolute;\n    inset: -8px;\n    width: calc(100% + 16px);\n    height: calc(100% + 16px);\n    transform: rotate(-90deg);\n    overflow: visible;\n  }\n\n  .b80-sight__progress circle {\n    fill: none;\n    stroke: var(--orange);\n    stroke-width: 1.5;\n    stroke-linecap: square;\n    stroke-dasharray: 226;\n    stroke-dashoffset: 226;\n  }\n\n  .b80-sight__readout {\n    position: absolute;\n    top: calc(100% + 15px);\n    left: 50%;\n    min-width: 150px;\n    color: rgba(242,239,231,.52);\n    font-size: 7px;\n    font-weight: 750;\n    line-height: 1;\n    letter-spacing: .19em;\n    text-align: center;\n    text-transform: uppercase;\n    transform: translateX(-50%);\n    white-space: nowrap;\n  }\n\n  .b80-hunt.is-near .b80-sight__axis {\n    opacity: .84;\n  }\n\n  .b80-hunt.is-near .b80-sight__core {\n    border-color: rgba(255,164,0,.76);\n    transform: scale(.72);\n  }\n\n  .b80-hunt.is-found .b80-sight__axis--x,\n  .b80-hunt.is-found .b80-sight__axis--y {\n    background: var(--orange);\n    opacity: .8;\n  }\n\n  .b80-hunt.is-found .b80-sight__core {\n    border-color: var(--orange);\n    background: rgba(255,164,0,.06);\n    transform: scale(.58);\n    animation: b80-sight-lock .42s cubic-bezier(.16, 1, .3, 1) 2;\n  }\n\n  .b80-hunt.is-found .b80-sight__readout {\n    color: var(--orange);\n  }\n\n  .b80-hunt__acquired {\n    position: absolute;\n    z-index: 11;\n    top: var(--target-y);\n    left: var(--target-x);\n    width: clamp(220px, 24vw, 360px);\n    padding-top: 16px;\n    border-top: 1px solid var(--orange);\n    color: var(--paper);\n    opacity: 0;\n    transform: translate(-50%, calc(-50% + 105px));\n    pointer-events: none;\n  }\n\n  .b80-hunt__acquired strong,\n  .b80-hunt__acquired span {\n    display: block;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__acquired strong {\n    font-size: clamp(15px, 1.4vw, 21px);\n    font-weight: 850;\n    line-height: 1;\n    letter-spacing: -.02em;\n  }\n\n  .b80-hunt__acquired span {\n    margin-top: 8px;\n    color: rgba(242,239,231,.5);\n    font-size: 7px;\n    font-weight: 700;\n    letter-spacing: .2em;\n  }\n\n  .b80-hunt.is-found .b80-hunt__acquired {\n    animation: b80-acquired-in .48s cubic-bezier(.16, 1, .3, 1) .12s forwards;\n  }\n\n  /* Moving clone between sections */\n\n  .b80-flight-racket {\n    position: fixed !important;\n    z-index: 2147483000 !important;\n    margin: 0 !important;\n    pointer-events: none !important;\n    transform-origin: center !important;\n    filter:\n      drop-shadow(0 24px 38px rgba(0,0,0,.22))\n      drop-shadow(0 0 22px rgba(255,164,0,.14));\n    will-change: transform, left, top;\n  }\n\n  /* ============================================================\n     SECTION 02 — PRODUCT + SWISS SPECIFICATIONS\n  ============================================================ */\n\n  .b80-object {\n    position: relative;\n    min-height: 780px;\n    height: 100svh;\n    max-height: 1080px;\n    overflow: hidden;\n    isolation: isolate;\n    color: var(--ink);\n    background: var(--paper);\n  }\n\n  .b80-object::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    top: 0;\n    bottom: 0;\n    left: 50%;\n    width: 1px;\n    background: rgba(16,16,16,.1);\n  }\n\n  .b80-object::after {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    top: 50%;\n    right: 0;\n    left: 0;\n    height: 1px;\n    background: rgba(16,16,16,.1);\n  }\n\n  .b80-object__top {\n    position: absolute;\n    z-index: 5;\n    top: clamp(28px, 3.5vw, 54px);\n    right: clamp(24px, 3.5vw, 54px);\n    left: clamp(24px, 3.5vw, 54px);\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n  }\n\n  .b80-object__eyebrow,\n  .b80-object__serial {\n    color: rgba(16,16,16,.48);\n    font-size: 8px;\n    font-weight: 750;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .b80-object__layout {\n    position: relative;\n    z-index: 2;\n    width: min(calc(100% - 72px), 1500px);\n    min-height: 100%;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(220px, 1fr) minmax(320px, 470px) minmax(220px, 1fr);\n    align-items: center;\n    gap: clamp(26px, 4vw, 76px);\n    padding: 110px 0 100px;\n  }\n\n  .b80-object__specs {\n    display: grid;\n    gap: clamp(42px, 6vh, 72px);\n  }\n\n  .b80-object__specs--left {\n    text-align: right;\n  }\n\n  .b80-object__specs--right {\n    text-align: left;\n  }\n\n  .b80-object__spec {\n    position: relative;\n    opacity: 0;\n    transform: translateY(16px);\n  }\n\n  .b80-object.is-revealed .b80-object__spec {\n    animation: b80-spec-in .65s cubic-bezier(.16, 1, .3, 1) forwards;\n  }\n\n  .b80-object.is-revealed .b80-object__spec:nth-child(2) {\n    animation-delay: .12s;\n  }\n\n  .b80-object__spec-index {\n    display: block;\n    margin-bottom: 11px;\n    color: var(--orange);\n    font-size: 8px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: .16em;\n  }\n\n  .b80-object__spec strong {\n    display: block;\n    font-size: clamp(18px, 1.75vw, 27px);\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: -.035em;\n    text-transform: uppercase;\n  }\n\n  .b80-object__spec small {\n    display: block;\n    margin-top: 8px;\n    color: rgba(16,16,16,.52);\n    font-size: 9px;\n    font-weight: 600;\n    line-height: 1.3;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n  }\n\n  .b80-object__spec-line {\n    display: block;\n    width: 68px;\n    height: 1px;\n    margin-top: 15px;\n    background: rgba(16,16,16,.24);\n  }\n\n  .b80-object__specs--left .b80-object__spec-line {\n    margin-left: auto;\n  }\n\n  .b80-object__centre {\n    position: relative;\n    align-self: stretch;\n    display: grid;\n    place-items: center;\n  }\n\n  .b80-object__halo {\n    position: absolute;\n    width: min(33vw, 470px);\n    aspect-ratio: 1;\n    border: 1px solid rgba(16,16,16,.1);\n    border-radius: 50%;\n    opacity: 0;\n    transform: scale(.76);\n  }\n\n  .b80-object.is-revealed .b80-object__halo {\n    animation: b80-halo-in 1s cubic-bezier(.16, 1, .3, 1) .1s forwards;\n  }\n\n  .b80-object__racket {\n    position: relative;\n    z-index: 3;\n    width: min(30vw, 390px);\n    height: min(72vh, 720px);\n    opacity: 1;\n    transform: rotate(-2deg);\n  }\n\n  .b80-object__racket[aria-hidden=\"true\"] {\n    opacity: 0;\n  }\n\n  .b80-object__identity {\n    position: absolute;\n    z-index: 4;\n    bottom: clamp(34px, 4vw, 62px);\n    left: 50%;\n    width: min(calc(100% - 48px), 680px);\n    text-align: center;\n    transform: translateX(-50%);\n  }\n\n  .b80-object__identity h2 {\n    margin: 0;\n    font-size: clamp(31px, 3.4vw, 53px);\n    font-weight: 850;\n    line-height: .95;\n    letter-spacing: -.055em;\n    text-transform: uppercase;\n  }\n\n  .b80-object__identity p {\n    margin: 12px 0 0;\n    color: rgba(16,16,16,.54);\n    font-size: 9px;\n    font-weight: 650;\n    line-height: 1.4;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .b80-object__cta {\n    position: absolute;\n    z-index: 5;\n    right: clamp(24px, 3.5vw, 54px);\n    bottom: clamp(34px, 4vw, 62px);\n    display: inline-flex;\n    align-items: center;\n    gap: 13px;\n    padding-bottom: 8px;\n    border-bottom: 1px solid rgba(16,16,16,.35);\n    color: var(--ink);\n    font-size: 8px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: .17em;\n    text-transform: uppercase;\n    transition: border-color .22s ease;\n  }\n\n  .b80-object__cta:hover {\n    border-color: var(--orange);\n  }\n\n  .b80-object__cta svg {\n    width: 14px;\n    height: 14px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.8;\n    transition: transform .22s ease;\n  }\n\n  .b80-object__cta:hover svg {\n    transform: translateX(4px);\n  }\n\n  @keyframes b80-hunt-flash {\n    0% { opacity: 0; }\n    18% { opacity: .72; }\n    100% { opacity: 0; }\n  }\n\n  @keyframes b80-sight-lock {\n    0% { box-shadow: 0 0 0 0 rgba(255,164,0,.4); }\n    100% { box-shadow: 0 0 0 36px rgba(255,164,0,0); }\n  }\n\n  @keyframes b80-acquired-in {\n    from {\n      opacity: 0;\n      transform: translate(-50%, calc(-50% + 122px));\n    }\n    to {\n      opacity: 1;\n      transform: translate(-50%, calc(-50% + 105px));\n    }\n  }\n\n  @keyframes b80-spec-in {\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes b80-halo-in {\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  @media (max-width: 989px) {\n    .b80-object__layout {\n      width: min(calc(100% - 42px), 900px);\n      grid-template-columns: minmax(170px, 1fr) minmax(270px, 360px) minmax(170px, 1fr);\n      gap: 24px;\n    }\n\n    .b80-object__racket {\n      width: min(36vw, 350px);\n    }\n  }\n\n  @media (max-width: 749px) {\n    .b80-hunt {\n      --target-x: {{ b80_target_x_mobile }}%;\n      --target-y: {{ b80_target_y_mobile }}%;\n    }\n\n    .b80-hunt__hero {\n      min-height: max(760px, 100svh);\n      max-height: none;\n    }\n\n    .b80-hunt__media video,\n    .b80-hunt__media img {\n      object-position: center;\n      filter: grayscale(1) contrast(1.15) brightness(.48);\n    }\n\n    .b80-hunt__chrome {\n      top: 22px;\n      right: 18px;\n      left: 18px;\n    }\n\n    .b80-hunt__brand strong {\n      font-size: 9px;\n    }\n\n    .b80-hunt__brand span,\n    .b80-hunt__code {\n      font-size: 6.5px;\n      letter-spacing: .16em;\n    }\n\n    .b80-hunt__instruction {\n      right: 18px;\n      bottom: 30px;\n      left: 18px;\n      max-width: 330px;\n    }\n\n    .b80-hunt__instruction h1 {\n      max-width: 300px;\n      font-size: clamp(38px, 12vw, 56px);\n    }\n\n    .b80-hunt__instruction p {\n      max-width: 260px;\n      font-size: 8px;\n    }\n\n    .b80-hunt__skip {\n      right: 18px;\n      bottom: 30px;\n      font-size: 7px;\n    }\n\n    .b80-hunt__target {\n      width: 52px;\n      height: 170px;\n    }\n\n    .b80-sight {\n      --sight-size: 82px;\n    }\n\n    .b80-sight__axis--x {\n      width: 250vw;\n    }\n\n    .b80-sight__axis--y {\n      height: 250vh;\n    }\n\n    .b80-hunt__acquired {\n      width: 210px;\n      transform: translate(-50%, calc(-50% + 96px));\n    }\n\n    .b80-hunt.is-found .b80-hunt__acquired {\n      animation-name: b80-acquired-mobile;\n    }\n\n    .b80-object {\n      min-height: 900px;\n      height: auto;\n      max-height: none;\n    }\n\n    .b80-object::before {\n      display: none;\n    }\n\n    .b80-object::after {\n      top: 44%;\n    }\n\n    .b80-object__top {\n      top: 22px;\n      right: 18px;\n      left: 18px;\n    }\n\n    .b80-object__eyebrow,\n    .b80-object__serial {\n      font-size: 6.5px;\n      letter-spacing: .15em;\n    }\n\n    .b80-object__layout {\n      width: calc(100% - 36px);\n      min-height: 900px;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      grid-template-rows: minmax(510px, 58vh) auto;\n      align-items: start;\n      column-gap: 24px;\n      row-gap: 32px;\n      padding: 68px 0 150px;\n    }\n\n    .b80-object__centre {\n      grid-column: 1 / -1;\n      grid-row: 1;\n      align-self: stretch;\n    }\n\n    .b80-object__racket {\n      width: min(68vw, 300px);\n      height: min(55vh, 500px);\n    }\n\n    .b80-object__halo {\n      width: min(84vw, 380px);\n    }\n\n    .b80-object__specs {\n      grid-row: 2;\n      gap: 32px;\n    }\n\n    .b80-object__specs--left {\n      grid-column: 1;\n      text-align: left;\n    }\n\n    .b80-object__specs--right {\n      grid-column: 2;\n      text-align: left;\n    }\n\n    .b80-object__specs--left .b80-object__spec-line {\n      margin-left: 0;\n    }\n\n    .b80-object__spec strong {\n      font-size: 18px;\n    }\n\n    .b80-object__spec small {\n      font-size: 7px;\n      letter-spacing: .1em;\n    }\n\n    .b80-object__spec-line {\n      width: 42px;\n    }\n\n    .b80-object__identity {\n      bottom: 58px;\n    }\n\n    .b80-object__identity h2 {\n      font-size: clamp(28px, 8.5vw, 39px);\n    }\n\n    .b80-object__identity p {\n      font-size: 7px;\n      letter-spacing: .11em;\n    }\n\n    .b80-object__cta {\n      right: 18px;\n      bottom: 24px;\n      font-size: 7px;\n    }\n  }\n\n  @keyframes b80-acquired-mobile {\n    from {\n      opacity: 0;\n      transform: translate(-50%, calc(-50% + 108px));\n    }\n    to {\n      opacity: 1;\n      transform: translate(-50%, calc(-50% + 92px));\n    }\n  }\n\n  @media (pointer: coarse) {\n    .b80-hunt__hero {\n      cursor: default;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .b80-hunt *,\n    .b80-hunt *::before,\n    .b80-hunt *::after {\n      animation-duration: .001ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: .001ms !important;\n    }\n  }\n</style>\n\n<div\n  class=\"b80-hunt\"\n  data-b80-hunt\n  data-target-x-desktop=\"{{ b80_target_x_desktop }}\"\n  data-target-y-desktop=\"{{ b80_target_y_desktop }}\"\n  data-target-x-mobile=\"{{ b80_target_x_mobile }}\"\n  data-target-y-mobile=\"{{ b80_target_y_mobile }}\"\n>\n  <!-- =========================================================\n       SECTION 01 / FIND THE RACKET\n  ========================================================== -->\n  <section\n    class=\"b80-hunt__hero\"\n    data-b80-hunt-hero\n    aria-label=\"Locate the Nitrix Bullet 80\"\n  >\n    {% if b80_video_desktop != blank or b80_video_mobile != blank %}\n      <div class=\"b80-hunt__media\" aria-hidden=\"true\">\n        <video\n          data-b80-hunt-video\n          autoplay\n          muted\n          loop\n          playsinline\n          preload=\"metadata\"\n          {% if b80_background_desktop != blank or b80_background_mobile != blank %}\n            poster=\"{{ b80_background_desktop | default: b80_background_mobile }}\"\n          {% endif %}\n        >\n          {% if b80_video_mobile != blank %}\n            <source\n              media=\"(max-width: 749px)\"\n              src=\"{{ b80_video_mobile }}\"\n              type=\"video/mp4\"\n            >\n          {% endif %}\n\n          <source\n            src=\"{{ b80_video_desktop | default: b80_video_mobile }}\"\n            type=\"video/mp4\"\n          >\n        </video>\n      </div>\n\n    {% elsif b80_background_desktop != blank or b80_background_mobile != blank %}\n      <div class=\"b80-hunt__media\" aria-hidden=\"true\">\n        <picture>\n          {% if b80_background_mobile != blank %}\n            <source\n              media=\"(max-width: 749px)\"\n              srcset=\"{{ b80_background_mobile }}\"\n            >\n          {% endif %}\n\n          <img\n            data-b80-hunt-background\n            src=\"{{ b80_background_desktop | default: b80_background_mobile }}\"\n            alt=\"\"\n            width=\"2400\"\n            height=\"1600\"\n            loading=\"eager\"\n            fetchpriority=\"high\"\n            decoding=\"async\"\n          >\n        </picture>\n      </div>\n\n    {% else %}\n      <div class=\"b80-hunt__fallback\" aria-hidden=\"true\"></div>\n    {% endif %}\n\n    <div class=\"b80-hunt__shade\" aria-hidden=\"true\"></div>\n    <div class=\"b80-hunt__grain\" aria-hidden=\"true\"></div>\n    <div class=\"b80-hunt__flash\" aria-hidden=\"true\"></div>\n\n    <div class=\"b80-hunt__chrome\">\n      <div class=\"b80-hunt__brand\">\n        <strong>Nitrix Bullet 80</strong>\n        <span>Precision attack system</span>\n      </div>\n\n      <span class=\"b80-hunt__code\">\n        Search field / B80\n      </span>\n    </div>\n\n    <div class=\"b80-hunt__instruction\">\n      <span class=\"b80-hunt__instruction-index\">01 / ACQUIRE</span>\n\n      <h1>Find what ends the point.</h1>\n\n      <p data-b80-instruction>\n        Move the sight. Hold to acquire.\n      </p>\n    </div>\n\n    <button\n      class=\"b80-hunt__skip\"\n      type=\"button\"\n      data-b80-skip\n      aria-label=\"Skip the search and reveal Bullet 80\"\n    >\n      Skip search\n    </button>\n\n    <div\n      class=\"b80-hunt__target\"\n      data-b80-target\n      aria-hidden=\"true\"\n    >\n      <div class=\"b80-racket-art\" data-b80-target-art>\n        {% if b80_racket_png != blank %}\n          <img\n            src=\"{{ b80_racket_png }}\"\n            alt=\"\"\n            width=\"500\"\n            height=\"1500\"\n            loading=\"eager\"\n            fetchpriority=\"high\"\n            decoding=\"async\"\n          >\n        {% else %}\n          <!-- Lightweight fallback until the final transparent PNG is added -->\n          <svg viewBox=\"0 0 180 620\" xmlns=\"http://www.w3.org/2000/svg\">\n            <ellipse cx=\"90\" cy=\"112\" rx=\"68\" ry=\"96\" fill=\"none\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n            <ellipse cx=\"90\" cy=\"112\" rx=\"56\" ry=\"83\" fill=\"none\" stroke=\"rgba(255,255,255,.28)\" stroke-width=\"2\"/>\n            <path d=\"M90 207V493\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n            <path d=\"M70 493H110V608H70Z\" fill=\"#111\"/>\n            <path d=\"M76 500L104 600M104 500L76 600\" stroke=\"rgba(255,164,0,.55)\" stroke-width=\"4\"/>\n          </svg>\n        {% endif %}\n      </div>\n    </div>\n\n    <div class=\"b80-sight\" data-b80-sight aria-hidden=\"true\">\n      <span class=\"b80-sight__axis b80-sight__axis--x\"></span>\n      <span class=\"b80-sight__axis b80-sight__axis--y\"></span>\n\n      <span class=\"b80-sight__core\"></span>\n      <span class=\"b80-sight__diamond\"></span>\n\n      <svg class=\"b80-sight__progress\" viewBox=\"0 0 80 80\">\n        <circle\n          data-b80-lock-ring\n          cx=\"40\"\n          cy=\"40\"\n          r=\"36\"\n        />\n      </svg>\n\n      <span class=\"b80-sight__readout\" data-b80-readout>\n        Searching / 00\n      </span>\n    </div>\n\n    <div class=\"b80-hunt__acquired\" aria-hidden=\"true\">\n      <strong>Bullet 80 locked</strong>\n      <span>Object acquired / moving to inspection</span>\n    </div>\n  </section>\n\n  <!-- =========================================================\n       SECTION 02 / CENTRED PRODUCT + MINIMAL SPECIFICATIONS\n  ========================================================== -->\n  <section\n    class=\"b80-object\"\n    id=\"b80-object-{{ section.id }}\"\n    data-b80-object\n    aria-labelledby=\"b80-object-title-{{ section.id }}\"\n  >\n    <div class=\"b80-object__top\">\n      <span class=\"b80-object__eyebrow\">\n        02 / THE OBJECT\n      </span>\n\n      <span class=\"b80-object__serial\">\n        B80 / Professional attack\n      </span>\n    </div>\n\n    <div class=\"b80-object__layout\">\n      <div class=\"b80-object__specs b80-object__specs--left\">\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">01</span>\n          <strong>5.8 mm</strong>\n          <small>Thin shaft profile</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">02</span>\n          <strong>Attack</strong>\n          <small>Playing intention</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n      </div>\n\n      <div class=\"b80-object__centre\">\n        <span class=\"b80-object__halo\" aria-hidden=\"true\"></span>\n\n        <div\n          class=\"b80-object__racket b80-racket-art\"\n          data-b80-destination-art\n        >\n          {% if b80_racket_png != blank %}\n            <img\n              src=\"{{ b80_racket_png }}\"\n              alt=\"Nitrix Bullet 80 badminton racket\"\n              width=\"700\"\n              height=\"1900\"\n              loading=\"eager\"\n              decoding=\"async\"\n            >\n          {% else %}\n            <svg\n              viewBox=\"0 0 180 620\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              role=\"img\"\n              aria-label=\"Nitrix Bullet 80 racket placeholder\"\n            >\n              <ellipse cx=\"90\" cy=\"112\" rx=\"68\" ry=\"96\" fill=\"none\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n              <ellipse cx=\"90\" cy=\"112\" rx=\"56\" ry=\"83\" fill=\"none\" stroke=\"rgba(16,16,16,.18)\" stroke-width=\"2\"/>\n              <path d=\"M90 207V493\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n              <path d=\"M70 493H110V608H70Z\" fill=\"#111\"/>\n              <path d=\"M76 500L104 600M104 500L76 600\" stroke=\"rgba(255,164,0,.55)\" stroke-width=\"4\"/>\n            </svg>\n          {% endif %}\n        </div>\n      </div>\n\n      <div class=\"b80-object__specs b80-object__specs--right\">\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">03</span>\n          <strong>Professional</strong>\n          <small>Player level</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">04</span>\n          <strong>B80</strong>\n          <small>Nitrix performance code</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"b80-object__identity\">\n      <h2 id=\"b80-object-title-{{ section.id }}\">\n        Built to end the point.\n      </h2>\n\n      <p>\n        Nitrix Bullet 80 / Thin shaft / Professional attack\n      </p>\n    </div>\n\n    <a class=\"b80-object__cta\" href=\"{{ b80_product_url }}\">\n      <span>Choose Bullet 80</span>\n\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M5 12h13\"></path>\n        <path d=\"m13 6 6 6-6 6\"></path>\n      </svg>\n    </a>\n  </section>\n</div>\n\n<script>\n  (function () {\n    function initB80Hunt(scope) {\n      var roots = (scope || document).querySelectorAll(\n        '[data-b80-hunt]:not([data-b80-hunt-ready])'\n      );\n\n      roots.forEach(function (root) {\n        root.setAttribute('data-b80-hunt-ready', 'true');\n\n        var hero = root.querySelector('[data-b80-hunt-hero]');\n        var sight = root.querySelector('[data-b80-sight]');\n        var target = root.querySelector('[data-b80-target]');\n        var targetArt = root.querySelector('[data-b80-target-art]');\n        var destination = root.querySelector('[data-b80-destination-art]');\n        var objectSection = root.querySelector('[data-b80-object]');\n        var ring = root.querySelector('[data-b80-lock-ring]');\n        var readout = root.querySelector('[data-b80-readout]');\n        var instruction = root.querySelector('[data-b80-instruction]');\n        var skip = root.querySelector('[data-b80-skip]');\n        var media = root.querySelector(\n          '[data-b80-hunt-background], [data-b80-hunt-video]'\n        );\n\n        if (\n          !hero ||\n          !sight ||\n          !target ||\n          !targetArt ||\n          !destination ||\n          !objectSection\n        ) {\n          return;\n        }\n\n        var reducedMotion = window.matchMedia(\n          '(prefers-reduced-motion: reduce)'\n        ).matches;\n\n        var coarsePointer = window.matchMedia(\n          '(pointer: coarse)'\n        ).matches;\n\n        var state = {\n          x: hero.clientWidth * 0.5,\n          y: hero.clientHeight * 0.5,\n          targetX: hero.clientWidth * 0.5,\n          targetY: hero.clientHeight * 0.5,\n          previousTime: performance.now(),\n          focusTime: 0,\n          requiredFocus: coarsePointer ? 470 : 620,\n          radius: coarsePointer ? 74 : 48,\n          found: false,\n          dragging: false,\n          transitionStarted: false\n        };\n\n        if (instruction && coarsePointer) {\n          instruction.textContent =\n            'Drag the sight. Hold to acquire.';\n        }\n\n        function clamp(value, min, max) {\n          return Math.max(min, Math.min(max, value));\n        }\n\n        function easeInOutCubic(value) {\n          return value < 0.5\n            ? 4 * value * value * value\n            : 1 - Math.pow(-2 * value + 2, 3) / 2;\n        }\n\n        function setDesiredPoint(clientX, clientY) {\n          if (state.found) {\n            return;\n          }\n\n          var rect = hero.getBoundingClientRect();\n\n          state.targetX = clamp(\n            clientX - rect.left,\n            0,\n            rect.width\n          );\n\n          state.targetY = clamp(\n            clientY - rect.top,\n            0,\n            rect.height\n          );\n        }\n\n        function getTargetPoint() {\n          var heroRect = hero.getBoundingClientRect();\n          var targetRect = target.getBoundingClientRect();\n\n          return {\n            x:\n              targetRect.left -\n              heroRect.left +\n              targetRect.width / 2,\n            y:\n              targetRect.top -\n              heroRect.top +\n              targetRect.height / 2\n          };\n        }\n\n        function setRingProgress(progress) {\n          var normalised = clamp(progress, 0, 1);\n          var dashOffset = 226 - (226 * normalised);\n\n          if (ring) {\n            ring.style.strokeDashoffset =\n              dashOffset.toFixed(2);\n          }\n\n          if (readout && !state.found) {\n            readout.textContent =\n              normalised > 0\n                ? 'Acquiring / ' +\n                  String(Math.round(normalised * 100))\n                    .padStart(2, '0')\n                : 'Searching / 00';\n          }\n        }\n\n        function updateSight(time) {\n          var dt = Math.min(\n            40,\n            Math.max(0, time - state.previousTime)\n          );\n\n          state.previousTime = time;\n\n          var easing = reducedMotion ? 1 : 0.17;\n\n          state.x += (state.targetX - state.x) * easing;\n          state.y += (state.targetY - state.y) * easing;\n\n          sight.style.transform =\n            'translate3d(' +\n            (state.x - sight.offsetWidth / 2) +\n            'px,' +\n            (state.y - sight.offsetHeight / 2) +\n            'px,0)';\n\n          if (media && !state.found && !coarsePointer) {\n            var px =\n              (state.x / Math.max(1, hero.clientWidth) - 0.5) *\n              -10;\n\n            var py =\n              (state.y / Math.max(1, hero.clientHeight) - 0.5) *\n              -7;\n\n            media.style.transform =\n              'scale(1.055) translate3d(' +\n              px.toFixed(2) +\n              'px,' +\n              py.toFixed(2) +\n              'px,0)';\n          }\n\n          if (!state.found) {\n            var targetPoint = getTargetPoint();\n            var dx = state.x - targetPoint.x;\n            var dy = state.y - targetPoint.y;\n            var distance = Math.sqrt(dx * dx + dy * dy);\n            var isNear = distance <= state.radius;\n\n            root.classList.toggle('is-near', isNear);\n\n            if (isNear) {\n              state.focusTime += dt;\n            } else {\n              state.focusTime = Math.max(\n                0,\n                state.focusTime - dt * 2.25\n              );\n            }\n\n            var progress =\n              state.focusTime / state.requiredFocus;\n\n            setRingProgress(progress);\n\n            if (progress >= 1) {\n              acquireTarget();\n            }\n          }\n\n          requestAnimationFrame(updateSight);\n        }\n\n        function acquireTarget() {\n          if (state.found) {\n            return;\n          }\n\n          state.found = true;\n\n          var targetPoint = getTargetPoint();\n\n          state.targetX = targetPoint.x;\n          state.targetY = targetPoint.y;\n\n          root.classList.remove('is-near');\n          root.classList.add('is-found');\n\n          setRingProgress(1);\n\n          if (readout) {\n            readout.textContent = 'Bullet 80 / Locked';\n          }\n\n          window.setTimeout(\n            moveRacketToSection,\n            reducedMotion ? 140 : 900\n          );\n        }\n\n        function moveRacketToSection() {\n          if (state.transitionStarted) {\n            return;\n          }\n\n          state.transitionStarted = true;\n\n          if (reducedMotion) {\n            objectSection.scrollIntoView({\n              behavior: 'auto',\n              block: 'start'\n            });\n\n            destination.removeAttribute('aria-hidden');\n            objectSection.classList.add('is-revealed');\n            return;\n          }\n\n          var startRect = targetArt.getBoundingClientRect();\n          var clone = targetArt.cloneNode(true);\n\n          clone.classList.add('b80-flight-racket');\n\n          clone.style.left = startRect.left + 'px';\n          clone.style.top = startRect.top + 'px';\n          clone.style.width = startRect.width + 'px';\n          clone.style.height = startRect.height + 'px';\n\n          document.body.appendChild(clone);\n\n          targetArt.style.opacity = '0';\n          destination.setAttribute('aria-hidden', 'true');\n\n          var viewportWidth = window.innerWidth;\n          var viewportHeight = window.innerHeight;\n\n          var desiredHeight = Math.min(\n            viewportHeight * (viewportWidth < 750 ? 0.55 : 0.72),\n            viewportWidth < 750 ? 500 : 720\n          );\n\n          var scale = desiredHeight / Math.max(1, startRect.height);\n\n          var startCenterX =\n            startRect.left + startRect.width / 2;\n\n          var startCenterY =\n            startRect.top + startRect.height / 2;\n\n          var endCenterX = viewportWidth / 2;\n          var endCenterY = viewportHeight / 2;\n\n          var moveX = endCenterX - startCenterX;\n          var moveY = endCenterY - startCenterY;\n\n          var startScroll = window.scrollY;\n          var targetScroll =\n            objectSection.getBoundingClientRect().top +\n            window.scrollY;\n\n          var duration = 1250;\n          var startedAt = performance.now();\n\n          function animateTransition(now) {\n            var elapsed = now - startedAt;\n            var rawProgress = clamp(\n              elapsed / duration,\n              0,\n              1\n            );\n\n            var progress = easeInOutCubic(rawProgress);\n\n            window.scrollTo(\n              0,\n              startScroll +\n                (targetScroll - startScroll) * progress\n            );\n\n            clone.style.transform =\n              'translate3d(' +\n              (moveX * progress).toFixed(2) +\n              'px,' +\n              (moveY * progress).toFixed(2) +\n              'px,0) ' +\n              'scale(' +\n              (1 + (scale - 1) * progress).toFixed(4) +\n              ') ' +\n              'rotate(' +\n              (-2 * progress).toFixed(2) +\n              'deg)';\n\n            clone.style.opacity =\n              String(1 - Math.max(0, rawProgress - .91) / .09);\n\n            if (rawProgress < 1) {\n              requestAnimationFrame(animateTransition);\n              return;\n            }\n\n            destination.removeAttribute('aria-hidden');\n            objectSection.classList.add('is-revealed');\n            clone.remove();\n\n            window.setTimeout(function () {\n              targetArt.style.opacity = '';\n            }, 150);\n          }\n\n          requestAnimationFrame(animateTransition);\n        }\n\n        hero.addEventListener(\n          'pointermove',\n          function (event) {\n            if (\n              event.pointerType === 'touch' &&\n              !state.dragging\n            ) {\n              return;\n            }\n\n            setDesiredPoint(\n              event.clientX,\n              event.clientY\n            );\n          },\n          { passive: true }\n        );\n\n        hero.addEventListener(\n          'pointerdown',\n          function (event) {\n            if (state.found) {\n              return;\n            }\n\n            state.dragging = true;\n\n            if (hero.setPointerCapture) {\n              try {\n                hero.setPointerCapture(event.pointerId);\n              } catch (error) {}\n            }\n\n            setDesiredPoint(\n              event.clientX,\n              event.clientY\n            );\n          }\n        );\n\n        hero.addEventListener(\n          'pointerup',\n          function () {\n            state.dragging = false;\n          }\n        );\n\n        hero.addEventListener(\n          'pointercancel',\n          function () {\n            state.dragging = false;\n          }\n        );\n\n        hero.addEventListener(\n          'keydown',\n          function (event) {\n            if (state.found) {\n              return;\n            }\n\n            var amount = event.shiftKey ? 42 : 18;\n            var handled = true;\n\n            if (event.key === 'ArrowLeft') {\n              state.targetX -= amount;\n            } else if (event.key === 'ArrowRight') {\n              state.targetX += amount;\n            } else if (event.key === 'ArrowUp') {\n              state.targetY -= amount;\n            } else if (event.key === 'ArrowDown') {\n              state.targetY += amount;\n            } else {\n              handled = false;\n            }\n\n            if (handled) {\n              event.preventDefault();\n\n              state.targetX = clamp(\n                state.targetX,\n                0,\n                hero.clientWidth\n              );\n\n              state.targetY = clamp(\n                state.targetY,\n                0,\n                hero.clientHeight\n              );\n            }\n          }\n        );\n\n        hero.setAttribute('tabindex', '0');\n\n        if (skip) {\n          skip.addEventListener('click', acquireTarget);\n        }\n\n        window.addEventListener(\n          'resize',\n          function () {\n            if (state.found) {\n              return;\n            }\n\n            state.x = clamp(\n              state.x,\n              0,\n              hero.clientWidth\n            );\n\n            state.y = clamp(\n              state.y,\n              0,\n              hero.clientHeight\n            );\n\n            state.targetX = clamp(\n              state.targetX,\n              0,\n              hero.clientWidth\n            );\n\n            state.targetY = clamp(\n              state.targetY,\n              0,\n              hero.clientHeight\n            );\n          },\n          { passive: true }\n        );\n\n        var video = root.querySelector('[data-b80-hunt-video]');\n\n        if (video) {\n          var playPromise = video.play();\n\n          if (\n            playPromise &&\n            typeof playPromise.catch === 'function'\n          ) {\n            playPromise.catch(function () {});\n          }\n        }\n\n        requestAnimationFrame(updateSight);\n      });\n    }\n\n    initB80Hunt(document);\n\n    if (!window.__b80HuntBound) {\n      window.__b80HuntBound = true;\n\n      document.addEventListener(\n        'shopify:section:load',\n        function (event) {\n          initB80Hunt(event.target);\n        }\n      );\n    }\n  })();\n</script>",
