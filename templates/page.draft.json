        "custom_liquid": "<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #000 !important;\n  }\n\n  .pred-reveal-hero {\n    position: relative;\n    width: 100vw;\n    min-height: 100vh;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    background: #000;\n    color: #fff;\n    overflow: hidden;\n    isolation: isolate;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  .pred-reveal-hero::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(circle at 50% 36%, rgba(82,255,143,0.18), transparent 28%),\n      radial-gradient(circle at 50% 66%, rgba(0,100,48,0.26), transparent 44%),\n      linear-gradient(180deg, #000 0%, #020805 55%, #000 100%);\n    z-index: -5;\n  }\n\n  .pred-reveal-hero::after {\n    content: \"PREDATOR\";\n    position: absolute;\n    left: 50%;\n    top: 42%;\n    transform: translate(-50%, -50%);\n    font-family: Impact, \"Arial Black\", sans-serif;\n    font-size: clamp(120px, 22vw, 360px);\n    letter-spacing: 9px;\n    color: transparent;\n    -webkit-text-stroke: 1px rgba(82,255,143,0.075);\n    text-stroke: 1px rgba(82,255,143,0.075);\n    white-space: nowrap;\n    z-index: -4;\n  }\n\n  .pred-reveal-hero__stage {\n    position: absolute;\n    inset: 0;\n    perspective: 1200px;\n    transform-style: preserve-3d;\n    z-index: 2;\n  }\n\n  .pred-reveal-hero__product {\n    position: absolute;\n    left: 50%;\n    top: 40%;\n    width: min(66vw, 920px);\n    max-height: 76vh;\n    object-fit: contain;\n    transform-origin: center;\n    filter:\n      drop-shadow(0 0 38px rgba(82,255,143,0.34))\n      drop-shadow(0 44px 120px rgba(0,0,0,1));\n    will-change: transform, opacity, filter;\n  }\n\n  .pred-reveal-hero__product--entry {\n    z-index: 3;\n    opacity: 0;\n    animation: pred-racket-entry 2.2s cubic-bezier(.12,.82,.16,1) forwards;\n  }\n\n  .pred-reveal-hero__product--final {\n    z-index: 4;\n    opacity: 0;\n    animation:\n      pred-racket-final 2.2s cubic-bezier(.12,.82,.16,1) forwards,\n      pred-racket-breathe 5.5s ease-in-out 2.2s infinite;\n  }\n\n  .pred-reveal-hero__strike {\n    position: absolute;\n    left: 50%;\n    top: 40%;\n    width: 110vw;\n    height: 3px;\n    transform: translate(-50%, -50%) rotate(-18deg) scaleX(0);\n    background: linear-gradient(90deg, transparent, rgba(82,255,143,0.95), transparent);\n    box-shadow: 0 0 38px rgba(82,255,143,0.85);\n    opacity: 0;\n    z-index: 1;\n    animation: pred-strike-line 2.15s ease-out forwards;\n  }\n\n  .pred-reveal-hero__slashes {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: -1;\n  }\n\n  .pred-reveal-hero__slashes span {\n    position: absolute;\n    width: 4px;\n    height: 650px;\n    background: linear-gradient(180deg, transparent, #52ff8f, transparent);\n    box-shadow: 0 0 34px rgba(82,255,143,0.72);\n    transform: rotate(28deg);\n    opacity: 0.38;\n    animation: pred-slash-pulse 3.8s ease-in-out infinite;\n  }\n\n  .pred-reveal-hero__slashes span:nth-child(1) {\n    left: 13%;\n    top: -20%;\n  }\n\n  .pred-reveal-hero__slashes span:nth-child(2) {\n    right: 13%;\n    top: -15%;\n    animation-delay: 0.8s;\n  }\n\n  .pred-reveal-hero__slashes span:nth-child(3) {\n    right: 30%;\n    bottom: -30%;\n    opacity: 0.22;\n    animation-delay: 1.4s;\n  }\n\n  .pred-reveal-hero__copy {\n    position: absolute;\n    left: clamp(24px, 6vw, 110px);\n    bottom: clamp(38px, 8vh, 88px);\n    z-index: 8;\n    opacity: 0;\n    transform: translateY(18px);\n    animation: pred-copy-in 0.9s ease-out 1.65s forwards;\n  }\n\n  .pred-reveal-hero__series {\n    margin: 0 0 10px;\n    font-size: clamp(22px, 2.1vw, 34px);\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: -0.6px;\n  }\n\n  .pred-reveal-hero__headline {\n    margin: 0;\n    font-size: clamp(46px, 5.9vw, 94px);\n    line-height: 0.9;\n    font-weight: 900;\n    letter-spacing: -2.5px;\n    color: #52ff8f;\n    text-shadow: 0 0 30px rgba(82,255,143,0.32);\n  }\n\n  .pred-reveal-hero__sub {\n    margin: 14px 0 0;\n    font-size: clamp(18px, 2vw, 30px);\n    line-height: 1.08;\n    font-weight: 800;\n    color: rgba(255,255,255,0.92);\n    letter-spacing: -0.8px;\n  }\n\n  .pred-reveal-hero__buy {\n    position: absolute;\n    right: clamp(20px, 5vw, 90px);\n    bottom: clamp(32px, 7vh, 72px);\n    z-index: 9;\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    padding: 13px 14px 13px 24px;\n    border-radius: 999px;\n    background: rgba(46,46,49,0.92);\n    backdrop-filter: blur(18px);\n    box-shadow: 0 18px 70px rgba(0,0,0,0.55);\n    opacity: 0;\n    transform: translateY(18px);\n    animation: pred-copy-in 0.9s ease-out 1.85s forwards;\n  }\n\n  .pred-reveal-hero__price {\n    font-size: 15px;\n    line-height: 1.25;\n    font-weight: 800;\n    color: rgba(255,255,255,0.9);\n    white-space: nowrap;\n  }\n\n  .pred-reveal-hero__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 72px;\n    height: 48px;\n    padding: 0 22px;\n    border-radius: 999px;\n    background: #52ff8f;\n    color: #020403;\n    text-decoration: none;\n    font-size: 15px;\n    font-weight: 900;\n    transition: 0.2s ease;\n  }\n\n  .pred-reveal-hero__btn:hover {\n    transform: scale(1.04);\n    color: #020403;\n    box-shadow: 0 0 34px rgba(82,255,143,0.65);\n  }\n\n  @keyframes pred-racket-entry {\n    0% {\n      opacity: 0;\n      transform: translate(-50%, -50%) translateZ(520px) scale(3.4) rotateZ(-24deg) rotateY(18deg);\n      filter:\n        blur(22px)\n        drop-shadow(0 0 90px rgba(82,255,143,0.7))\n        drop-shadow(0 70px 160px rgba(0,0,0,1));\n    }\n\n    18% {\n      opacity: 1;\n    }\n\n    48% {\n      opacity: 1;\n      transform: translate(-50%, -50%) translateZ(140px) scale(1.7) rotateZ(-12deg) rotateY(8deg);\n      filter:\n        blur(7px)\n        drop-shadow(0 0 70px rgba(82,255,143,0.55))\n        drop-shadow(0 58px 140px rgba(0,0,0,1));\n    }\n\n    76% {\n      opacity: 0.45;\n      transform: translate(-50%, -50%) translateZ(0) scale(1.05) rotateZ(-2deg) rotateY(0deg);\n      filter:\n        blur(0)\n        drop-shadow(0 0 42px rgba(82,255,143,0.38))\n        drop-shadow(0 44px 120px rgba(0,0,0,1));\n    }\n\n    100% {\n      opacity: 0;\n      transform: translate(-50%, -50%) translateZ(0) scale(1) rotateZ(0deg) rotateY(0deg);\n    }\n  }\n\n  @keyframes pred-racket-final {\n    0%, 52% {\n      opacity: 0;\n      transform: translate(-50%, -50%) scale(1.18) rotateZ(-4deg);\n      filter:\n        blur(5px)\n        drop-shadow(0 0 62px rgba(82,255,143,0.5))\n        drop-shadow(0 52px 130px rgba(0,0,0,1));\n    }\n\n    74% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(0.96) rotateZ(1deg);\n      filter:\n        blur(0)\n        drop-shadow(0 0 36px rgba(82,255,143,0.36))\n        drop-shadow(0 42px 115px rgba(0,0,0,1));\n    }\n\n    100% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1) rotateZ(0deg);\n      filter:\n        blur(0)\n        drop-shadow(0 0 34px rgba(82,255,143,0.34))\n        drop-shadow(0 42px 115px rgba(0,0,0,1));\n    }\n  }\n\n  @keyframes pred-racket-breathe {\n    0%, 100% {\n      transform: translate(-50%, -50%) scale(1) rotateZ(0deg);\n    }\n\n    50% {\n      transform: translate(-50%, -51.5%) scale(1.018) rotateZ(0.7deg);\n    }\n  }\n\n  @keyframes pred-strike-line {\n    0%, 18% {\n      opacity: 0;\n      transform: translate(-58%, -50%) rotate(-18deg) scaleX(0);\n    }\n\n    42% {\n      opacity: 1;\n      transform: translate(-50%, -50%) rotate(-18deg) scaleX(1);\n    }\n\n    78%, 100% {\n      opacity: 0;\n      transform: translate(-42%, -50%) rotate(-18deg) scaleX(0.25);\n    }\n  }\n\n  @keyframes pred-copy-in {\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes pred-slash-pulse {\n    0%, 100% { opacity: 0.25; }\n    50% { opacity: 0.62; }\n  }\n\n  @media (max-width: 768px) {\n    .pred-reveal-hero {\n      min-height: 100svh;\n    }\n\n    .pred-reveal-hero__product {\n      width: 112vw;\n      top: 35%;\n    }\n\n    .pred-reveal-hero__strike {\n      top: 35%;\n      width: 130vw;\n    }\n\n    .pred-reveal-hero__copy {\n      left: 22px;\n      right: 22px;\n      bottom: 132px;\n    }\n\n    .pred-reveal-hero__headline {\n      font-size: clamp(46px, 15vw, 74px);\n      letter-spacing: -1.7px;\n    }\n\n    .pred-reveal-hero__sub {\n      font-size: 21px;\n    }\n\n    .pred-reveal-hero__buy {\n      left: 18px;\n      right: 18px;\n      bottom: 28px;\n      justify-content: space-between;\n    }\n\n    .pred-reveal-hero__price {\n      font-size: 13px;\n    }\n\n    .pred-reveal-hero__btn {\n      min-width: 64px;\n      height: 44px;\n      font-size: 14px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pred-reveal-hero__product,\n    .pred-reveal-hero__strike,\n    .pred-reveal-hero__slashes span,\n    .pred-reveal-hero__copy,\n    .pred-reveal-hero__buy {\n      animation: none !important;\n      opacity: 1;\n    }\n\n    .pred-reveal-hero__product--entry {\n      display: none;\n    }\n\n    .pred-reveal-hero__product--final {\n      transform: translate(-50%, -50%) scale(1) rotateZ(0deg);\n      filter:\n        blur(0)\n        drop-shadow(0 0 34px rgba(82,255,143,0.34))\n        drop-shadow(0 42px 115px rgba(0,0,0,1));\n    }\n  }\n</style>\n\n<section class=\"pred-reveal-hero\" aria-label=\"Predator Series\">\n  <div class=\"pred-reveal-hero__slashes\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"pred-reveal-hero__strike\" aria-hidden=\"true\"></div>\n\n  <div class=\"pred-reveal-hero__stage\">\n    <img\n      class=\"pred-reveal-hero__product pred-reveal-hero__product--entry\"\n      src=\"https://cdn.shopify.com/s/files/1/0933/9