      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"main-sec-custom4\">\n  <h1 class=\"title4\">\n    This Is Where Rallies Stop Being Polite\n  </h1>\n\n  <a href=\"/collections/predator\" class=\"cta4\">\n    <span>Meet the Predators</span>\n  </a>\n</section>\n\n<style>\n  .main-sec-custom4 {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    text-align: center;\n    margin: 0 10px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .main-sec-custom4 img {\n    position: relative;\n    z-index: 1;\n  }\n\n  .main-sec-custom4 video {\n    position: absolute;\n    transform: rotate(180deg);\n    margin-top: 60%;\n    left: 0;\n    width: 100%;\n    height: 15%;\n    object-fit: cover;\n    z-index: 0;\n    overflow: hidden;\n  }\n\n  .title4 {\n    margin: 0;\n    font-weight: 900;\n    letter-spacing: -1px;\n    font-size: 2.4rem;\n    line-height: 1.02;\n    max-width: 900px;\n    z-index: 1;\n\n    background-image: linear-gradient(\n      90deg,\n      #ffffff 0%,\n      #f5f5f5 100%\n    );\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n\n  .cta4 {\n    margin-top: clamp(2.4rem, 4vw, 4.2rem);\n    position: relative;\n    z-index: 1;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    min-height: 54px;\n    padding: 0 3rem;\n    border: 2px solid transparent;\n    border-radius: 500px;\n\n    background:\n      linear-gradient(#050505, #050505) padding-box,\n      linear-gradient(\n        90deg,\n        #008a36 0%,\n        #008a36 30%,\n        #3f8724 42%,\n        #8c7214 52%,\n        #d85f07 66%,\n        #ff5c00 100%\n      ) border-box;\n\n    color: #ffffff;\n    text-decoration: none;\n    cursor: pointer;\n\n    font-size: 1.3rem;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n\n    transition: transform 0.