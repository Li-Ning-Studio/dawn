      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR - TESTIMONIAL CAROUSEL SECTION WITH AUTOPLAY -->\n<section class=\"hn-predator-testimonials\" data-hn-testimonials aria-label=\"Customer testimonials\">\n  <div class=\"hn-predator-testimonials__inner\">\n\n    <div class=\"hn-predator-testimonials__head\">\n      <h2 class=\"hn-predator-testimonials__heading\">What Our Customers Are Saying</h2>\n      <p class=\"hn-predator-testimonials__subheading\">\n        Our customer advocates are standing by 24/7 to support you via email.\n      </p>\n    </div>\n\n    <div class=\"hn-predator-testimonials__slider\">\n\n      <button class=\"hn-predator-testimonials__arrow hn-predator-testimonials__arrow--prev\" type=\"button\" aria-label=\"Previous testimonial\" data-hn-testimonial-prev>\n        <span aria-hidden=\"true\">←</span>\n      </button>\n\n      <div class=\"hn-predator-testimonials__viewport\" data-hn-testimonial-track>\n\n        <!-- CARD 1 -->\n        <article class=\"hn-predator-testimonials__card\">\n          <div class=\"hn-predator-testimonials__stars\" aria-label=\"5 star rating\">\n            ★★★★★\n          </div>\n\n          <p class=\"hn-predator-testimonials__quote\">\n            \"Really great for Intermediate Players. It's weight is perfect for powerful smashes, and faster reactions. Durability seems really good and the in hand feel is really premium considering the price range.\"\n          </p>\n\n          <p class=\"hn-predator-testimonials__name\">- Arush M.</p>\n        </article>\n\n        <!-- CARD 2 -->\n        <article class=\"hn-predator-testimonials__card\">\n          <div class=\"hn-predator-testimonials__stars\" aria-label=\"5 star rating\">\n            ★★★★★\n          </div>\n\n          <p class=\"hn-predator-testimonials__quote\">\n            \"Best racket for a defence player and I am personally satisfied with the racket with it's performance in the match it's control are impressive i am truly satisfied with the racket.\"\n          </p>\n\n          <p class=\"hn-predator-testimonials__name\">- Ashish</p>\n        </article>\n\n        <!-- CARD 3 -->\n        <article class=\"hn-predator-testimonials__card\">\n          <div class=\"hn-predator-testimonials__stars\" aria-label=\"5 star rating\">\n            ★★★★★\n          </div>\n\n          <p class=\"hn-predator-testimonials__quote\">\n            \"Great balance, Extreme Swing and awesome stroke. Overall it's killer\"\n          </p>\n\n          <p class=\"hn-predator-testimonials__name\">- Rayudu V.</p>\n        </article>\n\n        <!-- CARD 4 -->\n        <article class=\"hn-predator-testimonials__card\">\n          <div class=\"hn-predator-testimonials__stars\" aria-label=\"5 star rating\">\n            ★★★★★\n          </div>\n\n          <p class=\"hn-predator-testimonials__quote\">\n            \"I had ordered the white colour it is so nice and it generates too much power which is so good\"\n          </p>\n\n          <p class=\"hn-predator-testimonials__name\">- Mithun</p>\n        </article>\n\n      </div>\n\n      <button class=\"hn-predator-testimonials__arrow hn-predator-testimonials__arrow--next\" type=\"button\" aria-label=\"Next testimonial\" data-hn-testimonial-next>\n        <span aria-hidden=\"true\">→</span>\n      </button>\n\n    </div>\n\n    <div class=\"hn-predator-testimonials__dots\" aria-label=\"Testimonial slider navigation\">\n      <button class=\"hn-predator-testimonials__dot is-active\" type=\"button\" aria-label=\"Go to testimonial 1\" data-index=\"0\"></button>\n      <button class=\"hn-predator-testimonials__dot\" type=\"button\" aria-label=\"Go to testimonial 2\" data-index=\"1\"></button>\n      <button class=\"hn-predator-testimonials__dot\" type=\"button\" aria-label=\"Go to testimonial 3\" data-index=\"2\"></button>\n      <button class=\"hn-predator-testimonials__dot\" type=\"button\" aria-label=\"Go to testimonial 4\" data-index=\"3\"></button>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hn-predator-testimonials,\n  .hn-predator-testimonials *,\n  .hn-predator-testimonials *::before,\n  .hn-predator-testimonials *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-testimonials {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #f3f3f3;\n    color: #111111;\n    padding: 84px 0 74px;\n  }\n\n  .hn-predator-testimonials__inner {\n    width: 100%;\n    max-width: 1560px;\n    margin: 0 auto;\n    padding: 0 48px;\n  }\n\n  .hn-predator-testimonials__head {\n    text-align: center;\n    margin: 0 0 62px;\n  }\n\n  .hn-predator-testimonials__heading {\n    margin: 0;\n    color: #171717;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(38px, 2.8vw, 52px);\n    font-weight: 800;\n    line-height: 1.08;\n    letter-spacing: -0.045em;\n  }\n\n  .hn-predator-testimonials__subheading {\n    margin: 28px auto 0;\n    max-width: 720px;\n    color: #283544;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.45;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-predator-testimonials__slider {\n    position: relative;\n    width: 100%;\n    max-width: 1050px;\n    margin: 0 auto;\n  }\n\n  .hn-predator-testimonials__viewport {\n    display: flex;\n    gap: 30px;\n    width: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    padding: 0;\n  }\n\n  .hn-predator-testimonials__viewport::-webkit-scrollbar {\n    display: none;\n  }\n\n  .hn-predator-testimonials__card {\n    flex: 0 0 760px;\n    min-height: 220px;\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    border: 1px solid #dfdfdf;\n    border-radius: 9px;\n    background: #ffffff;\n    padding: 35px 39px 32px;\n  }\n\n  .hn-predator-testimonials__stars {\n    margin: 0 0 14px;\n    color: #f5a12a;\n    font-family: Arial, sans-serif;\n    font-size: 18px;\n    line-height: 1;\n    letter-spacing: 1px;\n  }\n\n  .hn-predator-testimonials__quote {\n    margin: 0;\n    color: #4d4d4d;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.85;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-predator-testimonials__name {\n    margin: 24px 0 0;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.2;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-predator-testimonials__arrow {\n    position: absolute;\n    top: 50%;\n    z-index: 5;\n    width: 42px;\n    height: 42px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: #7f8995;\n    font-size: 35px;\n    line-height: 1;\n    cursor: pointer;\n    transform: translateY(-50%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-predator-testimonials__arrow--prev {\n    left: -72px;\n  }\n\n  .hn-predator-testimonials__arrow--next {\n    right: -72px;\n  }\n\n  .hn-predator-testimonials__arrow:hover {\n    color: #111111;\n  }\n\n  .hn-predator-testimonials__dots {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    margin: 22px 0 0;\n  }\n\n  .hn-predator-testimonials__dot {\n    width: 13px;\n    height: 13px;\n    padding: 0;\n    border: 0;\n    border-radius: 999px;\n    background: #c7c7c7;\n    cursor: pointer;\n    transition: background-color 0.2s ease, transform 0.2s ease;\n  }\n\n  .hn-predator-testimonials__dot.is-active {\n    background: #151515;\n    transform: scale(1.04);\n  }\n\n  @media screen and (max-width: 1280px) {\n    .hn-predator-testimonials__slider {\n      max-width: 920px;\n    }\n\n    .hn-predator-testimonials__card {\n      flex-basis: 720px;\n    }\n\n    .hn-predator-testimonials__arrow--prev {\n      left: -54px;\n    }\n\n    .hn-predator-testimonials__arrow--next {\n      right: -54px;\n    }\n  }\n\n  @media screen and (max-width: 900px) {\n    .hn-predator-testimonials {\n      padding: 54px 0 56px;\n    }\n\n    .hn-predator-testimonials__inner {\n      padding: 0 12px;\n    }\n\n    .hn-predator-testimonials__head {\n      margin-bottom: 52px;\n    }\n\n    .hn-predator-testimonials__heading {\n      max-width: 330px;\n      margin: 0 auto;\n      font-size: 34px;\n      line-height: 1.18;\n      letter-spacing: -0.045em;\n    }\n\n    .hn-predator-testimonials__subheading {\n      max-width: 305px;\n      margin-top: 28px;\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .hn-predator-testimonials__slider {\n      max-width: 100%;\n    }\n\n    .hn-predator-testimonials__viewport {\n      gap: 14px;\n      padding: 0;\n    }\n\n    .hn-predator-testimonials__card {\n      flex: 0 0 100%;\n      min-height: 256px;\n      border-radius: 9px;\n      padding: 30px 32px 31px;\n    }\n\n    .hn-predator-testimonials__stars {\n      margin-bottom: 13px;\n      font-size: 17px;\n      letter-spacing: 0.8px;\n    }\n\n    .hn-predator-testimonials__quote {\n      font-size: 14px;\n      line-height: 1.72;\n      color: #26313d;\n    }\n\n    .hn-predator-testimonials__name {\n      margin-top: 24px;\n      font-size: 13px;\n    }\n\n    .hn-predator-testimonials__arrow {\n      display: none;\n    }\n\n    .hn-predator-testimonials__dots {\n      margin-top: 43px;\n      gap: 8px;\n    }\n\n    .hn-predator-testimonials__dot {\n      width: 12px;\n      height: 12px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-predator-testimonials__inner {\n      padding: 0 11px;\n    }\n\n    .hn-predator-testimonials__heading {\n      font-size: 33px;\n    }\n\n    .hn-predator-testimonials__card {\n      padding: 29px 31px 30px;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    function initTestimonials(root) {\n      if (!root || root.dataset.testimonialReady === 'true') return;\n\n      var track = root.querySelector('[data-hn-testimonial-track]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-testimonials__card'));\n      var dots = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-testimonials__dot'));\n      var prev = root.querySelector('[data-hn-testimonial-prev]');\n      var next = root.querySelector('[data-hn-testimonial-next]');\n      var autoplayDelay = 2000;\n      var autoplayTimer = null;\n      var scrollTimer = null;\n\n      if (!track || !cards.length || !dots.length) return;\n\n      root.dataset.testimonialReady = 'true';\n\n      function setActiveDot(index) {\n        dots.forEach(function(dot, i) {\n          dot.classList.toggle('is-active', i === index);\n        });\n      }\n\n      function getActiveIndex() {\n        var trackLeft = track.getBoundingClientRect().left;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.getBoundingClientRect().left - trackLeft);\n\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function scrollToCard(index) {\n        if (!cards[index]) return;\n\n        track.scrollTo({\n          left: cards[index].offsetLeft,\n          behavior: 'smooth'\n        });\n\n        setActiveDot(index);\n      }\n\n      function goNext() {\n        var current = getActiveIndex();\n        var nextIndex = current >= cards.length - 1 ? 0 : current + 1;\n        scrollToCard(nextIndex);\n      }\n\n      function goPrev() {\n        var current = getActiveIndex();\n        var prevIndex = current <= 0 ? cards.length - 1 : current - 1;\n        scrollToCard(prevIndex);\n      }\n\n      function startAutoplay() {\n        stopAutoplay();\n\n        autoplayTimer = window.setInterval(function() {\n          goNext();\n        }, autoplayDelay);\n      }\n\n      function stopAutoplay() {\n        if (autoplayTimer) {\n          window.clearInterval(autoplayTimer);\n          autoplayTimer = null;\n        }\n      }\n\n      track.addEventListener('scroll', function() {\n        window.clearTimeout(scrollTimer);\n\n        scrollTimer = window.setTimeout(function() {\n          setActiveDot(getActiveIndex());\n        }, 40);\n      }, { passive: true });\n\n      dots.forEach(function(dot) {\n        dot.addEventListener('click', function() {\n          var index = Number(dot.getAttribute('data-index'));\n          if (Number.isNaN(index)) return;\n\n          scrollToCard(index);\n          startAutoplay();\n        });\n      });\n\n      if (next) {\n        next.addEventListener('click', function() {\n          goNext();\n          startAutoplay();\n        });\n      }\n\n      if (prev) {\n        prev.addEventListener('click', function() {\n          goPrev();\n          startAutoplay();\n        });\n      }\n\n      root.addEventListener('mouseenter', stopAutoplay);\n      root.addEventListener('mouseleave', startAutoplay);\n\n      root.addEventListener('touchstart', stopAutoplay, { passive: true });\n      root.addEventListener('touchend', function() {\n        startAutoplay();\n      }, { passive: true });\n\n      document.addEventListener('visibilitychange', function() {\n        if (document.hidden) {\n          stopAutoplay();\n        } else {\n          startAutoplay();\n        }\n      });\n\n      window.addEventListener('resize', function() {\n        setActiveDot(getActiveIndex());\n      });\n\n      setActiveDot(0);\n      startAutoplay();\n    }\n\n    function initAllTestimonials() {\n      document.querySelectorAll('[data-hn-testimonials]').forEach(initTestimonials);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllTestimonials);\n    } else {\n      initAllTestimonials();\n    }\n\n    document.addEventListener('shopify:section:load', initAllTestimonials);\n  })();\n</script>",
