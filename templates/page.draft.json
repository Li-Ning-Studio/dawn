      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR - TRUST IN EVERY SMASH SECTION -->\n<section class=\"hn-predator-trust\" aria-label=\"Trust in Every Smash\">\n  <div class=\"hn-predator-trust__inner\">\n\n    <h2 class=\"hn-predator-trust__heading\">\n      <span class=\"hn-predator-trust__muted\">Trust in</span>\n      <span class=\"hn-predator-trust__strong\">Every Smash.</span>\n    </h2>\n\n    <p class=\"hn-predator-trust__copy\">\n      Every Predator is crafted with\n      <span>Japan Made Graphite</span>\n      and tested to serious string tensions, giving you the confidence to\n      <span>attack every rally</span>\n      with control, power, and intent.\n    </p>\n\n  </div>\n</section>\n\n<style>\n  .hn-predator-trust,\n  .hn-predator-trust *,\n  .hn-predator-trust *::before,\n  .hn-predator-trust *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-trust {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #000000;\n    color: #ffffff;\n    padding: 72px 20px 78px;\n  }\n\n  .hn-predator-trust__inner {\n    width: 100%;\n    max-width: 1220px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .hn-predator-trust__heading {\n    max-width: 1080px;\n    margin: 0 auto;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(36px, 4.4vw, 76px);\n    font-weight: 900;\n    line-height: 1.08;\n    letter-spacing: -0.065em;\n  }\n\n  .hn-predator-trust__muted {\n    color: #ffffff;\n  }\n\n  .hn-predator-trust__strong {\n    color: #ffffff;\n  }\n\n  .hn-predator-trust__copy {\n    max-width: 930px;\n    margin: 30px auto 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(18px, 1.7vw, 28px);\n    font-weight: 800;\n    line-height: 1.45;\n    letter-spacing: -0.045em;\n  }\n\n  .hn-predator-trust__copy span {\n    color: #ffffff;\n  }\n\n  @media screen and (max-width: 768px) {\n    .hn-predator-trust {\n      padding: 56px 18px 62px;\n    }\n\n    .hn-predator-trust__heading {\n      max-width: 560px;\n      font-size: clamp(34px, 10vw, 52px);\n      line-height: 1.08;\n      letter-spacing: -0.06em;\n    }\n\n    .hn-predator-trust__copy {\n      max-width: 520px;\n      margin-top: 26px;\n      font-size: clamp(18px, 5.3vw, 25px);\n      line-height: 1.42;\n      letter-spacing: -0.045em;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-predator-trust {\n      padding: 48px 16px 54px;\n    }\n\n    .hn-predator-trust__heading {\n      font-size: clamp(31px, 9.4vw, 40px);\n      letter-spacing: -0.055em;\n    }\n\n    .hn-predator-trust__copy {\n      font-size: clamp(17px, 5vw, 21px);\n      line-height: 1.45;\n    }\n  }\n</style>",
