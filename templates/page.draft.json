      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR LANDING PAGE SECTION - CTA BEFORE CARDS + MARQUEE AT BOTTOM -->\n\n<section class=\"hn-predator-rally-section\" aria-label=\"Predator racket rally winner section\">\n  <div class=\"hn-predator-rally__inner\">\n\n    <div class=\"hn-predator-rally__heading-wrap\">\n      <p class=\"hn-predator-rally__eyebrow\">Predator Series</p>\n\n      <h2 class=\"hn-predator-rally__headline\">\n        Every rally has a winner. <br>Make sure it's you.\n      </h2>\n    </div>\n\n    <!-- CTA BEFORE CARDS -->\n    <div class=\"hn-predator-rally__cta-wrap\">\n      <p class=\"hn-predator-rally__cta-kicker\">\n        Trusted by attacking players who don’t hold back\n      </p>\n\n      <a class=\"hn-predator-rally__cta\" href=\"/collections/predator\">\n        Enter Predator Mode\n      </a>\n    </div>\n\n    <div class=\"hn-predator-rally__grid\">\n\n      <!-- LEFT IMAGE -->\n      <div class=\"hn-predator-rally__image-card\">\n        <img\n          class=\"hn-predator-rally__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Predcator_Extra_Strong_X_Extreme_Poster_a581b87b-c8bb-45b9-b709-e3abf3f22c78.jpg?v=1782988066\"\n          alt=\"Two Predator badminton rackets crossed on a dark energy background\"\n          loading=\"eager\"\n          width=\"1200\"\n          height=\"1200\"\n        >\n      </div>\n\n      <!-- RIGHT CONTENT -->\n      <div class=\"hn-predator-rally__content-card\">\n        <div class=\"hn-predator-rally__content-wrap\">\n\n          <h3 class=\"hn-predator-rally__title\">\n            Built for players who decide rallies.\n          </h3>\n\n          <p class=\"hn-predator-rally__body\">\n            The Predator is built for one type of player. The kind who doesn't wait for the rally to open up, they force it open. Japanese graphite. Vapour Shaft. Head-heavy attack balance. Everything on this racket has a reason. Nothing is decoration.\n          </p>\n\n          <h4 class=\"hn-predator-rally__subhead\">\n            Why the Predator wins rallies?\n          </h4>\n\n          <ul class=\"hn-predator-rally__points\" role=\"list\">\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M13.35 2.35 4.65 13.85h6.45l-1.1 7.8 9.35-12.55h-6.55l.55-6.75Z\"></path>\n                </svg>\n              </span>\n              <span>Vapour Shaft. More speed. Same swing.</span>\n            </li>\n\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <circle cx=\"12\" cy=\"12\" r=\"7.1\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"2.45\"></circle>\n                  <path d=\"M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3\"></path>\n                </svg>\n              </span>\n              <span>Japan Graphite. Built for 10,000 impacts.</span>\n            </li>\n\n            <li class=\"hn-predator-rally__point\">\n              <span class=\"hn-predator-rally__point-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\">\n                  <path d=\"M7 5.2h10v3.6c0 2.95-2.15 5.25-5 5.25s-5-2.3-5-5.25V5.2Z\"></path>\n                  <path d=\"M5.1 7.1H3.55c0 3.05 1.55 5.1 4.15 5.55M18.9 7.1h1.55c0 3.05-1.55 5.1-4.15 5.55M12 14.05v3.1M8.75 20h6.5M10 17.15h4\"></path>\n                </svg>\n              </span>\n              <span>310mm Head Heavy. Smash from anywhere.</span>\n            </li>\n          </ul>\n\n          <div class=\"hn-predator-rally__gold-line\" aria-hidden=\"true\"></div>\n\n          <div class=\"hn-predator-rally__trust-row\">\n            <span class=\"hn-predator-rally__stars\" aria-label=\"5 star rating\">\n              ★★★★★\n            </span>\n            <span class=\"hn-predator-rally__rating-text\">\n              4.5/5 · Trusted by 1,200+ players across India\n            </span>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n\n    <!-- MARQUEE MOVED TO BOTTOM -->\n    <section class=\"hn-tech-marquee\" aria-label=\"Predator racket technologies\">\n      <div class=\"hn-tech-marquee__viewport\">\n        <div class=\"hn-tech-marquee__track\">\n\n          <!-- SET 1 -->\n          <div class=\"hn-tech-marquee__group\">\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                  <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Head Heavy - 310mm Balance</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon hn-tech-marquee__icon--cyan\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M13 2L4 14h7l-1 8 10-13h-7l0-7z\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text hn-tech-marquee__text--cyan\">Vapour Shaft Technology</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n                  <path d=\"M8 7h8M8 11h8M9 7l3 4 3-4M12 11v6\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Japan Made Graphite</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n          </div>\n\n          <!-- SET 2 -->\n          <div class=\"hn-tech-marquee__group\" aria-hidden=\"true\">\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                  <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Head Heavy - 310mm Balance</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon hn-tech-marquee__icon--cyan\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M13 2L4 14h7l-1 8 10-13h-7l0-7z\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text hn-tech-marquee__text--cyan\">Vapour Shaft Technology</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n                  <path d=\"M8 7h8M8 11h8M9 7l3 4 3-4M12 11v6\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Japan Made Graphite</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n          </div>\n\n          <!-- SET 3 -->\n          <div class=\"hn-tech-marquee__group\" aria-hidden=\"true\">\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n                  <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                  <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Head Heavy - 310mm Balance</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon hn-tech-marquee__icon--cyan\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M13 2L4 14h7l-1 8 10-13h-7l0-7z\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text hn-tech-marquee__text--cyan\">Vapour Shaft Technology</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n\n            <div class=\"hn-tech-marquee__item\">\n              <span class=\"hn-tech-marquee__icon\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n                  <path d=\"M8 7h8M8 11h8M9 7l3 4 3-4M12 11v6\"></path>\n                </svg>\n              </span>\n              <span class=\"hn-tech-marquee__text\">Japan Made Graphite</span>\n            </div>\n\n            <span class=\"hn-tech-marquee__dot\"></span>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n  </div>\n</section>\n\n<style>\n  html,\n  body {\n    overflow-x: hidden;\n  }\n\n  .hn-predator-rally-section,\n  .hn-tech-marquee,\n  .hn-predator-rally-section *,\n  .hn-predator-rally-section *::before,\n  .hn-predator-rally-section *::after,\n  .hn-tech-marquee *,\n  .hn-tech-marquee *::before,\n  .hn-tech-marquee *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-predator-rally-section {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #000000;\n    color: #ffffff;\n    padding: 72px 0 96px;\n  }\n\n  .hn-predator-rally__inner {\n    width: 100%;\n    max-width: 1360px;\n    margin: 0 auto;\n    padding: 0 40px;\n  }\n\n  .hn-predator-rally__heading-wrap {\n    width: 100%;\n    max-width: 1100px;\n    text-align: center;\n    margin: 0 auto 34px;\n  }\n\n  .hn-predator-rally__eyebrow {\n    margin: 0 0 12px;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.1;\n    letter-spacing: 0;\n    text-align: center;\n  }\n\n  .hn-predator-rally__headline {\n    display: inline-block;\n    width: fit-content;\n    max-width: 100%;\n    margin: 0 auto;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(42px, 5vw, 80px);\n    font-weight: 900;\n    line-height: 1.02;\n    letter-spacing: -0.05em;\n    text-align: center;\n    background-image: linear-gradient(\n      to right,\n      #3bc400 0%,\n      #2f9c00 34%,\n      #3f8724 44%,\n      #8c7214 52%,\n      #d85f07 62%,\n      #ff5c00 72%,\n      #ff5c00 100%\n    );\n    background-size: 100% 100%;\n    background-repeat: no-repeat;\n    background-position: center;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    -webkit-text-fill-color: transparent;\n  }\n\n  /* CTA BEFORE CARD */\n  .hn-predator-rally__cta-wrap {\n    width: 100%;\n    text-align: center;\n    margin: 0 auto 54px;\n  }\n\n  .hn-predator-rally__cta-kicker {\n    margin: 0 0 20px;\n    color: rgba(255, 255, 255, 0.62);\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-predator-rally__cta {\n    min-width: 260px;\n    min-height: 60px;\n    padding: 0 34px;\n    border: 1.5px solid #ffffff;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #ffffff;\n    background: transparent;\n    text-decoration: none;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 900;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;\n  }\n\n  .hn-predator-rally__cta:hover {\n    background: #ffffff;\n    color: #000000;\n    transform: translateY(-2px);\n    box-shadow: 0 0 28px rgba(255, 255, 255, 0.22);\n  }\n\n  .hn-predator-rally__grid {\n    width: 100%;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n    overflow: visible;\n    border-radius: 0;\n    background: transparent;\n    align-items: stretch;\n  }\n\n  .hn-predator-rally__image-card,\n  .hn-predator-rally__content-card {\n    min-height: 760px;\n    border-radius: 18px;\n    overflow: hidden;\n  }\n\n  .hn-predator-rally__image-card {\n    position: relative;\n    width: 100%;\n    background: #070707;\n    border: 1px solid rgba(255,255,255,0.14);\n  }\n\n  .hn-predator-rally__image {\n    width: 100%;\n    height: 100%;\n    min-height: 760px;\n    display: block;\n    object-fit: cover;\n    object-position: center center;\n  }\n\n  .hn-predator-rally__content-card {\n    position: relative;\n    width: 100%;\n    background: #f7f7f7;\n    border: 1px solid #dddddd;\n  }\n\n  .hn-predator-rally__content-wrap {\n    position: relative;\n    width: 100%;\n    min-height: 760px;\n    padding: 84px 56px 64px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  .hn-predator-rally__title {\n    margin: 0 0 22px;\n    max-width: 620px;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(27px, 1.58vw, 32px);\n    font-weight: 800;\n    line-height: 1.12;\n    letter-spacing: -0.028em;\n  }\n\n  .hn-predator-rally__body {\n    margin: 0 0 26px;\n    max-width: 620px;\n    color: #1c1c1c;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.65;\n    letter-spacing: -0.012em;\n  }\n\n  .hn-predator-rally__subhead {\n    margin: 0 0 18px;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: clamp(26px, 1.52vw, 31px);\n    font-weight: 800;\n    line-height: 1.12;\n    letter-spacing: -0.04em;\n  }\n\n  .hn-predator-rally__points {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    margin: 0;\n    padding: 0;\n    max-width: 620px;\n    list-style: none;\n  }\n\n  .hn-predator-rally__point {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    color: #000000;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.45;\n    letter-spacing: -0.016em;\n  }\n\n  .hn-predator-rally__point-icon {\n    width: 17px;\n    height: 17px;\n    flex: 0 0 17px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #000000;\n  }\n\n  .hn-predator-rally__point-icon svg {\n    width: 17px;\n    height: 17px;\n    display: block;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2.2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .hn-predator-rally__point:first-child .hn-predator-rally__point-icon svg {\n    fill: currentColor;\n    stroke: none;\n  }\n\n  .hn-predator-rally__gold-line {\n    width: min(100%, 632px);\n    height: 2px;\n    display: block;\n    margin: 30px 0 0;\n    background: #dfc087;\n    border-radius: 999px;\n    opacity: 0.95;\n  }\n\n  .hn-predator-rally__trust-row {\n    position: relative;\n    z-index: 3;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    max-width: 800px;\n    margin-top: 34px;\n    flex-wrap: wrap;\n  }\n\n  .hn-predator-rally__stars {\n    display: inline-flex;\n    align-items: center;\n    color: #f2c86b;\n    font-family: Arial, sans-serif;\n    font-size: 18px;\n    line-height: 1;\n    letter-spacing: 1.5px;\n    white-space: nowrap;\n  }\n\n  .hn-predator-rally__rating-text {\n    display: inline-block;\n    color: #1d2630;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1.25;\n    letter-spacing: -0.01em;\n  }\n\n  /* MARQUEE AT BOTTOM */\n  .hn-tech-marquee {\n    width: 100%;\n    height: 50px;\n    overflow: hidden;\n    background: #070707;\n    border-top: 2px solid #d7d7d7;\n    border-bottom: 2px solid #d7d7d7;\n    margin: 64px 0 0;\n  }\n\n  .hn-tech-marquee__viewport {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    position: relative;\n  }\n\n  .hn-tech-marquee__track {\n    height: 100%;\n    display: flex;\n    align-items: center;\n    width: max-content;\n    will-change: transform;\n    animation: hnTechMarqueeMove 28s linear infinite;\n  }\n\n  .hn-tech-marquee__group {\n    height: 100%;\n    display: flex;\n    align-items: center;\n    flex-shrink: 0;\n  }\n\n  .hn-tech-marquee__item {\n    height: 100%;\n    display: inline-flex;\n    align-items: center;\n    gap: 14px;\n    padding: 0 46px;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  .hn-tech-marquee__icon {\n    width: 22px;\n    height: 22px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 22px;\n    color: #ffffff;\n  }\n\n  .hn-tech-marquee__icon svg {\n    width: 22px;\n    height: 22px;\n    display: block;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2.25;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .hn-tech-marquee__icon svg path:first-child:last-child {\n    fill: currentColor;\n    stroke: none;\n  }\n\n  .hn-tech-marquee__icon--cyan {\n    color: #00d9e8;\n  }\n\n  .