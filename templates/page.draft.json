 1;\n    letter-spacing: 1px;\n  }\n\n  .hn-predator-testimonials__quote {\n    margin: 0;\n    color: #d7dce6;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.85;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-predator-testimonials__name {\n    margin: 24px 0 0;\n    color: #ffffff;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.2;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-predator-testimonials__arrow {\n    position: absolute;\n    top: 50%;\n    z-index: 5;\n    width: 42px;\n    height: 42px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: #c7ced9;\n    font-size: 35px;\n    line-height: 1;\n    cursor: pointer;\n    transform: translateY(-50%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-predator-testimonials__arrow--prev {\n    left: -72px;\n  }\n\n  .hn-predator-testimonials__arrow--next {\n    right: -72px;\n  }\n\n  .hn-predator-testimonials__arrow:hover {\n    color: #ffffff;\n  }\n\n  .hn-predator-testimonials__dots {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    margin: 22px 0 0;\n  }\n\n  .hn-predator-testimonials__dot {\n    width: 13px;\n    height: 13px;\n    padding: 0;\n    border: 0;\n    border-radius: 999px;\n    background: #333333;\n    cursor: pointer;\n    transition: background-color 0.2s ease, transform 0.2s ease;\n  }\n\n  .hn-predator-testimonials__dot.is-active {\n    background: #ffffff;\n    transform: scale(1.04);\n  }\n\n  @media screen and (max-width: 1280px) {\n    .hn-predator-testimonials__slider {\n      max-width: 920px;\n    }\n\n    .hn-predator-testimonials__card {\n      flex-basis: 720px;\n    }\n\n    .hn-predator-testimonials__arrow--prev {\n      left: -54px;\n    }\n\n    .hn-predator-testimonials__arrow--next {\n      right: -54px;\n    }\n  }\n\n  @media screen and (max-width: 900px) {\n    .hn-predator-testimonials {\n      padding: 56px 0 58px;\n      background: #000000 !important;\n    }\n\n    .hn-predator-testimonials__inner {\n      padding: 0 12px;\n    }\n\n    .hn-predator-testimonials__head {\n      max-width: 330px;\n      margin: 0 auto 48px;\n      text-align: left;\n    }\n\n    .hn-predator-testimonials__heading {\n      font-size: 27px;\n      line-height: 1.17;\n      letter-spacing: -0.04em;\n    }\n\n    .hn-predator-testimonials__subheading {\n      margin-top: 24px;\n      font-size: 15px;\n      line-height: 1.72;\n      color: #c4ccda;\n    }\n\n    .hn-predator-testimonials__slider {\n      max-width: 100%;\n    }\n\n    .hn-predator-testimonials__viewport {\n      gap: 14px;\n      padding: 0;\n    }\n\n    .hn-predator-testimonials__card {\n      flex: 0 0 100%;\n      min-height: 256px;\n      border-radius: 10px;\n      padding: 30px 32px 31px;\n      background: #090909;\n    }\n\n    .hn-predator-testimonials__stars {\n      margin-bottom: 13px;\n      font-size: 17px;\n      letter-spacing: 0.8px;\n    }\n\n    .hn-predator-testimonials__quote {\n      font-size: 14px;\n      line-height: 1.72;\n      color: #d7dce6;\n    }\n\n    .hn-predator-testimonials__name {\n      margin-top: 24px;\n      font-size: 13px;\n    }\n\n    .hn-predator-testimonials__arrow {\n      display: none;\n    }\n\n    .hn-predator-testimonials__dots {\n      margin-top: 43px;\n      gap: 8px;\n    }\n\n    .hn-predator-testimonials__dot {\n      width: 12px;\n      height: 12px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-predator-testimonials__inner {\n      padding: 0 11px;\n    }\n\n    .hn-predator-testimonials__heading {\n      font-size: 26px;\n    }\n\n    .hn-predator-testimonials__card {\n      padding: 29px 31px 30px;\n    }\n  }\n/* TESTIMONIAL HEADING FINAL FIX */\n.hn-predator-testimonials__head {\n  max-width: 900px !important;\n  margin: 0 auto 62px !important;\n  text-align: center !important;\n}\n\n.hn-predator-testimonials__heading {\n  margin: 0 auto !important;\n  color: #ffffff !important;\n  text-align: center !important;\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: clamp(34px, 3.1vw, 58px) !important;\n  font-weight: 800 !important;\n  line-height: 1.05 !important;\n  letter-spacing: -0.045em !important;\n}\n\n.hn-predator-testimonials__subheading {\n  margin: 24px auto 0 !important;\n  max-width: 760px !important;\n  color: #c9d0dc !important;\n  text-align: center !important;\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: clamp(16px, 1.15vw, 20px) !important;\n  font-weight: 400 !important;\n  line-height: 1.65 !important;\n  letter-spacing: -0.015em !important;\n}\n\n@media screen and (max-width: 900px) {\n  .hn-predator-testimonials__head {\n    max-width: 360px !important;\n    margin: 0 auto 48px !important;\n    text-align: center !important;\n  }\n\n  .hn-predator-testimonials__heading {\n    font-size: 34px !important;\n    line-height: 1.08 !important;\n    text-align: center !important;\n  }\n\n  .hn-predator-testimonials__subheading {\n    max-width: 330px !important;\n    margin-top: 20px !important;\n    font-size: 15px !important;\n    line-height: 1.65 !important;\n    text-align: center !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-testimonials__heading {\n    font-size: 31px !important;\n  }\n\n  .hn-predator-testimonials__subheading {\n    font-size: 14px !important;\n  }\n}\n/* TESTIMONIAL HEADING - REDUCED PHENOM STYLE, WHITE */\n.hn-predator-testimonials__head {\n  max-width: 900px !important;\n  margin: 0 auto 52px !important;\n  text-align: center !important;\n}\n\n.hn-predator-testimonials__heading {\n  display: inline-block !important;\n  width: fit-content !important;\n  max-width: 100% !important;\n  margin: 0 auto !important;\n\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: 2.8rem !important;\n  font-weight: 900 !important;\n  line-height: 1.05 !important;\n  letter-spacing: -1.3px !important;\n  text-align: center !important;\n\n  background: none !important;\n  background-image: none !important;\n  color: #ffffff !important;\n  -webkit-text-fill-color: #ffffff !important;\n  -webkit-background-clip: initial !important;\n  background-clip: initial !important;\n}\n\n.hn-predator-testimonials__subheading {\n  margin: 16px auto 0 !important;\n  max-width: 680px !important;\n  color: #c9d0dc !important;\n  text-align: center !important;\n  font-family: Figtree, Avenir, Montserrat, Arial, sans-serif !important;\n  font-size: 15px !important;\n  font-weight: 400 !important;\n  line-height: 1.55 !important;\n  letter-spacing: -0.01em !important;\n}\n\n@media screen and (min-width: 750px) {\n  .hn-predator-testimonials__heading {\n    font-size: 4.2rem !important;\n  }\n}\n\n@media screen and (max-width: 749px) {\n  .hn-predator-testimonials__head {\n    max-width: 340px !important;\n    margin: 0 auto 42px !important;\n  }\n\n  .hn-predator-testimonials__heading {\n    font-size: 2.6rem !important;\n    line-height: 1.05 !important;\n    letter-spacing: -1.2px !important;\n  }\n\n  .hn-predator-testimonials__subheading {\n    max-width: 320px !important;\n    margin-top: 14px !important;\n    font-size: 14px !important;\n    line-height: 1.55 !important;\n  }\n}\n\n@media screen and (max-width: 420px) {\n  .hn-predator-testimonials__heading {\n    font-size: 2.35rem !important;\n  }\n}\n</style>\n\n<script>\n  (function() {\n    function initTestimonials(root) {\n      if (!root || root.dataset.testimonialReady === 'true') return;\n\n      var track = root.querySelector('[data-hn-testimonial-track]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-testimonials__card'));\n      var dots = Array.prototype.slice.call(root.querySelectorAll('.hn-predator-testimonials__dot'));\n      var prev = root.querySelector('[data-hn-testimonial-prev]');\n      var next = root.querySelector('[data-hn-testimonial-next]');\n      var autoplayDelay = 2000;\n      var autoplayTimer = null;\n      var scrollTimer = null;\n\n      if (!track || !cards.length || !dots.length) return;\n\n      root.dataset.testimonialReady = 'true';\n\n      function setActiveDot(index) {\n        dots.forEach(function(dot, i) {\n          dot.classList.toggle('is-active', i === index);\n        });\n      }\n\n      function getActiveIndex() {\n        var trackLeft = track.getBoundingClientRect().left;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.getBoundingClientRect().left - trackLeft);\n\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function scrollToCard(index) {\n        if (!cards[index]) return;\n\n        track.scrollTo({\n          left: cards[index].offsetLeft,\n          behavior: 'smooth'\n        });\n\n        setActiveDot(index);\n      }\n\n      function goNext() {\n        var current = getActiveIndex();\n        var nextIndex = current >= cards.length - 1 ? 0 : current + 1;\n        scrollToCard(nextIndex);\n      }\n\n      function goPrev() {\n        var current = getActiveIndex();\n        var prevIndex = current <= 0 ? cards.length - 1 : current - 1;\n        scrollToCard(prevIndex);\n      }\n\n      function startAutoplay() {\n        stopAutoplay();\n\n        autoplayTimer = window.setInterval(function() {\n          goNext();\n        }, autoplayDelay);\n      }\n\n      function stopAutoplay() {\n        if (autoplayTimer) {\n          window.clearInterval(autoplayTimer);\n          autoplayTimer = null;\n        }\n      }\n\n      track.addEventListener('scroll', function() {\n        window.clearTimeout(scrollTimer);\n\n        scrollTimer = window.setTimeout(function() {\n          setActiveDot(getActiveIndex());\n        }, 40);\n      }, { passive: true });\n\n      dots.forEach(function(dot) {\n        dot.addEventListener('click', function() {\n          var index = Number(dot.getAttribute('data-index'));\n          if (Number.isNaN(index)) return;\n\n          scrollToCard(index);\n          startAutoplay();\n        });\n      });\n\n      if (next) {\n        next.addEventListener('click', function() {\n          goNext();\n          startAutoplay();\n        });\n      }\n\n      if (prev) {\n        prev.addEventListener('click', function() {\n          goPrev();\n          startAutoplay();\n        });\n      }\n\n      root.addEventListener('mouseenter', stopAutoplay);\n      root.addEventListener('mouseleave', startAutoplay);\n\n      root.addEventListener('touchstart', stopAutoplay, { passive: true });\n      root.addEventListener('touchend', function() {\n        startAutoplay();\n      }, { passive: true });\n\n      document.addEventListener('visibilitychange', function() {\n        if (document.hidden) {\n          stopAutoplay();\n        } else {\n          startAutoplay();\n        }\n      });\n\n      window.addEventListener('resize', function() {\n        setActiveDot(getActiveIndex());\n      });\n\n      setActiveDot(0);\n      startAutoplay();\n    }\n\n    function initAllTestimonials() {\n      document.querySelectorAll('[data-hn-testimonials]').forEach(initTestimonials);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllTestimonials);\n    } else {\n      initAllTestimonials();\n    }\n\n    document.addEventListener('shopify:section:load', initAllTestimonials);\n  })();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
