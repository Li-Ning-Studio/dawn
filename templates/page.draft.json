eight: 16px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .hn-predator-shop__nav {\n    display: none;\n  }\n\n  @media screen and (max-width: 1280px) {\n    .hn-predator-shop__inner {\n      max-width: 1180px;\n      padding: 0 28px;\n    }\n\n    .hn-predator-shop__grid {\n      gap: 22px;\n    }\n\n    .hn-predator-shop__card {\n      min-height: 835px;\n    }\n\n    .hn-predator-shop__image {\n      height: 270px;\n    }\n\n    .hn-predator-shop__title,\n    .hn-predator-shop__price {\n      font-size: 18px;\n    }\n\n    .hn-predator-shop__features li,\n    .hn-predator-shop__desc,\n    .hn-predator-shop__button {\n      font-size: 14px;\n    }\n  }\n\n  @media screen and (max-width: 990px) {\n    .hn-predator-shop {\n      padding: 24px 0 58px;\n      overflow-x: hidden;\n      overflow-y: visible;\n    }\n\n    .hn-predator-shop__inner {\n      padding: 0 18px;\n    }\n\n    .hn-predator-shop__carousel-wrap {\n      overflow: visible;\n    }\n\n    .hn-predator-shop__grid {\n      display: flex;\n      gap: 16px;\n      overflow-x: auto;\n      overflow-y: hidden;\n      padding: 0 58px 10px 0;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      overscroll-behavior-x: contain;\n      overscroll-behavior-y: auto;\n      touch-action: auto;\n      will-change: scroll-position;\n    }\n\n    .hn-predator-shop__grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-predator-shop__card {\n      flex: 0 0 calc(100vw - 116px);\n      width: calc(100vw - 116px);\n      max-width: 360px;\n      min-height: 780px;\n      scroll-snap-align: start;\n    }\n\n    .hn-predator-shop__image {\n      height: 275px;\n      padding: 18px 12px 0;\n    }\n\n    .hn-predator-shop__content {\n      padding: 18px 14px 14px;\n    }\n\n    .hn-predator-shop__features {\n      gap: 19px;\n    