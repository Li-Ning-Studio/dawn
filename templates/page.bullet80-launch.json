    "custom_liquid_H6AJRc": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  :root{\n    --ink:#07080a;\n    --ink-2:#0c0f11;\n    --teal-900:#04191c;\n    --teal-700:#0a3438;\n    --teal-500:#13707a;\n    --cyan-400:#5eead4;\n    --cyan-300:#a8f6e6;\n    --chrome-100:#eef1f2;\n    --chrome-300:#c6cdd1;\n    --chrome-500:#8b9296;\n    --chrome-700:#454c50;\n    --chrome-900:#232729;\n    --brass:#c98a4b;\n    --paper:#f4f5f3;\n    --paper-dim:rgba(244,245,243,.58);\n    --lid:0deg;\n    --racket-y:0px;\n    --racket-x:-10px;\n    --racket-z:0px;\n    --racket-rot:0deg;\n    --racket-scale:0.5;\n    --racket-op:0;\n    --glow-op:0;\n    --crack-op:.55;\n    --seal-op:1;\n    --brand-op:0;\n    --brand-y:14px;\n  }\n\n  *{box-sizing:border-box;}\n  body{\n    margin:0;\n    background:var(--ink);\n    color:var(--paper);\n    font-family:'Space Grotesk',sans-serif;\n    overflow-x:hidden;\n  }\n\n  .hnd-eyebrow{\n    font-family:'JetBrains Mono',monospace;\n    font-size:11px;\n    letter-spacing:.28em;\n    text-transform:uppercase;\n    color:var(--cyan-300);\n  }\n\n  /* ---------- NAV ---------- */\n  .hnd-nav{\n    position:fixed;\n    top:0;left:0;right:0;\n    z-index:40;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:22px clamp(20px,5vw,56px);\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    color:var(--paper-dim);\n    mix-blend-mode:difference;\n  }\n  .hnd-nav .mark{display:flex;align-items:center;gap:10px;color:var(--paper);font-weight:500;}\n  .hnd-nav svg{display:block;}\n\n  /* ---------- HERO SCAFFOLD ---------- */\n  .hnd-hero-spacer{\n    height:280vh;\n    position:relative;\n  }\n  .hnd-stage{\n    position:sticky;\n    top:0;\n    height:100vh;\n    width:100%;\n    overflow:hidden;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:\n      radial-gradient(120% 90% at 50% 8%, var(--teal-900) 0%, transparent 55%),\n      radial-gradient(90% 70% at 50% 100%, var(--teal-900) 0%, transparent 60%),\n      var(--ink);\n  }\n\n  /* faint vignette + grain-like scanlines for the \"sealed asset\" feel */\n  .hnd-stage::before{\n    content:\"\";\n    position:absolute;inset:0;\n    background:repeating-linear-gradient(180deg, rgba(255,255,255,.025) 0 1px, transparent 1px 3px);\n    pointer-events:none;\n    opacity:.5;\n  }\n  .hnd-stage::after{\n    content:\"\";\n    position:absolute;inset:0;\n    box-shadow:inset 0 0 18vw 2vw rgba(0,0,0,.7);\n    pointer-events:none;\n  }\n\n  /* ---------- SHATTER GRAPHIC ---------- */\n  .hnd-crack{\n    position:absolute;\n    top:6%;\n    left:50%;\n    transform:translateX(-50%);\n    width:min(70vw,760px);\n    opacity:var(--crack-op);\n    transition:opacity .4s linear;\n    pointer-events:none;\n  }\n  .hnd-crack path{\n    stroke:var(--chrome-100);\n    stroke-width:1.3;\n    fill:none;\n    filter:drop-shadow(0 0 6px rgba(94,234,212,.25));\n  }\n\n  /* ---------- COPY ---------- */\n  .hnd-copy{\n    position:absolute;\n    top:12%;\n    left:50%;\n    transform:translateX(-50%);\n    text-align:center;\n    z-index:5;\n    width:min(90vw,720px);\n  }\n  .hnd-headline{\n    font-family:'Rajdhani',sans-serif;\n    font-weight:700;\n    text-transform:uppercase;\n    font-size:clamp(30px,5.2vw,56px);\n    letter-spacing:.02em;\n    line-height:1.02;\n    margin:10px 0 0;\n    color:var(--paper);\n    transition:opacity .35s ease, transform .35s ease;\n  }\n  .hnd-sub{\n    font-size:14px;\n    color:var(--paper-dim);\n    margin:14px auto 0;\n    max-width:420px;\n    line-height:1.5;\n    transition:opacity .35s ease;\n  }\n\n  /* the brand line that surfaces once unsealed */\n  .hnd-brand-reveal{\n    position:absolute;\n    bottom:9.5%;\n    left:50%;\n    transform:translateX(-50%) translateY(var(--brand-y));\n    text-align:center;\n    z-index:6;\n    opacity:var(--brand-op);\n    transition:opacity .35s ease;\n    pointer-events:none;\n  }\n  .hnd-brand-reveal .hnd-headline{\n    font-size:clamp(24px,4vw,40px);\n    background:linear-gradient(180deg,var(--cyan-300),var(--teal-500) 130%);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .hnd-brand-reveal .hnd-sub{color:var(--paper-dim);margin-top:6px;}\n\n  /* ---------- 3D SCENE ---------- */\n  .hnd-scene-wrap{\n    position:relative;\n    z-index:3;\n    perspective:1900px;\n    width:min(92vw,640px);\n    height:340px;\n    margin-top:6vh;\n  }\n  .hnd-scene{\n    position:relative;\n    width:100%;\n    height:100%;\n    transform-style:preserve-3d;\n    transform:rotateX(26deg) rotateY(-16deg);\n  }\n\n  /* ground shadow */\n  .hnd-shadow{\n    position:absolute;\n    left:50%;top:64%;\n    width:78%;height:60px;\n    transform:translate(-50%,-50%) translateZ(-40px) rotateX(90deg);\n    background:radial-gradient(closest-side, rgba(0,0,0,.65), transparent 72%);\n    filter:blur(2px);\n  }\n\n  /* speed / unseal streaks behind the racket */\n  .hnd-streaks{\n    position:absolute;\n    left:50%;top:38%;\n    width:130%;\n    transform:translate(-50%,-50%) translateZ(10px);\n    opacity:var(--glow-op);\n    transition:opacity .4s ease;\n    pointer-events:none;\n  }\n  .hnd-streaks div{\n    position:absolute;\n    height:2px;\n    left:0;\n    background:linear-gradient(90deg, transparent, var(--cyan-400), transparent);\n    filter:blur(.4px);\n  }\n  .hnd-streaks div:nth-child(1){top:18%;width:70%;opacity:.65;}\n  .hnd-streaks div:nth-child(2){top:46%;width:100%;opacity:.9;}\n  .hnd-streaks div:nth-child(3){top:74%;width:58%;opacity:.5;}\n\n  /* ---------- CASE ---------- */\n  .hnd-case{\n    position:absolute;\n    left:50%;bottom:14%;\n    width:100%;\n    max-width:560px;\n    transform:translateX(-50%);\n    transform-style:preserve-3d;\n  }\n  .hnd-base{\n    position:relative;\n    height:118px;\n    border-radius:16px;\n    background:linear-gradient(180deg,var(--chrome-300) 0%,var(--chrome-500) 38%,var(--chrome-700) 100%);\n    box-shadow:\n      0 2px 0 rgba(255,255,255,.5) inset,\n      0 -10px 22px rgba(0,0,0,.45) inset,\n      0 30px 40px -12px rgba(0,0,0,.7);\n    transform:translateZ(-1px);\n  }\n  .hnd-base::before{ /* interior foam */\n    content:\"\";\n    position:absolute;\n    inset:10px 12px;\n    border-radius:9px;\n    background:\n      radial-gradient(60px 40px at 50% 40%, rgba(0,0,0,.25), transparent 70%),\n      linear-gradient(180deg,#17181a,#0c0d0e 70%);\n    box-shadow:inset 0 6px 14px rgba(0,0,0,.7);\n  }\n  .hnd-bullet-well{\n    position:absolute;\n    left:50%;bottom:22px;\n    transform:translateX(-50%);\n    width:36px;height:18px;\n    border-radius:50%;\n    background:radial-gradient(circle at 50% 30%, #000 0%, #000 55%, #1c1d1e 100%);\n    box-shadow:inset 0 3px 6px rgba(0,0,0,.9);\n    display:flex;align-items:center;justify-content:center;\n    z-index:2;\n  }\n  .hnd-bullet-well svg{transform:rotate(90deg);opacity:.95;}\n  .hnd-latch{\n    position:absolute;\n    right:26px;top:50%;\n    transform:translateY(-50%);\n    width:34px;height:16px;\n    border-radius:4px;\n    background:linear-gradient(180deg,var(--chrome-100),var(--chrome-500));\n    box-shadow:0 1px 2px rgba(0,0,0,.5);\n  }\n  .hnd-handle{\n    position:absolute;\n    left:44px;top:50%;\n    transform:translateY(-50%);\n    width:70px;height:26px;\n    border:5px solid var(--chrome-300);\n    border-bottom:none;\n    border-radius:10px 10px 0 0;\n    opacity:.9;\n  }\n\n  .hnd-lid{\n    position:absolute;\n    left:0;top:0;\n    width:100%;height:118px;\n    transform-origin:top center;\n    transform:translateZ(1px) rotateX(var(--lid));\n    transform-style:preserve-3d;\n    transition:transform 0.25s ease-out;\n  }\n  .hnd-lid-face{\n    position:absolute;inset:0;\n    border-radius:16px;\n    background:linear-gradient(180deg,var(--chrome-100) 0%,var(--chrome-300) 45%,var(--chrome-500) 100%);\n    box-shadow:\n      0 2px 0 rgba(255,255,255,.7) inset,\n      0 -8px 18px rgba(0,0,0,.3) inset;\n    backface-visibility:hidden;\n  }\n  .hnd-lid-face::after{\n    content:\"\";\n    position:absolute;\n    left:50%;top:14px;\n    transform:translateX(-50%);\n    width:60%;height:2px;\n    background:linear-gradient(90deg,transparent,rgba(0,0,0,.25),);\n  }\n  .hnd-lid-inner{\n    position:absolute;\n    border-radius:16px;\n    background:linear-gradient(180deg,#141516,#0a0b0c);\n    transform:rotateX(180deg);\n    backface-visibility:hidden;\n  }\n  .hnd-serial{\n    position:absolute;\n    left:24px;bottom:14px;\n    font-family:'JetBrains Mono',monospace;\n    font-size:9px;\n    letter-spacing:.12em;\n    color:rgba(0,0,0,.45);\n  }\n\n  /* ---------- RACKET ---------- */\n  .hnd-racket{\n    position:absolute;\n    left:50%;\n    transform:\n      translateX(-50%)\n      translate3d(var(--racket-x), var(--racket-y), var(--racket-z))\n      rotate(var(--racket-rot))\n      scale(var(--racket-scale));\n    transform-origin:50% 50%;\n    filter:drop-shadow(0 10px 26px rgba(0,0,0,.55));\n    z-index:2;\n    transition:filter .3s ease;\n    pointer-events:none;\n  }\n  .hnd-racket img{\n    display:block;\n    width:100%;\n    height:auto;\n    position: relative;\n    top: 0px;\n    transform: rotate(-90deg);\n  }\n  .hnd-racket .glow{\n    filter:drop-shadow(0 0 18px rgba(94,234,212,var(--glow-op)));\n  }\n\n  /* ---------- CTA ---------- */\n  .hnd-cta-wrap{\n    position:absolute;\n    bottom:6%;\n    left:50%;\n    transform:translateX(-50%);\n    z-index:8;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    gap:14px;\n    opacity:var(--seal-op);\n    transition:opacity .3s ease;\n  }\n  .hnd-cta{\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    letter-spacing:.2em;\n    text-transform:uppercase;\n    color:var(--ink);\n    background:linear-gradient(180deg,var(--cyan-300),var(--cyan-400));\n    border:none;\n    padding:14px 30px;\n    border-radius:999px;\n    cursor:pointer;\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    box-shadow:0 8px 22px -6px rgba(94,234,212,.55);\n    transition:transform .18s ease, box-shadow .18s ease;\n  }\n  .hnd-cta:hover{transform:translateY(-2px);box-shadow:0 12px 26px -6px rgba(94,234,212,.7);}\n  .hnd-cta:focus-visible{outline:2px solid var(--paper);outline-offset:3px;}\n  .hnd-cta svg{width:12px;height:12px;transition:transform .2s ease;}\n  .hnd-cta:hover svg{transform:translateY(2px);}\n\n  .hnd-scroll-hint{\n    font-family:'JetBrains Mono',monospace;\n    font-size:10px;\n    letter-spacing:.24em;\n    text-transform:uppercase;\n    color:var(--paper-dim);\n    display:flex;\n    align-items:center;\n    gap:8px;\n  }\n  .hnd-scroll-hint .line{\n    width:1px;height:26px;\n    background:linear-gradient(180deg,var(--paper-dim),transparent);\n    animation:hnd-drop 1.8s ease-in-out infinite;\n  }\n  @keyframes hnd-drop{\n    0%{transform:scaleY(.2);transform-origin:top;opacity:1;}\n    50%{transform:scaleY(1);transform-origin:top;opacity:1;}\n    100%{transform:scaleY(.2);transform-origin:bottom;opacity:.2;}\n  }\n\n  @media (max-width:640px){\n    .hnd-scene-wrap{height:300px;margin-top:8vh;}\n    .hnd-copy{top:15%;}\n    .hnd-racket{width: 276px;}\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .hnd-lid,.hnd-headline,.hnd-sub,.hnd-brand-reveal,.hnd-crack{transition:none;}\n    .hnd-scroll-hint .line{animation:none;}\n  }\n\n</style>\n\n<section class=\"hero-bd\">\n\n \n  <section class=\"hnd-hero-spacer\" id=\"hnd-hero\">\n    <div class=\"hnd-stage\">\n\n\n      <div class=\"hnd-copy\">\n        <div class=\"hnd-eyebrow\">Field Issue — Hundred Ordnance Div.</div>\n        <h1 class=\"hnd-headline\">Your license<br>to kill.</h1>\n        <p class=\"hnd-sub\">Sealed until you're ready. The Bullet ships in one case, once.</p>\n      </div>\n\n      <div class=\"hnd-scene-wrap\">\n        <div class=\"hnd-scene\">\n          <div class=\"hnd-shadow\"></div>\n\n          <div class=\"hnd-streaks\"><div></div><div></div><div></div></div>\n\n          <div class=\"hnd-case\">\n            <div class=\"hnd-base\">\n              <div class=\"hnd-handle\"></div>\n              <div class=\"hnd-bullet-well\">\n                <svg width=\"16\" height=\"8\" viewBox=\"0 0 16 8\">\n                  <path d=\"M0 4 L4 1 H12 A3 3 0 0 1 15 4 A3 3 0 0 1 12 7 H4 Z\" fill=\"var(--brass)\"/>\n                </svg>\n              </div>\n              <div class=\"hnd-latch\"></div>\n            </div>\n            <div class=\"hnd-lid\">\n              <div class=\"hnd-lid-face\">\n                <div class=\"hnd-serial\">HND · NX80 · SEALED</div>\n              </div>\n              <div class=\"hnd-lid-inner\"></div>\n            </div>\n          </div>\n          \n          <div class=\"hnd-racket\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\" alt=\"Nitrix 80 Bullet Racket\" class=\"glow\">\n          </div>\n          \n        </div>\n      </div>\n\n   \n\n      <div class=\"hnd-cta-wrap\">\n        <button class=\"hnd-cta\" id=\"hnd-claim\" aria-label=\"Open the case and reveal the racket\">\n          Claim the racket\n          <svg viewBox=\"0 0 12 12\"><path d=\"M6 1v9M2 6l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </button>\n        <div class=\"hnd-scroll-hint\">Scroll to unseal<span class=\"line\"></span></div>\n      </div>\n\n    </div>\n  </section>\n\n \n\n<script>\n(function(){\n  var hero = document.getElementById('hnd-hero');\n  var root = document.documentElement;\n  var claimBtn = document.getElementById('hnd-claim');\n  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  function clamp(v,min,max){return Math.max(min,Math.min(max,v));}\n\n  function ease(t){ return t<0.5 ? 2*t*t : -1+(4-2*t)*t; }\n  function seg(p,start,end){ return clamp((p-start)/(end-start),0,1); }\n\n  function setProgress(p){\n    p = clamp(p,0,1);\n\n    // Phase A (0 -> 0.45): case stays shut on top of the racket, lid swings open.\n    // Phase B (0.32 -> 1): racket fades in and rises out, rotating from flat to upright.\n    var lidP = ease(seg(p, 0, 0.45));\n    var riseP = ease(seg(p, 0.32, 1));\n\n    root.style.setProperty('--lid', (130*lidP) + 'deg'); // hinge stays at the back, front edge lifts up and toward the viewer\n    root.style.setProperty('--racket-op', seg(p, 0.32, 0.5)); // hidden until the case is visibly open\n    root.style.setProperty('--racket-y', (-230*riseP) + 'px');\n    root.style.setProperty('--racket-x', '0px');\n    root.style.setProperty('--racket-z', (120*riseP) + 'px'); // pushes racket forward on the z-axis\n    root.style.setProperty('--racket-rot', (90*riseP) + 'deg'); // flat in the case -> upright\n    root.style.setProperty('--racket-scale', (0.5 + 0.65*riseP));\n    root.style.setProperty('--glow-op', seg(p, 0.4, 0.75));\n    root.style.setProperty('--crack-op', 0.55 * (1-p));\n    root.style.setProperty('--seal-op', clamp(1-(p/0.25),0,1));\n    root.style.setProperty('--brand-op', seg(p, 0.78, 1));\n    root.style.setProperty('--brand-y', (14 - 14*seg(p, 0.78, 1)) + 'px');\n\n    var headline = document.querySelector('.hnd-copy .hnd-headline');\n    var sub = document.querySelector('.hnd-copy .hnd-sub');\n    var fadeOut = clamp(1-(p/0.4),0,1);\n    headline.style.opacity = fadeOut;\n    sub.style.opacity = fadeOut;\n    headline.style.transform = 'translateY(' + (-10*(1-fadeOut)) + 'px)';\n  }\n\n  function onScroll(){\n    var rect = hero.getBoundingClientRect();\n    var total = hero.offsetHeight - window.innerHeight;\n    var scrolled = clamp(-rect.top, 0, total);\n    var p = total > 0 ? scrolled/total : 0;\n    setProgress(p);\n  }\n\n  if (!reduced){\n    document.addEventListener('scroll', function(){\n      window.requestAnimationFrame(onScroll);\n    }, {passive:true});\n    onScroll();\n  } else {\n    setProgress(0);\n  }\n\n  claimBtn.addEventListener('click', function(){\n    if (reduced){\n      setProgress(1);\n      return;\n    }\n    var total = hero.offsetHeight - window.innerHeight;\n    var targetY = hero.offsetTop + total; // scroll to fully-open state\n    window.scrollTo({top: targetY, behavior:'smooth'});\n  });\n})();\n</script>\n\n</section>",
