      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Nitrix 80 Bullet — Locked and Loaded | Hundred</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#0b0c0e;\n    --bg-alt:#131418;\n    --steel:#2a2d33;\n    --steel-light:#4a4e57;\n    --text:#ecedef;\n    --text-dim:#8a8d93;\n    --accent:#e8332b;\n    --accent-dim:#5c1512;\n    --stage-h: 420vh;\n  }\n\n  *{ margin:0; padding:0; box-sizing:border-box; }\n\n  html{ scroll-behavior:auto; background:var(--bg); }\n\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:'Manrope', sans-serif;\n    overflow-x:hidden;\n  }\n\n  ::selection{ background:var(--accent); color:#fff; }\n\n  .mono{\n    font-family:'JetBrains Mono', monospace;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n  }\n\n  h1, h2, .display{\n    font-family:'Anton', sans-serif;\n    font-weight:400;\n    text-transform:uppercase;\n    letter-spacing:0.01em;\n    line-height:0.92;\n  }\n\n  a{ color:inherit; }\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    position:fixed; top:0; left:0; right:0; z-index:100;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:22px 5vw;\n    mix-blend-mode:difference;\n  }\n  .topbar .mono{ font-size:12px; color:#fff; }\n  .topbar .logo{ font-family:'Anton', sans-serif; font-size:18px; letter-spacing:0.08em; color:#fff; }\n\n  /* ---------- reduced motion ---------- */\n  @media (prefers-reduced-motion: reduce){\n    #racket{ transition:none !important; }\n  }\n\n  /* =====================================================\n     PINNED SCROLL STAGE — racket floats through 4 chapters\n     ===================================================== */\n  .scroll-stage{\n    position:relative;\n    height:var(--stage-h);\n  }\n\n  .stage-sticky{\n    position:sticky;\n    top:0;\n    height:100vh;\n    width:100%;\n    overflow:hidden;\n    background:\n      radial-gradient(ellipse 70% 60% at 50% 40%, #17191d 0%, var(--bg) 65%);\n  }\n\n  /* faint vignette + grain-like texture, restrained */\n  .stage-sticky::before{\n    content:\"\";\n    position:absolute; inset:0;\n    background:\n      linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 15%, rgba(0,0,0,0) 85%, rgba(0,0,0,0.6) 100%);\n    pointer-events:none;\n    z-index:5;\n  }\n\n  .stage-floor{\n    position:absolute; left:0; right:0; bottom:0; height:35%;\n    background:linear-gradient(180deg, rgba(232,51,43,0) 0%, rgba(232,51,43,0.05) 100%);\n    border-top:1px solid rgba(255,255,255,0.04);\n    pointer-events:none;\n  }\n\n  /* the racket itself — perspective wrapper + transformed object */\n  .racket-perspective{\n    position:absolute; inset:0;\n    display:flex; align-items:center; justify-content:center;\n    perspective:1400px;\n    z-index:3;\n    pointer-events:none;\n  }\n\n  #racket{\n    width:min(46vw, 420px);\n    filter:drop-shadow(0 30px 60px rgba(0,0,0,0.6));\n    transform-style:preserve-3d;\n    will-change:transform;\n    transition:filter 0.4s ease;\n  }\n\n  #racket .shaft-glow{ filter:drop-shadow(0 0 10px var(--accent)); }\n\n  /* chapter labels — small tactical tick, not a full HUD */\n  .spec-tick{\n    position:absolute; z-index:6;\n    font-size:11px; color:var(--accent);\n    display:flex; align-items:center; gap:8px;\n  }\n  .spec-tick::before{ content:\"\"; width:22px; height:1px; background:var(--accent); display:inline-block; }\n\n  /* content chapters, stacked and cross-faded by scroll progress */\n  .stage-content{\n    position:absolute; inset:0; z-index:4;\n  }\n  .chapter{\n    position:absolute; inset:0;\n    display:flex; flex-direction:column; justify-content:center;\n    padding:0 6vw;\n    opacity:0;\n    pointer-events:none;\n  }\n  .chapter .eyebrow{\n    font-size:11px; color:var(--accent); margin-bottom:18px;\n    display:flex; align-items:center; gap:10px;\n  }\n  .chapter .eyebrow::before{ content:\"\"; width:26px; height:1px; background:var(--accent); }\n  .chapter h2{\n    font-size:clamp(38px, 6.4vw, 92px);\n    max-width:11ch;\n    color:var(--text);\n  }\n  .chapter p{\n    margin-top:22px;\n    max-width:42ch;\n    color:var(--text-dim);\n    font-size:16px;\n    line-height:1.6;\n  }\n  .chapter .stat{\n    margin-top:28px;\n    display:flex; align-items:baseline; gap:14px;\n  }\n  .chapter .stat .num{\n    font-family:'Anton', sans-serif;\n    font-size:56px;\n    color:var(--accent);\n    line-height:1;\n  }\n  .chapter .stat .unit{ font-size:12px; color:var(--text-dim); max-width:16ch; line-height:1.4; }\n\n  /* right-aligned chapters (alternate for depth/rhythm) */\n  .chapter.align-right{ align-items:flex-end; text-align:right; }\n  .chapter.align-right p{ margin-left:auto; }\n  .chapter.align-right .stat{ flex-direction:row-reverse; }\n\n  /* scroll cue on chapter 0 only */\n  .scroll-cue{\n    position:absolute; bottom:36px; left:50%; transform:translateX(-50%);\n    font-size:10px; color:var(--text-dim); z-index:6;\n    display:flex; flex-direction:column; align-items:center; gap:10px;\n  }\n  .scroll-cue .line{ width:1px; height:34px; background:linear-gradient(180deg, var(--accent), transparent); animation:cue-pulse 1.8s ease-in-out infinite; }\n  @keyframes cue-pulse{ 0%,100%{ opacity:0.3; } 50%{ opacity:1; } }\n\n  /* progress rail, far right */\n  .progress-rail{\n    position:fixed; right:5vw; top:50%; transform:translateY(-50%);\n    z-index:50; display:flex; flex-direction:column; gap:16px;\n  }\n  .progress-rail .dot{\n    width:6px; height:6px; border-radius:50%;\n    background:var(--steel-light);\n    transition:background 0.3s ease, transform 0.3s ease;\n  }\n  .progress-rail .dot.active{ background:var(--accent); transform:scale(1.6); }\n\n  /* =====================================================\n     TESTIMONIALS\n     ===================================================== */\n  .testimonials{\n    background:var(--bg-alt);\n    padding:140px 6vw;\n    border-top:1px solid rgba(255,255,255,0.06);\n  }\n  .testimonials .section-head{ margin-bottom:70px; }\n  .testimonials .eyebrow{\n    font-size:11px; color:var(--accent); margin-bottom:16px;\n    display:flex; align-items:center; gap:10px;\n  }\n  .testimonials .eyebrow::before{ content:\"\"; width:26px; height:1px; background:var(--accent); }\n  .testimonials h2{ font-size:clamp(30px, 4vw, 52px); max-width:14ch; }\n\n  .quote-grid{\n    display:grid;\n    grid-template-columns:repeat(3, 1fr);\n    gap:1px;\n    background:rgba(255,255,255,0.06);\n    border:1px solid rgba(255,255,255,0.06);\n  }\n  .quote-card{\n    background:var(--bg-alt);\n    padding:40px 34px;\n  }\n  .quote-card p{\n    font-size:17px; line-height:1.6; color:var(--text);\n    margin-bottom:26px;\n  }\n  .quote-card .who{ font-size:12px; color:var(--text-dim); }\n  .quote-card .who b{ color:var(--text); font-weight:600; }\n\n  @media (max-width:820px){\n    .quote-grid{ grid-template-columns:1fr; }\n  }\n\n  /* placeholder-content note */\n  .content-note{\n    margin-top:26px; font-size:11px; color:var(--text-dim);\n  }\n\n  /* =====================================================\n     CLOSING CTA\n     ===================================================== */\n  .closing{\n    position:relative;\n    min-height:100vh;\n    display:flex; flex-direction:column; align-items:center; justify-content:center;\n    text-align:center;\n    padding:120px 6vw 200px;\n    background:\n      radial-gradient(ellipse 60% 50% at 50% 20%, rgba(232,51,43,0.10) 0%, transparent 60%),\n      var(--bg);\n    border-top:1px solid rgba(255,255,255,0.06);\n    overflow:hidden;\n  }\n  .closing .eyebrow{\n    font-size:11px; color:var(--accent); margin-bottom:22px;\n    display:flex; align-items:center; gap:10px;\n  }\n  .closing .eyebrow::before, .closing .eyebrow::after{ content:\"\"; width:26px; height:1px; background:var(--accent); }\n  .closing h2{\n    font-size:clamp(42px, 8vw, 108px);\n    max-width:14ch;\n  }\n  .closing .price-line{\n    margin-top:28px; font-size:15px; color:var(--text-dim);\n  }\n  .closing .price-line .amount{ color:var(--text); font-weight:700; }\n\n  .btn-primary{\n    margin-top:44px;\n    display:inline-flex; align-items:center; gap:12px;\n    background:var(--accent); color:#fff;\n    padding:18px 38px;\n    font-size:13px; letter-spacing:0.14em; text-transform:uppercase;\n    font-weight:600; font-family:'Manrope', sans-serif;\n    border:none; cursor:pointer;\n    transition:transform 0.25s ease, background 0.25s ease;\n  }\n  .btn-primary:hover{ background:#ff433a; transform:translateY(-2px); }\n\n  .closing .fine-print{\n    margin-top:22px; font-size:11px; color:var(--text-dim);\n  }\n\n  /* faint ghost racket silhouette behind closing headline */\n  .closing .ghost-racket{\n    position:absolute; top:50%; left:50%;\n    width:60vw; max-width:640px;\n    transform:translate(-50%,-46%) rotate(8deg);\n    opacity:0.05;\n    z-index:0;\n    pointer-events:none;\n  }\n  .closing > *{ position:relative; z-index:1; }\n\n  /* =====================================================\n     STICKY BUY BAR\n     ===================================================== */\n  .sticky-buy{\n    position:fixed; left:0; right:0; bottom:0; z-index:90;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:16px 5vw;\n    background:rgba(11,12,14,0.86);\n    backdrop-filter:blur(14px);\n    border-top:1px solid rgba(255,255,255,0.08);\n    transform:translateY(120%);\n    transition:transform 0.4s ease;\n  }\n  .sticky-buy.show{ transform:translateY(0); }\n  .sticky-buy .info{ display:flex; align-items:center; gap:16px; }\n  .sticky-buy .name{ font-size:13px; font-weight:700; }\n  .sticky-buy .price{ font-size:13px; color:var(--text-dim); }\n  .sticky-buy .btn-primary{ margin:0; padding:12px 26px; font-size:11px; }\n\n  @media (max-width:640px){\n    .sticky-buy .name{ display:; }\n.racket{\nwidth: 100px;\n}\n  }\n\n  footer{\n    padding:40px 6vw 120px;\n    text-align:center;\n    font-size:11px;\n    color:var(--text-dim);\n    background:var(--bg);\n  }\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">\n  <div class=\"logo\">HUNDRED</div>\n  <div class=\"mono\">Nitrix 80 · Bullet</div>\n</div>\n\n<div class=\"progress-rail\" id=\"progressRail\">\n  <div class=\"dot\" data-i=\"0\"></div>\n  <div class=\"dot\" data-i=\"1\"></div>\n  <div class=\"dot\" data-i=\"2\"></div>\n  <div class=\"dot\" data-i=\"3\"></div>\n</div>\n\n<!-- ============ PINNED SCROLL STAGE ============ -->\n<div class=\"scroll-stage\" id=\"scrollStage\">\n  <div class=\"stage-sticky\">\n\n    <div class=\"racket-perspective\">\n     <img class=\"racket\" id=\"racket\" style=\"width: 200px;\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/DSC02022.png?v=1786519768\"/>\n    </div>\n\n    <div class=\"stage-floor\"></div>\n\n    <div class=\"stage-content\" id=\"stageContent\">\n      <section class=\"chapter\" data-i=\"0\">\n        <div class=\"eyebrow mono\">Nitrix 80 · Bullet</div>\n        <h2>Locked and<br>loaded.</h2>\n        <p>Hundred's most expensive racket, built for one job — the kill. Every gram cut, every fibre tuned for the smash that ends the rally.</p>\n      </section>\n\n      <section class=\"chapter align-right\" data-i=\"1\">\n        <div class=\"eyebrow mono\">Spec 01 — Shaft</div>\n        <h2>5.9mm.<br>Thinnest<br>we've built.</h2>\n        <div class=\"stat\">\n          <div class=\"num\">5.9<span style=\"font-size:22px;\">mm</span></div>\n          <div class=\"unit\">vs. Hundred's standard 7mm shaft — less flex loss, more energy straight into the shuttle.</div>\n        </div>\n      </section>\n\n      <section class=\"chapter\" data-i=\"2\">\n        <div class=\"eyebrow mono\">Spec 02 — Series</div>\n        <h2>Built to<br>attack.</h2>\n        <p>The Bullet sits at the sharp end of Hundred's attacking series — stiffer, faster, engineered to close rallies before they open up.</p>\n      </section>\n\n      <section class=\"chapter align-right\" data-i=\"3\">\n        <div class=\"eyebrow mono\">Spec 03 — Craft</div>\n        <h2>The one<br>above all.</h2>\n        <p>Hand-finished, individually numbered, and priced like the flagship it is. Not a racket for every player — a racket for the point that matters.</p>\n      </section>\n    </div>\n\n    <div class=\"scroll-cue\" id=\"scrollCue\">\n      <span>SCROLL</span>\n      <div class=\"line\"></div>\n    </div>\n  </div>\n</div>\n\n<!-- ============ TESTIMONIALS (placeholder copy) ============ -->\n<section class=\"testimonials\">\n  <div class=\"section-head\">\n    <div class=\"eyebrow mono\">In the hands</div>\n    <h2>Players who've felt the shaft flex.</h2>\n    <div class=\"content-note\">Placeholder quotes — swap in real athlete / early-access tester feedback before launch.</div>\n  </div>\n  <div class=\"quote-grid\">\n    <div class=\"quote-card\">\n      <p>\"The thinnest shaft I've played and somehow the most stable through the smash. Takes a session to trust it, then you never go back.\"</p>\n      <div class=\"who mono\"><b>State-level singles player</b><br>Bengaluru</div>\n    </div>\n    <div class=\"quote-card\">\n      <p>\"Every attacking racket claims speed. This is the first one where I actually felt the head arrive before I expected it to.\"</p>\n      <div class=\"who mono\"><b>Club coach, 12 yrs</b><br>Hyderabad</div>\n    </div>\n    <div class=\"quote-card\">\n      <p>\"It's priced like a flagship and plays like one. Not a racket I'd hand a beginner — exactly why I wanted it.\"</p>\n      <div class=\"who mono\"><b>Competitive doubles player</b></div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CLOSING CTA ============ -->\n<section class=\"closing\">\n  <svg class=\"ghost-racket\" viewBox=\"0 0 300 640\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <ellipse cx=\"150\" cy=\"120\" rx=\"118\" ry=\"112\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"6\"/>\n    <line x1=\"150\" y1=\"230\" x2=\"150\" y2=\"620\" stroke=\"#ffffff\" stroke-width=\"3\"/>\n  </svg>\n  <div class=\"eyebrow mono\">Pre-order now</div>\n  <h2>Claim your<br>license to kill.</h2>\n  <div class=\"price-line\">Limited first run · <span class=\"amount\">₹[PRICE]</span> · Ships [DATE]</div>\n  <button class=\"btn-primary\">Reserve the Bullet →</button>\n  <div class=\"fine-print\">Email capture via Klaviyo on reservation. Numbered units, first come first served.</div>\n</section>\n\n<footer>© Hundred India — in.hndrd.co</footer>\n\n<div class=\"sticky-buy\" id=\"stickyBuy\">\n  <div class=\"info\">\n    <span class=\"name\">Nitrix 80 Bullet</span>\n    <span class=\"price\">₹[PRICE]</span>\n  </div>\n  <button class=\"btn-primary\">Reserve now</button>\n</div>\n\n<script>\n(function(){\n  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  var stage = document.getElementById('scrollStage');\n  var racket = document.getElementById('racket');\n  var chapters = Array.prototype.slice.call(document.querySelectorAll('.chapter'));\n  var dots = Array.prototype.slice.call(document.querySelectorAll('.progress-rail .dot'));\n  var stickyBuy = document.getElementById('stickyBuy');\n  var scrollCue = document.getElementById('scrollCue');\n\n  // Waypoints: [rotateY, rotateX, translateX(%), translateY(%), scale]\n  var waypoints = [\n    [-26,  6,   0,   2, 1.00],\n    [ 88, -2, -20,  -4, 1.16],\n    [ 16, -10, 20,   4, 1.32],\n    [  0,   0,  0,   0, 1.55]\n  ];\n\n  function lerp(a, b, t){ return a + (b - a) * t; }\n\n  function sampleWaypoints(progress){\n    // progress: 0..1 across 4 waypoints (3 segments)\n    var segCount = waypoints.length - 1;\n    var scaled = progress * segCount;\n    var seg = Math.min(Math.floor(scaled), segCount - 1);\n    var t = scaled - seg;\n    var a = waypoints[seg], b = waypoints[seg + 1];\n    return [\n      lerp(a[0], b[0], t),\n      lerp(a[1], b[1], t),\n      lerp(a[2], b[2], t),\n      lerp(a[3], b[3], t),\n      lerp(a[4], b[4], t)\n    ];\n  }\n\n  function smoothstep(edge0, edge1, x){\n    var t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));\n    return t * t * (3 - 2 * t);\n  }\n\n  var ticking = false;\n\n  function update(){\n    ticking = false;\n    var rect = stage.getBoundingClientRect();\n    var vh = window.innerHeight;\n    var stageHeight = stage.offsetHeight;\n    var scrolled = -rect.top;\n    var travel = stageHeight - vh;\n    var progress = travel > 0 ? Math.min(1, Math.max(0, scrolled / travel)) : 0;\n\n    // racket transform\n    if (!reduceMotion){\n      var p = sampleWaypoints(progress);\n      racket.style.transform =\n        'translate3d(' + p[2] + '%, ' + p[3] + '%, 0) ' +\n        'rotateY(' + p[0] + 'deg) rotateX(' + p[1] + 'deg) ' +\n        'scale(' + p[4] + ')';\n    }\n\n    // chapter cross-fade, 4 even segments\n    var segSize = 1 / chapters.length;\n    chapters.forEach(function(ch, i){\n      var segStart = i * segSize;\n      var segEnd = segStart + segSize;\n      var fadeIn = (i === 0) ? 1 : smoothstep(segStart, segStart + segSize * 0.28, progress);\n      var fadeOut = (i === chapters.length - 1) ? 1 : 1 - smoothstep(segEnd - segSize * 0.28, segEnd, progress);\n      var opacity = Math.max(0, Math.min(fadeIn, fadeOut));\n      ch.style.opacity = opacity;\n      ch.style.transform = 'translateY(' + (1 - opacity) * 18 + 'px)';\n    });\n\n    if (dots.length){\n      var activeIdx = Math.min(chapters.length - 1, Math.floor(progress * chapters.length));\n      dots.forEach(function(d, i){ d.classList.toggle('active', i === activeIdx); });\n    }\n\n    scrollCue.style.opacity = 1 - smoothstep(0, 0.06, progress);\n\n    stickyBuy.classList.toggle('show', window.scrollY > vh * 0.9);\n  }\n\n  function onScroll(){\n    if (!ticking){\n      requestAnimationFrame(update);\n      ticking = true;\n    }\n  }\n\n  window.addEventListener('scroll', onScroll, { passive: true });\n  window.addEventListener('resize', onScroll);\n  update();\n})();\n</script>\n\n</body>\n</html>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 52
      }
