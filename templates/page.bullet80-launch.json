        "custom_liquid": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700&display=swap');\n\n.center-secret{\n  --cyan:#7ff2ff;\n  --white:#f7fbfc;\n  --muted:#aab4ba;\n  position:relative;\n  width:100%;\n  overflow:hidden;\n  isolation:isolate;\n  padding:42px 20px 48px;\n  color:var(--white);\n  font-family:\"Oxanium\",sans-serif;\n  background:#000;\n}\n\n.cs-topcopy{\n  position:relative;\n  z-index:6;\n  margin:0 auto 28px;\n  text-align:center;\n  color:#b7c1c7;\n  font-size:clamp(14px,1.4vw,20px);\n  font-weight:500;\n  line-height:1.4;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.cs-topcopy span{\n  color:var(--cyan);\n  text-shadow:0 0 14px rgba(127,242,255,.42);\n}\n\n.cs-wrap{\n  position:relative;\n  z-index:2;\n  width:min(1120px,100%);\n  min-height:760px;\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:minmax(220px,1fr) minmax(330px,430px) minmax(220px,1fr);\n  gap:28px 32px;\n  align-items:center;\n  justify-content:center;\n}\n\n.cs-col{\n  position:relative;\n  z-index:5;\n  width:100%;\n  display:flex;\n  flex-direction:column;\n  justify-content:center;\n  gap:94px;\n}\n\n.cs-col.left,\n.cs-col.right{\n  align-items:center;\n  text-align:center;\n}\n\n.cs-card{\n  width:100%;\n  max-width:270px;\n  position:relative;\n  z-index:5;\n}\n\n.cs-col.right .cs-card,\n.cs-col.left .cs-card{\n  margin-left:auto;\n  margin-right:auto;\n}\n\n.cs-value{\n  display:flex;\n  align-items:baseline;\n  gap:8px;\n  min-height:48px;\n  color:#f4f6f7;\n  font-size:clamp(28px,2.55vw,44px);\n  font-weight:500;\n  line-height:1;\n  letter-spacing:.04em;\n  text-transform:uppercase;\n  white-space:nowrap;\n  text-shadow:\n    0 2px 8px #000,\n    0 0 12px #000;\n}\n\n.cs-col.right .cs-value,\n.cs-col.left .cs-value{\n  justify-content:center;\n}\n\n.cs-number{\n  display:inline-block;\n  flex:none;\n  color:var(--cyan);\n  text-align:right;\n  line-height:1;\n  font-variant-numeric:tabular-nums;\n  font-feature-settings:\"tnum\";\n  text-shadow:\n    0 0 8px rgba(127,242,255,.9),\n    0 0 18px rgba(127,242,255,.35),\n    0 1px 6px rgba(0,0,0,.65);\n  transition:opacity .05s linear;\n}\n\n.cs-number[data-spec=\"thickness\"]{\n  width:3.2ch;\n}\n\n\n.cs-number.changing{\n  opacity:.35;\n}\n\n.cs-feature{\n  display:inline-block;\n  width:1.05ch;\n  flex:0 0 1.05ch;\n  color:var(--cyan);\n  text-align:center;\n  text-shadow:\n    0 0 8px rgba(127,242,255,.95),\n    0 0 18px rgba(127,242,255,.35),\n    0 1px 6px rgba(0,0,0,.65);\n  transition:opacity .07s linear,filter .07s linear;\n}\n\n.cs-feature.changing{\n  opacity:.25;\n  filter:blur(1px);\n}\n\n.cs-unit{\n  color:#f7fbfc;\n  font-size:.78em;\n}\n\n.cs-label{\n  margin-top:11px;\n  color:#9ca6ac;\n  font-size:10px;\n  font-weight:500;\n  line-height:1.4;\n  letter-spacing:.23em;\n  text-transform:uppercase;\n  white-space:normal;\n  text-align:center;\n  text-shadow:0 2px 8px #000;\n}\n\n.cs-middle{\n  position:relative;\n  z-index:1;\n  width:100%;\n  min-height:760px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.cs-racket{\n  position:relative;\n  z-index:1;\n  width:430px;\n  max-width:none;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  animation:csFloat 5.5s ease-in-out infinite;\n}\n\n.cs-racket:after{\n  display:none;\n}\n\n.cs-racket img{\n  position:relative;\n  z-index:1;\n  display:block;\n  width:100%;\n  height:auto;\n  object-fit:contain;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n\n.cs-racket-main{\n  opacity:.9;\n  filter:\n    brightness(1.15)\n    contrast(1.15)\n    saturate(.45);\n}\n\n.cs-bottom{\n  position:relative;\n  z-index:6;\n  margin:28px auto 0;\n  text-align:center;\n}\n\n.cs-bottom-title{\n  color:#f7fbfc;\n  font-size:clamp(19px,1.9vw,28px);\n  font-weight:600;\n  line-height:1.3;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy{\n  margin-top:10px;\n  color:#aab4ba;\n  font-size:clamp(10px,.95vw,14px);\n  font-weight:500;\n  line-height:1.5;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy span{\n  color:var(--cyan);\n}\n\n@keyframes csFloat{\n  0%,100%{\n    transform:translateY(0);\n  }\n\n  50%{\n    transform:translateY(-5px);\n  }\n}\n\n@media(max-width:900px){\n  .center-secret{\n    padding:36px 14px 42px;\n  }\n\n  .cs-wrap{\n    width:min(850px,100%);\n    min-height:680px;\n    grid-template-columns:\n      minmax(160px,1fr)\n      minmax(250px,320px)\n      minmax(160px,1fr);\n    gap:22px 16px;\n  }\n\n  .cs-col{\n    gap:72px;\n  }\n\n  .cs-middle{\n    min-height:680px;\n  }\n\n  .cs-racket{\n    width:340px;\n  }\n\n  .cs-value{\n    font-size:clamp(21px,3vw,32px);\n  }\n\n  .cs-label{\n    font-size:8px;\n    letter-spacing:.15em;\n  }\n}\n\n/* MOBILE ONLY */\n@media(max-width:640px){\n  .center-secret{\n    padding:16px 10px 20px;\n  }\n\n  .cs-topcopy{\n    width:min(360px,96%);\n    margin:0 auto 4px;\n    font-size:11px;\n    line-height:1.35;\n    letter-spacing:.08em;\n  }\n\n  .cs-wrap{\n    width:min(430px,100%);\n    min-height:0;\n    height:500px;\n    margin:0 auto;\n    grid-template-columns:\n      minmax(76px,1fr)\n      minmax(142px,172px)\n      minmax(76px,1fr);\n    gap:0 2px;\n    align-items:center;\n  }\n\n  .cs-col{\n    gap:42px;\n  }\n\n  .cs-col.left,\n  .cs-col.right{\n    align-items:center;\n    transform:none;\n  }\n\n  .cs-card{\n    width:100%;\n    max-width:112px;\n  }\n\n  .cs-col.right .cs-card,\n  .cs-col.left .cs-card{\n    margin-left:auto;\n    margin-right:auto;\n  }\n\n  .cs-middle{\n    grid-column:2;\n    grid-row:1;\n    min-height:0;\n    height:500px;\n    overflow:visible;\n  }\n\n  .cs-racket{\n    width:280px;\n    max-width:none;\n  }\n\n  .cs-racket-main{\n    opacity:.82;\n    filter:\n      brightness(1.12)\n      contrast(1.14)\n      saturate(.38);\n  }\n\n  .cs-value{\n    min-height:24px;\n    gap:4px;\n    font-size:clamp(16px,4.6vw,21px);\n    letter-spacing:0;\n  }\n\n  .cs-col.right .cs-value,\n  .cs-col.left .cs-value{\n    justify-content:center;\n  }\n\n  .cs-label{\n    margin-top:5px;\n    font-size:6.5px;\n    line-height:1.35;\n    letter-spacing:.08em;\n    white-space:normal;\n  }\n\n  .cs-number[data-spec=\"thickness\"]{\n    width:3.15ch;\n  }\n\n\n  .cs-bottom{\n    width:min(360px,96%);\n    margin:4px auto 0;\n  }\n\n  .cs-bottom-title{\n    font-size:16px;\n    letter-spacing:.1em;\n  }\n\n  .cs-bottom-copy{\n    margin-top:5px;\n    font-size:8px;\n    letter-spacing:.08em;\n  }\n}\n\n@media(max-width:380px){\n  .center-secret{\n    padding:14px 6px 18px;\n  }\n\n  .cs-topcopy{\n    margin-bottom:2px;\n    font-size:9px;\n  }\n\n  .cs-wrap{\n    height:450px;\n    min-height:0;\n    grid-template-columns:\n      minmax(82px,1fr)\n      minmax(138px,160px)\n      minmax(82px,1fr);\n    gap:0;\n  }\n\n  .cs-col{\n    gap:34px;\n  }\n\n  .cs-col.left,\n  .cs-col.right{\n    transform:none;\n  }\n\n  .cs-middle{\n    height:450px;\n    min-height:0;\n  }\n\n  .cs-racket{\n    width:250px;\n  }\n\n  .cs-card{\n    max-width:98px;\n  }\n\n  .cs-value{\n    min-height:22px;\n    font-size:14px;\n  }\n\n  .cs-label{\n    margin-top:4px;\n    font-size:5.8px;\n  }\n\n  .cs-bottom{\n    margin-top:2px;\n  }\n\n  .cs-bottom-title{\n    font-size:13px;\n  }\n\n  .cs-bottom-copy{\n    font-size:7px;\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  .center-secret *{\n    animation:none!important;\n  }\n}\n</style>\n\n<section class=\"center-secret\">\n\n  <div class=\"cs-topcopy\">\n    Performance Profile\n    <span>Remains Encrypted</span>\n  </div>\n\n  <div class=\"cs-wrap\">\n\n    <div class=\"cs-col left\">\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"thickness\">4.8</span>\n          <span class=\"cs-unit\">MM</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Shaft Thickness\n        </div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-feature\" data-cycle>X</span>\n          <span class=\"cs-unit\">-WRAP</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Handle System\n        </div>\n      </article>\n    </div>\n\n    <div class=\"cs-middle\">\n      <div class=\"cs-racket\">\n        <img\n          class=\"cs-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/unnamed_1e54a0c3-6ff5-4211-a254-e5f69f0e4005.png?v=1785997513\"\n          alt=\"Secret badminton racket\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n    </div>\n\n    <div class=\"cs-col right\">\n<article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">HEAD-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Stability Tech\n        </div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">POWER-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Energy Transfer\n        </div>\n      </article>\n\n    </div>\n\n  </div>\n\n  <div class=\"cs-bottom\">\n\n    <div class=\"cs-bottom-title\">\n      Specifications Classified\n    </div>\n\n    <div class=\"cs-bottom-copy\">\n      Final performance data\n      <span>stays hidden</span>\n    </div>\n\n  </div>\n\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n\n  if (!section || section.dataset.initialized) return;\n\n  section.dataset.initialized = \"true\";\n\n  const thickness = section.querySelector(\n    '[data-spec=\"thickness\"]'\n  );\n\n  const featureLetters = section.querySelectorAll(\n    \"[data-cycle]\"\n  );\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const randomThickness = () =>\n    (randomInt(40,60) / 10).toFixed(1);\n\n  const swapNumber = (element,value) => {\n    if (!element || element.textContent === String(value)) {\n      return;\n    }\n\n    element.classList.add(\"changing\");\n\n    window.setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  let numberTimers = [];\n  let letterTimers = [];\n\n  const startAnimations = () => {\n    if (numberTimers.length || letterTimers.length) {\n      return;\n    }\n\n    numberTimers.push(\n      window.setInterval(() => {\n        swapNumber(\n          thickness,\n          randomThickness()\n        );\n      },160)\n    );\n\n    const characters = [\"X\",\"Y\",\"Z\"];\n\n    featureLetters.forEach((element,index) => {\n      let characterIndex = index % characters.length;\n\n      const timer = window.setInterval(() => {\n        element.classList.add(\"changing\");\n\n        window.setTimeout(() => {\n          characterIndex =\n            (characterIndex + 1) % characters.length;\n\n          element.textContent =\n            characters[characterIndex];\n\n          element.classList.remove(\"changing\");\n        },65);\n\n      },380 + index * 45);\n\n      letterTimers.push(timer);\n    });\n  };\n\n  const stopAnimations = () => {\n    numberTimers.forEach(clearInterval);\n    letterTimers.forEach(clearInterval);\n\n    numberTimers = [];\n    letterTimers = [];\n  };\n\n  const observer = new IntersectionObserver(\n    entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          startAnimations();\n        } else {\n          stopAnimations();\n        }\n      });\n    },\n    {\n      threshold:.08\n    }\n  );\n\n  observer.observe(section);\n})();\n</script>",
