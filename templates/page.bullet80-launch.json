        "custom_liquid": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700&display=swap');\n\n.center-secret{\n  --cyan:#7ff2ff;\n  --white:#f7fbfc;\n  --muted:#aab4ba;\n  position:relative;\n  width:100%;\n  overflow:hidden;\n  isolation:isolate;\n  padding:42px 20px 48px;\n  color:var(--white);\n  font-family:\"Oxanium\",sans-serif;\n  background:#000;\n}\n\n.cs-topcopy{\n  position:relative;\n  z-index:8;\n  margin:0 auto 18px;\n  text-align:center;\n  color:#b7c1c7;\n  font-size:clamp(14px,1.4vw,20px);\n  font-weight:500;\n  line-height:1.4;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.cs-topcopy span{\n  color:var(--cyan);\n  text-shadow:0 0 14px rgba(127,242,255,.42);\n}\n\n.cs-wrap{\n  position:relative;\n  z-index:2;\n  width:min(1240px,100%);\n  min-height:720px;\n  margin:0 auto;\n}\n\n.cs-card{\n  position:absolute;\n  z-index:6;\n  width:max-content;\n  max-width:280px;\n}\n\n.cs-value{\n  display:flex;\n  align-items:baseline;\n  gap:8px;\n  min-height:48px;\n  color:#f4f6f7;\n  font-size:clamp(25px,2.35vw,38px);\n  font-weight:500;\n  line-height:1;\n  letter-spacing:.04em;\n  text-transform:uppercase;\n  white-space:nowrap;\n  text-shadow:\n    0 2px 8px #000,\n    0 0 12px #000;\n}\n\n.cs-primary{\n  left:2.5%;\n  top:50%;\n  transform:translateY(-50%);\n  text-align:left;\n}\n\n.cs-primary .cs-value{\n  min-height:70px;\n  font-size:clamp(48px,5vw,68px);\n  font-weight:600;\n  letter-spacing:.01em;\n}\n\n.cs-primary .cs-label{\n  margin-top:13px;\n  font-size:clamp(12px,1.15vw,16px);\n  font-weight:700;\n  letter-spacing:.19em;\n}\n\n.cs-parabolic{\n  position:absolute;\n  z-index:5;\n  left:33%;\n  top:8%;\n  width:34%;\n  height:84%;\n  pointer-events:none;\n}\n\n.cs-parabolic .cs-card{\n  text-align:right;\n}\n\n.cs-parabolic .cs-value{\n  justify-content:flex-end;\n}\n\n.cs-curve-one{\n  left:0;\n  top:2%;\n}\n\n.cs-curve-two{\n  left:24%;\n  top:50%;\n  transform:translateY(-50%);\n}\n\n.cs-curve-three{\n  left:0;\n  bottom:2%;\n}\n\n.cs-number{\n  display:inline-block;\n  flex:none;\n  color:var(--cyan);\n  text-align:right;\n  line-height:1;\n  font-variant-numeric:tabular-nums;\n  font-feature-settings:\"tnum\";\n  text-shadow:\n    0 0 8px rgba(127,242,255,.9),\n    0 0 18px rgba(127,242,255,.35),\n    0 1px 6px rgba(0,0,0,.65);\n  transition:opacity .05s linear;\n}\n\n.cs-number[data-spec=\"thickness\"]{\n  width:3.2ch;\n}\n\n.cs-number.changing{\n  opacity:.35;\n}\n\n.cs-feature{\n  display:inline-block;\n  width:1.05ch;\n  flex:0 0 1.05ch;\n  color:var(--cyan);\n  text-align:center;\n  text-shadow:\n    0 0 8px rgba(127,242,255,.95),\n    0 0 18px rgba(127,242,255,.35),\n    0 1px 6px rgba(0,0,0,.65);\n  transition:opacity .07s linear,filter .07s linear;\n}\n\n.cs-feature.changing{\n  opacity:.25;\n  filter:blur(1px);\n}\n\n.cs-unit{\n  color:#f7fbfc;\n  font-size:.78em;\n}\n\n.cs-label{\n  margin-top:10px;\n  color:#9ca6ac;\n  font-size:10px;\n  font-weight:500;\n  line-height:1.4;\n  letter-spacing:.21em;\n  text-transform:uppercase;\n  white-space:nowrap;\n  text-shadow:0 2px 8px #000;\n}\n\n.cs-racket-zone{\n  position:absolute;\n  z-index:2;\n  top:50%;\n  right:-74px;\n  width:510px;\n  transform:translateY(-50%);\n  display:flex;\n  align-items:center;\n  justify-content:flex-end;\n  pointer-events:none;\n}\n\n.cs-racket{\n  position:relative;\n  z-index:1;\n  width:100%;\n  max-width:none;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  animation:csFloat 5.5s ease-in-out infinite;\n}\n\n.cs-racket img{\n  position:relative;\n  z-index:1;\n  display:block;\n  width:100%;\n  height:auto;\n  object-fit:contain;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n\n.cs-racket-main{\n  opacity:.9;\n  filter:\n    brightness(1.15)\n    contrast(1.15)\n    saturate(.45);\n}\n\n.cs-bottom{\n  position:relative;\n  z-index:8;\n  margin:18px auto 0;\n  text-align:center;\n}\n\n.cs-bottom-title{\n  color:#f7fbfc;\n  font-size:clamp(19px,1.9vw,28px);\n  font-weight:600;\n  line-height:1.3;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy{\n  margin-top:10px;\n  color:#aab4ba;\n  font-size:clamp(10px,.95vw,14px);\n  font-weight:500;\n  line-height:1.5;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy span{\n  color:var(--cyan);\n}\n\n@keyframes csFloat{\n  0%,100%{\n    transform:translateY(0);\n  }\n\n  50%{\n    transform:translateY(-5px);\n  }\n}\n\n@media(max-width:1000px){\n  .cs-wrap{\n    min-height:650px;\n  }\n\n  .cs-primary{\n    left:1%;\n  }\n\n  .cs-parabolic{\n    left:31%;\n    width:35%;\n  }\n\n  .cs-racket-zone{\n    right:-84px;\n    width:450px;\n  }\n}\n\n@media(max-width:760px){\n  .center-secret{\n    padding:24px 12px 28px;\n  }\n\n  .cs-topcopy{\n    margin-bottom:4px;\n    font-size:11px;\n    letter-spacing:.09em;\n  }\n\n  .cs-wrap{\n    width:min(560px,100%);\n    min-height:570px;\n  }\n\n  .cs-primary{\n    left:2px;\n    top:52%;\n  }\n\n  .cs-primary .cs-value{\n    min-height:48px;\n    font-size:clamp(34px,9vw,48px);\n  }\n\n  .cs-primary .cs-label{\n    margin-top:7px;\n    font-size:9px;\n    letter-spacing:.11em;\n  }\n\n  .cs-parabolic{\n    left:31%;\n    top:11%;\n    width:31%;\n    height:77%;\n  }\n\n  .cs-parabolic .cs-value{\n    font-size:clamp(17px,4.8vw,24px);\n  }\n\n  .cs-curve-two{\n    left:20%;\n  }\n\n  .cs-label{\n    margin-top:5px;\n    font-size:6.5px;\n    line-height:1.3;\n    letter-spacing:.08em;\n    white-space:normal;\n  }\n\n  .cs-racket-zone{\n    right:-105px;\n    width:355px;\n  }\n\n  .cs-racket-main{\n    opacity:.84;\n    filter:\n      brightness(1.12)\n      contrast(1.14)\n      saturate(.38);\n  }\n\n  .cs-bottom{\n    width:min(360px,96%);\n    margin-top:4px;\n  }\n\n  .cs-bottom-title{\n    font-size:16px;\n    letter-spacing:.1em;\n  }\n\n  .cs-bottom-copy{\n    margin-top:5px;\n    font-size:8px;\n    letter-spacing:.08em;\n  }\n}\n\n@media(max-width:420px){\n  .center-secret{\n    padding:16px 8px 20px;\n  }\n\n  .cs-wrap{\n    min-height:500px;\n  }\n\n  .cs-primary{\n    left:0;\n    top:53%;\n  }\n\n  .cs-primary .cs-value{\n    font-size:32px;\n    gap:4px;\n  }\n\n  .cs-primary .cs-label{\n    max-width:115px;\n    font-size:8px;\n  }\n\n  .cs-parabolic{\n    left:31%;\n    top:12%;\n    width:30%;\n    height:75%;\n  }\n\n  .cs-parabolic .cs-card{\n    max-width:112px;\n  }\n\n  .cs-parabolic .cs-value{\n    min-height:23px;\n    gap:3px;\n    font-size:15px;\n    letter-spacing:0;\n  }\n\n  .cs-curve-two{\n    left:16%;\n  }\n\n  .cs-label{\n    font-size:5.8px;\n  }\n\n  .cs-racket-zone{\n    right:-102px;\n    width:305px;\n  }\n\n  .cs-bottom-title{\n    font-size:13px;\n  }\n\n  .cs-bottom-copy{\n    font-size:7px;\n  }\n}\n\n@media(max-width:360px){\n  .cs-wrap{\n    min-height:455px;\n  }\n\n  .cs-primary .cs-value{\n    font-size:28px;\n  }\n\n  .cs-primary .cs-label{\n    max-width:98px;\n    font-size:7px;\n  }\n\n  .cs-parabolic{\n    left:30%;\n    width:30%;\n  }\n\n  .cs-parabolic .cs-value{\n    font-size:13px;\n  }\n\n  .cs-racket-zone{\n    right:-96px;\n    width:275px;\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  .center-secret *{\n    animation:none!important;\n  }\n}\n</style>\n\n<section class=\"center-secret\">\n\n  <div class=\"cs-topcopy\">\n    Performance Profile\n    <span>Remains Encrypted</span>\n  </div>\n\n  <div class=\"cs-wrap\">\n\n    <article class=\"cs-card cs-primary\">\n      <div class=\"cs-value\">\n        <span class=\"cs-number\" data-spec=\"thickness\">4.8</span>\n        <span class=\"cs-unit\">MM</span>\n      </div>\n\n      <div class=\"cs-label\">\n        Shaft Thickness\n      </div>\n    </article>\n\n    <div class=\"cs-parabolic\">\n\n      <article class=\"cs-card cs-curve-one\">\n        <div class=\"cs-value\">\n          <span class=\"cs-feature\" data-cycle>X</span>\n          <span class=\"cs-unit\">-WRAP</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Handle System\n        </div>\n      </article>\n\n      <article class=\"cs-card cs-curve-two\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">HEAD-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Stability Tech\n        </div>\n      </article>\n\n      <article class=\"cs-card cs-curve-three\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">POWER-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Energy Transfer\n        </div>\n      </article>\n\n    </div>\n\n    <div class=\"cs-racket-zone\">\n      <div class=\"cs-racket\">\n        <img\n          class=\"cs-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/unnamed_1e54a0c3-6ff5-4211-a254-e5f69f0e4005.png?v=1785997513\"\n          alt=\"Secret badminton racket\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"cs-bottom\">\n\n    <div class=\"cs-bottom-title\">\n      Specifications Classified\n    </div>\n\n    <div class=\"cs-bottom-copy\">\n      Final performance data\n      <span>stays hidden</span>\n    </div>\n\n  </div>\n\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n\n  if (!section || section.dataset.initialized) return;\n\n  section.dataset.initialized = \"true\";\n\n  const thickness = section.querySelector(\n    '[data-spec=\"thickness\"]'\n  );\n\n  const featureLetters = section.querySelectorAll(\n    \"[data-cycle]\"\n  );\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const randomThickness = () =>\n    (randomInt(40,60) / 10).toFixed(1);\n\n  const swapNumber = (element,value) => {\n    if (!element || element.textContent === String(value)) {\n      return;\n    }\n\n    element.classList.add(\"changing\");\n\n    window.setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  let numberTimers = [];\n  let letterTimers = [];\n\n  const startAnimations = () => {\n    if (numberTimers.length || letterTimers.length) {\n      return;\n    }\n\n    numberTimers.push(\n      window.setInterval(() => {\n        swapNumber(\n          thickness,\n          randomThickness()\n        );\n      },160)\n    );\n\n    const characters = [\"X\",\"Y\",\"Z\"];\n\n    featureLetters.forEach((element,index) => {\n      let characterIndex = index % characters.length;\n\n      const timer = window.setInterval(() => {\n        element.classList.add(\"changing\");\n\n        window.setTimeout(() => {\n          characterIndex =\n            (characterIndex + 1) % characters.length;\n\n          element.textContent =\n            characters[characterIndex];\n\n          element.classList.remove(\"changing\");\n        },65);\n\n      },380 + index * 45);\n\n      letterTimers.push(timer);\n    });\n  };\n\n  const stopAnimations = () => {\n    numberTimers.forEach(clearInterval);\n    letterTimers.forEach(clearInterval);\n\n    numberTimers = [];\n    letterTimers = [];\n  };\n\n  const observer = new IntersectionObserver(\n    entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          startAnimations();\n        } else {\n          stopAnimations();\n        }\n      });\n    },\n    {\n      threshold:.08\n    }\n  );\n\n  observer.observe(section);\n})();\n</script>",
