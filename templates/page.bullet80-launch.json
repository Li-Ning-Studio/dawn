\n}\n\n@media(max-width:420px){\n  .center-secret{\n    padding:16px 8px 20px;\n  }\n\n  .cs-wrap{\n    min-height:500px;\n  }\n\n  .cs-primary{\n    left:0;\n    top:53%;\n  }\n\n  .cs-primary .cs-value{\n    font-size:32px;\n    gap:4px;\n  }\n\n  .cs-primary .cs-label{\n    max-width:115px;\n    font-size:8px;\n  }\n\n  .cs-parabolic{\n    left:31%;\n    top:12%;\n    width:30%;\n    height:75%;\n  }\n\n  .cs-parabolic .cs-card{\n    max-width:112px;\n  }\n\n  .cs-parabolic .cs-value{\n    min-height:23px;\n    gap:3px;\n    font-size:15px;\n    letter-spacing:0;\n  }\n\n  .cs-curve-two{\n    left:16%;\n  }\n\n  .cs-label{\n    font-size:5.8px;\n  }\n\n  .cs-racket-zone{\n    right:-102px;\n    width:305px;\n  }\n\n  .cs-bottom-title{\n    font-size:13px;\n  }\n\n  .cs-bottom-copy{\n    font-size:7px;\n  }\n}\n\n@media(max-width:360px){\n  .cs-wrap{\n    min-height:455px;\n  }\n\n  .cs-primary .cs-value{\n    font-size:28px;\n  }\n\n  .cs-primary .cs-label{\n    max-width:98px;\n    font-size:7px;\n  }\n\n  .cs-parabolic{\n    left:30%;\n    width:30%;\n  }\n\n  .cs-parabolic .cs-value{\n    font-size:13px;\n  }\n\n  .cs-racket-zone{\n    right:-96px;\n    width:275px;\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  .center-secret *{\n    animation:none!important;\n  }\n}\n</style>\n\n<section class=\"center-secret\">\n\n  <div class=\"cs-topcopy\">\n    Performance Profile\n    <span>Remains Encrypted</span>\n  </div>\n\n  <div class=\"cs-wrap\">\n\n    <article class=\"cs-card cs-primary\">\n      <div class=\"cs-value\">\n        <span class=\"cs-number\" data-spec=\"thickness\">4.8</span>\n        <span class=\"cs-unit\">MM</span>\n      </div>\n\n      <div class=\"cs-label\">\n        Shaft Thickness\n      </div>\n    </article>\n\n    <div class=\"cs-parabolic\">\n\n      <article class=\"cs-card cs-curve-one\">\n        <div class=\"cs-value\">\n          <span class=\"cs-feature\" data-cycle>X</span>\n          <span class=\"cs-unit\">-WRAP</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Handle System\n        </div>\n      </article>\n\n      <article class=\"cs-card cs-curve-two\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">HEAD-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Stability Tech\n        </div>\n      </article>\n\n      <article class=\"cs-card cs-curve-three\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">POWER-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n\n        <div class=\"cs-label\">\n          Energy Transfer\n        </div>\n      </article>\n\n    </div>\n\n    <div class=\"cs-racket-zone\">\n      <div class=\"cs-racket\">\n        <img\n          class=\"cs-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/unnamed_1e54a0c3-6ff5-4211-a254-e5f69f0e4005.png?v=1785997513\"\n          alt=\"Secret badminton racket\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"cs-bottom\">\n\n    <div class=\"cs-bottom-title\">\n      Specifications Classified\n    </div>\n\n    <div class=\"cs-bottom-copy\">\n      Final performance data\n      <span>stays hidden</span>\n    </div>\n\n  </div>\n\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n\n  if (!section || section.dataset.initialized) return;\n\n  section.dataset.initialized = \"true\";\n\n  const thickness = section.querySelector(\n    '[data-spec=\"thickness\"]'\n  );\n\n  const featureLetters = section.querySelectorAll(\n    \"[data-cycle]\"\n  );\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const randomThickness = () =>\n    (randomInt(40,60) / 10).toFixed(1);\n\n  const swapNumber = (element,value) => {\n    if (!element || element.textContent === String(value)) {\n      return;\n    }\n\n    element.classList.add(\"changing\");\n\n    window.setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  let numberTimers = [];\n  let letterTimers = [];\n\n  const startAnimations = () => {\n    if (numberTimers.length || letterTimers.length) {\n      return;\n    }\n\n    numberTimers.push(\n      window.setInterval(() => {\n        swapNumber(\n          thickness,\n          randomThickness()\n        );\n      },160)\n    );\n\n    const characters = [\"X\",\"Y\",\"Z\"];\n\n    featureLetters.forEach((element,index) => {\n      let characterIndex = index % characters.length;\n\n      const timer = window.setInterval(() => {\n        element.classList.add(\"changing\");\n\n        window.setTimeout(() => {\n          characterIndex =\n            (characterIndex + 1) % characters.length;\n\n          element.textContent =\n            characters[characterIndex];\n\n          element.classList.remove(\"changing\");\n        },65);\n\n      },380 + index * 45);\n\n      letterTimers.push(timer);\n    });\n  };\n\n  const stopAnimations = () => {\n    numberTimers.forEach(clearInterval);\n    letterTimers.forEach(clearInterval);\n\n    numberTimers = [];\n    letterTimers = [];\n  };\n\n  const observer = new IntersectionObserver(\n    entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          startAnimations();\n        } else {\n          stopAnimations();\n        }\n      });\n    },\n    {\n      threshold:.08\n    }\n  );\n\n  observer.observe(section);\n})();\n</script>",
