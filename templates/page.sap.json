    "custom_liquid_cFMhfJ": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD STUDENT AMBASSADOR PROGRAM -->\n<!-- SECTION: FAQ ACCORDION -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800;900&display=swap\" rel=\"stylesheet\">\n<style>\n.sap-faq{\n  position:relative;\n  overflow:hidden;\n  background:\n    radial-gradient(circle at 15% 100%, rgba(108,0,255,.28), transparent 40%),\n    radial-gradient(circle at 85% 10%, rgba(8,27,125,.35), transparent 45%),\n    #030213;\n  padding:100px 24px 120px;\n}\n.sap-faq::before{\n  content:\"\";\n  position:absolute;\n  width:500px;\n  height:500px;\n  bottom:-260px;\n  left:-120px;\n  background:#6C00FF;\n  filter:blur(150px);\n  opacity:.28;\n  pointer-events:none;\n}\n.sap-faq::after{\n  content:\"\";\n  position:absolute;\n  width:380px;\n  height:380px;\n  top:-160px;\n  right:-100px;\n  background:#081B7D;\n  filter:blur(130px);\n  opacity:.5;\n  pointer-events:none;\n}\n.sap-faq .in{position:relative;z-index:2;max-width:800px;margin:0 auto;}\n.sap-faq .ey{font-family:Figtree;font-size:.95rem;font-weight:700;letter-spacing:.32em;text-transform:uppercase;color:#FCEBFF;margin-bottom:16px;display:block;}\n.sap-faq .ti{font-family:Figtree;font-weight:900;font-size:clamp(2.6rem,6vw,5.5rem);line-height:1.02;letter-spacing:-.01em;text-transform:uppercase;color:#fff;margin:0;}\n.sap-faq .sub{font-family:Figtree;font-weight:500;font-size:1.05rem;color:#F0EAF8;opacity:.65;margin:18px 0 0;max-width:480px;line-height:1.6;}\n.sap-faq .list{margin-top:56px;}\n.sap-faq .fi{border-bottom:1px solid rgba(255,255,255,.1);}\n.sap-faq .fq{\n  width:100%;\n  background:none;\n  border:none;\n  color:#fff;\n  text-align:left;\n  padding:26px 0;\n  font-family:Figtree;\n  font-weight:700;\n  font-size:1.15rem;\n  letter-spacing:0;\n  line-height:1.4;\n  text-transform:none;\n  cursor:pointer;\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:20px;\n  transition:color .2s;\n}\n.sap-faq .fq:hover{color:#FCEBFF;}\n.sap-faq .fa-arrow{\n  flex-shrink:0;\n  width:32px;\n  height:32px;\n  border-radius:50%;\n  border:1.5px solid rgba(252,235,255,.5);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  transition:transform .3s ease,background .3s ease,border-color .3s ease;\n}\n.sap-faq .fa-arrow svg{width:12px;height:12px;stroke:#FCEBFF;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s ease,stroke .3s ease;}\n.sap-faq .fi.open .fq{color:#FCEBFF;}\n.sap-faq .fi.open .fa-arrow{background:#6C00FF;border-color:#6C00FF;}\n.sap-faq .fi.open .fa-arrow svg{stroke:#fff;transform:rotate(180deg);}\n.sap-faq .fa{max-height:0;overflow:hidden;font-family:Figtree;font-size:1rem;font-weight:400;color:#F0EAF8;opacity:.7;line-height:1.7;transition:max-height .35s ease,opacity .3s ease,padding-bottom .35s ease;padding-bottom:0;padding-right:52px;}\n.sap-faq .fi.open .fa{max-height:300px;padding-bottom:26px;opacity:.85;}\n\n@media(max-width:600px){\n  .sap-faq{padding:64px 20px 72px;}\n  .sap-faq::before{width:280px;height:280px;bottom:-160px;left:-100px;filter:blur(90px);opacity:.22;}\n  .sap-faq::after{width:220px;height:220px;top:-100px;right:-80px;filter:blur(80px);opacity:.4;}\n  .sap-faq .ey{font-size:.72rem;letter-spacing:.24em;margin-bottom:10px;}\n  .sap-faq .ti{font-size:2.15rem;line-height:1.08;}\n  .sap-faq .sub{font-size:.95rem;margin-top:12px;}\n  .sap-faq .list{margin-top:40px;}\n  .sap-faq .fq{padding:20px 0;font-size:1rem;gap:14px;}\n  .sap-faq .fa-arrow{width:28px;height:28px;}\n  .sap-faq .fa-arrow svg{width:10px;height:10px;}\n  .sap-faq .fa{font-size:.92rem;padding-right:0;line-height:1.65;}\n  .sap-faq .fi.open .fa{padding-bottom:20px;}\n}\n</style>\n\n<section class=\"sap-faq\">\n  <div class=\"in\">\n    <span class=\"ey\">FAQ</span>\n    <h2 class=\"ti\">Got questions?</h2>\n    <p class=\"sub\">Everything you need to know before you apply.</p>\n    <div class=\"list\">\n\n      <div class=\"fi\">\n        <button class=\"fq\">What is the HNDRD Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">The HNDRD Student Ambassador Program (SAP) gives students the opportunity to represent HNDRD on their campus, organise badminton events and activations, and help grow the badminton community in their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Who can apply for the Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Any college student who loves badminton, enjoys bringing people together, and has a knack for organising events can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What does an HNDRD Student Ambassador do?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors represent HNDRD on campus by organising badminton events and activations, engaging students, and creating a stronger badminton community within their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Do I need to be a professional badminton player to apply?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Not at all. You don't need to be a professional player. If you enjoy badminton and have the enthusiasm and ability to organise events and bring people together, you can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What do I get as an HNDRD Student Ambassador?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors receive a monthly stipend, social media exposure, a certificate, and the opportunity to work with and become a part of the HNDRD family.</div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var items = document.querySelectorAll('.sap-faq .fi');\n  items.forEach(function(item){\n    item.querySelector('.fq').addEventListener('click', function(){\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.sap-faq .fi.open').forEach(function(o){ o.classList.remove('open'); });\n      if(!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_qb69YF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&family=Jost:wght@400;500;600&display=swap' | stylesheet_tag }}\n\n<div class=\"dd-section\">\n  <div class=\"dd-inner\">\n\n    <div class=\"dd-heading dd-reveal\">\n      <p class=\"dd-eyebrow\">HNDRD Student Ambassador Program</p>\n      <h2 class=\"dd-title\">Your<br><span>Perks.</span></h2>\n      <p class=\"dd-subtitle\">Here's what you get for being part of the HNDRD Family</p>\n    </div>\n\n    <div class=\"dd-line dd-reveal\" aria-hidden=\"true\"></div>\n\n    <div class=\"dd-row\">\n\n      <div class=\"dd-card dd-card--1 dd-reveal\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag dd-sway dd-sway--a\">\n          <span class=\"dd-shine\" aria-hidden=\"true\"></span>\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">I</span>\n          <span class=\"dd-icon dd-coins\" aria-hidden=\"true\">\n            <span class=\"dd-coins__c dd-coins__c--1\"></span>\n            <span class=\"dd-coins__c dd-coins__c--2\"></span>\n            <span class=\"dd-coins__c dd-coins__c--3\">$</span>\n          </span>\n          <h3 class=\"dd-tag-title\">Stipend</h3>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--2 dd-reveal\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag dd-sway dd-sway--b\">\n          <span class=\"dd-shine\" aria-hidden=\"true\"></span>\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">II</span>\n          <span class=\"dd-icon dd-cert\" aria-hidden=\"true\">\n            <span class=\"dd-cert__rule\"></span>\n            <span class=\"dd-cert__line dd-cert__line--1\"></span>\n            <span class=\"dd-cert__line dd-cert__line--2\"></span>\n            <span class=\"dd-cert__seal\">★</span>\n          </span>\n          <h3 class=\"dd-tag-title\">Certificate</h3>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--3 dd-reveal\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag dd-sway dd-sway--a\">\n          <span class=\"dd-shine\" aria-hidden=\"true\"></span>\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">III</span>\n          <span class=\"dd-icon dd-social\" aria-hidden=\"true\">\n            <span class=\"dd-social__app dd-social__app--ig\">📷</span>\n            <span class=\"dd-social__app dd-social__app--yt\">▶</span>\n            <span class=\"dd-social__app dd-social__app--tt\">♪</span>\n            <span class=\"dd-social__app dd-social__app--x\">𝕏</span>\n          </span>\n          <h3 class=\"dd-tag-title\">Social Media<br>Exposure</h3>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--4 dd-reveal\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag dd-sway dd-sway--b\">\n          <span class=\"dd-shine\" aria-hidden=\"true\"></span>\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">IV</span>\n          <span class=\"dd-icon\">🎁</span>\n          <h3 class=\"dd-tag-title\">Free Products<br>to Try Out</h3>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--5 dd-reveal\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag dd-sway dd-sway--a\">\n          <span class=\"dd-shine\" aria-hidden=\"true\"></span>\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">V</span>\n          <span class=\"dd-icon dd-family\" aria-hidden=\"true\">\n            <span class=\"dd-family__member\">👤</span>\n            <span class=\"dd-family__member\">👤</span>\n            <span class=\"dd-family__member\">👤</span>\n          </span>\n          <h3 class=\"dd-tag-title\">Be a Part of the<br>HNDRD Family</h3>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  .dd-section{\n    background: linear-gradient(160deg, #050508 0%, #0a0a14 60%, #08060f 100%);\n    padding:80px 24px 100px;\n    position:relative;\n    overflow:hidden;\n  }\n  .dd-section::before{\n    content:'';\n    position:absolute;\n    width:460px; height:460px;\n    border-radius:50%;\n    background:rgba(76,40,137,0.45);\n    filter:blur(110px);\n    top:-160px; left:-120px;\n    pointer-events:none;\n  }\n  .dd-section::after{\n    content:'';\n    position:absolute;\n    width:480px; height:480px;\n    border-radius:50%;\n    background:rgba(60,30,130,0.4);\n    filter:blur(110px);\n    bottom:-200px; right:-140px;\n    pointer-events:none;\n  }\n  .dd-inner{\n    max-width:1180px;\n    margin:0 auto;\n    position:relative;\n    z-index:1;\n  }\n\n  .dd-heading{\n    text-align:center;\n    margin-bottom:56px;\n  }\n  .dd-eyebrow{\n    font-family:'Jost',sans-serif;\n    font-size:13px;\n    letter-spacing:0.28em;\n    text-transform:uppercase;\n    color:#c9b6f0;\n    font-weight:500;\n    margin:0 0 14px;\n  }\n  .dd-title{\n    font-family:'Poppins', sans-serif;\n    font-weight:800;\n    font-style:normal;\n    text-transform:uppercase;\n    font-size:clamp(40px, 6.4vw, 68px);\n    color:#ffffff;\n    margin:0 0 14px;\n    line-height:1.05;\n    letter-spacing:-0.01em;\n  }\n  .dd-title span{\n    display:block;\n    background:linear-gradient(100deg, #7c5cff 0%, #b79bff 55%, #7c5cff 100%);\n    background-size:220% 100%;\n    background-position:0% 0%;\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n    animation:dd-shimmer-text 5s ease-in-out 1.1s 1;\n  }\n  .dd-subtitle{\n    font-family:'Jost',sans-serif;\n    font-size:16px;\n    color:rgba(230,224,245,0.62);\n    max-width:440px;\n    margin:0 auto;\n    line-height:1.6;\n    font-weight:400;\n  }\n\n  .dd-line{\n    height:1px;\n    background:linear-gradient(90deg, rgba(180,150,255,0) 0%, #7e5fd6 15%, #7e5fd6 85%, rgba(180,150,255,0) 100%);\n    max-width:920px;\n    margin:0 auto 0;\n    position:relative;\n    transform:scaleX(0);\n    transform-origin:center;\n  }\n\n  .dd-row{\n    display:flex;\n    justify-content:center;\n    align-items:flex-start;\n    gap:34px;\n    max-width:1180px;\n    margin:0 auto;\n    flex-wrap:wrap;\n  }\n\n  .dd-card{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    width:200px;\n  }\n  .dd-card--1{ margin-top:0; }\n  .dd-card--2{ margin-top:34px; }\n  .dd-card--3{ margin-top:0; }\n  .dd-card--4{ margin-top:34px; }\n  .dd-card--5{ margin-top:0; }\n\n  .dd-thread{\n    width:1px;\n    height:30px;\n    background:linear-gradient(180deg, #7e5fd6, #4c2889);\n  }\n\n  .dd-tag{\n    position:relative;\n    width:100%;\n    background:rgba(255,255,255,0.045);\n    border:1px solid rgba(180,150,255,0.25);\n    border-radius:14px 14px 6px 6px;\n    padding:38px 20px 34px;\n    text-align:center;\n    box-shadow:0 18px 34px rgba(0,0,0,0.55);\n    backdrop-filter:blur(6px);\n    overflow:hidden;\n    transform-origin:top center;\n    transition:box-shadow 0.4s ease, border-color 0.4s ease, transform 0.4s ease;\n  }\n  .dd-tag:hover{\n    box-shadow:0 26px 46px rgba(0,0,0,0.65), 0 0 0 1px rgba(180,150,255,0.4);\n    border-color:#9c7ee0;\n    transform:translateY(-6px) scale(1.02);\n  }\n  .dd-tag:hover .dd-shine{\n    animation:dd-shine-sweep 0.9s ease forwards;\n  }\n\n  .dd-shine{\n    position:absolute;\n    top:0; left:-60%;\n    width:40%; height:100%;\n    background:linear-gradient(115deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0) 100%);\n    transform:skewX(-18deg);\n    pointer-events:none;\n  }\n\n  .dd-hole{\n    position:absolute;\n    top:-13px; left:50%;\n    transform:translateX(-50%);\n    width:16px; height:16px;\n    border-radius:50%;\n    background:#08060f;\n    border:1px solid rgba(180,150,255,0.4);\n    z-index:1;\n  }\n\n  .dd-numeral{\n    display:block;\n    font-family:'Jost',sans-serif;\n    font-style:italic;\n    font-weight:600;\n    font-size:15px;\n    color:#c9b6f0;\n    letter-spacing:0.08em;\n    margin-bottom:14px;\n    position:relative;\n    z-index:1;\n  }\n\n  .dd-icon{\n    display:block;\n    font-size:34px;\n    line-height:1;\n    margin-bottom:16px;\n    position:relative;\n    z-index:1;\n  }\n\n  /* ── coin stack (card I — stipend) ── */\n  .dd-coins{\n    width:56px;\n    height:40px;\n    margin:0 auto 16px;\n    position:relative;\n    font-size:1px;\n  }\n  .dd-coins__c{\n    position:absolute;\n    left:50%;\n    width:32px; height:32px;\n    border-radius:50%;\n    background:radial-gradient(circle at 35% 30%, #f7ecc9, #c9a24a 75%);\n    border:1px solid rgba(255,255,255,0.4);\n    box-shadow:0 4px 8px rgba(0,0,0,0.4);\n  }\n  .dd-coins__c--1{ bottom:0; transform:translateX(-50%); }\n  .dd-coins__c--2{ bottom:6px; transform:translateX(-62%); }\n  .dd-coins__c--3{\n    bottom:12px;\n    transform:translateX(-38%);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:12px;\n    font-weight:700;\n    color:#5c4419;\n  }\n\n  /* ── certificate mini-mockup (card II) ── */\n  .dd-cert{\n    width:72px;\n    height:52px;\n    margin:0 auto 16px;\n    background:linear-gradient(160deg,#fdfaf7,#f2ecff);\n    border:1px solid rgba(180,150,255,0.4);\n    border-radius:5px;\n    box-shadow:0 10px 18px rgba(0,0,0,0.4);\n    transform:rotate(-4deg);\n    font-size:1px;\n  }\n  .dd-cert__rule{\n    position:absolute;\n    top:11px; left:12px; right:12px;\n    height:2px;\n    background:linear-gradient(90deg,#c9a24a,#e9d9ff);\n    border-radius:2px;\n  }\n  .dd-cert__line{\n    position:absolute;\n    left:14px;\n    height:1.5px;\n    background:rgba(74,45,120,0.35);\n    border-radius:1px;\n  }\n  .dd-cert__line--1{ top:22px; width:44px; }\n  .dd-cert__line--2{ top:29px; width:30px; }\n  .dd-cert__seal{\n    position:absolute;\n    bottom:-9px; left:50%;\n    transform:translateX(-50%);\n    width:17px; height:17px;\n    border-radius:50%;\n    background:radial-gradient(circle at 35% 30%, #f0e3ff, #8b6fd9 70%);\n    box-shadow:0 3px 6px rgba(0,0,0,0.4);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:8px;\n    color:#fdfaf7;\n    line-height:1;\n  }\n\n  /* ── social platform cluster (card III) ── */\n  .dd-social{\n    width:64px;\n    margin:0 auto 16px;\n    display:flex;\n    flex-wrap:wrap;\n    gap:5px;\n    justify-content:center;\n    font-size:1px;\n  }\n  .dd-social__app{\n    width:27px; height:27px;\n    border-radius:8px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:13px;\n    line-height:1;\n    color:#ffffff;\n    box-shadow:0 5px 10px rgba(0,0,0,0.4);\n  }\n  .dd-social__app--ig{ background:linear-gradient(135deg,#f6a24b,#dd2a7b 45%,#7d3fd9 100%); }\n  .dd-social__app--yt{ background:linear-gradient(160deg,#ff3b3b,#b30f0f); }\n  .dd-social__app--tt{ background:#0b0b0d; border:1px solid rgba(120,220,220,0.4); }\n  .dd-social__app--x{ background:#0b0b0d; border:1px solid rgba(180,150,255,0.35); font-size:11px; }\n\n  /* ── family avatar cluster (card V) ── */\n  .dd-family{\n    display:flex;\n    justify-content:center;\n    margin:0 auto 16px;\n    font-size:1px;\n  }\n  .dd-family__member{\n    width:30px; height:30px;\n    border-radius:50%;\n    background:linear-gradient(160deg,#a98be8,#4c2889);\n    border:2px solid #08060f;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:13px;\n    color:#f2ecff;\n    margin-left:-10px;\n    box-shadow:0 5px 10px rgba(0,0,0,0.45);\n  }\n  .dd-family__member:first-child{ margin-left:0; }\n\n  .dd-tag-title{\n    font-family:'Jost',sans-serif;\n    font-weight:600;\n    font-size:17px;\n    text-transform:uppercase;\n    letter-spacing:0.01em;\n    color:#ffffff;\n    line-height:1.35;\n    margin:0;\n    position:relative;\n    z-index:1;\n  }\n\n  /* entrance reveal */\n  .dd-reveal{\n    opacity:0;\n    transform:translateY(26px);\n    transition:opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1);\n  }\n  .dd-reveal.dd-in{\n    opacity:1;\n    transform:translateY(0);\n  }\n  .dd-line.dd-in{\n    opacity:1;\n    transform:scaleX(1);\n    transition:transform 0.9s cubic-bezier(0.22,1,0.36,1) 0.15s;\n  }\n  .dd-card--1.dd-reveal{ transition-delay:0.05s; }\n  .dd-card--2.dd-reveal{ transition-delay:0.16s; }\n  .dd-card--3.dd-reveal{ transition-delay:0.27s; }\n  .dd-card--4.dd-reveal{ transition-delay:0.38s; }\n  .dd-card--5.dd-reveal{ transition-delay:0.49s; }\n\n  /* idle hanging sway — the tag itself, not the icon */\n  .dd-sway{ animation:none; }\n  .dd-card.dd-in .dd-sway--a{ animation:dd-sway-a 5.5s ease-in-out 1s infinite; }\n  .dd-card.dd-in .dd-sway--b{ animation:dd-sway-b 6.2s ease-in-out 1.3s infinite; }\n  .dd-tag.dd-sway:hover{ animation-play-state:paused; }\n\n  @keyframes dd-sway-a{\n    0%, 100%{ transform:rotate(-1deg); }\n    50%{ transform:rotate(1.1deg); }\n  }\n  @keyframes dd-sway-b{\n    0%, 100%{ transform:rotate(1deg); }\n    50%{ transform:rotate(-1.1deg); }\n  }\n  @keyframes dd-shine-sweep{\n    0%{ left:-60%; }\n    100%{ left:120%; }\n  }\n  @keyframes dd-shimmer-text{\n    0%{ background-position:0% 0%; }\n    100%{ background-position:220% 0%; }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .dd-reveal, .dd-line{ opacity:1; transform:none; transition:none; }\n    .dd-sway, .dd-title span{ animation:none !important; }\n    .dd-tag{ transition:none; }\n  }\n\n  @media screen and (max-width:989px){\n    .dd-row{ gap:22px; }\n    .dd-card{ width:44%; min-width:150px; }\n    .dd-card--2, .dd-card--4{ margin-top:22px; }\n  }\n\n  @media screen and (max-width:589px){\n    .dd-section{ padding:64px 18px 74px; }\n    .dd-heading{ margin-bottom:40px; }\n    .dd-row{\n      flex-direction:column;\n      align-items:center;\n      gap:26px;\n    }\n    .dd-card{\n      width:100%;\n      max-width:280px;\n      margin-top:0 !important;\n    }\n    .dd-tag{ padding:34px 22px 30px; }\n  }\n</style>\n\n<script>\n  (function(){\n    if (typeof window === 'undefined') return;\n    var els = document.querySelectorAll('.dd-section .dd-reveal');\n    if (!els.length) return;\n\n    if (!('IntersectionObserver' in window)) {\n      els.forEach(function(el){ el.classList.add('dd-in'); });\n      return;\n    }\n\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if (entry.isIntersecting) {\n          entry.target.classList.add('dd-in');\n          io.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.2, rootMargin: '0px 0px -60px 0px' });\n\n    els.forEach(function(el){ io.observe(el); });\n  })();\n</script>",
