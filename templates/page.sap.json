    "custom_liquid_qb69YF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HNDRD STUDENT AMBASSADOR PROGRAM\n     PERKS SECTION — GLASS PANEL STYLE\n     Shopify: Themes > Customize > Add Section > Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&family=Jost:wght@400;500;600&family=Figtree:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<section class=\"gp-section\">\n\n  <div class=\"gp-panel\">\n\n    <div class=\"gp-heading\">\n      <p class=\"gp-eyebrow\">HNDRD Student Ambassador Program</p>\n      <h2 class=\"gp-title\">Your<br><span>Perks</span></h2>\n      <p class=\"gp-subtitle\">Here's what you get for being part of the HNDRD Family</p>\n    </div>\n\n    <div class=\"gp-row\">\n\n      <div class=\"gp-item\">\n        <span class=\"gp-numeral\">01</span>\n        <div class=\"gp-icon\">\n          <div class=\"gp-badge\">\n            <span class=\"gp-badge__ribbon gp-badge__ribbon--l\"></span>\n            <span class=\"gp-badge__ribbon gp-badge__ribbon--r\"></span>\n            <span class=\"gp-badge__medal\">★</span>\n          </div>\n        </div>\n        <h3 class=\"gp-item-title\">Achievement Sponsorship</h3>\n      </div>\n\n      <span class=\"gp-divider\" aria-hidden=\"true\"></span>\n\n      <div class=\"gp-item\">\n        <span class=\"gp-numeral\">02</span>\n        <div class=\"gp-icon\">\n          <div class=\"gp-cert\">\n            <span class=\"gp-cert__rule\"></span>\n            <span class=\"gp-cert__line gp-cert__line--1\"></span>\n            <span class=\"gp-cert__line gp-cert__line--2\"></span>\n            <span class=\"gp-cert__seal\">★</span>\n          </div>\n        </div>\n        <h3 class=\"gp-item-title\">Official Recognition</h3>\n      </div>\n\n      <span class=\"gp-divider\" aria-hidden=\"true\"></span>\n\n      <div class=\"gp-item\">\n        <span class=\"gp-numeral\">03</span>\n        <div class=\"gp-icon\">\n          <div class=\"gp-social\">\n            <span class=\"gp-social__app gp-social__app--ig\">📷</span>\n            <span class=\"gp-social__app gp-social__app--yt\">▶</span>\n            <span class=\"gp-social__app gp-social__app--tt\">♪</span>\n            <span class=\"gp-social__app gp-social__app--x\">𝕏</span>\n          </div>\n        </div>\n        <h3 class=\"gp-item-title\">Brand Spotlight</h3>\n      </div>\n\n      <span class=\"gp-divider\" aria-hidden=\"true\"></span>\n\n      <div class=\"gp-item\">\n        <span class=\"gp-numeral\">04</span>\n        <div class=\"gp-icon gp-icon--emoji\">🏸</div>\n        <h3 class=\"gp-item-title\">Exclusive Gear Access</h3>\n      </div>\n\n      <span class=\"gp-divider\" aria-hidden=\"true\"></span>\n\n      <div class=\"gp-item\">\n        <span class=\"gp-numeral\">05</span>\n        <div class=\"gp-icon\">\n          <img class=\"gp-logo-img\" src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/logo-assets-08-removebg-preview.png?v=1789026127\" alt=\"HNDRD\">\n        </div>\n        <h3 class=\"gp-item-title\">HNDRD Inner Circle</h3>\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n<style>\n\n  .gp-section{\n    position:relative;\n    background:#000000;\n    padding:100px 24px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    overflow:hidden;\n  }\n\n  /* the single glass panel housing the whole section */\n  .gp-panel{\n    position:relative;\n    z-index:1;\n    width:100%;\n    max-width:1180px;\n    border-radius:22px;\n    padding:56px 48px 60px;\n    background:rgba(255,255,255,.045);\n    border:1px solid rgba(255,255,255,.14);\n    -webkit-backdrop-filter:blur(24px) saturate(140%);\n    backdrop-filter:blur(24px) saturate(140%);\n    box-shadow:\n      0 34px 80px rgba(0,0,0,.6),\n      inset 0 1px 0 rgba(255,255,255,.15);\n  }\n\n  .gp-heading{\n    text-align:center;\n    margin-bottom:52px;\n  }\n\n  .gp-eyebrow{\n    font-family:'Figtree',sans-serif;\n    font-size:14px;\n    font-weight:500;\n    color:rgba(255,255,255,.65);\n    margin:0 0 12px;\n  }\n\n  .gp-title{\n    font-family:'Poppins',sans-serif;\n    font-size:clamp(38px,5.6vw,62px);\n    font-weight:900;\n    line-height:1;\n    letter-spacing:-.03em;\n    text-transform:uppercase;\n    color:#fff;\n    margin:0;\n  }\n  .gp-title span{\n    color:#FF8300;\n  }\n\n  .gp-subtitle{\n    font-family:'Figtree',sans-serif;\n    font-size:18px;\n    line-height:1.5;\n    font-weight:400;\n    color:rgba(255,255,255,.7);\n    max-width:440px;\n    margin:16px auto 0;\n  }\n\n  /* items row, all living inside the one glass panel, separated by hairlines */\n  .gp-row{\n    display:flex;\n    align-items:flex-start;\n    justify-content:center;\n    gap:0;\n    flex-wrap:wrap;\n  }\n\n  .gp-item{\n    flex:1 1 0;\n    min-width:150px;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    padding:0 18px;\n  }\n\n  .gp-divider{\n    width:1px;\n    align-self:stretch;\n    background:rgba(255,255,255,.1);\n    margin:6px 0;\n  }\n\n  .gp-numeral{\n    font-family:'Jost',sans-serif;\n    font-size:13px;\n    font-weight:600;\n    letter-spacing:.08em;\n    color:#FF8300;\n    margin-bottom:18px;\n  }\n\n  /* fixed-size icon zone — every icon graphic below is built to\n     roughly the same ~52-56px footprint so they read as one set */\n  .gp-icon{\n    height:60px;\n    width:100%;\n    display:flex;\n    align-items:flex-end;\n    justify-content:center;\n    margin-bottom:22px;\n  }\n  .gp-icon--emoji{\n    font-size:52px;\n    line-height:1;\n  }\n\n  /* achievement medal + ribbon (card 01) — ~46x52 footprint */\n  .gp-badge{\n    position:relative;\n    width:46px;\n    height:52px;\n  }\n  .gp-badge__ribbon{\n    position:absolute;\n    top:30px;\n    width:14px;\n    height:24px;\n    clip-path:polygon(0 0, 100% 0, 100% 78%, 50% 100%, 0 78%);\n    z-index:1;\n  }\n  .gp-badge__ribbon--l{\n    left:8px;\n    background:#c9922f;\n    transform:rotate(-16deg);\n  }\n  .gp-badge__ribbon--r{\n    right:8px;\n    background:#a3701f;\n    transform:rotate(16deg);\n  }\n  .gp-badge__medal{\n    position:relative;\n    z-index:2;\n    width:46px;\n    height:46px;\n    border-radius:50%;\n    background:radial-gradient(circle at 35% 30%, #ffdf9e, #eba832 55%, #c9922f 100%);\n    border:2px solid rgba(255,255,255,.55);\n    box-shadow:0 6px 14px rgba(0,0,0,.4);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:18px;\n    color:#7a4e10;\n  }\n\n  /* certificate — ~58x44 footprint, matched down from the old 70x50 */\n  .gp-cert{\n    width:58px; height:44px;\n    background:linear-gradient(145deg,#fff,#fff3e2);\n    border-radius:6px;\n    position:relative;\n    border:1px solid rgba(237,167,64,.4);\n    box-shadow:0 10px 20px rgba(0,0,0,.4);\n  }\n  .gp-cert__rule{\n    position:absolute; top:10px; left:10px; right:10px; height:2px;\n    background:#c9a24a;\n  }\n  .gp-cert__line{ position:absolute; height:2px; left:11px; background:#d9b98a; }\n  .gp-cert__line--1{ top:19px; width:34px; }\n  .gp-cert__line--2{ top:25px; width:23px; }\n  .gp-cert__seal{\n    position:absolute; bottom:-4px; left:50%; transform:translateX(-50%);\n    height:15px; width:15px; border-radius:50%;\n    background:#c9922f; color:#fff; font-size:7px;\n    display:flex; align-items:center; justify-content:center;\n    box-shadow:0 3px 8px rgba(0,0,0,.4);\n  }\n\n  /* social cluster — ~52x52 footprint, matched down from 57x57 */\n  .gp-social{ display:grid; grid-template-columns:repeat(2,24px); gap:4px; }\n  .gp-social__app{\n    height:24px; width:24px; border-radius:6px;\n    display:flex; align-items:center; justify-content:center;\n    font-size:11px; color:#fff;\n    box-shadow:0 4px 10px rgba(0,0,0,.35);\n  }\n  .gp-social__app--ig{ background:linear-gradient(135deg,#f7b24a,#d62f91,#7138d8); }\n  .gp-social__app--yt{ background:#e00000; }\n  .gp-social__app--tt,\n  .gp-social__app--x{ background:#080808; border:1px solid rgba(237,167,64,.4); }\n\n  /* logo — bumped up so it doesn't read smaller than the other icons */\n  .gp-logo-img{ height:58px; width:auto; object-fit:contain; }\n\n  .gp-item-title{\n    font-family:'Jost',sans-serif;\n    font-weight:600;\n    font-size:15px;\n    text-transform:uppercase;\n    letter-spacing:.01em;\n    color:#fff;\n    line-height:1.35;\n    margin:0;\n  }\n\n  /* ── tablet ── */\n  @media (max-width:990px){\n    .gp-panel{ padding:46px 28px 50px; }\n    .gp-row{ gap:24px 0; }\n    .gp-item{ flex:1 1 40%; min-width:130px; }\n    .gp-divider{ display:none; }\n  }\n\n  /* ── mobile ── */\n  @media (max-width:600px){\n    .gp-section{ padding:70px 16px; }\n    .gp-panel{ padding:38px 22px 44px; border-radius:18px; }\n    .gp-heading{ margin-bottom:36px; }\n    .gp-title{ font-size:38px; }\n    .gp-row{ flex-direction:column; gap:34px; }\n    .gp-item{ width:100%; }\n  }\n\n</style>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
