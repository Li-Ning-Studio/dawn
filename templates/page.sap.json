      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 1: STICKY CTA BAR\n     HOW TO ADD IN SHOPIFY:\n     Online Store → Themes → Customize → Add Section → Custom HTML\n     Paste this entire block. The bar sticks to the bottom of the\n     viewport across all sections on the page.\n     IMPORTANT: Add this section only ONCE on the page.\n     Replace the href=\"#sv-register\" with your actual product/form URL.\n================================================================ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\nhtml {\n  scroll-behavior: smooth;\n}\n\n  /* Scoped with .sv- prefix to avoid theme conflicts */\n  .sv-sticky-bar {\n    position: fixed;\n    bottom: 0; left: 0; right: 0;\n    background: #FFD400;\n    color: #1A0640;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 24px;\n    padding: 14px 24px;\n    z-index: 9999;\n    font-family: Figtree;\n    font-weight: 800;\n    font-size: 1.5rem;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    flex-wrap: wrap;\n  }\n  .sv-sticky-bar__label {\n    font-weight: 600;\n    font-size: 1.25rem;\n    opacity: 0.7;\n    font-family: 'Inter', sans-serif;\n    text-transform: none;\n    letter-spacing: 0;\n  }\n  .sv-sticky-bar__text {\n    font-family: Figtree;\n    font-weight: 800;\n    font-size: 1.6rem;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: #1A0640;\n  }\n  .sv-sticky-bar__btn {\n    display: inline-block;\n    background: #1A0640;\n    color: #F5C500;\n    border: none;\n    padding: 10px 28px;\n    font-family:Figtree;\n    font-weight: 800;\n    font-size: 1.7rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    cursor: pointer;\n    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);\n    text-decoration: none;\n    transition: background 0.2s, color 0.2s;\n  }\n  .sv-sticky-bar__btn:hover {\n    background: #ffffff;\n    color: #1A0640;\n  }\n  /* Push page content so sticky bar doesn't overlap footer */\n  body { padding-bottom: 60px; }\n\n  @media (max-width: 600px) {\n    .sv-sticky-bar { gap: 10px; padding: 12px 16px; }\n    .sv-sticky-bar__label { display: none; }\n  }\n</style>\n\n<div class=\"sv-sticky-bar\">\n  <span class=\"sv-sticky-bar__label\">Secure your spot now</span>\n  <span class=\"sv-sticky-bar__text\">Register for ₹299</span>\n  <!-- Replace href with your registration page URL -->\n  <a href=\"#sv-register\" class=\"sv-sticky-bar__btn\">Register Now</a>\n</div>",
