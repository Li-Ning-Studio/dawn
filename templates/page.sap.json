    "custom_liquid_GwyNeF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD STUDENT AMBASSADOR PROGRAM -->\n<!-- SECTION: FAQ ACCORDION -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800;900&display=swap\" rel=\"stylesheet\">\n<style>\n.sap-faq{\n  position:relative;\n  overflow:hidden;\n  background:\n    radial-gradient(circle at 15% 100%, rgba(108,0,255,.28), transparent 40%),\n    radial-gradient(circle at 85% 10%, rgba(8,27,125,.35), transparent 45%),\n    #030213;\n  padding:80px 24px 100px;\n}\n.sap-faq::before{\n  content:\"\";\n  position:absolute;\n  width:500px;\n  height:500px;\n  bottom:-260px;\n  left:-120px;\n  background:#6C00FF;\n  filter:blur(150px);\n  opacity:.28;\n  pointer-events:none;\n}\n.sap-faq::after{\n  content:\"\";\n  position:absolute;\n  width:380px;\n  height:380px;\n  top:-160px;\n  right:-100px;\n  background:#081B7D;\n  filter:blur(130px);\n  opacity:.5;\n  pointer-events:none;\n}\n.sap-faq .in{position:relative;z-index:2;max-width:800px;margin:0 auto;}\n.sap-faq .ey{font-family:Figtree;font-size:1.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#FCEBFF;margin-bottom:12px;display:block;}\n.sap-faq .ti{font-family:Figtree;font-weight:900;font-size:clamp(4.4rem,6vw,5.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sap-faq .list{margin-top:48px;}\n.sap-faq .fi{border-bottom:1px solid rgba(255,255,255,.1);}\n.sap-faq .fq{width:100%;background:none;border:none;color:#fff;text-align:left;padding:20px 0;font-family:Figtree;font-weight:700;font-size:1.7rem;letter-spacing:.03em;text-transform:uppercase;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;transition:color .2s;}\n.sap-faq .fq:hover{color:#FCEBFF;}\n.sap-faq .fa-arrow{flex-shrink:0;width:36px;height:36px;border-radius:50%;border:2px solid #FCEBFF;display:flex;align-items:center;justify-content:center;transition:transform .3s ease,background .3s ease;}\n.sap-faq .fa-arrow svg{width:14px;height:14px;stroke:#FCEBFF;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s ease,stroke .3s ease;}\n.sap-faq .fi.open .fa-arrow{background:#6C00FF;border-color:#6C00FF;}\n.sap-faq .fi.open .fa-arrow svg{stroke:#fff;transform:rotate(180deg);}\n.sap-faq .fa{max-height:0;overflow:hidden;font-family:Figtree;font-size:1.6rem;color:#F0EAF8;opacity:.8;line-height:1.7;transition:max-height .35s ease,padding-bottom .35s ease;padding-bottom:0;}\n.sap-faq .fi.open .fa{max-height:300px;padding-bottom:20px;}\n@media(max-width:600px){.sap-faq{padding:60px 20px 80px;}.sap-faq .fq{font-size:1.7rem;}}\n</style>\n\n<section class=\"sap-faq\">\n  <div class=\"in\">\n    <span class=\"ey\">FAQ</span>\n    <h2 class=\"ti\">Got questions?</h2>\n    <div class=\"list\">\n\n      <div class=\"fi\">\n        <button class=\"fq\">What is the HNDRD Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">The HNDRD Student Ambassador Program (SAP) gives students the opportunity to represent HNDRD on their campus, organise badminton events and activations, and help grow the badminton community in their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Who can apply for the Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Any college student who loves badminton, enjoys bringing people together, and has a knack for organising events can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What does an HNDRD Student Ambassador do?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors represent HNDRD on campus by organising badminton events and activations, engaging students, and creating a stronger badminton community within their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Do I need to be a professional badminton player to apply?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Not at all. You don't need to be a professional player. If you enjoy badminton and have the enthusiasm and ability to organise events and bring people together, you can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What do I get as an HNDRD Student Ambassador?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors receive a monthly stipend, social media exposure, a certificate, and the opportunity to work with and become a part of the HNDRD family.</div>\n      </div>\n\n      \n\n     \n      \n  </div>\n</section>\n\n<script>\n(function(){\n  var items = document.querySelectorAll('.sap-faq .fi');\n  items.forEach(function(item){\n    item.querySelector('.fq').addEventListener('click', function(){\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.sap-faq .fi.open').forEach(function(o){ o.classList.remove('open'); });\n      if(!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
