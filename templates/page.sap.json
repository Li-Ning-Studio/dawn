      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HNDRD STUDENT AMBASSADOR PROGRAM\n     SECTION: FINAL CTA\n     Shopify: Themes > Customize > Add Section > Custom HTML\n============================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n<style>\n.sap-cta,\n.sap-cta * {\n  box-sizing: border-box;\n  font-family: Figtree, sans-serif;\n}\n\n.sap-cta {\n  position: relative;\n  overflow: hidden;\n  background: #030213;\n  padding: 100px 24px 90px;\n  text-align: center;\n}\n\n/* drifting glow — radial-gradient fades to transparent on its own,\n   so no hard blur-clip edge like a filter:blur() div would leave */\n.sap-cta::before {\n  content: '';\n  position: absolute;\n  z-index: 0;\n  pointer-events: none;\n  width: 900px;\n  height: 900px;\n  left: 50%;\n  bottom: -520px;\n  transform: translateX(-50%);\n  background: radial-gradient(circle, rgba(108,0,255,.38) 0%, rgba(108,0,255,0) 62%);\n  animation: sapCtaDriftA 9s ease-in-out infinite;\n}\n\n.sap-cta::after {\n  content: '';\n  position: absolute;\n  z-index: 0;\n  pointer-events: none;\n  width: 700px;\n  height: 700px;\n  top: -380px;\n  left: -220px;\n  background: radial-gradient(circle, rgba(8,27,125,.55) 0%, rgba(8,27,125,0) 62%);\n  animation: sapCtaDriftB 11s ease-in-out infinite;\n}\n\n@keyframes sapCtaDriftA {\n  0%, 100% { transform: translateX(-50%) translateY(0) scale(1); }\n  50% { transform: translateX(-46%) translateY(-24px) scale(1.08); }\n}\n\n@keyframes sapCtaDriftB {\n  0%, 100% { transform: translate(0, 0) scale(1); }\n  50% { transform: translate(20px, 18px) scale(1.06); }\n}\n\n/* entrance animation */\n.sap-cta__eyebrow,\n.sap-cta__headline,\n.sap-cta__sub,\n.sap-cta__card,\n.sap-cta__bottom {\n  opacity: 0;\n  transform: translateY(22px);\n}\n\n.sap-cta.is-visible .sap-cta__eyebrow {\n  animation: sapCtaRise .7s cubic-bezier(.2,.8,.2,1) .05s forwards;\n}\n.sap-cta.is-visible .sap-cta__headline {\n  animation: sapCtaRise .8s cubic-bezier(.2,.8,.2,1) .15s forwards;\n}\n.sap-cta.is-visible .sap-cta__sub {\n  animation: sapCtaRise .8s cubic-bezier(.2,.8,.2,1) .28s forwards;\n}\n.sap-cta.is-visible .sap-cta__card {\n  animation: sapCtaRise .8s cubic-bezier(.2,.8,.2,1) .4s forwards;\n}\n.sap-cta.is-visible .sap-cta__bottom {\n  animation: sapCtaRise .8s cubic-bezier(.2,.8,.2,1) .52s forwards;\n}\n\n@keyframes sapCtaRise {\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sap-cta::before, .sap-cta::after { animation: none; }\n  .sap-cta__eyebrow, .sap-cta__headline, .sap-cta__sub, .sap-cta__card, .sap-cta__bottom {\n    opacity: 1; transform: none; animation: none;\n  }\n}\n\n.sap-cta__inner {\n  position: relative;\n  z-index: 2;\n  max-width: 620px;\n  margin: 0 auto;\n}\n\n.sap-cta__headline em {\n  position: relative;\n}\n\n.sap-cta__eyebrow {\n  display: inline-block;\n  font-weight: 700;\n  font-size: 15px;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #FCEBFF;\n  border: 1px solid rgba(252,235,255,.35);\n  padding: 10px 26px;\n  border-radius: 10px;\n  margin-bottom: 28px;\n}\n\n.sap-cta__headline {\n  font-weight: 900;\n  font-size: clamp(3.2rem, 9vw, 5.6rem);\n  line-height: .92;\n  letter-spacing: -0.02em;\n  text-transform: uppercase;\n  color: #ffffff;\n  margin: 0;\n}\n\n.sap-cta__headline em {\n  font-style: normal;\n  display: block;\n  color: #FCEBFF;\n}\n\n.sap-cta__sub {\n  font-size: clamp(1.05rem, 1.8vw, 1.3rem);\n  font-weight: 400;\n  color: rgba(255,255,255,.65);\n  line-height: 1.65;\n  margin: 20px auto 0;\n  max-width: 420px;\n}\n\n.sap-cta__sub strong {\n  color: #FCEBFF;\n  font-weight: 700;\n}\n\n/* card-style apply button */\n.sap-cta__card {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  margin-top: 44px;\n  padding: 22px 24px;\n  border-radius: 16px;\n  background: linear-gradient(135deg, #6C00FF, #081B7D);\n  text-decoration: none;\n  border: 1px solid rgba(252,235,255,.2);\n  transition: transform .18s ease, filter .18s ease, box-shadow .3s ease;\n  animation-fill-mode: forwards;\n}\n\n.sap-cta.is-visible .sap-cta__card {\n  animation:\n    sapCtaRise .8s cubic-bezier(.2,.8,.2,1) .4s forwards,\n    sapCtaPulse 2.6s ease-in-out 1.3s infinite;\n}\n\n@keyframes sapCtaPulse {\n  0%, 100% { box-shadow: 0 10px 30px rgba(108,0,255,.25); }\n  50% { box-shadow: 0 14px 38px rgba(108,0,255,.45); }\n}\n\n.sap-cta__card:hover {\n  transform: translateY(-3px);\n  filter: brightness(1.08);\n  box-shadow: 0 18px 44px rgba(108,0,255,.4);\n  animation-play-state: paused, paused;\n}\n\n.sap-cta__card:active {\n  transform: translateY(0);\n  filter: brightness(.96);\n}\n\n.sap-cta__card-left {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  text-align: left;\n}\n\n.sap-cta__card-icon {\n  flex-shrink: 0;\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(255,255,255,.12);\n  border: 1px solid rgba(252,235,255,.3);\n}\n\n.sap-cta__card-icon svg {\n  width: 22px;\n  height: 22px;\n  stroke: #FCEBFF;\n  fill: none;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sap-cta__card-label {\n  display: block;\n  font-weight: 500;\n  font-size: 13px;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.65);\n  margin-bottom: 3px;\n}\n\n.sap-cta__card-name {\n  display: block;\n  font-weight: 800;\n  font-size: 1.55rem;\n  letter-spacing: -0.01em;\n  text-transform: uppercase;\n  color: #ffffff;\n  line-height: 1;\n}\n\n.sap-cta__card-action {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n  background: rgba(0,0,0,.22);\n  border-radius: 10px;\n  padding: 12px 18px;\n}\n\n.sap-cta__card-action span {\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  color: #fff;\n  white-space: nowrap;\n}\n\n.sap-cta__card-action svg {\n  width: 14px;\n  height: 14px;\n  stroke: #fff;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  flex-shrink: 0;\n  transition: transform .25s ease;\n}\n\n.sap-cta__card:hover .sap-cta__card-action svg {\n  transform: translateX(3px);\n}\n\n/* periodic shimmer sweep */\n.sap-cta__card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  overflow: hidden;\n  background: linear-gradient(100deg, transparent 40%, rgba(255,255,255,.22) 50%, transparent 60%);\n  background-size: 220% 100%;\n  background-position: 150% 0;\n  pointer-events: none;\n}\n\n.sap-cta.is-visible .sap-cta__card::before {\n  animation: sapCtaShimmer 3.2s ease-in-out 1.6s infinite;\n}\n\n@keyframes sapCtaShimmer {\n  0%, 30% { background-position: 150% 0; }\n  60%, 100% { background-position: -60% 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sap-cta__card::before,\n  .sap-cta.is-visible .sap-cta__card { animation: none !important; }\n}\n\n.sap-cta__bottom {\n  margin-top: 34px;\n  font-size: 12.5px;\n  font-weight: 600;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.4);\n}\n\n.sap-cta__bottom span { color: #FCEBFF; }\n\n@media (max-width: 480px) {\n  .sap-cta { padding: 80px 20px 70px; }\n  .sap-cta__card { padding: 16px 16px; }\n  .sap-cta__card-name { font-size: 1.3rem; }\n  .sap-cta__card-action span { display: none; }\n}\n</style>\n\n<section class=\"sap-cta\" id=\"hndrd-register\">\n  <div class=\"sap-cta__inner\">\n\n    <span class=\"sap-cta__eyebrow\">Student Ambassador Program</span>\n\n    <h2 class=\"sap-cta__headline\">\n      Register<br><em>Now.</em>\n    </h2>\n\n    <p class=\"sap-cta__sub\">\n      Fill the form below and be a part of the <strong>HNDRD Family</strong>.\n    </p>\n\n    <a href=\"#hndrd-application-form\" class=\"sap-cta__card\">\n      <div class=\"sap-cta__card-left\">\n        <div class=\"sap-cta__card-icon\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect x=\"8\" y=\"2\" width=\"8\" height=\"4\" rx=\"1\"/><path d=\"M9 12h6\"/><path d=\"M9 16h6\"/></svg>\n        </div>\n        <div>\n          <span class=\"sap-cta__card-label\">Apply via</span>\n          <span class=\"sap-cta__card-name\">Application Form</span>\n        </div>\n      </div>\n\n      <div class=\"sap-cta__card-action\">\n        <span>Apply Now</span>\n        <svg viewBox=\"0 0 14 14\"><path d=\"M2.5 7h9M8 3.5L11.5 7 8 10.5\"/></svg>\n      </div>\n    </a>\n\n    <div class=\"sap-cta__bottom\">\n      Join the <span>HNDRD Family</span>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function(){\n  var el = document.querySelector('.sap-cta');\n  if(!el) return;\n  if('IntersectionObserver' in window){\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if(entry.isIntersecting){\n          el.classList.add('is-visible');\n          io.disconnect();\n        }\n      });\n    }, { threshold: 0.25 });\n    io.observe(el);\n  } else {\n    el.classList.add('is-visible');\n  }\n})();\n</script>",
