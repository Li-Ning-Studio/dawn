olygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);\n    text-decoration: none;\n    transition: background 0.2s, color 0.2s;\n  }\n  .sv-sticky-bar__btn:hover {\n    background: #ffffff;\n    color: #1A0640;\n  }\n  /* Push page content so sticky bar doesn't overlap footer */\n  body { padding-bottom: 60px; }\n\n  @media (max-width: 600px) {\n    .sv-sticky-bar { gap: 10px; padding: 12px 16px; }\n    .sv-sticky-bar__label { display: none; }\n  }\n</style>\n\n<div class=\"sv-sticky-bar\">\n  <span class=\"sv-sticky-bar__label\">Secure your spot now</span>\n  <span class=\"sv-sticky-bar__text\">Register for ₹299</span>\n  <!-- Replace href with your registration page URL -->\n  <a href=\"#sv-register\" class=\"sv-sticky-bar__btn\">Register Now</a>\n</div>",
