    "custom_liquid_wEr9EG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HNDRD STUDENT AMBASSADOR PROGRAM\n     HERO INTRO SECTION\n============================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n\nhtml {\n  scroll-behavior: smooth;\n}\n\n#hndrd-student-hero,\n#hndrd-student-hero * {\n  box-sizing: border-box;\n  font-family: Figtree, sans-serif;\n}\n\n#hndrd-student-hero {\n  position: relative;\n  width: 100%;\n  min-height: 650px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  padding: 100px 24px;\n  text-align: center;\n  background: #000000;\n  color: white;\n}\n\n/* floating particles */\n.hs-particle {\n  position: absolute;\n  z-index: 1;\n  border-radius: 50%;\n  background: #FCEBFF;\n  pointer-events: none;\n  opacity: 0;\n}\n#hndrd-student-hero.is-visible .hs-particle {\n  animation: hsFloat linear infinite, hsFadeIn 1.2s ease forwards;\n}\n.hs-particle:nth-child(1) { width: 4px;  height: 4px;  top: 22%; left: 12%; animation-duration: 9s, 1s;  animation-delay: 0s, .2s; }\n.hs-particle:nth-child(2) { width: 6px;  height: 6px;  top: 65%; left: 20%; animation-duration: 12s, 1s; animation-delay: 1s, .4s; opacity:.6; }\n.hs-particle:nth-child(3) { width: 3px;  height: 3px;  top: 35%; left: 85%; animation-duration: 8s, 1s;  animation-delay: .5s, .6s; }\n.hs-particle:nth-child(4) { width: 5px;  height: 5px;  top: 78%; left: 80%; animation-duration: 11s, 1s; animation-delay: 1.4s, .8s; }\n.hs-particle:nth-child(5) { width: 3px;  height: 3px;  top: 12%; left: 65%; animation-duration: 10s, 1s; animation-delay: .8s, 1s; }\n\n@keyframes hsFadeIn {\n  to { opacity: .5; }\n}\n@keyframes hsFloat {\n  0%   { transform: translateY(0) translateX(0); }\n  50%  { transform: translateY(-26px) translateX(10px); }\n  100% { transform: translateY(0) translateX(0); }\n}\n\n.hs-inner {\n  position: relative;\n  z-index: 2;\n  max-width: 950px;\n  margin: auto;\n}\n\n/* entrance animation — staggered rise-in, mirrors the CTA section */\n.hs-label,\n.hs-title,\n.hs-description,\n.hs-button,\n.hs-bottom {\n  opacity: 0;\n  transform: translateY(24px);\n}\n\n#hndrd-student-hero.is-visible .hs-label {\n  animation: hsRise .7s cubic-bezier(.2,.8,.2,1) .05s forwards;\n}\n#hndrd-student-hero.is-visible .hs-title {\n  animation: hsRise .85s cubic-bezier(.2,.8,.2,1) .18s forwards;\n}\n#hndrd-student-hero.is-visible .hs-description {\n  animation: hsRise .8s cubic-bezier(.2,.8,.2,1) .32s forwards;\n}\n#hndrd-student-hero.is-visible .hs-button {\n  animation: hsRise .8s cubic-bezier(.2,.8,.2,1) .46s forwards;\n}\n#hndrd-student-hero.is-visible .hs-bottom {\n  animation: hsRise .8s cubic-bezier(.2,.8,.2,1) .58s forwards;\n}\n\n@keyframes hsRise {\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hs-particle { animation: none !important; }\n  .hs-label, .hs-title, .hs-description, .hs-button, .hs-bottom {\n    opacity: 1; transform: none; animation: none;\n  }\n}\n\n/* small heading */\n.hs-label {\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  color: #FCEBFF;\n  margin-bottom: 20px;\n}\n\n/* main heading */\n.hs-title {\n  margin: 0;\n  font-size: clamp(48px, 6.5vw, 86px);\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n}\n\n.hs-title span {\n  display: inline-block;\n  color: #FF8300;\n  background: linear-gradient(90deg, #FFFFFF, #FF8300, #FFFFFF);\n  background-size: 200% auto;\n  background-position: 0% center;\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n#hndrd-student-hero.is-visible .hs-title span {\n  animation: hsRise .85s cubic-bezier(.2,.8,.2,1) .18s forwards, hsShine 5s ease-in-out 1.2s infinite;\n}\n\n@keyframes hsShine {\n  0%, 100% { background-position: 0% center; }\n  50%      { background-position: 100% center; }\n}\n\n/* description */\n.hs-description {\n  max-width: 760px;\n  margin: 28px auto 0;\n  font-size: clamp(17px, 1.8vw, 22px);\n  font-weight: 400;\n  line-height: 1.6;\n  color: rgba(255,255,255,.72);\n}\n\n.hs-description strong {\n  color: #FCEBFF;\n  font-weight: 700;\n}\n\n/* ===========================\n   PREMIUM CTA BUTTON — outline style, no fill\n=========================== */\n.hs-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  margin-top: 38px;\n  height: 62px;\n  padding: 0 58px;\n  background: transparent;\n  color: #FCEBFF !important;\n  border-radius: 999px;\n  font-size: 14px;\n  font-weight: 800;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  text-decoration: none;\n  border: 1.5px solid rgba(255,255,255,.7);\n  position: relative;\n  overflow: hidden;\n  transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease, color .35s ease;\n  box-shadow: 0 15px 40px rgba(0,0,0,.35);\n}\n\n#hndrd-student-hero.is-visible .hs-button {\n  animation: hsRise .8s cubic-bezier(.2,.8,.2,1) .46s forwards;\n}\n\n/* Shine effect (hover sweep) */\n.hs-button::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: -120%;\n  width: 80%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);\n  transform: skewX(-20deg);\n  transition: .7s ease;\n}\n\n.hs-button:hover::before { left: 130%; }\n\n.hs-button:hover {\n  background: transparent;\n  border-color: #FF8300;\n  color: #ffffff !important;\n  transform: translateY(-5px);\n  box-shadow: 0 20px 45px rgba(0,0,0,.4);\n}\n\n/* bottom branding */\n.hs-bottom {\n  margin-top: 20px;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.45);\n}\n\n.hs-bottom span { color: #FF8300; }\n\n/* mobile */\n@media (max-width: 600px) {\n  #hndrd-student-hero { min-height: 560px; padding: 75px 20px; }\n  .hs-label { font-size: 12px; margin-bottom: 16px; }\n  .hs-title { font-size: 52px; }\n  .hs-description { margin-top: 20px; font-size: 17px; line-height: 1.55; }\n  .hs-button { height: 56px; padding: 0 38px; font-size: 13px; letter-spacing: .14em; }\n}\n</style>\n\n<section id=\"hndrd-student-hero\">\n\n  <span class=\"hs-particle\"></span>\n  <span class=\"hs-particle\"></span>\n  <span class=\"hs-particle\"></span>\n  <span class=\"hs-particle\"></span>\n  <span class=\"hs-particle\"></span>\n\n  <div class=\"hs-inner\">\n\n    <div class=\"hs-label\">HNDRD Student Ambassador Program</div>\n\n    <h1 class=\"hs-title\">\n      BE THE FACE OF\n      <br>\n      <span>HNDRD.</span>\n    </h1>\n\n    <p class=\"hs-description\">\n      Turn your passion for badminton into action.\n      Join the <strong>HNDRD Student Ambassador Program</strong>\n      to organise campus activations, build communities,\n      and bring the game closer to more players.\n    </p>\n\n    <a href=\"#hndrd-register\" class=\"hs-button\">APPLY TO JOIN</a>\n\n    <div class=\"hs-bottom\">JOIN THE <span>HNDRD FAMILY</span></div>\n\n  </div>\n</section>\n\n<script>\n(function(){\n  var el = document.getElementById('hndrd-student-hero');\n  if(!el) return;\n  if('IntersectionObserver' in window){\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if(entry.isIntersecting){\n          el.classList.add('is-visible');\n          io.disconnect();\n        }\n      });\n    }, { threshold: 0.25 });\n    io.observe(el);\n  } else {\n    el.classList.add('is-visible');\n  }\n})();\n\nif (typeof window.history.pushState === 'function') {\n    history.pushState({}, '', window.location.pathname + window.location.search);\n}\n\ndocument.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n    anchor.addEventListener('click', function (e) {\n        // Let the browser scroll to the element first\n        setTimeout(() => {\n            history.pushState(null, null, window.location.pathname);\n        }, 50);\n    });\n});\n\n\n\n\n</script>",
        "color_scheme": "scheme-4",
