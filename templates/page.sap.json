      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 3: QUICKFACTS BAND\n     HOW TO ADD IN SHOPIFY:\n     Online Store → Themes → Customize → Add Section → Custom HTML\n     Place this section immediately below the Hero section.\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sv-qf {\n    background: #F5C500;\n    color: #1A0640;\n    padding: 28px 40px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 0;\n    position: relative;\n    z-index: 2;\n  }\n\n  .sv-qf__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 0 36px;\n    border-right: 2px solid rgba(58,13,122,0.2);\n  }\n  .sv-qf__item:last-child { border-right: none; }\n\n  .sv-qf__label {\n    font-family: 'Inter', sans-serif;\n    font-size: 1.62rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;\n    opacity: 0.6;\n    color: #1A0640;\n  }\n\n  .sv-qf__value {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 2.2rem;\n    letter-spacing: 0.03em;\n    line-height: 1.1;\n    margin-top: 2px;\n    color: #1A0640;\n  }\n\n  @media (max-width: 600px) {\n    .sv-qf {\n      flex-direction: column;\n      gap: 14px;\n      padding: 24px 20px;\n    }\n    .sv-qf__item {\n      border-right: none;\n      border-bottom: 1px solid rgba(58,13,122,0.15);\n      padding: 12px 0;\n      width: 100%;\n      text-align: center;\n    }\n    .sv-qf__item:last-child { border-bottom: none; }\n  }\n</style>\n\n<div class=\"sv-qf\">\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Date</span>\n    <span class=\"sv-qf__value\">28 JUN 2026</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Venue</span>\n    <span class=\"sv-qf__value\">SPORTFIT, JP NAGAR</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Reporting</span>\n    <span class=\"sv-qf__value\">10:30 AM</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Duration</span>\n    <span class=\"sv-qf__value\">4–5 HOURS</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Entry Fee</span>\n    <span class=\"sv-qf__value\">₹199</span>\n  </div>\n</div>",
