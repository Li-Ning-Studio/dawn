    "custom_liquid_cFMhfJ": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD STUDENT AMBASSADOR PROGRAM -->\n<!-- SECTION: FAQ ACCORDION -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800;900&display=swap\" rel=\"stylesheet\">\n<style>\n.sap-faq{\n  position:relative;\n  overflow:hidden;\n  background:\n    radial-gradient(circle at 15% 100%, rgba(108,0,255,.28), transparent 40%),\n    radial-gradient(circle at 85% 10%, rgba(8,27,125,.35), transparent 45%),\n    #030213;\n  padding:100px 24px 120px;\n}\n.sap-faq::before{\n  content:\"\";\n  position:absolute;\n  width:500px;\n  height:500px;\n  bottom:-260px;\n  left:-120px;\n  background:#6C00FF;\n  filter:blur(150px);\n  opacity:.28;\n  pointer-events:none;\n}\n.sap-faq::after{\n  content:\"\";\n  position:absolute;\n  width:380px;\n  height:380px;\n  top:-160px;\n  right:-100px;\n  background:#081B7D;\n  filter:blur(130px);\n  opacity:.5;\n  pointer-events:none;\n}\n.sap-faq .in{position:relative;z-index:2;max-width:800px;margin:0 auto;}\n.sap-faq .ey{font-family:Figtree;font-size:.95rem;font-weight:700;letter-spacing:.32em;text-transform:uppercase;color:#FCEBFF;margin-bottom:16px;display:block;}\n.sap-faq .ti{font-family:Figtree;font-weight:900;font-size:clamp(2.6rem,6vw,5.5rem);line-height:1.02;letter-spacing:-.01em;text-transform:uppercase;color:#fff;margin:0;}\n.sap-faq .sub{font-family:Figtree;font-weight:500;font-size:1.05rem;color:#F0EAF8;opacity:.65;margin:18px 0 0;max-width:480px;line-height:1.6;}\n.sap-faq .list{margin-top:56px;}\n.sap-faq .fi{border-bottom:1px solid rgba(255,255,255,.1);}\n.sap-faq .fq{\n  width:100%;\n  background:none;\n  border:none;\n  color:#fff;\n  text-align:left;\n  padding:26px 0;\n  font-family:Figtree;\n  font-weight:700;\n  font-size:1.15rem;\n  letter-spacing:0;\n  line-height:1.4;\n  text-transform:none;\n  cursor:pointer;\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:20px;\n  transition:color .2s;\n}\n.sap-faq .fq:hover{color:#FCEBFF;}\n.sap-faq .fa-arrow{\n  flex-shrink:0;\n  width:32px;\n  height:32px;\n  border-radius:50%;\n  border:1.5px solid rgba(252,235,255,.5);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  transition:transform .3s ease,background .3s ease,border-color .3s ease;\n}\n.sap-faq .fa-arrow svg{width:12px;height:12px;stroke:#FCEBFF;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s ease,stroke .3s ease;}\n.sap-faq .fi.open .fq{color:#FCEBFF;}\n.sap-faq .fi.open .fa-arrow{background:#6C00FF;border-color:#6C00FF;}\n.sap-faq .fi.open .fa-arrow svg{stroke:#fff;transform:rotate(180deg);}\n.sap-faq .fa{max-height:0;overflow:hidden;font-family:Figtree;font-size:1rem;font-weight:400;color:#F0EAF8;opacity:.7;line-height:1.7;transition:max-height .35s ease,opacity .3s ease,padding-bottom .35s ease;padding-bottom:0;padding-right:52px;}\n.sap-faq .fi.open .fa{max-height:300px;padding-bottom:26px;opacity:.85;}\n\n@media(max-width:600px){\n  .sap-faq{padding:64px 20px 72px;}\n  .sap-faq::before{width:280px;height:280px;bottom:-160px;left:-100px;filter:blur(90px);opacity:.22;}\n  .sap-faq::after{width:220px;height:220px;top:-100px;right:-80px;filter:blur(80px);opacity:.4;}\n  .sap-faq .ey{font-size:.72rem;letter-spacing:.24em;margin-bottom:10px;}\n  .sap-faq .ti{font-size:2.15rem;line-height:1.08;}\n  .sap-faq .sub{font-size:.95rem;margin-top:12px;}\n  .sap-faq .list{margin-top:40px;}\n  .sap-faq .fq{padding:20px 0;font-size:1rem;gap:14px;}\n  .sap-faq .fa-arrow{width:28px;height:28px;}\n  .sap-faq .fa-arrow svg{width:10px;height:10px;}\n  .sap-faq .fa{font-size:.92rem;padding-right:0;line-height:1.65;}\n  .sap-faq .fi.open .fa{padding-bottom:20px;}\n}\n</style>\n\n<section class=\"sap-faq\">\n  <div class=\"in\">\n    <span class=\"ey\">FAQ</span>\n    <h2 class=\"ti\">Got questions?</h2>\n    <p class=\"sub\">Everything you need to know before you apply.</p>\n    <div class=\"list\">\n\n      <div class=\"fi\">\n        <button class=\"fq\">What is the HNDRD Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">The HNDRD Student Ambassador Program (SAP) gives students the opportunity to represent HNDRD on their campus, organise badminton events and activations, and help grow the badminton community in their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Who can apply for the Student Ambassador Program?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Any college student who loves badminton, enjoys bringing people together, and has a knack for organising events can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What does an HNDRD Student Ambassador do?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors represent HNDRD on campus by organising badminton events and activations, engaging students, and creating a stronger badminton community within their college.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Do I need to be a professional badminton player to apply?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Not at all. You don't need to be a professional player. If you enjoy badminton and have the enthusiasm and ability to organise events and bring people together, you can apply.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What do I get as an HNDRD Student Ambassador?<span class=\"fa-arrow\"><svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg></span></button>\n        <div class=\"fa\">Student Ambassadors receive a monthly stipend, social media exposure, a certificate, and the opportunity to work with and become a part of the HNDRD family.</div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var items = document.querySelectorAll('.sap-faq .fi');\n  items.forEach(function(item){\n    item.querySelector('.fq').addEventListener('click', function(){\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.sap-faq .fi.open').forEach(function(o){ o.classList.remove('open'); });\n      if(!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
