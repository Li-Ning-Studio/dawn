    "custom_liquid_HfFkYp": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HNDRD STUDENT AMBASSADOR\n     SECTION 2: PROGRAM BENEFITS\n============================================================ -->\n\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n\n#hndrd-perks,\n#hndrd-perks * {\n\nbox-sizing:border-box;\nfont-family:Figtree,sans-serif;\n\n}\n\n\n\n#hndrd-perks {\n\n\nposition:relative;\n\noverflow:hidden;\n\n\npadding:90px 24px;\n\n\n\nbackground:\n\nradial-gradient(\ncircle at 20% 0%,\nrgba(130,80,255,.25),\ntransparent 35%\n),\n\nlinear-gradient(\n135deg,\n#100626 0%,\n#1D093D 55%,\n#0A0619 100%\n);\n\n\ncolor:white;\n\n\n}\n\n\n\n#hndrd-perks::before {\n\n\ncontent:\"\";\n\n\nposition:absolute;\n\n\nwidth:500px;\n\nheight:500px;\n\n\nright:-220px;\n\ntop:-200px;\n\n\nborder-radius:50%;\n\n\nbackground:#783CFF;\n\n\nfilter:blur(140px);\n\n\nopacity:.25;\n\n\n}\n\n\n\n\n.hp-inner {\n\n\nposition:relative;\n\nz-index:2;\n\n\nmax-width:1100px;\n\nmargin:auto;\n\n\ntext-align:center;\n\n\n}\n\n\n\n/* HEADER */\n\n\n.hp-label {\n\n\nmargin:0 0 20px;\n\n\nfont-size:13px;\n\n\nfont-weight:700;\n\n\nletter-spacing:.22em;\n\n\ntext-transform:uppercase;\n\n\ncolor:#BFA8FF;\n\n\n}\n\n\n\n.hp-title {\n\n\nmargin:0;\n\n\nfont-size:\n\nclamp(42px,5vw,68px);\n\n\n\nfont-weight:800;\n\n\nline-height:1;\n\n\nletter-spacing:-.045em;\n\n\ntext-transform:uppercase;\n\n\n}\n\n\n\n.hp-title span {\n\n\nbackground:\n\nlinear-gradient(\n90deg,\n#FFFFFF,\n#9865FF\n);\n\n\n-webkit-background-clip:text;\n\n-webkit-text-fill-color:transparent;\n\n\n}\n\n\n\n.hp-description {\n\n\nmax-width:700px;\n\n\nmargin:25px auto 0;\n\n\n\nfont-size:18px;\n\n\nline-height:1.65;\n\n\ncolor:rgba(255,255,255,.65);\n\n\n}\n\n\n\n\n/* CARDS */\n\n\n.hp-grid {\n\n\ndisplay:grid;\n\n\ngrid-template-columns:repeat(3,1fr);\n\n\ngap:18px;\n\n\nmargin-top:55px;\n\n\n}\n\n\n\n.hp-card {\n\n\nposition:relative;\n\n\npadding:34px 28px;\n\n\nmin-height:210px;\n\n\ntext-align:left;\n\n\nborder-radius:22px;\n\n\nbackground:\n\nlinear-gradient(\n145deg,\nrgba(255,255,255,.09),\nrgba(255,255,255,.03)\n);\n\n\nborder:1px solid rgba(255,255,255,.12);\n\n\n\nbackdrop-filter:blur(15px);\n\n\n\noverflow:hidden;\n\n\ntransition:.35s ease;\n\n\n\n}\n\n\n\n.hp-card::before {\n\n\ncontent:\"\";\n\n\nposition:absolute;\n\n\ntop:0;\n\nleft:0;\n\n\nwidth:100%;\n\nheight:2px;\n\n\nbackground:\n\nlinear-gradient(\n90deg,\ntransparent,\n#9865FF,\ntransparent\n);\n\n\nopacity:0;\n\n\ntransition:.35s;\n\n\n}\n\n\n\n.hp-card:hover {\n\n\ntransform:translateY(-8px);\n\n\nborder-color:rgba(160,110,255,.5);\n\n\nbackground:\n\nlinear-gradient(\n145deg,\nrgba(145,90,255,.18),\nrgba(255,255,255,.05)\n);\n\n\n}\n\n\n\n.hp-card:hover::before {\n\n\nopacity:1;\n\n\n}\n\n\n\n\n.hp-number {\n\n\nfont-size:13px;\n\n\nfont-weight:700;\n\n\nletter-spacing:.15em;\n\n\ncolor:#A97CFF;\n\n\nmargin-bottom:25px;\n\n\n}\n\n\n\n.hp-card-title {\n\n\nmargin:0 0 12px;\n\n\nfont-size:22px;\n\n\nfont-weight:700;\n\n\nletter-spacing:-.02em;\n\n\n}\n\n\n\n.hp-card-desc {\n\n\nmargin:0;\n\n\nfont-size:15px;\n\n\nline-height:1.6;\n\n\ncolor:rgba(255,255,255,.62);\n\n\n}\n\n\n\n/* CTA */\n\n\n.hp-action {\n\n\nmargin-top:55px;\n\n\n}\n\n\n\n.hp-cta {\n\n\ndisplay:inline-flex;\n\n\nalign-items:center;\n\n\njustify-content:center;\n\n\n\nheight:60px;\n\n\npadding:0 48px;\n\n\nborder-radius:100px;\n\n\nbackground:\n\nlinear-gradient(\n110deg,\n#9364FF,\n#5C22E8\n);\n\n\n\nborder:1px solid rgba(255,255,255,.25);\n\n\ncolor:white!important;\n\n\ntext-decoration:none;\n\n\nfont-size:14px;\n\n\nfont-weight:700;\n\n\nletter-spacing:.16em;\n\n\ntext-transform:uppercase;\n\n\nbox-shadow:\n\n0 15px 40px rgba(110,45,255,.4),\n\n\ninset 0 1px rgba(255,255,255,.3);\n\n\n\ntransition:.3s ease;\n\n\n}\n\n\n\n.hp-cta:hover {\n\n\ntransform:translateY(-4px);\n\n\nbox-shadow:\n\n0 22px 55px rgba(120,60,255,.55);\n\n\n}\n\n\n\n/* MOBILE */\n\n\n@media(max-width:900px){\n\n\n.hp-grid {\n\n\ngrid-template-columns:1fr;\n\n\n}\n\n\n\n.hp-card {\n\n\nmin-height:auto;\n\n\n}\n\n\n\n}\n\n\n\n@media(max-width:600px){\n\n\n#hndrd-perks {\n\n\npadding:70px 20px;\n\n\n}\n\n\n\n.hp-description {\n\n\nfont-size:16px;\n\n\n}\n\n\n\n.hp-cta {\n\n\nwidth:100%;\n\n\nmax-width:300px;\n\n\n}\n\n\n\n}\n\n\n\n</style>\n\n\n\n<section id=\"hndrd-perks\">\n\n\n<div class=\"hp-inner\">\n\n\n\n<p class=\"hp-label\">\nWhy Join HNDRD\n</p>\n\n\n\n<h2 class=\"hp-title\">\n\nBUILT FOR\n\n<span>BADMINTON.</span>\n\n</h2>\n\n\n\n<p class=\"hp-description\">\n\nGet rewarded for building the badminton community on your campus.\n\nAccess exclusive benefits and become a part of the HNDRD journey.\n\n</p>\n\n\n\n\n<div class=\"hp-grid\">\n\n\n\n<div class=\"hp-card\">\n\n<div class=\"hp-number\">\n01\n</div>\n\n<h3 class=\"hp-card-title\">\nStipend\n</h3>\n\n<p class=\"hp-card-desc\">\nEarn while creating meaningful badminton experiences on your campus.\n</p>\n\n</div>\n\n\n\n\n<div class=\"hp-card\">\n\n<div class=\"hp-number\">\n02\n</div>\n\n<h3 class=\"hp-card-title\">\nCertificate\n</h3>\n\n<p class=\"hp-card-desc\">\nReceive an official HNDRD Student Ambassador certificate.\n</p>\n\n</div>\n\n\n\n\n<div class=\"hp-card\">\n\n<div class=\"hp-number\">\n03\n</div>\n\n<h3 class=\"hp-card-title\">\nSocial Media Exposure\n</h3>\n\n<p class=\"hp-card-desc\">\nGet featured through HNDRD's community and digital platforms.\n</p>\n\n</div>\n\n\n\n\n<div class=\"hp-card\">\n\n<div class=\"hp-number\">\n04\n</div>\n\n<h3 class=\"hp-card-title\">\nFree Products\n</h3>\n\n<p class=\"hp-card-desc\">\nExperience HNDRD products and represent the brand on campus.\n</p>\n\n</div>\n\n\n\n\n<div class=\"hp-card\">\n\n<div class=\"hp-number\">\n05\n</div>\n\n<h3 class=\"hp-card-title\">\nHNDRD Family\n</h3>\n\n<p class=\"hp-card-desc\">\nBecome part of a growing badminton community across campuses.\n</p>\n\n</div>\n\n\n\n</div>\n\n\n\n\n<div class=\"hp-action\">\n\n<a href=\"#hndrd-register\" class=\"hp-cta\">\n\nBECOME AN AMBASSADOR\n\n</a>\n\n</div>\n\n\n\n\n</div>\n\n\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_UndVHN": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 5: EVENT DETAILS\n     Shopify: Themes > Customize > Add Section > Custom HTML\n\n     Design: Vertical info strip. Each detail is a full-width row\n     with an SVG icon, label, and value — all connected by a gold\n     vertical timeline line. Mobile-first: reads perfectly as a\n     single column on any screen size. The date row is hero-sized\n     to anchor the section. Alternating row tints add rhythm.\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n  /* ── Section wrapper ── */\n  .sv-details {\n    background: #4E1164;\n    padding: 80px 24px;\n  }\n\n  .sv-details__inner {\n    max-width: 640px;\n    margin: 0 auto;\n  }\n\n  /* ── Section header ── */\n  .sv-details__eyebrow {\n    display: block;\n    font-family:Figtree;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #FFD400;\n    margin-bottom: 12px;\n  }\n\n  .sv-details__title {\n    font-family: Figtree;\n    font-weight: 900;\n    font-size: clamp(4.4rem, 8vw, 5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 48px 0;\n  }\n\n  /* ── Timeline container ── */\n  .sv-details__timeline {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* The vertical gold line running through all rows */\n  .sv-details__timeline::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 27px;\n    width: 2px;\n    background: linear-gradient(\n      to bottom,\n      transparent 0%,\n      #F5C500 8%,\n      #F5C500 92%,\n      transparent 100%\n    );\n    z-index: 0;\n  }\n\n  /* ── Individual row ── */\n  .sv-details__row {\n    display: flex;\n    align-items: flex-start;\n    gap: 24px;\n    padding: 24px 20px 24px 0;\n    position: relative;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n    transition: background 0.2s;\n  }\n\n  .sv-details__row:first-child { padding-top: 0; }\n  .sv-details__row:last-child  { border-bottom: none; padding-bottom: 0; }\n\n  .sv-details__row:hover {\n    background: rgba(245, 197, 0, 0.04);\n   \n  }\n\n  /* ── Icon node on the timeline ── */\n  .sv-details__node {\n    flex-shrink: 0;\n    width: 56px;\n    height: 56px;\n    background: #6D188C;\n    border: 2px solid rgba(245, 197, 0, 0.35);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    z-index: 1;\n    transition: border-color 0.2s, background 0.2s;\n  }\n\n  .sv-details__row:hover .sv-details__node {\n    border-color: #F5C500;\n    background: #3A0D7A;\n  }\n\n  .sv-details__node svg {\n    width: 22px;\n    height: 22px;\n  }\n\n  /* ── Text block ── */\n  .sv-details__text {\n    flex: 1;\n    padding-top: 10px;\n  }\n\n  .sv-details__label {\n    display: block;\n    font-family: Figtree;\n    font-size: 1.265rem;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #F5C500;\n    opacity: 0.75;\n    margin-bottom: 4px;\n  }\n\n  .sv-details__value {\n    font-family: Figtree;\n    font-weight: 700;\n    font-size: clamp(2.8rem, 4vw, 4rem);\n    line-height: 1;\n    text-transform: uppercase;\n    color: #ffffff;\n    letter-spacing: 0.02em;\n  }\n\n  .sv-details__sub {\n    display: block;\n    font-family: Figtree;\n    font-size: 1.28rem;\n    color: #F0EAF8;\n    opacity: 0.5;\n    margin-top: 5px;\n    line-height: 1.5;\n  }\n\n  /* ── Hero date row — visually dominant ── */\n  .sv-details__row--date .sv-details__node {\n    width: 56px;\n    height: 56px;\n    background: #F5C500;\n    border-color: #F5C500;\n  }\n\n  .sv-details__row--date .sv-details__node svg {\n    color: #1A0640;\n  }\n\n  .sv-details__row--date .sv-details__value {\n    font-size: clamp(2rem, 7vw, 3rem);\n    color: #F5C500;\n  }\n\n  @media (max-width: 480px) {\n    .sv-details { padding: 60px 20px; }\n    .sv-details__row { gap: 18px; }\n    .sv-details__node { width: 48px; height: 48px; }\n    .sv-details__node svg { width: 18px; height: 18px; }\n    .sv-details__timeline::before { left: 23px; }\n  }\n\n</style>\n\n<section class=\"sv-details\">\n  <div class=\"sv-details__inner\">\n\n    <span class=\"sv-details__eyebrow\">Event Details</span>\n    <h2 class=\"sv-details__title\">Mark the<br>calendar</h2>\n\n    <div class=\"sv-details__timeline\">\n\n      <!-- DATE — hero row -->\n      <div class=\"sv-details__row sv-details__row--date\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1A0640\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/>\n            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n            <line x1=\"8\"  y1=\"2\" x2=\"8\"  y2=\"6\"/>\n            <line x1=\"3\"  y1=\"10\" x2=\"21\" y2=\"10\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Date</span>\n          <div class=\"sv-details__value\">Sunday, 6th Sept 2026</div>\n        </div>\n      </div>\n\n      <!-- TIME -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n            <polyline points=\"12 7 12 12 15 15\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Reporting Time</span>\n          <div class=\"sv-details__value\">11:00 AM onwards</div>\n          <span class=\"sv-details__sub\">Late arrivals may forfeit their first matches</span>\n        </div>\n      </div>\n\n      <!-- VENUE -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z\"/>\n            <circle cx=\"12\" cy=\"9\" r=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Venue</span>\n          <div class=\"sv-details__value\">Smashbounce Korattur,chennai</div>\n        <a  href=\"https://maps.app.goo.gl/9ozehbziPF9v7J6P9\" style=\"color: red; text-decoration: none; font-size: 20px;\">  <span class=\"\" >Get Directions -></span></a>\n        </div>\n      </div>\n\n      <!-- DURATION -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Duration</span>\n          <div class=\"sv-details__value\">3 Hours</div>\n          <span class=\"sv-details__sub\">Approximately</span>\n        </div>\n      </div>\n\n      <!-- ENTRY FEE -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"2\" y=\"6\" width=\"20\" height=\"13\" rx=\"2\"/>\n            <path d=\"M2 10h20\"/>\n            <circle cx=\"12\" cy=\"15\" r=\"1.5\" fill=\"#F5C500\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Entry Fee</span>\n          <div class=\"sv-details__value\">₹299</div>\n          <span class=\"sv-details__sub\">Per participant · Limited slots available</span>\n        </div>\n      </div>\n\n      <!-- ORGANIZED BY -->\n      <div class=\"sv-details__row\">\n        <div class=\"sv-details__node\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F5C500\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/>\n            <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n            <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/>\n            <path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>\n          </svg>\n        </div>\n        <div class=\"sv-details__text\">\n          <span class=\"sv-details__label\">Organized By</span>\n          <div class=\"sv-details__value\">HNDRD</div>\n          <span class=\"sv-details__sub\">Spectators welcome · Subject to venue capacity</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
