    "custom_liquid_wEr9EG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HNDRD STUDENT AMBASSADOR PROGRAM\n     HERO INTRO SECTION\n============================================================ -->\n\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n\n#hndrd-student-hero,\n#hndrd-student-hero * {\n\n  box-sizing:border-box;\n  font-family:Figtree, sans-serif;\n\n}\n\n\n\n#hndrd-student-hero {\n\n\n  position:relative;\n\n  width:100%;\n\n  min-height:650px;\n\n\n  display:flex;\n\n  align-items:center;\n\n  justify-content:center;\n\n\n  overflow:hidden;\n\n\n  padding:100px 24px;\n\n\n\n  text-align:center;\n\n\n  background:\n\n  radial-gradient(\n  circle at 50% 0%,\n  rgba(108,0,255,.3),\n  transparent 40%\n  ),\n\n  radial-gradient(\n  circle at 90% 90%,\n  rgba(8,27,125,.35),\n  transparent 45%\n  ),\n\n\n  #030213;\n\n\n  color:white;\n\n}\n\n\n\n/* background glow */\n\n\n#hndrd-student-hero::before {\n\n\ncontent:\"\";\n\nposition:absolute;\n\n\nwidth:550px;\n\nheight:550px;\n\n\ntop:-280px;\n\nleft:50%;\n\n\ntransform:translateX(-50%);\n\n\n\nbackground:#6C00FF;\n\n\nfilter:blur(150px);\n\n\nopacity:.3;\n\n\n}\n\n\n\n#hndrd-student-hero::after {\n\n\ncontent:\"\";\n\n\nposition:absolute;\n\n\nwidth:350px;\n\nheight:350px;\n\n\nbottom:-180px;\n\nleft:-100px;\n\n\n\nbackground:#081B7D;\n\n\nfilter:blur(120px);\n\n\nopacity:.5;\n\n\n}\n\n\n\n\n\n.hs-inner {\n\n\nposition:relative;\n\nz-index:2;\n\n\nmax-width:950px;\n\n\nmargin:auto;\n\n\n}\n\n\n\n/* small heading */\n\n\n.hs-label {\n\n\nfont-size:14px;\n\n\nfont-weight:700;\n\n\nletter-spacing:.22em;\n\n\ntext-transform:uppercase;\n\n\ncolor:#FCEBFF;\n\n\n\nmargin-bottom:28px;\n\n\n}\n\n\n\n\n\n/* main heading */\n\n\n.hs-title {\n\n\nmargin:0;\n\n\nfont-size:\n\nclamp(48px,6.5vw,86px);\n\n\n\nfont-weight:800;\n\n\n\nline-height:1;\n\n\n\nletter-spacing:-0.045em;\n\n\ntext-transform:uppercase;\n\n\n}\n\n\n\n.hs-title span {\n\n\ncolor:#6C00FF;\n\n\nbackground:\n\nlinear-gradient(\n90deg,\n#FFFFFF,\n#6C00FF\n);\n\n\n\n-webkit-background-clip:text;\n\nbackground-clip:text;\n\n-webkit-text-fill-color:transparent;\n\n\n}\n\n\n\n\n\n/* description */\n\n\n.hs-description {\n\n\nmax-width:760px;\n\n\nmargin:38px auto 0;\n\n\n\nfont-size:\n\nclamp(17px,1.8vw,22px);\n\n\n\nfont-weight:400;\n\n\nline-height:1.7;\n\n\n\ncolor:\n\nrgba(255,255,255,.72);\n\n\n}\n\n\n\n.hs-description strong {\n\n\ncolor:#FCEBFF;\n\n\nfont-weight:700;\n\n\n}\n\n\n\n\n\n/* ===========================\n   PREMIUM CTA BUTTON\n=========================== */\n\n\n.hs-button {\n\n\ndisplay:inline-flex;\n\n\nalign-items:center;\n\njustify-content:center;\n\n\n\nmargin-top:44px;\n\n\n\nheight:62px;\n\n\npadding:0 58px;\n\n\n\nbackground:\n\nlinear-gradient(\n135deg,\n#FFFFFF 0%,\n#FCEBFF 100%\n);\n\n\n\ncolor:#081B7D!important;\n\n\n\nborder-radius:999px;\n\n\n\nfont-size:14px;\n\n\n\nfont-weight:800;\n\n\n\nletter-spacing:.22em;\n\n\n\ntext-transform:uppercase;\n\n\n\ntext-decoration:none;\n\n\n\nborder:1px solid rgba(255,255,255,.7);\n\n\n\nposition:relative;\n\n\noverflow:hidden;\n\n\n\ntransition:\n\ntransform .35s ease,\n\nbox-shadow .35s ease,\n\nbackground .35s ease;\n\n\n\nbox-shadow:\n\n0 15px 40px rgba(0,0,0,.35),\n\ninset 0 1px 0 rgba(255,255,255,.8);\n\n\n}\n\n\n\n/* Shine effect */\n\n\n.hs-button::before {\n\n\ncontent:\"\";\n\n\nposition:absolute;\n\n\ntop:0;\n\n\nleft:-120%;\n\n\n\nwidth:80%;\n\n\n\nheight:100%;\n\n\n\nbackground:\n\nlinear-gradient(\n\n90deg,\n\ntransparent,\n\nrgba(255,255,255,.65),\n\ntransparent\n\n);\n\n\n\ntransform:skewX(-20deg);\n\n\n\ntransition:.7s ease;\n\n\n}\n\n\n\n.hs-button:hover::before {\n\n\nleft:130%;\n\n\n}\n\n\n\n\n\n.hs-button:hover {\n\n\nbackground:\n\nlinear-gradient(\n\n135deg,\n\n#6C00FF,\n\n#081B7D\n\n);\n\n\n\nborder-color:#6C00FF;\n\n\n\ncolor:white!important;\n\n\n\ntransform:\n\ntranslateY(-5px);\n\n\n\nbox-shadow:\n\n\n0 22px 60px rgba(108,0,255,.45),\n\n0 0 30px rgba(8,27,125,.4);\n\n\n\n}\n\n\n\n\n\n/* bottom branding */\n\n\n.hs-bottom {\n\n\n\nmargin-top:26px;\n\n\n\nfont-size:13px;\n\n\n\nfont-weight:600;\n\n\n\nletter-spacing:.18em;\n\n\n\ntext-transform:uppercase;\n\n\n\ncolor:rgba(255,255,255,.45);\n\n\n\n}\n\n\n\n.hs-bottom span {\n\n\ncolor:#FCEBFF;\n\n\n}\n\n\n\n\n\n/* mobile */\n\n\n@media(max-width:600px){\n\n\n#hndrd-student-hero {\n\n\nmin-height:560px;\n\n\npadding:75px 20px;\n\n\n}\n\n\n\n.hs-label {\n\n\nfont-size:12px;\n\n\nmargin-bottom:22px;\n\n\n}\n\n\n\n.hs-title {\n\n\nfont-size:52px;\n\n\n}\n\n\n\n.hs-description {\n\n\nmargin-top:28px;\n\n\nfont-size:17px;\n\n\nline-height:1.6;\n\n\n}\n\n\n\n.hs-button {\n\n\nheight:56px;\n\n\npadding:0 38px;\n\n\nfont-size:13px;\n\n\nletter-spacing:.18em;\n\n\n}\n\n\n\n}\n\n\n\n</style>\n\n\n\n\n<section id=\"hndrd-student-hero\">\n\n\n<div class=\"hs-inner\">\n\n\n\n<div class=\"hs-label\">\n\nHNDRD Student Ambassador Program\n\n</div>\n\n\n\n\n<h1 class=\"hs-title\">\n\nBE THE FACE OF\n\n<br>\n\n<span>HNDRD.</span>\n\n</h1>\n\n\n\n\n\n<p class=\"hs-description\">\n\n\nTurn your passion for badminton into action.\n\n\nJoin the <strong>HNDRD Student Ambassador Program</strong>\n\n\nto organise campus activations, build communities,\n\n\nand bring the game closer to more players.\n\n\n</p>\n\n\n\n\n\n<a href=\"#hndrd-register\" class=\"hs-button\">\n\nAPPLY TO JOIN\n\n</a>\n\n\n\n\n\n<div class=\"hs-bottom\">\n\nJOIN THE <span>HNDRD FAMILY</span>\n\n</div>\n\n\n\n\n</div>\n\n\n</section>",
