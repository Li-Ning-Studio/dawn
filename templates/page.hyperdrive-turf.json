lid rgba(255,255,255,0.25);\n    text-decoration: none;\n    display: inline-block;\n    transition: border-color 0.2s;\n  }\n  .hs-fcta-btn-b:hover { border-color: #f5f3ef; }\n  .hs-fcta-trust {\n    margin-top: 2rem;\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.28rem;\n    color: #888;\n    letter-spacing: 0.04em;\n  }\n\n  @media (max-width: 540px) {\n    .hs-fcta { padding: 3.5rem 1.25rem; }\n    .hs-fcta-actions { flex-direction: column; align-items: center; }\n    .hs-fcta-btn-a, .hs-fcta-btn-b { width: 100%; text-align: center; }\n  }\n</style>\n\n<section class=\"hs-fcta\">\n  <div class=\"hs-fcta-inner\">\n    <p class=\"hs-fcta-label\">Ready to Dominate?</p>\n    <h2 class=\"hs-fcta-title\">Pick Your Pitch.<br>Own Every Game.</h2>\n    <p class=\"hs-fcta-sub\">HyperDrive &nbsp;·&nbsp; HyperTurf &nbsp;·&nbsp; ₹1,599 each &nbsp;·&nbsp; Free Shipping</p>\n    <div class=\"hs-fcta-actions\">\n      <a href=\"/products/hyper-drive\" class=\"hs-fcta-btn-a\">Shop HyperDrive</a>\n      <a href=\"/products/hyper-turf\" class=\"hs-fcta-btn-b\">Shop HyperTurf →</a>\n    </div>\n    <p class=\"hs-fcta-trust\">✓ Free Shipping &nbsp;&nbsp; ✓ COD Available &nbsp;&nbsp; ✓ 7-Day Returns &nbsp;&nbsp; ✓ Warranty</p>\n  </div>\n</section>",
