    "custom_liquid_MMwd7G": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — SECTION 8: FAQ ACCORDION\n     Paste inside a Custom Liquid section in Shopify\n     ============================================================ -->\n\n<style>\n  .hs-faq {\n    padding: 5rem 2rem;\n    background: #0a0a0a;\n  }\n  .hs-faq-inner {\n    max-width: 860px;\n    margin: 0 auto;\n  }\n  .hs-faq .hs-section-label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 1.28rem;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: #b8f000;\n    margin-bottom: 0.5rem;\n  }\n  .hs-faq .hs-section-title {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(4.2rem, 5vw, 3.8rem);\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 3rem;\n  }\n  .hs-faq-item {\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  .hs-faq-q {\n    width: 100%;\n    background: none;\n    border: none;\n    padding: 1.35rem 0;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    cursor: pointer;\n    text-align: left;\n    gap: 1rem;\n  }\n  .hs-faq-q-text {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 1.6rem;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    color: #f5f3ef;\n    line-height: 1.3;\n  }\n  .hs-faq-toggle {\n    flex-shrink: 0;\n    width: 24px;\n    height: 24px;\n    border: 1px solid rgba(255,255,255,0.2);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.9rem;\n    color: #888;\n    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.25s;\n  }\n  .hs-faq-item.hs-open .hs-faq-toggle {\n    background: #b8f000;\n    border-color: #b8f000;\n    color: #0a0a0a;\n    transform: rotate(45deg);\n  }\n  .hs-faq-a {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.35s ease, padding 0.35s ease;\n    padding: 0;\n  }\n  .hs-faq-item.hs-open .hs-faq-a {\n    max-height: 300px;\n    padding-bottom: 1.25rem;\n  }\n  .hs-faq-a-text {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.39rem;\n    color: #888;\n    line-height: 1.7;\n  }\n\n  @media (max-width: 540px) {\n    .hs-faq { padding: 3.5rem 1.25rem; }\n    .hs-faq-q-text { font-size: 1.7rem; }\n  }\n</style>\n\n<section class=\"hs-faq\" id=\"hs-faq\">\n  <div class=\"hs-faq-inner\">\n    <p class=\"hs-section-label\">Got Questions</p>\n    <h2 class=\"hs-section-title\">FAQ</h2>\n\n    <div class=\"hs-faq-item hs-open\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">What is the difference between HyperDrive and HyperTurf?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">HyperDrive is optimised for hard natural pitches — ideal for batsmen and all-rounders who need confident lateral movement. HyperTurf is built specifically for synthetic turf and multi-surface grounds, featuring enhanced robust construction to handle abrasive surfaces. Both shoes share the same core technology (HexaFoam, TerraSpike, Vegan Leather, Stability Plate) at the same price of ₹1,599.</p>\n      </div>\n    </div>\n\n    <div class=\"hs-faq-item\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">Is ₹1,599 the final price or are there extra charges?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">₹1,599 is the all-inclusive MRP with taxes included. Shipping is free across India. Cash on Delivery is available for orders under ₹5,000 at no extra charge.</p>\n      </div>\n    </div>\n\n    <div class=\"hs-faq-item\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">What UK sizes are available?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">Both HyperDrive and HyperTurf are available in UK sizes from 1 UK upward, covering the full junior to adult range. Availability per colorway may vary — check the individual product page for real-time stock.</p>\n      </div>\n    </div>\n\n    <div class=\"hs-faq-item\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">What if the size doesn't fit?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">Hundred offers a 7-day easy exchange and return policy. Raise a request via the Returns portal on the website and the team will arrange a pickup and replacement within 2–3 business days at no additional cost.</p>\n      </div>\n    </div>\n\n    <div class=\"hs-faq-item\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">How long does delivery take across India?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">Most orders are delivered within 2–4 business days across India. You will receive a tracking link via SMS and WhatsApp once your order ships.</p>\n      </div>\n    </div>\n\n    <div class=\"hs-faq-item\">\n      <button class=\"hs-faq-q\" onclick=\"hsFaqToggle(this)\">\n        <span class=\"hs-faq-q-text\">Are these shoes suitable for all cricket formats?</span>\n        <span class=\"hs-faq-toggle\">+</span>\n      </button>\n      <div class=\"hs-faq-a\">\n        <p class=\"hs-faq-a-text\">Yes. HyperDrive performs best on traditional red-soil and hard pitches found in club and academy cricket. HyperTurf excels on synthetic, astroturf, and multi-use cricket pitches popular in T20 formats and urban academies. If you play on both surfaces regularly, the combo deal (both pairs) offers the best value.</p>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n  function hsFaqToggle(btn) {\n    var item = btn.closest('.hs-faq-item');\n    var isOpen = item.classList.contains('hs-open');\n    document.querySelectorAll('.hs-faq-item').forEach(function(i) {\n      i.classList.remove('hs-open');\n    });\n    if (!isOpen) {\n      item.classList.add('hs-open');\n    }\n  }\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
