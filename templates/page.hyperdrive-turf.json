  }\n  .hsb-price-note {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.68rem;\n    color: #555;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n  }\n\n  /* CTAs */\n  .hsb-ctas {\n    display: flex;\n    gap: 0.75rem;\n    flex-wrap: wrap;\n    margin-bottom: 2rem;\n  }\n  .hsb-btn-a {\n    background: #b8f000;\n    color: #0a0a0a;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 0.95rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.9rem 2rem;\n    text-decoration: none;\n    display: inline-block;\n    border: none;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: opacity 0.15s, transform 0.15s;\n  }\n  .hsb-btn-a:hover { opacity: 0.88; transform: translateY(-2px); }\n\n  .hsb-btn-b {\n    background: transparent;\n    color: #f5f3ef;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 0.95rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.9rem 2rem;\n    border: 1px solid rgba(255,255,255,0.18);\n    text-decoration: none;\n    display: inline-block;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: border-color 0.2s, transform 0.15s;\n  }\n  .hsb-btn-b:hover { border-color: rgba(255,255,255,0.6); transform: translateY(-2px); }\n\n  /* trust strip */\n  .hsb-trust {\n    display: flex;\n    gap: 1.25rem;\n    flex-wrap: wrap;\n  }\n  .hsb-trust-item {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.68rem;\n    color: #444;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .hsb-trust-item::before {\n    content: '✓';\n    color: #b8f000;\n    font-size: 0.65rem;\n  }\n\n  /* ── RIGHT: IMAGE PANEL ── */\n  .hsb-right {\n    position: relative;\n    overflow: hidden;\n    background: #111;\n  }\n\n  /* main product image */\n  .hsb-main-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center center;\n    display: block;\n    transition: opacity 0.35s ease;\n  }\n\n  /* dark overlay on image for contrast */\n  .hsb-img-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      135deg,\n      rgba(13,13,13,0.55) 0%,\n      transparent 60%\n    );\n    pointer-events: none;\n  }\n\n  /* floating info cards on image */\n  .hsb-img-badge-tl {\n    position: absolute;\n    top: 1.5rem;\n    left: 1.5rem;\n    background: rgba(10,10,10,0.82);\n    border: 1px solid rgba(184,240,0,0.25);\n    padding: 0.6rem 1rem;\n    backdrop-filter: blur(4px);\n  }\n  .hsb-badge-label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 0.62rem;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #b8f000;\n    display: block;\n    margin-bottom: 2px;\n  }\n  .hsb-badge-val {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 1rem;\n    font-weight: 900;\n    color: #f5f3ef;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .hsb-img-badge-br {\n    position: absolute;\n    bottom: 1.5rem;\n    right: 1.5rem;\n    background: rgba(10,10,10,0.82);\n    border: 1px solid rgba(255,255,255,0.08);\n    padding: 0.6rem 1rem;\n    backdrop-filter: blur(4px);\n    text-align: right;\n  }\n\n  /* color swatch switcher on image */\n  .hsb-swatch-strip {\n    position: absolute;\n    bottom: 1.5rem;\n    left: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n    align-items: flex-start;\n  }\n  .hsb-swatch-label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 0.6rem;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: rgba(245,243,239,0.4);\n  }\n  .hsb-swatches {\n    display: flex;\n    gap: 6px;\n  }\n  .hsb-swatch {\n    width: 28px;\n    height: 28px;\n    border: 2px solid transparent;\n    overflow: hidden;\n    cursor: pointer;\n    transition: border-color 0.15s;\n    flex-shrink: 0;\n    background: #1a1a1a;\n  }\n  .hsb-swatch img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .hsb-swatch:hover,\n  .hsb-swatch.hsb-active { border-color: #f5f3ef; }\n\n  /* model toggle pill (Drive / Turf) */\n  .hsb-model-toggle {\n    position: absolute;\n    top: 1.5rem;\n    right: 1.5rem;\n    display: flex;\n    gap: 1px;\n    background: rgba(10,10,10,0.7);\n    backdrop-filter: blur(4px);\n    border: 1px solid rgba(255,255,255,0.08);\n    overflow: hidden;\n  }\n  .hsb-toggle-btn {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 800;\n    font-size: 0.72rem;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    padding: 0.5rem 1rem;\n    border: none;\n    cursor: pointer;\n    transition: background 0.15s, color 0.15s;\n    background: transparent;\n    color: #555;\n  }\n  .hsb-toggle-btn.hsb-active-drive {\n    background: #b8f000;\n    color: #0a0a0a;\n  }\n  .hsb-toggle-btn.hsb-active-turf {\n    background: #00d4ff;\n    color: #0a0a0a;\n  }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 960px) {\n    .hsb-wrap {\n      grid-template-columns: 1fr;\n      min-height: auto;\n    }\n    .hsb-left {\n      padding: 2.5rem 1.75rem;\n      order: 2;\n    }\n    .hsb-right {\n      order: 1;\n      min-height: 55vw;\n    }\n    .hsb-topbar { display: none; }\n    .hsb-middle { padding: 0; }\n  }\n\n  @media (max-width: 540px) {\n    .hsb-left { padding: 2rem 1.25rem; }\n    .hsb-headline { font-size: clamp(3.2rem, 14vw, 4.5rem); }\n    .hsb-btn-a,\n    .hsb-btn-b { width: 100%; text-align: center; }\n    .hsb-ctas { flex-direction: column; }\n    .hsb-right { min-height: 70vw; }\n  }\n</style>\n\n<section class=\"hsb-wrap\" id=\"hs-hero\">\n\n  <!-- ══ LEFT TEXT PANEL ══ -->\n  <div class=\"hsb-left\">\n\n    <!-- top nav -->\n    <div class=\"hsb-topbar\">\n      <a href=\"/\" class=\"hsb-brand\">HUN<span>D</span>RED</a>\n      <a href=\"/collections/cricket-shoes\" class=\"hsb-nav-link\">All Cricket Shoes →</a>\n    </div>\n\n    <!-- headline block -->\n    <div class=\"hsb-middle\">\n      <p class=\"hsb-eyebrow\">Hundred &nbsp;·&nbsp; Cricket Shoes 2025</p>\n\n      <h1 class=\"hsb-headline\">\n        <span class=\"hsb-ac1\">Hyper</span><br>\n        <span id=\"hsb-name-display\">Drive</span><br>\n        <span class=\"hsb-ol\">Series</span>\n      </h1>\n\n      <p class=\"hsb-tagline\" id=\"hsb-tagline-display\">\n        Engineered for the modern cricketer on hard pitches. HexaFoam cushioning and TerraSpike grip — top-notch performance with every step.\n      </p>\n\n      <div class=\"hsb-features\">\n        <span class=\"hsb-feat\"><span class=\"hsb-feat-dot\"></span>HexaFoam midsole — superior shock absorption</span>\n        <span class=\"hsb-feat\"><span class=\"hsb-feat-dot\"></span>TerraSpike outsole — unbeatable grip on any surface</span>\n        <span class=\"hsb-feat\"><span class=\"hsb-feat-dot\"></span>Vegan leather upper — durable &amp; eco-conscious</span>\n        <span class=\"hsb-feat\"><span class=\"hsb-feat-dot\"></span>Stability plate — reduces injury risk</span>\n      </div>\n\n      <div class=\"hsb-price-row\">\n        <span class=\"hsb-price-now\">₹1,599</span>\n        <div class=\"hsb-price-meta\">\n          <span class=\"hsb-price-was\">₹2,499</span>\n          <span class=\"hsb-price-note\">Incl. taxes &nbsp;·&nbsp; Free shipping</span>\n        </div>\n      </div>\n\n      <div class=\"hsb-ctas\">\n        <a href=\"/products/hyper-drive\" class=\"hsb-btn-a\" id=\"hsb-cta-primary\">Buy HyperDrive →</a>\n        <a href=\"/products/hyper-turf\"  class=\"hsb-btn-b\" id=\"hsb-cta-secondary\">See HyperTurf</a>\n      </div>\n\n      <div class=\"hsb-trust\">\n        <span class=\"hsb-trust-item\">Free Shipping</span>\n        <span class=\"hsb-trust-item\">COD Available</span>\n        <span class=\"hsb-trust-item\">7-Day Returns</span>\n        <span class=\"hsb-trust-item\">Warranty Covered</span>\n      </div>\n    </div>\n\n    <!-- spacer so trust sits at bottom on tall screens -->\n    <div></div>\n\n  </div>\n\n  <!-- ══ RIGHT IMAGE PANEL ══ -->\n  <div class=\"hsb-right\">\n\n    <img\n      class=\"hsb-main-img\"\n      id=\"hsb-main-img\"\n      src=\"https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=1200\"\n      alt=\"HyperDrive Cricket Shoe\"\n      loading=\"eager\"\n      fetchpriority=\"high\"\n    >\n\n    <div class=\"hsb-img-overlay\"></div>\n\n    <!-- model toggle top-right -->\n    <div class=\"hsb-model-toggle\">\n      <button class=\"hsb-toggle-btn hsb-active-drive\" id=\"hsb-tog-drive\" onclick=\"hsbSwitch('drive')\">Drive</button>\n      <button class=\"hsb-toggle-btn\" id=\"hsb-tog-turf\" onclick=\"hsbSwitch('turf')\">Turf</button>\n    </div>\n\n    <!-- surface badge top-left -->\n    <div class=\"hsb-img-badge-tl\" id=\"hsb-surface-badge\">\n      <span class=\"hsb-badge-label\">Best surface</span>\n      <span class=\"hsb-badge-val\" id=\"hsb-surface-val\">Hard Pitch</span>\n    </div>\n\n    <!-- color swatches bottom-left -->\n    <div class=\"hsb-swatch-strip\">\n      <span class=\"hsb-swatch-label\" id=\"hsb-swatch-label\">4 colors</span>\n      <div class=\"hsb-swatches\" id=\"hsb-swatches-drive\">\n        <div class=\"hsb-swatch hsb-active\" onclick=\"hsbColor('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=200\" alt=\"White Lime Blue\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_0da120431e.png?v=1749011419&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_0da120431e.png?v=1749011419&width=200\" alt=\"White Lime Orange\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_0604d18dc1.png?v=1749011420&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_0604d18dc1.png?v=1749011420&width=200\" alt=\"White Navy Orange\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_2b131ad68c.png?v=1749011421&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_2b131ad68c.png?v=1749011421&width=200\" alt=\"White Red Black\">\n        </div>\n      </div>\n      <div class=\"hsb-swatches\" id=\"hsb-swatches-turf\" style=\"display:none\">\n        <div class=\"hsb-swatch hsb-active\" onclick=\"hsbColor('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=200\" alt=\"White Light Green\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_24a1490adf.png?v=1749011396&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_24a1490adf.png?v=1749011396&width=200\" alt=\"White Navy\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_2470225e41.png?v=1749011397&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_2470225e41.png?v=1749011397&width=200\" alt=\"White Lime Black\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_18da85db09.png?v=1749011397&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_18da85db09.png?v=1749011397&width=200\" alt=\"White Black Red\">\n        </div>\n        <div class=\"hsb-swatch\" onclick=\"hsbColor('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_fe298d101d.png?v=1749011398&width=1200')\">\n          <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_fe298d101d.png?v=1749011398&width=200\" alt=\"White Blue Orange\">\n        </div>\n      </div>\n    </div>\n\n    <!-- price badge bottom-right -->\n    <div class=\"hsb-img-badge-br\">\n      <span class=\"hsb-badge-label\">Only</span>\n      <span class=\"hsb-badge-val\">₹1,599</span>\n    </div>\n\n  </div>\n</section>\n\n<script>\n  var hsbData = {\n    drive: {\n      name: 'Drive',\n      tagline: 'Engineered for the modern cricketer on hard pitches. HexaFoam cushioning and TerraSpike grip — top-notch performance with every step.',\n      surface: 'Hard Pitch',\n      colors: '4 colors',\n      ctaPrimary: { text: 'Buy HyperDrive →', href: '/products/hyper-drive' },\n      ctaSecondary: { text: 'See HyperTurf', href: '/products/hyper-turf' },\n      defaultImg: 'https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=1200'\n    },\n    turf: {\n      name: 'Turf',\n      tagline: 'Built for synthetic turf and multi-surface pitches. Robust construction meets eco-conscious performance — 6 shades to match your squad.',\n      surface: 'Synthetic Turf',\n      colors: '6 colors',\n      ctaPrimary: { text: 'Buy HyperTurf →', href: '/products/hyper-turf' },\n      ctaSecondary: { text: 'See HyperDrive', href: '/products/hyper-drive' },\n      defaultImg: 'https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=1200'\n    }\n  };\n\n  function hsbSwitch(type) {\n    var d = hsbData[type];\n\n    /* headline name */\n    document.getElementById('hsb-name-display').textContent = d.name;\n\n    /* update name color */\n    var nameEl = document.getElementById('hsb-name-display');\n    nameEl.style.color = type === 'drive' ? '#b8f000' : '#00d4ff';\n\n    /* tagline */\n    document.getElementById('hsb-tagline-display').textContent = d.tagline;\n\n    /* surface badge */\n    document.getElementById('hsb-surface-val').textContent = d.surface;\n\n    /* swatch label */\n    document.getElementById('hsb-swatch-label').textContent = d.colors;\n\n    /* swatch rows */\n    document.getElementById('hsb-swatches-drive').style.display = type === 'drive' ? 'flex' : 'none';\n    document.getElementById('hsb-swatches-turf').style.display  = type === 'turf'  ? 'flex' : 'none';\n\n    /* main image */\n    document.getElementById('hsb-main-img').src = d.defaultImg;\n\n    /* CTAs */\n    var btnA = document.getElementById('hsb-cta-primary');\n    var btnB = document.getElementById('hsb-cta-secondary');\n    btnA.textContent = d.ctaPrimary.text;\n    btnA.href        = d.ctaPrimary.href;\n    btnB.textContent = d.ctaSecondary.text;\n    btnB.href        = d.ctaSecondary.href;\n\n    /* toggle button states */\n    document.getElementById('hsb-tog-drive').className = 'hsb-toggle-btn' + (type === 'drive' ? ' hsb-active-drive' : '');\n    document.getElementById('hsb-tog-turf').className  = 'hsb-toggle-btn' + (type === 'turf'  ? ' hsb-active-turf'  : '');\n\n    /* reset active swatch */\n    document.querySelectorAll('#hsb-swatches-' + type + ' .hsb-swatch').forEach(function(s, i) {\n      s.classList.toggle('hsb-active', i === 0);\n    });\n  }\n\n  function hsbColor(type, el, src) {\n    document.getElementById('hsb-main-img').src = src;\n    document.querySelectorAll('#hsb-swatches-' + type + ' .hsb-swatch').forEach(function(s) {\n      s.classList.remove('hsb-active');\n    });\n    el.classList.add('hsb-active');\n  }\n</script>",
