    "custom_liquid_TPkUib": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — SECTION 2: TRUST BAR (SCROLLING TICKER)\n     Paste inside a Custom Liquid section in Shopify\n     ============================================================ -->\n\n<style>\n  .hs-trust-bar {\n    background: #b8f000;\n    padding: 0.8rem 0;\n    overflow: hidden;\n    white-space: nowrap;\n  }\n  .hs-trust-track {\n    display: inline-flex;\n    gap: 0;\n    animation: hs-scroll-trust 22s linear infinite;\n  }\n  .hs-trust-bar:hover .hs-trust-track {\n    animation-play-state: paused;\n  }\n  .hs-trust-item {\n    \n    font-weight: 700;\n    font-size: 1.1rem;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #0a0a0a;\n    flex-shrink: 0;\n    padding: 0 2.5rem;\n  }\n  .hs-trust-dot {\n    flex-shrink: 0;\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: rgba(10,10,10,0.35);\n    align-self: center;\n  }\n  @keyframes hs-scroll-trust {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-50%); }\n  }\n</style>\n\n<div class=\"hs-trust-bar\">\n  <div class=\"hs-trust-track\">\n    <!-- First set -->\n    <span class=\"hs-trust-item\">Free Shipping Across India</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Cash on Delivery Available</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">7-Day Easy Returns</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">HexaFoam Cushioning</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">TerraSpike Outsole</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Vegan Leather Upper</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Stability Plate Embedded</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">₹1,599 Only</span><span class=\"hs-trust-dot\"></span>\n    <!-- Duplicate for seamless loop -->\n    <span class=\"hs-trust-item\">Free Shipping Across India</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Cash on Delivery Available</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">7-Day Easy Returns</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">HexaFoam Cushioning</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">TerraSpike Outsole</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Vegan Leather Upper</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">Stability Plate Embedded</span><span class=\"hs-trust-dot\"></span>\n    <span class=\"hs-trust-item\">₹1,599 Only</span><span class=\"hs-trust-dot\"></span>\n  </div>\n</div>",
