      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — HERO: STYLE F (CINEMATIC IMAGE OVERLAY)\n     Paste inside a Custom Liquid section in Shopify\n     Font dependency: Barlow Condensed + DM Sans (add once per page)\n     ============================================================ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .hsf-wrap {\n    position: relative;\n    width: 100%;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    overflow: hidden;\n    background: #0a0a0a;\n  }\n\n  /* ── BACKGROUND IMAGE ── */\n  .hsf-bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n  }\n  .hsf-bg img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center 30%;\n    display: block;\n  }\n\n  /* ── OVERLAY LAYERS ── */\n  /* dark vignette from bottom — keeps text readable */\n  .hsf-overlay-bottom {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    background: linear-gradient(\n      to top,\n      #0a0a0a 0%,\n      rgba(10,10,10,0.88) 30%,\n      rgba(10,10,10,0.45) 60%,\n      rgba(10,10,10,0.15) 80%,\n      transparent 100%\n    );\n  }\n  /* subtle top bar for eyebrow readability */\n  .hsf-overlay-top {\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 160px;\n    z-index: 1;\n    background: linear-gradient(\n      to bottom,\n      rgba(10,10,10,0.6) 0%,\n      transparent 100%\n    );\n  }\n\n  /* ── CONTENT ── */\n  .hsf-content {\n    position: relative;\n    z-index: 2;\n    padding: 0 2.5rem 3.5rem;\n    max-width: 1400px;\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  /* top eyebrow — sits at the very top via padding-top on wrap */\n  .hsf-eyebrow-wrap {\n    position: absolute;\n    top: 2rem;\n    left: 2.5rem;\n    right: 2.5rem;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n  }\n  .hsf-eyebrow {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #b8f000;\n  }\n  .hsf-eyebrow-price {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: rgba(245,243,239,0.5);\n  }\n  .hsf-eyebrow-price strong {\n    color: #f5f3ef;\n    font-size: 0.9rem;\n  }\n\n  /* main headline */\n  .hsf-headline {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: clamp(5rem, 14vw, 11rem);\n    line-height: 0.88;\n    text-transform: uppercase;\n    letter-spacing: -0.015em;\n    color: #f5f3ef;\n    margin: 0 0 1.75rem;\n  }\n  .hsf-headline .hsf-hl-dim {\n    opacity: 0.2;\n  }\n  .hsf-headline .hsf-hl-accent {\n    color: #b8f000;\n  }\n  .hsf-headline .hsf-hl-outline {\n    -webkit-text-stroke: 1.5px rgba(245,243,239,0.4);\n    color: transparent;\n  }\n\n  /* bottom meta row */\n  .hsf-meta {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 2rem;\n  }\n\n  /* left: description + stats */\n  .hsf-meta-left { display: flex; flex-direction: column; gap: 1.25rem; }\n\n  .hsf-desc {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.95rem;\n    color: rgba(245,243,239,0.6);\n    line-height: 1.65;\n    max-width: 400px;\n  }\n\n  .hsf-stats {\n    display: flex;\n    gap: 0;\n  }\n  .hsf-stat {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    padding-right: 1.75rem;\n    margin-right: 1.75rem;\n    border-right: 1px solid rgba(255,255,255,0.1);\n  }\n  .hsf-stat:last-child {\n    border-right: none;\n    padding-right: 0;\n    margin-right: 0;\n  }\n  .hsf-stat-num {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 1.8rem;\n    color: #f5f3ef;\n    line-height: 1;\n  }\n  .hsf-stat-num .hsf-stat-unit {\n    font-size: 1rem;\n    color: rgba(245,243,239,0.5);\n    font-weight: 700;\n  }\n  .hsf-stat-label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.68rem;\n    color: rgba(245,243,239,0.4);\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n  }\n\n  /* right: price block + CTAs */\n  .hsf-meta-right {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 1.25rem;\n  }\n\n  .hsf-price-block { text-align: right; }\n  .hsf-price-was {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.85rem;\n    color: rgba(245,243,239,0.3);\n    text-decoration: line-through;\n    display: block;\n    margin-bottom: 3px;\n  }\n  .hsf-price-now {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 3rem;\n    color: #f5f3ef;\n    line-height: 1;\n  }\n  .hsf-price-note {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.68rem;\n    color: rgba(245,243,239,0.35);\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    display: block;\n    margin-top: 3px;\n  }\n\n  .hsf-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: flex-end; }\n\n  .hsf-btn-primary {\n    background: #b8f000;\n    color: #0a0a0a;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 1rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.95rem 2.25rem;\n    text-decoration: none;\n    display: inline-block;\n    border: none;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: opacity 0.15s, transform 0.15s;\n  }\n  .hsf-btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }\n\n  .hsf-btn-secondary {\n    background: transparent;\n    color: #f5f3ef;\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 700;\n    font-size: 1rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.95rem 2.25rem;\n    border: 1px solid rgba(245,243,239,0.25);\n    text-decoration: none;\n    display: inline-block;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: border-color 0.2s, transform 0.15s;\n  }\n  .hsf-btn-secondary:hover { border-color: rgba(245,243,239,0.7); transform: translateY(-2px); }\n\n  /* trust strip */\n  .hsf-trust {\n    display: flex;\n    gap: 1.5rem;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n  .hsf-trust-item {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.7rem;\n    color: rgba(245,243,239,0.35);\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .hsf-trust-item::before {\n    content: '✓';\n    color: #b8f000;\n    font-size: 0.65rem;\n  }\n\n  /* scroll hint */\n  .hsf-scroll-hint {\n    position: absolute;\n    bottom: 3.5rem;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    opacity: 0.3;\n  }\n  .hsf-scroll-hint span {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 0.6rem;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #f5f3ef;\n  }\n  .hsf-scroll-line {\n    width: 1px;\n    height: 32px;\n    background: #f5f3ef;\n    animation: hsf-scroll-drop 1.8s ease-in-out infinite;\n  }\n  @keyframes hsf-scroll-drop {\n    0%   { transform: scaleY(0); transform-origin: top; }\n    50%  { transform: scaleY(1); transform-origin: top; }\n    51%  { transform: scaleY(1); transform-origin: bottom; }\n    100% { transform: scaleY(0); transform-origin: bottom; }\n  }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 900px) {\n    .hsf-meta { flex-direction: column; align-items: flex-start; gap: 1.5rem; }\n    .hsf-meta-right { align-items: flex-start; }\n    .hsf-price-block { text-align: left; }\n    .hsf-ctas { justify-content: flex-start; }\n    .hsf-trust { justify-content: flex-start; }\n    .hsf-scroll-hint { display: none; }\n  }\n\n  @media (max-width: 600px) {\n    .hsf-content { padding: 0 1.25rem 3rem; }\n    .hsf-eyebrow-wrap { left: 1.25rem; right: 1.25rem; }\n    .hsf-headline { font-size: clamp(4rem, 18vw, 6rem); }\n    .hsf-stats { gap: 0; flex-wrap: wrap; }\n    .hsf-stat { padding-right: 1.25rem; margin-right: 1.25rem; }\n    .hsf-btn-primary,\n    .hsf-btn-secondary { width: 100%; text-align: center; }\n    .hsf-ctas { flex-direction: column; width: 100%; }\n  }\n</style>\n\n<section class=\"hsf-wrap\" id=\"hs-hero\">\n\n  <!-- BACKGROUND IMAGE -->\n  <div class=\"hsf-bg\">\n    <img\n      src=\"https://in.hndrd.co/cdn/shop/files/banner_d849e795-9c71-454f-baf5-cee164c1ed29.jpg?v=1748239436&width=2400\"\n      alt=\"Hundred HyperDrive Cricket Shoe on pitch\"\n      loading=\"eager\"\n      fetchpriority=\"high\"\n    >\n  </div>\n\n  <!-- OVERLAY -->\n  <div class=\"hsf-overlay-top\"></div>\n  <div class=\"hsf-overlay-bottom\"></div>\n\n  <!-- EYEBROW (top of section) -->\n  <div class=\"hsf-eyebrow-wrap\">\n    <span class=\"hsf-eyebrow\">Hundred &nbsp;·&nbsp; Hyper Series &nbsp;·&nbsp; Cricket Shoes 2025</span>\n    <span class=\"hsf-eyebrow-price\">Starting at &nbsp;<strong>₹1,599</strong></span>\n  </div>\n\n  <!-- SCROLL HINT -->\n  <div class=\"hsf-scroll-hint\">\n    <span>Scroll</span>\n    <div class=\"hsf-scroll-line\"></div>\n  </div>\n\n  <!-- MAIN CONTENT -->\n  <div class=\"hsf-content\">\n\n    <h1 class=\"hsf-headline\">\n      Dominate<br>\n      <span class=\"hsf-hl-accent\">The</span>&nbsp;<span class=\"hsf-hl-outline\">Pitch</span>\n    </h1>\n\n    <div class=\"hsf-meta\">\n\n      <!-- LEFT -->\n      <div class=\"hsf-meta-left\">\n        <p class=\"hsf-desc\">Two cricket shoes built on the same elite tech — HexaFoam midsole, TerraSpike outsole, vegan leather upper. HyperDrive owns hard pitches. HyperTurf owns synthetic turf.</p>\n        <div class=\"hsf-stats\">\n          <div class=\"hsf-stat\">\n            <span class=\"hsf-stat-num\">₹1,599</span>\n            <span class=\"hsf-stat-label\">Starting price</span>\n          </div>\n          <div class=\"hsf-stat\">\n            <span class=\"hsf-stat-num\">10<span class=\"hsf-stat-unit\"> colors</span></span>\n            <span class=\"hsf-stat-label\">Across both models</span>\n          </div>\n          <div class=\"hsf-stat\">\n            <span class=\"hsf-stat-num\">2<span class=\"hsf-stat-unit\"> surfaces</span></span>\n            <span class=\"hsf-stat-label\">Hard pitch &amp; turf</span>\n          </div>\n          <div class=\"hsf-stat\">\n            <span class=\"hsf-stat-num\">4<span class=\"hsf-stat-unit\"> tech</span></span>\n            <span class=\"hsf-stat-label\">Core technologies</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- RIGHT -->\n      <div class=\"hsf-meta-right\">\n        <div class=\"hsf-price-block\">\n          <span class=\"hsf-price-was\">₹2,499</span>\n          <span class=\"hsf-price-now\">₹1,599</span>\n          <span class=\"hsf-price-note\">Incl. taxes &nbsp;·&nbsp; Free shipping</span>\n        </div>\n        <div class=\"hsf-ctas\">\n          <a href=\"/products/hyper-drive\" class=\"hsf-btn-primary\">Shop HyperDrive</a>\n          <a href=\"/products/hyper-turf\"  class=\"hsf-btn-secondary\">Shop HyperTurf →</a>\n        </div>\n        <div class=\"hsf-trust\">\n          <span class=\"hsf-trust-item\">Free Shipping</span>\n          <span class=\"hsf-trust-item\">COD Available</span>\n          <span class=\"hsf-trust-item\">7-Day Returns</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
