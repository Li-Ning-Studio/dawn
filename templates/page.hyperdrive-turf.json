    "custom_liquid_tPRJqE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — SECTION 3: PRODUCT SWITCHER (DRIVE + TURF)\n     Paste inside a Custom Liquid section in Shopify\n     NOTE: Replace /products/hyper-drive and /products/hyper-turf\n           with your actual Shopify product URLs if different.\n     ============================================================ -->\n\n<style>\n  .hs-prod {\n    padding: 5rem 2rem;\n    background: #0a0a0a;\n  }\n  .hs-prod-inner {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n  .hs-section-label {\n   \n    font-size: 1.38rem;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: #b8f000;\n    margin-bottom: 0.5rem;\n  }\n  .hs-section-title {\n   \n    font-weight: 900;\n    font-size: clamp(2.2rem, 5vw, 3.8rem);\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 2.5rem;\n  }\n\n  /* TABS */\n  .hs-tabs {\n    display: flex;\n    gap: 0;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n    margin-bottom: 3rem;\n  }\n  .hs-tab {\n    \n    font-weight: 600;\n    font-size: 1.5rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    padding: 0.8rem 2rem;\n    background: none;\n    border: none;\n    border-bottom: 3px solid transparent;\n    color: #888;\n    cursor: pointer;\n    margin-bottom: -1px;\n    transition: color 0.2s, border-color 0.2s;\n  }\n  .hs-tab[data-tab=\"drive\"].hs-active { color: #b8f000; border-bottom-color: #b8f000; }\n  .hs-tab[data-tab=\"turf\"].hs-active  { color: #00d4ff; border-bottom-color: #00d4ff; }\n\n  /* PANELS */\n  .hs-panel { display: none; }\n  .hs-panel.hs-active {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 4rem;\n    align-items: start;\n  }\n\n  /* IMAGE SIDE */\n  .hs-img-wrap { position: sticky; top: 5.5rem; }\n  .hs-img-main {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    background: #1a1a1a;\n    overflow: hidden;\n  }\n  .hs-img-main img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: opacity 0.2s;\n  }\n  .hs-swatches {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.6rem;\n    margin-top: 1.25rem;\n  }\n  .hs-swatch {\n    width: 52px;\n    height: 52px;\n    border: 2px solid transparent;\n    overflow: hidden;\n    cursor: pointer;\n    transition: border-color 0.2s;\n    flex-shrink: 0;\n  }\n  .hs-swatch img { width: 100%; height: 100%; object-fit: cover; display: block; }\n  .hs-swatch:hover,\n  .hs-swatch.hs-active { border-color: #f5f3ef; }\n\n  /* INFO SIDE */\n  .hs-info { padding-top: 0.25rem; }\n  .hs-prod-eyebrow {\n   \n    font-size: 1.28rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    margin-bottom: 0.5rem;\n  }\n  .hs-prod-eyebrow.drive { color: #b8f000; }\n  .hs-prod-eyebrow.turf  { color: #00d4ff; }\n  .hs-prod-name {\n    \n    font-weight: 900;\n    font-size:3.5rem;\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 1rem;\n  }\n  .hs-prod-tagline {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.2rem;\n    color: #888;\n    line-height: 1.65;\n    margin-bottom: 1.75rem;\n    max-width: 400px;\n  }\n  .hs-pills {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.45rem;\n    margin-bottom: 2rem;\n  }\n  .hs-pill {\n    \n    font-size: 1.2rem;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.3rem 0.85rem;\n    border: 1px solid rgba(255,255,255,0.12);\n    color: #888;\n  }\n  .hs-pill.drive { border-color: rgba(184,240,0,0.3); color: #b8f000; }\n  .hs-pill.turf  { border-color: rgba(0,212,255,0.3);  color: #00d4ff; }\n  .hs-price-row {\n    display: flex;\n    align-items: baseline;\n    gap: 1rem;\n    margin-bottom: 2rem;\n    flex-wrap: wrap;\n  }\n  .hs-price-big {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 3.6rem;\n    color: #f5f3ef;\n  }\n  .hs-price-meta {\n    display: flex;\n    flex-direction: column;\n    gap: 0.1rem;\n  }\n  .hs-price-was {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.6rem;\n    color: red;\n    text-decoration: line-through;\n  }\n  .hs-price-note {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1rem;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n  .hs-buy-btn {\n    display: block;\n    width: 100%;\n    padding: 1.1rem 1rem;\n    \n    font-weight: 900;\n    font-size: 1.5rem;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    text-align: center;\n    text-decoration: none;\n    border: none;\n    cursor: pointer;\n    transition: transform 0.15s, opacity 0.15s;\n    margin-bottom: 0.9rem;\n  }\n  .hs-buy-btn:hover { transform: translateY(-2px); opacity: 0.88; }\n  .hs-buy-btn.drive { background: #b8f000; color: #0a0a0a; }\n  .hs-buy-btn.turf  { background: #00d4ff; color: #0a0a0a; }\n  .hs-trust-note {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.96rem;\n    color: #888;\n    text-align: center;\n    line-height: 1.6;\n  }\n\n  @media (max-width: 900px) {\n    .hs-panel.hs-active { grid-template-columns: 1fr; gap: 2rem; }\n    .hs-img-wrap { position: static; }\n  }\n  @media (max-width: 540px) {\n    .hs-prod { padding: 3.5rem 1.25rem; }\n    .hs-tab { padding: 0.8rem 1.2rem; font-size: 1.4rem; }\n  }\n</style>\n\n<section class=\"hs-prod\" id=\"hs-products\">\n  <div class=\"hs-prod-inner\">\n    <p class=\"hs-section-label\">Hyper Series</p>\n    <h2 class=\"hs-section-title\">Pick Your Weapon</h2>\n\n    <!-- TABS -->\n    <div class=\"hs-tabs\">\n      <button class=\"hs-tab hs-active\" data-tab=\"drive\" onclick=\"hsProdTab('drive')\">HyperDrive</button>\n      <button class=\"hs-tab\" data-tab=\"turf\" onclick=\"hsProdTab('turf')\">HyperTurf</button>\n    </div>\n\n    <!-- DRIVE PANEL -->\n    <div class=\"hs-panel hs-active\" id=\"hs-panel-drive\">\n      <div class=\"hs-img-wrap\">\n        <div class=\"hs-img-main\">\n          <img id=\"hs-drive-img\" src=\"https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=900\" alt=\"HyperDrive — White Lime Blue\">\n        </div>\n        <div class=\"hs-swatches\">\n          <div class=\"hs-swatch hs-active\" onclick=\"hsSetImg('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=900\" alt=\"White Lime Blue\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_0da120431e.png?v=1749011419&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_0da120431e.png?v=1749011419&width=900\" alt=\"White Lime Orange\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_0604d18dc1.png?v=1749011420&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_0604d18dc1.png?v=1749011420&width=900\" alt=\"White Navy Orange\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('drive', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_2b131ad68c.png?v=1749011421&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_2b131ad68c.png?v=1749011421&width=900\" alt=\"White Red Black\">\n          </div>\n        </div>\n      </div>\n      <div class=\"hs-info\">\n        <p class=\"hs-prod-eyebrow drive\">Hundred &nbsp;·&nbsp; Cricket Shoes</p>\n        <h3 class=\"hs-prod-name\">Hyper<br>Drive</h3>\n        <p class=\"hs-prod-tagline\">Engineered for the modern cricketer on hard pitches. Top-notch performance with every step — batting, bowling, fielding.</p>\n        <div class=\"hs-pills\">\n          <span class=\"hs-pill drive\">HexaFoam Midsole</span>\n          <span class=\"hs-pill drive\">TerraSpike Outsole</span>\n          <span class=\"hs-pill drive\">Vegan Leather</span>\n          <span class=\"hs-pill drive\">Stability Plate</span>\n          <span class=\"hs-pill\">4 Colors</span>\n          <span class=\"hs-pill\">All UK Sizes</span>\n        </div>\n        <div class=\"hs-price-row\">\n          <span class=\"hs-price-big\">₹1,599</span>\n          <div class=\"hs-price-meta\">\n            <span class=\"hs-price-was\">₹2,499</span>\n            <span class=\"hs-price-note\">Incl. taxes &nbsp;·&nbsp; Free delivery</span>\n          </div>\n        </div>\n        <a href=\"/products/hyper-drive\" class=\"hs-buy-btn drive\">Buy HyperDrive — ₹1,599 →</a>\n        <p class=\"hs-trust-note\">✓ Free Shipping &nbsp;&nbsp; ✓ COD Available &nbsp;&nbsp; ✓ 7-Day Returns</p>\n      </div>\n    </div>\n\n    <!-- TURF PANEL -->\n    <div class=\"hs-panel\" id=\"hs-panel-turf\">\n      <div class=\"hs-img-wrap\">\n        <div class=\"hs-img-main\">\n          <img id=\"hs-turf-img\" src=\"https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=900\" alt=\"HyperTurf — White Light Green\">\n        </div>\n        <div class=\"hs-swatches\">\n          <div class=\"hs-swatch hs-active\" onclick=\"hsSetImg('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=900\" alt=\"White Light Green\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_24a1490adf.png?v=1749011396&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_24a1490adf.png?v=1749011396&width=900\" alt=\"White Navy\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_2470225e41.png?v=1749011397&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_2470225e41.png?v=1749011397&width=900\" alt=\"White Lime Black\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_18da85db09.png?v=1749011397&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_18da85db09.png?v=1749011397&width=900\" alt=\"White Black Red\">\n          </div>\n          <div class=\"hs-swatch\" onclick=\"hsSetImg('turf', this, 'https://in.hndrd.co/cdn/shop/files/Template_01_fe298d101d.png?v=1749011398&width=900')\">\n            <img src=\"https://in.hndrd.co/cdn/shop/files/Template_01_fe298d101d.png?v=1749011398&width=900\" alt=\"White Blue Orange\">\n          </div>\n        </div>\n      </div>\n      <div class=\"hs-info\">\n        <p class=\"hs-prod-eyebrow turf\">Hundred &nbsp;·&nbsp; Cricket Shoes</p>\n        <h3 class=\"hs-prod-name\">Hyper<br>Turf</h3>\n        <p class=\"hs-prod-tagline\">Built for synthetic turf and multi-surface pitches. Robust construction meets eco-conscious performance. 6 shades to match your squad colours.</p>\n        <div class=\"hs-pills\">\n          <span class=\"hs-pill turf\">HexaFoam Midsole</span>\n          <span class=\"hs-pill turf\">TerraSpike Outsole</span>\n          <span class=\"hs-pill turf\">Vegan Leather</span>\n          <span class=\"hs-pill turf\">Stability Plate</span>\n          <span class=\"hs-pill turf\">Robust Construction</span>\n          <span class=\"hs-pill\">6 Colors</span>\n          <span class=\"hs-pill\">All UK Sizes</span>\n        </div>\n        <div class=\"hs-price-row\">\n          <span class=\"hs-price-big\">₹1,599</span>\n          <div class=\"hs-price-meta\">\n            <span class=\"hs-price-was\">₹2,499</span>\n            <span class=\"hs-price-note\">Incl. taxes &nbsp;·&nbsp; Free delivery</span>\n          </div>\n        </div>\n        <a href=\"/products/hyper-turf\" class=\"hs-buy-btn turf\">Buy HyperTurf — ₹1,599 →</a>\n        <p class=\"hs-trust-note\">✓ Free Shipping &nbsp;&nbsp; ✓ COD Available &nbsp;&nbsp; ✓ 7-Day Returns</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  function hsProdTab(type) {\n    document.querySelectorAll('.hs-tab').forEach(function(t) {\n      t.classList.remove('hs-active');\n    });\n    document.querySelectorAll('.hs-panel').forEach(function(p) {\n      p.classList.remove('hs-active');\n    });\n    document.querySelector('.hs-tab[data-tab=\"' + type + '\"]').classList.add('hs-active');\n    document.getElementById('hs-panel-' + type).classList.add('hs-active');\n  }\n\n  function hsSetImg(type, el, src) {\n    document.getElementById('hs-' + type + '-img').src = src;\n    var panel = document.getElementById('hs-panel-' + type);\n    panel.querySelectorAll('.hs-swatch').forEach(function(s) {\n      s.classList.remove('hs-active');\n    });\n    el.classList.add('hs-active');\n  }\n</script>",
