    "custom_liquid_nfnrh8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — COMPARISON: STYLE A (SPLIT COLUMNS)\n     Paste inside a Custom Liquid section in Shopify\n     Font dependency: Barlow Condensed + DM Sans (add once per page)\n     ============================================================ -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=DM+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .hsa-wrap {\n    padding: 5rem 2rem;\n    background: #0a0a0a;\n  }\n\n  .hsa-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .hsa-eyebrow {\n   \n    font-size: 1.28rem;\n    font-weight: 700;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: #b8f000;\n    margin-bottom: 0.5rem;\n  }\n\n  .hsa-title {\n   \n    font-weight: 900;\n    font-size: clamp(4.2rem, 5vw, 3.8rem);\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 0.75rem;\n  }\n\n  .hsa-subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.22rem;\n    color: #888;\n    margin-bottom: 3rem;\n    max-width: 480px;\n    line-height: 1.6;\n  }\n\n  /* ── SPLIT GRID ── */\n  .hsa-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 1px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.06);\n  }\n\n  /* ── COLUMN ── */\n  .hsa-col {\n    background: #111;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* coloured top accent bar */\n  .hsa-col-bar {\n    height: 4px;\n    width: 100%;\n  }\n  .hsa-col.drive .hsa-col-bar { background: #b8f000; }\n  .hsa-col.turf  .hsa-col-bar { background: #00d4ff; }\n\n  /* column header */\n  .hsa-col-head {\n    padding: 1.75rem 2rem 1.5rem;\n    border-bottom: 1px solid rgba(255,255,255,0.06);\n  }\n\n  .hsa-col-name {\n    \n    font-weight: 900;\n    font-size: 2.5rem;\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin-bottom: 0.3rem;\n  }\n\n  .hsa-col-tagline {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.18rem;\n    color: #666;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    margin-bottom: 1.25rem;\n  }\n\n  .hsa-col-img {\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n    display: block;\n    background: #1a1a1a;\n  }\n\n  /* surface badge */\n  .hsa-surface-badge {\n    display: inline-block;\n   \n    font-weight: 800;\n    font-size: 1.28rem;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    padding: 0.3rem 0.8rem;\n  }\n  .hsa-col.drive .hsa-surface-badge { background: rgba(184,240,0,0.1); color: #b8f000; }\n  .hsa-col.turf  .hsa-surface-badge { background: rgba(0,212,255,0.1);  color: #00d4ff; }\n\n  /* ── FEATURE ROWS ── */\n  .hsa-rows {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 0 2rem;\n  }\n\n  .hsa-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0.85rem 0;\n    border-bottom: 1px solid rgba(255,255,255,0.04);\n    gap: 1rem;\n  }\n  .hsa-row:last-child { border-bottom: none; }\n\n  .hsa-row-label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.32rem;\n    color: #888;\n    flex-shrink: 0;\n  }\n\n  .hsa-row-val {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.32rem;\n    font-weight: 500;\n    color: #f5f3ef;\n    text-align: right;\n  }\n\n  /* tick */\n  .hsa-tick {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    font-size: 1.35rem;\n    font-weight: 700;\n  }\n  .hsa-col.drive .hsa-tick.yes { background: rgba(184,240,0,0.12); color: #b8f000; }\n  .hsa-col.turf  .hsa-tick.yes { background: rgba(0,212,255,0.12);  color: #00d4ff; }\n  .hsa-tick.no { background: rgba(255,255,255,0.04); color: #444; }\n\n  /* color swatches row */\n  .hsa-swatches {\n    display: flex;\n    gap: 5px;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n  .hsa-swatch {\n    width: 16px;\n    height: 16px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.15);\n    flex-shrink: 0;\n  }\n\n  /* ── COLUMN FOOTER ── */\n  .hsa-col-foot {\n    padding: 1.5rem 2rem;\n    border-top: 1px solid rgba(255,255,255,0.06);\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .hsa-price-group { display: flex; flex-direction: column; gap: 2px; }\n\n  .hsa-price-was {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.36rem;\n    color: red;\n    text-decoration: line-through;\n  }\n\n  .hsa-price-now {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-weight: 900;\n    font-size: 3.2rem;\n    color: #f5f3ef;\n    line-height: 1;\n  }\n\n  .hsa-price-note {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.08rem;\n    color: #666;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n\n  .hsa-buy-btn {\n    display: inline-block;\n  \n    font-weight: 900;\n    font-size: 1.55rem;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 0.8rem 1.75rem;\n    text-decoration: none;\n    border: none;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: transform 0.15s, opacity 0.15s;\n  }\n  .hsa-buy-btn:hover { transform: translateY(-2px); opacity: 0.88; }\n  .hsa-col.drive .hsa-buy-btn { background: #b8f000; color: #0a0a0a; }\n  .hsa-col.turf  .hsa-buy-btn { background: #00d4ff; color: #0a0a0a; }\n\n  /* ── SHARED STRIP ── */\n  .hsa-shared-wrap {\n    margin-top: 1px;\n    background: #0e0e0e;\n    border: 1px solid rgba(255,255,255,0.06);\n    border-top: none;\n    padding: 1.25rem 2rem;\n    display: flex;\n    align-items: center;\n    gap: 1.5rem;\n    flex-wrap: wrap;\n  }\n\n  .hsa-shared-label {\n    font-family: 'Barlow Condensed', sans-serif;\n    font-size: 1.37rem;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #444;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  .hsa-shared-items {\n    display: flex;\n    gap: 0.6rem;\n    flex-wrap: wrap;\n    flex: 1;\n  }\n\n  .hsa-shared-pill {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.22rem;\n    color: #888;\n    border: 1px solid rgba(255,255,255,0.08);\n    padding: 0.25rem 0.7rem;\n    white-space: nowrap;\n  }\n\n  /* ── TRUST LINE ── */\n  .hsa-trust {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.94rem;\n    color: #555;\n    text-align: center;\n    margin-top: 1.5rem;\n    letter-spacing: 0.02em;\n  }\n\n  /* ── RESPONSIVE ── */\n  @media (max-width: 720px) {\n    .hsa-grid { grid-template-columns: 1fr; }\n    .hsa-col-img { aspect-ratio: 16 / 9; }\n  }\n\n  @media (max-width: 480px) {\n    .hsa-wrap { padding: 3rem 1.25rem; }\n    .hsa-col-head,\n    .hsa-rows,\n    .hsa-col-foot { padding-left: 1.25rem; padding-right: 1.25rem; }\n    .hsa-shared-wrap { padding: 1rem 1.25rem; }\n  }\n</style>\n\n<section class=\"hsa-wrap\" id=\"hs-compare\">\n  <div class=\"hsa-inner\">\n\n    <p class=\"hsa-eyebrow\">Side by Side</p>\n    <h2 class=\"hsa-title\">Drive vs Turf</h2>\n    <p class=\"hsa-subtitle\">Same price. Same core tech. Different battlefield. Pick the one built for your surface.</p>\n\n    <div class=\"hsa-grid\">\n\n      <!-- ── HYPERDRIVE ── -->\n      <div class=\"hsa-col drive\">\n        <div class=\"hsa-col-bar\"></div>\n\n        <div class=\"hsa-col-head\">\n          <div class=\"hsa-col-name\">HyperDrive</div>\n          <div class=\"hsa-col-tagline\">Hard pitch specialist</div>\n          <span class=\"hsa-surface-badge\">Hard Pitch &amp; Natural Grass</span>\n        </div>\n\n        <img\n          class=\"hsa-col-img\"\n          src=\"https://in.hndrd.co/cdn/shop/files/Template_01_9589b3f138.png?v=1749011418&width=900\"\n          alt=\"HyperDrive Cricket Shoe\"\n          loading=\"lazy\"\n        >\n\n        <div class=\"hsa-rows\">\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Price</span>\n            <span class=\"hsa-row-val\">₹1,599</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">MRP</span>\n            <span class=\"hsa-row-val\" style=\"text-decoration:line-through;color:#555\">₹2,499</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Colors available</span>\n            <div class=\"hsa-swatches\">\n              <span class=\"hsa-swatch\" style=\"background:#e8f5c8\" title=\"White Lime Blue\"></span>\n              <span class=\"hsa-swatch\" style=\"background:#f4e0b0\" title=\"White Lime Orange\"></span>\n              <span class=\"hsa-swatch\" style=\"background:#b0c4d8\" title=\"White Navy Orange\"></span>\n              <span class=\"hsa-swatch\" style=\"background:#e8b0b0\" title=\"White Red Black\"></span>\n            </div>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Best for</span>\n            <span class=\"hsa-row-val\">Batsmen &amp; All-rounders</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">HexaFoam midsole</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">TerraSpike outsole</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Vegan leather upper</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Stability plate</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Robust construction</span>\n            <span class=\"hsa-tick no\">&#8212;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Free shipping</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">COD available</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">7-day returns</span>\n            <span class=\"hsa-tick yes\">&#10003;</span>\n          </div>\n        </div>\n\n        <div class=\"hsa-col-foot\">\n          <div class=\"hsa-price-group\">\n            <span class=\"hsa-price-was\">₹2,499</span>\n            <span class=\"hsa-price-now\">₹1,599</span>\n            <span class=\"hsa-price-note\">Incl. taxes &nbsp;·&nbsp; Free delivery</span>\n          </div>\n          <a href=\"/products/hyper-drive\" class=\"hsa-buy-btn\">Buy Now →</a>\n        </div>\n      </div>\n\n      <!-- ── HYPERTURF ── -->\n      <div class=\"hsa-col turf\">\n        <div class=\"hsa-col-bar\"></div>\n\n        <div class=\"hsa-col-head\">\n          <div class=\"hsa-col-name\">HyperTurf</div>\n          <div class=\"hsa-col-tagline\">Synthetic turf specialist</div>\n          <span class=\"hsa-surface-badge\">Synthetic Turf &amp; Multi-surface</span>\n        </div>\n\n        <img\n          class=\"hsa-col-img\"\n          src=\"https://in.hndrd.co/cdn/shop/files/Template_01_4039de0a05.png?v=1749011395&width=900\"\n          alt=\"HyperTurf Cricket Shoe\"\n          loading=\"lazy\"\n        >\n\n        <div class=\"hsa-rows\">\n          <div class=\"hsa-row\">\n            <span class=\"hsa-row-label\">Price</span>\n    