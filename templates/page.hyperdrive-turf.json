    "custom_liquid_bPzjmf": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — SECTION 6: SOCIAL PROOF STATS\n     Paste inside a Custom Liquid section in Shopify\n     ============================================================ -->\n\n<style>\n  .hs-proof {\n    padding: 5rem 2rem;\n    background: #111111;\n  }\n  .hs-proof-inner {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n  .hs-proof .hs-section-label {\n   \n    font-size: 1.28rem;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: #b8f000;\n    margin-bottom: 0.5rem;\n  }\n  .hs-proof .hs-section-title {\n   \n    font-weight: 900;\n    font-size: clamp(4.2rem, 5vw, 3.8rem);\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 3rem;\n  }\n  .hs-stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1px;\n    background: rgba(255,255,255,0.05);\n  }\n  .hs-stat-box {\n    background: #111111;\n    padding: 2.5rem 1.5rem;\n    text-align: center;\n    transition: background 0.2s;\n  }\n  .hs-stat-box:hover { background: #161616; }\n  .hs-stat-num {\n    \n    font-weight: 900;\n    font-size: clamp(3.8rem, 4vw, 3.5rem);\n    color: #b8f000;\n    line-height: 1;\n    display: block;\n  }\n  .hs-stat-label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.28rem;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    margin-top: 0.5rem;\n    display: block;\n    line-height: 1.4;\n  }\n\n  @media (max-width: 768px) {\n    .hs-stats-grid { grid-template-columns: repeat(2, 1fr); }\n  }\n  @media (max-width: 400px) {\n    .hs-proof { padding: 3.5rem 1.25rem; }\n  }\n</style>\n\n<section class=\"hs-proof\">\n  <div class=\"hs-proof-inner\">\n    <p class=\"hs-section-label\">Why Hundred</p>\n    <h2 class=\"hs-section-title\">Trusted On<br>Every Pitch</h2>\n\n    <div class=\"hs-stats-grid\">\n      <div class=\"hs-stat-box\">\n        <span class=\"hs-stat-num\">50K+</span>\n        <span class=\"hs-stat-label\">Cricketers Trust Hundred</span>\n      </div>\n      <div class=\"hs-stat-box\">\n        <span class=\"hs-stat-num\">4.6★</span>\n        <span class=\"hs-stat-label\">Average Customer Rating</span>\n      </div>\n      <div class=\"hs-stat-box\">\n        <span class=\"hs-stat-num\">₹1,599</span>\n        <span class=\"hs-stat-label\">Unbeatable Value Point</span>\n      </div>\n      <div class=\"hs-stat-box\">\n        <span class=\"hs-stat-num\">2–4d</span>\n        <span class=\"hs-stat-label\">Delivery Pan-India</span>\n      </div>\n    </div>\n  </div>\n</section>",
