    "custom_liquid_LXXMqC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     HYPER SERIES — SECTION 4: TECHNOLOGY FEATURES GRID\n     Paste inside a Custom Liquid section in Shopify\n     ============================================================ -->\n\n<style>\n  .hs-feat {\n    padding: 5rem 2rem;\n    background: #0f0f0f;\n  }\n  .hs-feat-inner {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n  .hs-feat .hs-section-label {\n    \n    font-size: 1.4rem;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: #b8f000;\n    margin-bottom: 0.5rem;\n  }\n  .hs-feat .hs-section-title {\n    font-family: 'Figtree';\n    font-weight: 900;\n    font-size: clamp(4.2rem, 5vw, 3.8rem);\n    text-transform: uppercase;\n    line-height: 1;\n    color: #f5f3ef;\n    margin: 0 0 3rem;\n  }\n  .hs-feat-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 1px;\n    background: rgba(255,255,255,0.05);\n  }\n  .hs-feat-card {\n    background: #0f0f0f;\n    padding: 2.5rem 2rem;\n    transition: background 0.2s;\n  }\n  .hs-feat-card:hover { background: #161616; }\n  .hs-feat-icon {\n    margin-bottom: 1.25rem;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n  .hs-feat-icon svg {\n    width: 38px;\n    height: 38px;\n  }\n  .hs-feat-name {\n   \n    font-weight: 600;\n    font-size: 1.8rem;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: #f5f3ef;\n    margin: 0 0 0.75rem;\n  }\n  .hs-feat-desc {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 1.68rem;\n    color: #888;\n    line-height: 1.65;\n    margin: 0 0 1rem;\n  }\n  .hs-feat-badge {\n    display: inline-block;\n    \n    font-size: 1.15rem;\n    font-weight: 700;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    padding: 0.25rem 0.6rem;\n    background: rgba(184,240,0,0.08);\n    color: #b8f000;\n    border: 1px solid rgba(184,240,0,0.2);\n  }\n\n  @media (max-width: 540px) {\n    .hs-feat { padding: 3.5rem 1.25rem; }\n    .hs-feat-grid { grid-template-columns: 1fr; }\n  }\n</style>\n\n<section class=\"hs-feat\" id=\"hs-features\">\n  <div class=\"hs-feat-inner\">\n    <p class=\"hs-section-label\">Shared Technology</p>\n    <h2 class=\"hs-section-title\">What's Inside<br>Every Pair</h2>\n\n    <div class=\"hs-feat-grid\">\n\n      <!-- HexaFoam -->\n      <div class=\"hs-feat-card\">\n        <div class=\"hs-feat-icon\">\n          <svg viewBox=\"0 0 38 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <polygon points=\"19,3 34,11 34,27 19,35 4,27 4,11\" fill=\"none\" stroke=\"#b8f000\" stroke-width=\"1.5\"/>\n            <polygon points=\"19,9 28,14 28,24 19,29 10,24 10,14\" fill=\"rgba(184,240,0,0.1)\" stroke=\"#b8f000\" stroke-width=\"1\"/>\n            <circle cx=\"19\" cy=\"19\" r=\"2.5\" fill=\"#b8f000\"/>\n          </svg>\n        </div>\n        <h3 class=\"hs-feat-name\">HexaFoam Midsole</h3>\n        <p class=\"hs-feat-desc\">Unique hexagonal structure distributes pressure evenly across the foot — superior shock absorption with a cushioned, responsive feel on every step.</p>\n        <span class=\"hs-feat-badge\">HyperDrive &amp; HyperTurf</span>\n      </div>\n\n      <!-- TerraSpike -->\n      <div class=\"hs-feat-card\">\n        <div class=\"hs-feat-icon\">\n          <svg viewBox=\"0 0 38 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <ellipse cx=\"19\" cy=\"30\" rx=\"13\" ry=\"4\" fill=\"rgba(184,240,0,0.08)\" stroke=\"#b8f000\" stroke-width=\"1.2\"/>\n            <line x1=\"19\" y1=\"30\" x2=\"19\" y2=\"10\" stroke=\"#b8f000\" stroke-width=\"1.5\"/>\n            <polygon points=\"19,6 22,12 16,12\" fill=\"#b8f000\"/>\n            <line x1=\"10\" y1=\"22\" x2=\"19\" y2=\"30\" stroke=\"#b8f000\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>\n            <line x1=\"28\" y1=\"22\" x2=\"19\" y2=\"30\" stroke=\"#b8f000\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>\n          </svg>\n        </div>\n        <h3 class=\"hs-feat-name\">TerraSpike Outsole</h3>\n        <p class=\"hs-feat-desc\">Strategically placed spikes deliver exceptional grip and stability — on natural grass, hard clay, and synthetic turf. Agile, confident movement guaranteed.</p>\n        <span class=\"hs-feat-badge\">HyperDrive &amp; HyperTurf</span>\n      </div>\n\n      <!-- Vegan Leather -->\n      <div class=\"hs-feat-card\">\n        <div class=\"hs-feat-icon\">\n          <svg viewBox=\"0 0 38 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"6\" y=\"12\" width=\"26\" height=\"14\" rx=\"3\" fill=\"rgba(184,240,0,0.07)\" stroke=\"#b8f000\" stroke-width=\"1.5\"/>\n            <path d=\"M6 19 Q19 15 32 19\" stroke=\"#b8f000\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n            <circle cx=\"19\" cy=\"19\" r=\"3\" fill=\"rgba(184,240,0,0.25)\" stroke=\"#b8f000\" stroke-width=\"1\"/>\n          </svg>\n        </div>\n        <h3 class=\"hs-feat-name\">Vegan Leather Upper</h3>\n        <p class=\"hs-feat-desc\">PU engineered leather — durable, flexible, and eco-conscious. Withstands intense play while supporting sustainability. No compromise on quality or the planet.</p>\n        <span class=\"hs-feat-badge\">HyperDrive &amp; HyperTurf</span>\n      </div>\n\n      <!-- Stability Plate -->\n      <div class=\"hs-feat-card\">\n        <div class=\"hs-feat-icon\">\n          <svg viewBox=\"0 0 38 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"7\" y=\"22\" width=\"24\" height=\"5\" rx=\"1.5\" fill=\"rgba(184,240,0,0.18)\" stroke=\"#b8f000\" stroke-width=\"1.5\"/>\n            <path d=\"M11 22 L11 17 Q19 13 27 17 L27 22\" stroke=\"#b8f000\" stroke-width=\"1.3\" fill=\"rgba(184,240,0,0.06)\"/>\n            <line x1=\"13\" y1=\"22\" x2=\"13\" y2=\"17\" stroke=\"#b8f000\" stroke-width=\"0.8\" stroke-dasharray=\"2,1.5\"/>\n            <line x1=\"19\" y1=\"22\" x2=\"19\" y2=\"14\" stroke=\"#b8f000\" stroke-width=\"0.8\" stroke-dasharray=\"2,1.5\"/>\n            <line x1=\"25\" y1=\"22\" x2=\"25\" y2=\"17\" stroke=\"#b8f000\" stroke-width=\"0.8\" stroke-dasharray=\"2,1.5\"/>\n          </svg>\n        </div>\n        <h3 class=\"hs-feat-name\">Stability Plate</h3>\n        <p class=\"hs-feat-desc\">Embedded midsole plate locks the foot in place — preventing excessive movement, reducing injury risk, and giving you explosive power for batting and fast bowling.</p>\n        <span class=\"hs-feat-badge\">HyperDrive &amp; HyperTurf</span>\n      </div>\n\n    </div>\n  </div>\n</section>",
