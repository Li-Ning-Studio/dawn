      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER\n  SHOP BY SPORT\n\n  DESKTOP:\n  Badminton | Cricket | Pickleball\n\n  MOBILE:\n  Badminton full width, natural image height\n  Cricket + Pickleball underneath\n{% endcomment %}\n\n\n{% assign badminton_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Badminton_ccf55140-dc6d-4873-8edb-c5b6e855a5ec.jpg?v=1790332305' %}\n{% assign cricket_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Cricket_cdcf288b-b869-4064-a700-347a1454d5b7.jpg?v=1790332304' %}\n{% assign pickleball_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Pickelball.jpg?v=1790332305' %}\n\n{% assign badminton_link = '/collections/badminton' %}\n{% assign cricket_link = '/collections/cricket' %}\n{% assign pickleball_link = '/collections/pickleball' %}\n\n\n<section\n  id=\"sport-premium-{{ section.id }}\"\n  class=\"sport-premium\"\n>\n\n  <div\n    class=\"sport-premium__ambient\"\n    aria-hidden=\"true\"\n  >\n    <span\n      class=\"\n        sport-premium__glow\n        sport-premium__glow--one\n      \"\n    ></span>\n\n    <span\n      class=\"\n        sport-premium__glow\n        sport-premium__glow--two\n      \"\n    ></span>\n  </div>\n\n\n  <div class=\"sport-premium__container\">\n\n\n    <!-- =========================\n         HEADER\n    ========================== -->\n\n    <div\n      class=\"\n        sport-premium__header\n        sport-reveal\n      \"\n    >\n\n      <div class=\"sport-premium__eyebrow\">\n\n        <span\n          class=\"sport-premium__eyebrow-line\"\n        ></span>\n\n        <span>\n          SHOP BY SPORT\n        </span>\n\n      </div>\n\n\n      <h2>\n        Your sport.\n        <span>Your sale.</span>\n      </h2>\n\n\n      <p>\n        From shuttle to stumps to paddles, the deals are live.\n      </p>\n\n    </div>\n\n\n\n    <!-- =========================\n         CARDS\n    ========================== -->\n\n    <div class=\"sport-premium__grid\">\n\n\n      <!-- =========================\n           BADMINTON\n      ========================== -->\n\n      <a\n        href=\"https://in.hndrd.co/pages/now-or-never-sale-badminton\"\n        class=\"\n          sport-card\n          sport-card--badminton\n          sport-reveal\n        \"\n        aria-label=\"Shop Badminton\"\n      >\n\n        <div class=\"sport-card__media\">\n\n\n          {% if badminton_image != blank %}\n\n            <img\n              src=\"{{ badminton_image }}\"\n              alt=\"Badminton\"\n              width=\"1400\"\n              height=\"1000\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"sport-card__placeholder\">\n              <span>\n                BADMINTON\n              </span>\n            </div>\n\n          {% endif %}\n\n\n          <div class=\"sport-card__overlay\"></div>\n\n\n          <span class=\"sport-card__arrow\">\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n\n              <path\n                d=\"\n                  M5 12H19\n                  M14 7L19 12L14 17\n                \"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =========================\n           CRICKET\n      ========================== -->\n\n      <a\n        href=\"https://in.hndrd.co/pages/now-or-never-sale-cricket\"\n        class=\"\n          sport-card\n          sport-card--cricket\n          sport-reveal\n        \" \n        aria-label=\"Shop Cricket\"\n      >\n\n        <div class=\"sport-card__media\">\n\n\n          {% if cricket_image != blank %}\n\n            <img\n              src=\"{{ cricket_image }}\"\n              alt=\"Cricket\"\n              width=\"1200\"\n              height=\"1200\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"sport-card__placeholder\">\n              <span>\n                CRICKET\n              </span>\n            </div>\n\n          {% endif %}\n\n\n          <div class=\"sport-card__overlay\"></div>\n\n\n          <span class=\"sport-card__arrow\">\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n\n              <path\n                d=\"\n                  M5 12H19\n                  M14 7L19 12L14 17\n                \"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =========================\n           PICKLEBALL\n      ========================== -->\n\n      <a\n        href=\"https://in.hndrd.co/pages/now-or-never-sale-pickleball\"\n        class=\"\n          sport-card\n          sport-card--pickleball\n          sport-reveal\n        \"\n        aria-label=\"Shop Pickleball\"\n      >\n\n        <div class=\"sport-card__media\">\n\n\n          {% if pickleball_image != blank %}\n\n            <img\n              src=\"{{ pickleball_image }}\"\n              alt=\"Pickleball\"\n              width=\"1200\"\n              height=\"1200\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"sport-card__placeholder\">\n              <span>\n                PICKLEBALL\n              </span>\n            </div>\n\n          {% endif %}\n\n\n          <div class=\"sport-card__overlay\"></div>\n\n\n          <span class=\"sport-card__arrow\">\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n\n              <path\n                d=\"\n                  M5 12H19\n                  M14 7L19 12L14 17\n                \"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n#sport-premium-{{ section.id }} {\n\n  --sport-yellow: #f2ef37;\n  --sport-dark: #17001f;\n  --sport-purple: #30003f;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  padding:\n    clamp(68px, 7vw, 108px)\n    0\n    clamp(72px, 7vw, 108px);\n\n  background:\n    radial-gradient(\n      circle at 50% -15%,\n      rgba(145, 27, 196, .22),\n      transparent 46%\n    ),\n    linear-gradient(\n      180deg,\n      #30003f 0%,\n      #18001f 100%\n    );\n\n  color: #fff;\n\n}\n\n\n\n/* =========================================================\n   AMBIENT BACKGROUND\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-premium__ambient {\n\n  position: absolute;\n\n  inset: 0;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n  z-index: -1;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__glow {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter: blur(130px);\n\n  opacity: .12;\n\n  will-change: transform;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__glow--one {\n\n  width: 520px;\n\n  height: 520px;\n\n  top: -290px;\n\n  left: -190px;\n\n  background: #bd2be5;\n\n  animation:\n    sportGlowOne\n    17s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__glow--two {\n\n  width: 520px;\n\n  height: 520px;\n\n  right: -210px;\n\n  bottom: -300px;\n\n  background: #6812c4;\n\n  animation:\n    sportGlowTwo\n    19s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n\n/* =========================================================\n   CONTAINER\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-premium__container {\n\n  width:\n    min(\n      1400px,\n      calc(100% - 56px)\n    );\n\n  margin: 0 auto;\n\n}\n\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-premium__header {\n\n  width: 100%;\n\n  max-width: 700px;\n\n  margin:\n    0 auto\n    clamp(38px, 4.5vw, 58px);\n\n  text-align: center;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__eyebrow {\n\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 10px;\n\n  margin-bottom: 15px;\n\n  font-size: 10px;\n\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .19em;\n\n  color:\n    rgba(255,255,255,.62);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__eyebrow-line {\n\n  display: block;\n\n  width: 24px;\n\n  height: 1px;\n\n  background:\n    var(--sport-yellow);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__header h2 {\n\n  margin: 0;\n\n  font-size:\n    clamp(\n      40px,\n      5vw,\n      68px\n    );\n\n  line-height: .98;\n\n  font-weight: 700;\n\n  letter-spacing: -.05em;\n\n  color: #fff;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__header h2 span {\n\n  color:\n    var(--sport-yellow);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-premium__header p {\n\n  max-width: 490px;\n\n  margin:\n    18px auto 0;\n\n  font-size:\n    clamp(\n      14px,\n      1.2vw,\n      16px\n    );\n\n  line-height: 1.55;\n\n  color:\n    rgba(255,255,255,.58);\n\n}\n\n\n\n/* =========================================================\n   DESKTOP GRID\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-premium__grid {\n\n  display: grid;\n\n  grid-template-columns:\n    repeat(\n      3,\n      minmax(0,1fr)\n    );\n\n  gap:\n    clamp(\n      14px,\n      1.6vw,\n      22px\n    );\n\n}\n\n\n\n/* =========================================================\n   CARD\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-card {\n\n  position: relative;\n\n  display: block;\n\n  min-width: 0;\n\n  text-decoration: none;\n\n  color: inherit;\n\n  outline: none;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card__media {\n\n  position: relative;\n\n  width: 100%;\n\n  aspect-ratio: 1 / 1;\n\n  overflow: hidden;\n\n  border-radius:\n    clamp(\n      22px,\n      2vw,\n      28px\n    );\n\n  background:\n    #3c0a4b;\n\n  border:\n    1px solid\n    rgba(255,255,255,.11);\n\n  box-shadow:\n    0 18px 45px\n    rgba(0,0,0,.21);\n\n  transform:\n    translateZ(0);\n\n  transition:\n\n    transform\n    .72s\n    cubic-bezier(.16,1,.3,1),\n\n    border-color\n    .5s ease,\n\n    box-shadow\n    .72s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n/* soft inner edge */\n\n#sport-premium-{{ section.id }}\n.sport-card__media::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 5;\n\n  pointer-events: none;\n\n  border-radius: inherit;\n\n  box-shadow:\n\n    inset 0 1px 0\n    rgba(255,255,255,.08),\n\n    inset 0 -1px 0\n    rgba(255,255,255,.025);\n\n}\n\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-card__media img {\n\n  position: absolute;\n\n  inset: 0;\n\n  display: block;\n\n  width: 100%;\n\n  height: 100%;\n\n  object-fit: cover;\n\n  transform:\n    scale(1.01);\n\n  transition:\n    transform\n    1s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =========================================================\n   PLACEHOLDER\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-card__placeholder {\n\n  position: absolute;\n\n  inset: 0;\n\n  display: grid;\n\n  place-items: center;\n\n  background:\n\n    radial-gradient(\n      circle at 50% 20%,\n      rgba(194,34,230,.26),\n      transparent 45%\n    ),\n\n    linear-gradient(\n      145deg,\n      #601078,\n      #280031\n    );\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card__placeholder span {\n\n  font-size: 9px;\n\n  font-weight: 600;\n\n  letter-spacing: .18em;\n\n  color:\n    rgba(255,255,255,.32);\n\n}\n\n\n\n/* =========================================================\n   OVERLAY\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-card__overlay {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 1;\n\n  pointer-events: none;\n\n  background:\n\n    linear-gradient(\n      180deg,\n      rgba(10,0,14,0) 40%,\n      rgba(10,0,14,.02) 58%,\n      rgba(10,0,14,.26) 100%\n    );\n\n}\n\n\n\n/* =========================================================\n   ARROW\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-card__arrow {\n\n  position: absolute;\n\n  z-index: 4;\n\n  right:\n    clamp(\n      17px,\n      1.8vw,\n      24px\n    );\n\n  bottom:\n    clamp(\n      17px,\n      1.8vw,\n      24px\n    );\n\n  display: grid;\n\n  place-items: center;\n\n  width:\n    clamp(\n      42px,\n      3.8vw,\n      52px\n    );\n\n  height:\n    clamp(\n      42px,\n      3.8vw,\n      52px\n    );\n\n  border-radius: 50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.22);\n\n  background:\n    rgba(12,0,18,.18);\n\n  color: #fff;\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  transition:\n\n    background\n    .4s ease,\n\n    border-color\n    .4s ease,\n\n    color\n    .4s ease,\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card__arrow svg {\n\n  width: 17px;\n\n  height: 17px;\n\n  transition:\n    transform\n    .5s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =========================================================\n   DESKTOP HOVER\n========================================================= */\n\n@media (hover:hover) {\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__media {\n\n    transform:\n      translateY(-6px);\n\n    border-color:\n      rgba(255,255,255,.2);\n\n    box-shadow:\n      0 28px 65px\n      rgba(0,0,0,.31);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__media img {\n\n    transform:\n      scale(1.055);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__arrow {\n\n    background:\n      var(--sport-yellow);\n\n    border-color:\n      var(--sport-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      scale(1.05);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card:hover\n  .sport-card__arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REVEAL\n========================================================= */\n\n#sport-premium-{{ section.id }}\n.sport-reveal {\n\n  opacity: 0;\n\n  transform:\n    translate3d(\n      0,\n      22px,\n      0\n    );\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-reveal.is-visible {\n\n  opacity: 1;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(1) {\n\n  transition-delay: .04s;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(2) {\n\n  transition-delay: .11s;\n\n}\n\n\n#sport-premium-{{ section.id }}\n.sport-card:nth-child(3) {\n\n  transition-delay: .18s;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 32px);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    gap: 12px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 749px) {\n\n\n  #sport-premium-{{ section.id }} {\n\n    padding:\n      56px 0\n      64px;\n\n  }\n\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n\n  /* -------------------------\n     HEADER\n  ------------------------- */\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header {\n\n    width:\n      calc(100% - 10px);\n\n    margin-bottom: 27px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header h2 {\n\n    font-size:\n      clamp(\n        36px,\n        10.5vw,\n        48px\n      );\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__header p {\n\n    max-width: 315px;\n\n    margin-top: 14px;\n\n    font-size: 13px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__eyebrow {\n\n    margin-bottom: 12px;\n\n    font-size: 8px;\n\n    letter-spacing: .17em;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__eyebrow-line {\n\n    width: 18px;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE GRID\n\n     ┌───────────────────────────┐\n     │         BADMINTON         │\n     └───────────────────────────┘\n\n     ┌─────────────┐ ┌─────────────┐\n     │   CRICKET   │ │ PICKLEBALL  │\n     └─────────────┘ └─────────────┘\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    display: grid;\n\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap: 10px;\n\n  }\n\n\n\n  /* =====================================================\n     BADMINTON\n     FULL WIDTH\n     HEIGHT COMES FROM ACTUAL IMAGE\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton {\n\n    grid-column:\n      1 / -1;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media {\n\n    aspect-ratio: auto;\n\n    height: auto;\n\n    min-height: 0;\n\n    border-radius: 22px;\n\n  }\n\n\n  /*\n    THIS IS THE IMPORTANT PART.\n\n    Desktop image = absolute / cover.\n    Mobile badminton image = normal document flow.\n    So the actual image ratio determines height.\n  */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media img {\n\n    position: relative;\n\n    inset: auto;\n\n    display: block;\n\n    width: 100%;\n\n    height: auto;\n\n    object-fit: contain;\n\n    transform: none;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__overlay {\n\n    position: absolute;\n\n    inset: 0;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__arrow {\n\n    right: 17px;\n\n    bottom: 17px;\n\n    width: 42px;\n\n    height: 42px;\n\n  }\n\n\n\n  /* =====================================================\n     CRICKET + PICKLEBALL\n  ===================================================== */\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__media,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__media {\n\n    aspect-ratio:\n      1 / 1.06;\n\n    border-radius: 19px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow {\n\n    right: 12px;\n\n    bottom: 12px;\n\n    width: 34px;\n\n    height: 34px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow svg,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow svg {\n\n    width: 14px;\n\n    height: 14px;\n\n  }\n\n\n\n  /* Disable desktop lift on touch */\n\n  #sport-premium-{{ section.id }}\n  .sport-card__media {\n\n    transform: none;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media (max-width: 360px) {\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__container {\n\n    width:\n      calc(100% - 20px);\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-premium__grid {\n\n    gap: 8px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--badminton\n  .sport-card__media {\n\n    border-radius: 20px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__media,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__media {\n\n    border-radius: 17px;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-card--cricket\n  .sport-card__arrow,\n\n  #sport-premium-{{ section.id }}\n  .sport-card--pickleball\n  .sport-card__arrow {\n\n    width: 30px;\n\n    height: 30px;\n\n    right: 10px;\n\n    bottom: 10px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   AMBIENT ANIMATION\n========================================================= */\n\n@keyframes sportGlowOne {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        65px,\n        30px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes sportGlowTwo {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -60px,\n        -30px,\n        0\n      );\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  #sport-premium-{{ section.id }} *,\n  #sport-premium-{{ section.id }} *::before,\n  #sport-premium-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #sport-premium-{{ section.id }}\n  .sport-reveal {\n\n    opacity: 1;\n\n    transform: none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'sport-premium-{{ section.id }}'\n    );\n\n  if (!section) return;\n\n\n  const items =\n    section.querySelectorAll(\n      '.sport-reveal'\n    );\n\n\n  const reduceMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (reduceMotion) {\n\n    items.forEach(function (item) {\n\n      item.classList.add(\n        'is-visible'\n      );\n\n    });\n\n    return;\n\n  }\n\n\n  if (!('IntersectionObserver' in window)) {\n\n    items.forEach(function (item) {\n\n      item.classList.add(\n        'is-visible'\n      );\n\n    });\n\n    return;\n\n  }\n\n\n  const observer =\n    new IntersectionObserver(\n\n      function (entries) {\n\n        entries.forEach(\n          function (entry) {\n\n            if (!entry.isIntersecting) {\n              return;\n            }\n\n\n            entry.target\n              .classList\n              .add(\n                'is-visible'\n              );\n\n\n            observer.unobserve(\n              entry.target\n            );\n\n          }\n        );\n\n      },\n\n      {\n        threshold: 0.12,\n\n        rootMargin:\n          '0px 0px -25px 0px'\n      }\n\n    );\n\n\n  items.forEach(function (item) {\n\n    observer.observe(item);\n\n  });\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
