      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — CLOSING CTA\n  CUSTOM LIQUID ONLY\n  NO SCHEMA\n{% endcomment %}\n\n{% assign full_collection_link = 'https://in.hndrd.co/collections/now-or-never-oct-sale-all-collection' %}\n\n<section\n  id=\"non-closing-{{ section.id }}\"\n  class=\"non-closing\"\n>\n\n  <!-- BACKGROUND DETAILS -->\n  <div\n    class=\"non-closing__ambient\"\n    aria-hidden=\"true\"\n  >\n    <span class=\"non-closing__glow non-closing__glow--one\"></span>\n    <span class=\"non-closing__glow non-closing__glow--two\"></span>\n\n    <span class=\"non-closing__ring non-closing__ring--one\"></span>\n    <span class=\"non-closing__ring non-closing__ring--two\"></span>\n  </div>\n\n\n  <div class=\"non-closing__container\">\n\n    <div class=\"non-closing__panel non-closing-reveal\">\n\n\n      <!-- SMALL LABEL -->\n\n      <div class=\"non-closing__eyebrow\">\n\n        <span></span>\n\n        NOW OR NEVER\n\n        <span></span>\n\n      </div>\n\n\n      <!-- MAIN COPY -->\n\n      <h2>\n        The full\n        <strong>haul.</strong>\n      </h2>\n\n\n      <p>\n       Check the entire product range, all in one place.\n      </p>\n\n\n      <!-- CTA -->\n\n      <a\n        href=\"{{ full_collection_link }}\"\n        class=\"non-closing__button\"\n      >\n\n        <span>\n          SHOP EVERYTHING\n        </span>\n\n\n        <span\n          class=\"non-closing__button-arrow\"\n          aria-hidden=\"true\"\n        >\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n          >\n            <path\n              d=\"M5 12H19M14 7L19 12L14 17\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n\n        </span>\n\n      </a>\n\n\n      <!-- BOTTOM LINE -->\n\n      <div class=\"non-closing__footer\">\n\n        <span class=\"non-closing__pulse\"></span>\n\n        <span>\n          LIVE FOR A LIMITED TIME\n        </span>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* ==========================================================\n   CLOSING SECTION\n========================================================== */\n\n#non-closing-{{ section.id }} {\n\n  --non-yellow: #f2ee38;\n  --non-deep: #16001e;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  padding:\n    42px 0\n    48px;\n\n  background:\n    linear-gradient(\n      180deg,\n      #16001e 0%,\n      #1b0025 48%,\n      #120019 100%\n    );\n\n  color: #fff;\n\n}\n\n\n\n/* ==========================================================\n   AMBIENT\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__ambient {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__glow {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter:\n    blur(130px);\n\n  opacity: .14;\n\n  will-change: transform;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__glow--one {\n\n  width: 470px;\n\n  height: 470px;\n\n  top: -260px;\n\n  left: -160px;\n\n  background:\n    #a520d5;\n\n  animation:\n    nonClosingGlowOne\n    16s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__glow--two {\n\n  width: 520px;\n\n  height: 520px;\n\n  right: -210px;\n\n  bottom: -300px;\n\n  background:\n    #6213b8;\n\n  animation:\n    nonClosingGlowTwo\n    19s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n\n/* decorative rings */\n\n#non-closing-{{ section.id }}\n.non-closing__ring {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.05);\n\n  opacity: .8;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__ring--one {\n\n  width: 360px;\n\n  height: 360px;\n\n  top: