    "custom_liquid_46qYWT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD — NOW OR NEVER · Sticky offers tab + semicircle offer fan\n  Paste into a \"Custom Liquid\" section (homepage only),\n  or into layout/theme.liquid just before </body> (every page).\n\n  EDIT OFFERS + LINKS in the OFFERS list inside the <script> below.\n  href can be:\n    - an anchor on the same page, e.g. \"#hn-rackets\"  (smooth-scrolls to that section)\n    - a page/collection URL,   e.g. \"/collections/rackets\"\n{% endcomment %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .hn-of {\n    --hn-ink: #0B1230;\n    --hn-black: #0D0D0D;       /* logo background */\n    --hn-logo: #FF9E2C;        /* logo orange */\n    --hn-logo-deep: #F2850F;\n    --hn-yellow: #F7E23E;      /* \"Your sale.\" yellow */\n    --hn-cream: #F5F2EA;\n    --hn-r: min(360px, 86vw, 46vh);\n    font-family: \"Barlow Condensed\", \"Arial Narrow\", \"Helvetica Neue\", Arial, sans-serif;\n  }\n  .hn-of *, .hn-of *::before, .hn-of *::after { box-sizing: border-box; }\n\n  /* ---------- Sticky tab (mobile: slim pill) ---------- */\n  .hn-of-tab {\n    position: fixed; left: 0; top: 50%;\n    transform: translateY(-50%);\n    z-index: 60;\n    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px;\n    margin: 0; padding: 14px 9px 12px;\n    background: linear-gradient(150deg, #FFB24D 0%, var(--hn-logo) 45%, var(--hn-logo-deep) 100%);\n    color: var(--hn-black);\n    border: 0; border-radius: 0 14px 14px 0;\n    box-shadow:\n      inset -2px 0 0 rgba(255, 255, 255, .25),\n      0 0 0 1px rgba(13, 13, 13, .9),\n      6px 8px 22px rgba(0, 0, 0, .35);\n    cursor: pointer;\n    font: 800 15px/1 \"Barlow Condensed\", \"Arial Narrow\", Arial, sans-serif;\n    letter-spacing: .08em;\n    -webkit-appearance: none; appearance: none;\n    transition: width .3s cubic-bezier(.2, .9, .3, 1.2), padding .3s ease, box-shadow .3s ease, opacity .2s ease;\n  }\n  .hn-of-tab:focus { outline: none; }\n  .hn-of-tab:focus-visible { outline: 3px solid var(--hn-yellow); outline-offset: 3px; }\n  .hn-of-tab span { writing-mode: vertical-rl; transform: rotate(180deg); }\n  .hn-of-dot {\n    flex: none; width: 7px; height: 7px; border-radius: 50%;\n    background: var(--hn-black);\n    box-shadow: 0 0 0 0 rgba(13, 13, 13, .45);\n    animation: hn-of-ping 2.4s ease-out infinite;\n  }\n  @keyframes hn-of-ping {\n    0%   { box-shadow: 0 0 0 0 rgba(13, 13, 13, .45); }\n    70%  { box-shadow: 0 0 0 8px rgba(13, 13, 13, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(13, 13, 13, 0); }\n  }\n  .hn-of.is-open .hn-of-tab { opacity: 0; pointer-events: none; }\n\n  /* ---------- Desktop: half-circle tab ---------- */\n  @media (min-width: 750px) {\n    .hn-of-tab {\n      width: 66px; height: 132px;\n      padding: 0 12px 0 0; gap: 8px;\n      border-radius: 0 999px 999px 0;\n      font-size: 16px;\n    }\n    /* thin inner ring that follows the curve */\n    .hn-of-tab::before {\n      content: \"\"; position: absolute; inset: 6px 6px 6px -40px;\n      border: 1.5px solid rgba(13, 13, 13, .22);\n      border-radius: 0 999px 999px 0;\n      pointer-events: none;\n    }\n    .hn-of-tab:hover {\n      width: 74px; padding-right: 8px;\n      box-shadow:\n        inset -2px 0 0 rgba(255, 255, 255, .3),\n        0 0 0 1px rgba(13, 13, 13, .9),\n        0 0 0 6px rgba(255, 158, 44, .22),\n        8px 10px 28px rgba(0, 0, 0, .4);\n    }\n  }\n\n  /* ---------- Backdrop ---------- */\n  .hn-of-backdrop {\n    position: fixed; inset: 0; z-index: 999;\n    background: rgba(8, 12, 30, .5);\n    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);\n    opacity: 0; visibility: hidden;\n    transition: opacity .3s ease, visibility .3s;\n  }\n  .hn-of.is-open .hn-of-backdrop { opacity: 1; visibility: visible; }\n\n  /* ---------- Semicircle panel ---------- */\n  .hn-of-panel {\n    position: fixed; left: 0; top: 50%; z-index: 1000;\n    width: var(--hn-r); height: calc(var(--hn-r) * 2);\n    transform: translateY(-50%);\n    visibility: hidden;\n    pointer-events: none;\n  }\n  .hn-of.is-open .hn-of-panel { visibility: visible; }\n  .hn-of-svg {\n    display: block; width: 100%; height: 100%;\n    overflow: visible; pointer-events: none;\n    filter: drop-shadow(10px 0 30px rgba(0, 0, 0, .35));\n  }\n\n  /* Each wedge: outer g = open animation, inner a = hover push */\n  .hn-of-w {\n    transform-box: view-box; transform-origin: 0 50%;\n    opacity: 0; transform: scale(.35) rotate(-24deg);\n    transition: transform .55s cubic-bezier(.2, .9, .25, 1.15), opacity .3s ease;\n  }\n  .hn-of.is-open .hn-of-w {\n    opacity: 1; transform: none;\n    transition-delay: calc(var(--i) * 55ms);\n  }\n  .hn-of-a {\n    pointer-events: auto; cursor: pointer; outline: none;\n    transition: transform .28s cubic-bezier(.2, .9, .3, 1.2);\n  }\n  .hn-of-a path {\n    fill: var(--c); stroke: var(--hn-ink); stroke-width: 3;\n    transition: fill .25s ease;\n  }\n  .hn-of-a text { fill: var(--hn-cream); transition: fill .25s ease, opacity .25s ease; pointer-events: none; }\n  .hn-of-a .hn-of-t { font-weight: 800; font-size: 36px; letter-spacing: .01em; }\n  .hn-of-a .hn-of-s { font-weight: 500; font-size: 16px; opacity: .82; }\n  .hn-of-a:hover, .hn-of-a:focus-visible { transform: translate(var(--dx), var(--dy)); }\n  .hn-of-a:hover path, .hn-of-a:focus-visible path { fill: var(--hn-yellow); }\n  .hn-of-a:hover text, .hn-of-a:focus-visible text { fill: var(--hn-ink); }\n  .hn-of-a:hover .hn-of-s, .hn-of-a:focus-visible .hn-of-s { opacity: 1; }\n  .hn-of-a:focus-visible path { stroke: var(--hn-logo); stroke-width: 4; }\n\n  /* Hub (centre half-circle) */\n  .hn-of-hub-shape { fill: var(--hn-black); }\n  .hn-of-hub-ring { fill: none; stroke: var(--hn-logo); stroke-width: 3; }\n  .hn-of-hub-text { fill: var(--hn-cream); font-weight: 800; font-size: 27px; }\n  .hn-of-hub-x { stroke: var(--hn-logo); stroke-width: 3; stroke-linecap: round; }\n  .hn-of-hubg {\n    transform-box: view-box; transform-origin: 0 50%;\n    transform: scale(0); transition: transform .4s cubic-bezier(.2, .9, .25, 1.2);\n  }\n  .hn-of.is-open .hn-of-hubg { transform: none; }\n\n  /* Invisible close button over the hub — reset theme button styles */\n  .hn-of .hn-of-close {\n    position: absolute; left: 0; top: 36.25%;\n    width: 27.5%; height: 27.5%; min-width: 0; min-height: 0;\n    margin: 0; padding: 0;\n    border: 0 !important; background: transparent !important;\n    box-shadow: none !important;\n    -webkit-appearance: none; appearance: none;\n    border-radius: 0 999px 999px 0;\n    cursor: pointer; pointer-events: auto;\n  }\n  .hn-of .hn-of-close::before, .hn-of .hn-of-close::after { display: none !important; }\n  .hn-of .hn-of-close:focus { outline: none; }\n  .hn-of .hn-of-close:focus-visible { outline: 3px solid var(--hn-yellow); outline-offset: -3px; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-of-dot { animation: none; }\n    .hn-of-w, .hn-of-hubg, .hn-of-a, .hn-of-backdrop, .hn-of-tab { transition: none !important; }\n  }\n</style>\n\n<div class=\"hn-of\" id=\"hnOffers\">\n  <button class=\"hn-of-tab\" type=\"button\" aria-expanded=\"false\" aria-controls=\"hnOffersPanel\">\n    <i class=\"hn-of-dot\" aria-hidden=\"true\"></i>\n    <span>VIEW <br>OFFERS</span>\n  </button>\n\n  <div class=\"hn-of-backdrop\" data-hn-close></div>\n\n  <div class=\"hn-of-panel\" id=\"hnOffersPanel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Now or Never offers\">\n    <svg class=\"hn-of-svg\" viewBox=\"0 0 400 800\"></svg>\n    <button class=\"hn-of-close\" type=\"button\" aria-label=\"Close offers\" data-hn-close></button>\n  </div>\n</div>\n\n<script>\n(function () {\n  /* ====== EDIT YOUR OFFERS HERE (top to bottom) ====== */\n  var OFFERS = [\n    { title: 'B1G1',       sub: ['Buy 1, get 1 free'],                  href: '#shopify-section-{{ section.id | split: \"__\" | first }}__hero_component_rMfbtJ' },\n    { title: 'Rackets',    sub: ['Free kit bag', 'or free string'],     href: '#shopify-section-{{ section.id | split: \"__\" | first }}__hero_component_NJcenP' },\n    { title: 'Shoes',      sub: ['Free SK bag,', 'drawstring or socks'],href: '#shopify-section-{{ section.id | split: \"__\" | first }}__custom_liquid_qdxydG' },\n    { title: 'Up to 70% OFF',  sub: ['on selected products'],               href: '#shopify-section-{{ section.id | split: \"__\" | first }}__hero_component_VK9DFC' },\n    { title: 'Name It', sub: ['T-shirt printing', 'at no cost'],     href: '#shopify-section-{{ section.id | split: \"__\" | first }}__hero_component_U9Jb93' }\n  ];\n  function headerOffset() {\n    var header = document.querySelector('.section-header');\n    if (!header) return 12;\n    var position = window.getComputedStyle(header).position;\n    return (position === 'sticky' || position === 'fixed' ? header.getBoundingClientRect().height : 0) + 12;\n  }\n  /* =================================================== */\n\n  var root = document.getElementById('hnOffers');\n  if (!root || root.dataset.ready) return;\n  root.dataset.ready = '1';\n\n  var svg = root.querySelector('.hn-of-svg');\n  var tab = root.querySelector('.hn-of-tab');\n  var NS = 'http://www.w3.org/2000/svg';\n  var CY = 400, R = 396, RI = 120, RL = 262, HUB = 110;\n  var SHADES = ['#18235E', '#1E2C78', '#253791', '#1E2C78', '#18235E'];\n\n  function pt(r, deg) {\n    var a = deg * Math.PI / 180;\n    return [(r * Math.cos(a)).toFixed(2), (CY + r * Math.sin(a)).toFixed(2)];\n  }\n  function el(tag, attrs) {\n    var n = document.createElementNS(NS, tag);\n    for (var k in attrs) n.setAttribute(k, attrs[k]);\n    return n;\n  }\n\n  var step = 180 / OFFERS.length;\n\n  OFFERS.forEach(function (o, i) {\n    var a0 = -90 + step * i, a1 = a0 + step, mid = (a0 + a1) / 2;\n    var p0 = pt(RI, a0), p1 = pt(R, a0), p2 = pt(R, a1), p3 = pt(RI, a1);\n    var d = 'M' + p0 + 'L' + p1 + 'A' + R + ' ' + R + ' 0 0 1 ' + p2 +\n            'L' + p3 + 'A' + RI + ' ' + RI + ' 0 0 0 ' + p0 + 'Z';\n\n    var g = el('g', { 'class': 'hn-of-w', style: '--i:' + i });\n    var rad = mid * Math.PI / 180;\n    var a = el('a', {\n      'class': 'hn-of-a', href: o.href,\n      'aria-label': o.title + ' — ' + o.sub.join(' '),\n      style: '--c:' + SHADES[i % SHADES.length] +\n             ';--dx:' + (Math.cos(rad) * 12).toFixed(1) + 'px' +\n             ';--dy:' + (Math.sin(rad) * 12).toFixed(1) + 'px'\n    });\n    a.appendChild(el('path', { d: d }));\n\n    var c = pt(RL, mid), cx = +c[0], cy = +c[1];\n    var top = cy - (o.sub.length * 19) / 2 + 4;\n    var t = el('text', { 'class': 'hn-of-t', x: cx, y: top, 'text-anchor': 'middle' });\n    t.textContent = o.title;\n    a.appendChild(t);\n    o.sub.forEach(function (line, j) {\n      var s = el('text', { 'class': 'hn-of-s', x: cx, y: top + 24 + j * 19, 'text-anchor': 'middle' });\n      s.textContent = line;\n      a.appendChild(s);\n    });\n\n    g.appendChild(a);\n    svg.appendChild(g);\n  });\n\n  /* Hub */\n  var hub = el('g', { 'class': 'hn-of-hubg' });\n  hub.appendChild(el('path', { 'class': 'hn-of-hub-shape',\n    d: 'M0 ' + (CY - HUB) + 'A' + HUB + ' ' + HUB + ' 0 0 1 0 ' + (CY + HUB) + 'Z' }));\n  var ri = HUB - 9;\n  hub.appendChild(el('path', { 'class': 'hn-of-hub-ring',\n    d: 'M0 ' + (CY - ri) + 'A' + ri + ' ' + ri + ' 0 0 1 0 ' + (CY + ri) }));\n  [['Now or', CY - 22], ['never', CY + 6]].forEach(function (l) {\n    var t = el('text', { 'class': 'hn-of-hub-text', x: 48, y: l[1], 'text-anchor': 'middle' });\n    t.textContent = l[0];\n    hub.appendChild(t);\n  });\n  hub.appendChild(el('path', { 'class': 'hn-of-hub-x', d: 'M40 ' + (CY + 30) + 'l16 16M56 ' + (CY + 30) + 'l-16 16' }));\n  svg.appendChild(hub);\n\n  /* Open / close */\n  function open() {\n    root.classList.add('is-open');\n    tab.setAttribute('aria-expanded', 'true');\n  }\n  function close(returnFocus) {\n    root.classList.remove('is-open');\n    tab.setAttribute('aria-expanded', 'false');\n    if (returnFocus) tab.focus({ preventScroll: true });\n  }\n\n  tab.addEventListener('click', open);\n  root.querySelectorAll('[data-hn-close]').forEach(function (b) {\n    b.addEventListener('click', function () { close(false); });\n  });\n  document.addEventListener('keydown', function (e) {\n    if (e.key === 'Escape' && root.classList.contains('is-open')) close(true);\n  });\n\n  var jumpToken = 0;\n  [\"wheel\", \"touchstart\", \"keydown\"].forEach(function (eventName) {\n    window.addEventListener(eventName, function () { jumpToken++; }, { passive: true });\n  });\n\n  /* Wedge click: smooth-scroll to anchors, otherwise navigate */\n  svg.addEventListener('click', function (e) {\n    var link = e.target.closest('.hn-of-a');\n    if (!link) return;\n    var href = link.getAttribute('href') || '';\n    if (href.charAt(0) !== '#') { close(false); return; }\n    e.preventDefault();\n    close(false);\n    var target = document.getElementById(href.slice(1));\n    if (!target) { location.hash = href; return; }\n    var y = target.getBoundingClientRect().top + window.pageYOffset - headerOffset();\n    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var token = ++jumpToken;\n    window.scrollTo({ top: y, behavior: reduce ? 'instant' : 'smooth' });\n    [750, 1100, 1600].forEach(function (delay) {\n      window.setTimeout(function () {\n        if (token !== jumpToken || !target.isConnected) return;\n        var delta = target.getBoundingClientRect().top - headerOffset();\n        if (Math.abs(delta) > 2) {\n          window.scrollTo({ top: Math.max(0, window.scrollY + delta), behavior: 'instant' });\n        }\n      }, delay);\n    });\n  });\n})();\n</script>",
