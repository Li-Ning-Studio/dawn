vents: none;\n\n  transform:\n    rotate(17deg);\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.045),\n      transparent\n    );\n\n  animation:\n    nonClosingSweep\n    8s\n    ease-in-out\n    infinite;\n\n}\n\n\n\n/* ==========================================================\n   EYEBROW\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__eyebrow {\n\n  position: relative;\n\n  z-index: 2;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 11px;\n\n  margin-bottom:\n    18px;\n\n  color:\n    rgba(255,255,255,.6);\n\n  font-size:\n    9px;\n\n  line-height: 1;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    .21em;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__eyebrow > span {\n\n  display: block;\n\n  width: 24px;\n\n  height: 1px;\n\n  background:\n    var(--non-yellow);\n\n  opacity: .8;\n\n}\n\n\n\n/* ==========================================================\n   HEADING\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__panel h2 {\n\n  position: relative;\n\n  z-index: 2;\n\n  margin: 0;\n\n  color: #fff;\n\n  font-size:\n    clamp(\n      50px,\n      7vw,\n      94px\n    );\n\n  line-height:\n    .91;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.06em;\n\n}\n\n\n#non-closing-{{ section.id }}\n.non-closing__panel h2 strong {\n\n  color:\n    var(--non-yellow);\n\n  font-weight:\n    inherit;\n\n}\n\n\n\n/* ==========================================================\n   DESCRIPTION\n========================================================== */\n\n#non-closing-{{ section.id }}\n.non-closing__panel p {\n\n  position: relative;\n\n  z-index: 2;\n\n  max-width:\n    520px;\n\n  margin:\n    22px auto\n    0;\n\n  color:\n    rgba(255,255,255,.64);\n\n  font-size:\n    clamp(\n      14px,\n      1.25vw,\n      17px\n    );\n\n  line-heigh