    "custom_liquid_7yh8rg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — SHOP BY PRICE\n\n  DESKTOP:\n  [ PRICE 1 ] [ PRICE 2 ] [ PRICE 3 ]\n\n  MOBILE:\n  [ PRICE 1 ] [ PRICE 2 ]\n       [ PRICE 3 ]\n\n  Add your 3 artwork URLs below.\n  Each card can scroll to a section on the same page.\n{% endcomment %}\n\n\n{% assign price1_link = '#price-1' %}\n{% assign price2_link = '#price-2' %}\n{% assign price3_link = '#price-3' %}\n\n\n{% assign price1_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_9e80cfb2-440a-46e7-8e33-07dafd68ad87.jpg?v=1790361013' %}\n{% assign price2_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_copy_4406913c-f76c-4502-80eb-ed11ef030079.jpg?v=1790361014' %}\n{% assign price3_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_copy_2.jpg?v=1790361014' %}\n\n\n\n<section\n  id=\"price-premium-{{ section.id }}\"\n  class=\"pr-section\"\n>\n\n  <!-- BACKGROUND -->\n  <div\n    class=\"pr-background\"\n    aria-hidden=\"true\"\n  >\n\n    <span\n      class=\"\n        pr-ambient\n        pr-ambient--one\n      \"\n    ></span>\n\n    <span\n      class=\"\n        pr-ambient\n        pr-ambient--two\n      \"\n    ></span>\n\n  </div>\n\n\n\n  <div class=\"pr-container\">\n\n\n    <!-- =====================================\n         HEADER\n    ====================================== -->\n\n    <div\n      class=\"\n        pr-header\n        pr-reveal\n      \"\n    >\n\n      <h2>\n        Shop by Price,\n        <span>Play Your Way.</span>\n      </h2>\n\n      <p>\n        Pick your range and find the gear that fits your game.\n      </p>\n\n    </div>\n\n\n\n    <!-- =====================================\n         PRICE CARDS\n    ====================================== -->\n\n    <div class=\"pr-grid\">\n\n\n      <!-- =================================\n           PRICE CARD 1\n      ================================== -->\n\n      <a\n        href=\"{{ price1_link }}\"\n        class=\"\n          pr-card\n          pr-card--one\n          pr-reveal\n        \"\n        data-price-link\n        aria-label=\"Shop price range 1\"\n      >\n\n        <span class=\"pr-sr\">\n          Price Range 1\n        </span>\n\n\n        <div class=\"pr-media\">\n\n          {% if price1_image != blank %}\n\n            <img\n              src=\"{{ price1_image }}\"\n              alt=\"\"\n              width=\"1200\"\n              height=\"1200\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"pr-placeholder\">\n\n              <span>\n                ADD PRICE<br>\n                IMAGE\n              </span>\n\n            </div>\n\n          {% endif %}\n\n\n          <div\n            class=\"pr-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"pr-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =================================\n           PRICE CARD 2\n      ================================== -->\n\n      <a\n        href=\"{{ price2_link }}\"\n        class=\"\n          pr-card\n          pr-card--two\n          pr-reveal\n        \"\n        data-price-link\n        aria-label=\"Shop price range 2\"\n      >\n\n        <span class=\"pr-sr\">\n          Price Range 2\n        </span>\n\n\n        <div class=\"pr-media\">\n\n          {% if price2_image != blank %}\n\n            <img\n              src=\"{{ price2_image }}\"\n              alt=\"\"\n              width=\"1200\"\n              height=\"1200\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"pr-placeholder\">\n\n              <span>\n                ADD PRICE<br>\n                IMAGE\n              </span>\n\n            </div>\n\n          {% endif %}\n\n\n          <div\n            class=\"pr-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"pr-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =================================\n           PRICE CARD 3\n      ================================== -->\n\n      <a\n        href=\"{{ price3_link }}\"\n        class=\"\n          pr-card\n          pr-card--three\n          pr-reveal\n        \"\n        data-price-link\n        aria-label=\"Shop price range 3\"\n      >\n\n        <span class=\"pr-sr\">\n          Price Range 3\n        </span>\n\n\n        <div class=\"pr-media\">\n\n          {% if price3_image != blank %}\n\n            <img\n              src=\"{{ price3_image }}\"\n              alt=\"\"\n              width=\"1200\"\n              height=\"1200\"\n              loading=\"lazy\"\n            >\n\n          {% else %}\n\n            <div class=\"pr-placeholder\">\n\n              <span>\n                ADD PRICE<br>\n                IMAGE\n              </span>\n\n            </div>\n\n          {% endif %}\n\n\n          <div\n            class=\"pr-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"pr-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n#price-premium-{{ section.id }} {\n\n  --pr-yellow: #f2ee38;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  padding:\n    clamp(68px, 7vw, 104px)\n    0\n    clamp(74px, 7vw, 108px);\n\n  background:\n    linear-gradient(\n      180deg,\n      #16001e 0%,\n      #1c0025 50%,\n      #16001e 100%\n    );\n\n  color: #fff;\n\n}\n\n\n\n/* =========================================================\n   BACKGROUND\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-background {\n\n  position: absolute;\n\n  inset: 0;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n  z-index: -1;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-ambient {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter:\n    blur(150px);\n\n  opacity: .09;\n\n  will-change: transform;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-ambient--one {\n\n  width: 520px;\n\n  height: 520px;\n\n  top: -280px;\n\n  left: -220px;\n\n  background:\n    #a921d4;\n\n  animation:\n    prAmbientOne\n    18s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-ambient--two {\n\n  width: 560px;\n\n  height: 560px;\n\n  right: -260px;\n\n  bottom: -300px;\n\n  background:\n    #6314b6;\n\n  animation:\n    prAmbientTwo\n    21s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n\n/* =========================================================\n   CONTAINER\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-container {\n\n  width:\n    min(\n      1400px,\n      calc(100% - 56px)\n    );\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-header {\n\n  width: 100%;\n\n  max-width: 760px;\n\n  margin:\n    0 auto\n    clamp(38px, 4.5vw, 58px);\n\n  text-align:\n    center;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-header h2 {\n\n  margin: 0;\n\n  color: #fff;\n\n  font-size:\n    clamp(\n      40px,\n      5vw,\n      68px\n    );\n\n  line-height:\n    .98;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-header h2 span {\n\n  color:\n    var(--pr-yellow);\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-header p {\n\n  max-width:\n    500px;\n\n  margin:\n    17px auto 0;\n\n  color:\n    rgba(255,255,255,.58);\n\n  font-size:\n    clamp(\n      14px,\n      1.2vw,\n      16px\n    );\n\n  line-height:\n    1.5;\n\n}\n\n\n\n/* =========================================================\n   DESKTOP GRID\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-grid {\n\n  display: grid;\n\n  grid-template-columns:\n    repeat(\n      3,\n      minmax(0,1fr)\n    );\n\n  gap:\n    clamp(\n      14px,\n      1.55vw,\n      22px\n    );\n\n}\n\n\n\n/* =========================================================\n   CARD\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-card {\n\n  position:\n    relative;\n\n  display:\n    block;\n\n  min-width:\n    0;\n\n  color:\n    inherit;\n\n  text-decoration:\n    none;\n\n  outline:\n    none;\n\n  border-radius:\n    clamp(\n      21px,\n      1.8vw,\n      27px\n    );\n\n}\n\n\n\n/* =========================================================\n   MEDIA\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-media {\n\n  position:\n    relative;\n\n  width:\n    100%;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    inherit;\n\n  background:\n    #30003e;\n\n  border:\n    1px solid\n    rgba(255,255,255,.1);\n\n  box-shadow:\n    0 16px 42px\n    rgba(0,0,0,.2);\n\n  transform:\n    translateZ(0);\n\n  transition:\n\n    transform\n    .72s\n    cubic-bezier(.16,1,.3,1),\n\n    box-shadow\n    .72s\n    cubic-bezier(.16,1,.3,1),\n\n    border-color\n    .45s ease;\n\n}\n\n\n\n/* subtle premium edge */\n\n#price-premium-{{ section.id }}\n.pr-media::after {\n\n  content: \"\";\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    5;\n\n  pointer-events:\n    none;\n\n  border-radius:\n    inherit;\n\n  box-shadow:\n\n    inset 0 1px 0\n    rgba(255,255,255,.075),\n\n    inset 0 -1px 0\n    rgba(255,255,255,.018);\n\n}\n\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-media img {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  display:\n    block;\n\n  width:\n    100%;\n\n  height:\n    100%;\n\n  object-fit:\n    cover;\n\n  transform:\n    scale(1.004);\n\n  transition:\n    transform\n    1.05s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =========================================================\n   PLACEHOLDER\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-placeholder {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  text-align:\n    center;\n\n  padding:\n    24px;\n\n  background:\n\n    radial-gradient(\n      circle at 74% 15%,\n      rgba(189,38,231,.19),\n      transparent 38%\n    ),\n\n    linear-gradient(\n      145deg,\n      #65108a 0%,\n      #2d0039 100%\n    );\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-placeholder::before {\n\n  content: \"\";\n\n  position:\n    absolute;\n\n  width:\n    70%;\n\n  height:\n    70%;\n\n  border-radius:\n    50%;\n\n  background:\n\n    radial-gradient(\n      circle,\n      rgba(189,37,231,.13),\n      transparent 67%\n    );\n\n  filter:\n    blur(24px);\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-placeholder span {\n\n  position:\n    relative;\n\n  z-index:\n    1;\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-size:\n    10px;\n\n  font-weight:\n    700;\n\n  line-height:\n    1.35;\n\n  letter-spacing:\n    .16em;\n\n}\n\n\n\n/* =========================================================\n   HOVER LIGHT\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-hover-light {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    2;\n\n  pointer-events:\n    none;\n\n  opacity:\n    0;\n\n  background:\n\n    radial-gradient(\n      circle at 76% 18%,\n      rgba(255,255,255,.1),\n      transparent 34%\n    );\n\n  transition:\n    opacity\n    .6s ease;\n\n}\n\n\n\n/* =========================================================\n   ARROW\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-arrow {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  top:\n    clamp(\n      13px,\n      1.4vw,\n      20px\n    );\n\n  right:\n    clamp(\n      13px,\n      1.4vw,\n      20px\n    );\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  width:\n    clamp(\n      34px,\n      3vw,\n      42px\n    );\n\n  height:\n    clamp(\n      34px,\n      3vw,\n      42px\n    );\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.17);\n\n  background:\n    rgba(16,0,22,.16);\n\n  color:\n    rgba(255,255,255,.86);\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  transition:\n\n    background\n    .4s ease,\n\n    border-color\n    .4s ease,\n\n    color\n    .4s ease,\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-arrow svg {\n\n  width:\n    15px;\n\n  height:\n    15px;\n\n  transition:\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* =========================================================\n   HOVER\n========================================================= */\n\n@media (hover:hover) {\n\n  #price-premium-{{ section.id }}\n  .pr-card:hover\n  .pr-media {\n\n    transform:\n      translateY(-6px)\n      scale(1.004);\n\n    border-color:\n      rgba(255,255,255,.19);\n\n    box-shadow:\n      0 27px 62px\n      rgba(0,0,0,.3);\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-card:hover\n  .pr-media img {\n\n    transform:\n      scale(1.045);\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-card:hover\n  .pr-hover-light {\n\n    opacity:\n      1;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-card:hover\n  .pr-arrow {\n\n    background:\n      var(--pr-yellow);\n\n    border-color:\n      var(--pr-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      scale(1.055);\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-card:hover\n  .pr-arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* =========================================================\n   PRESS\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-card:active\n.pr-media {\n\n  transform:\n    scale(.99);\n\n  transition-duration:\n    .14s;\n\n}\n\n\n\n/* =========================================================\n   REVEAL\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-reveal {\n\n  opacity:\n    0;\n\n  transform:\n    translate3d(\n      0,\n      22px,\n      0\n    );\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-reveal.pr-visible {\n\n  opacity:\n    1;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n\n}\n\n\n\n/* STAGGER */\n\n#price-premium-{{ section.id }}\n.pr-card:nth-child(1) {\n\n  transition-delay:\n    .04s;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-card:nth-child(2) {\n\n  transition-delay:\n    .10s;\n\n}\n\n\n#price-premium-{{ section.id }}\n.pr-card:nth-child(3) {\n\n  transition-delay:\n    .16s;\n\n}\n\n\n\n/* =========================================================\n   SCREEN READER\n========================================================= */\n\n#price-premium-{{ section.id }}\n.pr-sr {\n\n  position:\n    absolute;\n\n  width:\n    1px;\n\n  height:\n    1px;\n\n  padding:\n    0;\n\n  margin:\n    -1px;\n\n  overflow:\n    hidden;\n\n  clip:\n    rect(0,0,0,0);\n\n  white-space:\n    nowrap;\n\n  border:\n    0;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media\n(max-width: 900px)\nand\n(min-width: 750px) {\n\n  #price-premium-{{ section.id }}\n  .pr-container {\n\n    width:\n      calc(100% - 32px);\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-grid {\n\n    gap:\n      12px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n\n   4-COLUMN TECHNICAL GRID\n\n   [   1   ][   2   ]\n\n        [   3   ]\n\n   Each card still takes exactly 50% width.\n========================================================= */\n\n@media\n(max-width: 749px) {\n\n\n  #price-premium-{{ section.id }} {\n\n    padding:\n      56px 0\n      66px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n\n  /* HEADER */\n\n  #price-premium-{{ section.id }}\n  .pr-header {\n\n    width:\n      calc(100% - 8px);\n\n    margin-bottom:\n      28px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-header h2 {\n\n    font-size:\n      clamp(\n        35px,\n        9.8vw,\n        46px\n      );\n\n    line-height:\n      1;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-header p {\n\n    max-width:\n      310px;\n\n    margin-top:\n      13px;\n\n    font-size:\n      13px;\n\n  }\n\n\n\n  /* GRID */\n\n  #price-premium-{{ section.id }}\n  .pr-grid {\n\n    display:\n      grid;\n\n    grid-template-columns:\n      repeat(\n        4,\n        minmax(0,1fr)\n      );\n\n    gap:\n      10px;\n\n  }\n\n\n\n  /* FIRST TWO = HALF WIDTH */\n\n  #price-premium-{{ section.id }}\n  .pr-card {\n\n    grid-column:\n      span 2;\n\n  }\n\n\n\n  /* THIRD = SAME WIDTH, CENTERED */\n\n  #price-premium-{{ section.id }}\n  .pr-card--three {\n\n    grid-column:\n      2 / span 2;\n\n  }\n\n\n\n  /* CARDS */\n\n  #price-premium-{{ section.id }}\n  .pr-card {\n\n    border-radius:\n      19px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-media {\n\n    border-radius:\n      19px;\n\n  }\n\n\n\n  /* ARROW */\n\n  #price-premium-{{ section.id }}\n  .pr-arrow {\n\n    top:\n      10px;\n\n    right:\n      10px;\n\n    width:\n      30px;\n\n    height:\n      30px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-arrow svg {\n\n    width:\n      12px;\n\n    height:\n      12px;\n\n  }\n\n\n  /* NO HOVER LIFT ON TOUCH */\n\n  #price-premium-{{ section.id }}\n  .pr-media {\n\n    transform:\n      none;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media\n(max-width: 370px) {\n\n  #price-premium-{{ section.id }}\n  .pr-container {\n\n    width:\n      calc(100% - 20px);\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-grid {\n\n    gap:\n      8px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-card,\n  #price-premium-{{ section.id }}\n  .pr-media {\n\n    border-radius:\n      17px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-arrow {\n\n    width:\n      27px;\n\n    height:\n      27px;\n\n    top:\n      8px;\n\n    right:\n      8px;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-arrow svg {\n\n    width:\n      11px;\n\n    height:\n      11px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   BACKGROUND MOTION\n========================================================= */\n\n@keyframes\nprAmbientOne {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        65px,\n        32px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes\nprAmbientTwo {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -65px,\n        -30px,\n        0\n      );\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #price-premium-{{ section.id }} *,\n  #price-premium-{{ section.id }} *::before,\n  #price-premium-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #price-premium-{{ section.id }}\n  .pr-reveal {\n\n    opacity:\n      1;\n\n    transform:\n      none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'price-premium-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n\n  /* ==========================================\n     REVEAL ANIMATION\n  ========================================== */\n\n  const revealItems =\n    section.querySelectorAll(\n      '.pr-reveal'\n    );\n\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (\n    !reducedMotion &&\n    'IntersectionObserver' in window\n  ) {\n\n    const observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (!entry.isIntersecting) {\n                return;\n              }\n\n\n              entry.target\n                .classList\n                .add(\n                  'pr-visible'\n                );\n\n\n              observer.unobserve(\n                entry.target\n              );\n\n            }\n          );\n\n        },\n\n        {\n          threshold:\n            .12,\n\n          rootMargin:\n            '0px 0px -24px 0px'\n        }\n\n      );\n\n\n    revealItems.forEach(\n      function (item) {\n\n        observer.observe(\n          item\n        );\n\n      }\n    );\n\n  }\n\n  else {\n\n    revealItems.forEach(\n      function (item) {\n\n        item.classList.add(\n          'pr-visible'\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* ==========================================\n     SAME PAGE SMOOTH SCROLL\n  ========================================== */\n\n  const links =\n    section.querySelectorAll(\n      '[data-price-link]'\n    );\n\n\n  links.forEach(\n    function (link) {\n\n      link.addEventListener(\n        'click',\n        function (event) {\n\n          const href =\n            link.getAttribute(\n              'href'\n            );\n\n\n          if (\n            !href ||\n            href.charAt(0) !== '#'\n          ) {\n            return;\n          }\n\n\n          const target =\n            document.querySelector(\n              href\n            );\n\n\n          if (!target) {\n            return;\n          }\n\n\n          event.preventDefault();\n\n\n          const headerOffset =\n            90;\n\n\n          const position =\n            target\n              .getBoundingClientRect()\n              .top +\n            window.pageYOffset -\n            headerOffset;\n\n\n          window.scrollTo({\n\n            top:\n              position,\n\n            behavior:\n              reducedMotion\n                ? 'auto'\n                : 'smooth'\n\n          });\n\n        }\n      );\n\n    }\n  );\n\n})();\n\n</script>",
