    "custom_liquid_FdHkfj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — PREMIUM PRODUCT CAROUSEL\n\n  NO SCHEMA.\n  CUSTOM LIQUID ONLY.\n\n  COLLECTION 1 → FIRST 3 PRODUCTS\n  COLLECTION 2 → FIRST 3 PRODUCTS\n  COLLECTION 3 → FIRST 3 PRODUCTS\n\n  TOTAL → 9 PRODUCTS\n{% endcomment %}\n\n\n{% assign collection_1 = collections['now-or-never-buy-1-get-1-badminton-rackets'] %}\n{% assign collection_2 = collections['now-or-never-but-1-get-1-kitbag'] %}\n{% assign collection_3 = collections['now-or-never-buy-1-get-1-paddles'] %}\n\n{% assign view_all_link = '/collections/all' %}\n\n\n\n<section\n  id=\"nn-products-{{ section.id }}\"\n  class=\"nn-products\"\n>\n\n  <div class=\"nn-products__ambient\" aria-hidden=\"true\">\n    <span class=\"nn-products__glow nn-products__glow--1\"></span>\n    <span class=\"nn-products__glow nn-products__glow--2\"></span>\n  </div>\n\n\n  <div class=\"nn-products__container\">\n\n\n    <!-- HEADER -->\n    <div class=\"nn-products__header nn-reveal\">\n\n      <div class=\"nn-products__heading\">\n\n        <span class=\"nn-products__eyebrow\">\n          SHOP THE SALE\n        </span>\n\n        <h2>\n          Featured picks.\n        </h2>\n\n        <p>\n          Nine picks across the sale, all in one place.\n        </p>\n\n      </div>\n\n\n      <div class=\"nn-products__actions\">\n\n        <a\n          href=\"{{ view_all_link }}\"\n          class=\"nn-products__view\"\n        >\n          <span>View all</span>\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n          >\n            <path\n              d=\"M5 12H19M14 7L19 12L14 17\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.7\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n\n        <div class=\"nn-products__nav\">\n\n          <button\n            class=\"nn-products__nav-btn nn-products__prev\"\n            type=\"button\"\n            aria-label=\"Previous products\"\n          >\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M19 12H5M10 7L5 12L10 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n          </button>\n\n\n          <button\n            class=\"nn-products__nav-btn nn-products__next\"\n            type=\"button\"\n            aria-label=\"Next products\"\n          >\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n          </button>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- CAROUSEL -->\n    <div class=\"nn-products__carousel-wrap\">\n\n      <div\n        class=\"nn-products__carousel\"\n        data-nn-carousel\n      >\n\n\n        <!-- COLLECTION 1 -->\n        {% if collection_1 != blank %}\n\n          {% for product in collection_1.products limit: 3 %}\n\n            <article class=\"nn-product nn-reveal\">\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"nn-product__link\"\n              >\n\n                <div class=\"nn-product__media\">\n\n                  {% if product.featured_image != blank %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--primary\"\n                      src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                      alt=\"{{ product.title | escape }}\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  {% if product.images.size > 1 %}\n\n                    {% assign second_image = product.images[1] %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--secondary\"\n                      src=\"{{ second_image | image_url: width: 900 }}\"\n                      alt=\"\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  <div class=\"nn-product__shade\"></div>\n\n\n                  <span class=\"nn-product__collection\">\n                    {{ collection_1.title }}\n                  </span>\n\n\n                  {% unless product.available %}\n\n                    <span class=\"nn-product__badge\">\n                      SOLD OUT\n                    </span>\n\n                  {% else %}\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__badge nn-product__badge--sale\">\n                        SALE\n                      </span>\n\n                    {% endif %}\n\n                  {% endunless %}\n\n\n                  <span class=\"nn-product__arrow\">\n\n                    <svg\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                    >\n                      <path\n                        d=\"M5 12H19M14 7L19 12L14 17\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"1.7\"\n                        stroke-linecap=\"round\"\n                        stroke-linejoin=\"round\"\n                      />\n                    </svg>\n\n                  </span>\n\n                </div>\n\n\n                <div class=\"nn-product__info\">\n\n                  <h3>\n                    {{ product.title }}\n                  </h3>\n\n\n                  <div class=\"nn-product__price\">\n\n                    <span class=\"nn-product__price-current\">\n                      {{ product.price | money }}\n                    </span>\n\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__price-old\">\n                        {{ product.compare_at_price_max | money }}\n                      </span>\n\n                    {% endif %}\n\n                  </div>\n\n                </div>\n\n              </a>\n\n            </article>\n\n          {% endfor %}\n\n        {% endif %}\n\n\n\n        <!-- COLLECTION 2 -->\n        {% if collection_2 != blank %}\n\n          {% for product in collection_2.products limit: 3 %}\n\n            <article class=\"nn-product nn-reveal\">\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"nn-product__link\"\n              >\n\n                <div class=\"nn-product__media\">\n\n                  {% if product.featured_image != blank %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--primary\"\n                      src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                      alt=\"{{ product.title | escape }}\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  {% if product.images.size > 1 %}\n\n                    {% assign second_image = product.images[1] %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--secondary\"\n                      src=\"{{ second_image | image_url: width: 900 }}\"\n                      alt=\"\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  <div class=\"nn-product__shade\"></div>\n\n\n                  <span class=\"nn-product__collection\">\n                    {{ collection_2.title }}\n                  </span>\n\n\n                  {% unless product.available %}\n\n                    <span class=\"nn-product__badge\">\n                      SOLD OUT\n                    </span>\n\n                  {% else %}\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__badge nn-product__badge--sale\">\n                        SALE\n                      </span>\n\n                    {% endif %}\n\n                  {% endunless %}\n\n\n                  <span class=\"nn-product__arrow\">\n\n                    <svg\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                    >\n                      <path\n                        d=\"M5 12H19M14 7L19 12L14 17\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"1.7\"\n                        stroke-linecap=\"round\"\n                        stroke-linejoin=\"round\"\n                      />\n                    </svg>\n\n                  </span>\n\n                </div>\n\n\n                <div class=\"nn-product__info\">\n\n                  <h3>\n                    {{ product.title }}\n                  </h3>\n\n\n                  <div class=\"nn-product__price\">\n\n                    <span class=\"nn-product__price-current\">\n                      {{ product.price | money }}\n                    </span>\n\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__price-old\">\n                        {{ product.compare_at_price_max | money }}\n                      </span>\n\n                    {% endif %}\n\n                  </div>\n\n                </div>\n\n              </a>\n\n            </article>\n\n          {% endfor %}\n\n        {% endif %}\n\n\n\n        <!-- COLLECTION 3 -->\n        {% if collection_3 != blank %}\n\n          {% for product in collection_3.products limit: 3 %}\n\n            <article class=\"nn-product nn-reveal\">\n\n              <a\n                href=\"{{ product.url }}\"\n                class=\"nn-product__link\"\n              >\n\n                <div class=\"nn-product__media\">\n\n                  {% if product.featured_image != blank %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--primary\"\n                      src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                      alt=\"{{ product.title | escape }}\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  {% if product.images.size > 1 %}\n\n                    {% assign second_image = product.images[1] %}\n\n                    <img\n                      class=\"nn-product__image nn-product__image--secondary\"\n                      src=\"{{ second_image | image_url: width: 900 }}\"\n                      alt=\"\"\n                      loading=\"lazy\"\n                      width=\"900\"\n                      height=\"900\"\n                    >\n\n                  {% endif %}\n\n\n                  <div class=\"nn-product__shade\"></div>\n\n\n                  <span class=\"nn-product__collection\">\n                    {{ collection_3.title }}\n                  </span>\n\n\n                  {% unless product.available %}\n\n                    <span class=\"nn-product__badge\">\n                      SOLD OUT\n                    </span>\n\n                  {% else %}\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__badge nn-product__badge--sale\">\n                        SALE\n                      </span>\n\n                    {% endif %}\n\n                  {% endunless %}\n\n\n                  <span class=\"nn-product__arrow\">\n\n                    <svg\n                      viewBox=\"0 0 24 24\"\n                      fill=\"none\"\n                    >\n                      <path\n                        d=\"M5 12H19M14 7L19 12L14 17\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"1.7\"\n                        stroke-linecap=\"round\"\n                        stroke-linejoin=\"round\"\n                      />\n                    </svg>\n\n                  </span>\n\n                </div>\n\n\n                <div class=\"nn-product__info\">\n\n                  <h3>\n                    {{ product.title }}\n                  </h3>\n\n\n                  <div class=\"nn-product__price\">\n\n                    <span class=\"nn-product__price-current\">\n                      {{ product.price | money }}\n                    </span>\n\n\n                    {% if product.compare_at_price_max > product.price %}\n\n                      <span class=\"nn-product__price-old\">\n                        {{ product.compare_at_price_max | money }}\n                      </span>\n\n                    {% endif %}\n\n                  </div>\n\n                </div>\n\n              </a>\n\n            </article>\n\n          {% endfor %}\n\n        {% endif %}\n\n\n      </div>\n\n\n\n      <!-- progress -->\n      <div class=\"nn-products__progress\">\n\n        <div class=\"nn-products__progress-track\">\n          <span class=\"nn-products__progress-bar\"></span>\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ==========================================================\n   SECTION\n========================================================== */\n\n#nn-products-{{ section.id }} {\n\n  --nn-yellow: #f2ee38;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  padding:\n    clamp(68px, 7vw, 104px)\n    0\n    clamp(75px, 7vw, 108px);\n\n  background:\n    linear-gradient(\n      180deg,\n      #16001e 0%,\n      #1b0023 50%,\n      #16001e 100%\n    );\n\n  color: white;\n\n}\n\n\n\n/* ==========================================================\n   AMBIENT\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__ambient {\n\n  position: absolute;\n\n  inset: 0;\n\n  pointer-events: none;\n\n  z-index: -1;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter: blur(150px);\n\n  opacity: .08;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow--1 {\n\n  width: 520px;\n\n  height: 520px;\n\n  top: -300px;\n\n  left: -220px;\n\n  background:\n    #9f1dcb;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__glow--2 {\n\n  width: 540px;\n\n  height: 540px;\n\n  right: -260px;\n\n  bottom: -300px;\n\n  background:\n    #5d11af;\n\n}\n\n\n\n/* ==========================================================\n   CONTAINER\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__container {\n\n  width:\n    min(\n      1500px,\n      calc(100% - 64px)\n    );\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* ==========================================================\n   HEADER\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__header {\n\n  display: flex;\n\n  align-items: flex-end;\n\n  justify-content:\n    space-between;\n\n  gap: 25px;\n\n  margin-bottom:\n    clamp(\n      30px,\n      4vw,\n      46px\n    );\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading {\n\n  max-width:\n    720px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__eyebrow {\n\n  display: block;\n\n  margin-bottom:\n    12px;\n\n  color:\n    var(--nn-yellow);\n\n  font-size:\n    9px;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    .2em;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading h2 {\n\n  margin:\n    0;\n\n  font-size:\n    clamp(\n      39px,\n      4.5vw,\n      62px\n    );\n\n  line-height:\n    .98;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__heading p {\n\n  margin:\n    14px 0 0;\n\n  max-width:\n    500px;\n\n  color:\n    rgba(255,255,255,.52);\n\n  font-size:\n    14px;\n\n  line-height:\n    1.5;\n\n}\n\n\n\n/* ==========================================================\n   ACTIONS\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__actions {\n\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  gap:\n    10px;\n\n  flex-shrink:\n    0;\n\n}\n\n\n\n/* VIEW ALL */\n\n#nn-products-{{ section.id }}\n.nn-products__view {\n\n  min-height:\n    46px;\n\n  padding:\n    0 18px;\n\n  display:\n    inline-flex;\n\n  align-items:\n    center;\n\n  gap:\n    10px;\n\n  border-radius:\n    999px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  background:\n    rgba(255,255,255,.04);\n\n  color:\n    white;\n\n  text-decoration:\n    none;\n\n  font-size:\n    12px;\n\n  font-weight:\n    600;\n\n  transition:\n    .4s ease;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__view svg {\n\n  width:\n    15px;\n\n  height:\n    15px;\n\n  transition:\n    transform .4s ease;\n\n}\n\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__view:hover {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__view:hover svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   NAVIGATION\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__nav {\n\n  display:\n    flex;\n\n  gap:\n    7px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn {\n\n  width:\n    46px;\n\n  height:\n    46px;\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  padding:\n    0;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.14);\n\n  background:\n    rgba(255,255,255,.04);\n\n  color:\n    white;\n\n  cursor:\n    pointer;\n\n  transition:\n    .4s ease;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn svg {\n\n  width:\n    16px;\n\n  height:\n    16px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__nav-btn:disabled {\n\n  opacity:\n    .25;\n\n  cursor:\n    default;\n\n}\n\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__nav-btn:not(:disabled):hover {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   CAROUSEL\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__carousel {\n\n  display:\n    grid;\n\n  grid-auto-flow:\n    column;\n\n  grid-auto-columns:\n    calc(\n      (100% - 54px) / 4\n    );\n\n  gap:\n    18px;\n\n  overflow-x:\n    auto;\n\n  overflow-y:\n    hidden;\n\n  padding:\n    3px 2px\n    22px;\n\n  scroll-snap-type:\n    x mandatory;\n\n  scroll-behavior:\n    smooth;\n\n  scrollbar-width:\n    none;\n\n  overscroll-behavior-inline:\n    contain;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__carousel::-webkit-scrollbar {\n\n  display:\n    none;\n\n}\n\n\n\n/* ==========================================================\n   PRODUCT CARD\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product {\n\n  scroll-snap-align:\n    start;\n\n  min-width:\n    0;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__link {\n\n  display:\n    block;\n\n  color:\n    inherit;\n\n  text-decoration:\n    none;\n\n}\n\n\n\n/* IMAGE AREA */\n\n#nn-products-{{ section.id }}\n.nn-product__media {\n\n  position:\n    relative;\n\n  width:\n    100%;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    24px;\n\n  background:\n    #f4f5fa;\n\n  border:\n    1px solid\n    rgba(255,255,255,.08);\n\n  box-shadow:\n    0 15px 40px\n    rgba(0,0,0,.17);\n\n  transition:\n\n    transform\n    .7s\n    cubic-bezier(.16,1,.3,1),\n\n    box-shadow\n    .7s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* IMAGES */\n\n#nn-products-{{ section.id }}\n.nn-product__image {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  width:\n    100%;\n\n  height:\n    100%;\n\n  object-fit:\n    cover;\n\n  transition:\n\n    opacity\n    .6s ease,\n\n    transform\n    1s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__image--primary {\n\n  z-index:\n    1;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__image--secondary {\n\n  z-index:\n    2;\n\n  opacity:\n    0;\n\n}\n\n\n\n/* SHADE */\n\n#nn-products-{{ section.id }}\n.nn-product__shade {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    3;\n\n  pointer-events:\n    none;\n\n  background:\n    linear-gradient(\n      180deg,\n      transparent 72%,\n      rgba(0,0,0,.04) 100%\n    );\n\n}\n\n\n\n/* COLLECTION */\n\n#nn-products-{{ section.id }}\n.nn-product__collection {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  top:\n    15px;\n\n  left:\n    15px;\n\n  max-width:\n    calc(100% - 75px);\n\n  overflow:\n    hidden;\n\n  text-overflow:\n    ellipsis;\n\n  white-space:\n    nowrap;\n\n  padding:\n    8px 10px;\n\n  border-radius:\n    999px;\n\n  background:\n    rgba(15,0,20,.72);\n\n  color:\n    rgba(255,255,255,.92);\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  font-size:\n    8px;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    .1em;\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n/* BADGE */\n\n#nn-products-{{ section.id }}\n.nn-product__badge {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  left:\n    15px;\n\n  bottom:\n    15px;\n\n  padding:\n    8px 10px;\n\n  border-radius:\n    999px;\n\n  background:\n    #25132a;\n\n  color:\n    white;\n\n  font-size:\n    8px;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    .1em;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__badge--sale {\n\n  background:\n    var(--nn-yellow);\n\n  color:\n    #211023;\n\n}\n\n\n\n/* ARROW */\n\n#nn-products-{{ section.id }}\n.nn-product__arrow {\n\n  position:\n    absolute;\n\n  z-index:\n    4;\n\n  top:\n    14px;\n\n  right:\n    14px;\n\n  width:\n    38px;\n\n  height:\n    38px;\n\n  display:\n    grid;\n\n  place-items:\n    center;\n\n  border-radius:\n    50%;\n\n  border:\n    1px solid\n    rgba(255,255,255,.18);\n\n  background:\n    rgba(15,0,20,.72);\n\n  color:\n    white;\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  transition:\n    .45s ease;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__arrow svg {\n\n  width:\n    14px;\n\n  height:\n    14px;\n\n}\n\n\n\n/* ==========================================================\n   PRODUCT INFO\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-product__info {\n\n  padding:\n    16px 3px\n    3px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__info h3 {\n\n  margin:\n    0;\n\n  min-height:\n    2.5em;\n\n  overflow:\n    hidden;\n\n  display:\n    -webkit-box;\n\n  -webkit-line-clamp:\n    2;\n\n  -webkit-box-orient:\n    vertical;\n\n  color:\n    rgba(255,255,255,.94);\n\n  font-size:\n    clamp(\n      15px,\n      1.15vw,\n      18px\n    );\n\n  line-height:\n    1.25;\n\n  font-weight:\n    550;\n\n  letter-spacing:\n    -.02em;\n\n}\n\n\n\n/* PRICE */\n\n#nn-products-{{ section.id }}\n.nn-product__price {\n\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  flex-wrap:\n    wrap;\n\n  gap:\n    9px;\n\n  margin-top:\n    10px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__price-current {\n\n  color:\n    white;\n\n  font-size:\n    16px;\n\n  font-weight:\n    650;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-product__price-old {\n\n  color:\n    rgba(255,255,255,.38);\n\n  font-size:\n    13px;\n\n  text-decoration:\n    line-through;\n\n}\n\n\n\n/* ==========================================================\n   HOVER\n========================================================== */\n\n@media (hover:hover) {\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__media {\n\n    transform:\n      translateY(-6px);\n\n    box-shadow:\n      0 28px 65px\n      rgba(0,0,0,.28);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__image--primary {\n\n    transform:\n      scale(1.035);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__image--secondary {\n\n    opacity:\n      1;\n\n    transform:\n      scale(1.035);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product:hover\n  .nn-product__arrow {\n\n    background:\n      var(--nn-yellow);\n\n    border-color:\n      var(--nn-yellow);\n\n    color:\n      #211023;\n\n    transform:\n      scale(1.05);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   PROGRESS\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-products__progress {\n\n  display:\n    flex;\n\n  justify-content:\n    center;\n\n  margin-top:\n    4px;\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__progress-track {\n\n  position:\n    relative;\n\n  width:\n    min(\n      230px,\n      40%\n    );\n\n  height:\n    2px;\n\n  overflow:\n    hidden;\n\n  border-radius:\n    999px;\n\n  background:\n    rgba(255,255,255,.1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-products__progress-bar {\n\n  position:\n    absolute;\n\n  inset:\n    0 auto 0 0;\n\n  width:\n    25%;\n\n  border-radius:\n    999px;\n\n  background:\n    var(--nn-yellow);\n\n  transform-origin:\n    left center;\n\n}\n\n\n\n/* ==========================================================\n   REVEAL\n========================================================== */\n\n#nn-products-{{ section.id }}\n.nn-reveal {\n\n  opacity:\n    0;\n\n  transform:\n    translateY(20px);\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .9s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#nn-products-{{ section.id }}\n.nn-reveal.nn-visible {\n\n  opacity:\n    1;\n\n  transform:\n    translateY(0);\n\n}\n\n\n\n/* ==========================================================\n   TABLET\n========================================================== */\n\n@media\n(max-width: 1100px) {\n\n  #nn-products-{{ section.id }}\n  .nn-products__container {\n\n    width:\n      calc(100% - 36px);\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__carousel {\n\n    grid-auto-columns:\n      calc(\n        (100% - 18px) / 2.15\n      );\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   MOBILE\n========================================================== */\n\n@media\n(max-width: 749px) {\n\n  #nn-products-{{ section.id }} {\n\n    padding:\n      55px 0\n      65px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__container {\n\n    width:\n      100%;\n\n  }\n\n\n\n  /* HEADER */\n\n  #nn-products-{{ section.id }}\n  .nn-products__header {\n\n    width:\n      calc(100% - 28px);\n\n    margin:\n      0 auto\n      25px;\n\n    align-items:\n      flex-end;\n\n    gap:\n      12px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__heading h2 {\n\n    font-size:\n      clamp(\n        32px,\n        8.8vw,\n        42px\n      );\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__heading p {\n\n    display:\n      none;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__eyebrow {\n\n    font-size:\n      8px;\n\n  }\n\n\n\n  /* VIEW ALL */\n\n  #nn-products-{{ section.id }}\n  .nn-products__view {\n\n    min-height:\n      38px;\n\n    padding:\n      0 13px;\n\n    font-size:\n      10px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__view svg {\n\n    width:\n      12px;\n\n    height:\n      12px;\n\n  }\n\n\n\n  /* hide desktop nav */\n\n  #nn-products-{{ section.id }}\n  .nn-products__nav {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* CAROUSEL */\n\n  #nn-products-{{ section.id }}\n  .nn-products__carousel {\n\n    grid-auto-columns:\n      76vw;\n\n    gap:\n      12px;\n\n    padding:\n      2px 14px\n      21px;\n\n    scroll-padding-inline:\n      14px;\n\n  }\n\n\n\n  /* PRODUCT */\n\n  #nn-products-{{ section.id }}\n  .nn-product__media {\n\n    border-radius:\n      21px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__collection {\n\n    top:\n      12px;\n\n    left:\n      12px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__badge {\n\n    left:\n      12px;\n\n    bottom:\n      12px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__arrow {\n\n    top:\n      12px;\n\n    right:\n      12px;\n\n    width:\n      34px;\n\n    height:\n      34px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__info {\n\n    padding:\n      14px 3px\n      3px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__info h3 {\n\n    min-height:\n      auto;\n\n    font-size:\n      16px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__price {\n\n    margin-top:\n      8px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-product__price-current {\n\n    font-size:\n      15px;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-products__progress-track {\n\n    width:\n      120px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REDUCED MOTION\n========================================================== */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #nn-products-{{ section.id }} *,\n  #nn-products-{{ section.id }} *::before,\n  #nn-products-{{ section.id }} *::after {\n\n    transition:\n      none !important;\n\n    animation:\n      none !important;\n\n    scroll-behavior:\n      auto !important;\n\n  }\n\n\n  #nn-products-{{ section.id }}\n  .nn-reveal {\n\n    opacity:\n      1;\n\n    transform:\n      none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'nn-products-{{ section.id }}'\n    );\n\n\n  if (!section) return;\n\n\n  const carousel =\n    section.querySelector(\n      '[data-nn-carousel]'\n    );\n\n\n  if (!carousel) return;\n\n\n  const prev =\n    section.querySelector(\n      '.nn-products__prev'\n    );\n\n\n  const next =\n    section.querySelector(\n      '.nn-products__next'\n    );\n\n\n  const progress =\n    section.querySelector(\n      '.nn-products__progress-bar'\n    );\n\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n\n  /* CARD WIDTH */\n\n  function getCardStep() {\n\n    const card =\n      carousel.querySelector(\n        '.nn-product'\n      );\n\n\n    if (!card) return 0;\n\n\n    const styles =\n      window.getComputedStyle(\n        carousel\n      );\n\n\n    const gap =\n      parseFloat(\n        styles.gap || 0\n      );\n\n\n    return (\n      card.getBoundingClientRect().width +\n      gap\n    );\n\n  }\n\n\n\n  /* PREV */\n\n  if (prev) {\n\n    prev.addEventListener(\n      'click',\n      function () {\n\n        carousel.scrollBy({\n\n          left:\n            -getCardStep(),\n\n          behavior:\n            reducedMotion\n              ? 'auto'\n              : 'smooth'\n\n        });\n\n      }\n    );\n\n  }\n\n\n\n  /* NEXT */\n\n  if (next) {\n\n    next.addEventListener(\n      'click',\n      function () {\n\n        carousel.scrollBy({\n\n          left:\n            getCardStep(),\n\n          behavior:\n            reducedMotion\n              ? 'auto'\n              : 'smooth'\n\n        });\n\n      }\n    );\n\n  }\n\n\n\n  /* UPDATE CONTROLS + PROGRESS */\n\n  function updateCarousel() {\n\n    const max =\n      carousel.scrollWidth -\n      carousel.clientWidth;\n\n\n    const current =\n      carousel.scrollLeft;\n\n\n    if (prev) {\n\n      prev.disabled =\n        current <= 4;\n\n    }\n\n\n    if (next) {\n\n      next.disabled =\n        current >= max - 4;\n\n    }\n\n\n    if (\n      progress &&\n      max > 0\n    ) {\n\n      const visible =\n        carousel.clientWidth /\n        carousel.scrollWidth;\n\n\n      const width =\n        Math.max(\n          20,\n          Math.min(\n            100,\n            visible * 100\n          )\n        );\n\n\n      progress.style.width =\n        width + '%';\n\n\n      const available =\n        100 - width;\n\n\n      const ratio =\n        current / max;\n\n\n      progress.style.transform =\n        'translateX(' +\n        ((available / width) * ratio * 100) +\n        '%)';\n\n    }\n\n  }\n\n\n  carousel.addEventListener(\n    'scroll',\n    updateCarousel,\n    {\n      passive: true\n    }\n  );\n\n\n  window.addEventListener(\n    'resize',\n    updateCarousel\n  );\n\n\n  updateCarousel();\n\n\n\n  /* REVEAL */\n\n  const revealItems =\n    section.querySelectorAll(\n      '.nn-reveal'\n    );\n\n\n  if (\n    !reducedMotion &&\n    'IntersectionObserver' in window\n  ) {\n\n    const observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (!entry.isIntersecting) {\n                return;\n              }\n\n\n              entry.target\n                .classList\n                .add(\n                  'nn-visible'\n                );\n\n\n              observer.unobserve(\n                entry.target\n              );\n\n            }\n          );\n\n        },\n\n        {\n          threshold:\n            .1,\n\n          rootMargin:\n            '0px 0px -20px 0px'\n        }\n\n      );\n\n\n    revealItems.forEach(\n      function (item) {\n\n        observer.observe(\n          item\n        );\n\n      }\n    );\n\n  }\n\n  else {\n\n    revealItems.forEach(\n      function (item) {\n\n        item.classList.add(\n          'nn-visible'\n        );\n\n      }\n    );\n\n  }\n\n})();\n\n</script>",
