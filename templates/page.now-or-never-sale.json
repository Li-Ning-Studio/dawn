    "custom_liquid_84DEHd": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  NOW OR NEVER — OFFERS\n  Image-first premium layout\n\n  DESKTOP:\n  [ B1G1 ] [ RACKET ] [ SHOE ]\n  [ DISC ] [     T-SHIRT      ]\n\n  MOBILE:\n  [ B1G1 ] [ RACKET ]\n  [ SHOE ] [ DISCOUNT ]\n  [      T-SHIRT      ]\n{% endcomment %}\n\n\n{% assign b1g1_link = '#shopify-section-template--25232045179173__hero_component_rMfbtJ' %}\n{% assign racket_bundle_link = '#shopify-section-template--25232045179173__hero_component_NJcenP' %}\n{% assign shoe_bundle_link = '#shopify-section-template--25232045179173__hero_component_ADBmYq' %}\n{% assign discount_link = '#shopify-section-template--25232045179173__hero_component_VK9DFC' %}\n{% assign tshirt_link = '#shopify-section-template--25232045179173__hero_component_U9Jb93' %}\n\n\n{% assign b1g1_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/B1G1.jpg?v=1790336731' %}\n\n{% assign racket_bundle_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Racket_Kiybag_String.jpg?v=1790336731' %}\n\n{% assign shoe_bundle_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Shoe_Shoe_bag_Socks.jpg?v=1790336731' %}\n\n{% assign discount_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Upto_60_Off.jpg?v=1790336731' %}\n\n{% assign tshirt_image = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Free_T-Shirt_Printing.jpg?v=1790336731' %}\n\n\n\n<section\n  id=\"offers-premium-{{ section.id }}\"\n  class=\"op-section\"\n>\n\n  <!-- BACKGROUND -->\n  <div\n    class=\"op-background\"\n    aria-hidden=\"true\"\n  >\n    <span class=\"op-ambient op-ambient--one\"></span>\n    <span class=\"op-ambient op-ambient--two\"></span>\n  </div>\n\n\n  <div class=\"op-container\">\n\n\n    <!-- ========================================\n         HEADER\n    ========================================= -->\n\n    <div class=\"op-header op-reveal\">\n\n      <h2>\n        Deals worth\n        <span>playing for.</span>\n      </h2>\n\n      <p>\n        Swipe through offers for the next 48 hours.\n      </p>\n\n    </div>\n\n\n\n    <!-- ========================================\n         OFFERS\n    ========================================= -->\n\n    <div class=\"op-grid\">\n\n\n      <!-- =====================================\n           01 — B1G1\n      ====================================== -->\n\n      <a\n        href=\"{{ b1g1_link }}\"\n        class=\"\n          op-card\n          op-card--b1g1\n          op-reveal\n        \"\n        data-offer-link\n        aria-label=\"View Buy 1 Get 1 offer\"\n      >\n\n        <span class=\"op-sr\">\n          Buy 1 Get 1\n        </span>\n\n\n        <div class=\"op-media\">\n\n          <img\n            src=\"{{ b1g1_image }}\"\n            alt=\"\"\n            width=\"1200\"\n            height=\"1200\"\n            loading=\"lazy\"\n          >\n\n\n          <div\n            class=\"op-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"op-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =====================================\n           02 — RACKET BUNDLE\n      ====================================== -->\n\n      <a\n        href=\"{{ racket_bundle_link }}\"\n        class=\"\n          op-card\n          op-card--racket\n          op-reveal\n        \"\n        data-offer-link\n        aria-label=\"View racket bundle offer\"\n      >\n\n        <span class=\"op-sr\">\n          Racket, Kitbag and Strings\n        </span>\n\n\n        <div class=\"op-media\">\n\n          <img\n            src=\"{{ racket_bundle_image }}\"\n            alt=\"\"\n            width=\"1200\"\n            height=\"1200\"\n            loading=\"lazy\"\n          >\n\n\n          <div\n            class=\"op-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"op-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =====================================\n           03 — SHOE BUNDLE\n      ====================================== -->\n\n      <a\n        href=\"{{ shoe_bundle_link }}\"\n        class=\"\n          op-card\n          op-card--shoe\n          op-reveal\n        \"\n        data-offer-link\n        aria-label=\"View shoe bundle offer\"\n      >\n\n        <span class=\"op-sr\">\n          Shoes, Shoe Bag and Socks\n        </span>\n\n\n        <div class=\"op-media\">\n\n          <img\n            src=\"{{ shoe_bundle_image }}\"\n            alt=\"\"\n            width=\"1200\"\n            height=\"1200\"\n            loading=\"lazy\"\n          >\n\n\n          <div\n            class=\"op-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"op-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =====================================\n           04 — DISCOUNTS\n      ====================================== -->\n\n      <a\n        href=\"{{ discount_link }}\"\n        class=\"\n          op-card\n          op-card--discount\n          op-reveal\n        \"\n        data-offer-link\n        aria-label=\"View discount offers\"\n      >\n\n        <span class=\"op-sr\">\n          Discounts\n        </span>\n\n\n        <div class=\"op-media\">\n\n          <img\n            src=\"{{ discount_image }}\"\n            alt=\"\"\n            width=\"1200\"\n            height=\"1200\"\n            loading=\"lazy\"\n          >\n\n\n          <div\n            class=\"op-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"op-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n\n      <!-- =====================================\n           05 — FREE T-SHIRT PRINTING\n      ====================================== -->\n\n      <a\n        href=\"{{ tshirt_link }}\"\n        class=\"\n          op-card\n          op-card--tshirt\n          op-reveal\n        \"\n        data-offer-link\n        aria-label=\"View free T-shirt printing offer\"\n      >\n\n        <span class=\"op-sr\">\n          Free T-shirt Printing\n        </span>\n\n\n        <div class=\"op-media\">\n\n          <img\n            src=\"{{ tshirt_image }}\"\n            alt=\"\"\n            width=\"1600\"\n            height=\"900\"\n            loading=\"lazy\"\n          >\n\n\n          <div\n            class=\"op-hover-light\"\n            aria-hidden=\"true\"\n          ></div>\n\n\n          <span\n            class=\"op-arrow\"\n            aria-hidden=\"true\"\n          >\n\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n            >\n              <path\n                d=\"M5 12H19M14 7L19 12L14 17\"\n                stroke=\"currentColor\"\n                stroke-width=\"1.8\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n\n          </span>\n\n        </div>\n\n      </a>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* ==========================================================\n   SECTION\n========================================================== */\n\n#offers-premium-{{ section.id }} {\n\n  --op-yellow: #f1ed38;\n  --op-bg: #17001f;\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  isolation: isolate;\n\n  padding:\n    clamp(70px, 7vw, 105px)\n    0\n    clamp(76px, 7vw, 110px);\n\n  background:\n    linear-gradient(\n      180deg,\n      #17001f 0%,\n      #1c0025 55%,\n      #16001e 100%\n    );\n\n  color: #fff;\n\n}\n\n\n\n/* ==========================================================\n   BACKGROUND\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-background {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-ambient {\n\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter:\n    blur(150px);\n\n  opacity: .1;\n\n  will-change: transform;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-ambient--one {\n\n  width: 520px;\n\n  height: 520px;\n\n  top: -290px;\n\n  left: -210px;\n\n  background:\n    #a31ed0;\n\n  animation:\n    opAmbientOne\n    18s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-ambient--two {\n\n  width: 560px;\n\n  height: 560px;\n\n  right: -260px;\n\n  bottom: -300px;\n\n  background:\n    #6512ba;\n\n  animation:\n    opAmbientTwo\n    21s\n    ease-in-out\n    infinite alternate;\n\n}\n\n\n\n/* ==========================================================\n   CONTAINER\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-container {\n\n  width:\n    min(\n      1400px,\n      calc(100% - 56px)\n    );\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* ==========================================================\n   HEADER\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-header {\n\n  width: 100%;\n\n  max-width: 720px;\n\n  margin:\n    0 auto\n    clamp(36px, 4.5vw, 58px);\n\n  text-align: center;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-header h2 {\n\n  margin: 0;\n\n  color: #fff;\n\n  font-size:\n    clamp(\n      40px,\n      5vw,\n      68px\n    );\n\n  line-height:\n    .98;\n\n  font-weight:\n    700;\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-header h2 span {\n\n  color:\n    var(--op-yellow);\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-header p {\n\n  margin:\n    17px auto 0;\n\n  color:\n    rgba(255,255,255,.58);\n\n  font-size:\n    clamp(\n      14px,\n      1.2vw,\n      16px\n    );\n\n  line-height:\n    1.5;\n\n}\n\n\n\n/* ==========================================================\n   DESKTOP GRID\n\n   01 | 02 | 03\n   04 |   05\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-grid {\n\n  display: grid;\n\n  grid-template-columns:\n    repeat(\n      3,\n      minmax(0,1fr)\n    );\n\n  align-items:\n    start;\n\n  gap:\n    clamp(\n      14px,\n      1.55vw,\n      22px\n    );\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card--b1g1 {\n\n  grid-column:\n    1;\n\n  grid-row:\n    1;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card--racket {\n\n  grid-column:\n    2;\n\n  grid-row:\n    1;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card--shoe {\n\n  grid-column:\n    3;\n\n  grid-row:\n    1;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card--discount {\n\n  grid-column:\n    1;\n\n  grid-row:\n    2;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card--tshirt {\n\n  grid-column:\n    2 / 4;\n\n  grid-row:\n    2;\n\n}\n\n\n\n/* ==========================================================\n   CARD\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-card {\n\n  position: relative;\n\n  display: block;\n\n  min-width: 0;\n\n  color: inherit;\n\n  text-decoration: none;\n\n  outline: none;\n\n  border-radius:\n    clamp(\n      20px,\n      1.8vw,\n      26px\n    );\n\n  transform:\n    translateZ(0);\n\n}\n\n\n\n/* ==========================================================\n   CARD MEDIA\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-media {\n\n  position: relative;\n\n  width: 100%;\n\n  overflow: hidden;\n\n  border-radius:\n    inherit;\n\n  background:\n    #30003f;\n\n  border:\n    1px solid\n    rgba(255,255,255,.1);\n\n  box-shadow:\n    0 16px 42px\n    rgba(0,0,0,.2);\n\n  transform:\n    translateZ(0);\n\n  transition:\n\n    transform\n    .7s\n    cubic-bezier(.16,1,.3,1),\n\n    border-color\n    .45s ease,\n\n    box-shadow\n    .7s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n/* tiny edge detail */\n\n#offers-premium-{{ section.id }}\n.op-media::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 5;\n\n  pointer-events: none;\n\n  border-radius:\n    inherit;\n\n  box-shadow:\n\n    inset 0 1px 0\n    rgba(255,255,255,.07),\n\n    inset 0 -1px 0\n    rgba(255,255,255,.015);\n\n}\n\n\n\n/* ==========================================================\n   IMAGES\n   NO CROPPING\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-media img {\n\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  height: auto;\n\n  max-width: 100%;\n\n  object-fit: contain;\n\n  transform:\n    scale(1.001);\n\n  transform-origin:\n    center;\n\n  transition:\n    transform\n    1s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* ==========================================================\n   SOFT HOVER LIGHT\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-hover-light {\n\n  position: absolute;\n\n  z-index: 2;\n\n  inset: 0;\n\n  pointer-events: none;\n\n  opacity: 0;\n\n  background:\n\n    radial-gradient(\n      circle at 80% 15%,\n      rgba(255,255,255,.1),\n      transparent 34%\n    );\n\n  transition:\n    opacity\n    .65s ease;\n\n}\n\n\n\n/* ==========================================================\n   ARROW\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-arrow {\n\n  position: absolute;\n\n  z-index: 4;\n\n  top:\n    clamp(\n      13px,\n      1.45vw,\n      20px\n    );\n\n  right:\n    clamp(\n      13px,\n      1.45vw,\n      20px\n    );\n\n  display: grid;\n\n  place-items: center;\n\n  width:\n    clamp(\n      34px,\n      3vw,\n      42px\n    );\n\n  height:\n    clamp(\n      34px,\n      3vw,\n      42px\n    );\n\n  border-radius:\n    50%;\n\n  color:\n    rgba(255,255,255,.86);\n\n  border:\n    1px solid\n    rgba(255,255,255,.18);\n\n  background:\n    rgba(18,0,24,.17);\n\n  backdrop-filter:\n    blur(10px);\n\n  -webkit-backdrop-filter:\n    blur(10px);\n\n  transition:\n\n    background\n    .4s ease,\n\n    color\n    .4s ease,\n\n    border-color\n    .4s ease,\n\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-arrow svg {\n\n  width:\n    15px;\n\n  height:\n    15px;\n\n  transition:\n    transform\n    .55s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n\n/* ==========================================================\n   SCREEN READER TEXT\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-sr {\n\n  position: absolute;\n\n  width: 1px;\n\n  height: 1px;\n\n  padding: 0;\n\n  margin: -1px;\n\n  overflow: hidden;\n\n  clip:\n    rect(0,0,0,0);\n\n  white-space: nowrap;\n\n  border: 0;\n\n}\n\n\n\n/* ==========================================================\n   DESKTOP HOVER\n========================================================== */\n\n@media (hover:hover) {\n\n  #offers-premium-{{ section.id }}\n  .op-card:hover\n  .op-media {\n\n    transform:\n      translateY(-6px)\n      scale(1.004);\n\n    border-color:\n      rgba(255,255,255,.19);\n\n    box-shadow:\n      0 26px 60px\n      rgba(0,0,0,.3);\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card:hover\n  .op-media img {\n\n    transform:\n      scale(1.025);\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card:hover\n  .op-hover-light {\n\n    opacity: 1;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card:hover\n  .op-arrow {\n\n    background:\n      var(--op-yellow);\n\n    border-color:\n      var(--op-yellow);\n\n    color:\n      #201022;\n\n    transform:\n      scale(1.055);\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card:hover\n  .op-arrow svg {\n\n    transform:\n      translateX(2px);\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   CLICK\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-card:active\n.op-media {\n\n  transform:\n    scale(.992);\n\n  transition-duration:\n    .15s;\n\n}\n\n\n\n/* ==========================================================\n   REVEAL\n========================================================== */\n\n#offers-premium-{{ section.id }}\n.op-reveal {\n\n  opacity: 0;\n\n  transform:\n    translate3d(\n      0,\n      22px,\n      0\n    );\n\n  transition:\n\n    opacity\n    .8s\n    cubic-bezier(.16,1,.3,1),\n\n    transform\n    .92s\n    cubic-bezier(.16,1,.3,1);\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-reveal.op-visible {\n\n  opacity: 1;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n\n}\n\n\n/* controlled stagger */\n\n#offers-premium-{{ section.id }}\n.op-card:nth-child(1) {\n\n  transition-delay:\n    .03s;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card:nth-child(2) {\n\n  transition-delay:\n    .08s;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card:nth-child(3) {\n\n  transition-delay:\n    .13s;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card:nth-child(4) {\n\n  transition-delay:\n    .08s;\n\n}\n\n\n#offers-premium-{{ section.id }}\n.op-card:nth-child(5) {\n\n  transition-delay:\n    .13s;\n\n}\n\n\n\n/* ==========================================================\n   TABLET\n========================================================== */\n\n@media\n(max-width: 900px) {\n\n  #offers-premium-{{ section.id }}\n  .op-container {\n\n    width:\n      calc(100% - 32px);\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-grid {\n\n    gap:\n      12px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   MOBILE\n========================================================== */\n\n@media\n(max-width: 749px) {\n\n\n  #offers-premium-{{ section.id }} {\n\n    padding:\n      56px 0\n      68px;\n\n  }\n\n\n\n  #offers-premium-{{ section.id }}\n  .op-container {\n\n    width:\n      calc(100% - 28px);\n\n  }\n\n\n\n  /* HEADER */\n\n  #offers-premium-{{ section.id }}\n  .op-header {\n\n    width:\n      calc(100% - 8px);\n\n    margin-bottom:\n      28px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-header h2 {\n\n    font-size:\n      clamp(\n        36px,\n        10.5vw,\n        47px\n      );\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-header p {\n\n    max-width:\n      300px;\n\n    margin-top:\n      13px;\n\n    font-size:\n      13px;\n\n  }\n\n\n\n  /* ====================================================\n     MOBILE GRID\n\n       01           02\n     ┌──────┐     ┌──────┐\n     │ B1G1 │     │RACKET│\n     └──────┘     └──────┘\n\n       03           04\n     ┌──────┐     ┌──────┐\n     │ SHOE │     │ DISC │\n     └──────┘     └──────┘\n\n     ┌────────────────────┐\n     │      T-SHIRT       │\n     └────────────────────┘\n  ==================================================== */\n\n  #offers-premium-{{ section.id }}\n  .op-grid {\n\n    display: grid;\n\n    grid-template-columns:\n      repeat(\n        2,\n        minmax(0,1fr)\n      );\n\n    gap:\n      10px;\n\n  }\n\n\n\n  #offers-premium-{{ section.id }}\n  .op-card--b1g1 {\n\n    grid-column:\n      1;\n\n    grid-row:\n      1;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card--racket {\n\n    grid-column:\n      2;\n\n    grid-row:\n      1;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card--shoe {\n\n    grid-column:\n      1;\n\n    grid-row:\n      2;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card--discount {\n\n    grid-column:\n      2;\n\n    grid-row:\n      2;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card--tshirt {\n\n    grid-column:\n      1 / -1;\n\n    grid-row:\n      3;\n\n  }\n\n\n\n  /* CARDS */\n\n  #offers-premium-{{ section.id }}\n  .op-card {\n\n    border-radius:\n      18px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-media {\n\n    border-radius:\n      18px;\n\n  }\n\n\n\n  /*\n     IMPORTANT:\n     Images continue using natural aspect ratio.\n     Nothing is cropped on mobile.\n  */\n\n  #offers-premium-{{ section.id }}\n  .op-media img {\n\n    width:\n      100%;\n\n    height:\n      auto;\n\n    object-fit:\n      contain;\n\n  }\n\n\n\n  /* MOBILE ARROW */\n\n  #offers-premium-{{ section.id }}\n  .op-arrow {\n\n    top:\n      10px;\n\n    right:\n      10px;\n\n    width:\n      30px;\n\n    height:\n      30px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-arrow svg {\n\n    width:\n      12px;\n\n    height:\n      12px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   SMALL MOBILE\n========================================================== */\n\n@media\n(max-width: 370px) {\n\n  #offers-premium-{{ section.id }}\n  .op-container {\n\n    width:\n      calc(100% - 20px);\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-grid {\n\n    gap:\n      8px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-card,\n  #offers-premium-{{ section.id }}\n  .op-media {\n\n    border-radius:\n      16px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-arrow {\n\n    width:\n      27px;\n\n    height:\n      27px;\n\n    top:\n      8px;\n\n    right:\n      8px;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-arrow svg {\n\n    width:\n      11px;\n\n    height:\n      11px;\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   AMBIENT MOTION\n========================================================== */\n\n@keyframes\nopAmbientOne {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        65px,\n        32px,\n        0\n      );\n\n  }\n\n}\n\n\n@keyframes\nopAmbientTwo {\n\n  from {\n\n    transform:\n      translate3d(\n        0,\n        0,\n        0\n      );\n\n  }\n\n  to {\n\n    transform:\n      translate3d(\n        -65px,\n        -30px,\n        0\n      );\n\n  }\n\n}\n\n\n\n/* ==========================================================\n   REDUCED MOTION\n========================================================== */\n\n@media\n(prefers-reduced-motion: reduce) {\n\n  #offers-premium-{{ section.id }} *,\n  #offers-premium-{{ section.id }} *::before,\n  #offers-premium-{{ section.id }} *::after {\n\n    animation:\n      none !important;\n\n    transition:\n      none !important;\n\n  }\n\n\n  #offers-premium-{{ section.id }}\n  .op-reveal {\n\n    opacity: 1;\n\n    transform: none;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  const section =\n    document.getElementById(\n      'offers-premium-{{ section.id }}'\n    );\n\n  if (!section) return;\n\n\n\n  /* ==========================================\n     REVEAL\n  ========================================== */\n\n  const revealItems =\n    section.querySelectorAll(\n      '.op-reveal'\n    );\n\n\n  const reducedMotion =\n    window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n\n  if (\n    !reducedMotion &&\n    'IntersectionObserver' in window\n  ) {\n\n    const observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (\n                !entry.isIntersecting\n              ) {\n                return;\n              }\n\n\n              entry.target\n                .classList\n                .add(\n                  'op-visible'\n                );\n\n\n              observer.unobserve(\n                entry.target\n              );\n\n            }\n          );\n\n        },\n\n        {\n          threshold:\n            .12,\n\n          rootMargin:\n            '0px 0px -24px 0px'\n        }\n\n      );\n\n\n    revealItems.forEach(\n      function (item) {\n\n        observer.observe(\n          item\n        );\n\n      }\n    );\n\n  }\n\n  else {\n\n    revealItems.forEach(\n      function (item) {\n\n        item.classList.add(\n          'op-visible'\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* ==========================================\n     SAME-PAGE SMOOTH SCROLL\n  ========================================== */\n\n  const links =\n    section.querySelectorAll(\n      '[data-offer-link]'\n    );\n\n\n  links.forEach(\n    function (link) {\n\n      link.addEventListener(\n        'click',\n        function (event) {\n\n          const href =\n            link.getAttribute(\n              'href'\n            );\n\n\n          if (\n            !href ||\n            href.charAt(0) !== '#'\n          ) {\n            return;\n          }\n\n\n          const target =\n            document.querySelector(\n              href\n            );\n\n\n          if (!target) {\n            return;\n          }\n\n\n          event.preventDefault();\n\n\n          const headerOffset =\n            90;\n\n\n          const position =\n            target\n              .getBoundingClientRect()\n              .top +\n            window.pageYOffset -\n            headerOffset;\n\n\n          window.scrollTo({\n\n            top:\n              position,\n\n            behavior:\n              reducedMotion\n                ? 'auto'\n                : 'smooth'\n\n          });\n\n        }\n      );\n\n    }\n  );\n\n})();\n\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
