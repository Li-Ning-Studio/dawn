      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hyper-title-section\">\n\n  <p class=\"hyper-kicker\">\nSUPPORTS</p>\n\n\n  <h2 class=\"second-title\">\n    <span class=\"free-gifts-highlight\">Stay supported. </span> Keep playing.\n    <br class=\"mobile-break\">\n  </h2>\n\n\n  \n\n\n</section>\n\n\n\n<style>\n\n\n.hyper-title-section{\n\n  text-align:center;\n\n  letter-spacing:0px;\n\n}\n\n\n\n.hyper-kicker{\n\n  font-size:1.4rem;\n\n  margin:0 0 10px;\n\n  color:rgba(255,255,255,.8);\n\n}\n\n\n\n.second-title {\n\n  letter-spacing:-1px;\n\n  font-size:3.3rem;\n\n  font-weight:800;\n\n  line-height:1.1;\n\n  margin:0;\n\n  background-image:\n\n  linear-gradient(\n    to right,\n    #c9f24d 0%,\n    #2fe0c2 50%,\n    #ff8a3d 100%\n  );\n\n  -webkit-background-clip:text;\n\n  background-clip:text;\n\n  -webkit-text-fill-color:transparent;\n\n  color:transparent;\n\n}\n\n\n\n.second-copy {\n\n  max-width:520px;\n\n  margin:20px auto 0;\n\n  color:rgba(255,255,255,.55);\n\n  font-size:1.05rem;\n\n  line-height:1.55;\n\n  font-weight:450;\n\n}\n\n\n\n.mobile-break{\n\n  display:none;\n\n}\n\n\n\n\n\n@media screen and (min-width:750px){\n\n\n.second-title{\n\n  font-size:5.9rem;\n\n}\n\n\n.second-copy{\n\n  font-size:1.2rem;\n\n}\n\n\n}\n\n\n\n\n\n@media screen and (max-width:750px){\n\n\n.hyper-title-section{\n\n  padding:0 16px;\n\n}\n\n\n\n.hyper-kicker{\n\n  font-size:1.2rem;\n\n}\n\n\n\n.second-title{\n\n\n  font-size:2.9rem;\n\n  line-height:1.08;\n\n  letter-spacing:-1.5px;\n\n  max-width:100%;\n\n}\n\n\n\n.mobile-break{\n\n  display:block;\n\n}\n\n\n\n.second-copy{\n\n\n  max-width:330px;\n\n  margin-top:18px;\n\n  font-size:.95rem;\n\n  line-height:1.45;\n\n}\n\n\n\n}\n\n</style>\n<style>\n#shopify-section-{{ section.id }} .second-title{background:none!important;color:#fff!important;-webkit-text-fill-color:#fff!important;}\n#shopify-section-{{ section.id }} .free-gifts-highlight{color:#f2ee38!important;-webkit-text-fill-color:#f2ee38!important;}\n</style>",
