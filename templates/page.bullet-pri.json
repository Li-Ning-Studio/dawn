    "custom_liquid_eXJLmf": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  NITRIX BULLET 80 — PRECISION HUNT + CONTINUOUS PRODUCT REVEAL\n  ----------------------------------------------------------------\n  Paste into ONE Shopify Custom Liquid section.\n\n  EXPERIENCE:\n  1. Desktop: the precision sight follows the mouse.\n  2. Mobile: drag the sight with one finger.\n  3. Hold the sight over the hidden racket to acquire it.\n  4. The racket is carried into the centre of Section 02.\n  5. Minimal Swiss specifications appear on both sides.\n\n  MEDIA:\n  Upload the background media and transparent racket PNG to Shopify Files,\n  then paste their CDN URLs below.\n\n  TARGET POSITION:\n  Adjust the four percentage values until the hidden racket sits exactly\n  where you want it in the hero environment.\n{%- endcomment -%}\n\n{%- liquid\n  assign b80_video_desktop = ''\n  assign b80_video_mobile = ''\n\n  assign b80_background_desktop = ''\n  assign b80_background_mobile = ''\n\n  assign b80_racket_png = ''\n\n  assign b80_product_url = '/products/nitrix-bullet-80'\n\n  assign b80_target_x_desktop = 73\n  assign b80_target_y_desktop = 43\n\n  assign b80_target_x_mobile = 67\n  assign b80_target_y_mobile = 36\n-%}\n\n<style>\n  #shopify-section-{{ section.id }} {\n    margin: 0 !important;\n    overflow: visible;\n  }\n\n  #shopify-section-{{ section.id }} .page-width,\n  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .b80-hunt,\n  .b80-hunt * {\n    box-sizing: border-box;\n  }\n\n  .b80-hunt {\n    --orange: #ffa400;\n    --black: #050505;\n    --paper: #f2efe7;\n    --ink: #101010;\n\n    --target-x: {{ b80_target_x_desktop }}%;\n    --target-y: {{ b80_target_y_desktop }}%;\n    --lock: 0;\n\n    position: relative;\n    width: 100%;\n    overflow: clip;\n    font-family: Figtree, var(--font-body-family), Arial, sans-serif;\n  }\n\n  .b80-hunt a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  /* ============================================================\n     SECTION 01 — SEARCH ENVIRONMENT\n  ============================================================ */\n\n  .b80-hunt__hero {\n    position: relative;\n    width: 100%;\n    min-height: 760px;\n    height: 100svh;\n    max-height: 1080px;\n    overflow: hidden;\n    isolation: isolate;\n    color: var(--paper);\n    background: var(--black);\n    cursor: none;\n    touch-action: none;\n  }\n\n  .b80-hunt__media,\n  .b80-hunt__fallback,\n  .b80-hunt__shade,\n  .b80-hunt__grain,\n  .b80-hunt__flash {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  .b80-hunt__media,\n  .b80-hunt__fallback {\n    z-index: 0;\n    overflow: hidden;\n    background: #080808;\n  }\n\n  .b80-hunt__media video,\n  .b80-hunt__media picture,\n  .b80-hunt__media img {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .b80-hunt__media video,\n  .b80-hunt__media img {\n    object-fit: cover;\n    object-position: center;\n    filter: grayscale(1) contrast(1.13) brightness(.55);\n    transform: scale(1.045);\n    transition:\n      filter .75s ease,\n      transform 1.1s cubic-bezier(.16, 1, .3, 1);\n    will-change: transform;\n  }\n\n  .b80-hunt__fallback {\n    background:\n      linear-gradient(90deg, transparent 0 49.8%, rgba(255,255,255,.04) 50%, transparent 50.2%),\n      linear-gradient(transparent 0 49.8%, rgba(255,255,255,.04) 50%, transparent 50.2%),\n      radial-gradient(circle at 73% 43%, rgba(255,164,0,.06), transparent 16%),\n      linear-gradient(132deg, #151515 0%, #070707 48%, #11100e 100%);\n  }\n\n  .b80-hunt__fallback::before,\n  .b80-hunt__fallback::after {\n    content: \"\";\n    position: absolute;\n    border: 1px solid rgba(255,255,255,.06);\n    transform: rotate(-17deg);\n  }\n\n  .b80-hunt__fallback::before {\n    top: 8%;\n    right: 8%;\n    width: 44%;\n    height: 72%;\n  }\n\n  .b80-hunt__fallback::after {\n    right: 25%;\n    bottom: -8%;\n    width: 56%;\n    height: 60%;\n  }\n\n  .b80-hunt__shade {\n    z-index: 1;\n    background:\n      linear-gradient(90deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.2) 46%, rgba(0,0,0,.26) 100%),\n      linear-gradient(180deg, rgba(0,0,0,.72) 0%, transparent 25%, transparent 60%, rgba(0,0,0,.84) 100%);\n  }\n\n  .b80-hunt__grain {\n    z-index: 2;\n    opacity: .11;\n    background-image:\n      url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E\");\n    mix-blend-mode: soft-light;\n  }\n\n  .b80-hunt__flash {\n    z-index: 10;\n    background: var(--paper);\n    opacity: 0;\n  }\n\n  .b80-hunt.is-found .b80-hunt__flash {\n    animation: b80-hunt-flash .42s ease forwards;\n  }\n\n  .b80-hunt.is-found .b80-hunt__media video,\n  .b80-hunt.is-found .b80-hunt__media img {\n    filter: grayscale(1) contrast(1.22) brightness(.34);\n    transform: scale(1.075);\n  }\n\n  .b80-hunt__chrome {\n    position: absolute;\n    z-index: 7;\n    top: clamp(24px, 3.4vw, 52px);\n    right: clamp(24px, 3.4vw, 52px);\n    left: clamp(24px, 3.4vw, 52px);\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    pointer-events: none;\n  }\n\n  .b80-hunt__brand {\n    display: grid;\n    gap: 8px;\n  }\n\n  .b80-hunt__brand strong {\n    font-size: 11px;\n    font-weight: 850;\n    line-height: 1;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__brand span,\n  .b80-hunt__code {\n    color: rgba(242,239,231,.44);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__instruction {\n    position: absolute;\n    z-index: 7;\n    bottom: clamp(30px, 4vw, 58px);\n    left: clamp(24px, 3.4vw, 52px);\n    max-width: 430px;\n    pointer-events: none;\n  }\n\n  .b80-hunt__instruction-index {\n    display: block;\n    margin-bottom: 15px;\n    color: var(--orange);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .18em;\n  }\n\n  .b80-hunt__instruction h1 {\n    max-width: 430px;\n    margin: 0;\n    font-family: Figtree, var(--font-heading-family), Arial, sans-serif;\n    font-size: clamp(40px, 4.6vw, 76px);\n    font-weight: 850;\n    line-height: .92;\n    letter-spacing: -.055em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__instruction p {\n    margin: 17px 0 0;\n    color: rgba(242,239,231,.55);\n    font-size: 10px;\n    font-weight: 650;\n    line-height: 1.5;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .b80-hunt__skip {\n    position: absolute;\n    z-index: 12;\n    right: clamp(24px, 3.4vw, 52px);\n    bottom: clamp(30px, 4vw, 58px);\n    padding: 7px 0;\n    border: 0;\n    border-bottom: 1px solid rgba(242,239,231,.28);\n    border-radius: 0;\n    color: rgba(242,239,231,.52);\n    background: transparent;\n    font: inherit;\n    font-size: 8px;\n    font-weight: 750;\n    line-height: 1;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: color .24s ease, border-color .24s ease;\n  }\n\n  .b80-hunt__skip:hover {\n    color: var(--paper);\n    border-color: var(--orange);\n  }\n\n  /* Hidden product target */\n\n  .b80-hunt__target {\n    position: absolute;\n    z-index: 5;\n    top: var(--target-y);\n    left: var(--target-x);\n    width: clamp(54px, 5vw, 82px);\n    height: clamp(168px, 19vh, 242px);\n    transform: translate(-50%, -50%) rotate(-8deg);\n    opacity: .14;\n    filter: grayscale(1) brightness(.5);\n    pointer-events: none;\n    transition:\n      opacity .28s ease,\n      filter .28s ease,\n      transform .38s cubic-bezier(.16, 1, .3, 1);\n  }\n\n  .b80-hunt.is-near .b80-hunt__target {\n   