    "custom_liquid_9bJQen": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  HNDRD / NITRIX BULLET 80 — PAGE ENTRY LOADER\n  ------------------------------------------------\n  Paste this as the FIRST Custom Liquid section on the landing page,\n  directly above the Bullet 80 hero section.\n \n  Behaviour:\n  - Runs once on every real page visit or browser refresh.\n  - Does not repeat while scrolling or clicking anchor links on this page.\n  - Locks scrolling while active.\n  - Waits for the page to load, while enforcing a short minimum display time.\n  - Wipes upward to reveal the hero.\n  - Pauses the Bullet 80 hero animations until the reveal begins.\n{%- endcomment -%}\n\n<script>\n  document.documentElement.classList.add('b80-page-loading');\n</script>\n\n<style>\n  html.b80-page-loading,\n  html.b80-page-loading body {\n    overflow: hidden !important;\n    overscroll-behavior: none;\n  }\n\n  /*\n    Pause the existing Bullet 80 hero entrance animations while\n    the loader is covering the page. They begin as the loader exits.\n  */\n  html.b80-page-loading .b80-villain *,\n  html.b80-page-loading .b80-villain *::before,\n  html.b80-page-loading .b80-villain *::after {\n    animation-play-state: paused !important;\n  }\n\n  .b80-entry-loader,\n  .b80-entry-loader * {\n    box-sizing: border-box;\n  }\n\n  .b80-entry-loader {\n    --loader-orange: #ffa400;\n    --loader-white: #f3f0e8;\n    --loader-black: #030303;\n\n    position: fixed;\n    z-index: 2147483647;\n    inset: 0;\n    width: 100%;\n    height: 100vh;\n    height: 100svh;\n    overflow: hidden;\n    isolation: isolate;\n    background: var(--loader-black);\n    color: var(--loader-white);\n    font-family: Figtree, var(--font-body-family), Arial, sans-serif;\n    opacity: 1;\n    visibility: visible;\n    clip-path: inset(0 0 0 0);\n    -webkit-clip-path: inset(0 0 0 0);\n    cursor: wait;\n    will-change: clip-path, opacity;\n  }\n\n  .b80-entry-loader::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    inset: 0;\n    opacity: .18;\n    background-image:\n      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);\n    background-size: clamp(56px, 6vw, 96px) clamp(56px, 6vw, 96px);\n    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 70%);\n    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 70%);\n  }\n\n  .b80-entry-loader::after {\n    content: \"\";\n    position: absolute;\n    z-index: 1;\n    top: 0;\n    bottom: 0;\n    left: clamp(18px, 3.1vw, 52px);\n    width: 2px;\n    background: var(--loader-orange);\n    transform: scaleY(0);\n    transform-origin: top;\n    box-shadow: 0 0 18px rgba(255,164,0,.28);\n  }\n\n  .b80-entry-loader.is-running::after {\n    animation: b80-loader-rail 1.35s cubic-bezier(.16,1,.3,1) .12s forwards;\n  }\n\n  .b80-entry-loader__meta {\n    position: absolute;\n    z-index: 4;\n    color: rgba(243,240,232,.42);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n    opacity: 0;\n  }\n\n  .b80-entry-loader__meta--top {\n    top: clamp(24px, 4vw, 54px);\n    left: clamp(34px, 5vw, 76px);\n  }\n\n  .b80-entry-loader__meta--bottom {\n    right: clamp(24px, 4vw, 54px);\n    bottom: clamp(24px, 4vw, 54px);\n    text-align: right;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__meta {\n    animation: b80-loader-meta .65s ease .42s forwards;\n  }\n\n  .b80-entry-loader__stage {\n    position: absolute;\n    z-index: 3;\n    inset: 0;\n    display: grid;\n    place-items: center;\n  }\n\n  .b80-entry-loader__mark {\n    position: relative;\n    width: clamp(210px, 19vw, 320px);\n    aspect-ratio: 194 / 104;\n    transform: translateY(-2%);\n  }\n\n  .b80-entry-loader__mark::before {\n    content: \"\";\n    position: absolute;\n    inset: -62%;\n    border-radius: 50%;\n    background: radial-gradient(\n      circle,\n      rgba(255,164,0,.105) 0%,\n      rgba(255,164,0,.03) 34%,\n      transparent 69%\n    );\n    opacity: 0;\n    transform: scale(.55);\n  }\n\n  .b80-entry-loader__mark::after {\n    content: \"\";\n    position: absolute;\n    z-index: 5;\n    left: -12%;\n    right: -12%;\n    bottom: -3%;\n    height: 2px;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.28) 20%,\n      #fff7e7 50%,\n      rgba(255,164,0,.8) 74%,\n      transparent\n    );\n    opacity: 0;\n    transform: translateY(0) scaleX(.35);\n    box-shadow:\n      0 0 18px rgba(255,164,0,.42),\n      0 0 42px rgba(255,164,0,.14);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__mark::after {\n    animation: b80-loader-scan-up 1.02s cubic-bezier(.3,.7,.2,1) .84s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__mark::before {\n    animation: b80-loader-aura 1.35s ease .72s forwards;\n  }\n\n  .b80-entry-loader__svg {\n    position: relative;\n    z-index: 3;\n    display: block;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n\n  .b80-entry-loader__outline {\n    fill: none;\n    stroke: rgba(243,240,232,.78);\n    stroke-width: 1.15;\n    stroke-linecap: square;\n    stroke-linejoin: miter;\n    vector-effect: non-scaling-stroke;\n    stroke-dasharray: 420;\n    stroke-dashoffset: 420;\n    opacity: 0;\n    clip-path: inset(100% 0 0 0);\n    -webkit-clip-path: inset(100% 0 0 0);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__outline {\n    animation: b80-loader-outline-rise 1.08s cubic-bezier(.16,1,.3,1) .24s forwards;\n  }\n\n  .b80-entry-loader__fill {\n    fill: var(--loader-orange);\n    opacity: 0;\n    clip-path: inset(100% 0 0 0);\n    -webkit-clip-path: inset(100% 0 0 0);\n    filter:\n      drop-shadow(0 0 14px rgba(255,164,0,.22))\n      drop-shadow(0 0 34px rgba(255,164,0,.08));\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fill {\n    animation: b80-loader-fill-rise .92s cubic-bezier(.16,1,.3,1) .82s forwards;\n  }\n\n  .b80-entry-loader__fragment {\n    position: absolute;\n    z-index: 2;\n    display: block;\n    width: clamp(12px, 1.2vw, 19px);\n    height: 1px;\n    background: rgba(243,240,232,.74);\n    opacity: 0;\n    transform: scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(2) {\n    top: 7%;\n    left: 43%;\n    transform: rotate(90deg) scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(3) {\n    top: 27%;\n    left: -8%;\n    transform: rotate(18deg) scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(4) {\n    top: 63%;\n    left: -14%;\n    transform: rotate(-18deg) scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(5) {\n    top: 22%;\n    right: -9%;\n    transform: rotate(-17deg) scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(6) {\n    top: 68%;\n    right: -13%;\n    transform: rotate(17deg) scaleX(.15);\n  }\n\n  .b80-entry-loader__fragment:nth-child(7) {\n    right: 44%;\n    bottom: 1%;\n    transform: rotate(90deg) scaleX(.15);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(2) {\n    animation: b80-fragment-a .58s ease .30s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(3) {\n    animation: b80-fragment-b .62s ease .40s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(4) {\n    animation: b80-fragment-c .62s ease .54s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(5) {\n    animation: b80-fragment-d .62s ease .45s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(6) {\n    animation: b80-fragment-e .62s ease .60s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fragment:nth-child(7) {\n    animation: b80-fragment-f .58s ease .35s forwards;\n  }\n\n  .b80-entry-loader__slash {\n    position: absolute;\n    z-index: 1;\n    top: 50%;\n    left: 50%;\n    width: min(52vw, 740px);\n    height: 1px;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.06) 25%,\n      rgba(255,164,0,.72) 50%,\n      rgba(255,255,255,.06) 75%,\n      transparent\n    );\n    opacity: 0;\n    transform: translate(-50%, -50%) rotate(-8deg) scaleX(.1);\n    box-shadow: 0 0 20px rgba(255,164,0,.15);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__slash {\n    animation: b80-loader-slash .72s cubic-bezier(.16,1,.3,1) 1.38s forwards;\n  }\n\n  .b80-entry-loader__caption {\n    position: absolute;\n    z-index: 4;\n    top: calc(50% + clamp(62px, 7vw, 104px));\n    left: 50%;\n    margin: 0;\n    color: rgba(243,240,232,.46);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .3em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    opacity: 0;\n    transform: translateX(-50%) translateY(8px);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__caption {\n    animation: b80-loader-caption .6s ease 1.23s forwards;\n  }\n\n  /*\n    Exit follows the reference: the black loader lifts from\n    the bottom edge towards the top and exposes the hero below.\n  */\n  .b80-entry-loader.is-leaving {\n    cursor: default;\n    animation: b80-loader-exit .95s cubic-bezier(.76,0,.24,1) forwards;\n  }\n\n  .b80-entry-loader.is-leaving .b80-entry-loader__stage,\n  .b80-entry-loader.is-leaving .b80-entry-loader__meta {\n    animation: b80-loader-content-out .28s ease forwards;\n  }\n\n  @keyframes b80-loader-rail {\n    0% {\n      transform: scaleY(0);\n      transform-origin: top;\n    }\n    54% {\n      transform: scaleY(1);\n      transform-origin: top;\n    }\n    55% {\n      transform: scaleY(1);\n      transform-origin: bottom;\n    }\n    100% {\n      transform: scaleY(0);\n      transform-origin: bottom;\n    }\n  }\n\n  @keyframes b80-loader-meta {\n    from {\n      opacity: 0;\n      transform: translateY(8px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes b80-loader-aura {\n    from {\n      opacity: 0;\n      transform: scale(.55);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  @keyframes b80-loader-outline-rise {\n    0% {\n      opacity: 0;\n      stroke-dashoffset: 420;\n      clip-path: inset(100% 0 0 0);\n      -webkit-clip-path: inset(100% 0 0 0);\n    }\n    18% {\n      opacity: .86;\n    }\n    100% {\n      opacity: .72;\n      stroke-dashoffset: 0;\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n  }\n\n  @keyframes b80-loader-fill-rise {\n    0% {\n      opacity: 0;\n      clip-path: inset(100% 0 0 0);\n      -webkit-clip-path: inset(100% 0 0 0);\n    }\n    10% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 1;\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n  }\n\n  @keyframes b80-loader-scan-up {\n    0% {\n      opacity: 0;\n      transform: translateY(0) scaleX(.35);\n    }\n    18% {\n      opacity: 1;\n    }\n    72% {\n      opacity: .85;\n    }\n    100% {\n      opacity: 0;\n      transform: translateY(calc(-1 * clamp(112px, 10.5vw, 172px))) scaleX(1);\n    }\n  }\n\n  @keyframes b80-fragment-a {\n    0% { opacity: 0; transform: translateY(-17px) rotate(90deg) scaleX(.15); }\n    55% { opacity: .78; transform: translateY(0) rotate(90deg) scaleX(1); }\n    100% { opacity: 0; transform: translateY(10px) rotate(90deg) scaleX(.25); }\n  }\n\n  @keyframes b80-fragment-b {\n    0% { opacity: 0; transform: translateX(-19px) rotate(18deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(18deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(11px) rotate(18deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-c {\n    0% { opacity: 0; transform: translateX(-18px) rotate(-18deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(-18deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(10px) rotate(-18deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-d {\n    0% { opacity: 0; transform: translateX(19px) rotate(-17deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(-17deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(-10px) rotate(-17deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-e {\n    0% { opacity: 0; transform: translateX(18px) rotate(17deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(17deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(-10px) rotate(17deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-f {\n    0% { opacity: 0; transform: translateY(17px) rotate(90deg) scaleX(.15); }\n    55% { opacity: .78; transform: translateY(0) rotate(90deg) scaleX(1); }\n    100% { opacity: 0; transform: translateY(-10px) rotate(90deg) scaleX(.25); }\n  }\n\n  @keyframes b80-loader-slash {\n    0% {\n      opacity: 0;\n      transform: translate(-50%, -50%) rotate(-8deg) scaleX(.1);\n    }\n    30% {\n      opacity: 1;\n    }\n    100% {\n      opacity: .38;\n      transform: translate(-50%, -50%) rotate(-8deg) scaleX(1);\n    }\n  }\n\n  @keyframes b80-loader-caption {\n    from {\n      opacity: 0;\n      transform: translateX(-50%) translateY(8px);\n    }\n    to {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n  }\n\n  @keyframes b80-loader-content-out {\n    to {\n      opacity: 0;\n      transform: translateY(-12px);\n    }\n  }\n\n  @keyframes b80-loader-exit {\n    0% {\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n    100% {\n      clip-path: inset(0 0 100% 0);\n      -webkit-clip-path: inset(0 0 100% 0);\n    }\n  }\n\n  @media (max-width: 749px) {\n    .b80-entry-loader::after {\n      left: 18px;\n    }\n\n    .b80-entry-loader__meta {\n      font-size: 7px;\n      letter-spacing: .17em;\n    }\n\n    .b80-entry-loader__meta--top {\n      top: 24px;\n      left: 34px;\n    }\n\n    .b80-entry-loader__meta--bottom {\n      right: 20px;\n      bottom: 22px;\n    }\n\n    .b80-entry-loader__mark {\n      width: clamp(175px, 52vw, 238px);\n    }\n\n    .b80-entry-loader__slash {\n      width: 82vw;\n    }\n\n    .b80-entry-loader__caption {\n      top: calc(50% + 70px);\n      font-size: 7px;\n      letter-spacing: .24em;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .b80-entry-loader.is-running .b80-entry-loader__outline {\n      animation-duration: .25s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__fill {\n      animation-delay: .18s;\n      animation-duration: .25s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__mark::after {\n      animation-duration: .2s;\n      animation-delay: .1s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__fragment,\n    .b80-entry-loader.is-running .b80-entry-loader__slash,\n    .b80-entry-loader.is-running .b80-entry-loader__caption,\n    .b80-entry-loader.is-running .b80-entry-loader__meta,\n    .b80-entry-loader.is-running::after {\n      animation-duration: .01ms !important;\n      animation-delay: 0s !important;\n    }\n\n    .b80-entry-loader.is-leaving {\n      animation-duration: .35s;\n    }\n  }\n</style>\n\n<div\n  class=\"b80-entry-loader\"\n  data-b80-entry-loader\n  aria-hidden=\"true\"\n>\n  <span class=\"b80-entry-loader__meta b80-entry-loader__meta--top\">\n    HNDRD Performance\n  </span>\n\n  <div class=\"b80-entry-loader__stage\">\n    <div class=\"b80-entry-loader__mark\">\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n\n      <svg\n        class=\"b80-entry-loader__svg\"\n        viewBox=\"0 0 194 104\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        focusable=\"false\"\n      >\n        <!-- Exact geometry traced from the supplied HNDRD mark -->\n        <path\n          class=\"b80-entry-loader__outline\"\n          d=\"M150 31L110 34L31 73L56 73L89 56L124 73L148 73L102 50Z\"\n        />\n        <path\n          class=\"b80-entry-loader__fill\"\n          d=\"M150 31L110 34L31 73L56 73L89 56L124 73L148 73L102 50Z\"\n        />\n      </svg>\n    </div>\n\n    <span class=\"b80-entry-loader__slash\"></span>\n\n    <p class=\"b80-entry-loader__caption\">\n      Nitrix Bullet 80\n    </p>\n  </div>\n\n  <span class=\"b80-entry-loader__meta b80-entry-loader__meta--bottom\">\n    B80 / 5.8 / Pro Attack\n  </span>\n</div>\n\n<noscript>\n  <style>\n    .b80-entry-loader {\n      display: none !important;\n    }\n  </style>\n</noscript>\n\n<script>\n  (function () {\n    var loader = document.querySelector('[data-b80-entry-loader]');\n\n    if (!loader || loader.dataset.initialised === 'true') {\n      return;\n    }\n\n    loader.dataset.initialised = 'true';\n\n    var reducedMotion = window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n    /*\n      Desktop and mobile use the same sequence.\n      Reduced-motion users get a shorter, simpler version.\n    */\n    var minimumTime = reducedMotion ? 450 : 2700;\n    var maximumTime = reducedMotion ? 1100 : 5600;\n    var exitTime = reducedMotion ? 380 : 980;\n    var startTime = performance.now();\n    var hasExited = false;\n    var pageReady = document.readyState === 'complete';\n\n    requestAnimationFrame(function () {\n      loader.classList.add('is-running');\n    });\n\n    function unlockPage() {\n      document.documentElement.classList.remove('b80-page-loading');\n\n      if (document.body) {\n        document.body.classList.remove('b80-page-loading');\n      }\n    }\n\n    function beginExit() {\n      if (hasExited) {\n        return;\n      }\n\n      hasExited = true;\n      loader.classList.add('is-leaving');\n\n      /*\n        Start the hero entrance animation underneath the upward wipe.\n      */\n      window.setTimeout(unlockPage, reducedMotion ? 0 : 110);\n\n      window.dispatchEvent(\n        new CustomEvent('b80:loader-exit')\n      );\n\n      window.setTimeout(function () {\n        loader.remove();\n      }, exitTime + 100);\n    }\n\n    function exitWhenAllowed() {\n      var elapsed = performance.now() - startTime;\n      var remaining = Math.max(0, minimumTime - elapsed);\n\n      window.setTimeout(beginExit, remaining);\n    }\n\n    if (pageReady) {\n      exitWhenAllowed();\n    } else {\n      window.addEventListener(\n        'load',\n        function () {\n          pageReady = true;\n          exitWhenAllowed();\n        },\n        { once: true }\n      );\n    }\n\n    /*\n      Safety fallback: a failed external asset can never trap\n      the visitor behind the loader.\n    */\n    window.setTimeout(beginExit, maximumTime);\n\n    /*\n      Shopify's editor can reload sections without reloading the page.\n      Remove any injected duplicate immediately.\n    */\n    document.addEventListener(\n      'shopify:section:load',\n      function (event) {\n        var duplicate = event.target.querySelector(\n          '[data-b80-entry-loader]'\n        );\n\n        if (duplicate && duplicate !== loader) {\n          duplicate.remove();\n        }\n      }\n    );\n  })();\n</script>",
