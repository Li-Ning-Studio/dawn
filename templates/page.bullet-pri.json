elf: stretch;\n    }\n\n    .b80-object__racket {\n      width: min(68vw, 300px);\n      height: min(55vh, 500px);\n    }\n\n    .b80-object__halo {\n      width: min(84vw, 380px);\n    }\n\n    .b80-object__specs {\n      grid-row: 2;\n      gap: 32px;\n    }\n\n    .b80-object__specs--left {\n      grid-column: 1;\n      text-align: left;\n    }\n\n    .b80-object__specs--right {\n      grid-column: 2;\n      text-align: left;\n    }\n\n    .b80-object__specs--left .b80-object__spec-line {\n      margin-left: 0;\n    }\n\n    .b80-object__spec strong {\n      font-size: 18px;\n    }\n\n    .b80-object__spec small {\n      font-size: 7px;\n      letter-spacing: .1em;\n    }\n\n    .b80-object__spec-line {\n      width: 42px;\n    }\n\n    .b80-object__identity {\n      bottom: 58px;\n    }\n\n    .b80-object__identity h2 {\n      font-size: clamp(28px, 8.5vw, 39px);\n    }\n\n    .b80-object__identity p {\n      font-size: 7px;\n      letter-spacing: .11em;\n    }\n\n    .b80-object__cta {\n      right: 18px;\n      bottom: 24px;\n      font-size: 7px;\n    }\n  }\n\n  @keyframes b80-acquired-mobile {\n    from {\n      opacity: 0;\n      transform: translate(-50%, calc(-50% + 108px));\n    }\n    to {\n      opacity: 1;\n      transform: translate(-50%, calc(-50% + 92px));\n    }\n  }\n\n  @media (pointer: coarse) {\n    .b80-hunt__hero {\n      cursor: default;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .b80-hunt *,\n    .b80-hunt *::before,\n    .b80-hunt *::after {\n      animation-duration: .001ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: .001ms !important;\n    }\n  }\n</style>\n\n<div\n  class=\"b80-hunt\"\n  data-b80-hunt\n  data-target-x-desktop=\"{{ b80_target_x_desktop }}\"\n  data-target-y-desktop=\"{{ b80_target_y_desktop }}\"\n  data-target-x-mobile=\"{{ b80_target_x_mobile }}\"\n  data-target-y-mobile=\"{{ b80_target_y_mobile }}\"\n>\n  <!-- =========================================================\n       SECTION 01 / FIND THE RACKET\n  ========================================================== -->\n  <section\n    class=\"b80-hunt__hero\"\n    data-b80-hunt-hero\n    aria-label=\"Locate the Nitrix Bullet 80\"\n  >\n    {% if b80_video_desktop != blank or b80_video_mobile != blank %}\n      <div class=\"b80-hunt__media\" aria-hidden=\"true\">\n        <video\n          data-b80-hunt-video\n          autoplay\n          muted\n          loop\n          playsinline\n          preload=\"metadata\"\n          {% if b80_background_desktop != blank or b80_background_mobile != blank %}\n            poster=\"{{ b80_background_desktop | default: b80_background_mobile }}\"\n          {% endif %}\n        >\n          {% if b80_video_mobile != blank %}\n            <source\n              media=\"(max-width: 749px)\"\n              src=\"{{ b80_video_mobile }}\"\n              type=\"video/mp4\"\n            >\n          {% endif %}\n\n          <source\n            src=\"{{ b80_video_desktop | default: b80_video_mobile }}\"\n            type=\"video/mp4\"\n          >\n        </video>\n      </div>\n\n    {% elsif b80_background_desktop != blank or b80_background_mobile != blank %}\n      <div class=\"b80-hunt__media\" aria-hidden=\"true\">\n        <picture>\n          {% if b80_background_mobile != blank %}\n            <source\n              media=\"(max-width: 749px)\"\n              srcset=\"{{ b80_background_mobile }}\"\n            >\n          {% endif %}\n\n          <img\n            data-b80-hunt-background\n            src=\"{{ b80_background_desktop | default: b80_background_mobile }}\"\n            alt=\"\"\n            width=\"2400\"\n            height=\"1600\"\n            loading=\"eager\"\n            fetchpriority=\"high\"\n            decoding=\"async\"\n          >\n        </picture>\n      </div>\n\n    {% else %}\n      <div class=\"b80-hunt__fallback\" aria-hidden=\"true\"></div>\n    {% endif %}\n\n    <div class=\"b80-hunt__shade\" aria-hidden=\"true\"></div>\n    <div class=\"b80-hunt__grain\" aria-hidden=\"true\"></div>\n    <div class=\"b80-hunt__flash\" aria-hidden=\"true\"></div>\n\n    <div class=\"b80-hunt__chrome\">\n      <div class=\"b80-hunt__brand\">\n        <strong>Nitrix Bullet 80</strong>\n        <span>Precision attack system</span>\n      </div>\n\n      <span class=\"b80-hunt__code\">\n        Search field / B80\n      </span>\n    </div>\n\n    <div class=\"b80-hunt__instruction\">\n      <span class=\"b80-hunt__instruction-index\">01 / ACQUIRE</span>\n\n      <h1>Find what ends the point.</h1>\n\n      <p data-b80-instruction>\n        Move the sight. Hold to acquire.\n      </p>\n    </div>\n\n    <button\n      class=\"b80-hunt__skip\"\n      type=\"button\"\n      data-b80-skip\n      aria-label=\"Skip the search and reveal Bullet 80\"\n    >\n      Skip search\n    </button>\n\n    <div\n      class=\"b80-hunt__target\"\n      data-b80-target\n      aria-hidden=\"true\"\n    >\n      <div class=\"b80-racket-art\" data-b80-target-art>\n        {% if b80_racket_png != blank %}\n          <img\n            src=\"{{ b80_racket_png }}\"\n            alt=\"\"\n            width=\"500\"\n            height=\"1500\"\n            loading=\"eager\"\n            fetchpriority=\"high\"\n            decoding=\"async\"\n          >\n        {% else %}\n          <!-- Lightweight fallback until the final transparent PNG is added -->\n          <svg viewBox=\"0 0 180 620\" xmlns=\"http://www.w3.org/2000/svg\">\n            <ellipse cx=\"90\" cy=\"112\" rx=\"68\" ry=\"96\" fill=\"none\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n            <ellipse cx=\"90\" cy=\"112\" rx=\"56\" ry=\"83\" fill=\"none\" stroke=\"rgba(255,255,255,.28)\" stroke-width=\"2\"/>\n            <path d=\"M90 207V493\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n            <path d=\"M70 493H110V608H70Z\" fill=\"#111\"/>\n            <path d=\"M76 500L104 600M104 500L76 600\" stroke=\"rgba(255,164,0,.55)\" stroke-width=\"4\"/>\n          </svg>\n        {% endif %}\n      </div>\n    </div>\n\n    <div class=\"b80-sight\" data-b80-sight aria-hidden=\"true\">\n      <span class=\"b80-sight__axis b80-sight__axis--x\"></span>\n      <span class=\"b80-sight__axis b80-sight__axis--y\"></span>\n\n      <span class=\"b80-sight__core\"></span>\n      <span class=\"b80-sight__diamond\"></span>\n\n      <svg class=\"b80-sight__progress\" viewBox=\"0 0 80 80\">\n        <circle\n          data-b80-lock-ring\n          cx=\"40\"\n          cy=\"40\"\n          r=\"36\"\n        />\n      </svg>\n\n      <span class=\"b80-sight__readout\" data-b80-readout>\n        Searching / 00\n      </span>\n    </div>\n\n    <div class=\"b80-hunt__acquired\" aria-hidden=\"true\">\n      <strong>Bullet 80 locked</strong>\n      <span>Object acquired / moving to inspection</span>\n    </div>\n  </section>\n\n  <!-- =========================================================\n       SECTION 02 / CENTRED PRODUCT + MINIMAL SPECIFICATIONS\n  ========================================================== -->\n  <section\n    class=\"b80-object\"\n    id=\"b80-object-{{ section.id }}\"\n    data-b80-object\n    aria-labelledby=\"b80-object-title-{{ section.id }}\"\n  >\n    <div class=\"b80-object__top\">\n      <span class=\"b80-object__eyebrow\">\n        02 / THE OBJECT\n      </span>\n\n      <span class=\"b80-object__serial\">\n        B80 / Professional attack\n      </span>\n    </div>\n\n    <div class=\"b80-object__layout\">\n      <div class=\"b80-object__specs b80-object__specs--left\">\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">01</span>\n          <strong>5.8 mm</strong>\n          <small>Thin shaft profile</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">02</span>\n          <strong>Attack</strong>\n          <small>Playing intention</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n      </div>\n\n      <div class=\"b80-object__centre\">\n        <span class=\"b80-object__halo\" aria-hidden=\"true\"></span>\n\n        <div\n          class=\"b80-object__racket b80-racket-art\"\n          data-b80-destination-art\n        >\n          {% if b80_racket_png != blank %}\n            <img\n              src=\"{{ b80_racket_png }}\"\n              alt=\"Nitrix Bullet 80 badminton racket\"\n              width=\"700\"\n              height=\"1900\"\n              loading=\"eager\"\n              decoding=\"async\"\n            >\n          {% else %}\n            <svg\n              viewBox=\"0 0 180 620\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              role=\"img\"\n              aria-label=\"Nitrix Bullet 80 racket placeholder\"\n            >\n              <ellipse cx=\"90\" cy=\"112\" rx=\"68\" ry=\"96\" fill=\"none\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n              <ellipse cx=\"90\" cy=\"112\" rx=\"56\" ry=\"83\" fill=\"none\" stroke=\"rgba(16,16,16,.18)\" stroke-width=\"2\"/>\n              <path d=\"M90 207V493\" stroke=\"#ffa400\" stroke-width=\"8\"/>\n              <path d=\"M70 493H110V608H70Z\" fill=\"#111\"/>\n              <path d=\"M76 500L104 600M104 500L76 600\" stroke=\"rgba(255,164,0,.55)\" stroke-width=\"4\"/>\n            </svg>\n          {% endif %}\n        </div>\n      </div>\n\n      <div class=\"b80-object__specs b80-object__specs--right\">\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">03</span>\n          <strong>Professional</strong>\n          <small>Player level</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n\n        <div class=\"b80-object__spec\">\n          <span class=\"b80-object__spec-index\">04</span>\n          <strong>B80</strong>\n          <small>Nitrix performance code</small>\n          <span class=\"b80-object__spec-line\"></span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"b80-object__identity\">\n      <h2 id=\"b80-object-title-{{ section.id }}\">\n        Built to end the point.\n      </h2>\n\n      <p>\n        Nitrix Bullet 80 / Thin shaft / Professional attack\n      </p>\n    </div>\n\n    <a class=\"b80-object__cta\" href=\"{{ b80_product_url }}\">\n      <span>Choose Bullet 80</span>\n\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M5 12h13\"></path>\n        <path d=\"m13 6 6 6-6 6\"></path>\n      </svg>\n    </a>\n  </section>\n</div>\n\n<script>\n  (function () {\n    function initB80Hunt(scope) {\n      var roots = (scope || document).querySelectorAll(\n        '[data-b80-hunt]:not([data-b80-hunt-ready])'\n      );\n\n      roots.forEach(function (root) {\n        root.setAttribute('data-b80-hunt-ready', 'true');\n\n        var hero = root.querySelector('[data-b80-hunt-hero]');\n        var sight = root.querySelector('[data-b80-sight]');\n        var target = root.querySelector('[data-b80-target]');\n        var targetArt = root.querySelector('[data-b80-target-art]');\n        var destination = root.querySelector('[data-b80-destination-art]');\n        var objectSection = root.querySelector('[data-b80-object]');\n        var ring = root.querySelector('[data-b80-lock-ring]');\n        var readout = root.querySelector('[data-b80-readout]');\n        var instruction = root.querySelector('[data-b80-instruction]');\n        var skip = root.querySelector('[data-b80-skip]');\n        var media = root.querySelector(\n          '[data-b80-hunt-background], [data-b80-hunt-video]'\n        );\n\n        if (\n          !hero ||\n          !sight ||\n          !target ||\n          !targetArt ||\n          !destination ||\n          !objectSection\n        ) {\n          return;\n        }\n\n        var reducedMotion = window.matchMedia(\n          '(prefers-reduced-motion: reduce)'\n        ).matches;\n\n        var coarsePointer = window.matchMedia(\n          '(pointer: coarse)'\n        ).matches;\n\n        var state = {\n          x: hero.clientWidth * 0.5,\n          y: hero.clientHeight * 0.5,\n          targetX: hero.clientWidth * 0.5,\n          targetY: hero.clientHeight * 0.5,\n          previousTime: performance.now(),\n          focusTime: 0,\n          requiredFocus: coarsePointer ? 470 : 620,\n          radius: coarsePointer ? 74 : 48,\n          found: false,\n          dragging: false,\n          transitionStarted: false\n        };\n\n        if (instruction && coarsePointer) {\n          instruction.textContent =\n            'Drag the sight. Hold to acquire.';\n        }\n\n        function clamp(value, min, max) {\n          return Math.max(min, Math.min(max, value));\n        }\n\n        function easeInOutCubic(value) {\n          return value < 0.5\n            ? 4 * value * value * value\n            : 1 - Math.pow(-2 * value + 2, 3) / 2;\n        }\n\n        function setDesiredPoint(clientX, clientY) {\n          if (state.found) {\n            return;\n          }\n\n          var rect = hero.getBoundingClientRect();\n\n          state.targetX = clamp(\n            clientX - rect.left,\n            0,\n            rect.width\n          );\n\n          state.targetY = clamp(\n            clientY - rect.top,\n            0,\n            rect.height\n          );\n        }\n\n        function getTargetPoint() {\n          var heroRect = hero.getBoundingClientRect();\n          var targetRect = target.getBoundingClientRect();\n\n          return {\n            x:\n              targetRect.left -\n              heroRect.left +\n              targetRect.width / 2,\n            y:\n              targetRect.top -\n              heroRect.top +\n              targetRect.height / 2\n          };\n        }\n\n        function setRingProgress(progress) {\n          var normalised = clamp(progress, 0, 1);\n          var dashOffset = 226 - (226 * normalised);\n\n          if (ring) {\n            ring.style.strokeDashoffset =\n              dashOffset.toFixed(2);\n          }\n\n          if (readout && !state.found) {\n            readout.textContent =\n              normalised > 0\n                ? 'Acquiring / ' +\n                  String(Math.round(normalised * 100))\n                    .padStart(2, '0')\n                : 'Searching / 00';\n          }\n        }\n\n        function updateSight(time) {\n          var dt = Math.min(\n            40,\n            Math.max(0, time - state.previousTime)\n          );\n\n          state.previousTime = time;\n\n          var easing = reducedMotion ? 1 : 0.17;\n\n          state.x += (state.targetX - state.x) * easing;\n          state.y += (state.targetY - state.y) * easing;\n\n          sight.style.transform =\n            'translate3d(' +\n            (state.x - sight.offsetWidth / 2) +\n            'px,' +\n            (state.y - sight.offsetHeight / 2) +\n            'px,0)';\n\n          if (media && !state.found && !coarsePointer) {\n            var px =\n              (state.x / Math.max(1, hero.clientWidth) - 0.5) *\n              -10;\n\n            var py =\n              (state.y / Math.max(1, hero.clientHeight) - 0.5) *\n              -7;\n\n            media.style.transform =\n              'scale(1.055) translate3d(' +\n              px.toFixed(2) +\n              'px,' +\n              py.toFixed(2) +\n              'px,0)';\n          }\n\n          if (!state.found) {\n            var targetPoint = getTargetPoint();\n            var dx = state.x - targetPoint.x;\n            var dy = state.y - targetPoint.y;\n            var distance = Math.sqrt(dx * dx + dy * dy);\n            var isNear = distance <= state.radius;\n\n            root.classList.toggle('is-near', isNear);\n\n            if (isNear) {\n              state.focusTime += dt;\n            } else {\n              state.focusTime = Math.max(\n                0,\n                state.focusTime - dt * 2.25\n              );\n            }\n\n            var progress =\n              state.focusTime / state.requiredFocus;\n\n            setRingProgress(progress);\n\n            if (progress >= 1) {\n              acquireTarget();\n            }\n          }\n\n          requestAnimationFrame(updateSight);\n        }\n\n        function acquireTarget() {\n          if (state.found) {\n            return;\n          }\n\n          state.found = true;\n\n          var targetPoint = getTargetPoint();\n\n          state.targetX = targetPoint.x;\n          state.targetY = targetPoint.y;\n\n          root.classList.remove('is-near');\n          root.classList.add('is-found');\n\n          setRingProgress(1);\n\n          if (readout) {\n            readout.textContent = 'Bullet 80 / Locked';\n          }\n\n          window.setTimeout(\n            moveRacketToSection,\n            reducedMotion ? 140 : 900\n          );\n        }\n\n        function moveRacketToSection() {\n          if (state.transitionStarted) {\n            return;\n          }\n\n          state.transitionStarted = true;\n\n          if (reducedMotion) {\n            objectSection.scrollIntoView({\n              behavior: 'auto',\n              block: 'start'\n            });\n\n            destination.removeAttribute('aria-hidden');\n            objectSection.classList.add('is-revealed');\n            return;\n          }\n\n          var startRect = targetArt.getBoundingClientRect();\n          var clone = targetArt.cloneNode(true);\n\n          clone.classList.add('b80-flight-racket');\n\n          clone.style.left = startRect.left + 'px';\n          clone.style.top = startRect.top + 'px';\n          clone.style.width = startRect.width + 'px';\n          clone.style.height = startRect.height + 'px';\n\n          document.body.appendChild(clone);\n\n          targetArt.style.opacity = '0';\n          destination.setAttribute('aria-hidden', 'true');\n\n          var viewportWidth = window.innerWidth;\n          var viewportHeight = window.innerHeight;\n\n          var desiredHeight = Math.min(\n            viewportHeight * (viewportWidth < 750 ? 0.55 : 0.72),\n            viewportWidth < 750 ? 500 : 720\n          );\n\n          var scale = desiredHeight / Math.max(1, startRect.height);\n\n          var startCenterX =\n            startRect.left + startRect.width / 2;\n\n          var startCenterY =\n            startRect.top + startRect.height / 2;\n\n          var endCenterX = viewportWidth / 2;\n          var endCenterY = viewportHeight / 2;\n\n          var moveX = endCenterX - startCenterX;\n          var moveY = endCenterY - startCenterY;\n\n          var startScroll = window.scrollY;\n          var targetScroll =\n            objectSection.getBoundingClientRect().top +\n            window.scrollY;\n\n          var duration = 1250;\n          var startedAt = performance.now();\n\n          function animateTransition(now) {\n            var elapsed = now - startedAt;\n            var rawProgress = clamp(\n              elapsed / duration,\n              0,\n              1\n            );\n\n            var progress = easeInOutCubic(rawProgress);\n\n            window.scrollTo(\n              0,\n              startScroll +\n                (targetScroll - startScroll) * progress\n            );\n\n            clone.style.transform =\n              'translate3d(' +\n              (moveX * progress).toFixed(2) +\n              'px,' +\n              (moveY * progress).toFixed(2) +\n              'px,0) ' +\n              'scale(' +\n              (1 + (scale - 1) * progress).toFixed(4) +\n              ') ' +\n              'rotate(' +\n              (-2 * progress).toFixed(2) +\n              'deg)';\n\n            clone.style.opacity =\n              String(1 - Math.max(0, rawProgress - .91) / .09);\n\n            if (rawProgress < 1) {\n              requestAnimationFrame(animateTransition);\n              return;\n            }\n\n            destination.removeAttribute('aria-hidden');\n            objectSection.classList.add('is-revealed');\n            clone.remove();\n\n            window.setTimeout(function () {\n              targetArt.style.opacity = '';\n            }, 150);\n          }\n\n          requestAnimationFrame(animateTransition);\n        }\n\n        hero.addEventListener(\n          'pointermove',\n          function (event) {\n            if (\n              event.pointerType === 'touch' &&\n              !state.dragging\n            ) {\n              return;\n            }\n\n            setDesiredPoint(\n              event.clientX,\n              event.clientY\n            );\n          },\n          { passive: true }\n        );\n\n        hero.addEventListener(\n          'pointerdown',\n          function (event) {\n            if (state.found) {\n              return;\n            }\n\n            state.dragging = true;\n\n            if (hero.setPointerCapture) {\n              try {\n                hero.setPointerCapture(event.pointerId);\n              } catch (error) {}\n            }\n\n            setDesiredPoint(\n              event.clientX,\n              event.clientY\n            );\n          }\n        );\n\n        hero.addEventListener(\n          'pointerup',\n          function () {\n            state.dragging = false;\n          }\n        );\n\n        hero.addEventListener(\n          'pointercancel',\n          function () {\n            state.dragging = false;\n          }\n        );\n\n        hero.addEventListener(\n          'keydown',\n          function (event) {\n            if (state.found) {\n              return;\n            }\n\n            var amount = event.shiftKey ? 42 : 18;\n            var handled = true;\n\n            if (event.key === 'ArrowLeft') {\n              state.targetX -= amount;\n            } else if (event.key === 'ArrowRight') {\n              state.targetX += amount;\n            } else if (event.key === 'ArrowUp') {\n              state.targetY -= amount;\n            } else if (event.key === 'ArrowDown') {\n              state.targetY += amount;\n            } else {\n              handled = false;\n            }\n\n            if (handled) {\n              event.preventDefault();\n\n              state.targetX = clamp(\n                state.targetX,\n                0,\n                hero.clientWidth\n              );\n\n              state.targetY = clamp(\n                state.targetY,\n                0,\n                hero.clientHeight\n              );\n            }\n          }\n        );\n\n        hero.setAttribute('tabindex', '0');\n\n        if (skip) {\n          skip.addEventListener('click', acquireTarget);\n        }\n\n        window.addEventListener(\n          'resize',\n          function () {\n            if (state.found) {\n              return;\n            }\n\n            state.x = clamp(\n              state.x,\n              0,\n              hero.clientWidth\n            );\n\n            state.y = clamp(\n              state.y,\n              0,\n              hero.clientHeight\n            );\n\n            state.targetX = clamp(\n              state.targetX,\n              0,\n              hero.clientWidth\n            );\n\n            state.targetY = clamp(\n              state.targetY,\n              0,\n              hero.clientHeight\n            );\n          },\n          { passive: true }\n        );\n\n        var video = root.querySelector('[data-b80-hunt-video]');\n\n        if (video) {\n          var playPromise = video.play();\n\n          if (\n            playPromise &&\n            typeof playPromise.catch === 'function'\n          ) {\n            playPromise.catch(function () {});\n          }\n        }\n\n        requestAnimationFrame(updateSight);\n      });\n    }\n\n    initB80Hunt(document);\n\n    if (!window.__b80HuntBound) {\n      window.__b80HuntBound = true;\n\n      document.addEventListener(\n        'shopify:section:load',\n        function (event) {\n          initB80Hunt(event.target);\n        }\n      );\n    }\n  })();\n</script>",
        "color_scheme": "scheme-4",
