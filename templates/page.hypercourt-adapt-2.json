    "custom_liquid_ceFCac": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* ==========================================\n   HNDRD EXPLORE ALL\n   ORIGINAL BRAND FONT\n========================================== */\n\n@font-face {\n  font-family: 'Anita_semi_square';\n  src: url(\"{{ 'Anita_semi_square.ttf' | file_url }}\")\n    format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n}\n\n/* ==========================================\n   MAIN SECTION\n========================================== */\n\n.hndrd-explore-all,\n.hndrd-explore-all * {\n  box-sizing: border-box;\n}\n\n.hndrd-explore-all {\n  position: relative;\n  isolation: isolate;\n\n  width: 100%;\n  min-height: 0 !important;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  margin: 0 !important;\n\n  /* TOP 0 | SIDES 24 | BOTTOM 65 */\n  padding: 0 24px 65px !important;\n\n  background: #ffffff;\n  overflow: hidden;\n}\n\n/* ==========================================\n   DOT GRID - DESKTOP\n========================================== */\n\n.hndrd-explore-all::before {\n  content: \"\";\n\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n\n  pointer-events: none;\n\n  background-image: radial-gradient(\n    circle,\n    #555555 0px,\n    #555555 1px,\n    transparent 1.5px\n  );\n\n  background-size: 150px 155px;\n  background-position: center -22px;\n  background-repeat: repeat;\n\n  opacity: .65;\n}\n\n/* ==========================================\n   EXPLORE LINK\n========================================== */\n\n.hndrd-explore-all .hndrd-explore-link,\n.hndrd-explore-all .hndrd-explore-link:visited {\n  position: relative;\n  z-index: 1;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: fit-content;\n  max-width: 100%;\n\n  gap: 17px;\n\n  padding: 0;\n  margin: 0;\n\n  background: transparent;\n  border: none;\n\n  color: #000000 !important;\n  text-decoration: none !important;\n\n  cursor: pointer;\n}\n\n/* ==========================================\n   ORIGINAL BUTTUN IMAGE\n   BIGGER + CONTINUOUS ROTATION\n========================================== */\n\n.hndrd-explore-all .hndrd-explore-wheel {\n  display: block;\n\n  width: 82px;\n  height: 82px;\n\n  flex: 0 0 82px;\n\n  object-fit: contain;\n\n  margin: 0;\n  padding: 0;\n\n  transform-origin: center center;\n\n  animation:\n    hndrd-wheel-rotation 6s linear infinite;\n\n  will-change: transform;\n}\n\n/* ==========================================\n   WHEEL ROTATION ANIMATION\n========================================== */\n\n@keyframes hndrd-wheel-rotation {\n  0% {\n    transform: rotate(0deg);\n  }\n\n  100% {\n    transform: rotate(360deg);\n  }\n}\n\n/* ==========================================\n   EXPLORE ALL TEXT\n========================================== */\n\n.hndrd-explore-all .hndrd-explore-text {\n  display: block;\n\n  margin: 0;\n  padding: 0;\n\n  font-family: 'Anita_semi_square' !important;\n\n  font-size: clamp(38px, 5vw, 70px);\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  line-height: 1.1 !important;\n  letter-spacing: .025em !important;\n\n  text-transform: uppercase !important;\n\n  color: #000000 !important;\n\n  white-space: nowrap;\n}\n\n/* ==========================================\n   HOVER\n========================================== */\n\n@media (hover: hover) {\n\n  .hndrd-explore-link {\n    transition: opacity .25s ease;\n  }\n\n  .hndrd-explore-link:hover {\n    opacity: .75;\n  }\n\n}\n\n.hndrd-explore-link:focus-visible {\n  outline: 2px solid #dd0d16;\n  outline-offset: 8px;\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (min-width: 769px) and (max-width: 1024px) {\n\n  .hndrd-explore-all {\n    min-height: 0 !important;\n\n    /* ZERO TOP PADDING */\n    padding: 0 24px 65px !important;\n  }\n\n  .hndrd-explore-all .hndrd-explore-text {\n    font-size: clamp(32px, 5.5vw, 55px);\n  }\n\n  .hndrd-explore-all .hndrd-explore-wheel {\n    width: 70px;\n    height: 70px;\n    flex-basis: 70px;\n  }\n\n}\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 768px) {\n\n  .hndrd-explore-all {\n    width: 100%;\n    min-height: 0 !important;\n\n    /* ZERO TOP PADDING */\n    padding: 0 15px 45px !important;\n\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* MOBILE DOT GRID */\n\n  .hndrd-explore-all::before {\n    background-size: 78px 110px;\n    background-position: center -25px;\n    background-repeat: repeat;\n\n    opacity: .65;\n  }\n\n  /* LINK ALIGNMENT */\n\n  .hndrd-explore-all .hndrd-explore-link {\n    display: inline-flex;\n\n    align-items: center;\n    justify-content: center;\n\n    gap: 10px;\n\n    width: fit-content;\n    max-width: 100%;\n\n    margin: 0 auto;\n  }\n\n  /* BIGGER ROTATING WHEEL */\n\n  .hndrd-explore-all .hndrd-explore-wheel {\n    width: 54px;\n    height: 54px;\n    flex: 0 0 54px;\n\n    object-fit: contain;\n\n    animation:\n      hndrd-wheel-rotation 6s linear infinite;\n  }\n\n  /* EXPLORE ALL TEXT */\n\n  .hndrd-explore-all .hndrd-explore-text {\n    font-size: clamp(21px, 5.8vw, 36px);\n\n    letter-spacing: .015em !important;\n    line-height: 1.1 !important;\n\n    white-space: nowrap;\n  }\n\n}\n\n/* ==========================================\n   SMALL MOBILE\n========================================== */\n\n@media (max-width: 400px) {\n\n  .hndrd-explore-all {\n    min-height: 0 !important;\n\n    /* ZERO TOP PADDING */\n    padding: 0 12px 40px !important;\n  }\n\n  .hndrd-explore-all .hndrd-explore-link {\n    gap: 8px;\n  }\n\n  .hndrd-explore-all .hndrd-explore-wheel {\n    width: 50px;\n    height: 50px;\n    flex: 0 0 50px;\n  }\n\n  .hndrd-explore-all .hndrd-explore-text {\n    font-size: clamp(18px, 5.5vw, 23px);\n    letter-spacing: .01em !important;\n  }\n\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hndrd-explore-all .hndrd-explore-wheel {\n    animation: none;\n    will-change: auto;\n  }\n\n  .hndrd-explore-link {\n    transition: none;\n  }\n\n}\n</style>\n\n<!-- ==========================================\n     HNDRD EXPLORE ALL SECTION\n========================================== -->\n\n<section class=\"hndrd-explore-all\">\n\n  <a\n    class=\"hndrd-explore-link\"\n    href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n    aria-label=\"Explore Hypercourt Adapt\"\n  >\n\n    <!-- ORIGINAL ROTATING WHEEL -->\n\n    <img\n      class=\"hndrd-explore-wheel\"\n      src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/BUTTUN.png?v=1792162562\"\n      alt=\"\"\n      aria-hidden=\"true\"\n      loading=\"lazy\"\n      width=\"82\"\n      height=\"82\"\n    >\n\n    <!-- EXPLORE ALL TEXT -->\n\n    <span class=\"hndrd-explore-text\">\n      EXPLORE ALL\n    </span>\n\n  </a>\n\n</section>\n\n<!--\n  Anita Semi-Square by Gustavo Paz L.\n  Licensed under CC BY-SA 4.0\n-->",
        "color_scheme": "scheme-39636f9a-299a-4d34-b9ae-709d6d7a1dfa",
        "padding_top": 0,
