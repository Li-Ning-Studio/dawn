nt;\n  }\n\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hndrd-adapt-reverse-media img,\n  .hndrd-adapt-reverse-cta,\n  .hndrd-adapt-reverse-cta svg {\n    transition: none;\n  }\n\n}\n</style>\n\n<section class=\"hndrd-adapt-reverse\">\n\n  <div class=\"hndrd-adapt-reverse-grid\">\n\n    <!-- LEFT CONTENT -->\n\n    <div class=\"hndrd-adapt-reverse-content\">\n\n      <div class=\"hndrd-adapt-reverse-inner\">\n\n        <!-- BRAND LABEL -->\n\n        <p class=\"hndrd-adapt-reverse-label\">\n          HNDRD HYPERCOURT ADAPT\n        </p>\n\n        <!-- HEADING -->\n\n        <h2 class=\"hndrd-adapt-reverse-title\">\n          LOCK-IN TRACTION\n        </h2>\n\n        <!-- DESCRIPTION -->\n\n        <p class=\"hndrd-adapt-reverse-description\">\n          The non-marking rubber outsole delivers a strong and durable grip, allowing confident\nstarts, stops, and slides. The outsole has upgraded abrasion resistance, 20% higher than\nany regular outsole.\n        </p>\n\n        <!-- CTA -->\n\n        <a\n          class=\"hndrd-adapt-reverse-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Pre-book HNDRD Hypercourt Adapt\"\n        >\n\n          Explore HYPERCOURT ADAPT\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n\n        </a>\n\n      </div>\n\n    </div>\n\n    <!-- RIGHT PRODUCT IMAGE -->\n\n    <div class=\"hndrd-adapt-reverse-media\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_3_686e75ad-4ce3-4e0f-bfd7-52e1ac7b3913