      "settings": {
        "custom_liquid": "<style>\n/* ==========================================\n   HNDRD ORIGINAL FONT\n========================================== */\n\n@font-face {\n  font-family: 'Anita_semi_square';\n  src: url(\"{{ 'Anita_semi_square.ttf' | file_url }}\")\n    format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n}\n\n/* ==========================================\n   MAIN SECTION\n========================================== */\n\n.hndrd-final-story,\n.hndrd-final-story * {\n  box-sizing: border-box;\n}\n\n.hndrd-final-story {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n\n  background: #ffffff;\n  color: #101010;\n}\n\n/* ==========================================\n   DOT BACKGROUND\n========================================== */\n\n.hndrd-final-story::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n\n  background-image: radial-gradient(\n    circle,\n    #383838 0px,\n    #383838 1px,\n    transparent 1.5px\n  );\n\n  background-size: 115px 115px;\n  background-position: 29px -73px;\n  background-repeat: repeat;\n}\n\n/* ==========================================\n   VIDEO WRAPPER\n========================================== */\n\n.hndrd-final-video-wrap {\n  position: relative;\n  z-index: 1;\n\n  width: 100%;\n  padding: 0;\n  margin: 0;\n\n  overflow: hidden;\n  background: #ffffff;\n}\n\n.hndrd-final-video {\n  display: block;\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n  object-position: center;\n\n  margin: 0;\n  padding: 0;\n}\n\n/* DESKTOP VIDEO */\n\n.hndrd-final-video-desktop {\n  display: block;\n  aspect-ratio: 16 / 9;\n}\n\n/* MOBILE VIDEO */\n\n.hndrd-final-video-mobile {\n  display: none;\n}\n\n/* ==========================================\n   CONTENT\n========================================== */\n\n.hndrd-final-content {\n  position: relative;\n  z-index: 1;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  padding: 38px 20px 45px;\n\n  text-align: center;\n}\n\n/* ==========================================\n   TITLE - ANITA SEMI SQUARE\n   MATCHING LOCKED-IN STABILITY FONT\n========================================== */\n\n.hndrd-final-story .hndrd-final-title {\n  display: block;\n  width: 100%;\n  max-width: 1300px;\n\n  margin: 0;\n  padding: 0;\n\n  font-family: 'Anita_semi_square' !important;\n  font-size: clamp(30px, 4.5vw, 68px);\n\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .105em !important;\n  line-height: 1.28 !important;\n\n  text-transform: uppercase !important;\n  text-align: center !important;\n\n  color: #101010 !important;\n}\n\n/* ALL WORDS USE SAME FONT */\n\n.hndrd-final-title span {\n  font-family: 'Anita_semi_square' !important;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n}\n\n/* ==========================================\n   CTA - RED OUTLINE\n========================================== */\n\n.hndrd-final-story .hndrd-final-cta,\n.hndrd-final-story .hndrd-final-cta:visited {\n  position: relative;\n  isolation: isolate;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n\n  max-width: 100%;\n  min-height: 52px;\n\n  margin-top: 28px;\n  padding: 0 28px;\n\n  border: 1.5px solid #dd0d16;\n  border-radius: 999px;\n\n  background: #ffffff;\n  color: #dd0d16 !important;\n\n  font-family: 'Anita_semi_square' !important;\n  font-size: 12px;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .06em !important;\n  line-height: 1.25 !important;\n\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n\n  overflow: hidden;\n  cursor: pointer;\n\n  transition:\n    color .45s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n/* ==========================================\n   DOWNWARD FLUID RED FILL\n========================================== */\n\n.hndrd-final-cta::before {\n  content: \"\";\n  position: absolute;\n\n  z-index: 0;\n  top: -15%;\n  left: -5%;\n\n  width: 110%;\n  height: 130%;\n\n  background: #dd0d16;\n\n  border-radius:\n    0 0 48% 52% / 0 0 20% 20%;\n\n  transform: translateY(-115%);\n\n  transition: transform .65s\n    cubic-bezier(.22,1,.36,1);\n}\n\n/* CTA TEXT */\n\n.hndrd-final-cta-label {\n  position: relative;\n  z-index: 1;\n\n  font-family: 'Anita_semi_square' !important;\n  font-weight: 400 !important;\n  font-style: normal !important;\n}\n\n/* ==========================================\n   DOWN ARROW\n========================================== */\n\n.hndrd-final-cta-arrow {\n  position: relative;\n  z-index: 1;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 18px;\n  height: 20px;\n\n  flex: 0 0 18px;\n}\n\n.hndrd-final-cta-arrow svg {\n  display: block;\n\n  width: 18px;\n  height: 18px;\n\n  animation: hndrd-arrow-down 2s\n    ease-in-out infinite;\n}\n\n@keyframes hndrd-arrow-down {\n  0%, 100% {\n    transform: translateY(-2px);\n  }\n\n  50% {\n    transform: translateY(3px);\n  }\n}\n\n/* ==========================================\n   HOVER ANIMATIONS\n========================================== */\n\n@media (hover: hover) {\n\n  .hndrd-final-story .hndrd-final-cta:hover {\n    color: #ffffff !important;\n\n    transform: translateY(-2px);\n\n    box-shadow:\n      0 8px 24px rgba(221,13,22,.13);\n  }\n\n  .hndrd-final-story .hndrd-final-cta:hover::before {\n    transform: translateY(0);\n  }\n}\n\n.hndrd-final-cta:active {\n  transform: scale(.98);\n}\n\n.hndrd-final-cta:focus-visible {\n  outline: 2px solid #dd0d16;\n  outline-offset: 4px;\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (min-width: 769px) and (max-width: 1024px) {\n\n  .hndrd-final-content {\n    padding: 32px 18px 38px;\n  }\n\n  .hndrd-final-story .hndrd-final-title {\n    font-size: clamp(28px, 4vw, 44px);\n\n    letter-spacing: .09em !important;\n    line-height: 1.3 !important;\n  }\n\n  .hndrd-final-story .hndrd-final-cta {\n    margin-top: 24px;\n  }\n}\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 768px) {\n\n  /* DOTS */\n\n  .hndrd-final-story::before {\n    background-size: 65px 65px;\n    background-position: 20px 10px;\n  }\n\n  /* VIDEOS */\n\n  .hndrd-final-video-desktop {\n    display: none;\n  }\n\n  .hndrd-final-video-mobile {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 5;\n  }\n\n  .hndrd-final-video-wrap {\n    width: 100%;\n    padding: 0;\n    margin: 0;\n  }\n\n  /* CONTENT */\n\n  .hndrd-final-content {\n    padding: 32px 15px 39px;\n  }\n\n  /* TITLE */\n\n  .hndrd-final-story .hndrd-final-title {\n    width: 100%;\n\n    font-family: 'Anita_semi_square' !important;\n\n    font-size: clamp(25px, 7vw, 40px);\n    font-weight: 400 !important;\n    font-style: normal !important;\n\n    letter-spacing: .085em !important;\n    line-height: 1.4 !important;\n\n    text-align: center !important;\n  }\n\n  /* IMPOSSIBLE ON SECOND LINE */\n\n  .hndrd-final-title .hndrd-final-impossible {\n    display: block;\n    margin-top: 2px;\n  }\n\n  /* CTA */\n\n  .hndrd-final-story .hndrd-final-cta {\n    min-height: 48px;\n\n    margin-top: 24px;\n    padding: 0 19px;\n\n    gap: 9px;\n\n    font-size: clamp(10px, 2.65vw, 12px);\n    letter-spacing: .035em !important;\n  }\n\n  .hndrd-final-cta-arrow {\n    width: 16px;\n    flex-basis: 16px;\n  }\n\n  .hndrd-final-cta-arrow svg {\n    width: 16px;\n    height: 16px;\n  }\n}\n\n/* ==========================================\n   SMALL MOBILE\n========================================== */\n\n@media (max-width: 400px) {\n\n  .hndrd-final-content {\n    padding: 27px 12px 34px;\n  }\n\n  .hndrd-final-story .hndrd-final-title {\n    font-size: clamp(23px, 6.8vw, 29px);\n\n    letter-spacing: .075em !important;\n    line-height: 1.4 !important;\n  }\n\n  .hndrd-final-story .hndrd-final-cta {\n    min-height: 45px;\n\n    margin-top: 21px;\n    padding: 0 14px;\n\n    gap: 7px;\n\n    font-size: 10px;\n    letter-spacing: .015em !important;\n  }\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hndrd-final-cta,\n  .hndrd-final-cta::before,\n  .hndrd-final-cta-arrow svg {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n</style>\n\n<!-- ==========================================\n     FINAL HYPERCOURT ADAPT SECTION\n========================================== -->\n\n<section class=\"hndrd-final-story\">\n\n  <!-- DESKTOP + MOBILE VIDEOS -->\n\n  <div class=\"hndrd-final-video-wrap\">\n\n    <!-- DESKTOP -->\n\n    <video\n      class=\"hndrd-final-video hndrd-final-video-desktop\"\n      autoplay\n      muted\n      loop\n      playsinline\n      preload=\"metadata\"\n      aria-label=\"Hypercourt Adapt desktop video\"\n    >\n      <source\n        src=\"https://cdn.shopify.com/videos/c/o/v/36ff3b3aaa6342a4bed72022eef786bd.mp4\"\n        type=\"video/mp4\"\n      >\n    </video>\n\n    <!-- MOBILE -->\n\n    <video\n      class=\"hndrd-final-video hndrd-final-video-mobile\"\n      autoplay\n      muted\n      loop\n      playsinline\n      preload=\"metadata\"\n      aria-label=\"Hypercourt Adapt mobile video\"\n    >\n      <source\n        src=\"https://cdn.shopify.com/videos/c/o/v/b9889e01e5e94900a3c39fbff8460deb.mp4\"\n        type=\"video/mp4\"\n      >\n    </video>\n\n  </div>\n\n  <!-- TITLE + CTA -->\n\n  <div class=\"hndrd-final-content\">\n\n    <h2 class=\"hndrd-final-title\">\n      ADAPT TO THE\n      <span class=\"hndrd-final-impossible\">\n        IMPOSSIBLE\n      </span>\n    </h2>\n\n    <a\n      class=\"hndrd-final-cta\"\n      href=\"https://in.hndrd.co/pages/preorder-adapt-today\"\n      aria-label=\"Explore the Hypercourt Adapt\"\n    >\n\n      <span class=\"hndrd-final-cta-label\">\n        EXPLORE THE HYPERCOURT ADAPT\n      </span>\n\n      <span\n        class=\"hndrd-final-cta-arrow\"\n        aria-hidden=\"true\"\n      >\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n        >\n          <path\n            d=\"M12 4v15m-6-6 6 6 6-6\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </span>\n\n    </a>\n\n  </div>\n\n</section>\n\n<!--\n  Anita Semi-Square by Gustavo Paz L.\n  Licensed under CC BY-SA 4.0\n-->",
