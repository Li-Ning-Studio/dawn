      "settings": {
        "custom_liquid": "<style>\n/* ==========================================\n   HNDRD ORIGINAL SHOPIFY FONTS\n========================================== */\n\n@font-face {\n  font-family: 'Anita_semi_square';\n  src: url(\"{{ 'Anita_semi_square.ttf' | file_url }}\")\n    format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: block;\n}\n\n@font-face {\n  font-family: 'Gilroy-Regular';\n  src: url(\"{{ 'Gilroy-Regular.ttf' | file_url }}\")\n    format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: block;\n}\n\n/* ==========================================\n   MAIN SECTION\n========================================== */\n\n.hndrd-adapt-split,\n.hndrd-adapt-split * {\n  box-sizing: border-box;\n}\n\n.hndrd-adapt-split {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n  background: #ffffff;\n  color: #161616;\n}\n\n/* ==========================================\n   DOT GRID\n========================================== */\n\n.hndrd-adapt-split::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n\n  background-image: radial-gradient(\n    circle,\n    #383838 0px,\n    #383838 1px,\n    transparent 1.5px\n  );\n\n  background-size: 115px 115px;\n  background-position: 29px -73px;\n  background-repeat: repeat;\n}\n\n/* ==========================================\n   SPLIT LAYOUT\n========================================== */\n\n.hndrd-adapt-grid {\n  position: relative;\n  z-index: 1;\n\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n\n  width: 100%;\n  min-height: 650px;\n  align-items: stretch;\n}\n\n/* ==========================================\n   LEFT IMAGE - FULL COVER\n========================================== */\n\n.hndrd-adapt-media {\n  position: relative;\n  display: block;\n\n  width: 100%;\n  height: 100%;\n  min-height: 650px;\n\n  padding: 0;\n  margin: 0;\n\n  overflow: hidden;\n  background: transparent;\n}\n\n.hndrd-adapt-media img {\n  position: absolute;\n  inset: 0;\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  max-width: none;\n  max-height: none;\n\n  object-fit: cover;\n  object-position: center center;\n\n  margin: 0;\n  padding: 0;\n\n  transition: transform .8s\n    cubic-bezier(.22,1,.36,1);\n}\n\n/* ==========================================\n   RIGHT CONTENT\n========================================== */\n\n.hndrd-adapt-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  min-width: 0;\n  padding: 65px 36px;\n\n  background: transparent;\n}\n\n.hndrd-adapt-inner {\n  width: 100%;\n  max-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* ==========================================\n   BRAND LABEL - ANITA SEMI SQUARE\n========================================== */\n\n.hndrd-adapt-split .hndrd-adapt-label {\n  margin: 0 0 22px;\n  padding: 0;\n\n  font-family: 'Anita_semi_square' !important;\n  font-size: 13px;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .12em !important;\n  line-height: 1.5 !important;\n  text-transform: uppercase !important;\n\n  color: #dd0d16;\n}\n\n/* ==========================================\n   TITLE - ANITA SEMI SQUARE\n========================================== */\n\n.hndrd-adapt-split .hndrd-adapt-title {\n  display: block;\n\n  margin: 0 0 25px;\n  padding: 0;\n\n  font-family: 'Anita_semi_square' !important;\n  font-size: clamp(27px, 2.8vw, 43px);\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .15em !important;\n  line-height: 1.3 !important;\n\n  text-transform: uppercase !important;\n  text-align: center !important;\n  overflow-wrap: anywhere;\n\n  color: #101010;\n}\n\n/* ==========================================\n   DESCRIPTION - GILROY REGULAR\n========================================== */\n\n.hndrd-adapt-split .hndrd-adapt-description {\n  display: block;\n\n  width: 100%;\n  max-width: 540px;\n\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'Gilroy-Regular' !important;\n  font-size: 17px;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.015em !important;\n  line-height: 1.45 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  color: #292929;\n}\n\n/* ==========================================\n   RED OUTLINE CTA\n========================================== */\n\n.hndrd-adapt-split .hndrd-adapt-cta,\n.hndrd-adapt-split .hndrd-adapt-cta:visited {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n\n  margin-top: 34px;\n  padding: 0 30px;\n\n  border: 1.5px solid #dd0d16;\n  border-radius: 999px;\n\n  background: #ffffff;\n  color: #dd0d16 !important;\n\n  font-family: 'Anita_semi_square' !important;\n  font-size: 13px;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .06em !important;\n  line-height: 1.2;\n\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n\n  white-space: nowrap;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hndrd-adapt-cta svg {\n  display: block;\n\n  width: 17px;\n  height: 17px;\n\n  flex-shrink: 0;\n\n  transition: transform .3s ease;\n}\n\n/* ==========================================\n   DESKTOP HOVER\n========================================== */\n\n@media (hover: hover) {\n\n  .hndrd-adapt-media:hover img {\n    transform: scale(1.025);\n  }\n\n  .hndrd-adapt-split .hndrd-adapt-cta:hover {\n    background: #dd0d16;\n    color: #ffffff !important;\n\n    transform: translateY(-2px);\n\n    box-shadow: 0 8px 22px\n      rgba(221,13,22,.12);\n  }\n\n  .hndrd-adapt-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hndrd-adapt-cta:active {\n  transform: scale(.98);\n}\n\n.hndrd-adapt-cta:focus-visible {\n  outline: 2px solid #dd0d16;\n  outline-offset: 4px;\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (min-width: 769px) and (max-width: 1024px) {\n\n  .hndrd-adapt-grid {\n    min-height: 550px;\n  }\n\n  .hndrd-adapt-media {\n    min-height: 550px;\n  }\n\n  .hndrd-adapt-content {\n    padding: 45px 25px;\n  }\n\n  .hndrd-adapt-split .hndrd-adapt-title {\n    font-size: clamp(24px, 3vw, 32px);\n    letter-spacing: .10em !important;\n  }\n\n  .hndrd-adapt-split .hndrd-adapt-description {\n    font-size: 15px;\n  }\n\n}\n\n/* ==========================================\n   MOBILE - FULL WIDTH IMAGE\n========================================== */\n\n@media (max-width: 768px) {\n\n  .hndrd-adapt-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n\n    width: 100%;\n    min-height: 0;\n  }\n\n  /* EDGE-TO-EDGE IMAGE */\n\n  .hndrd-adapt-media {\n    position: relative;\n    display: block;\n\n    width: 100%;\n    height: auto;\n    min-height: 0;\n\n    aspect-ratio: 4 / 5;\n\n    padding: 0 !important;\n    margin: 0 !important;\n\n    overflow: hidden;\n  }\n\n  .hndrd-adapt-media img {\n    position: absolute;\n    inset: 0;\n\n    display: block;\n\n    width: 100% !important;\n    height: 100% !important;\n\n    max-width: none !important;\n    max-height: none !important;\n\n    object-fit: cover !important;\n    object-position: center center !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  /* CONTENT */\n\n  .hndrd-adapt-content {\n    padding: 30px 22px 55px;\n  }\n\n  .hndrd-adapt-inner {\n    max-width: 460px;\n    margin: 0 auto;\n  }\n\n  /* LABEL */\n\n  .hndrd-adapt-split .hndrd-adapt-label {\n    margin-bottom: 17px;\n    font-size: 11px;\n    letter-spacing: .10em !important;\n  }\n\n  /* TITLE */\n\n  .hndrd-adapt-split .hndrd-adapt-title {\n    margin-bottom: 20px;\n\n    font-family: 'Anita_semi_square' !important;\n    font-size: clamp(22px, 5.8vw, 32px);\n    font-weight: 400 !important;\n\n    letter-spacing: .12em !important;\n    line-height: 1.3 !important;\n  }\n\n  /* DESCRIPTION */\n\n  .hndrd-adapt-split .hndrd-adapt-description {\n    font-family: 'Gilroy-Regular' !important;\n\n    font-size: 15px;\n    line-height: 1.45 !important;\n    letter-spacing: -.015em !important;\n  }\n\n  /* CTA */\n\n  .hndrd-adapt-split .hndrd-adapt-cta {\n    min-height: 47px;\n\n    margin-top: 27px;\n    padding: 0 26px;\n\n    font-family: 'Anita_semi_square' !important;\n    font-size: 12px;\n  }\n}\n\n/* ==========================================\n   SMALL MOBILE\n========================================== */\n\n@media (max-width: 400px) {\n\n  .hndrd-adapt-media {\n    width: 100%;\n    height: auto;\n    min-height: 0;\n\n    aspect-ratio: 4 / 5;\n\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  .hndrd-adapt-media img {\n    width: 100% !important;\n    height: 100% !important;\n\n    max-width: none !important;\n    max-height: none !important;\n\n    object-fit: cover !important;\n    object-position: center !important;\n  }\n\n  .hndrd-adapt-content {\n    padding: 28px 18px 48px;\n  }\n\n  .hndrd-adapt-split .hndrd-adapt-title {\n    font-size: 22px;\n    letter-spacing: .10em !important;\n  }\n\n  .hndrd-adapt-split .hndrd-adapt-description {\n    font-size: 14px;\n    line-height: 1.4 !important;\n  }\n\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hndrd-adapt-media img,\n  .hndrd-adapt-cta,\n  .hndrd-adapt-cta svg {\n    transition: none;\n  }\n\n}\n</style>\n\n<section class=\"hndrd-adapt-split\">\n\n  <div class=\"hndrd-adapt-grid\">\n\n    <!-- LEFT PRODUCT IMAGE -->\n\n    <div class=\"hndrd-adapt-media\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_2_0c3d455b-0471-4c8d-b3d9-c88db99268a3.jpg?v=1792580525\"\n        alt=\"HNDRD Hypercourt Adapt Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n\n    </div>\n\n    <!-- RIGHT CONTENT -->\n\n    <div class=\"hndrd-adapt-content\">\n\n      <div class=\"hndrd-adapt-inner\">\n\n        <!-- BRAND LABEL -->\n\n        <p class=\"hndrd-adapt-label\">\n          HNDRD HYPERCOURT ADAPT\n        </p>\n\n        <!-- HEADING -->\n\n        <h2 class=\"hndrd-adapt-title\">\n          BUILT FOR STABILITY\n        </h2>\n\n        <!-- DESCRIPTION -->\n\n        <p class=\"hndrd-adapt-description\">\n          Positioned beneath the midfoot, the external support plate adds structure during lateral\nmovement. It improves balance and stability, especially during quick cuts, lunges, and\nsudden directional shifts.\n        </p>\n\n        <!-- CTA -->\n\n        <a\n          class=\"hndrd-adapt-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Pre-book HNDRD Hypercourt Adapt\"\n        >\n\n          SHOP HYPERCOURT ADAPT\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n\n        </a>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n<!--\n  Anita Semi-Square by Gustavo Paz L.\n  Licensed under CC BY-SA 4.0\n  https://creativecommons.org/licenses/by-sa/4.0/\n-->",
