      "settings": {
        "custom_liquid": "{%- comment -%}\n  HNDRD / NITRIX BULLET 80 — PAGE ENTRY LOADER\n  ------------------------------------------------\n  Paste this as the FIRST Custom Liquid section on the landing page,\n  directly above the Bullet 80 hero section.\n \n  Behaviour:\n  - Runs once on every real page visit or browser refresh.\n  - Does not repeat while scrolling or clicking anchor links on this page.\n  - Locks scrolling while active.\n  - Waits for the page to load, while enforcing a short minimum display time.\n  - Wipes upward to reveal the hero.\n  - Pauses the Bullet 80 hero animations until the reveal begins.\n{%- endcomment -%}\n\n<script>\n  document.documentElement.classList.add('b80-page-loading');\n</script>\n\n<style>\n  html.b80-page-loading,\n  html.b80-page-loading body {\n    overflow: hidden !important;\n    overscroll-behavior: none;\n  }\n\n  /*\n    Pause the existing Bullet 80 hero entrance animations while\n    the loader is covering the page. They begin as the loader exits.\n  */\n  html.b80-page-loading .b80-villain *,\n  html.b80-page-loading .b80-villain *::before,\n  html.b80-page-loading .b80-villain *::after {\n    animation-play-state: paused !important;\n  }\n\n  .b80-entry-loader,\n  .b80-entry-loader * {\n    box-sizing: border-box;\n  }\n\n  .b80-entry-loader {\n    --loader-orange: #ffa400;\n    --loader-white: #f3f0e8;\n    --loader-black: #030303;\n\n    position: fixed;\n    z-index: 2147483647;\n    inset: 0;\n    width: 100%;\n    height: 100vh;\n    height: 100svh;\n    overflow: hidden;\n    isolation: isolate;\n    background: var(--loader-black);\n    color: var(--loader-white);\n    font-family: Figtree, var(--font-body-family), Arial, sans-serif;\n    opacity: 1;\n    visibility: visible;\n    clip-path: inset(0 0 0 0);\n    -webkit-clip-path: inset(0 0 0 0);\n    cursor: wait;\n    will-change: clip-path, opacity;\n  }\n\n  .b80-entry-loader::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    inset: 0;\n    opacity: .18;\n    background-image:\n      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);\n    background-size: clamp(56px, 6vw, 96px) clamp(56px, 6vw, 96px);\n    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 70%);\n    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 70%);\n  }\n\n  .b80-entry-loader::after {\n    content: \"\";\n    position: absolute;\n    z-index: 1;\n    top: 0;\n    bottom: 0;\n    left: clamp(18px, 3.1vw, 52px);\n    width: 2px;\n    background: var(--loader-orange);\n    transform: scaleY(0);\n    transform-origin: top;\n    box-shadow: 0 0 18px rgba(255,164,0,.28);\n  }\n\n  .b80-entry-loader.is-running::after {\n    animation: b80-loader-rail 1.35s cubic-bezier(.16,1,.3,1) .12s forwards;\n  }\n\n  .b80-entry-loader__meta {\n    position: absolute;\n    z-index: 4;\n    color: rgba(243,240,232,.42);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n    opacity: 0;\n  }\n\n  .b80-entry-loader__meta--top {\n    top: clamp(24px, 4vw, 54px);\n    left: clamp(34px, 5vw, 76px);\n  }\n\n  .b80-entry-loader__meta--bottom {\n    right: clamp(24px, 4vw, 54px);\n    bottom: clamp(24px, 4vw, 54px);\n    text-align: right;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__meta {\n    animation: b80-loader-meta .65s ease .42s forwards;\n  }\n\n  .b80-entry-loader__stage {\n    position: absolute;\n    z-index: 3;\n    inset: 0;\n    display: grid;\n    place-items: center;\n  }\n\n  .b80-entry-loader__mark {\n    position: relative;\n    width: clamp(210px, 19vw, 320px);\n    aspect-ratio: 194 / 104;\n    transform: translateY(-2%);\n  }\n\n  .b80-entry-loader__mark::before {\n    content: \"\";\n    position: absolute;\n    inset: -62%;\n    border-radius: 50%;\n    background: radial-gradient(\n      circle,\n      rgba(255,164,0,.105) 0%,\n      rgba(255,164,0,.03) 34%,\n      transparent 69%\n    );\n    opacity: 0;\n    transform: scale(.55);\n  }\n\n  .b80-entry-loader__mark::after {\n    content: \"\";\n    position: absolute;\n    z-index: 5;\n    left: -12%;\n    right: -12%;\n    bottom: -3%;\n    height: 2px;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.28) 20%,\n      #fff7e7 50%,\n      rgba(255,164,0,.8) 74%,\n      transparent\n    );\n    opacity: 0;\n    transform: translateY(0) scaleX(.35);\n    box-shadow:\n      0 0 18px rgba(255,164,0,.42),\n      0 0 42px rgba(255,164,0,.14);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__mark::after {\n    animation: b80-loader-scan-up 1.02s cubic-bezier(.3,.7,.2,1) .84s forwards;\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__mark::before {\n    animation: b80-loader-aura 1.35s ease .72s forwards;\n  }\n\n  .b80-entry-loader__svg {\n    position: relative;\n    z-index: 3;\n    display: block;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n\n  .b80-entry-loader__outline {\n    fill: none;\n    stroke: rgba(243,240,232,.78);\n    stroke-width: 1.15;\n    stroke-linecap: square;\n    stroke-linejoin: miter;\n    vector-effect: non-scaling-stroke;\n    stroke-dasharray: 420;\n    stroke-dashoffset: 420;\n    opacity: 0;\n    clip-path: inset(100% 0 0 0);\n    -webkit-clip-path: inset(100% 0 0 0);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__outline {\n    animation: b80-loader-outline-rise 1.08s cubic-bezier(.16,1,.3,1) .24s forwards;\n  }\n\n  .b80-entry-loader__fill {\n    fill: var(--loader-orange);\n    opacity: 0;\n    clip-path: inset(100% 0 0 0);\n    -webkit-clip-path: inset(100% 0 0 0);\n    filter:\n      drop-shadow(0 0 14px rgba(255,164,0,.22))\n      drop-shadow(0 0 34px rgba(255,164,0,.08));\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__fill {\n    animation: b80-loader-fill-rise .92s cubic-be