:-.025em;font-size:clamp(30px,5vw,55px);line-height:1.08}#hx .d{color:#666;font-size:15px}#hx .hx-js-side{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%}#hx small{font-size:12px;color:#777}#hx .hx-b,#hxp .hx-b{display:inline-flex;align-items:center;justify-content:center;gap:9px;background:#dd0d16;color:#fff;border:0;border-radius:999px;min-height:52px;padding:0 32px;font-size:16px;font-weight:600;cursor:pointer;transition:transform .25s,box-shadow .25s}#hx .hx-b svg,#hxp .hx-b svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}#hx .hx-b:hover,#hxp .hx-b:hover{transform:translateY(-2px);box-shadow:0 5px 15px #dd0d161b}\n#hxp .hp-fb{position:fixed;bottom:calc(12px + env(safe-area-inset-bottom));left:50%;z-index:2147482000;transform:translate(-50%,calc(100% + 60px));opacity:0;transition:transform .5s,opacity .4s;display:flex;align-items:center;gap:12px;width:max-content;max-width:calc(100% - 20px);padding:8px;border:1px solid #ddd;background:#ffffffed;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:999px;box-shadow:0 2px 10px #00000016}#hxp .hp-fb.show{transform:translate(-50%,0);opacity:1}#hxp .hp-bell{color:#dd0d16;display:grid;place-items:center;width:36px;height:36px;border:1px solid #efc4c4;border-radius:50%;flex:none}#hxp .hp-bell svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2}#hxp .hp-bell .ck{display:none}#hxp .hp-fb.done .hp-bell .bl{display:none}#hxp .hp-fb.done .hp-bell .ck{display:block}#hxp .hp-fb-t{flex:1;min-width:0;line-height:1.25;text-align:left;white-space:nowrap}#hxp .hp-fb-t b{font-size:12px;font-weight:600;display:block}#hxp .hp-fb-t span{font-size:11px;color:#666;display:block}#hxp .hp-fb .hx-b{font-size:12px;min-height:39px;padding:0 16px}\n#hxp .hp-m{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:16px;visibility:hidden;transition:visibility 0s .4s}#hxp .hp-m.open{visibility:visible;transition:none}#hxp .hp-bd{position:absolute;inset:0;background:#0009;opacity:0;transition:opacity .3s}#hxp .hp-m.open>.hp-bd{opacity:1}#hxp .hp-sh{position:relative;width:min(460px,100%);max-height:calc(100dvh - 32px);overflow:hidden;border-radius:28px;background:#fff;border:1px solid #ddd;box-shadow:0 12px 38px #0003;opacity:0;transform:translateY(15px);transition:transform .35s,opacity .35s}#hxp .hp-m.open .hp-sh{opacity:1;transform:none}#hxp .hp-body{padding:34px 26px 28px;overflow-y:auto;max-height:calc(100dvh - 32px)}#hxp .hp-x{position:absolute;top:12px;right:12px;z-index:2}#hxp .hp-ic{border:0;background:#f5f5f5;color:#222;border-radius:50%;width:34px;height:34px;display:grid;place-items:center;cursor:pointer}#hxp .hp-ic svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;fill:none}#hxp .hp-top{margin-bottom:16px}#hxp .hp-live{font-size:12px;color:#dd0d16;text-transform:uppercase;letter-spacing:.06em}#hxp .hp-body h3{font-size:clamp(26px,6vw,32px);font-weight:600;line-height:1.08;margin:12px 0 10px}#hxp .hp-p{font-size:14px;line-height:1.5;color:#666;margin-bottom:22px}#hxp .hp-f{position:relative;margin:0 0 12px}#hxp .hp-f input{width:100%;height:56px;padding:23px 14px 7px 44px;background:#f8f8f8;color:#111;border:1px solid #ddd;border-radius:14px;outline:none;font-size:16px}#hxp .hp-f input:focus{border-color:#dd0d16;box-shadow:0 0 0 3px #dd0d1614}#hxp .hp-f svg.ic{position:absolute;top:18px;left:14px;width:18px;height:18px;stroke:#777;fill:none;stroke-width:2;pointer-events:none}#hxp .hp-f label{position:absolute;left:44px;top:18px;color:#777;font-size:15px;pointer-events:none;transition:transform .2s;transform-origin:left top}#hxp .hp-f input:focus~label,#hxp .hp-f input:not(:placeholder-shown)~label{transform:translateY(-10px) scale(.76)}#hxp .hp-go{width:100%;margin-top:5px}#hxp .hp-trust{display:flex;align-items:center;justify-content:center;gap:7px;font-size:11px;color:#777;margin-top:12px;text-align:center}#hxp .hp-trust svg{width:12px;height:12px;fill:none;stroke:currentColor}#hxp .hp-v[hidden]{display:none!important}#hxp .hp-err{color:#b8000b;font-size:13px}#hxp .hp-next{background:#f8f8f8;border:1px solid #eee;border-radius:16px;list-style:none;padding:5px 16px;margin:0}#hxp .hp-next li{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #e8e8e8}#hxp .hp-next li:last-child{border:0}#hxp .hp-next i{font-style:normal;font-weight:700;color:#dd0d16}#hxp .hp-next b{display:block;font-size:13px}#hxp .hp-next li span{display:block;color:#666;font-size:12px}#hxp .hp-ck svg{height:65px;width:65px;fill:none;stroke:#dd0d16;stroke-width:3}#hxp .hp-done .hx-b{margin-top:20px;width:100%;background:#222}#hxp .hp-done.show{animation:adaptRise .5s both}\n@keyframes adaptRise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@media(max-width:600px){#hx{padding:16px 16px 40px}#hx .hx-jc{padding:28px 18px}#hx .hx-js-side .hx-b{width:100%}#hxp .hp-fb{width:calc(100% - 20px)}#hxp .hp-body{padding:30px 20px 24px}#hxp .hp-fb-t span{display:none}}@media(prefers-reduced-motion:reduce){#hx .hx-jc,#hxp .hp-done.show{animation:none!important}#hx .hx-b,#hxp .hx-b,#hxp .hp-fb,#hxp .hp-sh{transition:none!important}}\n/* Anita Semi-Square across CTA, signup, buttons and supporting text. */\n#hx,#hxp,#hx button,#hxp button,#hxp input{font-family:\"AD Anita\",Oxanium,Arial,sans-serif}\n#hx h2,#hxp .hp-body h3{font-family:\"AD Anita\",Oxanium,Arial,sans-serif;letter-spacing:-.025em}\n#hx .hx-eb,#hx .d,#hx small,#hxp .hp-fb-t,#hxp .hp-live,#hxp label,#hxp .hp-p,#hxp .hp-next{font-family:\"AD Anita\",Oxanium,Arial,sans-serif}\n#hxp [data-fb-t]{font-family:\"AD Gilroy\",Arial,sans-serif;font-weight:400;letter-spacing:0}\n</style>\n<div id=\"hx\"><section class=\"hx-join\"><div class=\"hx-jc\"><div><p class=\"hx-eb\">Early access</p><h2>BE FIRST ON THE COURT</h2><p class=\"d\">Get the link as soon as pre-booking opens.</p></div><div class=\"hx-js-side\"><button type=\"button\" class=\"hx-b\" data-open data-jb><span>Notify me</span><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button><small data-js>One alert when pre-booking opens. No spam.</small></div></div></section></div>\n<div id=\"hxp\"><div class=\"hp-fb\" data-fb><span class=\"hp-bell\"><svg class=\"bl\" viewBox=\"0 0 24 24\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg><svg class=\"ck\" viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span><div class=\"hp-fb-t\"><b data-fb-t>Pre-booking opens soon</b><span data-fb-s>Be the first to get the link</span></div><button type=\"button\" class=\"hx-b\" data-open><span>Notify me</span></button></div><div class=\"hp-m\" aria-hidden=\"true\"><div class=\"hp-bd\" data-m-close></div><div class=\"hp-sh\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"hxpT\"><button type=\"button\" class=\"hp-ic hp-x\" data-m-close aria-label=\"Close\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button><div class=\"hp-body\">\n{% form 'customer', id: 'hxpForm' %}\n{% if form.posted_successfully? %}\n<i data-fok hidden></i><div class=\"hp-v hp-done\" data-v-done><div class=\"hp-ck s\"><svg viewBox=\"0 0 64 64\"><circle cx=\"32\" cy=\"32\" r=\"29\"/><path d=\"M20 33l8 8 16-17\"/></svg></div><h3 class=\"s\" style=\"--d:.15s\" data-done-h>You're on the list.</h3><p class=\"hp-p s\" style=\"--d:.25s\" data-done-msg>Keep an eye on your inbox. We'll email you the pre-booking link as soon as it opens.</p><ul class=\"hp-next hx-gl s\" style=\"--d:.38s\"><li><i>✓</i><div><b>You're registered</b><span>Your spot on the early list is saved.</span></div></li><li><i>2</i><div><b>Pre-booking opens</b><span>In a few days. You hear about it first.</span></div></li><li><i>3</i><div><b>Reserve your pair</b><span>Pick your size and colourway before launch.</span></div></li></ul><button type=\"button\" class=\"hx-b hx-b-gl hx-gl s\" style=\"--d:.5s\" data-m-close>Back to Adapt</button></div>\n{% else %}\n<div class=\"hp-v\" data-v-form><span class=\"hp-bell hp-top hp-st\" style=\"--d:.12s\"><svg class=\"bl\" viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg><i></i></span><span class=\"hp-live hp-st\" style=\"--d:.2s\"><i></i>Pre-booking opens in a few days</span><h3 id=\"hxpT\" class=\"hp-st\" style=\"--d:.27s\">Be first to pre-book.</h3><p class=\"hp-p hp-st\" style=\"--d:.34s\">Get the pre-booking link first.</p>\n{%- if form.errors -%}<div class=\"hp-err\" data-ferr role=\"alert\">{{ form.errors | default_errors }}</div>{%- endif -%}\n<input type=\"hidden\" name=\"contact[tags]\" value=\"adapt-prebooking,notify-me,hypercourt-adapt\"><div class=\"hp-f hp-st\" style=\"--d:.41s\" data-f=\"name\"><svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 3.6-7 8-7s8 3 8 7\"/></svg><input id=\"hxpN\" name=\"contact[first_name]\" required minlength=\"2\" type=\"text\" placeholder=\" \" autocomplete=\"name\" enterkeyhint=\"next\"><label for=\"hxpN\">Full name</label></div><div class=\"hp-f hp-st\" style=\"--d:.47s\" data-f=\"email\"><svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><path d=\"M4 7l8 6 8-6\"/></svg><input id=\"hxpE\" required value=\"{{ form.email | escape }}\" type=\"email\" name=\"contact[email]\" placeholder=\" \" autocomplete=\"email\" inputmode=\"email\" enterkeyhint=\"next\"><label for=\"hxpE\">Email</label></div><div class=\"hp-f hp-tel hp-st\" style=\"--d:.53s\" data-f=\"phone\"><svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><rect x=\"6\" y=\"2.5\" width=\"12\" height=\"19\" rx=\"3\"/><path d=\"M11 18h2\"/></svg><input id=\"hxpP\" type=\"tel\" name=\"contact[phone]\" required pattern=\"[+0-9\\s\\(\\)\\-]{10,20}\" placeholder=\" \" autocomplete=\"tel\" inputmode=\"tel\" maxlength=\"20\" enterkeyhint=\"done\"><label for=\"hxpP\">Mobile number (+91)</label></div><div class=\"hp-st\" style=\"--d:.6s\"><button type=\"submit\" class=\"hx-b hx-b-red hp-go\" data-go><svg viewBox=\"0 0 24 24\" stroke-width=\"2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg><span>Notify me</span></button><p class=\"hp-trust\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2.5\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/></svg>Your details stay with HNDRD. Unsubscribe anytime.</p></div></div>\n{% endif %}\n{% endform %}\n</div></div></div></div>\n<script>\n(function(){var root=document.getElementById('hx'),P=document.getElementById('hxp');if(!root||!P||root.dataset.ready)return;root.dataset.ready='true';var q=function(s,c){return(c||P).querySelector(s)},qa=function(s,c){return Array.prototype.slice.call((c||P).querySelectorAll(s))},M=q('.hp-m'),fb=q('[data-fb]'),html=document.documentElement,previousOverflow='',opener=null,FINE=matchMedia('(hover:hover) and (pointer:fine)').matches;function bar(){fb.classList.toggle('show',!M.classList.contains('open'))}function open(btn){if(M.classList.contains('open'))return;opener=btn||document.activeElement;previousOverflow=html.style.overflow;html.style.overflow='hidden';M.classList.add('open');M.setAttribute('aria-hidden','false');bar();q('.hp-x').focus({preventScroll:true})}function close(){if(!M.classList.contains('open'))return;M.classList.remove('open');M.setAttribute('aria-hidden','true');html.style.overflow=previousOverflow;bar();if(opener&&FINE)opener.focus({preventScroll:true})}document.addEventListener('click',function(e){var b=e.target.closest('[data-open]');if(b&&(root.contains(b)||P.contains(b))){e.preventDefault();open(b)}});qa('[data-m-close]').forEach(function(b){b.addEventListener('click',close)});document.addEventListener('keydown',function(e){if(M.classList.contains('open')&&e.key==='Escape')close()});var n=q('#hxpN'),e=q('#hxpE'),ph=q('#hxpP');if(n&&e&&ph){n.addEventListener('keydown',function(x){if(x.key==='Enter'){x.preventDefault();e.focus()}});e.addEventListener('keydown',function(x){if(x.key==='Enter'){x.preventDefault();ph.focus()}})}M.addEventListener('keydown',function(e){if(e.key!=='Tab'||!M.classList.contains('open'))return;var a=qa('button:not([disabled]),input:not([type=\"hidden\"]):not([disabled]),a[href],[tabindex=\"0\"]',M).filter(function(x){return x.getClientRects().length});if(!a.length)return;if(e.shiftKey&&document.activeElement===a[0]){e.preventDefault();a[a.length-1].focus()}else if(!e.shiftKey&&document.activeElement===a[a.length-1]){e.preventDefault();a[0].focus()}});if(q('[data-fok]')){var vf=q('[data-v-form]'),vd=q('[data-v-done]');if(vf)vf.hidden=true;if(vd){vd.hidden=false;requestAnimationFrame(function(){vd.classList.add('show')})}fb.classList.add('done');q('[data-jb] span',root).textContent='Watch your inbox';q('[data-js]',root).textContent='You’re registered. We’ll email you when pre-booking opens.';q('[data-open] span',fb).textContent='Watch your inbox';q('[data-fb-t]').textContent=\"You're on the list\";q('[data-fb-s]').textContent='We’ll email you when pre-booking opens';open(q('[data-jb]',root))}else if(q('[data-ferr]'))open(q('[data-jb]',root));setTimeout(bar,1300)})();\n</script>",
