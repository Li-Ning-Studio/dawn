ding:36px 20px 22px}\n.hp-f input{max-width:100%}.hp-f label{max-width:calc(100% - 58px)}\n.hp-fb{max-width:calc(100% - 16px);width:calc(100% - 16px);gap:9px}\n.hp-fb .hx-b{padding:0 14px;font-size:13px}.hp-fb-t b{font-size:12px}.hp-fb-t span{font-size:11px}\n}\n@media(max-width:380px){.hx-h1{font-size:clamp(34px,9.5vw,42px)}.hx-chip{font-size:11px}.hx-trk{--g:5px;padding-left:10px;padding-right:10px;scroll-padding-left:10px}.hx-cf{width:48px;height:48px}.hx-cc b{font-size:9px}.hp-fb .hp-bell{width:36px;height:36px}.hp-fb .hx-b{padding:0 11px}}\n</style><section class=\"hx-hero\">\n<div class=\"hx-aura\"><i class=\"a1\"></i><i class=\"a2\"></i><i class=\"a3\"></i></div>\n<div class=\"hx-grid\"></div>\n<div class=\"hx-copy\">\n<div data-rv style=\"--d:.05s\">\n<span class=\"hx-pill hx-gl\">\n<span class=\"hx-pill-ic\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.4\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg></span>\nHNDRD Hypercourt<span class=\"sep\"></span><span class=\"sub\">Pre-booking opens soon</span>\n</span>\n</div>\n<h1 class=\"hx-h1\" data-rv style=\"--d:.15s\"><span class=\"l1\">Adapt to the</span><span class=\"l2\">impossible.</span></h1>\n<p class=\"hx-sub\" data-rv style=\"--d:.3s\">Dial-in lockdown fit, energy-return cushioning and glue-like grip. <b>Pre-booking opens in a few days. Get notified and secure your pair first.</b></p>\n</div>\n<div class=\"hx-stage\" data-rv style=\"--d:.45s\">\n<div class=\"hx-par\">\n<div class=\"hx-float\">\n<img class=\"hx-shoe\" src=\"{{ hero_src }}\" alt=\"HNDRD Hypercourt Adapt badminton shoe\" width=\"1800\" height=\"1000\" fetchpriority=\"high\" onerror=\"this.style.display='none'\">\n</div>\n</div>\n</div>\n<div class=\"hx-chips\" data-rv style=\"--d:.65s\">\n<span class=\"hx-chip hx-gl\"><i></i>Adapt Dial</span>\n<span class=\"hx-chip hx-gl\"><i></i>Energy return midsole</span>\n<span class=\"hx-chip hx-gl\"><i></i>Flyknit upper</span>\n<span class=\"hx-chip hx-gl\"><i></i>Active Grip outsole</span>\n</div>\n</section>\n<section class=\"hx-join\">\n<div class=\"hx-join-glow\"></div>\n<div class=\"hx-jc hx-gl\" data-rv>\n<div>\n<p class=\"hx-eb\">Early access</p>\n<h2>Be first on court.</h2>\n<p class=\"d\">Pre-booking for Hypercourt Adapt opens in a few days. Leave your details and get the pre-booking link the moment it goes live.</p>\n</div>\n<div class=\"hx-js-side\">\n<button type=\"button\" class=\"hx-b hx-b-red\" data-open data-jb><span>Notify me</span><svg class=\"hx-arr\" viewBox=\"0 0 24 24\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>\n<small data-js>One alert when pre-booking opens. No spam.</small>\n</div>\n</div>\n</section>\n<section class=\"hx-ap\" id=\"hx-ap\">\n<div class=\"hx-ap-glow\"></div>\n<div class=\"hx-ap-h\" data-rv>\n<div>\n<p class=\"hx-eb\">Inside the shoe</p>\n<h2>Engineered to adapt.</h2>\n</div>\n<div class=\"hx-nav\">\n<button type=\"button\" class=\"hx-ar hx-gl\" data-prev aria-label=\"Previous\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M15 5l-7 7 7 7\"/></svg></button>\n<button type=\"button\" class=\"hx-ar hx-gl\" data-next aria-label=\"Next\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M9 5l7 7-7 7\"/></svg></button>\n</div>\n</div>\n<div class=\"hx-tw\">\n<div class=\"hx-trk\" data-trk>\n{%- for f in poster_files -%}\n{%- assign i = forloop.index0 -%}\n{%- assign fn = f | strip -%}\n{%- assign t = poster_titles[i] | strip -%}\n<div class=\"hx-c\" data-rv style=\"--d:{{ forloop.index0 | modulo: 4 | times: 0.08 }}s\" role=\"button\" tabindex=\"0\" aria-label=\"View {{ t }}\" data-full=\"{{ fn | file_img_url: '1800x' }}\">\n<div class=\"hx-cf\">\n<img src=\"{{ fn | file_img_url: '900x' }}\" alt=\"{{ t }}\" width=\"924\" height=\"1308\" loading=\"lazy\" decoding=\"async\" draggable=\"false\" onload=\"this.classList.add('ok')\" onerror=\"this.parentNode.classList.add('miss')\">\n<span class=\"hx-miss\">Upload {{ fn }}</span>\n<span class=\"hx-zoom hx-gl\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7\"/></svg></span>\n</div>\n<div class=\"hx-cc\"><span>{{ poster_tags[i] | strip }}</span><b>{{ t }}</b></div>\n</div>\n{%- endfor -%}\n</div>\n<div class=\"hx-dw\"><div class=\"hx-dots hx-gl\" data-dots></div></div>\n</div>\n</section>\n<div class=\"hxp\" id=\"hxp\">\n<div class=\"hp-fb\" data-fb>\n<span class=\"hp-bell\">\n<svg class=\"bl\" viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg>\n<svg class=\"ck\" viewBox=\"0 0 24 24\" stroke-width=\"2.6\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n<i></i>\n</span>\n<div class=\"hp-fb-t\"><b data-fb-t>Pre-booking opens soon</b><span data-fb-s>Be the first to get the link</span></div>\n<button type=\"button\" class=\"hx-b hx-b-red\" data-open><span>Notify me</span></button>\n</div>\n<div class=\"hp-m\" aria-hidden=\"true\">\n<div class=\"hp-bd\" data-m-close></div>\n<div class=\"hp-sh\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"hxpT\">\n\n<button type=\"button\" class=\"hp-ic hx-gl hp-x\" data-m-close aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.6\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n<div class=\"hp-body\">\n<div class=\"hp-v\" data-v-form>\n<span class=\"hp-bell hp-top hp-st\" style=\"--d:.12s\"><svg class=\"bl\" viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg><i></i></span>\n<span class=\"hp-live hp-st\" style=\"--d:.2s\"><i></i>Pre-booking opens in a few days</span>\n<h3 id=\"hxpT\" class=\"hp-st\" style=\"--d:.27s\">Be first to pre-book.</h3>\n<p class=\"hp-p hp-st\" style=\"--d:.34s\">Leave your details and we will send you the pre-booking link for Hypercourt Adapt the moment it goes live.</p>\n{% form 'customer', id: 'hxpForm', novalidate: 'novali