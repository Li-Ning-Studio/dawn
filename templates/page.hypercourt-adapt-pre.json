aw .6s .65s var(--e) forwards}\n.hp-done .hp-p{margin-bottom:22px!important}\n.hp-done .hp-p b{color:var(--t1);font-weight:600}\n.hp-next{border-radius:20px;padding:6px 16px!important;list-style:none}\n.hp-next li{display:flex;gap:14px;align-items:flex-start;padding:12px 0;border-bottom:1px solid #ffffff14}\n.hp-next li:last-child{border-bottom:0}\n.hp-next li i{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:12px;font-weight:700;background:#ffffff14;color:var(--t1)}\n.hp-next li:first-child i{background:#30d158;color:#000}\n.hp-next li b{display:block;font-size:14px;font-weight:600;color:var(--t1)}\n.hp-next li span{display:block;font-size:13px;color:var(--t2);margin-top:2px;line-height:1.4}\n.hp-done .hx-b{width:100%;height:54px;margin-top:20px}\n@media(max-width:760px){.hp-m{padding:16px}\n.hp-sh{border-radius:28px;max-height:calc(100svh - 32px)}\n.hp-body{max-height:calc(100svh - 32px);padding:34px 22px 24px}\n.hp-body h3{font-size:27px}\n.hp-x{top:14px;right:14px}\n}\n.hp-lb{padding:70px 16px 100px;z-index:2147483001}\n.hp-lb .hp-bd{background:#000000cc;}\n.hp-fig{position:relative;z-index:1;margin:0}\n.hp-fig img{width:auto;height:auto;max-width:min(640px,calc(100vw - 32px));max-height:calc(100svh - 170px);border-radius:22px;box-shadow:0 40px 100px #000000b2;opacity:0;transform:scale(.92);transition:opacity .5s var(--e),transform .7s var(--sh)}\n.hp-lb.open .hp-fig img{opacity:1;transform:none}\n.hp-lb.open .hp-fig.sw img{opacity:0;transform:scale(.97);transition-duration:.22s}\n.hp-lbx{position:absolute;top:calc(16px + env(safe-area-inset-top));right:16px;z-index:2}\n.hp-bar{position:absolute;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:2;display:flex;align-items:center;gap:4px;padding:5px;border-radius:999px}\n.hp-bar span{min-width:64px;text-align:center;font-size:14px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--t1)}\n.hx-join{position:relative;padding:clamp(20px,4vw,72px) 20px 0}\n.hx-join-glow{position:absolute;left:50%;top:62%;width:min(1000px,130vw);aspect-ratio:2;transform:translate(-50%,-50%);z-index:-1;pointer-events:none;background:radial-gradient(closest-side,#e1060059,#e1060014 60%,transparent)}\n.hx-join-glow::before,.hx-join-glow::after{content:'';position:absolute;border-radius:50%}\n.hx-join-glow::before{width:260px;height:260px;left:22%;top:14%;opacity:.85;background:radial-gradient(closest-side,#e10600,#e1060000);animation:hx-b1 14s ease-in-out infinite}\n.hx-join-glow::after{width:220px;height:220px;left:60%;top:40%;background:radial-gradient(closest-side,#ff3b30,#ff3b3000);opacity:.7;animation:hx-b2 17s ease-in-out infinite}\n.hx-jc{position:relative;max-width:1120px;margin:0 auto;border-radius:36px;padding:clamp(30px,5vw,64px);display:grid;grid-template-columns:1fr auto;align-items:center;gap:36px;background:linear-gradient(135deg,#ffffff1f,#ffffff08);}\n.hx-jc h2{font-size:clamp(34px,4.8vw,60px);font-weight:700;letter-spacing:-.045em;line-height:1.02;color:var(--t1)}\n.hx-jc p.d{margin-top:14px!important;max-width:480px;color:var(--t2);font-size:17px;line-height:1.5}\n.hx-js-side{display:flex;flex-direction:column;align-items:center;gap:12px}\n.hx-js-side small{font-size:12px;color:var(--t3)}\n.hx-js-side .hx-b{height:58px;padding:0 34px;font-size:17px}\n@media(max-width:760px){.hx-jc{grid-template-columns:1fr;gap:28px;border-radius:30px}\n.hx-js-side{align-items:stretch}\n.hx-js-side .hx-b{width:100%}\n}\n@keyframes hx-a1{0%,100%{transform:translate(-50%,-50%) scale(1)}\n50%{transform:translate(calc(-50% + 40px),calc(-50% - 30px)) scale(1.08)}\n}\n@keyframes hx-a2{0%,100%{transform:translate(-50%,-50%)}\n50%{transform:translate(calc(-50% - 50px),calc(-50% + 30px))}\n}\n@keyframes hx-float{0%,100%{transform:translateY(0)}\n50%{transform:translateY(-14px)}\n}\n@keyframes hx-ping{0%{box-shadow:0 0 0 0 #ff3b308c}\n80%,100%{box-shadow:0 0 0 9px #ff3b3000}\n}\n@keyframes hx-rip