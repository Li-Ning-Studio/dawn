      "settings": {
        "custom_liquid": "{%- comment -%}\nHNDRD Hypercourt Adapt pre-booking page. Paste into a Custom Liquid section (padding 0).\nFiles (Content > Files): adapt-hero.png (transparent shoe), adapt-01.jpg ... adapt-08.jpg (A+ posters).\nSignups save to Customers, tagged adapt-prebooking, notify-me, hypercourt-adapt.\nSegment: customer_tags CONTAINS 'adapt-prebooking' (create in Shopify Admin > Customers > Segments)\n{%- endcomment -%}\n{%- assign hero_src = 'adapt-hero.png' | file_img_url: '1800x' -%}\n{%- assign poster_files = 'adapt-01.jpg,adapt-02.jpg,adapt-03.jpg,adapt-04.jpg,adapt-05.jpg,adapt-06.jpg,adapt-07.jpg,adapt-08.jpg' | split: ',' -%}\n{%- assign poster_titles = 'Adapt to the impossible,Energy return midsole,Adapt Dial system,Three colourways,Flyknit upper,Anatomy of Adapt,Midfoot support plate,Active Grip outsole' | split: ',' -%}\n{%- assign poster_tags = 'Hypercourt,Impact to bounce,Secure lockdown fit,Choose your Adapt,Flexible and breathable,Built layer by layer,Locked-in stability,Glue-like traction' | split: ',' -%}\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<div class=\"hx\" id=\"hx\">\n<style>.hx svg,.hxp svg{fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round}.hx,.hxp{--red:#e10600;--red2:#ff3b30;--bg:#000;--t1:#f5f5f7;--t2:#a1a1a6;--t3:#6e6e73;--e:cubic-bezier(.22,1,.36,1);--sh:cubic-bezier(.32,.72,0,1);--f:-apple-system,BlinkMacSystemFont,\"SF Pro Display\",\"Inter\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;font-family:var(--f);color:var(--t1);letter-spacing:-.011em;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.hx *,.hx *::before,.hx *::after,.hxp *,.hxp *::before,.hxp *::after{box-sizing:border-box}.hx img,.hxp img{display:block;max-width:100%}.hx button,.hxp button{font-family:inherit;-webkit-tap-highlight-color:transparent}.hx h1,.hx h2,.hx