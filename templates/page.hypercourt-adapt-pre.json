form:translateZ(0);transition:transform .8s var(--e),box-shadow .8s var(--e)}\n.hx-cf::after{content:'';position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px #ffffff17;pointer-events:none}\n.hx-cf img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--e);user-select:none;-webkit-user-drag:none}\n.hx-cf img.ok{opacity:1;transform:none}\n.hx-miss{position:absolute;inset:0;display:none;place-items:center;padding:14px;text-align:center;font-size:12px;color:var(--t3)}\n.hx-cf.miss .hx-miss{display:grid}\n.hx-zoom{position:absolute;right:10px;top:10px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;opacity:0;transform:scale(.8);transition:opacity .5s var(--e),transform .5s var(--e)}\n.hx-zoom svg{width:14px;height:14px}\n.hx-cc{padding:14px 2px 0}\n.hx-cc span{display:block;font-size:12px;font-weight:600;color:var(--red2);margin-bottom:3px}\n.hx-cc b{display:block;font-size:16px;font-weight:600;letter-spacing:-.015em;color:var(--t1);line-height:1.3}\n.hx-c:focus-visible .hx-cf{box-shadow:0 0 0 2px #000,0 0 0 4px var(--red2)}\n@media(hover:hover){.hx-c:hover .hx-cf{transform:translateY(-6px);box-shadow:0 34px 60px -26px #e106008c}\n.hx-c:hover .hx-cf img.ok{transform:scale(1.05)}\n.hx-c:hover .hx-zoom{opacity:1;transform:none}\n}\n@media(hover:none){.hx-zoom{opacity:1;transform:none;width:28px;height:28px;right:8px;top:8px}\n}\n.hx-trk.nosnap{scroll-snap-type:none}\n.hx-trk.drag{cursor:grabbing;user-select:none}\n.hx-dw{text-align:center;margin-top:22px}\n.hx-dots{display:inline-flex;align-items:center;gap:8px;padding:11px 14px;border-radius:999px}\n.hx-dots[hidden]{display:none}\n.hx-d{width:8px;height:8px;padding:0;border:0;border-radius:999px;background:#ffffff40;cursor:pointer;transition:width .6s var(--e),background .4s}\n.hx-d.on{width:28px;background:var(--red2)}\n@media(max-width:899px){.hx-cc{padding-top:10px}\n.hx-cc span{font-size:11px}\n.hx-cc b{font-size:13px}\n.hx-ar{width:42px;height:42px}\n}\