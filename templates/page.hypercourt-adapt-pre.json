ign-items:stretch}\n.hx-js-side .hx-b{width:100%;height:52px}\n.hx-js-side small{text-align:center}\n.hx-ap{padding:62px 0 35px}\n.hx-ap-h{padding:0 20px;align-items:center;margin-bottom:18px;gap:10px}\n.hx-ap-h h2{font-size:clamp(28px,7vw,38px)}\n.hx-nav{gap:6px}\n.hx-ar{width:36px;height:36px}\n.hx-trk{--g:8px;display:grid;grid-auto-flow:column;grid-template-rows:1fr;grid-auto-columns:calc((100% - 3*var(--g) - 32px)/4);column-gap:var(--g);overflow-x:auto;padding:4px 16px 14px;scroll-padding-left:16px;scroll-snap-type:x mandatory;align-items:stretch}\n.hx-c,.hx-c:nth-child(n){min-width:0;scroll-snap-align:start}\n.hx-cf{width:50px;height:50px;max-width:100%;aspect-ratio:1;margin:0 auto;border-radius:12px}\n.hx-cf img{object-fit:cover}\n.hx-zoom{display:none}\n.hx-cc{padding:8px 0 0;text-align:center}\n.hx-cc span{display:none}\n.hx-cc b{font-size:10px;font-weight:600;line-height:1.25;overflow-wrap:anywhere}\n.hx-dw{margin-top:4px}\n.hp-fb{max-width:calc(100% - 24px);gap:8px;padding:7px;border-radius:22px}\n.hp-bell{width:36px;height:36px}\n.hp-fb-t b{font-size:12px}\n.hp-fb-t span{font-size:10px}\n.hp-fb .hx-b{padding:0 12px;height:40px;font-size:12px}\n.hp-m{padding:12px}\n.hp-sh{max-height:calc(100dvh - 24px);border-radius:24px}\n.hp-body{max-height:calc(100dvh - 24px);padding:36px 20px 22px}\n.hp-body h3{font-size:27px;max-width:calc(100% - 20px)}\n.hp-p{font-size:14px}\n.hp-f input{height:56px}\n.hp-go{height:54px}\n.hp-trust{font-size:11px;line-height:1.4}\n\n}\n\n@media(max-width:390px){.hx-hero{padding-left:16px;padding-right:16px}\n.hx-h1{font-size:clamp(39px,10vw,47px)}\n.hx-trk{grid-auto-columns:calc((100% - 3*var(--g) - 32px)/4)}\n.hx-cf{height:48px;width:48px}\n.hx-cc b{font-size:9px}\n.hp-fb-t span{display:none}\n}\n\n\n\n@media(max-width:899px){\n.hx,.hx section{max-width:100%}\n.hx-copy,.hx-stage,.hx-jc,.hx-ap-h{min-width:0}\n\n.hx-hero{padding:48px 18px 34px}\n.hx-h1{font-size:clamp(42px,10.6vw,68px);overflow-wrap:normal}\n.hx-sub{max-width:36ch;margin:16px auto 0!important}\n\n.hx-stage{margin-top:10px}\n.hx-shoe{max-width:100%}\n.hx-chips{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n\n.hx-join{padding:28px 14px 0}\n.hx-jc{padding:26px 20px}\n.hx-jc h2{overflow-wrap:break-word}\n\n.hx-ap-h{padding:0 16px}\n.hx-trk{--g:8px;grid-template-rows:1fr;grid-auto-columns:calc((100% - 32px - 3*var(--g))/4);gap:var(--g);padding:6px 16px 16px;scroll-padding-left:16px}\n\n.hx-c{width:100%;min-width:0}\n.hx-cf{width:50px;height:50px;max-width:100%;border-radius:11px;aspect-ratio:1;margin:auto}\n.hx-cc{padding:7px 0 0;min-height:42px;text-align:center}\n.hx-cc b{font-size:10px;line-height:1.25;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}\n.hx-cc span{display:none}\n\n.hp-m,.hp-lb{width:100%}\n.hp-sh{width:100%}\n.hp-fb{width:calc(100% - 20px)}\n.hp-fb-t{flex:1;min-width:0}\n.hp-fb .hx-b{white-space:nowrap}\n\n}\n\n@media(max-width:390px){.hx-trk{grid-auto-columns:calc((100% - 32px - 3*var(--g))/4)}\n.hx-cc b{font-size:9px}\n.hx-h1{font-size:clamp(39px,10.4vw,45px)}\n}\n\n</style><section class=\"hx-hero\">\n<div class=\"hx-aura\"><i class=\"a1\"></i><i class=\"a2\"></i><i class=\"a3\"></i></div>\n<div class=\"hx-grid\"></div>\n<div class=\"hx-copy\">\n<div>\n<span class=\"hx-pill hx-gl\">\n<span class=\"hx-pill-ic\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.4\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg></span>\nHNDRD Hypercourt<span class=\"sep\"></span><span class=\"sub\">Pre-booking opens soon</span>\n</span>\n</div>\n<h1 class=\"hx-h1\"><span class=\"l1\">Adapt to the</span><span class=\"l2\">impossible.</span></h1>\n<p class=\"hx-sub\">Dial-in lockdown fit, energy-return cushioning and glue-like grip. <b>Pre-booking opens in a few days. Get notified and secure your pair first.</b></p>\n</div>\n<div class=\"hx-stage\">\n<div class=\"hx-par\">\n<div class=\"hx-float\">\n<img class=\"hx-shoe\" src=\"{{ hero_src }}\" alt=\"HNDRD Hypercourt Adapt badminton shoe\" width=\"1800\" height=\"1000\" fetchpriority=\"high\" onerror=\"this.style.display='none'\">\n</div>\n</div>\n</div>\n<div class=\"hx-chips\">\n<span class=\"hx-chip hx-gl\"><i></i>Adapt Dial</span>\n<span class=\"hx-chip hx-gl\"><i></i>Energy return midsole</span>\n<span class=\"hx-chip hx-gl\"><i></i>Flyknit upper</span>\n<span class=\"hx-chip hx-gl\"><i></i>Active Grip outsole</span>\n</div>\n</section>\n<section class=\"hx-join\">\n<div class=\"hx-join-glow\"></div>\n<div class=\"hx-jc hx-gl\">\n<div>\n<p class=\"hx-eb\">Early access</p>\n<h2>Be first on court.</h2>\n<p class=\"d\">Pre-booking for Hypercourt Adapt opens in a few days. Leave your details and get the pre-booking link the moment it goes live.</p>\n</div>\n<div class=\"hx-js-side\">\n<button type=\"button\" class=\"hx-b hx-b-red\" data-open data-jb><span>Notify me</span><svg class=\"hx-arr\" viewBox=\"0 0 24 24\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>\n<small data-js>One alert when pre-booking opens. No spam.</small>\n</div>\n</div>\n</section>\n<section class=\"hx-ap\" id=\"hx-ap\">\n<div class=\"hx-ap-glow\"></div>\n<div class=\"hx-ap-h\">\n<div>\n<p class=\"hx-eb\">Inside the shoe</p>\n<h2>Engineered to adapt.</h2>\n</div>\n<div class=\"hx-nav\">\n<button type=\"button\" class=\"hx-ar hx-gl\" data-prev aria-label=\"Previous\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M15 5l-7 7 7 7\"/></svg></button>\n<button type=\"button\" class=\"hx-ar hx-gl\" data-next aria-label=\"Next\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M9 5l7 7-7 7\"/></svg></button>\n</div>\n</div>\n<div class=\"hx-tw\">\n<div class=\"hx-trk\" data-trk>\n{%- for f in poster_files -%}\n{%- assign i = forloop.index0 -%}\n{%- assign fn = f | strip -%}\n{%- assign t = poster_titles[i] | strip -%}\n<div class=\"hx-c\" role=\"button\" tabindex=\"0\" aria-label=\"View {{ t }}\" data-full=\"{{ fn | file_img_url: '1800x' }}\">\n<div class=\"hx-cf\">\n<img src=\"{{ fn | file_img_url: '900x' }}\" alt=\"{{ t }}\" width=\"924\" height=\"1308\" loading=\"lazy\" decoding=\"async\" draggable=\"false\" onload=\"this.classList.add('ok')\" onerror=\"this.parentNode.classList.add('miss')\">\n<span class=\"hx-miss\">Upload {{ fn }}</span>\n<span class=\"hx-zoom hx-gl\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7\"/></svg></span>\n</div>\n<div class=\"hx-cc\"><span>{{ poster_tags[i] | strip }}</span><b>{{ t }}</b></div>\n</div>\n{%- endfor -%}\n</div>\n<div class=\"hx-dw\"><div class=\"hx-dots hx-gl\" data-dots></div></div>\n</div>\n</section>\n<div class=\"hxp\" id=\"hxp\">\n<div class=\"hp-fb\" data-fb>\n<span class=\"hp-bell\">\n<svg class=\"bl\" viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg>\n<svg class=\"ck\" viewBox=\"0 0 24 24\" stroke-width=\"2.6\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>\n<i></i>\n</span>\n<div class=\"hp-fb-t\"><b data-fb-t>Pre-booking opens soon</b><span data-fb-s>Be the first to get the link</span></div>\n<button type=\"button\" class=\"hx-b hx-b-red\" data-open><span>Notify me</span></button>\n</div>\n<div class=\"hp-m\" aria-hidden=\"true\">\n<div class=\"hp-bd\" data-m-close></div>\n<div class=\"hp-sh\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"hxpT\">\n\n<button type=\"button\" class=\"hp-ic hx-gl hp-x\" data-m-close aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" stroke-width=\"2.6\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n<div class=\"hp-body\">\n<div class=\"hp-v\" data-v-form>\n<span class=\"hp-bell hp-top hp-st\" style=\"--d:.12s\"><svg class=\"bl\" viewBox=\"0 0 24 24\" stroke-width=\"2.2\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg><i></i></span>\n<span class=\"hp-live hp-st\" style=\"--d:.2s\"><i></i>Pre-booking opens in a few days</span>\n<h3 id=\"hxpT\" class=\"hp-st\" style=\"--d:.27s\">Be first to pre-book.</h3>\n<p class=\"hp-p hp-st\" style=\"--d:.34s\">Leave your details and we will send you the pre-booking link for Hypercourt Adapt the moment it goes live.</p>\n{% form 'customer', id: 'hxpForm', return_to: 'back', novalidate: 'novalidate' %}\n{%- if form.posted_successfully? -%}\n{%- assign hx_form_success = true -%}\n<i data-fok hidden></i>\n{%- endif -%}{%- if form.errors -%}<div class=\"hp-err\" data-ferr role=\"alert\">{{ form.errors | default_errors }}</div>{%- endif -%}\n<input type=\"hidden\" name=\"contact[tags]\" value=\"adapt-prebooking,notify-me,hypercourt-adapt\">\n<input type=\"hidden\" name=\"contact[first_name]\" data-fn>\n<input type=\"hidden\" name=\"contact[last_name]\" data-ln>\n<input type=\"hidden\" name=\"contact[phone]\" data-ph>\n<div class=\"hp-f hp-st\" style=\"--d:.41s\" data-f=\"name\">\n<svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 3.6-7 8-7s8 3 8 7\"/></svg>\n<input id=\"hxpN\" type=\"text\" placeholder=\" \" autocomplete=\"name\" enterkeyhint=\"next\">\n<label for=\"hxpN\">Full name</label>\n</div>\n<div class=\"hp-f hp-st\" style=\"--d:.47s\" data-f=\"email\">\n<svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\"/><path d=\"M4 7l8 6 8-6\"/></svg>\n<input id=\"hxpE\" value=\"{{ form.email | escape }}\" type=\"email\" name=\"contact[email]\" placeholder=\" \" autocomplete=\"email\" inputmode=\"email\" enterkeyhint=\"next\">\n<label for=\"hxpE\">Email</label>\n</div>\n<div class=\"hp-f hp-tel hp-st\" style=\"--d:.53s\" data-f=\"phone\">\n<svg class=\"ic\" viewBox=\"0 0 24 24\" stroke-width=\"1.8\"><rect x=\"6\" y=\"2.5\" width=\"12\" height=\"19\" rx=\"3\"/><path d=\"M11 18h2\"/></svg>\n<span class=\"hp-cc\">+91</span>\n<input id=\"hxpP\" type=\"tel\" placeholder=\" \" autocomplete=\"tel