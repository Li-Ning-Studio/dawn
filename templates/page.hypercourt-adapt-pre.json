      "settings": {
        "custom_liquid": "{%- assign hx_form_success = false -%}\n{%- assign hero_src = 'adapt-hero.png' | file_img_url: '1800x' -%}\n{%- assign poster_files = 'adapt-01.jpg,adapt-02.jpg,adapt-03.jpg,adapt-04.jpg,adapt-05.jpg,adapt-06.jpg,adapt-07.jpg,adapt-08.jpg' | split: ',' -%}\n{%- assign poster_titles = 'Adapt to the impossible,Energy return midsole,Adapt Dial system,Three colourways,Flyknit upper,Anatomy of Adapt,Midfoot support plate,Active Grip outsole' | split: ',' -%}\n{%- assign poster_tags = 'Hypercourt,Impact to bounce,Secure lockdown fit,Choose your Adapt,Flexible and breathable,Built layer by layer,Locked-in stability,Glue-like traction' | split: ',' -%}\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<div class=\"hx\" id=\"hx\">\n<style>\n.hx svg,.hxp svg{fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round}\n.hx,.hxp{--red:#e10600;--red2:#ff3b30;--bg:#000;--t1:#f5f5f7;--t2:#a1a1a6;--t3:#6e6e73;--e:cubic-bezier(.22,1,.36,1);--sh:cubic-bezier(.32,.72,0,1);--f:-apple-system,BlinkMacSystemFont,\"SF Pro Display\",\"Inter\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;font-family:var(--f);color:var(--t1);letter-spacing:-.011em;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}\n.hx *,.hx *::before,.hx *::after,.hxp *,.hxp *::before,.hxp *::after{box-sizing:border-box}\n.hx img,.hxp img{display:block;max-width:100%}\n.hx button,.hxp button{font-family:inherit;-webkit-tap-highlight-color:transparent}\n.hx h1,.hx h2,.hxp h3,.hxp h4{font-family:var(--f);text-transform:none;margin:0}\n.hx p,.hxp p,.hxp ul{margin:0}\n.hx{position:relative;background:var(--bg);overflow:hidden;isolation:isolate;padding-bottom:110px}\n.hx-gl{background:linear-gradient(180deg,#ffffff1c,#ffffff0a);border:1px solid #ffffff1f;box-shadow:inset 0 1px 0 #ffffff24,0 12px 40px #00000059}\n.hx-b{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:10px;height:54px;padding:0 28px;border-radius:999px;border:0;cursor:pointer;font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1;color:#fff;text-decoration:none;white-space:nowrap;transition:transform .6s var(--e),box-shadow .6s var(--e),background .4s}\n.hx-b:active{transform:scale(.96)}\n.hx-b svg{width:18px;height:18px;flex:none;transition:transform .6s var(--e)}\n.hx-b-red{background:linear-gradient(180deg,#ff2d20 0%,#e10600 55%,#c20500 100%);box-shadow:inset 0 1px 0 #ffffff59,inset 0 -1px 0 #00000040,0 10px 30px -6px #e1060099}\n.hx-b-red::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(110deg,transparent 35%,#ffffff52 50%,transparent 65%);background-size:260% 100%;background-position:130% 0;transition:background-position 1.1s var(--e)}\n.hx-b-gl{color:var(--t1)}\n@media(hover:hover){.hx-b-red:hover{box-shadow:inset 0 1px 0 #ffffff59,inset 0 -1px 0 #00000040,0 18px 46px -8px #ff281ebf}\n.hx-b-red:hover::after{background-position:-30% 0}\n.hx-b-gl:hover{background:#ffffff29}\n.hx-b:hover .hx-arr{transform:translateX(4px)}\n}\n.hx-hero{position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(56px,10vh,150px) 20px clamp(36px,5vw,64px)}\n.hx-aura{position:absolute;inset:0;z-index:-2;pointer-events:none}\n.hx-aura i{position:absolute;border-radius:50%;aspect-ratio:1}\n.hx-aura .a1{width:min(980px,170vw);left:50%;top:62%;background:radial-gradient(closest-side,#e106008c,#e1060029 55%,transparent);animation:hx-a1 18s ease-in-out infinite}\n.hx-aura .a2{width:min(640px,120vw);left:16%;top:80%;background:radial-gradient(closest-side,#96000080,transparent);animation:hx-a2 23s ease-in-out infinite}\n.hx-aura .a3{width:min(560px,110vw);left:86%;top:34%;background:radial-gradient(closest-side,#ff3b3038,transparent);animation:hx-a2 27s ease-in-out in