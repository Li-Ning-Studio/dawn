(52vw, 740px);\n    height: 1px;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.06) 25%,\n      rgba(255,164,0,.72) 50%,\n      rgba(255,255,255,.06) 75%,\n      transparent\n    );\n    opacity: 0;\n    transform: translate(-50%, -50%) rotate(-8deg) scaleX(.1);\n    box-shadow: 0 0 20px rgba(255,164,0,.15);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__slash {\n    animation: b80-loader-slash .72s cubic-bezier(.16,1,.3,1) 1.38s forwards;\n  }\n\n  .b80-entry-loader__caption {\n    position: absolute;\n    z-index: 4;\n    top: calc(50% + clamp(62px, 7vw, 104px));\n    left: 50%;\n    margin: 0;\n    color: rgba(243,240,232,.46);\n    font-size: 8px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .3em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    opacity: 0;\n    transform: translateX(-50%) translateY(8px);\n  }\n\n  .b80-entry-loader.is-running .b80-entry-loader__caption {\n    animation: b80-loader-caption .6s ease 1.23s forwards;\n  }\n\n  /*\n    Exit follows the reference: the black loader lifts from\n    the bottom edge towards the top and exposes the hero below.\n  */\n  .b80-entry-loader.is-leaving {\n    cursor: default;\n    animation: b80-loader-exit .95s cubic-bezier(.76,0,.24,1) forwards;\n  }\n\n  .b80-entry-loader.is-leaving .b80-entry-loader__stage,\n  .b80-entry-loader.is-leaving .b80-entry-loader__meta {\n    animation: b80-loader-content-out .28s ease forwards;\n  }\n\n  @keyframes b80-loader-rail {\n    0% {\n      transform: scaleY(0);\n      transform-origin: top;\n    }\n    54% {\n      transform: scaleY(1);\n      transform-origin: top;\n    }\n    55% {\n      transform: scaleY(1);\n      transform-origin: bottom;\n    }\n    100% {\n      transform: scaleY(0);\n      transform-origin: bottom;\n    }\n  }\n\n  @keyframes b80-loader-meta {\n    from {\n      opacity: 0;\n      transform: translateY(8px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes b80-loader-aura {\n    from {\n      opacity: 0;\n      transform: scale(.55);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  @keyframes b80-loader-outline-rise {\n    0% {\n      opacity: 0;\n      stroke-dashoffset: 420;\n      clip-path: inset(100% 0 0 0);\n      -webkit-clip-path: inset(100% 0 0 0);\n    }\n    18% {\n      opacity: .86;\n    }\n    100% {\n      opacity: .72;\n      stroke-dashoffset: 0;\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n  }\n\n  @keyframes b80-loader-fill-rise {\n    0% {\n      opacity: 0;\n      clip-path: inset(100% 0 0 0);\n      -webkit-clip-path: inset(100% 0 0 0);\n    }\n    10% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 1;\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n  }\n\n  @keyframes b80-loader-scan-up {\n    0% {\n      opacity: 0;\n      transform: translateY(0) scaleX(.35);\n    }\n    18% {\n      opacity: 1;\n    }\n    72% {\n      opacity: .85;\n    }\n    100% {\n      opacity: 0;\n      transform: translateY(calc(-1 * clamp(112px, 10.5vw, 172px))) scaleX(1);\n    }\n  }\n\n  @keyframes b80-fragment-a {\n    0% { opacity: 0; transform: translateY(-17px) rotate(90deg) scaleX(.15); }\n    55% { opacity: .78; transform: translateY(0) rotate(90deg) scaleX(1); }\n    100% { opacity: 0; transform: translateY(10px) rotate(90deg) scaleX(.25); }\n  }\n\n  @keyframes b80-fragment-b {\n    0% { opacity: 0; transform: translateX(-19px) rotate(18deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(18deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(11px) rotate(18deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-c {\n    0% { opacity: 0; transform: translateX(-18px) rotate(-18deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(-18deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(10px) rotate(-18deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-d {\n    0% { opacity: 0; transform: translateX(19px) rotate(-17deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(-17deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(-10px) rotate(-17deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-e {\n    0% { opacity: 0; transform: translateX(18px) rotate(17deg) scaleX(.15); }\n    55% { opacity: .72; transform: translateX(0) rotate(17deg) scaleX(1); }\n    100% { opacity: 0; transform: translateX(-10px) rotate(17deg) scaleX(.3); }\n  }\n\n  @keyframes b80-fragment-f {\n    0% { opacity: 0; transform: translateY(17px) rotate(90deg) scaleX(.15); }\n    55% { opacity: .78; transform: translateY(0) rotate(90deg) scaleX(1); }\n    100% { opacity: 0; transform: translateY(-10px) rotate(90deg) scaleX(.25); }\n  }\n\n  @keyframes b80-loader-slash {\n    0% {\n      opacity: 0;\n      transform: translate(-50%, -50%) rotate(-8deg) scaleX(.1);\n    }\n    30% {\n      opacity: 1;\n    }\n    100% {\n      opacity: .38;\n      transform: translate(-50%, -50%) rotate(-8deg) scaleX(1);\n    }\n  }\n\n  @keyframes b80-loader-caption {\n    from {\n      opacity: 0;\n      transform: translateX(-50%) translateY(8px);\n    }\n    to {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n  }\n\n  @keyframes b80-loader-content-out {\n    to {\n      opacity: 0;\n      transform: translateY(-12px);\n    }\n  }\n\n  @keyframes b80-loader-exit {\n    0% {\n      clip-path: inset(0 0 0 0);\n      -webkit-clip-path: inset(0 0 0 0);\n    }\n    100% {\n      clip-path: inset(0 0 100% 0);\n      -webkit-clip-path: inset(0 0 100% 0);\n    }\n  }\n\n  @media (max-width: 749px) {\n    .b80-entry-loader::after {\n      left: 18px;\n    }\n\n    .b80-entry-loader__meta {\n      font-size: 7px;\n      letter-spacing: .17em;\n    }\n\n    .b80-entry-loader__meta--top {\n      top: 24px;\n      left: 34px;\n    }\n\n    .b80-entry-loader__meta--bottom {\n      right: 20px;\n      bottom: 22px;\n    }\n\n    .b80-entry-loader__mark {\n      width: clamp(175px, 52vw, 238px);\n    }\n\n    .b80-entry-loader__slash {\n      width: 82vw;\n    }\n\n    .b80-entry-loader__caption {\n      top: calc(50% + 70px);\n      font-size: 7px;\n      letter-spacing: .24em;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .b80-entry-loader.is-running .b80-entry-loader__outline {\n      animation-duration: .25s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__fill {\n      animation-delay: .18s;\n      animation-duration: .25s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__mark::after {\n      animation-duration: .2s;\n      animation-delay: .1s;\n    }\n\n    .b80-entry-loader.is-running .b80-entry-loader__fragment,\n    .b80-entry-loader.is-running .b80-entry-loader__slash,\n    .b80-entry-loader.is-running .b80-entry-loader__caption,\n    .b80-entry-loader.is-running .b80-entry-loader__meta,\n    .b80-entry-loader.is-running::after {\n      animation-duration: .01ms !important;\n      animation-delay: 0s !important;\n    }\n\n    .b80-entry-loader.is-leaving {\n      animation-duration: .35s;\n    }\n  }\n</style>\n\n<div\n  class=\"b80-entry-loader\"\n  data-b80-entry-loader\n  aria-hidden=\"true\"\n>\n  <span class=\"b80-entry-loader__meta b80-entry-loader__meta--top\">\n    HNDRD Performance\n  </span>\n\n  <div class=\"b80-entry-loader__stage\">\n    <div class=\"b80-entry-loader__mark\">\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n      <span class=\"b80-entry-loader__fragment\"></span>\n\n      <svg\n        class=\"b80-entry-loader__svg\"\n        viewBox=\"0 0 194 104\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        focusable=\"false\"\n      >\n        <!-- Exact geometry traced from the supplied HNDRD mark -->\n        <path\n          class=\"b80-entry-loader__outline\"\n          d=\"M150 31L110 34L31 73L56 73L89 56L124 73L148 73L102 50Z\"\n        />\n        <path\n          class=\"b80-entry-loader__fill\"\n          d=\"M150 31L110 34L31 73L56 73L89 56L124 73L148 73L102 50Z\"\n        />\n      </svg>\n    </div>\n\n    <span class=\"b80-entry-loader__slash\"></span>\n\n    <p class=\"b80-entry-loader__caption\">\n      Nitrix Bullet 80\n    </p>\n  </div>\n\n  <span class=\"b80-entry-loader__meta b80-entry-loader__meta--bottom\">\n    B80 / 5.8 / Pro Attack\n  </span>\n</div>\n\n<noscript>\n  <style>\n    .b80-entry-loader {\n      display: none !important;\n    }\n  </style>\n</noscript>\n\n<script>\n  (function () {\n    var loader = document.querySelector('[data-b80-entry-loader]');\n\n    if (!loader || loader.dataset.initialised === 'true') {\n      return;\n    }\n\n    loader.dataset.initialised = 'true';\n\n    var reducedMotion = window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n    /*\n      Desktop and mobile use the same sequence.\n      Reduced-motion users get a shorter, simpler version.\n    */\n    var minimumTime = reducedMotion ? 450 : 2700;\n    var maximumTime = reducedMotion ? 1100 : 5600;\n    var exitTime = reducedMotion ? 380 : 980;\n    var startTime = performance.now();\n    var hasExited = false;\n    var pageReady = document.readyState === 'complete';\n\n    requestAnimationFrame(function () {\n      loader.classList.add('is-running');\n    });\n\n    function unlockPage() {\n      document.documentElement.classList.remove('b80-page-loading');\n\n      if (document.body) {\n        document.body.classList.remove('b80-page-loading');\n      }\n    }\n\n    function beginExit() {\n      if (hasExited) {\n        return;\n      }\n\n      hasExited = true;\n      loader.classList.add('is-leaving');\n\n      /*\n        Start the hero entrance animation underneath the upward wipe.\n      */\n      window.setTimeout(unlockPage, reducedMotion ? 0 : 110);\n\n      window.dispatchEvent(\n        new CustomEvent('b80:loader-exit')\n      );\n\n      window.setTimeout(function () {\n        loader.remove();\n      }, exitTime + 100);\n    }\n\n    function exitWhenAllowed() {\n      var elapsed = performance.now() - startTime;\n      var remaining = Math.max(0, minimumTime - elapsed);\n\n      window.setTimeout(beginExit, remaining);\n    }\n\n    if (pageReady) {\n      exitWhenAllowed();\n    } else {\n      window.addEventListener(\n        'load',\n        function () {\n          pageReady = true;\n          exitWhenAllowed();\n        },\n        { once: true }\n      );\n    }\n\n    /*\n      Safety fallback: a failed external asset can never trap\n      the visitor behind the loader.\n    */\n    window.setTimeout(beginExit, maximumTime);\n\n    /*\n      Shopify's editor can reload sections without reloading the page.\n      Remove any injected duplicate immediately.\n    */\n    document.addEventListener(\n      'shopify:section:load',\n      function (event) {\n        var duplicate = event.target.querySelector(\n          '[data-b80-entry-loader]'\n        );\n\n        if (duplicate && duplicate !== loader) {\n          duplicate.remove();\n        }\n      }\n    );\n  })();\n</script>",
