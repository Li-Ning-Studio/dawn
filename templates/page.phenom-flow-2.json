      "settings": {
        "custom_liquid": "{% comment %}\n  PHENOM FLOW – scroll-scrubbed hero video (HNDRD)\n  Paste into a Custom Liquid section (or a section file).\n{% endcomment %}\n\n<style>\n  .hsv {\n    --hsv-scroll: 900vh;\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    height: var(--hsv-scroll);\n    background: #000;\n    isolation: isolate;\n  }\n\n  .hsv__stage {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    height: 100svh;\n    overflow: hidden;\n    background: #000;\n  }\n\n  .hsv__video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n    background: #000;\n    pointer-events: none;\n    opacity: 0;\n    transform: scale(1.04);\n    transition: opacity 1.1s cubic-bezier(.2,.7,.2,1), transform 1.6s cubic-bezier(.2,.7,.2,1);\n  }\n  .hsv.is-ready .hsv__video {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  /* cinematic vignette */\n  .hsv__shade {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background:\n      linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 72%, rgba(0,0,0,.6) 100%),\n      radial-gradient(120% 90% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,.45) 100%);\n  }\n\n  /* TEXT OVERLAY */\n  .hsv__intro {\n    position: absolute;\n    z-index: 2;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    text-align: center;\n    color: #fff;\n    pointer-events: none;\n    will-change: transform, opacity;\n  }\n\n  .hsv__intro h2 {\n    margin: 0;\n    color: inherit;\n    font-family: inherit;\n    font-size: clamp(42px, 7vw, 110px);\n    font-weight: 900;\n    line-height: .95;\n    letter-spacing: -.055em;\n    text-transform: uppercase;\n    opacity: 0;\n    transform: translate3d(0, 24px, 0);\n    filter: blur(8px);\n    transition: opacity 1s ease, transform 1.2s cubic-bezier(.2,.7,.2,1), filter 1s ease;\n  }\n\n  .hsv__intro p {\n    margin: 18px 0 0;\n    color: inherit;\n    font-family: inherit;\n    font-size: clamp(12px, 1.3vw, 16px);\n    font-weight: 500;\n    letter-spacing: .24em;\n    text-transform: uppercase;\n    opacity: 0;\n    transform: translate3d(0, 16px, 0);\n    transition: opacity 1s ease .25s, transform 1.2s cubic-bezier(.2,.7,.2,1) .25s;\n  }\n\n  .hsv.is-ready .hsv__intro h2,\n  .hsv.is-ready .hsv__intro p {\n    opacity: 1;\n    transform: none;\n    filter: none;\n  }\n\n  /* scroll hint */\n  .hsv__hint {\n    position: absolute;\n    z-index: 2;\n    left: 50%;\n    bottom: 34px;\n    transform: translateX(-50%);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    color: rgba(255,255,255,.75);\n    font-size: 10px;\n    letter-spacing: .3em;\n    text-transform: uppercase;\n    pointer-events: none;\n    opacity: 0;\n    transition: opacity .8s ease .6s;\n  }\n  .hsv.is-ready .hsv__hint { opacity: 1; }\n  .hsv__hint i {\n    position: relative;\n    display: block;\n    width: 1px;\n    height: 42px;\n    background: rgba(255,255,255,.2);\n    overflow: hidden;\n  }\n  .hsv__hint i::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: -50%;\n    width: 100%;\n    height: 50%;\n    background: #fff;\n    animation: hsvHint 1.8s cubic-bezier(.6,0,.4,1) infinite;\n  }\n  @keyframes hsvHint {\n    0%   { top: -50%; }\n    100% { top: 100%; }\n  }\n\n  /* progress rail */\n  .hsv__rail {\n    position: absolute;\n    z-index: 2;\n    right: 22px;\n    top: 50%;\n    width: 2px;\n    height: 120px;\n    transform: translateY(-50%);\n    background: rgba(255,255,255,.15);\n    border-radius: 2px;\n    overflow: hidden;\n    pointer-events: none;\n    opacity: 0;\n    transition: opacity .6s ease;\n  }\n  .hsv.is-ready .hsv__rail { opacity: 1; }\n  .hsv__rail span {\n    position: absolute;\n    left: 0; top: 0;\n    width: 100%;\n    height: 100%;\n    background: #fff;\n    transform-origin: top;\n    transform: scaleY(0);\n  }\n\n  /* loader */\n  .hsv__loader {\n    position: absolute;\n    z-index: 3;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    background: #000;\n    color: rgba(255,255,255,.6);\n    font-size: 11px;\n    letter-spacing: .3em;\n    text-transform: uppercase;\n    transition: opacity .7s ease, visibility .7s ease;\n  }\n  .hsv.is-ready .hsv__loader {\n    opacity: 0;\n    visibility: hidden;\n  }\n  .hsv__bar {\n    width: min(180px, 40vw);\n    height: 1px;\n    background: rgba(255,255,255,.15);\n    overflow: hidden;\n  }\n  .hsv__bar span {\n    display: block;\n    height: 100%;\n    width: 100%;\n    background: #fff;\n    transform-origin: left;\n    transform: scaleX(0);\n    transition: transform .25s ease;\n  }\n\n  @media (max-width: 749px) {\n    .hsv__intro h2 { font-size: clamp(42px, 11vw, 72px); }\n    .hsv__intro p  { font-size: 11px; letter-spacing: .18em; }\n    .hsv__rail     { right: 12px; height: 80px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hsv { height: 100svh !important; }\n    .hsv__intro h2, .hsv__intro p, .hsv__video { transition: none; }\n    .hsv__hint, .hsv__rail { display: none; }\n  }\n</style>\n\n<section\n  class=\"hsv\"\n  data-scroll=\"900\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/68a71a78e32540cdb16d5b88c790c8af.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/4c4739953b8d46039d8098073bdc7fa6.mp4\"\n>\n  <div class=\"hsv__stage\">\n    <video\n      class=\"hsv__video\"\n      muted\n      playsinline\n      webkit-playsinline\n      preload=\"auto\"\n      disablepictureinpicture\n      disableremoteplayback\n    ></video>\n\n    <div class=\"hsv__shade\"></div>\n\n    <div class=\"hsv__intro\">\n      <h2>PHENOM FLOW</h2>\n      <p>Engineered to move</p>\n    </div>\n\n    <div class=\"hsv__hint\"><i></i>Scroll</div>\n    <div class=\"hsv__rail\"><span></span></div>\n\n    <div class=\"hsv__loader\">\n      <div class=\"hsv__bar\"><span></span></div>\n      <div class=\"hsv__pct\">0%</div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  function initHSV(section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n\n    var video   = section.querySelector('.hsv__video');\n    var intro   = section.querySelector('.hsv__intro');\n    var hint    = section.querySelector('.hsv__hint');\n    var railBar = section.querySelector('.hsv__rail span');\n    var barFill = section.querySelector('.hsv__bar span');\n    var pctEl   = section.querySelector('.hsv__pct');\n\n    var mobileQuery   = window.matchMedia('(max-width: 749px)');\n    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    var scrollVh = parseFloat(section.dataset.scroll) || 900;\n    section.style.setProperty('--hsv-scroll', scrollVh + 'vh');\n\n    var ready = false, visible = false, running = false;\n    var current = 0, last = performance.now();\n    var activeSrc = '', blobUrl = '', loadToken = 0;\n    var EASE = 0.1;\n\n    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }\n    function smoothstep(t) { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); }\n\n    /* ---- FIX 1: theme wrappers with overflow:hidden kill position:sticky ---- */\n    function fixStickyAncestors() {\n      var p = section.parentElement;\n      while (p && p !== document.documentElement) {\n        var cs = getComputedStyle(p);\n        if (cs.overflowX === 'hidden' || cs.overflowY === 'hidden') {\n          p.style.overflowY = 'visible';\n          p.style.overflowX = 'clip';\n        }\n        p = p.parentElement;\n      }\n    }\n\n    function progress() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      return total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n    }\n\n    function updateUI(p) {\n      if (railBar) railBar.style.transform = 'scaleY(' + p + ')';\n      if (reducedMotion.matches) return;\n      var e = smoothstep(clamp(p / 0.08, 0, 1));\n      intro.style.opacity = ready ? Math.pow(1 - e, 1.35) : '';\n      intro.style.transform = 'translate3d(0,' + (-110 * e) + 'px,0)';\n      if (hint) hint.style.opacity = ready ? String(1 - smoothstep(clamp(p / 0.03, 0, 1))) : '';\n    }\n\n    function setLoad(r) {\n      r = clamp(r, 0, 1);\n      if (barFill) barFill.style.transform = 'scaleX(' + r + ')';\n      if (pctEl) pctEl.textContent = Math.round(r * 100) + '%';\n    }\n\n    function seek(t) {\n      if (!ready || video.seeking || !isFinite(video.duration)) return;\n      var safe = clamp(t, 0, Math.max(0, video.duration - 0.04));\n      if (Math.abs(video.currentTime - safe) > 0.016) {\n        try { video.currentTime = safe; } catch (e) {}\n      }\n    }\n\n    function markReady() {\n      if (ready) return;\n      ready = true;\n      current = progress() * video.duration;\n      seek(current);\n      setLoad(1);\n      section.classList.add('is-ready');\n      updateUI(progress());\n      kick();\n    }\n\n    /* ---- FIX 2: paint the first frame (iOS/Safari show nothing until played) ---- */\n    function primeAndReady() {\n      var pr;\n      try { pr = video.play(); } catch (e) {}\n      if (pr && pr.then) {\n        pr.then(function () { video.pause(); markReady(); })\n          .catch(function () { markReady(); });\n      } else {\n        video.pause();\n        markReady();\n      }\n    }\n\n    function attach(src) {\n      video.src = src;\n      video.load();\n    }\n\n    /* ---- FIX 3: download the whole file into memory so seeking is instant ---- */\n    function loadCorrectVideo() {\n      var src = mobileQuery.matches ? section.dataset.mobile : section.dataset.desktop;\n      if (!src || src === activeSrc) return;\n\n      activeSrc = src;\n      ready = false;\n      section.classList.remove('is-ready');\n      setLoad(0);\n      var token = ++loadToken;\n      video.pause();\n\n      if (!window.fetch || !window.ReadableStream || !window.URL) { attach(src); return; }\n\n      fetch(src, { mode: 'cors' })\n        .then(function (res) {\n          if (!res.ok) throw new Error('HTTP ' + res.status);\n          var total = +res.headers.get('Content-Length') || 0;\n          if (!res.body || !res.body.getReader) return res.blob();\n\n          var reader = res.body.getReader(), chunks = [], got = 0;\n          function pump() {\n            return reader.read().then(function (r) {\n              if (r.done) return new Blob(chunks, { type: 'video/mp4' });\n              chunks.push(r.value);\n              got += r.value.length;\n              if (total && token === loadToken) setLoad(got / total * 0.95);\n              return pump();\n            });\n          }\n          return pump();\n        })\n        .then(function (blob) {\n          if (token !== loadToken) return;\n          if (blobUrl) URL.revokeObjectURL(blobUrl);\n          blobUrl = URL.createObjectURL(blob);\n          attach(blobUrl);\n        })\n        .catch(function () {\n          if (token !== loadToken) return;\n          attach(src); // CORS / network fallback: stream directly\n        });\n    }\n\n    video.addEventListener('loadeddata', function () {\n      if (isFinite(video.duration)) primeAndReady();\n    });\n    video.addEventListener('seeked', function () { if (visible) kick(); });\n\n    /* ---- FIX 4: if it still fails, just autoplay-loop so the hero is never blank ---- */\n    video.addEventListener('error', function () {\n      if (video.src.indexOf('blob:') === 0) { attach(activeSrc); return; }\n      video.loop = true;\n      video.autoplay = true;\n      section.classList.add('is-ready');\n      video.play().catch(function () {});\n    });\n    setTimeout(function () {\n      if (!ready && video.readyState >= 2) primeAndReady();\n    }, 8000);\n\n    window.addEventListener('touchstart', function () {\n      if (!ready) return;\n      var pr = video.play();\n      if (pr && pr.then) pr.then(function () { video.pause(); seek(current); }).catch(function () {});\n    }, { once: true, passive: true });\n\n    function tick(now) {\n      running = false;\n      if (!visible) return;\n      var dt = clamp((now - last) / 16.667, 0, 3);\n      last = now;\n\n      var p = progress();\n      updateUI(p);\n\n      if (ready && isFinite(video.duration)) {\n        var target = p * video.duration;\n        current += (target - current) * (1 - Math.pow(1 - EASE, dt));\n        if (Math.abs(target - current) < 0.001) current = target;\n        seek(current);\n      }\n      kick();\n    }\n\n    function kick() {\n      if (running || !visible) return;\n      running = true;\n      requestAnimationFrame(tick);\n    }\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (entries) {\n        visible = entries[0].isIntersecting;\n        if (visible) { last = performance.now(); kick(); }\n      }, { rootMargin: '200px 0px' }).observe(section);\n    } else {\n      visible = true;\n    }\n\n    window.addEventListener('scroll', function () { kick(); }, { passive: true });\n    window.addEventListener('resize', function () { updateUI(progress()); kick(); }, { passive: true });\n\n    if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', loadCorrectVideo);\n    else mobileQuery.addListener(loadCorrectVideo);\n\n    fixStickyAncestors();\n    loadCorrectVideo();\n    updateUI(progress());\n  }\n\n  function boot() { document.querySelectorAll('.hsv').forEach(initHSV); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n\n  /* re-init inside the Shopify theme editor */\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
