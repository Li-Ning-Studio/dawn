      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  PHENOM FLOW\n  Scroll-controlled video + introduction\n  Fixture OTF fonts\n{% endcomment %}\n\n<style>\n/* ============ LOCAL FIXTURE FONTS ============ */\n\n@font-face {\n  font-family: 'PFX-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'PFX-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n}\n\n/* ============ TOKENS ============ */\n\n.pfx {\n  --pfx-scroll: 360vh;\n  --pfx-offset: 0px;\n  --pfx-white: #f5f5f7;\n  --pfx-grey: #86868b;\n  --pfx-dim: #424245;\n  --pfx-line: #2d2d30;\n  --pfx-font: 'PFX-Fixture-Expanded', sans-serif;\n  --pfx-heading-font: 'PFX-Fixture-ExtraBold', sans-serif;\n  --pfx-ease: cubic-bezier(.28, .11, .32, 1);\n\n  position: relative;\n  width: 100vw;\n  max-width: 100vw;\n  margin-left: calc(50% - 50vw);\n\n  background: #000 !important;\n  color: var(--pfx-white);\n\n  font-family: var(--pfx-font);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n.pfx *,\n.pfx *::before,\n.pfx *::after {\n  box-sizing: border-box;\n}\n\n/* THEME-PROOF TEXT */\n\n.pfx h2,\n.pfx h3,\n.pfx p,\n.pfx span,\n.pfx strong,\n.pfx li {\n  font-family: var(--pfx-font) !important;\n  text-transform: none !important;\n  -webkit-text-fill-color: currentColor !important;\n  background: none !important;\n  margin: 0;\n  padding: 0;\n}\n\n/* ============ 1. PINNED VIDEO ============ */\n\n.pfx-track {\n  position: relative;\n  height: var(--pfx-scroll);\n}\n\n.pfx-stage {\n  position: sticky;\n  top: var(--pfx-offset);\n\n  height: calc(100vh - var(--pfx-offset));\n  height: calc(100svh - var(--pfx-offset));\n\n  overflow: hidden;\n  background: #000;\n}\n\n.pfx-video {\n  position: absolute;\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: contain;\n  object-position: 50% 50%;\n\n  background: #000;\n  pointer-events: none;\n\n  opacity: 0;\n  transition: opacity 1.2s var(--pfx-ease);\n  will-change: opacity;\n}\n\n.pfx.is-ready .pfx-video {\n  opacity: 1;\n}\n\n/* VIDEO FADE INTO BLACK CONTENT */\n\n.pfx-stage::after {\n  content: \"\";\n  position: absolute;\n\n  left: 0;\n  right: 0;\n  bottom: 0;\n\n  height: 22%;\n  background: linear-gradient(\n    180deg,\n    rgba(0,0,0,0) 0%,\n    #000 100%\n  );\n\n  pointer-events: none;\n  z-index: 1;\n}\n\n/* ============ HERO COPY ============ */\n\n.pfx-hero {\n  position: absolute;\n  z-index: 2;\n\n  left: 0;\n  right: 0;\n\n  top: clamp(44px, 9vh, 110px);\n  padding: 0 24px;\n\n  text-align: center;\n  pointer-events: none;\n\n  will-change: transform, opacity;\n}\n\n/* EYEBROW: FIXTURE EXPANDED */\n\n.pfx .pfx-eyebrow {\n  display: block;\n\n  font-family: 'PFX-Fixture-Expanded', sans-serif !important;\n  font-size: clamp(17px, 1.55vw, 24px) !important;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n\n  line-height: 1.25 !important;\n  letter-spacing: .004em !important;\n\n  color: var(--pfx-grey) !important;\n}\n\n/* HEADLINE: FIXTURE EXTRABOLD */\n\n.pfx .pfx-headline {\n  display: block;\n  margin-top: 8px;\n\n  font-family: 'PFX-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(40px, 5.6vw, 80px) !important;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n\n  line-height: 1.05 !important;\n  letter-spacing: -.015em !important;\n\n  color: var(--pfx-white) !important;\n}\n\n/* HERO ENTRANCE */\n\n.pfx-anim .pfx-eyebrow,\n.pfx-anim .pfx-headline {\n  opacity: 0;\n  transform: translate3d(0, 20px, 0);\n\n  transition:\n    opacity 1s var(--pfx-ease),\n    transform 1s var(--pfx-ease);\n}\n\n.pfx-anim .pfx-headline {\n  transition-delay: .55s;\n}\n\n.pfx-anim.is-in .pfx-eyebrow,\n.pfx-anim.is-in .pfx-headline {\n  opacity: 1;\n  transform: none;\n}\n\n/* ============ 2. STORY BELOW VIDEO ============ */\n\n.pfx-story {\n  position: relative;\n  z-index: 3;\n\n  max-width: 980px;\n  margin: 0 auto;\n\n  padding:\n    clamp(44px, 7vw, 90px)\n    24px\n    clamp(60px, 9vw, 110px);\n}\n\n/* DESCRIPTION: FIXTURE EXPANDED */\n\n.pfx .pfx-intro {\n  max-width: 692px;\n  margin: 0 auto;\n\n  text-align: center;\n\n  font-family: 'PFX-Fixture-Expanded', sans-serif !important;\n  font-size: clamp(17px, 1.45vw, 21px) !important;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n\n  line-height: 1.42 !important;\n  letter-spacing: .01em !important;\n\n  color: var(--pfx-grey) !important;\n}\n\n.pfx .pfx-intro strong {\n  font-family: 'PFX-Fixture-Expanded', sans-serif !important;\n  color: var(--pfx-white) !important;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n}\n\n/* STORY FADE-UP */\n\n.pfx-anim .pfx-up {\n  opacity: 0;\n  transform: translate3d(0, 34px, 0);\n\n  transition:\n    opacity 1.1s var(--pfx-ease),\n    transform 1.1s var(--pfx-ease);\n}\n\n.pfx-anim .pfx-up.is-in {\n  opacity: 1;\n  transform: none;\n}\n\n/* ============ MOBILE ============ */\n\n@media (max-width: 749px) {\n  .pfx-hero {\n    top: clamp(40px, 9vh, 90px);\n  }\n\n  .pfx .pfx-headline {\n    margin-top: 8px;\n    font-size: clamp(36px, 10.5vw, 48px) !important;\n  }\n\n  .pfx .pfx-eyebrow {\n    font-size: 17px !important;\n  }\n\n  .pfx-story {\n    padding: 36px 24px 64px;\n  }\n}\n\n/* ============ REDUCED MOTION ============ */\n\n@media (prefers-reduced-motion: reduce) {\n  .pfx-track {\n    height: auto;\n  }\n\n  .pfx-stage {\n    position: relative;\n    height: 100svh;\n  }\n\n  .pfx-anim .pfx-up,\n  .pfx-anim .pfx-eyebrow,\n  .pfx-anim .pfx-headline {\n    opacity: 1 !important;\n    transform: none !important;\n    transition: none !important;\n  }\n}\n</style>\n\n<section\n  class=\"pfx\"\n  data-scroll=\"360\"\n  data-offset=\"auto\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/8f741d9015554854aeb2e745f94253d2.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/1d26484da27546c0820e713e5151c384.mp4\"\n>\n\n  <!-- 1. SCROLL VIDEO -->\n\n  <div class=\"pfx-track\">\n    <div class=\"pfx-stage\">\n\n      <video\n        class=\"pfx-video\"\n        muted\n        playsinline\n        webkit-playsinline\n        preload=\"auto\"\n        disablepictureinpicture\n        disableremoteplayback\n        aria-hidden=\"true\"\n      ></video>\n\n      <div class=\"pfx-hero\">\n        <span class=\"pfx-eyebrow\">\n          Phenom Flow\n        </span>\n\n        <h2 class=\"pfx-headline\">\n          Engineered to move.\n        </h2>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- 2. INTRODUCTION -->\n\n  <div class=\"pfx-story\">\n    <p class=\"pfx-intro pfx-up\">\n     \n\n</section>\n\n<script>\n(function () {\n  function initPFX(section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n\n    var track = section.querySelector('.pfx-track');\n    var video = section.querySelector('.pfx-video');\n    var hero  = section.querySelector('.pfx-hero');\n    var stage = section.querySelector('.pfx-stage');\n    var story = section.querySelector('.pfx-story');\n\n    var mobileQuery = window.matchMedia('(max-width: 749px)');\n    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    section.classList.add('pfx-anim');\n\n    var mem = navigator.deviceMemory || 4;\n    var cores = navigator.hardwareConcurrency || 4;\n    var lowEnd = mem <= 2 || cores <= 4;\n    var EASE = lowEnd ? 0.30 : 0.25;\n\n    section.style.setProperty(\n      '--pfx-scroll',\n      (parseFloat(section.dataset.scroll) || 360) + 'vh'\n    );\n\n    var ready = false;\n    var visible = false;\n    var rafId = 0;\n\n    var current = 0;\n    var target = 0;\n    var lastT = 0;\n\n    var activeSrc = '';\n    var blobUrl = '';\n    var token = 0;\n\n    var top0 = 0;\n    var range = 1;\n\n    function clamp(n, a, b) {\n      return n < a ? a : n > b ? b : n;\n    }\n\n    function fixStickyAncestors() {\n      var p = section.parentElement;\n\n      while (p && p !== document.documentElement) {\n        var cs = getComputedStyle(p);\n\n        if (\n          cs.overflowX === 'hidden' ||\n          cs.overflowY === 'hidden'\n        ) {\n          p.style.overflowY = 'visible';\n          p.style.overflowX = 'clip';\n        }\n\n        p = p.parentElement;\n      }\n    }\n\n    function applyOffset() {\n      var o = section.dataset.offset;\n      var px = 0;\n\n      if (o === 'auto') {\n        var h = document.querySelector(\n          '.shopify-section-header-sticky, .section-header, header'\n        );\n\n        if (h) {\n          var pos = getComputedStyle(h).position;\n\n          if (pos === 'sticky' || pos === 'fixed') {\n            px = Math.round(h.getBoundingClientRect().height);\n          }\n        }\n      } else {\n        px = parseFloat(o) || 0;\n      }\n\n      section.style.setProperty('--pfx-offset', px + 'px');\n    }\n\n    function measure() {\n      var rect = track.getBoundingClientRect();\n\n      top0 = rect.top + window.pageYOffset;\n\n      range = Math.max(\n        1,\n        track.offsetHeight - window.innerHeight\n      );\n    }\n\n    function tighten() {\n      if (!story || !video.videoWidth) return;\n\n      var sw = stage.clientWidth;\n      var sh = stage.clientHeight;\n\n      var shown = Math.min(\n        sh,\n        sw * video.videoHeight / video.videoWidth\n      );\n\n      var gap = Math.max(0, (sh - shown) / 2);\n\n      if (mobileQuery.matches) {\n        gap += shown * 0.24;\n      }\n\n      story.style.marginTop =\n        gap > 8 ? (-Math.round(gap)) + 'px' : '';\n    }\n\n    function progress() {\n      return clamp(\n        (window.pageYOffset - top0) / range,\n        0,\n        1\n      );\n    }\n\n    function updateHero(p) {\n      if (reducedMotion.matches) return;\n\n      var t = clamp(p / 0.15, 0, 1);\n      var e = t * t * (3 - 2 * t);\n\n      hero.style.opacity = 1 - e;\n\n      hero.style.transform =\n        'translate3d(0,' + (-120 * e) + 'px,0)';\n\n      hero.style.visibility =\n        t >= 1 ? 'hidden' : 'visible';\n    }\n\n    function seek(t) {\n      if (!ready || video.seeking) return;\n\n      var d = video.duration;\n      if (!isFinite(d)) return;\n\n      t = clamp(t, 0, d - 0.04);\n\n      if (Math.abs(video.currentTime - t) > 0.02) {\n        try {\n          video.currentTime = t;\n        } catch (e) {}\n      }\n    }\n\n    function frame(now) {\n      rafId = 0;\n\n      var dt = lastT\n        ? clamp((now - lastT) / 16.667, 0.5, 3)\n        : 1;\n\n      lastT = now;\n\n      var p = progress();\n      updateHero(p);\n\n      if (ready) {\n        target = p * video.duration;\n\n        current +=\n          (target - current) *\n          (1 - Math.pow(1 - EASE, dt));\n\n        if (Math.abs(target - current) < 0.005) {\n          current = target;\n        }\n\n        seek(current);\n      }\n\n      if (visible && (!ready || current !== target)) {\n        start();\n      }\n    }\n\n    function start() {\n      if (!rafId && visible) {\n        rafId = requestAnimationFrame(frame);\n      }\n    }\n\n    function markReady() {\n      if (ready) return;\n\n      ready = true;\n\n      current = target =\n        progress() * video.duration;\n\n      seek(current);\n\n      section.classList.add('is-ready');\n\n      setTimeout(function () {\n        section.classList.add('is-in');\n      }, 250);\n\n      start();\n    }\n\n    function prime() {\n      var pr;\n\n      try {\n        pr = video.play();\n      } catch (e) {}\n\n      if (pr && pr.then) {\n        pr.then(function () {\n          video.pause();\n          markReady();\n        }).catch(markReady);\n      } else {\n        video.pause();\n        markReady();\n      }\n    }\n\n    function attach(src) {\n      video.src = src;\n      video.load();\n    }\n\n    function loadVideo() {\n      var src = mobileQuery.matches\n        ? section.dataset.mobile\n        : section.dataset.desktop;\n\n      if (!src || src === activeSrc) return;\n\n      activeSrc = src;\n      ready = false;\n\n      section.classList.remove('is-ready');\n\n      var my = ++token;\n\n      video.pause();\n\n      if (!window.fetch || mem <= 1) {\n        attach(src);\n        return;\n      }\n\n      fetch(src, { mode: 'cors' })\n        .then(function (r) {\n          if (!r.ok) throw 0;\n          return r.blob();\n        })\n        .then(function (b) {\n          if (my !== token) return;\n\n          if (blobUrl) {\n            URL.revokeObjectURL(blobUrl);\n          }\n\n          blobUrl = URL.createObjectURL(b);\n          attach(blobUrl);\n        })\n        .catch(function () {\n          if (my === token) attach(src);\n        });\n    }\n\n    video.addEventListener('loadeddata', function () {\n      tighten();\n\n      if (isFinite(video.duration)) {\n        prime();\n      }\n    });\n\n    video.addEventListener('loadedmetadata', tighten);\n\n    video.addEventListener('seeked', start);\n\n    video.addEventListener('error', function () {\n      if (video.src.indexOf('blob:') === 0) {\n        attach(activeSrc);\n        return;\n      }\n\n      video.loop = true;\n      section.classList.add('is-ready');\n      video.play().catch(function () {});\n    });\n\n    window.addEventListener(\n      'touchstart',\n      function () {\n        if (!ready) return;\n\n        var pr = video.play();\n\n        if (pr && pr.then) {\n          pr.then(function () {\n            video.pause();\n            seek(current);\n          }).catch(function () {});\n        }\n      },\n      { once: true, passive: true }\n    );\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(\n        function (en) {\n          visible = en[0].isIntersecting;\n\n          if (visible) {\n            lastT = 0;\n            start();\n          } else if (rafId) {\n            cancelAnimationFrame(rafId);\n            rafId = 0;\n          }\n        },\n        { rootMargin: '100px 0px' }\n      ).observe(track);\n\n      var upIO = new IntersectionObserver(\n        function (en) {\n          en.forEach(function (x) {\n            if (x.isIntersecting) {\n              x.target.classList.add('is-in');\n              upIO.unobserve(x.target);\n            }\n          });\n        },\n        { rootMargin: '0px 0px -12% 0px' }\n      );\n\n      section.querySelectorAll('.pfx-up').forEach(\n        function (el) {\n          upIO.observe(el);\n        }\n      );\n    } else {\n      visible = true;\n      section.classList.remove('pfx-anim');\n    }\n\n    var resizeT;\n\n    function onResize() {\n      clearTimeout(resizeT);\n\n      resizeT = setTimeout(function () {\n        applyOffset();\n        tighten();\n        measure();\n        start();\n      }, 150);\n    }\n\n    window.addEventListener(\n      'scroll',\n      function () {\n        start();\n      },\n      { passive: true }\n    );\n\n    window.addEventListener(\n      'resize',\n      onResize,\n      { passive: true }\n    );\n\n    window.addEventListener('load', function () {\n      applyOffset();\n      tighten();\n      measure();\n      start();\n    });\n\n    if (mobileQuery.addEventListener) {\n      mobileQuery.addEventListener(\n        'change',\n        function () {\n          loadVideo();\n          tighten();\n        }\n      );\n    } else {\n      mobileQuery.addListener(loadVideo);\n    }\n\n    fixStickyAncestors();\n    applyOffset();\n    measure();\n    loadVideo();\n    updateHero(progress());\n\n    setTimeout(function () {\n      section.classList.add('is-in');\n    }, 4000);\n  }\n\n  function boot() {\n    document.querySelectorAll('.pfx').forEach(initPFX);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', boot);\n  } else {\n    boot();\n  }\n\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
