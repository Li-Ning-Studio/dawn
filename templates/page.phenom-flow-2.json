    "custom_liquid_W8FhAR": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  PREMIUM PRODUCT CAROUSEL (Custom Liquid)\n  -----------------------------------------\n  1. Paste your collection link below (full URL or just the handle).\n  2. Change the heading if you want.\n  That's it. Products load automatically.\n{%- endcomment -%}\n \n{%- assign collection_link = 'https://in.hndrd.co/collections/phenom-flow' -%}\n{%- assign section_heading = 'Explore Phenom Flow' -%}\n{%- assign max_products = 12 -%}\n\n{%- comment -%} Pull the handle out of the link {%- endcomment -%}\n{%- assign handle = collection_link | split: '/collections/' | last | split: '?' | first | split: '/' | first | strip -%}\n{%- assign pc_collection = collections[handle] -%}\n{%- assign uid = 'pc-' | append: handle | handleize -%}\n\n<section class=\"pc-wrap\" id=\"{{ uid }}\">\n  <div class=\"pc-head\">\n    <h2 class=\"pc-title\">{{ section_heading }}</h2>\n    <div class=\"pc-arrows\">\n      <button class=\"pc-arrow pc-prev\" type=\"button\" aria-label=\"Previous\" disabled>\n        <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg>\n      </button>\n      <button class=\"pc-arrow pc-next\" type=\"button\" aria-label=\"Next\">\n        <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      </button>\n    </div>\n  </div>\n\n  <div class=\"pc-track\">\n    {%- if pc_collection != blank and pc_collection.products_count > 0 -%}\n      {%- for product in pc_collection.products limit: max_products -%}\n        {%- assign color_count = 0 -%}\n        {%- for option in product.options_with_values -%}\n          {%- assign opt = option.name | downcase -%}\n          {%- if opt contains 'color' or opt contains 'colour' -%}\n            {%- assign color_count = option.values.size -%}\n          {%- endif -%}\n        {%- endfor -%}\n\n        <a class=\"pc-card\" href=\"{{ product.url }}\">\n          <div class=\"pc-img\">\n            {%- if product.featured_image -%}\n              <img\n                src=\"{{ product.featured_image | image_url: width: 900 }}\"\n                srcset=\"{{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 900 }} 900w\"\n                sizes=\"(max-width: 749px) 80vw, 30vw\"\n                alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                loading=\"lazy\">\n            {%- endif -%}\n            {%- if product.secondary_image -%}{%- endif -%}\n            {%- if product.compare_at_price > product.price -%}\n              <span class=\"pc-badge\">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF</span>\n            {%- endif -%}\n          </div>\n\n          <div class=\"pc-info\">\n            <h3 class=\"pc-name\">{{ product.title }}</h3>\n            <p class=\"pc-meta\">\n              {%- if color_count > 0 -%}\n                <span>{{ color_count }} {% if color_count == 1 %}color{% else %}colors{% endif %}</span>\n              {%- endif -%}\n              {%- if color_count > 0 and product.type != blank -%}<span class=\"pc-dot\">•</span>{%- endif -%}\n              {%- if product.type != blank -%}<span>{{ product.type }}</span>{%- endif -%}\n            </p>\n            <p class=\"pc-price\">\n              <span>{{ product.price | money_without_trailing_zeros }}</span>\n              {%- if product.compare_at_price > product.price -%}\n                <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>\n              {%- endif -%}\n            </p>\n          </div>\n        </a>\n      {%- endfor -%}\n    {%- else -%}\n      <p class=\"pc-empty\">No products found. Check the collection link at the top of this code.</p>\n    {%- endif -%}\n  </div>\n</section>\n\n<style>\n  #{{ uid }} {\n    --pc-bg: #03040a;\n    --pc-card-bg: #000;\n    --pc-text: #fff;\n    --pc-muted: #8b8d96;\n    --pc-gap: 16px;\n    background: var(--pc-bg);\n    color: var(--pc-text);\n    padding: 64px 0 72px;\n    font-family: inherit;\n    overflow: hidden;\n  }\n  #{{ uid }} .pc-head {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 0 48px; margin-bottom: 36px;\n  }\n  #{{ uid }} .pc-title {\n    margin: 0; color: var(--pc-text);\n    font-size: clamp(26px, 3vw, 44px); font-weight: 400; letter-spacing: 0.01em;\n  }\n  #{{ uid }} .pc-arrows { display: flex; gap: 16px; }\n  #{{ uid }} .pc-arrow {\n    width: 56px; height: 56px; border-radius: 50%; border: 0;\n    background: #e9e9ec; color: #111; cursor: pointer;\n    display: grid; place-items: center;\n    transition: transform .25s ease, background .25s ease, opacity .25s ease;\n  }\n  #{{ uid }} .pc-arrow:hover:not(:disabled) { background: #fff; transform: scale(1.06); }\n  #{{ uid }} .pc-arrow:disabled { opacity: .35; cursor: default; }\n\n  #{{ uid }} .pc-track {\n    display: flex; gap: var(--pc-gap);\n    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;\n    padding: 0 48px; scroll-padding-left: 48px;\n    scrollbar-width: none; -ms-overflow-style: none;\n  }\n  #{{ uid }} .pc-track::-webkit-scrollbar { display: none; }\n\n  #{{ uid }} .pc-card {\n    flex: 0 0 calc((100% - var(--pc-gap) * 2) / 3.2);\n    scroll-snap-align: start;\n    text-decoration: none; color: inherit; display: block;\n  }\n  #{{ uid }} .pc-img {\n    position: relative; aspect-ratio: 1 / 1; overflow: hidden;\n    background: var(--pc-card-bg);\n    border: 1px solid rgba(255,255,255,.06);\n  }\n  #{{ uid }} .pc-img img {\n    width: 100%; height: 100%; object-fit: contain; display: block;\n    transition: transform .6s cubic-bezier(.2,.7,.2,1);\n  }\n  #{{ uid }} .pc-card:hover .pc-img img { transform: scale(1.05); }\n  #{{ uid }} .pc-badge {\n    position: absolute; top: 14px; left: 14px;\n    background: #fff; color: #000; font-size: 12px; font-weight: 600;\n    padding: 5px 10px; letter-spacing: .04em;\n  }\n\n  #{{ uid }} .pc-info { padding-top: 20px; }\n  #{{ uid }} .pc-name { margin: 0 0 6px; font-size: 22px; font-weight: 400; color: var(--pc-text); }\n  #{{ uid }} .pc-meta {\n    margin: 0 0 18px; font-size: 18px; color: var(--pc-muted);\n    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;\n  }\n  #{{ uid }} .pc-dot { font-size: 12px; }\n  #{{ uid }} .pc-price { margin: 0; font-size: 22px; color: var(--pc-text); display: flex; gap: 12px; align-items: baseline; }\n  #{{ uid }} .pc-price s { font-size: 16px; color: var(--pc-muted); }\n  #{{ uid }} .pc-empty { color: var(--pc-muted); padding: 40px 0; }\n\n  @media (max-width: 989px) {\n    #{{ uid }} .pc-card { flex-basis: calc((100% - var(--pc-gap)) / 2.2); }\n  }\n  @media (max-width: 749px) {\n    #{{ uid }} { padding: 40px 0 48px; }\n    #{{ uid }} .pc-head { padding: 0 16px; margin-bottom: 24px; }\n    #{{ uid }} .pc-track { padding: 0 16px; scroll-padding-left: 16px; --pc-gap: 12px; }\n    #{{ uid }} .pc-card { flex-basis: 78%; }\n    #{{ uid }} .pc-arrow { width: 42px; height: 42px; }\n    #{{ uid }} .pc-name { font-size: 18px; }\n    #{{ uid }} .pc-meta { font-size: 15px; margin-bottom: 12px; }\n    #{{ uid }} .pc-price { font-size: 18px; }\n  }\n</style>\n\n<script>\n  (function () {\n    var root = document.getElementById('{{ uid }}');\n    if (!root) return;\n    var track = root.querySelector('.pc-track');\n    var prev = root.querySelector('.pc-prev');\n    var next = root.querySelector('.pc-next');\n\n    function step() {\n      var card = track.querySelector('.pc-card');\n      if (!card) return track.clientWidth;\n      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;\n      return card.getBoundingClientRect().width + gap;\n    }\n    function update() {\n      var max = track.scrollWidth - track.clientWidth - 2;\n      prev.disabled = track.scrollLeft <= 2;\n      next.disabled = track.scrollLeft >= max;\n    }\n    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });\n    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });\n    track.addEventListener('scroll', update, { passive: true });\n    window.addEventListener('resize', update);\n    update();\n  })();\n</script>",
