      "settings": {
        "custom_liquid": "<style>\n/* ==========================================\n   HNDRD ORIGINAL BRAND FONTS\n========================================== */\n\n@font-face {\n  font-family: 'Anita_semi_square';\n  src: url(\"{{ 'Anita_semi_square.ttf' | file_url }}\") format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'Gilroy-Regular';\n  src: url(\"{{ 'Gilroy-Regular.ttf' | file_url }}\") format('truetype');\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n}\n\n/* ==========================================\n   MAIN SECTION\n========================================== */\n\n.hndrd-secure-fit,\n.hndrd-secure-fit * {\n  box-sizing: border-box;\n}\n\n.hndrd-secure-fit {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n  margin: 0;\n  overflow: hidden;\n  background: linear-gradient(140deg,\n    #ffffff 0%,\n    #000000 50%,\n    #ffffff 100%);\n  color: #ffffff;\n}\n\n/* ==========================================\n   DESKTOP SPLIT LAYOUT\n========================================== */\n\n.hndrd-secure-grid {\n  position: relative;\n  z-index: 1;\n\n  display: grid;\n  grid-template-columns:\n    minmax(0, 1fr) minmax(0, 1fr);\n\n  align-items: center;\n\n  width: 100%;\n  max-width: 100%;\n  min-height: 0;\n  margin: 0;\n}\n\n/* ==========================================\n   LEFT IMAGE - FULL IMAGE, NO CROP\n========================================== */\n\n.hndrd-secure-media {\n  position: relative;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-width: 0;\n  height: auto;\n  min-height: 0;\n\n  margin: 0;\n  padding: 0;\n\n  overflow: hidden;\n  background: transparent;\n}\n\n.hndrd-secure-media img {\n  position: static !important;\n  inset: auto !important;\n\n  display: block;\n\n  width: 100% !important;\n  height: auto !important;\n\n  max-width: 100% !important;\n  max-height: none !important;\n\n  aspect-ratio: auto !important;\n  object-fit: contain !important;\n  object-position: center center !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  transform: none !important;\n  transition: none !important;\n}\n\n.hndrd-secure-media:hover img {\n  transform: none !important;\n}\n\n/* ==========================================\n   RIGHT CONTENT\n========================================== */\n\n.hndrd-secure-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-width: 0;\n\n  padding: 65px 36px;\n\n  background: transparent;\n}\n\n.hndrd-secure-inner {\n  width: 100%;\n  max-width: 560px;\n  min-width: 0;\n\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* ==========================================\n   BRAND LABEL\n========================================== */\n\n.hndrd-secure-fit .hndrd-secure-label {\n  margin: 0 0 22px;\n  padding: 0;\n\n  font-family: 'Anita_semi_square', sans-serif !important;\n  font-size: 13px;\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .12em !important;\n  line-height: 1.5 !important;\n  text-transform: uppercase !important;\n\n  color: #ffffff;\n}\n\n/* ==========================================\n   TITLE\n========================================== */\n\n.hndrd-secure-fit .hndrd-secure-title {\n  display: block;\n\n  margin: 0 0 25px;\n  padding: 0;\n\n  font-family: 'Anita_semi_square', sans-serif !important;\n  font-size: clamp(27px, 2.8vw, 43px);\n  font-weight: 400 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .15em !important;\n  line-height: 1.3 !important;\n\n  text-transform: uppercase !important;\n  text-align: center !important;\n  overflow-wrap: break-word;\n\n  color: #ffffff;\n}\n\n/* ==========================================\n   DESCRIPTION\n========================================== */\n\n.hndrd-secure-fit .hndr