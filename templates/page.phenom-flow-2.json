\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hndrd-secure-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hndrd-secure-fit .hndrd-secure-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 22px rgba(0,0,0,.2);\n  }\n\n  .hndrd-secure-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hndrd-secure-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hndrd-secure-content {\n    padding: 45px 25px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-title {\n    font-size: clamp(26px, 3vw, 38px);\n  }\n\n  .hndrd-secure-fit .hndrd-secure-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .hndrd-secure-fit {\n    background: linear-gradient(\n      140deg,\n      #ffffff 0%,\n      #ededed 8%,\n      #b8b8b8 19%,\n      #777777 30%,\n      #383838 40%,\n      #101010 47%,\n      #000000 49%,\n      #000000 51%,\n      #101010 53%,\n      #383838 60%,\n      #777777 70%,\n      #b8b8b8 81%,\n      #ededed 92%,\n      #ffffff 100%\n    );\n  }\n\n  .hndrd-secure-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .hndrd-secure-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hndrd-secure-media img {\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  .hndrd-secure-content {\n    order: 1;\n    padding: 35px 28px 60px;\n  }\n\n  .hndrd-secure-inner {\n    max-width: 460px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-title {\n    margin-bottom: 22px;\n    font-size: clamp(28px, 7vw, 42px);\n    letter-spacing: -.025em !important;\n    line-height: 1.08 !important;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hndrd-secure-content {\n    padding: 30px 23px 50px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-title {\n    font-size: 28px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-description {\n    font-size: 12px;\n  }\n}\n\n/* ACCESSIBILITY */\n@media (prefers-reduced-motion: reduce) {\n  .hndrd-secure-cta,\n  .hndrd-secure-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hndrd-secure-fit\">\n  <div class=\"hndrd-secure-grid\">\n\n    <!-- LEFT IMAGE -->\n    <div class=\"hndrd-secure-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/01_R_c4584f19-7f28-4673-9e7c-7bf4ac46fa01.jpg?v=1793177980\"\n        alt=\"HNDRD Hypercourt Adapt Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n    </div>\n\n    <!-- RIGHT CONTENT -->\n    <div class=\"hndrd-secure-content\">\n      <div class=\"hndrd-secure-inner\">\n\n        <p class=\"hndrd-secure-label\">\n          HNDRD HYPERCOURT ADAPT\n        </p>\n\n        <h2 class=\"hndrd-secure-title\">\n          SECURE FIT\n        </h2>\n\n        <p class=\"hndrd-secure-description\">\n          The Adapt Dial replaces traditional laces\n          to create a snug, even fit. It allows\n          tightening in small increments for a\n          secure fit. A simple pull of the dial\n          releases the tension, making it easy\n          to remove the shoe.\n        </p>\n\n        <a\n          class=\"hndrd-secure-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Shop HNDRD Hypercourt Adapt\"\n        >\n          SHOP HYPERCOURT ADAPT\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n  </div>\n</section>",
