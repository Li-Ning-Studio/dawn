      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD PHENOM FLOW\n  Premium Introduction Section\n  Shopify Custom Liquid\n{% endcomment %}\n\n<style>\n/* ================================\n   FIXTURE FONTS\n================================ */\n\n@font-face {\n  font-family: 'PF-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'PF-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* ================================\n   SECTION\n================================ */\n\n.hn-pf-premium,\n.hn-pf-premium * {\n  box-sizing: border-box;\n}\n\n.hn-pf-premium {\n  --pf-pink: #f20b87;\n  --pf-white: #ffffff;\n  --pf-black: #000000;\n\n  position: relative;\n  isolation: isolate;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-height: 460px;\n  margin: 0;\n  padding: 100px 28px;\n  overflow: hidden;\n\nbackground: #000000;\n\n  color: var(--pf-white);\n}\n\n/* soft studio light from the top + fine grain so the gradient never bands */\n.hn-pf-premium::before,\n.hn-pf-premium::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 0;\n}\n\n.hn-pf-premium::before {\n  background: linear-gradient(\n    100deg,\n    rgba(255,255,255,.10) 0%,\n    rgba(255,255,255,0) 45%\n  );\n  -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 30%);\n          mask-image: linear-gradient(180deg, #000 0%, transparent 30%);\n}\n\n.hn-pf-premium::after {\n  opacity: .07;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n}\n\n/* ================================\n   CONTENT WRAPPER\n================================ */\n\n.hn-pf-premium__inner {\n  position: relative;\n  z-index: 1;\n\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n\n  text-align: center;\n}\n\n/* ================================\n   EYEBROW\n================================ */\n\n.hn-pf-premium__eyebrow {\n  display: block;\n\n  margin: 0 0 20px;\n  padding: 0;\n\n  font-family: 'PF-Fixture-Expanded', sans-serif !important;\n  font-size: 13px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  line-height: 1.5;\n  letter-spacing: .08em;\n  text-align: center;\n  text-transform: uppercase;\n\n  color: rgba(255,255,255,.72);\n}\n\n/* ================================\n   MAIN HEADING\n================================ */\n\n.hn-pf-premium .hn-pf-premium__title {\n  display: block;\n\n  max-width: 1100px;\n  margin: 0 auto 24px;\n  padding: 0;\n\n  font-family: 'PF-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(42px, 5.5vw, 82px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.045em !important;\n  line-height: 1.04 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  color: var(--pf-pink) !important;\n}\n\n/* ================================\n   DESCRIPTION\n================================ */\n\n.hn-pf-premium .hn-pf-premium__description {\n  display: block;\n\n  width: 100%;\n  max-width: 750px;\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'PF-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .01em !important;\n  line-height: 1.55 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  color: #d6d6d6;\n}\n\n/* ================================\n   CTA\n================================ */\n\n.hn-pf-premium .hn-pf-premium__cta,\n.hn-pf-premium .hn-pf-premium__cta:visited {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  min-height: 52px;\n  max-width: 100%;\n\n  margin-top: 38px;\n  padding: 14px 34px;\n\n  border: 1.5px solid var(--pf-pink);\n  border-radius: 999px;\n\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'PF-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .04em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-align: center;\n  text-decoration: none !important;\n\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    border-color .3s ease,\n    color .3s ease;\n}\n\n/* ================================\n   CTA HOVER\n================================ */\n\n@media (hover: hover) {\n  .hn-pf-premium .hn-pf-premium__cta:hover {\n    background: var(--pf-pink);\n    border-color: var(--pf-pink);\n    color: #ffffff !important;\n  }\n}\n\n.hn-pf-premium__cta:focus-visible {\n  outline: 2px solid var(--pf-pink);\n  outline-offset: 4px;\n}\n\n/* ================================\n   TABLET\n================================ */\n\n@media (min-width: 769px) and (max-width: 1100px) {\n  .hn-pf-premium {\n    min-height: 420px;\n    padding: 90px 30px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: clamp(40px, 5.5vw, 64px);\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 13px;\n  }\n}\n\n/* ================================\n   MOBILE\n================================ */\n\n@media (max-width: 768px) {\n  .hn-pf-premium {\n    min-height: 370px;\n    padding: 75px 24px;\n  }\n\n  .hn-pf-premium__inner {\n    max-width: 480px;\n  }\n\n  .hn-pf-premium__eyebrow {\n    margin-bottom: 17px;\n    font-size: 10px;\n    letter-spacing: .06em;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    max-width: 440px;\n    margin-bottom: 20px;\n\n    font-size: clamp(35px, 9vw, 54px);\n    letter-spacing: -.045em !important;\n    line-height: 1.05 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    max-width: 390px;\n    font-size: 12px;\n    line-height: 1.5 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__cta {\n    min-height: 47px;\n    margin-top: 30px;\n    padding: 12px 27px;\n    font-size: 11px;\n  }\n}\n\n/* ================================\n   SMALL MOBILE\n================================ */\n\n@media (max-width: 400px) {\n  .hn-pf-premium {\n    min-height: 340px;\n    padding: 65px 20px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: 34px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 11px;\n  }\n}\n\n/* ================================\n   REDUCED MOTION\n================================ */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-pf-premium__cta {\n    transition: none !important;\n  }\n}\n.hn-pf-premium::before,\n.hn-pf-premium::after {\n  display: none !important;\n}\n\n.hn-pf-premium {\n  background: #000000 !important;\n}\n/* PURE BLACK & WHITE THEME */\n\n.hn-pf-premium {\n  --pf-pink: #ffffff !important;\n  --pf-white: #ffffff !important;\n  background: #000000 !important;\n}\n\n/* ALL TEXT WHITE */\n.hn-pf-premium .hn-pf-premium__eyebrow,\n.hn-pf-premium .hn-pf-premium__title,\n.hn-pf-premium .hn-pf-premium__description {\n  color: #ffffff !important;\n}\n\n/* WHITE OUTLINE CTA */\n.hn-pf-premium .hn-pf-premium__cta,\n.hn-pf-premium .hn-pf-premium__cta:visited {\n  color: #ffffff !important;\n  border-color: #ffffff !important;\n  background: transparent !important;\n}\n\n/* CLEAN WHITE HOVER */\n@media (hover: hover) {\n  .hn-pf-premium .hn-pf-premium__cta:hover {\n    background: #ffffff !important;\n    border-color: #ffffff !important;\n    color: #000000 !important;\n  }\n}\n\n/* WHITE FOCUS OUTLINE */\n.hn-pf-premium .hn-pf-premium__cta:focus-visible {\n  outline-color: #ffffff !important;\n}\n</style>\n\n<section class=\"hn-pf-premium\">\n\n  <div class=\"hn-pf-premium__inner\">\n\n    <p class=\"hn-pf-premium__eyebrow\">\n      INTRODUCING PHENOM FLOW\n    </p>\n\n    <h2 class=\"hn-pf-premium__title\">\n      Crafted for Perfectionists\n    </h2>\n\n    <p class=\"hn-pf-premium__description\">\n      The Over-Engineered Badminton Shoe by HNDRD\n    </p>\n\n    <a\n      class=\"hn-pf-premium__cta\"\n      href=\"https://in.hndrd.co/products/phenom-flow\"\n      aria-label=\"Explore Phenom Flow\"\n    >\n      EXPLORE PHENOM FLOW\n    </a>\n\n  </div>\n\n</section>",
        "color_scheme": "scheme-4",
