x-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* LABEL */\n.hndrd-secure-fit .hndrd-secure-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: #ffffff;\n}\n\n/* HEADING */\n.hndrd-secure-fit .hndrd-secure-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(30px, 3.4vw, 52px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hndrd-secure-fit .hndrd-secure-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  text-transform: none !important;\n  color: #f1f1f1;\n}\n\n/* CTA */\n.hndrd-secure-fit .hndrd-secure-cta,\n.hndrd-secure-fit .hndrd-secure-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .015em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hndrd-secure-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hndrd-secure-fit .hndrd-secure-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 22px rgba(0,0,0,.2);\n  }\n\n  .hndrd-secure-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hndrd-secure-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hndrd-secure-content {\n    padding: 45px 25px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-title {\n    font-size: clamp(26px, 3vw, 38px);\n  }\n\n  .hndrd-secure-fit .hndrd-secure-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .hndrd-secure-fit {\n    background: linear-gradient(\n      140deg,\n      #ffffff 0%,\n      #ededed 8%,\n      #b8b8b8 19%,\n      #777777 30%,\n      #383838 40%,\n      #101010 47%,\n      #000000 49%,\n      #000000 51%,\n      #101010 53%,\n      #383838 60%,\n      #777777 70%,\n      #b8b8b8 81%,\n      #ededed 92%,\n      #ffffff 100%\n    );\n  }\n\n  .hndrd-secure-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .hndrd-secure-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hndrd-secure-media img {\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  .hndrd-secure-content {\n    order: 1;\n    padding: 35px 28px 60px;\n  }\n\n  .hndrd-secure-inner {\n    max-width: 460px;\n  }\n\n  .hndrd-secure-fit .hndrd-secure-label