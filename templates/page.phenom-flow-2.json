      "settings": {
        "custom_liquid": "{% comment %}\n  PHENOM FLOW – Apple-style scroll story (HNDRD)\n  Paste into a Custom Liquid section (replace everything).\n\n  Quick edits:\n    data-scroll   → how long the video scrubs (vh). Higher = slower.\n    data-desktop / data-mobile → your Shopify video links\n    All text lives in the HTML below; edit the words freely.\n{% endcomment %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* ============ TOKENS ============ */\n  .pfx {\n    --pfx-scroll: 360vh;\n    --pfx-offset: 0px;\n    --pfx-white: #f5f5f7;\n    --pfx-grey: #86868b;\n    --pfx-dim: #424245;\n    --pfx-line: #2d2d30;\n    --pfx-font: \"SF Pro Display\", \"SF Pro Text\", -apple-system, BlinkMacSystemFont, \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\n    --pfx-ease: cubic-bezier(.28, .11, .32, 1);\n\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    background: #000 !important;\n    color: var(--pfx-white);\n    font-family: var(--pfx-font);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n  .pfx *, .pfx *::before, .pfx *::after { box-sizing: border-box; }\n\n  /* theme-proof text: solid colours, no inherited transforms */\n  .pfx h2, .pfx h3, .pfx p, .pfx span, .pfx strong, .pfx li {\n    font-family: var(--pfx-font) !important;\n    text-transform: none !important;\n    -webkit-text-fill-color: currentColor !important;\n    background: none !important;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* ============ 1. PINNED VIDEO ============ */\n  .pfx-track {\n    position: relative;\n    height: var(--pfx-scroll);\n  }\n\n  .pfx-stage {\n    position: sticky;\n    top: var(--pfx-offset);\n    height: calc(100vh - var(--pfx-offset));\n    height: calc(100svh - var(--pfx-offset));\n    overflow: hidden;\n    background: #000;\n  }\n\n  .pfx-video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: 50% 50%;\n    background: #000;\n    pointer-events: none;\n    opacity: 0;\n    transition: opacity 1.2s var(--pfx-ease);\n    will-change: opacity;\n  }\n  .pfx.is-ready .pfx-video { opacity: 1; }\n\n  /* melts the video into the black content below */\n  .pfx-stage::after {\n    content: \"\";\n    position: absolute;\n    left: 0; right: 0; bottom: 0;\n    height: 22%;\n    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, #000 100%);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  /* hero copy: eyebrow first, then headline */\n  .pfx-hero {\n    position: absolute;\n    z-index: 2;\n    left: 0; right: 0;\n    top: clamp(44px, 9vh, 110px);\n    padding: 0 24px;\n    text-align: center;\n    pointer-events: none;\n    will-change: transform, opacity;\n  }\n\n  .pfx .pfx-eyebrow {\n    display: block;\n    font-size: clamp(17px, 1.55vw, 24px) !important;\n    font-weight: 600 !important;\n    line-height: 1.25 !important;\n    letter-spacing: .004em !important;\n    color: var(--pfx-grey) !important;\n  }\n\n  .pfx .pfx-headline {\n    display: block;\n    margin-top: 8px;\n    font-size: clamp(40px, 5.6vw, 80px) !important;\n    font-weight: 600 !important;\n    line-height: 1.05 !important;\n    letter-spacing: -.015em !important;\n    color: var(--pfx-white) !important;\n  }\n\n  .pfx-anim .pfx-eyebrow,\n  .pfx-anim .pfx-headline {\n    opacity: 0;\n    transform: translate3d(0, 20px, 0);\n    transition: opacity 1s var(--pfx-ease), transform 1s var(--pfx-ease);\n  }\n  .pfx-anim .pfx-headline { transition-delay: .55s; }\n  .pfx-anim.is-in .pfx-eyebrow,\n  .pfx-anim.is-in .pfx-headline {\n    opacity: 1;\n    transform: none;\n  }\n\n  /* ============ 2. STORY BELOW THE VIDEO ============ */\n  .pfx-story {\n    position: relative;\n    max-width: 980px;\n    margin: 0 auto;\n    padding: clamp(40px, 6vw, 80px) 24px clamp(80px, 12vw, 160px);\n  }\n\n  .pfx .pfx-intro {\n    max-width: 692px;\n    margin: 0 auto;\n    text-align: center;\n    font-size: clamp(17px, 1.45vw, 21px) !important;\n    font-weight: 600 !important;\n    line-height: 1.42 !important;\n    letter-spacing: .01em !important;\n    color: var(--pfx-grey) !important;\n  }\n  .pfx .pfx-intro strong { color: var(--pfx-white) !important; font-weight: 600 !important; }\n\n  /* spec rows */\n  .pfx-specs {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);\n    gap: 0 clamp(32px, 7vw, 96px);\n    margin-top: clamp(56px, 8vw, 100px);\n  }\n\n  .pfx-stat {\n    padding: 16px 0 34px;\n    border-top: 1px solid var(--pfx-dim);\n  }\n  .pfx .pfx-stat-label {\n    display: block;\n    font-size: 12px !important;\n    font-weight: 400 !important;\n    line-height: 1.33 !important;\n    color: var(--pfx-grey) !important;\n  }\n  .pfx .pfx-stat-value {\n    display: block;\n    margin-top: 6px;\n    font-size: clamp(30px, 3.4vw, 48px) !important;\n    font-weight: 600 !important;\n    line-height: 1.08 !important;\n    letter-spacing: -.01em !important;\n    color: var(--pfx-white) !important;\n  }\n  .pfx .pfx-stat-caption {\n    display: block;\n    margin-top: 6px;\n    font-size: 12px !important;\n    font-weight: 400 !important;\n    line-height: 1.33 !important;\n    color: var(--pfx-grey) !important;\n  }\n\n  .pfx-list {\n    list-style: none;\n    margin: 0;\n    padding: 18px 0 0;\n    border-top: 1px solid var(--pfx-dim);\n  }\n  .pfx .pfx-list li { margin-bottom: 26px; }\n  .pfx .pfx-list strong {\n    display: block;\n    font-size: clamp(14px, 1.2vw, 17px) !important;\n    font-weight: 600 !important;\n    line-height: 1.47 !important;\n    color: var(--pfx-white) !important;\n  }\n  .pfx .pfx-list span {\n    display: block;\n    font-size: clamp(14px, 1.2vw, 17px) !important;\n    font-weight: 400 !important;\n    line-height: 1.47 !important;\n    color: var(--pfx-grey) !important;\n  }\n\n  /* big reveal headline: lights up grey → white as you scroll */\n  .pfx-reveal {\n    margin-top: clamp(100px, 14vw, 180px);\n    text-align: center;\n  }\n  .pfx .pfx-reveal-title {\n    font-size: clamp(40px, 5.6vw, 80px) !important;\n    font-weight: 600 !important;\n    line-height: 1.05 !important;\n    letter-spacing: -.015em !important;\n    color: var(--pfx-white) !important;\n  }\n  .pfx .pfx-reveal-title .pfx-line { display: block; }\n  .pfx-anim .pfx-reveal-title .pfx-line {\n    color: var(--pfx-dim) !important;\n    transition: color .9s var(--pfx-ease);\n  }\n  .pfx-anim .pfx-reveal-title .pfx-line.is-lit { color: var(--pfx-white) !important; }\n\n  .pfx .pfx-reveal-copy {\n    max-width: 692px;\n    margin: clamp(22px, 2.4vw, 32px) auto 0;\n    font-size: clamp(17px, 1.45vw, 21px) !important;\n    font-weight: 600 !important;\n    line-height: 1.42 !important;\n    letter-spacing: .01em !important;\n    color: var(--pfx-grey) !important;\n  }\n  .pfx .pfx-reveal-copy strong { color: var(--pfx-white) !important; font-weight: 600 !important; }\n\n  /* gentle fade-up for story blocks */\n  .pfx-anim .pfx-up {\n    opacity: 0;\n    transform: translate3d(0, 34px, 0);\n    transition: opacity 1.1s var(--pfx-ease), transform 1.1s var(--pfx-ease);\n  }\n  .pfx-anim .pfx-up.is-in { opacity: 1; transform: none; }\n  .pfx-anim .pfx-specs .pfx-up:nth-child(2) { transition-delay: .12s; }\n\n  /* ============ MOBILE ============ */\n  @media (max-width: 749px) {\n    .pfx-hero { top: clamp(40px, 9vh, 90px); }\n    .pfx .pfx-headline { margin-top: 8px; font-size: clamp(36px, 10.5vw, 48px) !important; }\n    .pfx .pfx-eyebrow { font-size: 17px !important; }\n\n    .pfx-specs { grid-template-columns: minmax(0, 1fr); }\n    .pfx-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }\n    .pfx-list { margin-top: 8px; }\n    .pfx .pfx-reveal-title { font-size: clamp(36px, 10.5vw, 48px) !important; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pfx-track { height: auto; }\n    .pfx-stage { position: relative; height: 100svh; }\n    .pfx-anim .pfx-up,\n    .pfx-anim .pfx-eyebrow,\n    .pfx-anim .pfx-headline { opacity: 1 !important; transform: none !important; transition: none !important; }\n    .pfx-anim .pfx-reveal-title .pfx-line { color: var(--pfx-white) !important; }\n  }\n</style>\n\n<section\n  class=\"pfx\"\n  data-scroll=\"360\"\n  data-offset=\"auto\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/8f741d9015554854aeb2e745f94253d2.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/ce75a5749d5f4997bf534b9826ef2c2a.mp4\"\n>\n  <!-- 1. VIDEO -->\n  <div class=\"pfx-track\">\n    <div class=\"pfx-stage\">\n      <video\n        class=\"pfx-video\"\n        muted\n        playsinline\n        webkit-playsinline\n        preload=\"auto\"\n        disablepictureinpicture\n        disableremoteplayback\n        aria-hidden=\"true\"\n      ></video>\n\n      <div class=\"pfx-hero\">\n        <span class=\"pfx-eyebrow\">Phenom Flow</span>\n        <h2 class=\"pfx-headline\">Engineered to move.</h2>\n      </div>\n    </div>\n  </div>\n\n  <!-- 2. STORY -->\n  <div class=\"pfx-story\">\n    <p class=\"pfx-intro pfx-up\">\n      <strong>The over-engineered badminton shoe by HNDRD.</strong>\n      Phenom Flow brings together Thrust Foam with nitrogen-infused cushioning,\n      an Aero Flow upper and a grip-ready insole, so every split step, lunge\n      and recovery feels effortless.\n    </p>\n\n    <div class=\"pfx-specs\">\n      <div class=\"pfx-stats pfx-up\">\n        <div class=\"pfx-stat\">\n          <span class=\"pfx-stat-label\">Midsole</span>\n          <span class=\"pfx-stat-value\">Thrust Foam</span>\n          <span class=\"pfx-stat-caption\">nitrogen-infused cushioning</span>\n        </div>\n        <div class=\"pfx-stat\">\n          <span class=\"pfx-stat-label\">Upper</span>\n          <span class=\"pfx-stat-value\">Aero Flow</span>\n          <span class=\"pfx-stat-caption\">built-in ventilation</span>\n        </div>\n      </div>\n\n      <ul class=\"pfx-list pfx-up\">\n        <li>\n          <strong>Foam ridges</strong>\n          <span>Anti-slip texture that locks the foot in place</span>\n        </li>\n        <li>\n          <strong>Built-in ventilation</strong>\n          <span>Vents in the foam let air pass through</span>\n        </li>\n        <li>\n          <strong>Cushioned surface</strong>\n          <span>Specially designed texture to maintain comfort</span>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"pfx-reveal\">\n      <h2 class=\"pfx-reveal-title\">\n        <span class=\"pfx-line\">Soft landing.</span>\n        <span class=\"pfx-line\">Quick return.</span>\n      </h2>\n      <p class=\"pfx-reveal-copy pfx-up\">\n        Thrust Foam cushions every landing and\n        <strong>gives the energy straight back for your next move</strong>,\n        rally after rally.\n      </p>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  function initPFX(section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n\n    var track = section.querySelector('.pfx-track');\n    var video = section.querySelector('.pfx-video');\n    var hero  = section.querySelector('.pfx-hero');\n\n    var mobileQuery   = window.matchMedia('(max-width: 749px)');\n    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    /* text animations only switch on when JS runs, so text is never stuck hidden */\n    section.classList.add('pfx-anim');\n\n    var mem   = navigator.deviceMemory || 4;\n    var cores = navigator.hardwareConcurrency || 4;\n    var lowEnd = mem <= 2 || cores <= 4;\n    var EASE = lowEnd ? 0.30 : 0.25;\n\n    section.style.setProperty('--pfx-scroll', (parseFloat(section.dataset.scroll) || 360) + 'vh');\n\n    var ready = false, visible = false, rafId = 0;\n    var current = 0, target = 0, lastT = 0;\n    var activeSrc = '', blobUrl = '', token = 0;\n    var top0 = 0, range = 1;\n\n    function clamp(n, a, b) { return n < a ? a : n > b ? b : n; }\n\n    /* theme wrappers with overflow:hidden break position:sticky */\n    function fixStickyAncestors() {\n      var p = section.parentElement;\n      while (p && p !== document.documentElement) {\n        var cs = getComputedStyle(p);\n        if (cs.overflowX === 'hidden' || cs.overflowY === 'hidden') {\n          p.style.overflowY = 'visible';\n          p.style.overflowX = 'clip';\n        }\n        p = p.parentElement;\n      }\n    }\n\n    function applyOffset() {\n      var o = section.dataset.offset, px = 0;\n      if (o === 'auto') {\n        var h = document.querySelector('.shopify-section-header-sticky, .section-header, header');\n        if (h) {\n          var pos = getComputedStyle(h).position;\n          if (pos === 'sticky' || pos === 'fixed') px = Math.round(h.getBoundingClientRect().height);\n        }\n      } else {\n        px = parseFloat(o) || 0;\n      }\n      section.style.setProperty('--pfx-offset', px + 'px');\n    }\n\n    function measure() {\n      var rect = track.getBoundingClientRect();\n      top0 = rect.top + window.pageYOffset;\n      range = Math.max(1, track.offsetHeight - window.innerHeight);\n    }\n\n    function progress() {\n      return clamp((window.pageYOffset - top0) / range, 0, 1);\n    }\n\n    /* Apple-style: copy drifts upward and fades out during the first part of the scroll */\n    function updateHero(p) {\n      if (reducedMotion.matches) return;\n      var t = clamp(p / 0.15, 0, 1);\n      var e = t * t * (3 - 2 * t);\n      hero.style.opacity = 1 - e;\n      hero.style.transform = 'translate3d(0,' + (-120 * e) + 'px,0)';\n      hero.style.visibility = t >= 1 ? 'hidden' : 'visible';\n    }\n\n    function seek(t) {\n      if (!ready || video.seeking) return;\n      var d = video.duration;\n      if (!isFinite(d)) return;\n      t = clamp(t, 0, d - 0.04);\n      if (Math.abs(video.currentTime - t) > 0.02) {\n        try { video.currentTime = t; } catch (e) {}\n      }\n    }\n\n    function frame(now) {\n      rafId = 0;\n      var dt = lastT ? clamp((now - lastT) / 16.667, 0.5, 3) : 1;\n      lastT = now;\n\n      var p = progress();\n      updateHero(p);\n\n      if (ready) {\n        target = p * video.duration;\n        current += (target - current) * (1 - Math.pow(1 - EASE, dt));\n        if (Math.abs(target - current) < 0.005) current = target;\n        seek(current);\n      }\n\n      if (visible && (!ready || current !== target)) start();\n    }\n\n    function start() {\n      if (!rafId && visible) rafId = requestAnimationFrame(frame);\n    }\n\n    function markReady() {\n      if (ready) return;\n      ready = true;\n      current = target = progress() * video.duration;\n      seek(current);\n      section.classList.add('is-ready');\n      /* eyebrow first, headline follows, once the video is on screen */\n      setTimeout(function () { section.classList.add('is-in'); }, 250);\n      start();\n    }\n\n    function prime() {\n      var pr;\n      try { pr = video.play(); } catch (e) {}\n      if (pr && pr.then) pr.then(function () { video.pause(); markReady(); }).catch(markReady);\n      else { video.pause(); markReady(); }\n    }\n\n    function attach(src) { video.src = src; video.load(); }\n\n    function loadVideo() {\n      var src = mobileQuery.matches ? section.dataset.mobile : section.dataset.desktop;\n      if (!src || src === activeSrc) return;\n      activeSrc = src;\n      ready = false;\n      section.classList.remove('is-ready');\n      var my = ++token;\n      video.pause();\n\n      if (!window.fetch || mem <= 1) { attach(src); return; }\n\n      fetch(src, { mode: 'cors' })\n        .then(function (r) { if (!r.ok) throw 0; return r.blob(); })\n        .then(function (b) {\n          if (my !== token) return;\n          if (blobUrl) URL.revokeObjectURL(blobUrl);\n          blobUrl = URL.createObjectURL(b);\n          attach(blobUrl);\n        })\n        .catch(function () { if (my === token) attach(src); });\n    }\n\n    video.addEventListener('loadeddata', function () { if (isFinite(video.duration)) prime(); });\n    video.addEventListener('seeked', start);\n    video.addEventListener('error', function () {\n      if (video.src.indexOf('blob:') === 0) { attach(activeSrc); return; }\n      video.loop = true;\n      section.classList.add('is-ready');\n      video.play().catch(function () {});\n    });\n\n    window.addEventListener('touchstart', function () {\n      if (!ready) return;\n      var pr = video.play();\n      if (pr && pr.then) pr.then(function () { video.pause(); seek(current); }).catch(function () {});\n    }, { once: true, passive: true });\n\n    /* run the video loop only while the pinned part is on screen */\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (en) {\n        visible = en[0].isIntersecting;\n        if (visible) { lastT = 0; start(); }\n        else if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }\n      }, { rootMargin: '100px 0px' }).observe(track);\n\n      /* story blocks fade up once as they enter */\n      var upIO = new IntersectionObserver(function (en) {\n        en.forEach(function (x) {\n          if (x.isIntersecting) { x.target.classList.add('is-in'); upIO.unobserve(x.target); }\n        });\n      }, { rootMargin: '0px 0px -12% 0px' });\n      section.querySelectorAll('.pfx-up').forEach(function (el) { upIO.observe(el); });\n\n      /* reveal headline: each line lights up as it reaches the middle of the screen */\n      var lineIO = new IntersectionObserver(function (en) {\n        en.forEach(function (x) { x.target.classList.toggle('is-lit', x.isIntersecting); });\n      }, { rootMargin: '0px 0px -38% 0px' });\n      section.querySelectorAll('.pfx-line').forEach(function (el) { lineIO.observe(el); });\n    } else {\n      visible = true;\n      section.classList.remove('pfx-anim');\n    }\n\n    var resizeT;\n    function onResize() {\n      clearTimeout(resizeT);\n      resizeT = setTimeout(function () { applyOffset(); measure(); start(); }, 150);\n    }\n\n    window.addEventListener('scroll', function () { start(); }, { passive: true });\n    window.addEventListener('resize', onResize, { passive: true });\n    window.addEventListener('load', function () { applyOffset(); measure(); start(); });\n\n    if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', loadVideo);\n    else mobileQuery.addListener(loadVideo);\n\n    fixStickyAncestors();\n    applyOffset();\n    measure();\n    loadVideo();\n    updateHero(progress());\n\n    /* safety net: never leave the copy hidden if the video is slow */\n    setTimeout(function () { section.classList.add('is-in'); }, 4000);\n  }\n\n  function boot() { document.querySelectorAll('.pfx').forEach(initPFX); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
