roll__footer { bottom: 38px; }\n    .pf-scroll__copy {\n      top: auto;\n      bottom: 23%;\n      left: 23px;\n      width: calc(100% - 46px);\n    }\n    .pf-scroll__copy h2 { font-size: clamp(39px, 10.5vw, 67px); letter-spacing: -.02em; }\n    .pf-scroll__copy p { margin-top: 16px; font-size: 13px; max-width: 300px; }\n    .pf-scroll__copy .pf-scroll__eyebrow { font-size: 9px; margin-bottom: 14px; }\n    .pf-scroll__chapter { display: none; }\n    .pf-scroll__loading { right: 22px; bottom: 76px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .pf-scroll__hint, .pf-scroll__loading { transition: none; }\n    .pf-scroll__copy { will-change: auto; }\n  }\n</style>\n\n<script>\n(() => {\n  const stories = document.querySelectorAll('[data-pf-scroll]');\n  stories.forEach(root => {\n    if (root.dataset.pfReady === '1') return;\n    root.dataset.pfReady = '1';\n\n    const canvas = root.querySelector('[data-pf-canvas]');\n    const ctx = canvas.getContext('2d', { alpha: false });\n    const urls = JSON.parse(root.querySelector('[data-pf-frames]').textContent).filter(Boolean);\n    const copies = [...root.querySelectorAll('[data-pf-copy]')];\n    const counter = root.querySelector('[data-pf-counter]');\n    const progressBar = root.querySelector('[data-pf-track]');\n    const hint = root.querySelector('[data-pf-hint]');\n    const chapter = root.querySelector('[data-pf-chapter]');\n    const loading = root.querySelector('[data-pf-loading]');\n    const loadingCount = root.querySelector('[data-pf-loading-count]');\n    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    if (!ctx || urls.length !== 154) {\n      loading.textContent = 'FRAME LIST ERROR. CHECK THE SHOPIFY FILE NAMES.';\n      return;\n    }\n\n    const images = Array(urls.length).fill(null);\n    const state = Array(urls.length).fill(0);\n    const queue = [];\n    const maxConcurrent = 5;\n    let active = 0;\n    let loaded = 0;\n    let progress = 0;\n    let targetIndex = 0;\n    let drawnIndex = -1;\n    let ticking = false;\n    let canvasWidth = 0;\n    let canvasHeight = 0;\n    let started = false;\n\n    function enqueue(index, priority = false) {\n      if (index < 0 || index >= urls.length) return;\n      if (state[index] === 1 && priority) {\n        const queuedAt = queue.indexOf(index);\n        if (queuedAt !== -1) {\n          queue.splice(queuedAt, 1);\n          queue.unshift(index);\n        }\n        return;\n      }\n      if (state[index]) return;\n      state[index] = 1;\n      if (priority) queue.unshift(index);\n      else queue.push(index);\n      pump();\n    }\n\n    function pump() {\n      while (active < maxConcurrent && queue.length) {\n        const index = queue.shift();\n        const image = new Image();\n        active++;\n        image.decoding = 'async';\n        image.onload = () => {\n          images[index] = image;\n          state[index] = 2;\n          loaded++;\n          loadingCount.textContent = Math.round(loaded / urls.length * 100) + '%';\n          if (loaded === urls.length || (loaded > 9 && targetIndex < 3)) loading.classList.add('is-hidden');\n          renderFrame();\n          active--;\n          pump();\n        };\n        image.onerror = () => {\n          state[index] = -1;\n          active--;\n          if (index === 0) loading.textContent = 'COULD NOT LOAD FRAMES. CHECK FILE EXTENSION (.jpg/.JPG).';\n          pump();\n        };\n        image.src = urls[index];\n      }\n    }\n\n    function prioritize(index) {\n      enqueue(index, true);\n      for (let gap = 1; gap <= 12; gap++) {\n        enqueue(index + gap, gap <= 4);\n        enqueue(index - gap, gap <= 4);\n      }\n    }\n\n    function resize() {\n      const rect = canvas.getBoundingClientRect();\n      const ratio = Math.min(window.devicePixelRatio || 1, 2);\n      canvasWidth = Math.max(1, Math.round(rect.width * ratio));\n      canvasHeight = Math.max(1, Math.round(rect.height * ratio));\n      if (canvas.width !== canvasWidth || canvas.height !== canvasHeight) {\n        canvas.width = canvasWidth;\n        canvas.height = canvasHeight;\n      }\n      drawnIndex = -1;\n      renderFrame();\n    }\n\n    function renderFrame() {\n      let index = targetIndex;\n      if (!images[index]) {\n        let bestDistance = Infinity;\n        images.forEach((image, i) => {\n          if (image && Math.abs(i - targetIndex) < bestDistance) {\n            bestDistance = Math.abs(i - targetIndex);\n            index = i;\n          }\n        });\n      }\n      const image = images[index];\n      if (!image || (index === drawnIndex && canvas.width === canvasWidth)) return;\n      drawnIndex = index;\n      ctx.fillStyle = '#080909';\n      ctx.fillRect(0, 0, canvasWidth, canvasHeight);\n      const mobile = window.innerWidth < 750;\n      const scale = mobile\n        ? Math.min(canvasWidth / image.naturalWidth, canvasHeight / image.naturalHeight)\n        : Math.max(canvasWidth / image.naturalWidth, canvasHeight / image.naturalHeight);\n      const width = image.naturalWidth * scale;\n      const height = image.naturalHeight * scale;\n      const x = (canvasWidth - width) / 2;\n      const y = (canvasHeight - height) / 2;\n      ctx.imageSmoothingEnabled = true;\n      ctx.imageSmoothingQuality = 'high';\n      ctx.drawImage(image, x, y, width, height);\n    }\n\n    function smoothstep(value) {\n      const x = Math.max(0, Math.min(1, value));\n      return x * x * (3 - 2 * x);\n    }\n\n    function renderText() {\n      copies.forEach(copy => {\n        const start = Number(copy.dataset.pfStart);\n        const end = Number(copy.dataset.pfEnd);\n        const fade = .055;\n        const fadeIn = start === 0 ? 1 : smoothstep((progress - start) / fade);\n        const fadeOut = end >= 1 ? 1 : 1 - smoothstep((progress - (end - fade)) / fade);\n        const opacity = Math.min(fadeIn, fadeOut);\n        copy.style.opacity = opacity.toFixed(3);\n        copy.style.transform = `translate3d(0, ${((1 - opacity) * 34 - 17).toFixed(1)}px, 0)`;\n        copy.setAttribute('aria-hidden', opacity < .1 ? 'true' : 'false');\n      });\n      progressBar.style.transform = `scaleX(${progress})`;\n      hint.style.opacity = progress > .025 ? '0' : '1';\n      counter.innerHTML = String(targetIndex + 1).padStart(3, '0') + ' <span>/</span> 154';\n      chapter.textContent = progress < .23 ? 'DISCOVER THE FLOW'\n        : progress < .48 ? 'BUILT TO BREATHE'\n        : progress < .75 ? 'ENERGY IN MOTION'\n        : 'MOVE YOUR WAY';\n    }\n\n    function update() {\n      ticking = false;\n      const scrollLength = Math.max(1, root.offsetHeight - window.innerHeight);\n      const rect = root.getBoundingClientRect();\n      progress = Math.max(0, Math.min(1, -rect.top / scrollLength));\n      targetIndex = reducedMotion.matches ? 0 : Math.round(progress * (urls.length - 1));\n      if (started) prioritize(targetIndex);\n      renderFrame();\n      renderText();\n    }\n\n    function onScroll() {\n      if (ticking) return;\n      ticking = true;\n      requestAnimationFrame(update);\n    }\n\n    function startLoading() {\n      if (started) return;\n      started = true;\n      prioritize(targetIndex);\n      for (let i = 0; i < urls.length; i++) enqueue(i);\n    }\n\n    resize();\n    if ('IntersectionObserver' in window) {\n      const observer = new IntersectionObserver(entries => {\n        if (!entries.some(entry => entry.isIntersecting)) return;\n        startLoading();\n        observer.disconnect();\n      }, { rootMargin: '1000px 0px' });\n      observer.observe(root);\n    } else {\n      startLoading();\n    }\n    window.addEventListener('scroll', onScroll, { passive: true });\n    window.addEventListener('resize', () => { resize(); onScroll(); }, { passive: true });\n    update();\n  });\n})();\n</script>",
