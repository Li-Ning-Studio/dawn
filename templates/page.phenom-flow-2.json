      "settings": {
        "custom_liquid": "{% comment %}\n  PHENOM FLOW – Apple-style scroll-scrubbed hero (HNDRD)\n  Paste into a Custom Liquid section.\n\n  Settings on the <section> tag:\n    data-scroll   → scroll length in vh (higher = slower video)\n    data-offset   → \"auto\" detects a sticky header so the shoe stays centred\n                    in the visible area, or set a number in px (e.g. \"70\")\n    --hsv-nudge-x / --hsv-nudge-y → fine-tune the shoe position if the source\n                    video itself isn't perfectly centred (e.g. -2%)\n{% endcomment %}\n\n<style>\n  .hsv {\n    --hsv-scroll: 600vh;\n    --hsv-offset: 0px;\n    --hsv-nudge-x: 0%;\n    --hsv-nudge-y: 0%;\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    height: var(--hsv-scroll);\n    background: #000;\n  }\n\n  .hsv__stage {\n    position: sticky;\n    top: var(--hsv-offset);\n    width: 100%;\n    height: calc(100vh - var(--hsv-offset));\n    height: calc(100svh - var(--hsv-offset));\n    overflow: hidden;\n    background: #000;\n    contain: strict;\n  }\n\n  .hsv__video {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: 50% 50%;\n    background: #000;\n    pointer-events: none;\n    transform: translate3d(calc(-50% + var(--hsv-nudge-x)), calc(-50% + var(--hsv-nudge-y)), 0);\n    opacity: 0;\n    transition: opacity 1.2s cubic-bezier(.25,.1,.25,1);\n    backface-visibility: hidden;\n  }\n  .hsv.is-ready .hsv__video { opacity: 1; }\n\n  /* Apple-style headline */\n  .hsv__intro {\n    position: absolute;\n    z-index: 2;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    padding: clamp(40px, 8vh, 90px) 24px 0;\n    text-align: center;\n    pointer-events: none;\n    will-change: transform, opacity;\n  }\n\n  .hsv__intro h2 {\n    margin: 0;\n    font-family: \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\n    font-size: clamp(44px, 6.4vw, 96px);\n    font-weight: 600;\n    line-height: 1.02;\n    letter-spacing: -.035em;\n    background: linear-gradient(180deg, #f5f5f7 0%, #d2d2d7 55%, #8e8e93 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: #e8e8ed;\n  }\n\n  .hsv__intro p {\n    margin: 14px 0 0;\n    font-family: \"SF Pro Text\", -apple-system, BlinkMacSystemFont, \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\n    font-size: clamp(17px, 1.9vw, 26px);\n    font-weight: 500;\n    letter-spacing: -.01em;\n    color: #86868b;\n  }\n\n  .hsv__intro h2,\n  .hsv__intro p {\n    opacity: 0;\n    transform: translate3d(0, 18px, 0);\n    transition: opacity 1.1s cubic-bezier(.25,.1,.25,1), transform 1.1s cubic-bezier(.25,.1,.25,1);\n  }\n  .hsv__intro p { transition-delay: .18s; }\n  .hsv.is-in .hsv__intro h2,\n  .hsv.is-in .hsv__intro p {\n    opacity: 1;\n    transform: none;\n  }\n\n  @media (max-width: 749px) {\n    .hsv__intro { padding-top: clamp(48px, 12vh, 110px); }\n    .hsv__video { width: 100%; height: 100%; object-fit: contain; }\n    .hsv__intro h2 { font-size: clamp(40px, 12vw, 64px); }\n    .hsv__intro p  { font-size: 17px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hsv { height: 100svh !important; }\n    .hsv__intro h2, .hsv__intro p, .hsv__video { transition: none; }\n  }\n</style>\n\n<section\n  class=\"hsv\"\n  data-scroll=\"600\"\n  data-offset=\"auto\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/8f741d9015554854aeb2e745f94253d2.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/bb45f70663a847da8846c675c7496308.mp4\"\n>\n  <div class=\"hsv__stage\">\n    <video\n      class=\"hsv__video\"\n      muted\n      playsinline\n      webkit-playsinline\n      preload=\"auto\"\n      disablepictureinpicture\n      disableremoteplayback\n      aria-hidden=\"true\"\n    ></video>\n\n    <div class=\"hsv__intro\">\n      <h2>Phenom Flow</h2>\n      <p>Engineered to move.</p>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  function initHSV(section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n\n    var video = section.querySelector('.hsv__video');\n    var intro = section.querySelector('.hsv__intro');\n\n    var mobileQuery   = window.matchMedia('(max-width: 749px)');\n    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    /* Low-end device detection: less smoothing work, no in-memory copy on tiny-RAM phones */\n    var mem   = navigator.deviceMemory || 4;\n    var cores = navigator.hardwareConcurrency || 4;\n    var lowEnd = mem <= 2 || cores <= 4;\n    var EASE = lowEnd ? 0.18 : 0.12;\n\n    section.style.setProperty('--hsv-scroll', (parseFloat(section.dataset.scroll) || 600) + 'vh');\n\n    var ready = false, visible = false, rafId = 0;\n    var current = 0, target = 0, lastT = 0;\n    var activeSrc = '', blobUrl = '', token = 0;\n    var top0 = 0, range = 1, vh = window.innerHeight;\n\n    function clamp(n, a, b) { return n < a ? a : n > b ? b : n; }\n\n    /* theme wrappers with overflow:hidden break position:sticky */\n    function fixStickyAncestors() {\n      var p = section.parentElement;\n      while (p && p !== document.documentElement) {\n        var cs = getComputedStyle(p);\n        if (cs.overflowX === 'hidden' || cs.overflowY === 'hidden') {\n          p.style.overflowY = 'visible';\n          p.style.overflowX = 'clip';\n        }\n        p = p.parentElement;\n      }\n    }\n\n    /* keep the shoe centred in the area below a sticky header */\n    function applyOffset() {\n      var o = section.dataset.offset;\n      var px = 0;\n      if (o === 'auto') {\n        var h = document.querySelector('.shopify-section-header-sticky, .section-header, header');\n        if (h) {\n          var pos = getComputedStyle(h).position;\n          if (pos === 'sticky' || pos === 'fixed') px = Math.round(h.getBoundingClientRect().height);\n        }\n      } else {\n        px = parseFloat(o) || 0;\n      }\n      section.style.setProperty('--hsv-offset', px + 'px');\n    }\n\n    /* cache layout once; reading getBoundingClientRect every frame costs on old phones */\n    function measure() {\n      vh = window.innerHeight;\n      var rect = section.getBoundingClientRect();\n      top0 = rect.top + window.pageYOffset;\n      range = Math.max(1, section.offsetHeight - vh);\n    }\n\n    function progress() {\n      return clamp((window.pageYOffset - top0) / range, 0, 1);\n    }\n\n    function updateText(p) {\n      if (reducedMotion.matches) return;\n      var t = clamp(p / 0.12, 0, 1);\n      var e = t * t * (3 - 2 * t);\n      intro.style.opacity = 1 - e;\n      intro.style.transform = 'translate3d(0,' + (-90 * e) + 'px,0) scale(' + (1 - 0.05 * e) + ')';\n      intro.style.visibility = t >= 1 ? 'hidden' : 'visible';\n    }\n\n    /* one seek at a time; the next one starts when the browser finishes the last */\n    function seek(t) {\n      if (!ready || video.seeking) return;\n      var d = video.duration;\n      if (!isFinite(d)) return;\n      t = clamp(t, 0, d - 0.04);\n      if (Math.abs(video.currentTime - t) > 0.02) {\n        try { video.currentTime = t; } catch (e) {}\n      }\n    }\n\n    function frame(now) {\n      rafId = 0;\n      var dt = lastT ? clamp((now - lastT) / 16.667, 0.5, 3) : 1;\n      lastT = now;\n\n      var p = progress();\n      updateText(p);\n\n      if (ready) {\n        target = p * video.duration;\n        current += (target - current) * (1 - Math.pow(1 - EASE, dt));\n        if (Math.abs(target - current) < 0.005) current = target;\n        seek(current);\n      }\n\n      /* stop the loop when nothing is moving: zero CPU while idle */\n      if (visible && (!ready || current !== target)) start();\n    }\n\n    function start() {\n      if (!rafId && visible) rafId = requestAnimationFrame(frame);\n    }\n\n    function onScroll() { lastT = lastT || performance.now(); start(); }\n\n    function markReady() {\n      if (ready) return;\n      ready = true;\n      current = target = progress() * video.duration;\n      seek(current);\n      section.classList.add('is-ready');\n      start();\n    }\n\n    /* paint the first frame (Safari shows nothing until played once) */\n    function prime() {\n      var pr;\n      try { pr = video.play(); } catch (e) {}\n      if (pr && pr.then) pr.then(function () { video.pause(); markReady(); }).catch(markReady);\n      else { video.pause(); markReady(); }\n    }\n\n    function attach(src) { video.src = src; video.load(); }\n\n    function loadVideo() {\n      var src = mobileQuery.matches ? section.dataset.mobile : section.dataset.desktop;\n      if (!src || src === activeSrc) return;\n      activeSrc = src;\n      ready = false;\n      section.classList.remove('is-ready');\n      var my = ++token;\n      video.pause();\n\n      /* in-memory copy makes seeking instant; skip it on very low-RAM phones */\n      if (!window.fetch || mem <= 1) { attach(src); return; }\n\n      fetch(src, { mode: 'cors' })\n        .then(function (r) { if (!r.ok) throw 0; return r.blob(); })\n        .then(function (b) {\n          if (my !== token) return;\n          if (blobUrl) URL.revokeObjectURL(blobUrl);\n          blobUrl = URL.createObjectURL(b);\n          attach(blobUrl);\n        })\n        .catch(function () { if (my === token) attach(src); });\n    }\n\n    video.addEventListener('loadeddata', function () { if (isFinite(video.duration)) prime(); });\n    video.addEventListener('seeked', start);\n    video.addEventListener('error', function () {\n      if (video.src.indexOf('blob:') === 0) { attach(activeSrc); return; }\n      video.loop = true;\n      section.classList.add('is-ready');\n      video.play().catch(function () {});\n    });\n\n    window.addEventListener('touchstart', function () {\n      if (!ready) return;\n      var pr = video.play();\n      if (pr && pr.then) pr.then(function () { video.pause(); seek(current); }).catch(function () {});\n    }, { once: true, passive: true });\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (en) {\n        visible = en[0].isIntersecting;\n        if (visible) { lastT = 0; start(); }\n        else if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }\n      }, { rootMargin: '100px 0px' }).observe(section);\n    } else {\n      visible = true;\n    }\n\n    var resizeT;\n    function onResize() {\n      clearTimeout(resizeT);\n      resizeT = setTimeout(function () { applyOffset(); measure(); start(); }, 150);\n    }\n\n    window.addEventListener('scroll', onScroll, { passive: true });\n    window.addEventListener('resize', onResize, { passive: true });\n    window.addEventListener('load', function () { applyOffset(); measure(); start(); });\n\n    if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', loadVideo);\n    else mobileQuery.addListener(loadVideo);\n\n    fixStickyAncestors();\n    applyOffset();\n    measure();\n    loadVideo();\n    updateText(progress());\n\n    /* headline fade-in on arrival */\n    requestAnimationFrame(function () { section.classList.add('is-in'); });\n  }\n\n  function boot() { document.querySelectorAll('.hsv').forEach(initHSV); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_eqhTBn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n@font-face {\n  font-family: 'HNSF-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNSF-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n}\n\n/* BASE */\n.hnsf-v2,\n.hnsf-v2 * {\n  box-sizing: border-box;\n}\n\n.hnsf-v2 {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  margin: 0;\n  color: #ffffff;\n  background: #000000 !important;\n  background-image: none !important;\n}\n\n/* fine grain so the gradient stays smooth on every screen (no banding) */\n.hnsf-v2-content::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: .06;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n}\n\n/* DESKTOP GRID */\n.hnsf-v2-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  align-items: center;\n  position: relative;\n  z-index: 1;\n  width: 100%;\n}\n\n/* IMAGE */\n.hnsf-v2-media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  overflow: hidden;\n  padding: 0;\n  margin: 0;\n}\n\n.hnsf-v2-media img {\n  display: block;\n  position: static !important;\n  width: 100% !important;\n  height: auto !important;\n  max-width: 100% !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* CONTENT */\n.hnsf-v2-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  padding: 65px 40px;\n  position: relative;\n  isolation: isolate;\n  align-self: stretch;\n  /* STUDIO PANEL: grey light top-left, black centre, grey glow bottom-right */\n  background-image: linear-gradient(\n    166deg,\n    #6b6b6b 0%,\n    #6b6b6b 7%,\n    #434343 15%,\n    #1f1f1f 25%,\n    #080808 33%,\n    #000000 38%,\n    #000000 70%,\n    #191919 82%,\n    #383838 91%,\n    #5c5c5c 100%\n  ) !important;\n  background-color: #000000 !important;\n}\n\n.hnsf-v2-inner {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* LABEL */\n.hnsf-v2 .hnsf-v2-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HNSF-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.8);\n}\n\n/* HEADING */\n.hnsf-v2 .hnsf-v2-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n\n  font-family: 'HNSF-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(30px, 3.4vw, 52px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hnsf-v2 .hnsf-v2-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'HNSF-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  text-transform: none !important;\n  color: #e4e4e4;\n}\n\n/* CTA */\n.hnsf-v2 .hnsf-v2-cta,\n.hnsf-v2 .hnsf-v2-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HNSF-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .015em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hnsf-v2-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hnsf-v2 .hnsf-v2-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 10px 28px rgba(255,255,255,.12);\n  }\n\n  .hnsf-v2-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hnsf-v2-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hnsf-v2-content {\n    padding: 45px 25px;\n  }\n\n  .hnsf-v2 .hnsf-v2-title {\n    font-size: clamp(26px, 3vw, 38px);\n  }\n\n  .hnsf-v2 .hnsf-v2-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n\n  .hnsf-v2-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .hnsf-v2-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hnsf-v2-media img {\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  .hnsf-v2-content {\n    order: 1;\n    padding: 84px 28px 72px;\n  }\n\n  .hnsf-v2-inner {\n    max-width: 460px;\n  }\n\n  .hnsf-v2 .hnsf-v2-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hnsf-v2 .hnsf-v2-title {\n    margin-bottom: 22px;\n    font-size: clamp(28px, 7vw, 42px);\n    letter-spacing: -.025em !important;\n    line-height: 1.08 !important;\n  }\n\n  .hnsf-v2 .hnsf-v2-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hnsf-v2 .hnsf-v2-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hnsf-v2-content {\n    padding: 76px 23px 64px;\n  }\n\n  .hnsf-v2 .hnsf-v2-title {\n    font-size: 28px;\n  }\n\n  .hnsf-v2 .hnsf-v2-description {\n    font-size: 12px;\n  }\n}\n\n/* ACCESSIBILITY */\n@media (prefers-reduced-motion: reduce) {\n  .hnsf-v2-cta,\n  .hnsf-v2-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hnsf-v2\">\n  <div class=\"hnsf-v2-grid\">\n\n    <!-- LEFT IMAGE -->\n    <div class=\"hnsf-v2-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_2_990abf09-4ec9-42f2-b215-145a4c7e9bc9.jpg?v=1793177980\"\n        alt=\"HNDRD Phenom  Flow Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n    </div>\n\n    <!-- RIGHT CONTENT -->\n    <div class=\"hnsf-v2-content\">\n      <div class=\"hnsf-v2-inner\">\n\n        <p class=\"hnsf-v2-label\">\n          HNDRD PHENOM FLOW        </p>\n\n        <h2 class=\"hnsf-v2-title\">\n          SOFT LANDING\n        </h2>\n\n        <p class=\"hnsf-v2-description\">\n          A nitrogen-infused cushion called Thrustfoam is placed right under the heel. It makes every landing soft, with just enough bounce-back to keep you comfortable, step after step.\n        </p>\n\n        <a\n          class=\"hnsf-v2-cta\"\n          href=\"https://in.hndrd.co/products/phenom-flow\"\n          aria-label=\"Shop HNDRD Phenom Flow\"\n        >\n          SHOP Phenom flow\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_dM3aAK": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* FIXTURE FONTS */\n@font-face {\n  font-family: 'HNLT-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNLT-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* BASE */\n.hnlt-v2,\n.hnlt-v2 * {\n  box-sizing: border-box;\n}\n\n.hnlt-v2 {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n  color: #ffffff;\n\n  background: #000000 !important;\n  background-image: none !important;\n}\n\n/* GRID */\n.hnlt-v2-grid {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  width: 100%;\n  align-items: center;\n}\n\n/* LEFT TEXT */\n.hnlt-v2-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  padding: 65px 40px;\n  /* STUDIO PANEL: grey light top-left, black centre, grey glow bottom-right */\n  position: relative;\n  isolation: isolate;\n  align-self: stretch;\n  background-color: #000000 !important;\n  background-image: linear-gradient(\n    166deg,\n    #6b6b6b 0%,\n    #6b6b6b 7%,\n    #434343 15%,\n    #1f1f1f 25%,\n    #080808 33%,\n    #000000 38%,\n    #000000 70%,\n    #191919 82%,\n    #383838 91%,\n    #5c5c5c 100%\n  ) !important;\n}\n\n/* fine grain so the gradient stays smooth on every screen (no banding) */\n.hnlt-v2-content::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: .06;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n}\n\n.hnlt-v2-inner {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* RIGHT IMAGE */\n.hnlt-v2-media {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  height: auto;\n  padding: 0;\n  margin: 0;\n  overflow: hidden;\n  background: transparent;\n}\n\n.hnlt-v2-media img {\n  position: static !important;\n  display: block;\n  width: 100% !important;\n  height: auto !important;\n  max-width: 100% !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* LABEL */\n.hnlt-v2 .hnlt-v2-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.8);\n}\n\n/* HEADING */\n.hnlt-v2 .hnlt-v2-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(28px, 3.2vw, 50px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  overflow-wrap: break-word;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hnlt-v2 .hnlt-v2-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  color: #e4e4e4;\n}\n\n/* CTA */\n.hnlt-v2 .hnlt-v2-cta,\n.hnlt-v2 .hnlt-v2-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n  letter-spacing: .015em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hnlt-v2-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hnlt-v2 .hnlt-v2-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 10px 28px rgba(255,255,255,.12);\n  }\n\n  .hnlt-v2-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hnlt-v2-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hnlt-v2-content {\n    padding: 45px 25px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    font-size: clamp(24px, 3vw, 34px);\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .hnlt-v2-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  /* IMAGE FIRST */\n  .hnlt-v2-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hnlt-v2-media img {\n    position: static !important;\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  /* CONTENT BELOW */\n  .hnlt-v2-content {\n    order: 1;\n    padding: 84px 28px 72px;\n  }\n\n  .hnlt-v2-inner {\n    max-width: 460px;\n  }\n\n  .hnlt-v2 .hnlt-v2-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    margin-bottom: 22px;\n    font-size: clamp(27px, 7vw, 40px);\n    line-height: 1.08 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hnlt-v2-content {\n    padding: 76px 23px 64px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    font-size: 26px;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 12px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  .hnlt-v2-cta,\n  .hnlt-v2-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hnlt-v2\">\n  <div class=\"hnlt-v2-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hnlt-v2-content\">\n      <div class=\"hnlt-v2-inner\">\n\n        <p class=\"hnlt-v2-label\">\n          HNDRD Phenom Flow\n        </p>\n\n        <h2 class=\"hnlt-v2-title\">\n          Just Breathe\n        </h2>\n\n        <p class=\"hnlt-v2-description\">\n          Every layer of this shoe can breathe: the insole, the support plate, and the upper. Air circulates throughout, providing complete ventilation and comfort.\n        </p>\n\n        <a\n          class=\"hnlt-v2-cta\"\n          href=\"https://in.hndrd.co/products/phenom-flow\"\n          aria-label=\"Explore HNDRD Phenom Flow\"\n        >\n          Explore Phenom flow\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n\n    <!-- RIGHT PRODUCT IMAGE -->\n    <div class=\"hnlt-v2-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_1_e6eac2b3-bb85-4fee-95d7-cd47647c5268.jpg?v=1793177980\"\n        alt=\"HNDRD Phenom flow Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n    </div>\n\n  </div>\n</section>",
