ontain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* LABEL */\n.hndrd-adapt-reverse .hndrd-adapt-reverse-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: #ffffff;\n}\n\n/* HEADING */\n.hndrd-adapt-reverse .hndrd-adapt-reverse-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(28px, 3.2vw, 50px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  overflow-wrap: break-word;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hndrd-adapt-reverse .hndrd-adapt-reverse-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  color: #f1f1f1;\n}\n\n/* CTA */\n.hndrd-adapt-reverse .hndrd-adapt-reverse-cta,\n.hndrd-adapt-reverse .hndrd-adapt-reverse-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n  letter-spacing: .015em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hndrd-adapt-reverse-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 22px rgba(0,0,0,.2);\n  }\n\n  .hndrd-adapt-reverse-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hndrd-adapt-reverse-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hndrd-adapt-reverse-content {\n    padding: 45px 25px;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-title {\n    font-size: clamp(24px, 3vw, 34px);\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .hndrd-adapt-reverse {\n    background: linear-gradient(\n      140deg,\n      #ffffff 0%,\n      #ededed 8%,\n      #b8b8b8 19%,\n      #777777 30%,\n      #383838 40%,\n      #101010 47%,\n      #000000 49%,\n      #000000 51%,\n      #101010 53%,\n      #383838 60%,\n      #777777 70%,\n      #b8b8b8 81%,\n      #ededed 92%,\n      #ffffff 100%\n    );\n  }\n\n  .hndrd-adapt-reverse-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  /* IMAGE FIRST */\n  .hndrd-adapt-reverse-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hndrd-adapt-reverse-media img {\n    position: static !important;\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  /* CONTENT BELOW */\n  .hndrd-adapt-reverse-content {\n    order: 1;\n    padding: 35px 28px 60px;\n  }\n\n  .hndrd-adapt-reverse-inner {\n    max-width: 460px;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-title {\n    margin-bottom: 22px;\n    font-size: clamp(27px, 7vw, 40px);\n    line-height: 1.08 !important;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hndrd-adapt-reverse-content {\n    padding: 30px 23px 50px;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-title {\n    font-size: 26px;\n  }\n\n  .hndrd-adapt-reverse .hndrd-adapt-reverse-description {\n    font-size: 12px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  .hndrd-adapt-reverse-cta,\n  .hndrd-adapt-reverse-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hndrd-adapt-reverse\">\n  <div class=\"hndrd-adapt-reverse-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hndrd-adapt-reverse-content\">\n      <div class=\"hndrd-adapt-reverse-inner\">\n\n        <p class=\"hndrd-adapt-reverse-label\">\n          HNDRD HYPERCOURT ADAPT\n        </p>\n\n        <h2 class=\"hndrd-adapt-reverse-title\">\n          LOCK-IN TRACTION\n        </h2>\n\n        <p class=\"hndrd-adapt-reverse-description\">\n          The non-marking rubber outsole delivers a strong and\n          durable grip, allowing confident starts, stops, and\n          slides. The outsole has upgraded abrasion resistance,\n          20% higher than any regular outsole.\n        </p>\n\n        <a\n          class=\"hndrd-adapt-reverse-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Explore HNDRD Hypercourt Adapt\"\n        >\n          Explore Hypercourt Adapt\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n\n    <!-- RIGHT PRODUCT IMAGE -->\n    <div class=\"hndrd-adapt-reverse-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_3_929c4148-c8d0-4a68-94c3-c44ec2784d98.jpg?v=1793177980\"\n        alt=\"HNDRD Hypercourt Adapt Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n    </div>\n\n  </div>\n</section>",
