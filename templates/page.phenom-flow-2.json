        "custom_liquid": "<style>\n@font-face {\n  font-family: 'HN-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HN-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n}\n\n/* BASE */\n.hndrd-secure-fit,\n.hndrd-secure-fit * {\n  box-sizing: border-box;\n}\n\n.hndrd-secure-fit {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  margin: 0;\n  color: #ffffff;\n\n  /* WIDE SOFT DIAGONAL GRADIENT */\n  background: linear-gradient(\n    140deg,\n    #ffffff 0%,\n    #ededed 8%,\n    #b8b8b8 19%,\n    #777777 30%,\n    #383838 40%,\n    #101010 47%,\n    #000000 49%,\n    #000000 51%,\n    #101010 53%,\n    #383838 60%,\n    #777777 70%,\n    #b8b8b8 81%,\n    #ededed 92%,\n    #ffffff 100%\n  );\n}\n\n/* DESKTOP GRID */\n.hndrd-secure-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  align-items: center;\n  position: relative;\n  z-index: 1;\n  width: 100%;\n}\n\n/* IMAGE */\n.hndrd-secure-media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  overflow: hidden;\n  padding: 0;\n  margin: 0;\n}\n\n.hndrd-secure-media img {\n  display: block;\n  position: static !important;\n  width: 100% !important;\n  height: auto !important;\n  max-width: 100% !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* CONTENT */\n.hndrd-secure-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  padding: 65px 40px;\n  background: transparent;\n}\n\n.hndrd-secure-inner {\n  width: 100%;\n  max-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* LABEL */\n.hndrd-secure-fit .hndrd-secure-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: #ffffff;\n}\n\n/* HEADING */\n.hndrd-secure-fit .hndrd-secure-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(30px, 3.4vw, 52px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hndrd-secure-fit .hndrd-secure-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'HN-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  text-transform: none !important;\n  color: #f1f1f1;\n}\n\n/* CTA */\n.hndrd-secure-fit .hndrd-secure-cta,\n.hndrd-secure-fit .hndrd-secure-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HN-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .015em;