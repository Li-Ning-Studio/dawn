    "custom_liquid_eqhTBn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n@font-face {\n  font-family: 'HNSF-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNSF-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n}\n\n/* BASE */\n.hnsf-v2,\n.hnsf-v2 * {\n  box-sizing: border-box;\n}\n\n.hnsf-v2 {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  margin: 0;\n  color: #ffffff;\n  background: #000000 !important;\n  background-image: none !important;\n}\n\n/* fine grain so the gradient stays smooth on every screen (no banding) */\n.hnsf-v2-content::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: .06;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n}\n\n/* DESKTOP GRID */\n.hnsf-v2-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  align-items: center;\n  position: relative;\n  z-index: 1;\n  width: 100%;\n}\n\n/* IMAGE */\n.hnsf-v2-media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  overflow: hidden;\n  padding: 0;\n  margin: 0;\n}\n\n.hnsf-v2-media img {\n  display: block;\n  position: static !important;\n  width: 100% !important;\n  height: auto !important;\n  max-width: 100% !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* CON