      "settings": {
        "custom_liquid": "{% assign pf_store_id = section.id | default: 'custom-liquid' %}\n{% assign pf_file_extension = 'jpg' %}\n\n<section class=\"pf-scroll\" data-pf-scroll data-pf-id=\"{{ pf_store_id }}\" aria-label=\"Phenom Flow product film\">\n  <div class=\"pf-scroll__sticky\">\n    <canvas class=\"pf-scroll__canvas\" data-pf-canvas aria-label=\"Phenom Flow shoe animation controlled by page scrolling\" role=\"img\"></canvas>\n    <div class=\"pf-scroll__shade\" aria-hidden=\"true\"></div>\n\n    <div class=\"pf-scroll__topline\">\n      <span class=\"pf-scroll__mark\">HNDRD <span class=\"pf-scroll__mark-sep\">/</span> PHENOM FLOW</span>\n      <span class=\"pf-scroll__count\" data-pf-counter>001 <span>/</span> 154</span>\n    </div>\n\n    <div class=\"pf-scroll__copy\" data-pf-copy data-pf-start=\"0\" data-pf-end=\"0.22\">\n      <span class=\"pf-scroll__eyebrow\">THE NEW STANDARD OF MOVEMENT</span>\n      <h2>BUILT TO <em>FLOW.</em></h2>\n      <p>Every movement. Without hesitation.</p>\n    </div>\n\n    <div class=\"pf-scroll__copy\" data-pf-copy data-pf-start=\"0.23\" data-pf-end=\"0.46\">\n      <span class=\"pf-scroll__eyebrow\">01 / AERO FLOW MESH</span>\n      <h2>LET YOUR<br><em>FEET BREATHE.</em></h2>\n      <p>Lightweight airflow, made for the pace of play.</p>\n    </div>\n\n    <div class=\"pf-scroll__copy\" data-pf-copy data-pf-start=\"0.48\" data-pf-end=\"0.72\">\n      <span class=\"pf-scroll__eyebrow\">02 / THRUST FOAM</span>\n      <h2>ENERGY IN.<br><em>ENERGY OUT.</em></h2>\n      <p>Nitrogen-infused cushioning that keeps you moving.</p>\n    </div>\n\n    <div class=\"pf-scroll__copy\" data-pf-copy data-pf-start=\"0.75\" data-pf-end=\"1\">\n      <span class=\"pf-scroll__eyebrow\">HNDRD / PHENOM FLOW</span>\n      <h2>FIND YOUR<br><em>FLOW.</em></h2>\n      <p>Designed for the demands of the court.</p>\n    </div>\n\n    <div class=\"pf-scroll__footer\">\n      <span class=\"pf-scroll__hint\" data-pf-hint><span class=\"pf-scroll__hint-line\"></span> SCROLL TO EXPLORE</span>\n      <span class=\"pf-scroll__chapter\" data-pf-chapter>DISCOVER THE FLOW</span>\n    </div>\n    <div class=\"pf-scroll__track\" aria-hidden=\"true\"><div class=\"pf-scroll__track-fill\" data-pf-track></div></div>\n    <div class=\"pf-scroll__loading\" data-pf-loading role=\"status\" aria-live=\"polite\">LOADING THE EXPERIENCE <span data-pf-loading-count>0%</span></div>\n  </div>\n\n  <script type=\"application/json\" data-pf-frames>\n  [\n    {% for pf_n in (48..97) %}\n      {% assign pf_digits = pf_n | prepend: '0000' | slice: -4, 4 %}\n      {% capture pf_filename %}FinalShot20001-027{{ pf_digits }}.{{ pf_file_extension }}{% endcapture %}\n      {{ pf_filename | file_url | json }},\n    {% endfor %}\n    {% for pf_n in (98..147) %}\n      {% assign pf_digits = pf_n | prepend: '0000' | slice: -4, 4 %}\n      {% capture pf_filename %}FinalShot20001-027{{ pf_digits }}.{{ pf_file_extension }}{% endcapture %}\n      {{ pf_filename | file_url | json }},\n    {% endfor %}\n    {% for pf_n in (148..197) %}\n      {% assign pf_digits = pf_n | prepend: '0000' | slice: -4, 4 %}\n      {% capture pf_filename %}FinalShot20001-027{{ pf_digits }}.{{ pf_file_extension }}{% endcapture %}\n      {{ pf_filename | file_url | json }},\n    {% endfor %}\n    {% for pf_n in (198..201) %}\n      {% assign pf_digits = pf_n | prepend: '0000' | slice: -4, 4 %}\n      {% capture pf_filename %}FinalShot20001-027{{ pf_digits }}.{{ pf_file_extension }}{% endcapture %}\n      {{ pf_filename | file_url | json }},\n    {% endfor %}\n    null\n  ]\n  </script>\n</section>\n\n<style>\n  @font-face {\n    font-family: \"PF Gilroy\";\n    src: url(\"{{ 'Gilroy-Regular.ttf' | file_url }}\") format(\"truetype\");\n    font-display: swap;\n  }\n  @font-face {\n    font-family: \"PF Anita\";\n    src: url(\"{{ 'Anita_semi_square.ttf' | file_url }}\") format(\"truetype\");\n    font-display: swap;\n  }\n\n  .pf-scroll, .pf-scroll * { box-sizing: border-box; }\n  .pf-scroll {\n    position: relative;\n    left: 50%;\n    width: 100vw;\n    margin-left: -50vw;\n    height: 590vh;\n    height: 590svh;\n    color: #f7f7f5;\n    background: #080909;\n    isolation: isolate;\n    font-family: \"PF Gilroy\", Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n  .pf-scroll__sticky {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    height: 100svh;\n    min-height: 440px;\n    width: 100%;\n    overflow: hidden;\n    background: #080909;\n  }\n  .pf-scroll__canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    background: #080909;\n  }\n  .pf-scroll__shade {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: linear-gradient(90deg, rgba(0,0,0,.58) 0%, rgba(0,0,0,.20) 38%, transparent 76%),\n      linear-gradient(0deg, rgba(0,0,0,.60), transparent 24%, transparent 75%, rgba(0,0,0,.30));\n  }\n  .pf-scroll__topline, .pf-scroll__footer {\n    position: absolute;\n    z-index: 4;\n    left: clamp(22px, 5.4vw, 100px);\n    right: clamp(22px, 5.4vw, 100px);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .20em;\n  }\n  .pf-scroll__topline { top: clamp(25px, 5.4vh, 55px); }\n  .pf-scroll__footer { bottom: clamp(34px, 6.5vh, 70px); }\n  .pf-scroll__mark-sep { opacity: .35; margin-inline: .6em; }\n  .pf-scroll__count { font-variant-numeric: tabular-nums; }\n  .pf-scroll__count span { color: #9b9b9b; margin: 0 .25em; }\n  .pf-scroll__copy {\n    position: absolute;\n    z-index: 3;\n    top: 50%;\n    left: clamp(22px, 9vw, 170px);\n    width: min(650px, 80%);\n    opacity: 0;\n    transform: translate3d(0, 36px, 0);\n    pointer-events: none;\n    will-change: opacity, transform;\n  }\n  .pf-scroll__copy .pf-scroll__eyebrow {\n    display: block;\n    margin-bottom: clamp(15px, 2.5vh, 25px);\n    font-size: clamp(10px, .85vw, 12px);\n    font-weight: 700;\n    line-height: 1.4;\n    letter-spacing: .26em;\n    color: #f4a900;\n  }\n  .pf-scroll__copy h2 {\n    margin: 0;\n    color: #fafafa;\n    font-family: \"PF Anita\", \"PF Gilroy\", sans-serif;\n    font-size: clamp(43px, 6.15vw, 104px);\n    line-height: .96;\n    letter-spacing: -.025em;\n    font-weight: 400;\n  }\n  .pf-scroll__copy h2 em { color: #ffa300; font-style: normal; }\n  .pf-scroll__copy p {\n    margin: 24px 0 0;\n    max-width: 400px;\n    color: rgba(255,255,255,.78);\n    font-size: clamp(13px, 1.16vw, 17px);\n    line-height: 1.5;\n    letter-spacing: .02em;\n  }\n  .pf-scroll__hint { display: flex; align-items: center; gap: 13px; transition: opacity .3s; }\n  .pf-scroll__hint-line { display: block; width: 24px; height: 1px; background: #ffa300; }\n  .pf-scroll__chapter { color: rgba(255,255,255,.62); text-align: right; }\n  .pf-scroll__track {\n    position: absolute;\n    z-index: 4;\n    bottom: 0;\n    width: 100%;\n    height: 3px;\n    background: rgba(255,255,255,.2);\n  }\n  .pf-scroll__track-fill {\n    width: 100%;\n    height: 100%;\n    background: #ffa300;\n    transform: scaleX(0);\n    transform-origin: left center;\n    will-change: transform;\n  }\n  .pf-scroll__loading {\n    position: absolute;\n    z-index: 8;\n    right: clamp(22px, 5.4vw, 100px);\n    bottom: 95px;\n    color: rgba(255,255,255,.7);\n    font-size: 10px;\n    letter-spacing: .14em;\n    transition: opacity .35s;\n    pointer-events: none;\n  }\n  .pf-scroll__loading span { color: #ffa300; margin-left: 8px; }\n  .pf-scroll__loading.is-hidden { opacity: 0; }\n\n  @media (max-width: 749px) {\n    .pf-scroll { height: 460vh; height: 460svh; }\n    .pf-scroll__shade {\n      background: linear-gradient(0deg, rgba(0,0,0,.83) 0%, rgba(0,0,0,.50) 19%, transparent 65%, rgba(0,0,0,.27) 100%);\n    }\n    .pf-scroll__topline, .pf-scroll__footer { left: 22px; right: 22px; font-size: 9px; letter-spacing: .12em; }\n    .pf-scroll__topline { top: 27px; }\n    .pf-scroll__footer { bottom: 38px; }\n    .pf-scroll__copy {\n      top: auto;\n      bottom: 23%;\n      left: 23px;\n      width: calc(100% - 46px);\n    }\n    .pf-scroll__copy h2 { font-size: clamp(39px, 10.5vw, 67px); letter-spacing: -.02em; }\n    .pf-scroll__copy p { margin-top: 16px; font-size: 13px; max-width: 300px; }\n    .pf-scroll__copy .pf-scroll__eyebrow { font-size: 9px; margin-bottom: 14px; }\n    .pf-scroll__chapter { display: none; }\n    .pf-scroll__loading { right: 22px; bottom: 76px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .pf-scroll__hint, .pf-scroll__loading { transition: none; }\n    .pf-scroll__copy { will-change: auto; }\n  }\n</style>\n\n<script>\n(() => {\n  const stories = document.querySelectorAll('[data-pf-scroll]');\n  stories.forEach(root => {\n    if (root.dataset.pfReady === '1') return;\n    root.dataset.pfReady = '1';\n\n    const canvas = root.querySelector('[data-pf-canvas]');\n    const ctx = canvas.getContext('2d', { alpha: false });\n    const urls = JSON.parse(root.querySelector('[data-pf-frames]').textContent).filter(Boolean);\n    const copies = [...root.querySelectorAll('[data-pf-copy]')];\n    const counter = root.querySelector('[data-pf-counter]');\n    const progressBar = root.querySelector('[data-pf-track]');\n    const hint = root.querySelector('[data-pf-hint]');\n    const chapter = root.querySelector('[data-pf-chapter]');\n    const loading = root.querySelector('[data-pf-loading]');\n    const loadingCount = root.querySelector('[data-pf-loading-count]');\n    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    if (!ctx || urls.length !== 154) {\n      loading.textContent = 'FRAME LIST ERROR. CHECK THE SHOPIFY FILE NAMES.';\n      return;\n    }\n\n    const images = Array(urls.length).fill(null);\n    const state = Array(urls.length).fill(0);\n    const queue = [];\n    const maxConcurrent = 5;\n    let active = 0;\n    let loaded = 0;\n    let progress = 0;\n    let targetIndex = 0;\n    let drawnIndex = -1;\n    let ticking = false;\n    let canvasWidth = 0;\n    let canvasHeight = 0;\n    let started = false;\n\n    function enqueue(index, priority = false) {\n      if (index < 0 || index >= urls.length) return;\n      if (state[index] === 1 && priority) {\n        const queuedAt = queue.indexOf(index);\n        if (queuedAt !== -1) {\n          queue.splice(queuedAt, 1);\n          queue.unshift(index);\n        }\n        return;\n      }\n      if (state[index]) return;\n      state[index] = 1;\n      if (priority) queue.unshift(index);\n      else queue.push(index);\n      pump();\n    }\n\n    function pump() {\n      while (active < maxConcurrent && queue.length) {\n        const index = queue.shift();\n        const image = new Image();\n        active++;\n        image.decoding = 'async';\n        image.onload = () => {\n          images[index] = image;\n          state[index] = 2;\n          loaded++;\n          loadingCount.textContent = Math.round(loaded / urls.length * 100) + '%';\n          if (loaded === urls.length || (loaded > 9 && targetIndex < 3)) loading.classList.add('is-hidden');\n          renderFrame();\n          active--;\n          pump();\n        };\n        image.onerror = () => {\n          state[index] = -1;\n          active--;\n          if (index === 0) loading.textContent = 'COULD NOT LOAD FRAMES. CHECK FILE EXTENSION (.jpg/.JPG).';\n          pump();\n        };\n        image.src = urls[index];\n      }\n    }\n\n    function prioritize(index) {\n      enqueue(index, true);\n      for (let gap = 1; gap <= 12; gap++) {\n        enqueue(index + gap, gap <= 4);\n        enqueue(index - gap, gap <= 4);\n      }\n    }\n\n    function resize() {\n      const rect = canvas.getBoundingClientRect();\n      const ratio = Math.min(window.devicePixelRatio || 1, 2);\n      canvasWidth = Math.max(1, Math.round(rect.width * ratio));\n      canvasHeight = Math.max(1, Math.round(rect.height * ratio));\n      if (canvas.width !== canvasWidth || canvas.height !== canvasHeight) {\n        canvas.width = canvasWidth;\n        canvas.height = canvasHeight;\n      }\n      drawnIndex = -1;\n      renderFrame();\n    }\n\n    function renderFrame() {\n      let index = targetIndex;\n      if (!images[index]) {\n        let bestDistance = Infinity;\n        images.forEach((image, i) => {\n          if (image && Math.abs(i - targetIndex) < bestDistance) {\n            bestDistance = Math.abs(i - targetIndex);\n            index = i;\n          }\n        });\n      }\n      const image = images[index];\n      if (!image || (index === drawnIndex && canvas.width === canvasWidth)) return;\n      drawnIndex = index;\n      ctx.fillStyle = '#080909';\n      ctx.fillRect(0, 0, canvasWidth, canvasHeight);\n      const mobile = window.innerWidth < 750;\n      const scale = mobile\n        ? Math.min(canvasWidth / image.naturalWidth, canvasHeight / image.naturalHeight)\n        : Math.max(canvasWidth / image.naturalWidth, canvasHeight / image.naturalHeight);\n      const width = image.naturalWidth * scale;\n      const height = image.naturalHeight * scale;\n      const x = (canvasWidth - width) / 2;\n      const y = (canvasHeight - height) / 2;\n      ctx.imageSmoothingEnabled = true;\n      ctx.imageSmoothingQuality = 'high';\n      ctx.drawImage(image, x, y, width, height);\n    }\n\n    function smoothstep(value) {\n      const x = Math.max(0, Math.min(1, value));\n      return x * x * (3 - 2 * x);\n    }\n\n    function renderText() {\n      copies.forEach(copy => {\n        const start = Number(copy.dataset.pfStart);\n        const end = Number(copy.dataset.pfEnd);\n        const fade = .055;\n        const fadeIn = start === 0 ? 1 : smoothstep((progress - start) / fade);\n        const fadeOut = end >= 1 ? 1 : 1 - smoothstep((progress - (end - fade)) / fade);\n        const opacity = Math.min(fadeIn, fadeOut);\n        copy.style.opacity = opacity.toFixed(3);\n        copy.style.transform = `translate3d(0, ${((1 - opacity) * 34 - 17).toFixed(1)}px, 0)`;\n        copy.setAttribute('aria-hidden', opacity < .1 ? 'true' : 'false');\n      });\n      progressBar.style.transform = `scaleX(${progress})`;\n      hint.style.opacity = progress > .025 ? '0' : '1';\n      counter.innerHTML = String(targetIndex + 1).padStart(3, '0') + ' <span>/</span> 154';\n      chapter.textContent = progress < .23 ? 'DISCOVER THE FLOW'\n        : progress < .48 ? 'BUILT TO BREATHE'\n        : progress < .75 ? 'ENERGY IN MOTION'\n        : 'MOVE YOUR WAY';\n    }\n\n    function update() {\n      ticking = false;\n      const scrollLength = Math.max(1, root.offsetHeight - window.innerHeight);\n      const rect = root.getBoundingClientRect();\n      progress = Math.max(0, Math.min(1, -rect.top / scrollLength));\n      targetIndex = reducedMotion.matches ? 0 : Math.round(progress * (urls.length - 1));\n      if (started) prioritize(targetIndex);\n      renderFrame();\n      renderText();\n    }\n\n    function onScroll() {\n      if (ticking) return;\n      ticking = true;\n      requestAnimationFrame(update);\n    }\n\n    function startLoading() {\n      if (started) return;\n      started = true;\n      prioritize(targetIndex);\n      for (let i = 0; i < urls.length; i++) enqueue(i);\n    }\n\n    resize();\n    if ('IntersectionObserver' in window) {\n      const observer = new IntersectionObserver(entries => {\n        if (!entries.some(entry => entry.isIntersecting)) return;\n        startLoading();\n        observer.disconnect();\n      }, { rootMargin: '1000px 0px' });\n      observer.observe(root);\n    } else {\n      startLoading();\n    }\n    window.addEventListener('scroll', onScroll, { passive: true });\n    window.addEventListener('resize', () => { resize(); onScroll(); }, { passive: true });\n    update();\n  });\n})();\n</script>",
