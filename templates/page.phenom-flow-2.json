frames[i];break}if(frames[i+d]){i+=d;img=frames[i];break}}}\n  if(!img)return;const key=i+quality;if(key===drawn)return;\n  const scale=Math.max(canvas.width/img.naturalWidth,canvas.height/img.naturalHeight),w=img.naturalWidth*scale,h=img.naturalHeight*scale;\n  ctx.drawImage(img,(canvas.width-w)/2,(canvas.height-h)/2,w,h);drawn=key;root.dataset.frame=i+1;root.dataset.quality=quality;root.dataset.painted='true';root.dataset.buffered=frames.filter(Boolean).length;\n }\n function tick(t){raf=0;if(dead)return;measure();const dt=Math.min(50,last?t-last:16);last=t;current+=(target-current)*(1-Math.exp(-dt/60));if(Math.abs(target-current)<.0001)current=target;wanted=Math.round(current*269);paint();if(near&&current!==target)wake()}\n function scroll(){measure();moving=true;if(hdJob)hdJob();clearTimeout(settle);settle=setTimeout(()=>{moving=false;current=target;wanted=destination;wake();sharp()},180);plan();wake()}\n function resize(){if(mobile!==mq.matches){select();return}const r=stage.getBoundingClientRect(),ratio=Math.min(devicePixelRatio||1,1.25);const w=Math.round(r.width*ratio),h=Math.round(r.height*ratio);if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;drawn=''}wake()}\n function cancel(){for(const stop of jobs.values())stop();jobs.clear();if(hdJob)hdJob();clearTimeout(settle);clearTimeout(retry)}\n function select(){cancel();generation++;mobile=mq.matches;urls=JSON.parse(root.querySelector(mobile?'[data-pf-mobile]':'[data-pf-desktop]').textContent);small=urls.map(u=>u.replace(/_\\d+x\\.webp/,mobile?'_180x.webp':'_320x.webp'));frames=Array(270);failed.clear();hd=null;queue=[];drawn='';root.dataset.sequence=mobile?'mobile':'desktop';measure();current=target;wanted=destination;resize();plan();sharp()}\n function visibility(){if(document.hidden){cancel();queue=[]}else{last=0;measure();plan();wake();sharp()}}\n function destroy(e){if(e&&!e.target.contains(root))return;cancel();dead=true;generation++;cancelAnimationFrame(raf);io.disconnect();ro.dis