    "custom_liquid_JUYcVj": {
      "type": "custom-liquid",
      "disabled": true,
      "custom_css": [],
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD | PHENOM FLOW\n  Cinematic Apple-inspired scroll story\n  Paste this entire block into ONE Shopify Custom Liquid section.\n\n  Scroll speed: change data-scroll=\"520\" below.\n    350 = faster | 520 = balanced | 750 = slower\n\n  Video sources are the supplied desktop and mobile Shopify files.\n  Video is loaded immediately, not held up by a full-file fetch.\n{% endcomment %}\n\n<style>\n  .pf26 {\n    --pf26-bg: #000;\n    --pf26-white: #f5f5f7;\n    --pf26-muted: #8a8a90;\n    --pf26-h: 520vh;\n    --pf26-scale: 1.09;\n    --pf26-lift: 0vh;\n    --pf26-intro: 1;\n    --pf26-details: 0;\n    --pf26-cue: 1;\n    --pf26-intro-y: 0px;\n    --pf26-details-y: 0px;\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    height: var(--pf26-h);\n    margin-left: calc(50% - 50vw);\n    background: var(--pf26-bg);\n    color: var(--pf26-white);\n    isolation: isolate;\n    font-family: inherit;\n  }\n\n  .pf26 *, .pf26 *::before, .pf26 *::after { box-sizing: border-box; }\n\n  .pf26__stage {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    height: 100svh;\n    width: 100%;\n    overflow: hidden;\n    background: radial-gradient(ellipse at 50% 47%, #111113 0%, #050505 52%, #000 82%);\n    isolation: isolate;\n  }\n\n  .pf26__film {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    transform: translate3d(0, var(--pf26-lift), 0) scale(var(--pf26-scale));\n    transform-origin: 50% 50%;\n    will-change: transform;\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .pf26__video {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: center center;\n    opacity: 0;\n    transition: opacity .55s ease;\n    background: #000;\n    pointer-events: none;\n  }\n  .pf26.is-ready .pf26__video { opacity: 1; }\n\n  .pf26__vignette {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    pointer-events: none;\n    background: linear-gradient(180deg,\n      rgba(0,0,0,.24) 0%, transparent 19%, transparent 68%,\n      rgba(0,0,0,.22) 100%);\n  }\n\n  .pf26__rail {\n    position: absolute;\n    z-index: 6;\n    top: clamp(22px, 4vh, 42px);\n    left: 50%;\n    width: min(100% - 60px, 1320px);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    transform: translateX(-50%);\n    pointer-events: none;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .15em;\n    line-height: 1.4;\n    text-transform: uppercase;\n    color: rgba(245,245,247,.72);\n  }\n  .pf26__rail span:last-child { color: rgba(245,245,247,.38); }\n\n  .pf26__intro {\n    position: absolute;\n    inset: 0;\n    z-index: 4;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    padding: 0 24px;\n    text-align: center;\n    opacity: var(--pf26-intro);\n    transform: translate3d(0, var(--pf26-intro-y), 0);\n    pointer-events: none;\n  }\n  .pf26__intro h2 {\n    margin: 0;\n    font-family: inherit;\n    font-weight: 600;\n    font-size: clamp(46px, 7.6vw, 116px);\n    letter-spacing: -.065em;\n    line-height: 1.02;\n    text-transform: none;\n    color: #f5f5f7;\n  }\n  .pf26__intro p {\n    margin: 20px 0 0;\n    font-size: clamp(15px, 1.5vw, 22px);\n    font-weight: 400;\n    letter-spacing: -.025em;\n    line-height: 1.4;\n    color: #b9b9bd;\n  }\n\n  .pf26__cue {\n    position: absolute;\n    z-index: 6;\n    left: 50%;\n    bottom: clamp(30px, 5.6vh, 62px);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    transform: translateX(-50%);\n    opacity: var(--pf26-cue);\n    color: #aaaab0;\n    white-space: nowrap;\n    pointer-events: none;\n    font-size: 10px;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n  .pf26__cue-line {\n    display: inline-block;\n    height: 1px;\n    width: 31px;\n    background: currentColor;\n    opacity: .65;\n  }\n\n  .pf26__details {\n    position: absolute;\n    z-index: 5;\n    left: 50%;\n    bottom: clamp(48px, 8vh, 100px);\n    width: min(760px, calc(100% - 56px));\n    transform: translate3d(-50%, var(--pf26-details-y), 0);\n    opacity: var(--pf26-details);\n    pointer-events: none;\n    text-align: center;\n  }\n  .pf26__eyebrow {\n    margin: 0 0 15px;\n    font-size: 10px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    font-weight: 600;\n    color: #a1a1a7;\n  }\n  .pf26__details h3 {\n    margin: 0 auto;\n    max-width: 650px;\n    font-family: inherit;\n    font-size: clamp(33px, 4.6vw, 66px);\n    font-weight: 600;\n    letter-spacing: -.06em;\n    line-height: 1.04;\n    text-transform: none;\n    color: #f5f5f7;\n  }\n  .pf26__description {\n    max-width: 470px;\n    margin: 16px auto 0;\n    font-size: clamp(13px, 1.3vw, 16px);\n    letter-spacing: -.01em;\n    line-height: 1.6;\n    font-weight: 400;\n    color: #939398;\n  }\n  .pf26__specs {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    column-gap: clamp(20px, 5vw, 75px);\n    margin: clamp(22px, 4vh, 40px) auto 0;\n    max-width: 570px;\n    text-align: left;\n  }\n  .pf26__spec {\n    min-width: 0;\n    padding-top: 16px;\n    border-top: 1px solid rgba(245,245,247,.19);\n  }\n  .pf26__spec strong {\n    display: block;\n    font-size: clamp(14px, 1.5vw, 18px);\n    letter-spacing: -.025em;\n    font-weight: 600;\n    color: #e9e9ed;\n  }\n  .pf26__spec span {\n    display: block;\n    padding-top: 5px;\n    font-size: 12px;\n    line-height: 1.45;\n    color: #8c8c92;\n  }\n\n  @media (max-width: 749px) {\n    .pf26 { --pf26-scale: 1.14; }\n    .pf26__rail { width: calc(100% - 36px); top: 22px; font-size: 9px; }\n    .pf26__intro { padding: 0 18px; }\n    .pf26__intro h2 { font-size: clamp(43px, 11.4vw, 66px); letter-spacing: -.055em; }\n    .pf26__intro p { margin-top: 13px; font-size: 16px; }\n    .pf26__cue { bottom: 38px; font-size: 9px; }\n    .pf26__details { width: calc(100% - 42px); bottom: clamp(36px, 6vh, 64px); }\n    .pf26__eyebrow { font-size: 9px; margin-bottom: 10px; }\n    .pf26__details h3 { font-size: clamp(34px, 8.7vw, 48px); }\n    .pf26__description { font-size: 13px; margin-top: 11px; line-height: 1.5; }\n    .pf26__specs { margin-top: 25px; gap: 16px; }\n    .pf26__spec { padding-top: 12px; }\n    .pf26__spec strong { font-size: 13px; }\n    .pf26__spec span { font-size: 11px; }\n  }\n\n  @media (max-width: 749px) and (max-height: 650px) {\n    .pf26__details { bottom: 20px; }\n    .pf26__details h3 { font-size: 31px; }\n    .pf26__description { display: none; }\n    .pf26__specs { margin-top: 15px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pf26 { height: 100svh !important; }\n    .pf26__film { transform: translateY(-14vh) scale(.88) !important; }\n    .pf26__intro, .pf26__cue { display: none; }\n    .pf26__details { opacity: 1 !important; transform: translateX(-50%) !important; }\n    .pf26__video { transition: none; }\n  }\n</style>\n\n<section\n  class=\"pf26\"\n  data-scroll=\"520\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/8f741d9015554854aeb2e745f94253d2.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/ce75a5749d5f4997bf534b9826ef2c2a.mp4\"\n  aria-label=\"Phenom Flow cinematic product story\"\n>\n  <div class=\"pf26__stage\">\n    <div class=\"pf26__film\">\n      <video class=\"pf26__video\" muted playsinline webkit-playsinline preload=\"auto\" disablepictureinpicture disableremoteplayback aria-hidden=\"true\"></video>\n    </div>\n    <div class=\"pf26__vignette\"></div>\n\n    <div class=\"pf26__rail\" aria-hidden=\"true\">\n      <span>HNDRD / Phenom Flow</span>\n      <span>Designed for motion</span>\n    </div>\n\n    <div class=\"pf26__intro\">\n      <h2>Phenom Flow.</h2>\n      <p>Engineered to move.</p>\n    </div>\n\n    <div class=\"pf26__cue\" aria-hidden=\"true\">\n      <span class=\"pf26__cue-line\"></span>\n      <span>Scroll to explore</span>\n      <span class=\"pf26__cue-line\"></span>\n    </div>\n\n    <div class=\"pf26__details\">\n      <p class=\"pf26__eyebrow\">Every movement matters</p>\n      <h3>Find your flow.</h3>\n      <p class=\"pf26__description\">Move freely. Change direction with confidence. Stay in the moment.</p>\n      <div class=\"pf26__specs\">\n        <div class=\"pf26__spec\">\n          <strong>Goodyear rubber</strong>\n          <span>Built for confident traction</span>\n        </div>\n        <div class=\"pf26__spec\">\n          <strong>Fluid movement</strong>\n          <span>Ready for every direction</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  'use strict';\n  var SELECTOR = '.pf26';\n  var mq = window.matchMedia('(max-width: 749px)');\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n  function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }\n  function smooth(a, b, x) {\n    var t = clamp((x - a) / (b - a), 0, 1);\n    return t * t * (3 - 2 * t);\n  }\n  function init(section) {\n    if (section.dataset.pfReady === '1') return;\n    section.dataset.pfReady = '1';\n\n    var video = section.querySelector('.pf26__video');\n    var src = '';\n    var ready = false;\n    var visible = true;\n    var raf = 0;\n    var current = 0;\n    var target = 0;\n    var top = 0;\n    var length = 1;\n    var last = 0;\n\n    // Shopify/Dawn wrappers can interfere with sticky positioning.\n    var ancestor = section.parentElement;\n    while (ancestor && ancestor !== document.documentElement) {\n      var s = window.getComputedStyle(ancestor);\n      if (s.overflowY === 'hidden') ancestor.style.overflowY = 'visible';\n      if (s.overflowX === 'hidden') ancestor.style.overflowX = 'clip';\n      ancestor = ancestor.parentElement;\n    }\n\n    function measure() {\n      var scrollVH = parseFloat(section.dataset.scroll) || 520;\n      section.style.setProperty('--pf26-h', scrollVH + 'vh');\n      top = section.getBoundingClientRect().top + window.scrollY;\n      length = Math.max(1, section.offsetHeight - window.innerHeight);\n    }\n    function getProgress() {\n      return clamp((window.scrollY - top) / length, 0, 1);\n    }\n    function render(p) {\n      var intro = 1 - smooth(.045, .205, p);\n      var zoom = smooth(.29, .67, p);\n      var details = smooth(.60, .82, p);\n      var scale = (mq.matches ? 1.14 : 1.09) - (mq.matches ? .23 : .33) * zoom;\n      var lift = (mq.matches ? -20 : -25) * zoom;\n      section.style.setProperty('--pf26-scale', scale.toFixed(4));\n      section.style.setProperty('--pf26-lift', lift.toFixed(3) + 'vh');\n      section.style.setProperty('--pf26-intro', intro.toFixed(4));\n      section.style.setProperty('--pf26-intro-y', (-24 * (1 - intro)).toFixed(2) + 'px');\n      section.style.setProperty('--pf26-details-y', (32 * (1 - details)).toFixed(2) + 'px');\n      section.style.setProperty('--pf26-cue', (1 - smooth(.02, .14, p)).toFixed(4));\n      section.style.setProperty('--pf26-details', details.toFixed(4));\n    }\n    function schedule() {\n      if (!raf && visible) raf = requestAnimationFrame(tick);\n    }\n    function tick(now) {\n      raf = 0;\n      var p = getProgress();\n      if (!reduce.matches) render(p);\n      if (!ready || reduce.matches) return;\n\n      var duration = video.duration;\n      if (!Number.isFinite(duration) || duration <= 0) return;\n\n      // Finish playing the visual before revealing the final copy.\n      target = smooth(.025, .72, p) * Math.max(0, duration - .06);\n      var dt = last ? clamp((now - last) / 16.667, .5, 3) : 1;\n      last = now;\n      var factor = 1 - Math.pow(.74, dt);\n      current += (target - current) * factor;\n      if (Math.abs(target - current) < .018) current = target;\n\n      if (!video.seeking && Math.abs(video.currentTime - current) > .045) {\n        try { video.currentTime = current; } catch (e) {}\n      }\n      if (Math.abs(target - current) > .018) schedule();\n    }\n\n    function sourceForDevice() {\n      return mq.matches ? section.dataset.mobile : section.dataset.desktop;\n    }\n    function loadSource() {\n      var next = sourceForDevice();\n      if (!next || next === src) return;\n      src = next;\n      ready = false;\n      current = target = 0;\n      last = 0;\n      section.classList.remove('is-ready');\n      video.pause();\n      video.src = src;\n      video.load();\n      // Unlike a Blob-fetch approach, loading begins immediately.\n    }\n    function markReady() {\n      if (ready || !Number.isFinite(video.duration)) return;\n      ready = true;\n      section.classList.add('is-ready');\n      current = target = smooth(.025, .72, getProgress()) * Math.max(0, video.duration - .06);\n      if (current > .045) {\n        try { video.currentTime = current; } catch (e) {}\n      }\n      schedule();\n    }\n    function onVideoLoaded() {\n      // Painting the first video frame works without autoplay and keeps audio silent.\n      markReady();\n    }\n    function onResize() {\n      measure();\n      render(getProgress());\n      schedule();\n    }\n\n    video.addEventListener('loadeddata', onVideoLoaded);\n    video.addEventListener('seeked', schedule);\n    video.addEventListener('error', function () {\n      // Do not hide the headline if the source is unavailable.\n      section.classList.add('is-ready');\n    });\n    window.addEventListener('scroll', schedule, { passive: true });\n    window.addEventListener('resize', onResize, { passive: true });\n    window.addEventListener('load', onResize);\n    if (mq.addEventListener) mq.addEventListener('change', function () { loadSource(); onResize(); });\n    else mq.addListener(function () { loadSource(); onResize(); });\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (entries) {\n        visible = !!entries[0].isIntersecting;\n        if (!visible && raf) { cancelAnimationFrame(raf); raf = 0; }\n        if (visible) { last = 0; schedule(); }\n      }, { rootMargin: '75% 0px' }).observe(section);\n    }\n    measure();\n    render(getProgress());\n    loadSource();\n    schedule();\n  }\n  function boot() { document.querySelectorAll(SELECTOR).forEach(init); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
