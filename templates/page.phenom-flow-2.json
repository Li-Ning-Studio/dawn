  href=\"https://cdn.shopify.com/videos/c/o/v/68a71a78e32540cdb16d5b88c790c8af.mp4\"\n  media=\"(min-width: 750px)\"\n>\n\n<link\n  rel=\"preload\"\n  as=\"video\"\n  href=\"https://cdn.shopify.com/videos/c/o/v/4c4739953b8d46039d8098073bdc7fa6.mp4\"\n  media=\"(max-width: 749px)\"\n>\n</style>\n\n<section\n  class=\"hsv\"\n  data-scroll=\"900\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/68a71a78e32540cdb16d5b88c790c8af.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/4c4739953b8d46039d8098073bdc7fa6.mp4\"\n>\n  <div class=\"hsv__stage\">\n\n    <video\n      class=\"hsv__video\"\n      muted\n      playsinline\n      webkit-playsinline\n      preload=\"auto\"\n      disablepictureinpicture\n      disableremoteplayback\n    ></video>\n\n    <div class=\"hsv__intro\">\n      <h2>PHENOM FLOW</h2>\n      <p>Engineered to move</p>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  document.querySelectorAll('.hsv').forEach(function (section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n\n    const video = section.querySelector('.hsv__video');\n    const intro = section.querySelector('.hsv__intro');\n\n    const mobileQuery = window.matchMedia('(max-width: 749px)');\n    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    const scrollVh = parseFloat(section.dataset.scroll) || 900;\n    section.style.setProperty('--hsv-scroll', scrollVh + 'vh');\n\n    let ready = false;\n    let visible = false;\n    let running = false;\n    let current = 0;\n    let last = performance.now();\n    let activeSrc = '';\n\n    const ease = 0.085;\n\n    function clamp(n, min, max) {\n      return Math.max(min, Math.min(max, n));\n    }\n\n    function progress() {\n      const rect = section.getBoundingClientRect();\n      const total = section.offsetHeight - window.innerHeight;\n\n      return total > 0\n        ? clamp(-rect.top / total, 0, 1)\n        : 0;\n    }\n\n    function smoothstep(t) {\n      t = clamp(t, 0, 1);\n      return t * t * (3 - 2 * t);\n    }\n\n    function updateText(p) {\n      if (!intro || reducedMotion.matches) return;\n\n      const t = clamp(p / 0.08, 0, 1);\n      const eased = smoothstep(t);\n\n      intro.style.opacity = Math.pow(1 - eased, 1.35);\n      intro.style.transform =\n        'translate3d(0,' + (-110 * eased) + 'px,0)';\n      intro.style.visibility = t >= 1 ? 'hidden' : 'visible';\n    }\n\n    function seek(time) {\n      if (!ready || video.seeking) return;\n      if (!Number.isFinite(video.duration)) return;\n\n      const safeTime = clamp(\n        time,\n        0,\n        Math.max(0, video.duration - 0.035)\n      );\n\n      if (Math.abs(video.currentTime - safeTime) > 0.012) {\n        try {\n          video.currentTime = safeTime;\n        } catch (e) {}\n      }\n    }\n\n    /*\n     * Load the appropriate video immediately.\n     * This also works with Shopify mobile preview.\n     */\n    function loadCorrectVideo() {\n      const source = mobileQuery.matches\n        ? section.dataset.mobile\n        : section.dataset.desktop;\n\n      if (!source || activeSrc === source) return;\n\n      activeSrc = source;\n      ready = false;\n\n      video.pause();\n      video.preload = 'auto';\n      video.setAttribute('preload', 'auto');\n      video.src = source;\n      video.load();\n    }\n\n    video.addEventListener('loadedmetadata', function () {\n      if (!Number.isFinite(video.duration)) return;\n\n      current = progress() * video.duration;\n      ready = true;\n\n      seek(current);\n      updateText(progress());\n      kick();\n    });\n\n    video.addEventListener('loadeddata', function () {\n      updateText(progress());\n      kick();\n    });\n\n    video.addEventListener('canplay', function () {\n      kick();\n    });\n\n    video.addEventListener('seeked', function () {\n      if (visible) kick();\n    });\n\n    /*\n     * iOS Safari interaction unlock.\n     * Video is paused immediately afterward.\n     */\n    function unlock() {\n      const p = video.play();\n\n      if (p && p.then) {\n        p.then(function () {\n          video.pause();\n          seek(current);\n        }).catch(function () {});\n      }\n    }\n\n    window.addEventListener(\n      'touchstart',\n      unlock,\n      { once: true, passive: true }\n    );\n\n    function tick(now) {\n      running = false;\n      if (!visible) return;\n\n      const dt = clamp((now - last) / 16.667, 0, 3);\n      last = now;\n\n      const p = progress();\n      updateText(p);\n\n      if (ready && Number.isFinite(video.duration)) {\n        const target = p * video.duration;\n        const smoothing = 1 - Math.pow(1 - ease, dt);\n\n        current += (target - current) * smoothing;\n\n        if (Math.abs(target - current) < 0.001) {\n          current = target;\n        }\n\n        seek(current);\n      }\n\n      kick();\n    }\n\n    function kick() {\n      if (running || !visible) return;\n      running = true;\n      requestAnimationFrame(tick);\n    }\n\n    function sync() {\n      updateText(progress());\n      kick();\n    }\n\n    if ('IntersectionObserver' in window) {\n      const observer = new IntersectionObserver(\n        function (entries) {\n          visible = entries[0].isIntersecting;\n\n          if (visible) {\n            last = performance.now();\n            kick();\n          }\n        },\n        { rootMargin: '200px 0px' }\n      );\n\n      observer.observe(section);\n    } else {\n      visible = true;\n      kick();\n    }\n\n    window.addEventListener('scroll', sync, { passive: true });\n    window.addEventListener('resize', sync, { passive: true });\n\n    if (mobileQuery.addEventListener) {\n      mobileQuery.addEventListener('change', loadCorrectVideo);\n    } else {\n      mobileQuery.addListener(loadCorrectVideo);\n    }\n\n    /* IMPORTANT: Start loading immediately */\n    loadCorrectVideo();\n    updateText(progress());\n  });\n})();\n</script>",
