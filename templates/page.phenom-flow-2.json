idth: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  /* CONTENT BELOW */\n  .hnlt-v2-content {\n    order: 1;\n    padding: 84px 28px 72px;\n  }\n\n  .hnlt-v2-inner {\n    max-width: 460px;\n  }\n\n  .hnlt-v2 .hnlt-v2-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    margin-bottom: 22px;\n    font-size: clamp(27px, 7vw, 40px);\n    line-height: 1.08 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hnlt-v2-content {\n    padding: 76px 23px 64px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    font-size: 26px;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 12px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  .hnlt-v2-cta,\n  .hnlt-v2-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hnlt-v2\">\n  <div class=\"hnlt-v2-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hnlt-v2-content\">\n      <div class=\"hnlt-v2-inner\">\n\n        <p class=\"hnlt-v2-label\">\n          HNDRD HYPERCOURT ADAPT\n        </p>\n\n        <h2 class=\"hnlt-v2-title\">\n          LOCK-IN TRACTION\n        </h2>\n\n        <p class=\"hnlt-v2-description\">\n          The non-marking rubber outsole delivers a strong and\n          durable grip, allowing confident starts, stops, and\n          slides. The outsole has upgraded abrasion resistance,\n          20% higher than any regular outsole.\n        </p>\n\n        <a\n          class=\"hnlt-v2-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Explore HNDRD Hypercourt Adapt\"\n        >\n          Explore Hypercourt Adapt\n\n          <svg\n            viewBox=\"0 0 24 24\"\n           