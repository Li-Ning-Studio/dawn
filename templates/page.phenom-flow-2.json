 </p>\n\n        <a\n          class=\"hndrd-secure-cta\"\n          href=\"https://in.hndrd.co/products/hypercourt-adapt\"\n          aria-label=\"Shop HNDRD Hypercourt Adapt\"\n        >\n          SHOP HYPERCOURT ADAPT\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n  </div>\n</section>",
