        "custom_liquid": "{% comment %}\n  HNDRD PHENOM FLOW\n  Premium Introduction Section\n  Matching Fixture Typography\n  Matching Studio Gradient\n{% endcomment %}\n\n<style>\n/* ================================\n   FIXTURE FONTS\n================================ */\n\n@font-face {\n  font-family: 'HNLT-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNLT-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* ================================\n   SECTION\n================================ */\n\n.hn-pf-premium,\n.hn-pf-premium * {\n  box-sizing: border-box;\n}\n\n.hn-pf-premium {\n  position: relative;\n  isolation: isolate;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-height: 460px;\n  margin: 0;\n  padding: 100px 28px;\n\n  overflow: hidden;\n\n  /* MATCHING STUDIO GRADIENT */\n  background-color: #000000 !important;\n\n  background-image: linear-gradient(\n    166deg,\n    #6b6b6b 0%,\n    #6b6b6b 7%,\n    #434343 15%,\n    #1f1f1f 25%,\n    #080808 33%,\n    #000000 38%,\n    #000000 70%,\n    #191919 82%,\n    #383838 91%,\n    #5c5c5c 100%\n  ) !important;\n\n  color: #ffffff;\n}\n\n/* ================================\n   CONTENT WRAPPER\n================================ */\n\n.hn-pf-premium__inner {\n  position: relative;\n  z-index: 1;\n\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n\n  text-align: center;\n}\n\n/* ================================\n   EYEBROW\n================================ */\n\n.hn-pf-premium .hn-pf-premium__eyebrow {\n  display: block;\n\n  margin: 0 0 22px;\n  padding: 0;\n\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .06em;\n  line-height: 1.5;\n\n  text-align: center;\n  text-transform: uppercase;\n\n  color: rgba(255,255,255,.8) !important;\n}\n\n/* ================================\n   MAIN HEADING\n================================ */\n\n.hn-pf-premium .hn-pf-premium__title {\n  display: block;\n\n  width: 100%;\n  max-width: 1100px;\n\n  margin: 0 auto 25px;\n  padding: 0;\n\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n\n  font-size: clamp(42px, 5.5vw, 82px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  overflow-wrap: break-word;\n\n  color: #ffffff !important;\n}\n\n/* ================================\n   DESCRIPTION\n================================ */\n\n.hn-pf-premium .hn-pf-premium__description {\n  display: block;\n\n  width: 100%;\n  max-width: 750px;\n\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  color: #e4e4e4 !important;\n}\n\n/* ================================\n   CTA BUTTON\n================================ */\n\n.hn-pf-premium .hn-pf-premium__cta,\n.hn-pf-premium .hn-pf-premium__cta:visited {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  min-height: 52px;\n  max-width: 100%;\n\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n\n  background: transparent !important;\n  color: #ffffff !important;\n\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n\n  letter-spacing: .015em;\n  line-height: 1.2;\n\n  text-transform: uppercase;\n  text-align: center;\n  text-decoration: none !important;\n\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n/* ================================\n   CTA HOVER\n================================ */\n\n@media (hover: hover) {\n  .hn-pf-premium .hn-pf-premium__cta:hover {\n    background: #ffffff !important;\n    border-color: #ffffff !important;\n    color: #101010 !important;\n\n    transform: translateY(-2px);\n    box-shadow: 0 10px 28px rgba(255,255,255,.12);\n  }\n}\n\n.hn-pf-premium .hn-pf-premium__cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* ================================\n   TABLET\n================================ */\n\n@media (min-width: 769px) and (max-width: 1100px) {\n  .hn-pf-premium {\n    min-height: 420px;\n    padding: 90px 30px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: clamp(40px, 5.5vw, 64px);\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 13px;\n  }\n}\n\n/* ================================\n   MOBILE\n================================ */\n\n@media (max-width: 768px) {\n  .hn-pf-premium {\n    min-height: 370px;\n    padding: 75px 24px;\n  }\n\n  .hn-pf-premium__inner {\n    max-width: 480px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__eyebrow {\n    margin-bottom: 16px;\n    font-size: 10px;\n    letter-spacing: .06em;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    max-width: 440px;\n    margin-bottom: 22px;\n\n    font-size: clamp(35px, 9vw, 54px);\n    letter-spacing: -.025em !important;\n    line-height: 1.08 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    max-width: 390px;\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* ================================\n   SMALL MOBILE\n================================ */\n\n@media (max-width: 400px) {\n  .hn-pf-premium {\n    min-height: 340px;\n    padding: 65px 20px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: 34px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 12px;\n  }\n}\n\n/* ================================\n   REDUCED MOTION\n================================ */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-pf-premium .hn-pf-premium__cta {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hn-pf-premium\">\n\n  <div class=\"hn-pf-premium__inner\">\n\n    <p class=\"hn-pf-premium__eyebrow\">\n      INTRODUCING PHENOM FLOW\n    </p>\n\n    <h2 class=\"hn-pf-premium__title\">\n      Crafted for Perfectionists\n    </h2>\n\n    <p class=\"hn-pf-premium__description\">\n      The Engineered Badminton Shoe by HNDRD\n    </p>\n\n    <a\n      class=\"hn-pf-premium__cta\"\n      href=\"https://in.hndrd.co/products/phenom-flow\" \n      aria-label=\"Explore Phenom Flow\"\n    >\n      EXPLORE PHENOM FLOW\n    </a>\n\n  </div>\n\n</section>",
        "color_scheme": "scheme-4",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
