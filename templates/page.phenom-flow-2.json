        "custom_liquid": "<style>\n/* FIXTURE FONTS */\n@font-face {\n  font-family: 'HNLT-Fixture-ExtraBold';\n  src: url(\"{{ 'Fixture-ExtraBold.otf' | file_url }}\") format('opentype');\n  font-weight: 800;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'HNLT-Fixture-Expanded';\n  src: url(\"{{ 'Fixture-Expanded-SemiBold.otf' | file_url }}\") format('opentype');\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* BASE */\n.hnlt-v2,\n.hnlt-v2 * {\n  box-sizing: border-box;\n}\n\n.hnlt-v2 {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  overflow: hidden;\n  color: #ffffff;\n\n  background: #000000 !important;\n  background-image: none !important;\n}\n\n/* GRID */\n.hnlt-v2-grid {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  width: 100%;\n  align-items: center;\n}\n\n/* LEFT TEXT */\n.hnlt-v2-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  padding: 65px 40px;\n  /* STUDIO PANEL: grey light top-left, black centre, grey glow bottom-right */\n  position: relative;\n  isolation: isolate;\n  align-self: stretch;\n  background-color: #000000 !important;\n  background-color: #000000;\n  \n}\n\n/* fine grain so the gradient stays smooth on every screen (no banding) */\n.hnlt-v2-content::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: .06;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n}\n\n.hnlt-v2-inner {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 560px;\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* RIGHT IMAGE */\n.hnlt-v2-media {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  height: auto;\n  padding: 0;\n  margin: 0;\n  overflow: hidden;\n  background: transparent;\n}\n\n.hnlt-v2-media img {\n  position: static !important;\n  display: block;\n  width: 100% !important;\n  height: auto !important;\n  max-width: 100% !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: none !important;\n}\n\n/* LABEL */\n.hnlt-v2 .hnlt-v2-label {\n  margin: 0 0 22px;\n  padding: 0;\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n  font-size: 12px;\n  font-weight: 600 !important;\n  font-synthesis: none !important;\n  letter-spacing: .06em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.8);\n}\n\n/* HEADING */\n.hnlt-v2 .hnlt-v2-title {\n  display: block;\n  margin: 0 0 25px;\n  padding: 0;\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n  font-size: clamp(28px, 3.2vw, 50px);\n  font-weight: 800 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.08 !important;\n  text-transform: uppercase !important;\n  text-align: center !important;\n  overflow-wrap: break-word;\n  color: #ffffff;\n}\n\n/* DESCRIPTION */\n.hnlt-v2 .hnlt-v2-description {\n  display: block;\n  width: 100%;\n  max-width: 540px;\n  margin: 0 auto;\n  padding: 0;\n  font-family: 'HNLT-Fixture-Expanded', sans-serif !important;\n  font-size: 15px;\n  font-weight: 600 !important;\n  font-style: normal !important;\n  font-synthesis: none !important;\n  letter-spacing: -.025em !important;\n  line-height: 1.55 !important;\n  text-align: center !important;\n  color: #e4e4e4;\n}\n\n/* CTA */\n.hnlt-v2 .hnlt-v2-cta,\n.hnlt-v2 .hnlt-v2-cta:visited {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n\n  min-height: 52px;\n  max-width: 100%;\n  margin-top: 34px;\n  padding: 12px 30px;\n\n  border: 1.5px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff !important;\n\n  font-family: 'HNLT-Fixture-ExtraBold', sans-serif !important;\n  font-size: 12px;\n  font-weight: 800 !important;\n  font-synthesis: none !important;\n  letter-spacing: .015em;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  text-align: center;\n  cursor: pointer;\n\n  transition:\n    background .3s ease,\n    color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n.hnlt-v2-cta svg {\n  display: block;\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  transition: transform .3s ease;\n}\n\n@media (hover: hover) {\n  .hnlt-v2 .hnlt-v2-cta:hover {\n    background: #ffffff;\n    color: #101010 !important;\n    transform: translateY(-2px);\n    box-shadow: 0 10px 28px rgba(255,255,255,.12);\n  }\n\n  .hnlt-v2-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n.hnlt-v2-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* TABLET */\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hnlt-v2-content {\n    padding: 45px 25px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    font-size: clamp(24px, 3vw, 34px);\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 13px;\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .hnlt-v2-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  /* IMAGE FIRST */\n  .hnlt-v2-media {\n    order: -1;\n    width: 100%;\n    height: auto;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hnlt-v2-media img {\n    position: static !important;\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  /* CONTENT BELOW */\n  .hnlt-v2-content {\n    order: 1;\n    padding: 84px 28px 72px;\n  }\n\n  .hnlt-v2-inner {\n    max-width: 460px;\n  }\n\n  .hnlt-v2 .hnlt-v2-label {\n    margin-bottom: 16px;\n    font-size: 10px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    margin-bottom: 22px;\n    font-size: clamp(27px, 7vw, 40px);\n    line-height: 1.08 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 13px;\n    line-height: 1.55 !important;\n  }\n\n  .hnlt-v2 .hnlt-v2-cta {\n    min-height: 47px;\n    margin-top: 28px;\n    padding: 12px 25px;\n    font-size: 11px;\n  }\n}\n\n/* SMALL MOBILE */\n@media (max-width: 400px) {\n  .hnlt-v2-content {\n    padding: 76px 23px 64px;\n  }\n\n  .hnlt-v2 .hnlt-v2-title {\n    font-size: 26px;\n  }\n\n  .hnlt-v2 .hnlt-v2-description {\n    font-size: 12px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  .hnlt-v2-cta,\n  .hnlt-v2-cta svg {\n    transition: none !important;\n  }\n}\n/* ===================================\n   HNDRD PHENOM FLOW\n   FORCE PURE BLACK BACKGROUND\n   DESKTOP + MOBILE\n=================================== */\n/* ===================================\n   HNDRD PHENOM FLOW\n   JUST BREATHE\n   PURE BLACK BACKGROUND\n   DESKTOP + MOBILE\n=================================== */\n\nhtml body .hnlt-v2,\nhtml body .hnlt-v2 .hnlt-v2-grid,\nhtml body .hnlt-v2 .hnlt-v2-content,\nhtml body .hnlt-v2 .hnlt-v2-media,\nhtml body .hnlt-v2 .hnlt-v2-inner {\n  background: #000000 !important;\n  background-color: #000000 !important;\n  background-image: none !important;\n  box-shadow: none !important;\n}\n\n/* REMOVE GREY GRADIENTS, GRAIN AND OVERLAYS */\n\nhtml body .hnlt-v2::before,\nhtml body .hnlt-v2::after,\nhtml body .hnlt-v2 .hnlt-v2-grid::before,\nhtml body .hnlt-v2 .hnlt-v2-grid::after,\nhtml body .hnlt-v2 .hnlt-v2-content::before,\nhtml body .hnlt-v2 .hnlt-v2-content::after,\nhtml body .hnlt-v2 .hnlt-v2-media::before,\nhtml body .hnlt-v2 .hnlt-v2-media::after {\n  content: none !important;\n  display: none !important;\n  background: none !important;\n  background-image: none !important;\n}\n\n/* KEEP PRODUCT IMAGE UNCHANGED */\n\nhtml body .hnlt-v2 .hnlt-v2-media img {\n  box-shadow: none !important;\n}\n</style>\n\n<section class=\"hnlt-v2\">\n  <div class=\"hnlt-v2-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hnlt-v2-content\">\n      <div class=\"hnlt-v2-inner\">\n\n        <p class=\"hnlt-v2-label\">\n          HNDRD Phenom Flow\n        </p>\n\n        <h2 class=\"hnlt-v2-title\">\n          Just Breathe\n        </h2>\n\n        <p class=\"hnlt-v2-description\">\n          Every layer of this shoe can breathe: the insole, the support plate, and the upper. Air circulates throughout, providing complete ventilation and comfort.\n        </p>\n\n        <a\n          class=\"hnlt-v2-cta\"\n          href=\"https://in.hndrd.co/products/phenom-flow\"\n          aria-label=\"Explore HNDRD Phenom Flow\"\n        >\n          Explore Phenom flow\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n\n    <!-- RIGHT PRODUCT IMAGE -->\n    <div class=\"hnlt-v2-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_1_e6eac2b3-bb85-4fee-95d7-cd47647c5268.jpg?v=1793177980\"\n        alt=\"HNDRD Phenom flow Badminton Shoes\"\n        loading=\"lazy\"\n        width=\"1000\"\n        height=\"1000\"\n      >\n    </div>\n\n  </div>\n</section>",
