      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 4: WHAT'S INCLUDED\n     Shopify: Themes > Customize > Add Section > Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* ── Section wrapper ── */\n  .sv-included {\n    background: linear-gradient(180deg, #4E1164 0%, #2A0960 100%);\n    padding: 80px 24px;\n    position: relative;\n  }\n\n  /* Gold top accent line */\n  .sv-included::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 4px;\n    background: #F5C500;\n  }\n\n  .sv-included__inner {\n    max-width: 860px;\n    margin: 0 auto;\n  }\n\n  /* ── Section header ── */\n  .sv-included__eyebrow {\n    display: block;\n    font-family: Figtree;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #F5C500;\n    margin-bottom: 12px;\n  }\n\n  .sv-included__title {\n    font-family: Figtree;\n    font-weight: 900;\n    font-size: clamp(3.8rem, 6vw, 4.5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0;\n  }\n\n  /* ── 2-column card grid ── */\n  .sv-included__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 48px;\n  }\n\n  /* ── Individual card ── */\n  .sv-included__card {\n    background: rgba(91, 31, 168, 0.25);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-left: 3px solid transparent;\n    padding: 32px 28px;\n    position: relative;\n    overflow: hidden;\n    transition: border-left-color 0.2s, background 0.2s;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  /* Gold corner tag on hover */\n  .sv-included__card::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    border-style: solid;\n    border-width: 0 28px 28px 0;\n    border-color: transparent #F5C500 transparent transparent;\n    opacity: 0;\n    transition: opacity 0.2s;\n  }\n\n  .sv-included__card:hover {\n    border-left-color: #F5C500;\n    background: rgba(91, 31, 168, 0.45);\n  }\n\n  .sv-included__card:hover::after {\n    opacity: 1;\n  }\n\n  .sv-included__icon {\n    font-size: 2.5rem;\n    display: block;\n    margin-bottom: 14px;\n  }\n\n  .sv-included__card-title {\n    font-family: Figtree;\n    font-weight: 800;\n    font-size: 2.15rem;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 8px 0;\n  }\n\n  .sv-included__card-desc {\n    font-family: Figtree;\n    font-size: 1.49rem;\n    color: #F0EAF8;\n    opacity: 0.75;\n    line-height: 1.65;\n    margin: 0;\n  }\n\n  /* ── Responsive ── */\n  @media (max-width: 600px) {\n    .sv-included { padding: 60px 20px; }\n    .sv-included__grid { grid-template-columns: 1fr; gap: 12px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-included__card {\n      opacity: 1 !important;\n      transform: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<section class=\"sv-included\">\n  <div class=\"sv-included__inner\">\n\n    <span class=\"sv-included__eyebrow\">What's Included</span>\n    <h2 class=\"sv-included__title\">Everything<br>you need to play</h2>\n\n    <div class=\"sv-included__grid\">\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Event Entry</h3>\n        <p class=\"sv-included__card-desc\">Full day access to all scheduled matches, challenges, and court activities.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Shuttles & Rackets Provided</h3>\n        <p class=\"sv-included__card-desc\">Official event shuttles & rackets provided by the organizers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Prizes </h3>\n        <p class=\"sv-included__card-desc\">Prizes, merchandise, and exclusive HNDRD rewards for standout performers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Community Access</h3>\n        <p class=\"sv-included__card-desc\">Network with fellow enthusiasts and get exclusive HNDRD experiences and offers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Brand Activations</h3>\n        <p class=\"sv-included__card-desc\">Interactive brand zones, product experiences, and exclusive HNDRD drops on the day.</p>\n      </div>\n\n     <!-- <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Food Stalls Available</h3>\n        <p class=\"sv-included__card-desc\">Food available at the venue. <i>Additional charges apply, Based on venue.</i></p>\n      </div> -->\n\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var cards = document.querySelectorAll('.sv-included__card');\n    if (!cards.length) return;\n\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          var card = entry.target;\n          var index = Array.prototype.indexOf.call(cards, card);\n          setTimeout(function () {\n            card.style.opacity = '1';\n            card.style.transform = 'translateY(0)';\n            card.style.transition = 'opacity 0.45s ease, transform 0.45s ease, border-left-color 0.2s, background 0.2s';\n          }, index * 80);\n          observer.unobserve(card);\n        }\n      });\n    }, { threshold: 0.1 });\n\n    cards.forEach(function (card) {\n      observer.observe(card);\n    });\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_UndVHN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — EVENT DETAILS\n     Premium Boarding Pass Style\n============================================================ -->\n\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n.dv-details,\n.dv-details *{\nbox-sizing:border-box;\n}\n\n\n\n.dv-details{\n\nposition:relative;\n\npadding:80px 20px;\n\noverflow:hidden;\n\n\nbackground:\n\nlinear-gradient(\n135deg,\n#F8E9DF,\n#F2D4CF\n);\n\n\nfont-family:Figtree,sans-serif;\n\n\n}\n\n\n\n/* background */\n\n.dv-details:before{\n\ncontent:\"DIVA\";\n\nposition:absolute;\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:240px;\n\ncolor:rgba(113,31,42,.04);\n\nright:-60px;\n\ntop:60px;\n\ntransform:rotate(-15deg);\n\n}\n\n\n\n/* wrapper */\n\n.dv-details-wrap{\n\nmax-width:950px;\n\nmargin:auto;\n\nposition:relative;\n\nz-index:2;\n\n}\n\n\n\n\n\n/* heading */\n\n.dv-details-head{\n\ntext-align:center;\n\nmargin-bottom:45px;\n\n}\n\n\n\n.dv-details-head small{\n\nfont-size:.75rem;\n\nletter-spacing:.4em;\n\ntext-transform:uppercase;\n\nfont-weight:700;\n\ncolor:#A36A50;\n\n}\n\n\n\n.dv-details-head h2{\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:clamp(3rem,6vw,5rem);\n\ncolor:#711F2A;\n\nmargin:15px 0 0;\n\nline-height:.9;\n\n}\n\n\n\n\n\n/* boarding pass */\n\n.dv-pass{\n\nposition:relative;\n\nbackground:#FFF9F1;\n\nborder-radius:28px;\n\npadding:40px;\n\nbox-shadow:\n\n0 25px 70px rgba(90,30,40,.18);\n\n\nborder:1px solid rgba(184,134,85,.4);\n\n\ndisplay:grid;\n\ngrid-template-columns:1fr 280px;\n\noverflow:hidden;\n\nanimation:passReveal .8s ease;\n\n}\n\n\n\n@keyframes passReveal{\n\nfrom{\n\nopacity:0;\n\ntransform:translateY(30px);\n\n}\n\nto{\n\nopacity:1;\n\ntransform:translateY(0);\n\n}\n\n}\n\n\n\n\n\n/* ticket divider */\n\n.dv-pass:after{\n\ncontent:\"\";\n\nposition:absolute;\n\ntop:30px;\n\nbottom:30px;\n\nright:280px;\n\nborder-left:1px dashed rgba(113,31,42,.25);\n\n}\n\n\n\n\n\n/* left content */\n\n\n.dv-pass-main{\n\npadding-right:35px;\n\n}\n\n\n\n\n\n.dv-pass-label{\n\nfont-size:.7rem;\n\nletter-spacing:.3em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\nfont-weight:700;\n\n}\n\n\n\n\n.dv-pass-date{\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:3.2rem;\n\nline-height:1;\n\ncolor:#711F2A;\n\nmargin:15px 0 35px;\n\n}\n\n\n\n\n\n.dv-info-row{\n\ndisplay:flex;\n\nalign-items:center;\n\ngap:18px;\n\npadding:18px 0;\n\nborder-bottom:1px solid rgba(113,31,42,.12);\n\n}\n\n\n\n.dv-icon{\n\nwidth:48px;\n\nheight:48px;\n\nborder-radius:50%;\n\nbackground:#F2DDD3;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\nfont-size:1.3rem;\n\n}\n\n\n\n.dv-info-row small{\n\ndisplay:block;\n\nfont-size:.7rem;\n\nletter-spacing:.2em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\n}\n\n\n\n.dv-info-row strong{\n\ndisplay:block;\n\nfont-size:1.25rem;\n\ncolor:#711F2A;\n\n}\n\n\n\n\n\n/* right stamp section */\n\n\n.dv-pass-side{\n\ndisplay:flex;\n\nflex-direction:column;\n\nalign-items:center;\n\njustify-content:center;\n\ntext-align:center;\n\n}\n\n\n\n.dv-stamp{\n\nwidth:150px;\n\nheight:150px;\n\nborder-radius:50%;\n\nborder:3px dashed #B88655;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\ncolor:#8B542F;\n\nfont-size:.75rem;\n\nfont-weight:800;\n\nletter-spacing:.15em;\n\ntransform:rotate(-12deg);\n\nposition:relative;\n\n}\n\n\n\n.dv-stamp:before{\n\ncontent:\"\";\n\nposition:absolute;\n\ninset:12px;\n\nborder:1px solid rgba(184,134,85,.6);\n\nborder-radius:50%;\n\n}\n\n\n\n\n.dv-side-text{\n\nmargin-top:35px;\n\nfont-size:.8rem;\n\nletter-spacing:.25em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\n}\n\n\n\n\n\n/* mobile */\n\n@media(max-width:700px){\n\n\n.dv-details{\n\npadding:55px 15px;\n\n}\n\n\n\n.dv-pass{\n\ngrid-template-columns:1fr;\n\npadding:28px;\n\n}\n\n\n\n.dv-pass:after{\n\ndisplay:none;\n\n}\n\n\n\n.dv-pass-main{\n\npadding-right:0;\n\n}\n\n\n\n.dv-pass-date{\n\nfont-size:2.2rem;\n\n}\n\n\n\n.dv-pass-side{\n\nmargin-top:35px;\n\npadding-top:35px;\n\nborder-top:1px dashed rgba(113,31,42,.25);\n\n}\n\n\n\n.dv-stamp{\n\nwidth:120px;\n\nheight:120px;\n\n}\n\n\n\n}\n\n\n\n</style>\n\n\n\n\n<section class=\"dv-details\">\n\n\n<div class=\"dv-details-wrap\">\n\n\n<div class=\"dv-details-head\">\n\n\n<small>\nEvent Details\n</small>\n\n\n<h2>\nYour Diva Pass\n</h2>\n\n\n</div>\n\n\n\n\n\n<div class=\"dv-pass\">\n\n\n\n<div class=\"dv-pass-main\">\n\n\n\n<div class=\"dv-pass-label\">\nEvent Date\n</div>\n\n\n\n<div class=\"dv-pass-date\">\n20th September\n</div>\n\n\n\n\n<div class=\"dv-info-row\">\n\n<div class=\"dv-icon\">\n◷\n</div>\n\n\n<div>\n\n<small>\nTime\n</small>\n\n<strong>\n4 PM onwards\n</strong>\n\n\n</div>\n\n\n</div>\n\n\n\n\n\n<div class=\"dv-info-row\">\n\n<div class=\"dv-icon\">\n⌖\n</div>\n\n\n<div>\n\n<small>\nVenue\n</small>\n\n<strong>\nGame Theory\n</strong>\n\n<span>\nHSR Layout Sector\n</span>\n\n</div>\n\n\n</div>\n\n\n\n\n\n</div>\n\n\n\n\n\n\n\n<div class=\"dv-pass-side\">\n\n\n\n<div class=\"dv-stamp\">\n\nDIVA'S<br>\nDAY<br>\n2026\n\n</div>\n\n\n\n<div class=\"dv-side-text\">\n\nOrganized By<br>\n\n<strong>\nHNDRD\n</strong>\n\n</div>\n\n\n\n</div>\n\n\n\n\n\n</div>\n\n\n\n\n</div>\n\n\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_V6VAFT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n  DIVA'S DAY — \"Player Pass\" boarding-pass ticket\n  Paste this whole block into a Shopify \"Custom Liquid\" section.\n  Self-contained (styles + markup), fully responsive — the card\n  keeps its aspect ratio and just scales down on phones, so it\n  never needs to scroll, sideways or up/down.\n============================================================= -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .dd-pass-wrap{\n    --card-w: min(92vw, 1000px);\n    --pink-bg: #f4dade;\n    --cream: #fbede6;\n    --cream-2: #f7e2da;\n    --maroon: #5c1428;\n    --maroon-deep: #4a0f20;\n    --ink: #6e1f34;\n    --ink-soft: #8a3d50;\n    --label: #a68e91;\n    --gold: #cfa15e;\n\n    box-sizing: border-box;\n    width: 100%;\n    padding: clamp(24px, 6vw, 60px) 16px;\n    background: var(--pink-bg);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-family: 'Poppins', Helvetica, Arial, sans-serif;\n  }\n\n  .dd-pass{\n    position: relative;\n    width: var(--card-w);\n    aspect-ratio: 2000 / 558;\n    display: flex;\n    border-radius: clamp(10px, 1.4vw, 20px);\n    overflow: hidden;\n    box-shadow: 0 18px 40px -12px rgba(74, 15, 32, 0.28);\n  }\n\n  /* ---------- LEFT CREAM BODY ---------- */\n  .dd-pass__body{\n    position: relative;\n    flex: 1 1 auto;\n    background: linear-gradient(135deg, var(--cream) 0%, var(--cream-2) 100%);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 3.2% 3.4% 3% 3.6%;\n  }\n\n  /* faint decorative swirl, echoes the smoky texture in the reference */\n  .dd-pass__body::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:\n      radial-gradient(ellipse 60% 90% at 100% 30%, rgba(207,161,94,0.10), transparent 70%),\n      radial-gradient(ellipse 50% 70% at 90% 90%, rgba(92,20,40,0.06), transparent 70%);\n    pointer-events:none;\n  }\n\n  /* header row */\n  .dd-pass__header{\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 3%;\n    padding-bottom: clamp(6px, 1.4%, 14px);\n    border-bottom: 1px solid rgba(110, 31, 52, 0.18);\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__header-left{\n    display:flex;\n    align-items:center;\n    gap: clamp(6px, 1vw, 12px);\n    white-space: nowrap;\n  }\n\n  .dd-pass__star{\n    color: var(--gold);\n    font-size: clamp(11px, 1.5vw, 18px);\n    line-height:1;\n  }\n\n  .dd-pass__eyebrow{\n    font-weight: 600;\n    letter-spacing: 0.14em;\n    color: var(--ink);\n    font-size: clamp(9px, 1.25vw, 15px);\n    text-transform: uppercase;\n  }\n\n  .dd-pass__subtitle{\n    font-weight: 500;\n    letter-spacing: 0.12em;\n    color: var(--ink-soft);\n    font-size: clamp(8px, 1.05vw, 13px);\n    text-transform: uppercase;\n  }\n\n  .dd-pass__tag{\n    font-weight: 600;\n    letter-spacing: 0.12em;\n    color: var(--maroon);\n    font-size: clamp(8px, 1.05vw, 13px);\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  /* info row: DATE / VENUE / TIME / ENTRY FEE */\n  .dd-pass__info{\n    display: flex;\n    align-items: stretch;\n    gap: clamp(10px, 2.2%, 26px);\n    padding: clamp(8px, 2%, 20px) 0;\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__field{\n    flex: 1 1 0;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: clamp(2px, 0.6vw, 8px);\n    padding-right: clamp(10px, 2.2%, 26px);\n    border-right: 1px solid rgba(110, 31, 52, 0.18);\n  }\n\n  .dd-pass__field:last-child{\n    border-right: none;\n    padding-right: 0;\n  }\n\n  .dd-pass__label{\n    font-weight: 600;\n    letter-spacing: 0.14em;\n    color: var(--label);\n    font-size: clamp(6.5px, 0.85vw, 11px);\n    text-transform: uppercase;\n  }\n\n  .dd-pass__value{\n    font-family: 'Playfair Display', Georgia, serif;\n    font-weight: 700;\n    color: var(--ink);\n    font-size: clamp(11px, 1.9vw, 27px);\n    line-height: 1.15;\n  }\n\n  .dd-pass__value-sub{\n    font-family: 'Poppins', sans-serif;\n    font-weight: 500;\n    color: var(--ink-soft);\n    font-size: clamp(7.5px, 1.05vw, 14px);\n  }\n\n  /* footer row: barcode + admit line */\n  .dd-pass__footer{\n    display: flex;\n    align-items: center;\n    gap: clamp(8px, 1.6%, 16px);\n    padding-top: clamp(6px, 1.2%, 12px);\n    border-top: 1px dashed rgba(110, 31, 52, 0.28);\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__barcode{\n    display: flex;\n    align-items: stretch;\n    gap: clamp(1px, 0.25vw, 3px);\n    height: clamp(12px, 2vw, 22px);\n  }\n\n  .dd-pass__barcode span{\n    display:block;\n    width: clamp(1px, 0.3vw, 3px);\n    background: var(--maroon);\n  }\n  .dd-pass__barcode span:nth-child(3n){ width: clamp(2px, 0.55vw, 5px); }\n  .dd-pass__barcode span:nth-child(5n){ opacity: .55; }\n\n  .dd-pass__footer-text{\n    font-weight: 500;\n    letter-spacing: 0.1em;\n    color: var(--ink-soft);\n    font-size: clamp(6.5px, 0.9vw, 12px);\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  /* ---------- PERFORATION NOTCHES ---------- */\n  .dd-pass__notch{\n    position: absolute;\n    width: clamp(14px, 2.4vw, 34px);\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--pink-bg);\n    z-index: 2;\n    right: calc(26% - clamp(7px, 1.2vw, 17px));\n  }\n  .dd-pass__notch--top{ top: clamp(-9px, -1.4vw, -18px); }\n  .dd-pass__notch--bottom{ bottom: clamp(-9px, -1.4vw, -18px); }\n\n  /* ---------- RIGHT MAROON STUB ---------- */\n  .dd-pass__stub{\n    position: relative;\n    flex: 0 0 26%;\n    background: linear-gradient(150deg, var(--maroon) 0%, var(--maroon-deep) 100%);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    gap: clamp(4px, 1%, 10px);\n    padding: 4% 6%;\n    overflow: hidden;\n  }\n\n  .dd-pass__stub::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:\n      radial-gradient(ellipse 80% 60% at 15% 100%, rgba(230,180,120,0.16), transparent 65%),\n      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(255,255,255,0.06), transparent 60%);\n    pointer-events:none;\n  }\n\n  .dd-pass__stub-star{\n    color: var(--gold);\n    font-size: clamp(12px, 1.8vw, 20px);\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__stub-eyebrow{\n    font-weight: 600;\n    letter-spacing: 0.16em;\n    color: rgba(255,255,255,0.75);\n    font-size: clamp(7px, 0.95vw, 12.5px);\n    text-transform: uppercase;\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__stub-title{\n    font-family: 'Playfair Display', Georgia, serif;\n    font-weight: 800;\n    color: #fff;\n    font-size: clamp(16px, 2.9vw, 34px);\n    line-height: 1.08;\n    position: relative;\n    z-index: 1;\n  }\n\n  .dd-pass__stub-by{\n    font-weight: 500;\n    letter-spacing: 0.16em;\n    color: rgba(255,255,255,0.7);\n    font-size: clamp(6.5px, 0.85vw, 11px);\n    text-transform: uppercase;\n    position: relative;\n    z-index: 1;\n  }\n</style>\n\n<div class=\"dd-pass-wrap\">\n  <div class=\"dd-pass\">\n\n    <div class=\"dd-pass__body\">\n\n      <div class=\"dd-pass__header\">\n        <div class=\"dd-pass__header-left\">\n          <span class=\"dd-pass__star\">&#10022;</span>\n          <span class=\"dd-pass__eyebrow\">Diva  Pass</span>\n          <span class=\"dd-pass__subtitle\">&middot; Bengaluru</span>\n        </div>\n        <div class=\"dd-pass__tag\">Women Only Experience</div>\n      </div>\n\n      <div class=\"dd-pass__info\">\n        <div class=\"dd-pass__field\">\n          <span class=\"dd-pass__label\">Date</span>\n          <span class=\"dd-pass__value\">20th<br>September 2026</span>\n        </div>\n        <div class=\"dd-pass__field\">\n          <span class=\"dd-pass__label\">Venue</span>\n          <span class=\"dd-pass__value\">Game Theory</span>\n          <span class=\"dd-pass__value-sub\">HSR Layout Sector</span>\n        </div>\n        <div class=\"dd-pass__field\">\n          <span class=\"dd-pass__label\">Time</span>\n          <span class=\"dd-pass__value\">4 PM onwards</span>\n        </div>\n        <div class=\"dd-pass__field\">\n          <span class=\"dd-pass__label\">Entry Fee</span>\n          <span class=\"dd-pass__value\">&#8377;299/-</span>\n          <span class=\"dd-pass__value-sub\">Per Participant</span>\n        </div>\n      </div>\n\n      <div class=\"dd-pass__footer\">\n        <div class=\"dd-pass__barcode\">\n          <span></span><span></span><span></span><span></span><span></span>\n          <span></span><span></span><span></span><span></span><span></span>\n          <span></span><span></span><span></span><span></span><span></span>\n          <span></span><span></span><span></span><span></span><span></span>\n        </div>\n        <span class=\"dd-pass__footer-text\">Pass &middot; Diva-2026 &middot; BLR &middot; Admit One</span>\n      </div>\n\n      <span class=\"dd-pass__notch dd-pass__notch--top\"></span>\n      <span class=\"dd-pass__notch dd-pass__notch--bottom\"></span>\n    </div>\n\n    <div class=\"dd-pass__stub\">\n      <span class=\"dd-pass__stub-star\">&#10022;</span>\n      <span class=\"dd-pass__stub-eyebrow\">Player Pass</span>\n      <span class=\"dd-pass__stub-title\">Diva's<br>Day</span>\n      <span class=\"dd-pass__stub-by\">By HNDRD</span>\n    </div>\n\n  </div>\n</div>",
