    "custom_liquid_LjMxTE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — PREMIUM RSVP CTA\n     Light Pink Feminine Editorial Style\n============================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n.diva-rsvp-premium,\n.diva-rsvp-premium *{\n  box-sizing:border-box;\n}\n\n.diva-rsvp-premium{\n  position:relative;\n  overflow:hidden;\n  padding:95px 20px 80px;\n  text-align:center;\n\n  font-family:Manrope,sans-serif;\n\n  background:\n    radial-gradient(\n      circle at 50% 0%,\n      rgba(255,255,255,.92),\n      transparent 35%\n    ),\n    radial-gradient(\n      circle at 85% 90%,\n      rgba(190,120,120,.16),\n      transparent 40%\n    ),\n    linear-gradient(\n      135deg,\n      #FBECE7,\n      #F2D2D2\n    );\n\n  color:#6B2632;\n}\n\n\n/* soft background glow */\n\n.drp-glow{\n  position:absolute;\n  width:600px;\n  height:600px;\n  top:-350px;\n  left:50%;\n  transform:translateX(-50%);\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(218,170,110,.28),\n      transparent 65%\n    );\n\n  animation:drpGlow 8s ease-in-out infinite;\n}\n\n@keyframes drpGlow{\n  0%,100%{\n    transform:translateX(-50%) scale(1);\n    opacity:.7;\n  }\n\n  50%{\n    transform:translateX(-50%) scale(1.15);\n    opacity:.45;\n  }\n}\n\n\n/* main content */\n\n.drp-content{\n  position:relative;\n  z-index:2;\n  max-width:760px;\n  margin:auto;\n\n  animation:drpReveal .9s ease both;\n}\n\n@keyframes drpReveal{\n  from{\n    opacity:0;\n    transform:translateY(28px);\n  }\n\n  to{\n    opacity:1;\n    transform:translateY(0);\n  }\n}\n\n\n/* date pill */\n\n.drp-date{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n\n  padding:10px 24px;\n\n  border-radius:999px;\n\n  border:1px solid rgba(160,100,70,.32);\n\n  background:rgba(255,255,255,.3);\n\n  font-family:Manrope,sans-serif;\n  font-size:11px;\n  font-weight:700;\n\n  letter-spacing:.24em;\n\n  color:#9A604E;\n}\n\n\n/* headline */\n\n.drp-title{\n  margin:36px 0 0;\n\n  font-family:\"DM Serif Display\",serif;\n\n  font-size:clamp(58px,8vw,98px);\n\n  line-height:.88;\n\n  letter-spacing:-.035em;\n\n  font-weight:400;\n\n  color:#65202B;\n}\n\n.drp-title span{\n  display:block;\n\n  margin-top:5px;\n\n  font-family:\"DM Serif Display\",serif;\n\n  font-size:clamp(88px,12vw,145px);\n\n  line-height:.86;\n\n  font-style:italic;\n\n  font-weight:400;\n\n  color:#A52F45;\n}\n\n\n/* subtitle */\n\n.drp-sub{\n  max-width:520px;\n\n  margin:30px auto 44px;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:16px;\n\n  line-height:1.75;\n\n  font-weight:500;\n\n  letter-spacing:-.01em;\n\n  color:#805C54;\n}\n\n\n/* booking bar */\n\n.drp-book{\n  position:relative;\n\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n\n  gap:16px;\n\n  width:100%;\n  max-width:590px;\n\n  margin:auto;\n\n  padding:13px 14px;\n\n  background:\n    linear-gradient(\n      135deg,\n      #8B3042,\n      #691F30\n    );\n\n  border-radius:20px;\n\n  border:1px solid rgba(255,255,255,.12);\n\n  text-decoration:none;\n\n  color:#fff;\n\n  box-shadow:\n    0 18px 45px rgba(100,35,45,.22);\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease,\n    background .25s ease;\n}\n\n\n/* NO CTA EFFECTS / NO SHINE / NO FLOAT */\n\n.drp-book:before{\n  display:none;\n}\n\n.drp-book:hover{\n  transform:none;\n\n  background:\n    linear-gradient(\n      135deg,\n      #923448,\n      #712235\n    );\n\n  box-shadow:\n    0 18px 45px rgba(100,35,45,.22);\n}\n\n\n/* booking left */\n\n.drp-left{\n  display:flex;\n  align-items:center;\n  gap:14px;\n  text-align:left;\n}\n\n\n/* icon */\n\n.drp-icon{\n  width:50px;\n  height:50px;\n\n  flex:0 0 50px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border-radius:50%;\n\n  background:#F4D49D;\n\n  color:#792737;\n\n  font-family:\"DM Serif Display\",serif;\n\n  font-size:24px;\n}\n\n\n/* book text */\n\n.drp-left small{\n  display:block;\n\n  margin-bottom:3px;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:9px;\n\n  font-weight:600;\n\n  letter-spacing:.2em;\n\n  color:rgba(255,255,255,.72);\n}\n\n.drp-left strong{\n  display:block;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:25px;\n\n  font-weight:800;\n\n  letter-spacing:.05em;\n\n  color:#fff;\n}\n\n\n/* action pill */\n\n.drp-action{\n  flex-shrink:0;\n\n  padding:14px 21px;\n\n  border-radius:999px;\n\n  background:#F2D39A;\n\n  color:#762535;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:800;\n\n  letter-spacing:.08em;\n}\n\n\n/* limited slots */\n\n.drp-limit{\n  margin-top:38px;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:700;\n\n  letter-spacing:.22em;\n\n  color:#A36A50;\n}\n\n\n/* note */\n\n.drp-note{\n  max-width:610px;\n\n  margin:36px auto 0;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:500;\n\n  line-height:1.8;\n\n  color:#98776D;\n}\n\n\n/* decorative elements */\n\n.drp-flower{\n  position:absolute;\n\n  z-index:1;\n\n  color:#B88655;\n\n  opacity:.38;\n\n  pointer-events:none;\n\n  animation:floatDiva 5s ease-in-out infinite;\n}\n\n.f1{\n  left:12%;\n  top:25%;\n  font-size:34px;\n}\n\n.f2{\n  right:12%;\n  top:21%;\n  font-size:48px;\n}\n\n.f3{\n  right:15%;\n  bottom:20%;\n  font-size:24px;\n}\n\n@keyframes floatDiva{\n  0%,100%{\n    transform:translateY(0) rotate(0deg);\n  }\n\n  50%{\n    transform:translateY(-12px) rotate(5deg);\n  }\n}\n\n\n/* ===========================\n   MOBILE\n=========================== */\n\n@media(max-width:600px){\n\n  .diva-rsvp-premium{\n    padding:64px 18px 55px;\n  }\n\n\n  .drp-date{\n    padding:8px 14px;\n\n    font-size:9px;\n\n    letter-spacing:.17em;\n  }\n\n\n  .drp-title{\n    margin-top:30px;\n\n    font-s