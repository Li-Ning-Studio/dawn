    "custom_liquid_GwyNeF": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SHUTTLEVERSE SECTION 7: FAQ ACCORDION -->\n<!-- Shopify: Themes > Customize > Add Section > Custom HTML -->\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n.sv7{background:#4E1164;padding:80px 24px 100px;}\n.sv7 .in{max-width:800px;margin:0 auto;}\n.sv7 .ey{font-family:Figtree;font-size:1.78rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#F5C500;margin-bottom:12px;display:block;}\n.sv7 .ti{font-family:Figtree;font-weight:900;font-size:clamp(4.4rem,6vw,5.5rem);line-height:.95;text-transform:uppercase;color:#fff;margin:0;}\n.sv7 .list{margin-top:48px;}\n.sv7 .fi{border-bottom:1px solid rgba(255,255,255,.1);}\n.sv7 .fq{width:100%;background:none;border:none;color:#fff;text-align:left;padding:20px 0;font-family:Figtree;font-weight:700;font-size:1.7rem;letter-spacing:.03em;text-transform:uppercase;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;transition:color .2s;}\n.sv7 .fq:hover{color:#F5C500;}\n.sv7 .fa-arrow{flex-shrink:0;width:22px;height:22px;border:2px solid #F5C500;display:flex;align-items:center;justify-content:center;font-size:1.9rem;color:#F5C500;transition:transform .25s;clip-path:polygon(4px 0%,100% 0%,calc(100% - 4px) 100%,0% 100%);line-height:1;}\n.sv7 .fi.open .fa-arrow{transform:rotate(45deg);}\n.sv7 .fa{max-height:0;overflow:hidden;font-family:Figtree;font-size:1.6rem;color:#F0EAF8;opacity:.8;line-height:1.7;transition:max-height .35s ease,padding-bottom .35s ease;padding-bottom:0;}\n.sv7 .fi.open .fa{max-height:200px;padding-bottom:20px;}\n@media(max-width:600px){.sv7{padding:60px 20px 80px;}.sv7 .fq{font-size:1.7rem;}}\n</style>\n\n<section class=\"sv7\">\n  <div class=\"in\">\n    <span class=\"ey\">FAQ</span>\n    <h2 class=\"ti\">Got questions?</h2>\n    <div class=\"list\">\n\n      <div class=\"fi\">\n        <button class=\"fq\">Is the registration fee refundable?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">No. Registrations once confirmed are non-refundable and non-transferable unless the event is cancelled by HNDRD.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What happens after I pay?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">You will receive a confirmation message or email from the HNDRD team with your full registration details. Keep it handy on event day.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Can I register on the day?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">On-spot registrations may be available if slots remain open — but we strongly recommend registering in advance to secure your place.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Will shuttles be provided?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes. Event shuttles & rackets are provided by the organizers.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">What if I arrive late?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Late arrivals may forfeit their scheduled matches or activities. Please report by 11:30 AM to make the most of the day.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Is there a skill-level restriction?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">No. ShuttleVerse is designed for players across all skill levels — Beginner, Intermediate, and Advanced. Everyone aged 16 and above is welcome.</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Can spectators attend?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes, spectators are welcome subject to venue regulations and available space at Smashbounce Korattur, Chennai.\n</div>\n      </div>\n\n      <div class=\"fi\">\n        <button class=\"fq\">Will there be prizes?<span class=\"fa-arrow\">+</span></button>\n        <div class=\"fa\">Yes. Winners and standout performers may receive prizes, merchandise, and exclusive HNDRD rewards.</div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var items = document.querySelectorAll('.sv7 .fi');\n  items.forEach(function(item){\n    item.querySelector('.fq').addEventListener('click', function(){\n      var isOpen = item.classList.contains('open');\n      document.querySelectorAll('.sv7 .fi.open').forEach(function(o){ o.classList.remove('open'); });\n      if(!isOpen) item.classList.add('open');\n    });\n  });\n})();\n</script>",
