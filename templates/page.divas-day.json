      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — HERO CTA SECTION\n     Premium feminine event CTA\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n.dv-hero,\n.dv-hero * {\n  box-sizing:border-box;\n}\n\n\n.dv-hero {\n\n  position:relative;\n  width:100%;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  padding:70px 24px 110px;\n\n  text-align:center;\n\n  overflow:hidden;\n\n\n  background:\n\n  radial-gradient(\n    circle at 15% 15%,\n    rgba(255,255,255,.75),\n    transparent 35%\n  ),\n\n  radial-gradient(\n    circle at 85% 80%,\n    rgba(125,31,41,.08),\n    transparent 35%\n  ),\n\n  linear-gradient(\n    135deg,\n    #F8ECE1 0%,\n    #F3D9D0 55%,\n    #EBC3BA 100%\n  );\n\n}\n\n\n\n/* Texture */\n\n.dv-hero:before {\n\n  content:\"\";\n\n  position:absolute;\n\n  inset:0;\n\n\n  background-image:\n\n  radial-gradient(\n    rgba(120,30,40,.08) 1px,\n    transparent 1px\n  );\n\n\n  background-size:18px 18px;\n\n  opacity:.22;\n\n}\n\n\n\n/* Floating decoration */\n\n.dv-hero:after {\n\n  content:\"♡  ✦  ♡\";\n\n  position:absolute;\n\n  top:15%;\n  right:8%;\n\n\n  font-size:38px;\n\n  color:rgba(125,31,41,.16);\n\n  letter-spacing:12px;\n\n\n  animation:dvaFloat 5s ease-in-out infinite;\n\n}\n\n\n\n@keyframes dvaFloat {\n\n0%,100%{\n\ntransform:translateY(0);\n\n}\n\n50%{\n\ntransform:translateY(-15px);\n\n}\n\n}\n\n\n\n/* Bottom wave */\n\n.dv-hero__clip {\n\n\nposition:absolute;\n\nbottom:-1px;\n\nleft:0;\n\nright:0;\n\nheight:75px;\n\n\nbackground:#7D1F29;\n\n\nclip-path:polygon(\n0 100%,\n100% 0,\n100% 100%\n);\n\n\n}\n\n\n\n\n\n/* Content */\n\n.dv-hero__content {\n\nposition:relative;\n\nz-index:2;\n\n\nmax-width:820px;\n\n\ndisplay:flex;\n\nflex-direction:column;\n\nalign-items:center;\n\n\nanimation:dvaReveal .8s ease forwards;\n\n}\n\n\n\n@keyframes dvaReveal {\n\n\nfrom{\n\nopacity:0;\n\ntransform:translateY(25px);\n\n}\n\n\nto{\n\nopacity:1;\n\ntransform:translateY(0);\n\n}\n\n}\n\n\n\n\n\n/* Text */\n\n\n.dv-hero__tagline {\n\n\nfont-family:Figtree,sans-serif;\n\n\nfont-size:clamp(1.45rem,2vw,2.1rem);\n\n\nline-height:1.55;\n\n\nfont-weight:400;\n\n\ncolor:#552027;\n\n\nmargin:0;\n\n\n}\n\n\n\n.dv-highlight {\n\n\ncolor:#8F2533;\n\nfont-weight:700;\n\n}\n\n\n\n\n/* CTA */\n\n\n.dv-hero__cta {\n\n\nmargin-top:38px;\n\n\ndisplay:inline-flex;\n\nalign-items:center;\n\njustify-content:center;\n\n\nbackground:#7D1F29;\n\n\ncolor:#FCEBDD;\n\n\nfont-family:Figtree,sans-serif;\n\n\nfont-weight:800;\n\n\nfont-size:1.25rem;\n\n\nletter-spacing:.08em;\n\n\ntext-transform:uppercase;\n\n\npadding:18px 60px;\n\n\nborder-radius:999px;\n\n\ntext-decoration:none;\n\n\nbox-shadow:\n0 12px 30px rgba(125,31,41,.22);\n\n\ntransition:.3s ease;\n\n\n}\n\n\n\n.dv-hero__cta:hover {\n\n\nbackground:#962C3B;\n\ntransform:translateY(-3px);\n\n}\n\n\n\n\n\n/* Price */\n\n\n.dv-hero__price {\n\n\nmargin-top:18px;\n\n\nfont-family:Figtree,sans-serif;\n\n\nfont-size:1.25rem;\n\n\ncolor:#87552E;\n\n\nletter-spacing:.05em;\n\n\n}\n\n\n\n.dv-hero__price strong {\n\n\ncolor:#7D1F29;\n\nfont-size:1.45rem;\n\n\n}\n\n\n\n\n/* Sparkle */\n\n\n.dv-hero__content:before {\n\n\ncontent:\"✦\";\n\n\nposition:absolute;\n\n\nleft:-80px;\n\ntop:25px;\n\n\nfont-size:35px;\n\n\ncolor:#C28A55;\n\n\nanimation:dvaSparkle 2.5s infinite;\n\n\n}\n\n\n\n@keyframes dvaSparkle {\n\n\n0%,100%{\n\nopacity:.3;\n\ntransform:scale(.8);\n\n}\n\n\n50%{\n\nopacity:1;\n\ntransform:scale(1.1);\n\n}\n\n}\n\n\n\n\n\n\n\n/* ===========================\n        MOBILE VERSION\n=========================== */\n\n\n@media(max-width:600px){\n\n\n.dv-hero {\n\n\npadding:38px 20px 65px;\n\n}\n\n\n\n/* remove unnecessary motion */\n\n.dv-hero:after {\n\ndisplay:none;\n\n}\n\n\n.dv-hero__content {\n\nanimation:none;\n\nmax-width:100%;\n\n}\n\n\n\n.dv-hero__content:before {\n\ndisplay:none;\n\n}\n\n\n\n/* Text */\n\n.dv-hero__tagline {\n\n\nfont-size:1.12rem;\n\n\nline-height:1.55;\n\n\nletter-spacing:-0.01em;\n\n\n}\n\n\n\n.dv-highlight {\n\nfont-weight:700;\n\n}\n\n\n\n/* CTA */\n\n.dv-hero__cta {\n\n\nmargin-top:26px;\n\n\nwidth:100%;\n\nmax-width:290px;\n\n\nfont-size:.95rem;\n\n\npadding:15px 25px;\n\n\nletter-spacing:.07em;\n\n\nbox-shadow:\n0 8px 20px rgba(125,31,41,.18);\n\n\n}\n\n\n\n/* Price */\n\n.dv-hero__price {\n\n\nmargin-top:16px;\n\n\nfont-size:.95rem;\n\n\nletter-spacing:.03em;\n\n\n}\n\n\n.dv-hero__price strong {\n\n\nfont-size:1.2rem;\n\n\n}\n\n\n\n/* bottom shape */\n\n.dv-hero__clip {\n\n\nheight:38px;\n\n}\n\n\n\n}\n\n</style>\n\n\n\n\n\n<section class=\"dv-hero\">\n\n\n<div class=\"dv-hero__content\">\n\n\n<p class=\"dv-hero__tagline\">\n\n\nMade by women who love the sport, for women who love to play.\n\n\n\n<span class=\"dv-highlight\">\nDiva's Day\n</span>\n\nbrings together\n\n\n<span class=\"dv-highlight\">\nZumba, badminton, and coffee\n</span>\n\n\nin a two-hour celebration of movement, fun, and doing it the diva-way.\n\n\nOpen to women of all ages ready to play, move, and enjoy.\n\n\n\n</p>\n\n\n\n\n<a href=\"#sv-register\" class=\"dv-hero__cta\">\n\nReserve Your Spot\n\n</a>\n\n\n\n\n\n<div class=\"dv-hero__price\">\n\nOnly <strong>₹299</strong> per participant\n&nbsp;·&nbsp;\nLimited spots\n\n</div>\n\n\n\n</div>\n\n\n\n<div class=\"dv-hero__clip\"></div>\n\n\n</section>",
