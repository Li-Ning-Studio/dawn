      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — HERO CTA SECTION\n     Mobile optimized + scrolls to #sv-register\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n\nhtml{\n  scroll-behavior:smooth;\n}\n\n.dv-hero,\n.dv-hero *{\n  box-sizing:border-box;\n}\n\n.dv-hero{\n  position:relative;\n  width:100%;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  padding:70px 24px 110px;\n\n  text-align:center;\n  overflow:hidden;\n\n  background:#ECD4D0;\n}\n\n/* subtle texture */\n\n.dv-hero:before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n\n  background-image:\n    radial-gradient(\n      rgba(120,30,40,.08) 1px,\n      transparent 1px\n    );\n\n  background-size:18px 18px;\n  opacity:.22;\n}\n\n/* floating decoration */\n\n.dv-hero:after{\n  content:\"♡  ✦  ♡\";\n\n  position:absolute;\n  top:15%;\n  right:8%;\n\n  font-size:38px;\n  color:rgba(125,31,41,.16);\n  letter-spacing:12px;\n\n  animation:dvaFloat 5s ease-in-out infinite;\n}\n\n@keyframes dvaFloat{\n  0%,100%{\n    transform:translateY(0);\n  }\n\n  50%{\n    transform:translateY(-15px);\n  }\n}\n\n/* bottom wave */\n\n.dv-hero__clip{\n  position:absolute;\n  bottom:-1px;\n  left:0;\n  right:0;\n\n  height:75px;\n\n  background:#7D1F29;\n\n  clip-path:polygon(\n    0 100%,\n    100% 0,\n    100% 100%\n  );\n}\n\n/* content */\n\n.dv-hero__content{\n  position:relative;\n  z-index:2;\n\n  max-width:820px;\n\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n\n  animation:dvaReveal .8s ease forwards;\n}\n\n@keyframes dvaReveal{\n  from{\n    opacity:0;\n    transform:translateY(25px);\n  }\n\n  to{\n    opacity:1;\n    transform:translateY(0);\n  }\n}\n\n/* text */\n\n.dv-hero__tagline{\n  font-family:Figtree,sans-serif;\n\n  font-size:clamp(1.45rem,2vw,2.1rem);\n\n  line-height:1.55;\n  font-weight:400;\n\n  color:#552027;\n\n  margin:0;\n}\n\n.dv-highlight{\n  color:#8F2533;\n  font-weight:700;\n}\n\n/* CTA */\n\n.dv-hero__cta{\n  margin-top:38px;\n\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n\n  min-width:320px;\n\n  background:#7D1F29;\n  color:#FCEBDD;\n\n  font-family:Figtree,sans-serif;\n  font-weight:800;\n\n  font-size:1.25rem;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n\n  padding:18px 60px;\n\n  border-radius:999px;\n\n  text-decoration:none;\n\n  box-shadow:\n    0 12px 30px rgba(125,31,41,.22);\n\n  transition:\n    transform .3s ease,\n    background .3s ease,\n    box-shadow .3s ease;\n}\n\n.dv-hero__cta:hover{\n  background:#962C3B;\n\n  transform:translateY(-3px);\n\n  box-shadow:\n    0 18px 38px rgba(125,31,41,.28);\n\n  color:#fff;\n}\n\n/* price */\n\n.dv-hero__price{\n  margin-top:18px;\n\n  font-family:Figtree,sans-serif;\n\n  font-size:1.25rem;\n\n  color:#87552E;\n\n  letter-spacing:.05em;\n}\n\n.dv-hero__price strong{\n  color:#7D1F29;\n  font-size:1.45rem;\n}\n\n/* sparkle */\n\n.dv-hero__content:before{\n  content:\"✦\";\n\n  position:absolute;\n\n  left:-80px;\n  top:25px;\n\n  font-size:35px;\n\n  color:#C28A55;\n\n  animation:dvaSparkle 2.5s infinite;\n}\n\n@keyframes dvaSparkle{\n  0%,100%{\n    opacity:.3;\n    transform:scale(.8);\n  }\n\n  50%{\n    opacity:1;\n    transform:scale(1.1);\n  }\n}\n\n/* ===========================\n        MOBILE\n=========================== */\n\n@media(max-width:600px){\n\n  .dv-hero{\n    padding:50px 20px 78px;\n  }\n\n  .dv-hero:after{\n    display:none;\n  }\n\n  .dv-hero__content{\n    max-width:100%;\n    animation:none;\n  }\n\n  .dv-hero__content:before{\n    display:none;\n  }\n\n  .dv-hero__tagline{\n    font-size:1.32rem;\n    line-height:1.58;\n    letter-spacing:-0.01em;\n  }\n\n  .dv-hero__cta{\n    margin-top:32px;\n\n    width:100%;\n    max-width:none;\n    min-width:0;\n\n    font-size:1.08rem;\n\n    padding:18px 24px;\n\n    letter-spacing:.07em;\n\n    box-shadow:\n      0 10px 24px rgba(125,31,41,.2);\n  }\n\n  .dv-hero__price{\n    margin-top:20px;\n\n    font-size:1.08rem;\n    line-height:1.5;\n\n    letter-spacing:.02em;\n  }\n\n  .dv-hero__price strong{\n    font-size:1.35rem;\n  }\n\n  .dv-hero__clip{\n    height:42px;\n  }\n}\n\n/* extra small phones */\n\n@media(max-width:380px){\n\n  .dv-hero{\n    padding-left:16px;\n    padding-right:16px;\n  }\n\n  .dv-hero__tagline{\n    font-size:1.22rem;\n  }\n\n  .dv-hero__cta{\n    font-size:1rem;\n    padding:17px 18px;\n  }\n\n  .dv-hero__price{\n    font-size:1rem;\n  }\n\n}\n\n</style>\n\n\n<section class=\"dv-hero\">\n\n  <div class=\"dv-hero__content\">\n\n    <p class=\"dv-hero__tagline\">\n\n      Made by women who love the sport, for women who love to play.\n\n      <span class=\"dv-highlight\">\n        Diva's Day\n      </span>\n\n      brings together\n\n      <span class=\"dv-highlight\">\n        Zumba, badminton, and coffee\n      </span>\n\n      in a two-hour celebration of movement, fun, and doing it the diva-way.\n\n      Open to women of all ages ready to play, move, and enjoy.\n\n    </p>\n\n\n    <!-- Goes directly to your final RSVP section -->\n    <a href=\"#sv-register\" class=\"dv-hero__cta\">\n      Reserve Your Spot\n    </a>\n\n\n    <div class=\"dv-hero__price\">\n      Only <strong>₹299</strong> per participant\n      &nbsp;·&nbsp;\n      Limited spots\n    </div>\n\n  </div>\n\n\n  <div class=\"dv-hero__clip\"></div>\n\n</section>",
