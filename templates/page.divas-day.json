      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — PREMIUM RSVP CTA\n     Exact Background: #ECD4D0\n============================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=League+Spartan:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n.diva-rsvp-premium,\n.diva-rsvp-premium *{\n  box-sizing:border-box;\n}\n\n.diva-rsvp-premium{\n  position:relative;\n  overflow:hidden;\n\n  padding:95px 20px 82px;\n\n  text-align:center;\n\n  font-family:Manrope,sans-serif;\n\n  color:#6B2632;\n\n  background:#ECD4D0;\n}\n\n\n/* very subtle texture only */\n\n.diva-rsvp-premium:before{\n  content:\"\";\n\n  position:absolute;\n  inset:0;\n\n  pointer-events:none;\n\n  background:\n    radial-gradient(\n      rgba(112,45,56,.055) 1px,\n      transparent 1px\n    );\n\n  background-size:24px 24px;\n\n  opacity:.16;\n}\n\n\n.drp-content{\n  position:relative;\n  z-index:2;\n\n  width:100%;\n  max-width:760px;\n\n  margin:auto;\n}\n\n\n/* DATE PILL */\n\n.drp-date{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n\n  padding:10px 23px;\n\n  border-radius:999px;\n\n  border:1px solid rgba(116,31,43,.35);\n\n  background:rgba(255,255,255,.18);\n\n  color:#7D3541;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n  font-weight:800;\n\n  letter-spacing:.23em;\n}\n\n\n/* ============================================================\n   MAIN HEADING\n============================================================ */\n\n.drp-title{\n  margin:38px 0 0;\n\n  font-family:\"League Spartan\",sans-serif;\n\n  font-size:clamp(66px,8vw,102px);\n\n  line-height:.82;\n\n  font-weight:900;\n\n  letter-spacing:-.055em;\n\n  text-transform:uppercase;\n\n  color:#63212D;\n}\n\n\n.drp-title span{\n  display:block;\n\n  margin-top:10px;\n\n  font-family:\"League Spartan\",sans-serif;\n\n  font-size:clamp(92px,12vw,148px);\n\n  line-height:.82;\n\n  font-weight:900;\n\n  letter-spacing:-.055em;\n\n  color:#9B3043;\n}\n\n\n/* SUBTEXT */\n\n.drp-sub{\n  max-width:560px;\n\n  margin:34px auto 44px;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:16px;\n\n  line-height:1.7;\n\n  font-weight:500;\n\n  color:#75555A;\n}\n\n\n/* ============================================================\n   BOOKING BAR\n============================================================ */\n\n.drp-book{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n\n  gap:18px;\n\n  width:100%;\n  max-width:600px;\n\n  margin:auto;\n\n  padding:13px 14px;\n\n  background:#782A3A;\n\n  border:1px solid rgba(255,255,255,.12);\n\n  border-radius:18px;\n\n  text-decoration:none;\n\n  color:#fff;\n\n  box-shadow:\n    0 16px 35px rgba(87,31,42,.15);\n\n  transition:\n    background .2s ease;\n}\n\n\n/* no CTA effects */\n\n.drp-book:hover{\n  transform:none;\n\n  background:#812E40;\n}\n\n\n/* LEFT SIDE */\n\n.drp-left{\n  display:flex;\n  align-items:center;\n\n  gap:14px;\n\n  text-align:left;\n}\n\n\n.drp-icon{\n  width:50px;\n  height:50px;\n\n  flex:0 0 50px;\n\n  display:flex;\n  align-items:center;\n  justify-content:center;\n\n  border-radius:11px;\n\n  background:#E5C6A2;\n\n  color:#762837;\n\n  font-family:\"League Spartan\",sans-serif;\n\n  font-size:22px;\n\n  font-weight:800;\n}\n\n\n.drp-left small{\n  display:block;\n\n  margin-bottom:3px;\n\n  color:rgba(255,255,255,.68);\n\n  font-family:Manrope,sans-serif;\n\n  font-size:9px;\n\n  font-weight:700;\n\n  letter-spacing:.19em;\n}\n\n\n.drp-left strong{\n  display:block;\n\n  font-family:\"League Spartan\",sans-serif;\n\n  font-size:26px;\n\n  line-height:1;\n\n  font-weight:800;\n\n  letter-spacing:.025em;\n\n  color:#fff;\n}\n\n\n/* BOOK NOW */\n\n.drp-action{\n  flex-shrink:0;\n\n  padding:14px 21px;\n\n  border-radius:10px;\n\n  background:#E5C6A2;\n\n  color:#702535;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:800;\n\n  letter-spacing:.08em;\n}\n\n\n/* LIMITED SLOTS */\n\n.drp-limit{\n  margin-top:38px;\n\n  color:#88513E;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:800;\n\n  letter-spacing:.22em;\n}\n\n\n/* DISCLAIMER */\n\n.drp-note{\n  max-width:620px;\n\n  margin:40px auto 0;\n\n  color:#886B6B;\n\n  font-family:Manrope,sans-serif;\n\n  font-size:11px;\n\n  font-weight:500;\n\n  line-height:1.8;\n}\n\n\n/* DECORATIVE DETAILS */\n\n.drp-deco{\n  position:absolute;\n\n  z-index:1;\n\n  color:#9B3043;\n\n  opacity:.18;\n\n  pointer-events:none;\n}\n\n\n.drp-deco.one{\n  left:11%;\n  top:25%;\n\n  font-size:30px;\n}\n\n\n.drp-deco.two{\n  right:11%;\n  top:21%;\n\n  font-size:38px;\n}\n\n\n.drp-deco.three{\n  right:15%;\n  bottom:18%;\n\n  font-size:22px;\n}\n\n\n/* ============================================================\n   MOBILE\n============================================================ */\n\n@media(max-width:600px){\n\n  .diva-rsvp-premium{\n    padding:64px 18px 56px;\n\n    background:#ECD4D0;\n  }\n\n\n  .drp-date{\n    padding:8px 14px;\n\n    font-size:9px;\n\n    letter-spacing:.16em;\n  }\n\n\n  .drp-title{\n    margin-top:30px;\n\n    font-size:55px;\n\n    line-height:.82;\n\n    letter-spacing:-.045em;\n  }\n\n\n  .drp-title span{\n    margin-top:8px;\n\n    font-size:84px;\n\n    line-height:.82;\n  }\n\n\n  .drp-sub{\n    max-width:330px;\n\n    margin:26px auto 34px;\n\n    font-size:14px;\n\n    line-height:1.65;\n  }\n\n\n  .drp-book{\n    gap:10px;\n\n    padding:11px;\n\n    border-radius:15px;\n  }\n\n\n  .drp-left{\n    gap:9px;\n  }\n\n\n  .drp-icon{\n    width:40px;\n    height:40px;\n\n    flex-basis:40px;\n\n    border-radius:9px;\n\n    font-size:17px;\n  }\n\n\n  .drp-left small{\n    font-size:7px;\n\n    letter-spacing:.11em;\n  }\n\n\n  .drp-left strong{\n    font-size:18px;\n  }\n\n\n  .drp-action{\n    padding:11px 12px;\n\n    border-radius:8px;\n\n    font-size:9px;\n\n    letter-spacing:.04em;\n  }\n\n\n  .drp-limit{\n    margin-top:30px;\n\n    padding:0 10px;\n\n    font-size:9px;\n\n    line-height:1.6;\n\n    letter-spacing:.12em;\n  }\n\n\n  .drp-note{\n    margin-top:30px;\n\n    font-size:9.5px;\n\n    line-height:1.7;\n  }\n\n\n  .drp-deco.one{\n    left:2%;\n    top:24%;\n\n    font-size:20px;\n  }\n\n\n  .drp-deco.two{\n    right:3%;\n    top:20%;\n\n    font-size:24px;\n  }\n\n\n  .drp-deco.three{\n    display:none;\n  }\n\n}\n\n</style>\n\n\n<section class=\"diva-rsvp-premium\">\n\n\n  <div class=\"drp-deco one\">✦</div>\n  <div class=\"drp-deco two\">♡</div>\n  <div class=\"drp-deco three\">✦</div>\n\n\n  <div class=\"drp-content\">\n\n\n    <div class=\"drp-date\">\n\n      20TH SEPTEMBER · BENGALURU\n\n    </div>\n\n\n\n    <h2 class=\"drp-title\">\n\n      JOIN FOR\n\n      <span>₹299</span>\n\n    </h2>\n\n\n\n    <p class=\"drp-sub\">\n\n      Book your spot for Diva's Day and get ready\n      for badminton, zumba, coffee and good company.\n\n    </p>\n\n\n\n    <a\n      href=\"https://offlyn.life/e/446HVIM\"\n      class=\"drp-book\"\n      target=\"_blank\"\n      rel=\"noopener\"\n    >\n\n\n      <div class=\"drp-left\">\n\n\n        <div class=\"drp-icon\">\n          ♡\n        </div>\n\n\n        <div>\n\n          <small>\n            BOOK ON\n          </small>\n\n          <strong>\n            OFFLYN\n          </strong>\n\n        </div>\n\n\n      </div>\n\n\n\n      <div class=\"drp-action\">\n\n        BOOK NOW →\n\n      </div>\n\n\n    </a>\n\n\n\n    <div class=\"drp-limit\">\n\n      ✦ LIMITED SPOTS · FIRST COME, FIRST SERVED\n\n    </div>\n\n\n\n    <p class=\"drp-note\">\n\n      Registration confirmed only after successful payment.\n      HNDRD reserves the right to modify schedules.\n      Participants may be photographed for promotional use.\n      Misconduct may result in disqualification without refund.\n      Event decisions by organizers are final.\n\n    </p>\n\n\n  </div>\n\n\n</section>",
