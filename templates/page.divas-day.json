      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     SHUTTLEVERSE — SECTION 4: WHAT'S INCLUDED\n     Shopify: Themes > Customize > Add Section > Custom HTML\n================================================================ -->\n\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Inter:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* ── Section wrapper ── */\n  .sv-included {\n    background: linear-gradient(180deg, #4E1164 0%, #2A0960 100%);\n    padding: 80px 24px;\n    position: relative;\n  }\n\n  /* Gold top accent line */\n  .sv-included::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 4px;\n    background: #F5C500;\n  }\n\n  .sv-included__inner {\n    max-width: 860px;\n    margin: 0 auto;\n  }\n\n  /* ── Section header ── */\n  .sv-included__eyebrow {\n    display: block;\n    font-family: Figtree;\n    font-weight: 700;\n    font-size: 1.78rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #F5C500;\n    margin-bottom: 12px;\n  }\n\n  .sv-included__title {\n    font-family: Figtree;\n    font-weight: 900;\n    font-size: clamp(3.8rem, 6vw, 4.5rem);\n    line-height: 0.95;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0;\n  }\n\n  /* ── 2-column card grid ── */\n  .sv-included__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 48px;\n  }\n\n  /* ── Individual card ── */\n  .sv-included__card {\n    background: rgba(91, 31, 168, 0.25);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-left: 3px solid transparent;\n    padding: 32px 28px;\n    position: relative;\n    overflow: hidden;\n    transition: border-left-color 0.2s, background 0.2s;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  /* Gold corner tag on hover */\n  .sv-included__card::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    border-style: solid;\n    border-width: 0 28px 28px 0;\n    border-color: transparent #F5C500 transparent transparent;\n    opacity: 0;\n    transition: opacity 0.2s;\n  }\n\n  .sv-included__card:hover {\n    border-left-color: #F5C500;\n    background: rgba(91, 31, 168, 0.45);\n  }\n\n  .sv-included__card:hover::after {\n    opacity: 1;\n  }\n\n  .sv-included__icon {\n    font-size: 2.5rem;\n    display: block;\n    margin-bottom: 14px;\n  }\n\n  .sv-included__card-title {\n    font-family: Figtree;\n    font-weight: 800;\n    font-size: 2.15rem;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 8px 0;\n  }\n\n  .sv-included__card-desc {\n    font-family: Figtree;\n    font-size: 1.49rem;\n    color: #F0EAF8;\n    opacity: 0.75;\n    line-height: 1.65;\n    margin: 0;\n  }\n\n  /* ── Responsive ── */\n  @media (max-width: 600px) {\n    .sv-included { padding: 60px 20px; }\n    .sv-included__grid { grid-template-columns: 1fr; gap: 12px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sv-included__card {\n      opacity: 1 !important;\n      transform: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<section class=\"sv-included\">\n  <div class=\"sv-included__inner\">\n\n    <span class=\"sv-included__eyebrow\">What's Included</span>\n    <h2 class=\"sv-included__title\">Everything<br>you need to play</h2>\n\n    <div class=\"sv-included__grid\">\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Event Entry</h3>\n        <p class=\"sv-included__card-desc\">Full day access to all scheduled matches, challenges, and court activities.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Shuttles & Rackets Provided</h3>\n        <p class=\"sv-included__card-desc\">Official event shuttles & rackets provided by the organizers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Prizes </h3>\n        <p class=\"sv-included__card-desc\">Prizes, merchandise, and exclusive HNDRD rewards for standout performers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Community Access</h3>\n        <p class=\"sv-included__card-desc\">Network with fellow enthusiasts and get exclusive HNDRD experiences and offers.</p>\n      </div>\n\n      <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Brand Activations</h3>\n        <p class=\"sv-included__card-desc\">Interactive brand zones, product experiences, and exclusive HNDRD drops on the day.</p>\n      </div>\n\n     <!-- <div class=\"sv-included__card\">\n        <span class=\"sv-included__icon\"></span>\n        <h3 class=\"sv-included__card-title\">Food Stalls Available</h3>\n        <p class=\"sv-included__card-desc\">Food available at the venue. <i>Additional charges apply, Based on venue.</i></p>\n      </div> -->\n\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var cards = document.querySelectorAll('.sv-included__card');\n    if (!cards.length) return;\n\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          var card = entry.target;\n          var index = Array.prototype.indexOf.call(cards, card);\n          setTimeout(function () {\n            card.style.opacity = '1';\n            card.style.transform = 'translateY(0)';\n            card.style.transition = 'opacity 0.45s ease, transform 0.45s ease, border-left-color 0.2s, background 0.2s';\n          }, index * 80);\n          observer.unobserve(card);\n        }\n      });\n    }, { threshold: 0.1 });\n\n    cards.forEach(function (card) {\n      observer.observe(card);\n    });\n  })();\n</script>",
