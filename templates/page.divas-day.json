      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — PREMIUM STICKY CTA BAR\n================================================================ -->\n\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n\nhtml {\n  scroll-behavior:smooth;\n}\n\n\n\n/* MAIN BAR */\n\n\n.dv-sticky-bar {\n\n\n  position:fixed;\n\n  bottom:22px;\n\n  left:50%;\n\n\n  transform:translateX(-50%);\n\n\n  width:calc(100% - 48px);\n\n\n  max-width:1100px;\n\n\n  background:\n\n  linear-gradient(\n    135deg,\n    #7D1F29,\n    #5B1720\n  );\n\n\n  color:#F8E9D7;\n\n\n  display:flex;\n\n\n  align-items:center;\n\n\n  justify-content:center;\n\n\n  gap:28px;\n\n\n  padding:18px 28px;\n\n\n  border-radius:24px;\n\n\n  z-index:9999;\n\n\n  font-family:Figtree,sans-serif;\n\n\n  box-shadow:\n\n\n  0 20px 50px rgba(80,20,30,.35),\n\n\n  inset 0 1px 0 rgba(255,255,255,.15);\n\n\n\n  overflow:hidden;\n\n\n  animation:\n\n  stickyEnter .8s ease forwards;\n\n\n}\n\n\n\n/* shine */\n\n\n.dv-sticky-bar:before {\n\n\n  content:\"\";\n\n\n  position:absolute;\n\n\n  top:0;\n\n\n  left:-100%;\n\n\n  width:60%;\n\n\n  height:100%;\n\n\n  background:\n\n  linear-gradient(\n\n  120deg,\n\n  transparent,\n\n  rgba(255,255,255,.18),\n\n  transparent\n\n  );\n\n\n  transform:skewX(-20deg);\n\n\n  animation:\n\n  stickyShine 5s infinite;\n\n\n}\n\n\n\n\n@keyframes stickyShine {\n\n\n  0% {\n\n    left:-100%;\n\n  }\n\n\n  35% {\n\n    left:150%;\n\n  }\n\n\n  100% {\n\n    left:150%;\n\n  }\n\n}\n\n\n\n\n@keyframes stickyEnter {\n\n\n  from {\n\n    opacity:0;\n\n    transform:\n\n    translateX(-50%)\n\n    translateY(40px);\n\n  }\n\n\n  to {\n\n    opacity:1;\n\n    transform:\n\n    translateX(-50%)\n\n    translateY(0);\n\n  }\n\n}\n\n\n\n/* Text */\n\n\n.dv-sticky-label {\n\n\n  font-size:1rem;\n\n\n  font-weight:500;\n\n\n  opacity:.75;\n\n\n  letter-spacing:.04em;\n\n\n}\n\n\n\n.dv-sticky-text {\n\n\n  font-size:1.55rem;\n\n\n  font-weight:800;\n\n\n  color:#F6D49A;\n\n\n  letter-spacing:.04em;\n\n\n}\n\n\n\n\n/* BUTTON */\n\n\n.dv-sticky-btn {\n\n\n  position:relative;\n\n\n  overflow:hidden;\n\n\n  display:inline-flex;\n\n\n  align-items:center;\n\n\n  justify-content:center;\n\n\n  background:#F6D49A;\n\n\n  color:#7D1F29;\n\n\n  padding:14px 38px;\n\n\n  border-radius:999px;\n\n\n  text-decoration:none;\n\n\n  font-size:1.15rem;\n\n\n  font-weight:800;\n\n\n  letter-spacing:.08em;\n\n\n  text-transform:uppercase;\n\n\n  transition:.3s ease;\n\n\n  box-shadow:\n\n\n  0 8px 25px rgba(246,212,154,.25);\n\n\n  animation:\n\n  stickyPulse 3s infinite;\n\n\n}\n\n\n\n.dv-sticky-btn:before {\n\n\n  content:\"\";\n\n\n  position:absolute;\n\n\n  top:0;\n\n\n  left:-100%;\n\n\n  width:50%;\n\n\n  height:100%;\n\n\n  background:\n\n  linear-gradient(\n\n  120deg,\n\n  transparent,\n\n  rgba(255,255,255,.8),\n\n  transparent\n\n  );\n\n\n  animation:\n\n  buttonGlow 3.5s infinite;\n\n\n}\n\n\n\n@keyframes buttonGlow {\n\n\n  0% {\n\n    left:-100%;\n\n  }\n\n\n  35% {\n\n    left:140%;\n\n  }\n\n\n  100% {\n\n    left:140%;\n\n  }\n\n}\n\n\n\n\n@keyframes stickyPulse {\n\n\n  0%,100% {\n\n    transform:scale(1);\n\n  }\n\n\n  50% {\n\n    transform:scale(1.04);\n\n  }\n\n}\n\n\n\n\n.dv-sticky-btn:hover {\n\n\n  background:white;\n\n\n  transform:translateY(-3px) scale(1.05);\n\n\n}\n\n\n\n/* Sparkle */\n\n.dv-sticky-bar:after {\n\n\n  content:\"✦\";\n\n\n  position:absolute;\n\n\n  right:25px;\n\n\n  top:12px;\n\n\n  color:#F6D49A;\n\n\n  opacity:.5;\n\n\n  animation:\n\n  sparkleMove 2s infinite;\n\n\n}\n\n\n\n@keyframes sparkleMove {\n\n\n  0%,100% {\n\n    transform:scale(.8) rotate(0deg);\n\n    opacity:.3;\n\n  }\n\n\n  50% {\n\n    transform:scale(1.2) rotate(20deg);\n\n    opacity:1;\n\n  }\n\n}\n\n\n\n/* Space below */\n\n\nbody {\n\n  padding-bottom:100px;\n\n}\n\n\n\n\n\n/* MOBILE */\n\n\n@media(max-width:700px){\n\n\n.dv-sticky-bar {\n\n\n  bottom:14px;\n\n\n  width:calc(100% - 24px);\n\n\n  padding:16px;\n\n\n  border-radius:20px;\n\n\n  flex-direction:column;\n\n\n  gap:10px;\n\n\n}\n\n\n\n.dv-sticky-label {\n\n  display:none;\n\n}\n\n\n\n.dv-sticky-text {\n\n\n  font-size:1.25rem;\n\n\n}\n\n\n\n.dv-sticky-btn {\n\n\n  width:100%;\n\n\n  padding:14px;\n\n\n  font-size:1rem;\n\n\n}\n\n\n}\n\n\n\n</style>\n\n\n\n\n<div class=\"dv-sticky-bar\">\n\n\n<span class=\"dv-sticky-label\">\n\nYour diva moment awaits\n\n</span>\n\n\n\n<span class=\"dv-sticky-text\">\n\nReserve Your Spot · ₹299\n\n</span>\n\n\n\n<a href=\"#sv-register\" class=\"dv-sticky-btn\">\n\nJoin Diva's Day\n\n</a>\n\n\n\n</div>",
