    "custom_liquid_UndVHN": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     DIVA'S DAY — EVENT DETAILS\n     Premium Boarding Pass Style\n============================================================ -->\n\n\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n\n.dv-details,\n.dv-details *{\nbox-sizing:border-box;\n}\n\n\n\n.dv-details{\n\nposition:relative;\n\npadding:80px 20px;\n\noverflow:hidden;\n\n\nbackground:\n\nlinear-gradient(\n135deg,\n#F8E9DF,\n#F2D4CF\n);\n\n\nfont-family:Figtree,sans-serif;\n\n\n}\n\n\n\n/* background */\n\n.dv-details:before{\n\ncontent:\"DIVA\";\n\nposition:absolute;\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:240px;\n\ncolor:rgba(113,31,42,.04);\n\nright:-60px;\n\ntop:60px;\n\ntransform:rotate(-15deg);\n\n}\n\n\n\n/* wrapper */\n\n.dv-details-wrap{\n\nmax-width:950px;\n\nmargin:auto;\n\nposition:relative;\n\nz-index:2;\n\n}\n\n\n\n\n\n/* heading */\n\n.dv-details-head{\n\ntext-align:center;\n\nmargin-bottom:45px;\n\n}\n\n\n\n.dv-details-head small{\n\nfont-size:.75rem;\n\nletter-spacing:.4em;\n\ntext-transform:uppercase;\n\nfont-weight:700;\n\ncolor:#A36A50;\n\n}\n\n\n\n.dv-details-head h2{\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:clamp(3rem,6vw,5rem);\n\ncolor:#711F2A;\n\nmargin:15px 0 0;\n\nline-height:.9;\n\n}\n\n\n\n\n\n/* boarding pass */\n\n.dv-pass{\n\nposition:relative;\n\nbackground:#FFF9F1;\n\nborder-radius:28px;\n\npadding:40px;\n\nbox-shadow:\n\n0 25px 70px rgba(90,30,40,.18);\n\n\nborder:1px solid rgba(184,134,85,.4);\n\n\ndisplay:grid;\n\ngrid-template-columns:1fr 280px;\n\noverflow:hidden;\n\nanimation:passReveal .8s ease;\n\n}\n\n\n\n@keyframes passReveal{\n\nfrom{\n\nopacity:0;\n\ntransform:translateY(30px);\n\n}\n\nto{\n\nopacity:1;\n\ntransform:translateY(0);\n\n}\n\n}\n\n\n\n\n\n/* ticket divider */\n\n.dv-pass:after{\n\ncontent:\"\";\n\nposition:absolute;\n\ntop:30px;\n\nbottom:30px;\n\nright:280px;\n\nborder-left:1px dashed rgba(113,31,42,.25);\n\n}\n\n\n\n\n\n/* left content */\n\n\n.dv-pass-main{\n\npadding-right:35px;\n\n}\n\n\n\n\n\n.dv-pass-label{\n\nfont-size:.7rem;\n\nletter-spacing:.3em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\nfont-weight:700;\n\n}\n\n\n\n\n.dv-pass-date{\n\nfont-family:\"Playfair Display\",serif;\n\nfont-size:3.2rem;\n\nline-height:1;\n\ncolor:#711F2A;\n\nmargin:15px 0 35px;\n\n}\n\n\n\n\n\n.dv-info-row{\n\ndisplay:flex;\n\nalign-items:center;\n\ngap:18px;\n\npadding:18px 0;\n\nborder-bottom:1px solid rgba(113,31,42,.12);\n\n}\n\n\n\n.dv-icon{\n\nwidth:48px;\n\nheight:48px;\n\nborder-radius:50%;\n\nbackground:#F2DDD3;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\nfont-size:1.3rem;\n\n}\n\n\n\n.dv-info-row small{\n\ndisplay:block;\n\nfont-size:.7rem;\n\nletter-spacing:.2em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\n}\n\n\n\n.dv-info-row strong{\n\ndisplay:block;\n\nfont-size:1.25rem;\n\ncolor:#711F2A;\n\n}\n\n\n\n\n\n/* right stamp section */\n\n\n.dv-pass-side{\n\ndisplay:flex;\n\nflex-direction:column;\n\nalign-items:center;\n\njustify-content:center;\n\ntext-align:center;\n\n}\n\n\n\n.dv-stamp{\n\nwidth:150px;\n\nheight:150px;\n\nborder-radius:50%;\n\nborder:3px dashed #B88655;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\ncolor:#8B542F;\n\nfont-size:.75rem;\n\nfont-weight:800;\n\nletter-spacing:.15em;\n\ntransform:rotate(-12deg);\n\nposition:relative;\n\n}\n\n\n\n.dv-stamp:before{\n\ncontent:\"\";\n\nposition:absolute;\n\ninset:12px;\n\nborder:1px solid rgba(184,134,85,.6);\n\nborder-radius:50%;\n\n}\n\n\n\n\n.dv-side-text{\n\nmargin-top:35px;\n\nfont-size:.8rem;\n\nletter-spacing:.25em;\n\ntext-transform:uppercase;\n\ncolor:#A36A50;\n\n}\n\n\n\n\n\n/* mobile */\n\n@media(max-width:700px){\n\n\n.dv-details{\n\npadding:55px 15px;\n\n}\n\n\n\n.dv-pass{\n\ngrid-template-columns:1fr;\n\npadding:28px;\n\n}\n\n\n\n.dv-pass:after{\n\ndisplay:none;\n\n}\n\n\n\n.dv-pass-main{\n\npadding-right:0;\n\n}\n\n\n\n.dv-pass-date{\n\nfont-size:2.2rem;\n\n}\n\n\n\n.dv-pass-side{\n\nmargin-top:35px;\n\npadding-top:35px;\n\nborder-top:1px dashed rgba(113,31,42,.25);\n\n}\n\n\n\n.dv-stamp{\n\nwidth:120px;\n\nheight:120px;\n\n}\n\n\n\n}\n\n\n\n</style>\n\n\n\n\n<section class=\"dv-details\">\n\n\n<div class=\"dv-details-wrap\">\n\n\n<div class=\"dv-details-head\">\n\n\n<small>\nEvent Details\n</small>\n\n\n<h2>\nYour Diva Pass\n</h2>\n\n\n</div>\n\n\n\n\n\n<div class=\"dv-pass\">\n\n\n\n<div class=\"dv-pass-main\">\n\n\n\n<div class=\"dv-pass-label\">\nEvent Date\n</div>\n\n\n\n<div class=\"dv-pass-date\">\n20th September\n</div>\n\n\n\n\n<div class=\"dv-info-row\">\n\n<div class=\"dv-icon\">\n◷\n</div>\n\n\n<div>\n\n<small>\nTime\n</small>\n\n<strong>\n4 PM onwards\n</strong>\n\n\n</div>\n\n\n</div>\n\n\n\n\n\n<div class=\"dv-info-row\">\n\n<div class=\"dv-icon\">\n⌖\n</div>\n\n\n<div>\n\n<small>\nVenue\n</small>\n\n<strong>\nGame Theory\n</strong>\n\n<span>\nHSR Layout Sector\n</span>\n\n</div>\n\n\n</div>\n\n\n\n\n\n</div>\n\n\n\n\n\n\n\n<div class=\"dv-pass-side\">\n\n\n\n<div class=\"dv-stamp\">\n\nDIVA'S<br>\nDAY<br>\n2026\n\n</div>\n\n\n\n<div class=\"dv-side-text\">\n\nOrganized By<br>\n\n<strong>\nHNDRD\n</strong>\n\n</div>\n\n\n\n</div>\n\n\n\n\n\n</div>\n\n\n\n\n</div>\n\n\n</section>",
        "color_scheme": "scheme-1183aca3-ab12-4774-abf0-fce114e24f29",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_V6VAFT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{{ 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@400;500;600&display=swap' | stylesheet_tag }}\n\n<div class=\"dd-section\">\n  <div class=\"dd-inner\">\n\n    <div class=\"dd-heading\">\n      <p class=\"dd-eyebrow\">You're invited to</p>\n      <h2 class=\"dd-title\">Diva Day</h2>\n      <p class=\"dd-subtitle\">A day made for you — dance it out, smash a shuttle, and unwind with your girls</p>\n    </div>\n\n    <div class=\"dd-line\" aria-hidden=\"true\"></div>\n\n    <div class=\"dd-row\">\n\n      <div class=\"dd-card dd-card--1\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag\">\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">I</span>\n          <span class=\"dd-icon\">💃</span>\n          <h3 class=\"dd-tag-title\">Workout with<br>Zumba</h3>\n          <span class=\"dd-corner dd-corner--tl\" aria-hidden=\"true\"></span>\n          <span class=\"dd-corner dd-corner--br\" aria-hidden=\"true\"></span>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--2\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag\">\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">II</span>\n          <span class=\"dd-icon\">🏸</span>\n          <h3 class=\"dd-tag-title\">Play<br>Badminton</h3>\n          <span class=\"dd-corner dd-corner--tl\" aria-hidden=\"true\"></span>\n          <span class=\"dd-corner dd-corner--br\" aria-hidden=\"true\"></span>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--3\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag\">\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">III</span>\n          <span class=\"dd-icon\">🎁</span>\n          <h3 class=\"dd-tag-title\">Freebies and<br>Goodies for All</h3>\n          <span class=\"dd-corner dd-corner--tl\" aria-hidden=\"true\"></span>\n          <span class=\"dd-corner dd-corner--br\" aria-hidden=\"true\"></span>\n        </div>\n      </div>\n\n      <div class=\"dd-card dd-card--4\">\n        <span class=\"dd-thread\" aria-hidden=\"true\"></span>\n        <div class=\"dd-tag\">\n          <span class=\"dd-hole\"></span>\n          <span class=\"dd-numeral\">IV</span>\n          <span class=\"dd-icon\">🎶</span>\n          <h3 class=\"dd-tag-title\">Music and<br>Coffee</h3>\n          <span class=\"dd-corner dd-corner--tl\" aria-hidden=\"true\"></span>\n          <span class=\"dd-corner dd-corner--br\" aria-hidden=\"true\"></span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  .dd-section{\n    background:#ECD4D0;\n    padding:90px 24px 110px;\n    position:relative;\n    overflow:hidden;\n  }\n  .dd-section::before{\n    content:\"\";\n    position:absolute;\n    top:-120px; right:-120px;\n    width:320px; height:320px;\n    border-radius:50%;\n    background:radial-gradient(circle, rgba(184,137,95,0.16) 0%, rgba(184,137,95,0) 70%);\n    pointer-events:none;\n  }\n  .dd-section::after{\n    content:\"\";\n    position:absolute;\n    bottom:-140px; left:-100px;\n    width:300px; height:300px;\n    border-radius:50%;\n    background:radial-gradient(circle, rgba(74,25,66,0.08) 0%, rgba(74,25,66,0) 70%);\n    pointer-events:none;\n  }\n  .dd-inner{\n    max-width:1180px;\n    margin:0 auto;\n    position:relative;\n    z-index:1;\n  }\n\n  .dd-heading{\n    text-align:center;\n    margin-bottom:56px;\n  }\n  .dd-eyebrow{\n    font-family:'Jost',sans-serif;\n    font-size:13px;\n    letter-spacing:0.28em;\n    text-transform:uppercase;\n    color:#A85C6B;\n    font-weight:500;\n    margin:0 0 10px;\n  }\n  .dd-title{\n    font-family:'Playfair Display',serif;\n    font-style:italic;\n    font-weight:700;\n    font-size:clamp(46px, 7vw, 78px);\n    color:#4A1942;\n    margin:0 0 14px;\n    line-height:1.05;\n  }\n  .dd-subtitle{\n    font-family:'Jost',sans-serif;\n    font-size:16px;\n    color:#7A5B63;\n    max-width:440px;\n    margin:0 auto;\n    line-height:1.6;\n    font-weight:400;\n  }\n\n  .dd-line{\n    height:1px;\n    background:linear-gradient(90deg, rgba(184,137,95,0) 0%, #B8895F 15%, #B8895F 85%, rgba(184,137,95,0) 100%);\n    max-width:920px;\n    margin:0 auto 0;\n    position:relative;\n  }\n\n  .dd-row{\n    display:flex;\n    justify-content:center;\n    align-items:flex-start;\n    gap:34px;\n    max-width:1080px;\n    margin:0 auto;\n    flex-wrap:wrap;\n  }\n\n  .dd-card{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    width:225px;\n  }\n  .dd-card--1{ margin-top:0; }\n  .dd-card--2{ margin-top:34px; }\n  .dd-card--3{ margin-top:0; }\n  .dd-card--4{ margin-top:34px; }\n\n  .dd-thread{\n    width:1px;\n    height:30px;\n    background:#B8895F;\n  }\n  .dd-card--2 .dd-thread,\n  .dd-card--4 .dd-thread{\n    height:30px;\n    margin-top:0;\n  }\n\n  .dd-tag{\n    position:relative;\n    width:100%;\n    background:#FBF3EE;\n    border:1px solid #D9B99F;\n    border-radius:14px 14px 6px 6px;\n    padding:38px 22px 34px;\n    text-align:center;\n    box-shadow:0 18px 34px rgba(74,25,66,0.10);\n  }\n\n  .dd-hole{\n    position:absolute;\n    top:-13px; left:50%;\n    transform:translateX(-50%);\n    width:16px; height:16px;\n    border-radius:50%;\n    background:#ECD4D0;\n    border:1px solid #B8895F;\n  }\n\n  .dd-numeral{\n    display:block;\n    font-family:'Playfair Display',serif;\n    font-style:italic;\n    font-weight:600;\n    font-size:15px;\n    color:#B8895F;\n    letter-spacing:0.08em;\n    margin-bottom:14px;\n  }\n\n  .dd-icon{\n    display:block;\n    font-size:34px;\n    line-height:1;\n    margin-bottom:16px;\n  }\n\n  .dd-tag-title{\n    font-family:'Playfair Display',serif;\n    font-weight:600;\n    font-size:19px;\n    color:#4A1942;\n    line-height:1.35;\n    margin:0;\n  }\n\n  .dd-corner{\n    position:absolute;\n    width:10px; height:10px;\n    border:1px solid #B8895F;\n    opacity:0.7;\n  }\n  .dd-corner--tl{\n    top:8px; left:8px;\n    border-right:none; border-bottom:none;\n  }\n  .dd-corner--br{\n    bottom:8px; right:8px;\n    border-left:none; border-top:none;\n  }\n\n  @media screen and (max-width:989px){\n    .dd-row{ gap:22px; }\n    .dd-card{ width:47%; min-width:150px; }\n    .dd-card--2, .dd-card--4{ margin-top:22px; }\n  }\n\n  @media screen and (max-width:589px){\n    .dd-section{ padding:64px 18px 74px; }\n    .dd-heading{ margin-bottom:40px; }\n    .dd-row{\n      flex-wrap:nowrap;\n      overflow-x:auto;\n      justify-content:flex-start;\n      gap:16px;\n      padding:6px 6px 16px;\n      scroll-snap-type:x mandatory;\n      -webkit-overflow-scrolling:touch;\n    }\n    .dd-row::-webkit-scrollbar{ display:none; }\n    .dd-card{\n      width:170px;\n      flex:0 0 170px;\n      scroll-snap-align:center;\n      margin-top:0 !important;\n    }\n    .dd-tag{ padding:32px 18px 28px; }\n  }\n</style>",
