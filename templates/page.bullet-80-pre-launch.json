ght:1.4;\n  letter-spacing:.22em;\n  text-transform:uppercase;\n}\n\n.cs-topcopy span{\n  color:var(--cyan);\n  text-shadow:0 0 12px rgba(87,232,255,.25);\n}\n\n/* LONGER DESKTOP RACKET */\n\n.cs-racket{\n  position:relative;\n  width:min(100%,310px);\n  height:700px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  animation:csFloat 5.5s ease-in-out infinite;\n}\n\n.cs-racket:before{\n  content:\"\";\n  position:absolute;\n  width:150%;\n  aspect-ratio:1;\n  border-radius:50%;\n  opacity:.22;\n  filter:blur(34px);\n  background:radial-gradient(\n    circle,\n    rgba(87,232,255,.08),\n    transparent 65%\n  );\n}\n\n.cs-racket:after{\n  content:\"\";\n  position:absolute;\n  bottom:7px;\n  left:50%;\n  width:88px;\n  height:10px;\n  transform:translateX(-50%);\n  border-radius:50%;\n  opacity:.22;\n  filter:blur(12px);\n  background:rgba(87,232,255,.28);\n}\n\n.cs-racket img{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  display:block;\n  object-fit:contain;\n  object-position:center;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n\n.cs-racket-glow{\n  opacity:.14;\n  mix-blend-mode:screen;\n  filter:\n    brightness(.88)\n    contrast(1.02)\n    blur(8px)\n    drop-shadow(0 0 14px rgba(87,232,255,.18));\n  transform:scale(1.008);\n}\n\n.cs-racket-main{\n  opacity:.54;\n  mix-blend-mode:screen;\n  filter:\n    brightness(.92)\n    contrast(1.07)\n    saturate(.8)\n    drop-shadow(0 0 5px rgba(87,232,255,.18))\n    drop-shadow(0 0 12px rgba(87,232,255,.07));\n}\n\n/* LARGER BOTTOM HEADING */\n\n.cs-bottom{\n  position:absolute;\n  bottom:0;\n  left:50%;\n  width:max-content;\n  transform:translateX(-50%);\n  text-align:center;\n}\n\n.cs-bottom-title{\n  color:#eef4f6;\n  font-size:22px;\n  font-weight:600;\n  letter-spacing:.21em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy{\n  margin-top:10px;\n  color:var(--muted);\n  font-size:11px;\n  font-weight:500;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.cs-bottom-copy span{\n  color:var(--cyan);\n  text-shadow:0 0 10px rgba(87,232,255,.2);\n}\n\n/* ANIMATIONS */\n\n@keyframes csFloat{\n  0%,100%{\n    transform:translateY(0);\n  }\n  50%{\n    transform:translateY(-4px);\n  }\n}\n\n@keyframes csSmokeLeft{\n  0%,100%{\n    transform:translate(0,0) scale(1);\n  }\n  50%{\n    transform:translate(32px,-15px) scale(1.06);\n  }\n}\n\n@keyframes csSmokeRight{\n  0%,100%{\n    transform:translate(0,0) scale(1);\n  }\n  50%{\n    transform:translate(-32px,-15px) scale(1.06);\n  }\n}\n\n/* TABLET */\n\n@media(max-width:900px){\n  .center-secret{\n    min-height:750px;\n    padding:36px 14px 42px;\n  }\n\n  .cs-wrap{\n    width:min(820px,100%);\n    grid-template-columns:minmax(160px,1fr) minmax(215px,280px) minmax(160px,1fr);\n    gap:22px 20px;\n  }\n\n  .cs-col{\n    gap:66px;\n  }\n\n  .cs-middle{\n    min-height:660px;\n  }\n\n  .cs-racket{\n    width:min(100%,245px);\n    height:590px;\n  }\n\n  .cs-value{\n    font-size:clamp(21px,3vw,31px);\n  }\n\n  .cs-label{\n    font-size:8px;\n    letter-spacing:.15em;\n  }\n\n  .cs-topcopy{\n    font-size:10px;\n  }\n\n  .cs-bottom-title{\n    font-size:17px;\n  }\n\n  .cs-bottom-copy{\n    font-size:9px;\n  }\n}\n\n/* MOBILE: SPECS REMAIN AROUND THE RACKET */\n\n@media(max-width:640px){\n  .center-secret{\n    min-height:630px;\n    padding:26px 12px 32px;\n  }\n\n  .cs-wrap{\n    width:min(390px,100%);\n    grid-template-columns:\n      minmax(88px,1fr)\n      minmax(112px,132px)\n      minmax(88px,1fr);\n    gap:8px 2px;\n    align-items:center;\n  }\n\n  /* Pull both columns closer toward the racket */\n\n  .cs-col.left{\n    align-items:flex-end;\n    text-align:left;\n    transform:translateX(9px);\n  }\n\n  .cs-col.right{\n    align-items:flex-start;\n    text-align:right;\n    transform:translateX(-9px);\n  }\n\n  .cs-col{\n    gap:54px;\n  }\n\n  .cs-card{\n    width:100%;\n    max-width:104px;\n  }\n\n  .cs-col.right .cs-card{\n    margin-left:0;\n  }\n\n  .cs-middle{\n    grid-column:2;\n    grid-row:1;\n    min-height:560px;\n  }\n\n  .cs-racket{\n    width:100%;\n    max-width:132px;\n    height:480px;\n  }\n\n  /* Larger mobile heading */\n\n  .cs-topcopy{\n    top:2px;\n    font-size:8px;\n    font-weight:500;\n    letter-spacing:.1em;\n    line-height:1.45;\n  }\n\n  .cs-value{\n    min-height:25px;\n    gap:3px;\n    font-size:clamp(14px,4.2vw,18px);\n    letter-spacing:0;\n  }\n\n  .cs-col.right .cs-value{\n    justify-content:flex-end;\n  }\n\n  .cs-label{\n    margin-top:7px;\n    font-size:6px;\n    letter-spacing:.07em;\n    line-height:1.35;\n    white-space:normal;\n  }\n\n  .cs-number[data-spec=\"thickness\"]{\n    width:3.15ch;\n  }\n\n  .cs-number[data-spec=\"tension\"]{\n    width:2.1ch;\n  }\n\n  .cs-number[data-spec=\"balance\"]{\n    width:3.2ch;\n  }\n\n  .cs-bottom{\n    bottom:2px;\n  }\n\n  /* Larger mobile bottom heading */\n\n  .cs-bottom-title{\n    font-size:13px;\n    letter-spacing:.11em;\n  }\n\n  .cs-bottom-copy{\n    margin-top:6px;\n    font-size:7px;\n    letter-spacing:.09em;\n  }\n\n  .cs-smoke{\n    width:210px;\n    height:120px;\n    opacity:.15;\n  }\n}\n\n/* SMALL MOBILE */\n\n@media(max-width:380px){\n  .center-secret{\n    padding-left:7px;\n    padding-right:7px;\n  }\n\n  .cs-wrap{\n    grid-template-columns:\n      minmax(82px,1fr)\n      minmax(105px,122px)\n      minmax(82px,1fr);\n    gap:5px 0;\n  }\n\n  .cs-col.left{\n    transform:translateX(7px);\n  }\n\n  .cs-col.right{\n    transform:translateX(-7px);\n  }\n\n  .cs-middle{\n    min-height:525px;\n  }\n\n  .cs-racket{\n    max-width:122px;\n    height:450px;\n  }\n\n  .cs-card{\n    max-width:96px;\n  }\n\n  .cs-value{\n    font-size:13px;\n  }\n\n  .cs-label{\n    font-size:5.5px;\n  }\n\n  .cs-topcopy{\n    font-size:7px;\n  }\n\n  .cs-bottom-title{\n    font-size:11px;\n  }\n\n  .cs-bottom-copy{\n    font-size:6px;\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  .center-secret *{\n    animation:none!important;\n  }\n}\n</style>\n\n<section class=\"center-secret\">\n  <div class=\"cs-smoke\"></div>\n  <div class=\"cs-smoke right\"></div>\n\n  <div class=\"cs-wrap\">\n\n    <!-- LEFT SPECIFICATIONS -->\n\n    <div class=\"cs-col left\">\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"thickness\">4.8</span>\n          <span class=\"cs-unit\">MM</span>\n        </div>\n        <div class=\"cs-label\">Frame Thickness</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"tension\">32</span>\n          <span class=\"cs-unit\">LBS</span>\n        </div>\n        <div class=\"cs-label\">Max Tension</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"balance\">297</span>\n          <span class=\"cs-unit\">MM</span>\n        </div>\n        <div class=\"cs-label\">Balance Point</div>\n      </article>\n\n    </div>\n\n    <!-- CENTER RACKET -->\n\n    <div class=\"cs-middle\">\n\n      <div class=\"cs-topcopy\">\n        Performance Profile\n        <span>Remains Encrypted</span>\n      </div>\n\n      <div class=\"cs-racket\">\n        <img\n          class=\"cs-racket-glow\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\"\n          alt=\"\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n\n        <img\n          class=\"cs-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\"\n          alt=\"Secret badminton racket silhouette\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n\n      <div class=\"cs-bottom\">\n        <div class=\"cs-bottom-title\">\n          Specifications Classified\n        </div>\n\n        <div class=\"cs-bottom-copy\">\n          Final performance data\n          <span>stays hidden</span>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- RIGHT FEATURES -->\n\n    <div class=\"cs-col right\">\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-feature\" data-cycle> X </span>\n          <span class=\"cs-unit\">-WRAP</span>\n        </div>\n        <div class=\"cs-label\">Handle System</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">HEAD-</span>\n          <span class=\"cs-feature\" data-cycle> X </span>\n        </div>\n        <div class=\"cs-label\">Stability Tech</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">POWER-</span>\n          <span class=\"cs-feature\" data-cycle> X </span>\n        </div>\n        <div class=\"cs-label\">Energy Transfer</div>\n      </article>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n  if (!section) return;\n\n  const thickness =\n    section.querySelector('[data-spec=\"thickness\"]');\n\n  const tension =\n    section.querySelector('[data-spec=\"tension\"]');\n\n  const balance =\n    section.querySelector('[data-spec=\"balance\"]');\n\n  const featureLetters =\n    section.querySelectorAll(\"[data-cycle]\");\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const randomThickness = () =>\n    (randomInt(40,60) / 10).toFixed(1);\n\n  const swapNumber = (element,value) => {\n    if (!element || element.textContent === String(value)) return;\n\n    element.classList.add(\"changing\");\n\n    setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  setInterval(() => {\n    swapNumber(thickness,randomThickness());\n  },160);\n\n  setInterval(() => {\n    swapNumber(tension,randomInt(20,40));\n  },145);\n\n  setInterval(() => {\n    swapNumber(balance,randomInt(280,310));\n  },155);\n\n  /* X → Y → Z feature animation */\n\n  const characters = [\"X\",\"Y\",\"Z\"];\n\n  featureLetters.forEach((element,index) => {\n    let characterIndex = index % characters.length;\n\n    setInterval(() => {\n      element.classList.add(\"changing\");\n\n      setTimeout(() => {\n        characterIndex =\n          (characterIndex + 1) % characters.length;\n\n        element.textContent =\n          characters[characterIndex];\n\n        element.classList.remove(\"changing\");\n      },70);\n    },360 + index * 45);\n  });\n})();\n</script>",
