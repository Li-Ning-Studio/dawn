      "settings": {
        "custom_liquid": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700&display=swap');\n\n.nitrix-secret{\n  --cyan:#57e8ff;\n  --white:#f1f5f7;\n  --muted:#849198;\n  position:relative;\n  overflow:hidden;\n  isolation:isolate;\n  min-height:820px;\n  padding:64px 36px 54px;\n  font-family:\"Oxanium\",sans-serif;\n  color:var(--white);\n  background:\n    radial-gradient(circle at 50% 42%,rgba(54,190,218,.11),transparent 27%),\n    radial-gradient(circle at 10% 90%,rgba(37,153,182,.07),transparent 22%),\n    radial-gradient(circle at 90% 90%,rgba(37,153,182,.07),transparent 22%),\n    linear-gradient(180deg,#030607 0%,#010202 100%);\n}\n\n.ns-smoke{\n  position:absolute;\n  bottom:-100px;\n  left:-110px;\n  width:470px;\n  height:280px;\n  border-radius:50%;\n  pointer-events:none;\n  opacity:.38;\n  filter:blur(48px);\n  background:radial-gradient(\n    circle,\n    rgba(40,181,213,.18),\n    transparent 67%\n  );\n  animation:nsSmokeLeft 9s ease-in-out infinite;\n}\n\n.ns-smoke.right{\n  left:auto;\n  right:-110px;\n  animation:nsSmokeRight 9s ease-in-out infinite;\n}\n\n.ns-layout{\n  position:relative;\n  z-index:2;\n  width:min(1240px,100%);\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:minmax(220px,1fr) minmax(270px,390px) minmax(220px,1fr);\n  gap:42px 58px;\n  align-items:center;\n}\n\n/* SIDE SPECIFICATIONS */\n\n.ns-column{\n  display:flex;\n  flex-direction:column;\n  gap:82px;\n}\n\n.ns-column.left{\n  text-align:left;\n}\n\n.ns-column.right{\n  text-align:right;\n}\n\n.ns-card{\n  position:relative;\n  width:100%;\n}\n\n.ns-value{\n  display:flex;\n  align-items:baseline;\n  gap:9px;\n  min-height:52px;\n  color:#f4f7f8;\n  font-size:clamp(28px,2.7vw,50px);\n  font-weight:500;\n  line-height:1;\n  letter-spacing:.055em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n\n.ns-column.right .ns-value{\n  justify-content:flex-end;\n}\n\n.ns-number{\n  display:inline-block;\n  flex:none;\n  color:var(--cyan);\n  text-align:right;\n  line-height:1;\n  font-variant-numeric:tabular-nums;\n  font-feature-settings:\"tnum\";\n  text-shadow:\n    0 0 7px rgba(87,232,255,.72),\n    0 0 17px rgba(87,232,255,.2);\n  transition:opacity .05s linear;\n}\n\n/* Fixed widths prevent jumping */\n\n.ns-number[data-spec=\"thickness\"]{\n  width:3.2ch;\n}\n\n.ns-number[data-spec=\"tension\"]{\n  width:2.2ch;\n}\n\n.ns-number[data-spec=\"balance\"]{\n  width:3.3ch;\n}\n\n.ns-number.changing{\n  opacity:.3;\n}\n\n.ns-feature{\n  color:var(--cyan);\n  text-shadow:\n    0 0 7px rgba(87,232,255,.66),\n    0 0 16px rgba(87,232,255,.18);\n}\n\n.ns-unit{\n  color:#e8eef0;\n  font-size:.79em;\n}\n\n.ns-label{\n  margin-top:12px;\n  color:var(--muted);\n  font-size:12px;\n  font-weight:500;\n  letter-spacing:.27em;\n  text-transform:uppercase;\n  white-space:nowrap;\n}\n\n/* CENTER */\n\n.ns-center{\n  position:relative;\n  min-height:700px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.ns-lock{\n  position:absolute;\n  top:0;\n  left:50%;\n  transform:translateX(-50%);\n  padding:10px 18px 9px;\n  white-space:nowrap;\n  color:#dff8fc;\n  border:1px solid rgba(87,232,255,.2);\n  background:rgba(3,8,10,.55);\n  box-shadow:\n    inset 0 0 18px rgba(87,232,255,.035),\n    0 0 18px rgba(87,232,255,.04);\n  font-size:11px;\n  font-weight:600;\n  letter-spacing:.3em;\n  text-transform:uppercase;\n}\n\n.ns-racket{\n  position:relative;\n  width:min(100%,270px);\n  height:610px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  animation:nsFloat 5.2s ease-in-out infinite;\n}\n\n.ns-racket:before{\n  content:\"\";\n  position:absolute;\n  width:155%;\n  aspect-ratio:1;\n  border-radius:50%;\n  opacity:.38;\n  filter:blur(32px);\n  background:radial-gradient(\n    circle,\n    rgba(87,232,255,.10),\n    transparent 64%\n  );\n  animation:nsAura 4.5s ease-in-out infinite;\n}\n\n.ns-racket:after{\n  content:\"\";\n  position:absolute;\n  bottom:15px;\n  left:50%;\n  width:90px;\n  height:11px;\n  transform:translateX(-50%);\n  border-radius:50%;\n  opacity:.3;\n  filter:blur(13px);\n  background:rgba(87,232,255,.35);\n}\n\n.ns-racket img{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  display:block;\n  object-fit:contain;\n  object-position:center;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n\n.ns-racket-glow{\n  opacity:.2;\n  mix-blend-mode:screen;\n  filter:\n    brightness(.9)\n    contrast(1.03)\n    blur(8px)\n    drop-shadow(0 0 16px rgba(87,232,255,.25));\n  transform:scale(1.01);\n}\n\n.ns-racket-main{\n  opacity:.58;\n  mix-blend-mode:screen;\n  filter:\n    brightness(.92)\n    contrast(1.08)\n    saturate(.82)\n    drop-shadow(0 0 7px rgba(87,232,255,.24))\n    drop-shadow(0 0 16px rgba(87,232,255,.1));\n}\n\n.ns-bottom{\n  position:absolute;\n  bottom:0;\n  left:50%;\n  width:max-content;\n  transform:translateX(-50%);\n  text-align:center;\n}\n\n.ns-bottom-title{\n  color:#eef4f6;\n  font-size:clamp(16px,1.5vw,22px);\n  font-weight:600;\n  letter-spacing:.25em;\n  text-transform:uppercase;\n}\n\n.ns-bottom-copy{\n  margin-top:9px;\n  color:var(--muted);\n  font-size:10px;\n  letter-spacing:.26em;\n  text-transform:uppercase;\n}\n\n.ns-bottom-copy span{\n  color:var(--cyan);\n}\n\n/* ANIMATIONS */\n\n@keyframes nsFloat{\n  0%,100%{\n    transform:translateY(0);\n  }\n  50%{\n    transform:translateY(-5px);\n  }\n}\n\n@keyframes nsAura{\n  0%,100%{\n    opacity:.28;\n    transform:scale(.97);\n  }\n  50%{\n    opacity:.44;\n    transform:scale(1.025);\n  }\n}\n\n@keyframes nsSmokeLeft{\n  0%,100%{\n    transform:translate(0,0) scale(1);\n  }\n  50%{\n    transform:translate(35px,-18px) scale(1.08);\n  }\n}\n\n@keyframes nsSmokeRight{\n  0%,100%{\n    transform:translate(0,0) scale(1);\n  }\n  50%{\n    transform:translate(-35px,-18px) scale(1.08);\n  }\n}\n\n/* TABLET */\n\n@media(max-width:980px){\n  .nitrix-secret{\n    min-height:720px;\n    padding:48px 18px 44px;\n  }\n\n  .ns-layout{\n    grid-template-columns:minmax(160px,1fr) minmax(220px,300px) minmax(160px,1fr);\n    gap:28px 20px;\n  }\n\n  .ns-column{\n    gap:62px;\n  }\n\n  .ns-center{\n    min-height:610px;\n  }\n\n  .ns-racket{\n    width:min(100%,225px);\n    height:520px;\n  }\n\n  .ns-value{\n    font-size:clamp(21px,3.2vw,34px);\n  }\n\n  .ns-label{\n    font-size:9px;\n    letter-spacing:.18em;\n  }\n}\n\n/* MOBILE */\n\n@media(max-width:640px){\n  .nitrix-secret{\n    min-height:auto;\n    padding:34px 12px 40px;\n  }\n\n  .ns-layout{\n    grid-template-columns:1fr 1fr;\n    gap:32px 18px;\n  }\n\n  .ns-center{\n    grid-column:1/-1;\n    grid-row:1;\n    min-height:470px;\n  }\n\n  .ns-racket{\n    width:min(100%,190px);\n    height:400px;\n  }\n\n  .ns-lock{\n    padding:8px 11px 7px;\n    font-size:8px;\n    letter-spacing:.18em;\n  }\n\n  .ns-column{\n    gap:34px;\n  }\n\n  .ns-column.right{\n    text-align:left;\n  }\n\n  .ns-column.right .ns-value{\n    justify-content:flex-start;\n  }\n\n  .ns-value{\n    min-height:28px;\n    gap:4px;\n    font-size:clamp(17px,5vw,23px);\n    letter-spacing:.01em;\n  }\n\n  .ns-label{\n    margin-top:8px;\n    font-size:7px;\n    letter-spacing:.1em;\n    white-space:normal;\n  }\n\n  .ns-number[data-spec=\"thickness\"]{\n    width:3.15ch;\n  }\n\n  .ns-number[data-spec=\"tension\"]{\n    width:2.1ch;\n  }\n\n  .ns-number[data-spec=\"balance\"]{\n    width:3.2ch;\n  }\n\n  .ns-bottom-title{\n    font-size:11px;\n    letter-spacing:.13em;\n  }\n\n  .ns-bottom-copy{\n    margin-top:6px;\n    font-size:7px;\n    letter-spacing:.11em;\n  }\n\n  .ns-smoke{\n    width:260px;\n    height:150px;\n    opacity:.28;\n  }\n}\n\n@media(prefers-reduced-motion:reduce){\n  .nitrix-secret *{\n    animation:none!important;\n  }\n}\n</style>\n\n<section class=\"nitrix-secret\">\n  <div class=\"ns-smoke\"></div>\n  <div class=\"ns-smoke right\"></div>\n\n  <div class=\"ns-layout\">\n\n    <!-- LEFT SPECS -->\n\n    <div class=\"ns-column left\">\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-number\" data-spec=\"thickness\">5.4</span>\n          <span class=\"ns-unit\">MM</span>\n        </div>\n        <div class=\"ns-label\">Frame Thickness</div>\n      </article>\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-number\" data-spec=\"tension\">32</span>\n          <span class=\"ns-unit\">LBS</span>\n        </div>\n        <div class=\"ns-label\">Max Tension</div>\n      </article>\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-number\" data-spec=\"balance\">300</span>\n          <span class=\"ns-unit\">MM</span>\n        </div>\n        <div class=\"ns-label\">Balance Point</div>\n      </article>\n\n    </div>\n\n    <!-- CENTER RACKET -->\n\n    <div class=\"ns-center\">\n\n      <div class=\"ns-lock\">Power Signature Locked</div>\n\n      <div class=\"ns-racket\">\n        <img\n          class=\"ns-racket-glow\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\"\n          alt=\"\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n\n        <img\n          class=\"ns-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\"\n          alt=\"Secret badminton racket silhouette\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n\n      <div class=\"ns-bottom\">\n        <div class=\"ns-bottom-title\">\n          Specifications Classified\n        </div>\n\n        <div class=\"ns-bottom-copy\">\n          Performance profile\n          <span>remains encrypted</span>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- RIGHT FEATURES -->\n\n    <div class=\"ns-column right\">\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-feature\">X</span>\n          <span class=\"ns-unit\">-WRAP</span>\n        </div>\n        <div class=\"ns-label\">Handle System</div>\n      </article>\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-unit\">HEAD-</span>\n          <span class=\"ns-feature\">X</span>\n        </div>\n        <div class=\"ns-label\">Stability Tech</div>\n      </article>\n\n      <article class=\"ns-card\">\n        <div class=\"ns-value\">\n          <span class=\"ns-unit\">POWER-</span>\n          <span class=\"ns-feature\">X</span>\n        </div>\n        <div class=\"ns-label\">Energy Transfer</div>\n      </article>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n  if (!section) return;\n\n  const thickness =\n    section.querySelector('[data-spec=\"thickness\"]');\n\n  const tension =\n    section.querySelector('[data-spec=\"tension\"]');\n\n  const balance =\n    section.querySelector('[data-spec=\"balance\"]');\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const update = (element,value) => {\n    if (!element || element.textContent === String(value)) return;\n\n    element.classList.add(\"changing\");\n\n    setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  setInterval(() => {\n    update(\n      thickness,\n      (randomInt(40,60) / 10).toFixed(1)\n    );\n  },160);\n\n  setInterval(() => {\n    update(tension,randomInt(20,40));\n  },145);\n\n  setInterval(() => {\n    update(balance,randomInt(280,310));\n  },155);\n})();\n</script>",
