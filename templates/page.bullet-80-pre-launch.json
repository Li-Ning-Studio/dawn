 <div class=\"cs-topcopy\">\n    Performance Profile\n    <span>Remains Encrypted</span>\n  </div>\n\n  <div class=\"cs-wrap\">\n\n    <div class=\"cs-col left\">\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"thickness\">4.8</span>\n          <span class=\"cs-unit\">MM</span>\n        </div>\n        <div class=\"cs-label\">Frame Thickness</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"tension\">32</span>\n          <span class=\"cs-unit\">LBS</span>\n        </div>\n        <div class=\"cs-label\">Max Tension</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-number\" data-spec=\"balance\">297</span>\n          <span class=\"cs-unit\">MM</span>\n        </div>\n        <div class=\"cs-label\">Balance Point</div>\n      </article>\n    </div>\n\n    <div class=\"cs-middle\">\n      <div class=\"cs-racket\">\n        <img\n          class=\"cs-racket-main\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/ChatGPT_Image_Aug_4_2026_01_01_27_PM.png?v=1785828725\"\n          alt=\"Secret badminton racket\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </div>\n    </div>\n\n    <div class=\"cs-col right\">\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-feature\" data-cycle>X</span>\n          <span class=\"cs-unit\">-WRAP</span>\n        </div>\n        <div class=\"cs-label\">Handle System</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">HEAD-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n        <div class=\"cs-label\">Stability Tech</div>\n      </article>\n\n      <article class=\"cs-card\">\n        <div class=\"cs-value\">\n          <span class=\"cs-unit\">POWER-</span>\n          <span class=\"cs-feature\" data-cycle>X</span>\n        </div>\n        <div class=\"cs-label\">Energy Transfer</div>\n      </article>\n    </div>\n\n  </div>\n\n  <div class=\"cs-bottom\">\n    <div class=\"cs-bottom-title\">\n      Specifications Classified\n    </div>\n\n    <div class=\"cs-bottom-copy\">\n      Final performance data\n      <span>stays hidden</span>\n    </div>\n  </div>\n\n</section>\n\n<script>\n(() => {\n  const section = document.currentScript.previousElementSibling;\n  if (!section || section.dataset.initialized) return;\n\n  section.dataset.initialized = \"true\";\n\n  const thickness = section.querySelector('[data-spec=\"thickness\"]');\n  const tension = section.querySelector('[data-spec=\"tension\"]');\n  const balance = section.querySelector('[data-spec=\"balance\"]');\n  const featureLetters = section.querySelectorAll(\"[data-cycle]\");\n\n  const randomInt = (min,max) =>\n    Math.floor(Math.random() * (max - min + 1)) + min;\n\n  const randomThickness = () =>\n    (randomInt(40,60) / 10).toFixed(1);\n\n  const swapNumber = (element,value) => {\n    if (!element || element.textContent === String(value)) return;\n\n    element.classList.add(\"changing\");\n\n    window.setTimeout(() => {\n      element.textContent = value;\n      element.classList.remove(\"changing\");\n    },35);\n  };\n\n  let numberTimers = [];\n  let letterTimers = [];\n\n  const startAnimations = () => {\n    if (numberTimers.length || letterTimers.length) return;\n\n    numberTimers.push(\n      window.setInterval(() => {\n        swapNumber(thickness,randomThickness());\n      },160),\n\n      window.setInterval(() => {\n        swapNumber(tension,randomInt(20,40));\n      },145),\n\n      window.setInterval(() => {\n        swapNumber(balance,randomInt(280,310));\n      },155)\n    );\n\n    const characters = [\"X\",\"Y\",\"Z\"];\n\n    featureLetters.forEach((element,index) => {\n      let characterIndex = index % characters.length;\n\n      const timer = window.setInterval(() => {\n        element.classList.add(\"changing\");\n\n        window.setTimeout(() => {\n          characterIndex = (characterIndex + 1) % characters.length;\n          element.textContent = characters[characterIndex];\n          element.classList.remove(\"changing\");\n        },65);\n      },380 + index * 45);\n\n      letterTimers.push(timer);\n    });\n  };\n\n  const stopAnimations = () => {\n    numberTimers.forEach(clearInterval);\n    letterTimers.forEach(clearInterval);\n    numberTimers = [];\n    letterTimers = [];\n  };\n\n  const observer = new IntersectionObserver(entries => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) startAnimations();\n      else stopAnimations();\n    });\n  },{threshold:.08});\n\n  observer.observe(section);\n})();\n</script>",
