         <div class=\"hxad-event\">\n\n            <div class=\"hxad-event-when\">\n\n              <div class=\"hxad-event-date\">\n                22\n              </div>\n\n              <div class=\"hxad-event-time\">\n                7–9<br>AM\n              </div>\n\n            </div>\n\n\n            <div class=\"hxad-event-venue\">\n              Professional Shuttlers Badminton Academy\n            </div>\n\n\n            <a\n              class=\"hxad-event-go\"\n              href=\"https://share.google/F7wcvEpFj7g6xLLvH\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              aria-label=\"Get directions\"\n            >\n\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n              >\n                <path d=\"M7 17L17 7M7 7h10v10\"/>\n              </svg>\n\n            </a>\n\n          </div>\n\n\n\n          <div class=\"hxad-event\">\n\n            <div class=\"hxad-event-when\">\n\n              <div class=\"hxad-event-date\">\n                22\n              </div>\n\n              <div class=\"hxad-event-time\">\n                4–6<br>PM\n              </div>\n\n            </div>\n\n\n            <div class=\"hxad-event-venue\">\n              Professional Shuttlers Badminton Academy\n            </div>\n\n\n            <a\n              class=\"hxad-event-go\"\n              href=\"https://share.google/F7wcvEpFj7g6xLLvH\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              aria-label=\"Get directions\"\n            >\n\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n              >\n                <path d=\"M7 17L17 7M7 7h10v10\"/>\n              </svg>\n\n            </a>\n\n          </div>\n\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- ========================================================\n         JALANDHAR\n    ========================================================= -->\n\n    <article\n      class=\"hxad-card\"\n      data-idx=\"4\"\n    >\n\n      <div class=\"hxad-inner\">\n\n        <div class=\"hxad-glare\"></div>\n\n        <span class=\"hxad-badge\">\n          05/05\n        </span>\n\n        <h3 class=\"hxad-city\">\n          Jalandhar\n        </h3>\n\n        <p class=\"hxad-range\">\n          24–25 Sep · 2 Sessions\n        </p>\n\n\n        <div class=\"hxad-events\">\n\n\n          <div class=\"hxad-event\">\n\n            <div class=\"hxad-event-when\">\n\n              <div class=\"hxad-event-date\">\n                24\n              </div>\n\n              <div class=\"hxad-event-time\">\n                6–8<br>PM\n              </div>\n\n            </div>\n\n\n            <div class=\"hxad-event-venue\">\n              Raizada Hansraj Badminton Stadium\n            </div>\n\n\n            <a\n              class=\"hxad-event-go\"\n              href=\"https://share.google/MBMdm12HNEJ2XG3eB\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              aria-label=\"Get directions\"\n            >\n\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n              >\n                <path d=\"M7 17L17 7M7 7h10v10\"/>\n              </svg>\n\n            </a>\n\n          </div>\n\n\n\n          <div class=\"hxad-event\">\n\n            <div class=\"hxad-event-when\">\n\n              <div class=\"hxad-event-date\">\n                25\n              </div>\n\n              <div class=\"hxad-event-time\">\n                6–8<br>PM\n              </div>\n\n            </div>\n\n\n            <div class=\"hxad-event-venue\">\n              Raizada Hansraj Badminton Stadium\n            </div>\n\n\n            <a\n              class=\"hxad-event-go\"\n              href=\"https://share.google/MBMdm12HNEJ2XG3eB\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              aria-label=\"Get directions\"\n            >\n\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n              >\n                <path d=\"M7 17L17 7M7 7h10v10\"/>\n              </svg>\n\n            </a>\n\n          </div>\n\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n  </div>\n\n</div>\n\n\n<script>\n\n(function () {\n\n  var root =\n    document.getElementById(\n      \"hndrd-punjab-tour\"\n    );\n\n  if (!root) return;\n\n\n  var cards =\n    Array.prototype.slice.call(\n      root.querySelectorAll(\n        \".hxad-card\"\n      )\n    );\n\n\n  var canHover =\n    window.matchMedia &&\n    window.matchMedia(\n      \"(pointer: fine)\"\n    ).matches;\n\n\n  /* ============================================================\n     ENTRANCE ANIMATION\n  ============================================================= */\n\n  if (\"IntersectionObserver\" in window) {\n\n    var observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (\n                entry.isIntersecting\n              ) {\n\n                var index =\n                  parseInt(\n                    entry.target.getAttribute(\n                      \"data-idx\"\n                    ),\n                    10\n                  ) || 0;\n\n\n                entry.target.style.transitionDelay =\n                  (index * 80) + \"ms\";\n\n\n                entry.target.classList.add(\n                  \"hxad-in\"\n                );\n\n\n                observer.unobserve(\n                  entry.target\n                );\n\n              }\n\n            }\n          );\n\n        },\n\n        {\n          threshold: .12,\n          rootMargin:\n            \"0px 0px -25px 0px\"\n        }\n\n      );\n\n\n    cards.forEach(\n      function (card) {\n\n        observer.observe(card);\n\n      }\n    );\n\n  }\n\n  else {\n\n    cards.forEach(\n      function (card) {\n\n        card.classList.add(\n          \"hxad-in\"\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* ============================================================\n     DESKTOP 3D TILT\n  ============================================================= */\n\n  cards.forEach(\n\n    function (card) {\n\n      var inner =\n        card.querySelector(\n          \".hxad-inner\"\n        );\n\n\n      if (!inner) return;\n\n\n      if (canHover) {\n\n\n        card.addEventListener(\n\n          \"pointermove\",\n\n          function (event) {\n\n            var rect =\n              card.getBoundingClientRect();\n\n\n            var x =\n              (\n                event.clientX -\n                rect.left\n              ) / rect.width;\n\n\n            var y =\n              (\n                event.clientY -\n                rect.top\n              ) / rect.height;\n\n\n            var rotateY =\n              (x - .5) * 10;\n\n\n            var rotateX =\n              (.5 - y) * 8;\n\n\n            inner.style.transition =\n              \"none\";\n\n\n            inner.style.transform =\n              \"rotateX(\" +\n              rotateX +\n              \"deg) rotateY(\" +\n              rotateY +\n              \"deg)\";\n\n\n            inner.style.setProperty(\n              \"--mx\",\n              (x * 100) + \"%\"\n            );\n\n\n            inner.style.setProperty(\n              \"--my\",\n              (y * 100) + \"%\"\n            );\n\n          }\n\n        );\n\n\n        card.addEventListener(\n\n          \"pointerleave\",\n\n          function () {\n\n            inner.style.transition =\n              \"transform .5s cubic-bezier(.2,.8,.2,1)\";\n\n\n            inner.style.transform =\n              \"rotateX(0deg) rotateY(0deg)\";\n\n          }\n\n        );\n\n      }\n\n    }\n\n  );\n\n})();\n\n</script>\n\n</section>",
