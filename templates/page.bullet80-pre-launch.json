ter;\n  justify-content:center;\n}\n\n.be-product::before{\n  content:\"\";\n  position:absolute;\n  top:50%;\n  left:50%;\n  width:390px;\n  height:390px;\n  border:1px solid rgba(128,239,255,.11);\n  border-radius:50%;\n  transform:translate(-50%,-50%);\n  box-shadow:\n    0 0 0 70px rgba(128,239,255,.018),\n    0 0 90px rgba(24,142,162,.12);\n}\n\n.be-racket{\n  position:relative;\n  z-index:2;\n  display:block;\n  width:440px;\n  max-width:none;\n  height:auto;\n  object-fit:contain;\n  filter:brightness(1.13) contrast(1.1) saturate(.68) drop-shadow(0 34px 40px rgba(0,0,0,.45));\n  animation:beFloat 6s ease-in-out infinite;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n\n.be-footer{\n  width:min(760px,100%);\n  margin:70px auto 0;\n  text-align:center;\n}\n\n.be-footer-line{\n  width:70px;\n  height:1px;\n  margin:0 auto 22px;\n  background:var(--accent);\n  box-shadow:0 0 14px rgba(128,239,255,.6);\n}\n\n.be-footer-title{\n  margin:0;\n  color:#fff;\n  font-size:clamp(18px,2vw,26px);\n  font-weight:500;\n  line-height:1.3;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n\n.be-footer-copy{\n  margin:12px 0 0;\n  color:#7f8b90;\n  font-size:10px;\n  font-weight:500;\n  line-height:1.5;\n  letter-spacing:.19em;\n  text-transform:uppercase;\n}\n\n@keyframes beFloat{\n  0%,100%{transform:translateY(0)}\n  50%{transform:translateY(-9px)}\n}\n\n@media(max-width:980px){\n  .bullet-engineering{padding:78px 18px 68px}\n  .be-header{margin-bottom:50px}\n  .be-layout{\n    min-height:630px;\n    grid-template-columns:minmax(190px,1fr) minmax(280px,340px) minmax(190px,1fr);\n    gap:24px 20px;\n  }\n  .be-product{min-height:630px}\n  .be-product::before{width:300px;height:300px}\n  .be-racket{width:350px}\n  .be-card{min-height:136px;padding:21px 18px 19px}\n  .be-copy{font-size:10px}\n}\n\n@media(max-width:720px){\n  .bullet-engineering{padding:64px 16px 56px}\n  .bullet-engineering::before{background-size:52px 52px}\n  .be-header{ma