der-radius:18px;\n  background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));\n  box-shadow:0 22px 70px rgba(0,0,0,.2);\n  backdrop-filter:blur(10px);\n  -webkit-backdrop-filter:blur(10px);\n  transition:transform .35s ease,border-color .35s ease,background .35s ease;\n}\n\n.be-card::before{\n  content:\"\";\n  position:absolute;\n  top:0;\n  width:58px;\n  height:1px;\n  background:var(--accent);\n  box-shadow:0 0 14px rgba(128,239,255,.7);\n}\n\n.be-specs--left .be-card::before{right:22px}\n.be-specs--right .be-card::before{left:22px}\n\n.be-card:hover{\n  transform:translateY(-4px);\n  border-color:rgba(128,239,255,.28);\n  background:linear-gradient(145deg,rgba(128,239,255,.075),rgba(255,255,255,.02));\n}\n\n.be-specs--left .be-card{text-align:right}\n.be-specs--right .be-card{text-align:left}\n\n.be-value{\n  margin:0;\n  color:#fff;\n  font-size:clamp(21px,2vw,30px);\n  font-weight:600;\n  line-height:1;\n  letter-spacing:-.025em;\n  text-transform:uppercase;\n}\n\n.be-label{\n  margin:10px 0 0;\n  color:var(--accent);\n  font-size:9px;\n  font-weight:600;\n  line-height:1.4;\n  letter-spacing:.2em;\n  text-transform:uppercase;\n}\n\n.be-copy{\n  margin:13px 0 0;\n  color:var(--muted);\n  font-size:11px;\n  font-weight:400;\n  line-height:1.55;\n}\n\n.be-product{\n  position:relative;\n  z-index:2;\n  min-height:650px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.be-product::before{\n  display:none;\n}\n\n.be-racket{\n  position:relative;\n  z-index:2;\n  display:block;\n  width:440px;\n  max-width:none;\n  height:auto;\n  object-fit:contain;\n  filter:brightness(1.13) contrast(1.1) saturate(.68) drop-shadow(0 34px 40px rgba(0,0,0,.45));\n  animation:none;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-drag:none;\n}\n.be-footer{\n  width:min(760px,100%);\n  margin:70px auto 0;\n  text-align:center;\n}\n\n.be-footer-line{\n  width:70px;\n  height:1px;\n  margin:0 auto 22px;\n  background:var(--accent);\n  box-shadow:0 0 14px rgba(128,239,255,.6);\n}\n\n.be-footer-title{\n  margin:0;\n  color:#fff;\n  font-size:clamp(18px,2vw,26px);\n  font-weight:500;\n  line-height:1.3;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n\n.be-footer-copy{\n  margin:12px 0 0;\n  color:#7f8b90;\n  font-size:10px;\n  font-weight:500;\n  line-height:1.5;\n  letter-spacing:.19em;\n  text-transform:uppercase;\n}\n\n@keyframes beFloat{\n  0%,100%{transform:translateY(0)}\n  50%{transform:translateY(-9px)}\n}\n\n@media(max-width:980px){\n  .bullet-engineering{padding:78px 18px 68px}\n  .be-header{margin-bottom:50px}\n  .be-layout{\n    min-height:630px;\n    grid-template-columns:minmax(190px,1fr) minmax(280px,340px) minmax(190px,1fr);\n    gap:24px 20px;\n  }\n  .be-product{min-height:630px}\n  .be-racket{width:350px}\n  .be-card{min-height:136px;padding:21px 18px 19px}\n  .be-copy{font-size:10px}\n}\n\n@media(max-width:720px){\n  .bullet-engineering{padding:64px 16px 56px}\n  .be-header{margin-bottom:18px}\n  .be-eyebrow{margin-bottom:14px;font-size:9px;letter-spacing:.24em}\n  .be-title{font-size:clamp(38px,13vw,58px);line-height:.98}\n  .be-intro{margin-top:18px;font-size:12px;line-height:1.65}\n  .be-layout{\n    min-height:0;\n    display:flex;\n    flex-direction:column;\n    gap:0;\n  }\n  .be-product{\n    order:1;\n    width:100%;\n    min-height:480px;\n  }\n  .be-racket{width:320px}\n  .be-specs{\n    width:100%;\n    display:grid;\n    grid-template-columns:repeat(2,minmax(0,1fr));\n    gap:12px;\n  }\n  .be-specs--left{order:2}\n  .be-specs--right{order:3;margin-top:12px}\n  .be-card,\n  .be-specs--left .be-card,\n  .be-specs--right .be-card{\n    min-height:138px;\n    padding:20px 17px 18px;\n    text-align:left;\n    border-radius:15px;\n  }\n  .be-specs--left .be-card::before,\n  .be-specs--right .be-card::before{right:auto;left:17px}\n  .be-value{font-size:21px}\n  .be-label{font-size:7.5px;letter-spacing:.14em}\n  .be-copy{margin-top:11px;font-size:9.5px;line-height:1.5}\n  .be-footer{margin-top:48px}\n  .be-footer-title{font-size:17px;letter-spacing:.13em}\n  .be-footer-copy{font-size:8px;letter-spacing:.13em}\n}\n\n@media(max-width:420px){\n  .bullet-engineering{padding-left:12px;padding-right:12px}\n  .be-product{min-height:430px}\n  .be-racket{width:285px}\n  .be-card,\n  .be-specs--left .be-card,\n  .be-specs--right .be-card{min-height:142px;padding:18px 14px 16px}\n  .be-value{font-size:18px}\n  .be-copy{font-size:8.8px}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .be-racket{animation:none}\n  .be-card{transition:none}\n}\n</style>\n\n<section class=\"bullet-engineering\" aria-labelledby=\"bullet-engineering-title\">\n  <header class=\"be-header\">\n    <p class=\"be-eyebrow\">Nitrix 80 Bullet Engineering</p>\n    <h2 class=\"be-title\" id=\"bullet-engineering-title\">\n      <strong>5.9 mm</strong> shaft\n    </h2>\n    <p class=\"be-intro\">\n      A thinner, faster shaft engineered to whip through the swing and hold its line at contact.\n    </p>\n  </header>\n\n  <div class=\"be-layout\">\n    <div class=\"be-specs be-specs--left\">\n      <article class=\"be-card\">\n        <h3 class=\"be-value\">T-Fuse</h3>\n        <p class=\"be-label\">Torsion control</p>\n        <p class=\"be-copy\">Controls twisting where the frame meets the shaft, keeping the racket stable through full-power swings.</p>\n      </article>\n\n      <article class=\"be-card\">\n        <h3 class=\"be-value\">CNTRL Foam</h3>\n        <p class=\"be-label\">Impact absorption</p>\n        <p class=\"be-copy\">Foam inside the frame absorbs shock at the point of contact before it reaches the hand.</p>\n      </article>\n\n    </div>\n\n    <div class=\"be-product\">\n      <video\n        class=\"be-racket\"\n        src=\"https://cdn.shopify.com/videos/c/vp/d5ebe429829144c78fd8be7d3df249ba/d5ebe429829144c78fd8be7d3df249ba.HD-1080p-7.2Mbps-91310021.mp4\" autoplay loop\n.\n        alt=\"Nitrix 80 Bullet badminton racket\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\nstyle=\"border-radius:20px;\"\n      >\n    </div>\n\n    <div class=\"be-specs be-specs--right\">\n      <article class=\"be-card\">\n        <h3 class=\"be-value\">Curve²</h3>\n        <p class=\"be-label\">Expanded sweet spot</p>\n        <p class=\"be-copy\">Reshaped frame geometry widens the sweet spot for a larger, cleaner contact zone.</p>\n      </article>\n\n      <article class=\"be-card\">\n        <h3 class=\"be-value\">M46X</h3>\n        <p class=\"be-label\">Responsive carbon</p>\n        <p class=\"be-copy\">Highly refined carbon balances density and responsiveness for immediate feedback on every hit.</p>\n      </article>\n    </div>\n  </div>\n\n  <footer class=\"be-footer\">\n    <div class=\"be-footer-line\" aria-hidden=\"true\"></div>\n    <p class=\"be-footer-title\">Speaks fluent power</p>\n    <p class=\"be-footer-copy\">Force. Power. Attack.</p>\n  </footer>\n</section>",
