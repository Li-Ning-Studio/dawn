background:\n      linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.024)),\n      rgba(0,0,0,0.22);\n    border: 1px solid rgba(255,255,255,0.12);\n  }\n\n  .hn-prime-system__copy-panel {\n    position: absolute;\n    inset: 0;\n    padding: 34px;\n    display: flex;\n    flex-direction: column;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(26px);\n    transition: opacity 0.34s ease, transform 0.44s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .hn-prime-system__copy-panel.is-active {\n    opacity: 1;\n    pointer-events: auto;\n    transform: translateY(0);\n  }\n\n  .hn-prime-system__tag {\n    width: fit-content;\n    min-height: 30px;\n    padding: 9px 13px;\n    border-radius: 999px;\n    color: #ffffff;\n    background: rgba(var(--active-rgb), 0.32);\n    border: 1px solid rgba(var(--active-rgb), 0.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    transition: background 0.45s ease, border-color 0.45s ease;\n  }\n\n  .hn-prime-system__series {\n    margin: 28px 0 0;\n    color: rgba(255,255,255,0.64);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n  }\n\n  .hn-prime-system__copy-panel h3 {\n    margin: 14px 0 0;\n    max-width: 660px;\n    color: #ffffff;\n    font-size: clamp(36px, 4vw, 68px);\n    line-height: 0.9;\n    font-weight: 900;\n    letter-spacing: -0.065em;\n    text-shadow: 0 18px 42px rgba(0,0,0,0.44);\n  }\n\n  .hn-prime-system__body {\n    margin: 18px 0 0;\n    max-width: 580px;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(15px, 1.25vw, 18px);\n    line-height: 1.45;\n    font-weight: 560;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-prime-system__specs {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n    margin-top: 30px;\n  }\n\n  .hn-prime-system__specs div {\n    min-height: 96px;\n    padding: 16px;\n    border-radius: 20