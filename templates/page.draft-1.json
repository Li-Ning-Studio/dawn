ion isMobile() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setVars(unlock, reveal, c1, c2, c3, c4) {\n      section.style.setProperty('--unlock', unlock.toFixed(3));\n      section.style.setProperty('--reveal', reveal.toFixed(3));\n      section.style.setProperty('--card-1', c1.toFixed(3));\n      section.style.setProperty('--card-2', c2.toFixed(3));\n      section.style.setProperty('--card-3', c3.toFixed(3));\n      section.style.setProperty('--card-4', c4.toFixed(3));\n    }\n\n    function updateDesktop() {\n      if (isMobile()) {\n        ticking = false;\n        return;\n      }\n\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n      var rect = section.getBoundingClientRect();\n      var total = Math.max(section.offsetHeight - vh, 1);\n      var progress = clamp(-rect.top / total, 0, 1);\n\n      var unlock = easeInOutSine(clamp((progress - 0.08) / 0.30, 0, 1));\n      var reveal = easeOutCubic(clamp((progress - 0.30) / 0.18, 0, 1));\n\n      var card1 = easeOutCubic(clamp((progress - 0.43) / 0.12, 0, 1));\n      var card2 = easeOutCubic(clamp((progress - 0.49) / 0.12, 0, 1));\n      var card3 = easeOutCubic(clamp((progress - 0.55) / 0.12, 0, 1));\n      var card4 = easeOutCubic(clamp((progress - 0.61) / 0.12, 0, 1));\n\n      setVars(unlock, reveal, card1, card2, card3, card4);\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateDesktop);\n        ticking = true;\n      }\n    }\n\n    if (unlockButton) {\n      unlockButton.addEventListener('click', function () {\n        section.classList.add('is-unlocked');\n        setVars(1, 1, 1, 1, 1, 1);\n      });\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      if (isMobile()) {\n        if (!section.classList.contains('is-unlocked')) {\n          setVars(0, 0, 0, 0, 0, 0);\n        }\n      } else {\n        section.classList.remove('is-unlocked');\n        requestTick();\n      }\n    });\n\n    if (isMobile()) {\n      setVars(0, 0, 0, 0, 0, 0);\n    } else {\n      updateDesktop();\n    }\n  })();\n</script>",
