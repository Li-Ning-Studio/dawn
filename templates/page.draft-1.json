      "settings": {
        "custom_liquid": "<section class=\"hn-duel-upgrade\" id=\"hnDuelUpgrade\" aria-label=\"Prime Trinity to Evolution Series upgrade comparison\">\n\n  <div class=\"hn-duel-upgrade__intro\">\n    <p class=\"hn-duel-upgrade__eyebrow\">Prime Trinity → Evolution Series</p>\n    <h2 class=\"hn-duel-upgrade__main-title\">Same game. New gear ceiling.</h2>\n    <p class=\"hn-duel-upgrade__main-copy\">\n      Three familiar playing styles, rebuilt with sharper speed, heavier response, and cleaner control.\n    </p>\n  </div>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--attack\"\n    data-duel-scene\n    style=\"\n      --accent: #dba20f;\n      --accent-rgb: 219, 162, 15;\n      --side-glow: rgba(219, 162, 15, 0.26);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Nitrix 10</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_fe068018-61b0-4d27-a662-e5df945e4492.png?v=1769778461&width=1200\"\n            alt=\"Nitrix 10 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Nitrix Thunder</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1200\"\n            alt=\"Nitrix Thunder racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__divider\">\n          <span></span>\n        </div>\n\n        <div class=\"hn-duel-upgrade__center-copy\">\n          <p>Attack DNA</p>\n          <h3>Same DNA.<br>More everything.</h3>\n          <small>From quick attacking power to a heavier, cleaner strike.</small>\n        </div>\n      </div>\n\n      <div class=\"hn-duel-upgrade__bottom\">\n        <div>\n          <span>Prime feel</span>\n          <strong>Fast attacking base</strong>\n        </div>\n\n        <a href=\"/products/nitrix-thunder\" class=\"hn-duel-upgrade__cta\">\n          Upgrade to Thunder\n          <span>→</span>\n        </a>\n\n        <div>\n          <span>Evolution gain</span>\n          <strong>32 LBS / Head Heavy / Attack</strong>\n        </div>\n      </div>\n    </div>\n  </article>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--speed\"\n    data-duel-scene\n    style=\"\n      --accent: #2d9fa7;\n      --accent-rgb: 45, 159, 167;\n      --side-glow: rgba(45, 159, 167, 0.26);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Flareon 100</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/Template-01_b87a1cf0-54d3-4771-8cd9-7012109a497c.png?v=1768643121&width=1200\"\n            alt=\"Flareon 100 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Flareon Typhoon</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1200\"\n            alt=\"Flareon Typhoon racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__divider\">\n          <span></span>\n        </div>\n\n        <div class=\"hn-duel-upgrade__center-copy\">\n          <p>Speed DNA</p>\n          <h3>Same DNA.<br>More everything.</h3>\n          <small>From fast handling to storm-level reaction speed.</small>\n        </div>\n      </div>\n\n      <div class=\"hn-duel-upgrade__bottom\">\n        <div>\n          <span>Prime feel</span>\n          <strong>Quick swing control</strong>\n        </div>\n\n        <a href=\"/products/flareon-typhoon\" class=\"hn-duel-upgrade__cta\">\n          Upgrade to Typhoon\n          <span>→</span>\n        </a>\n\n        <div>\n          <span>Evolution gain</span>\n          <strong>32 LBS / Head Light / Speed</strong>\n        </div>\n      </div>\n    </div>\n  </article>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--precision\"\n    data-duel-scene\n    style=\"\n      --accent: #0c8642;\n      --accent-rgb: 12, 134, 66;\n      --side-glow: rgba(12, 134, 66, 0.28);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Hyfonic 1</strong>\n  