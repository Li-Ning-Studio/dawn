hn-duel-upgrade__side--prime::after,\n  .hn-duel-upgrade__side--evo::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 4;\n    pointer-events: none;\n  }\n\n  .hn-duel-upgrade__side--prime::after {\n    background: rgba(0,0,0, calc(.34 + (var(--progress) * .28)));\n  }\n\n  .hn-duel-upgrade__side--evo::after {\n    background:\n      radial-gradient(circle at 50% 48%, rgba(var(--accent-rgb), calc(.06 + (var(--progress) * .14))), transparent 48%);\n  }\n\n  .hn-duel-upgrade__label {\n    position: absolute;\n    z-index: 8;\n    left: clamp(20px, 4vw, 64px);\n    top: clamp(36px, 7vh, 82px);\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    text-transform: uppercase;\n  }\n\n  .hn-duel-upgrade__label--right {\n    left: auto;\n    right: clamp(20px, 4vw, 64px);\n    text-align: right;\n    align-items: flex-end;\n  }\n\n  .hn-duel-upgrade__label span {\n    color: rgba(255,255,255,.48);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .14em;\n  }\n\n  .hn-duel-upgrade__label strong {\n    color: #fff;\n    font-size: clamp(18px, 2.2vw, 34px);\n    line-height: .95;\n    font-weight: 950;\n    letter-spacing: -.055em;\n    text-shadow: 0 12px 34px rgba(0,0,0,.78);\n  }\n\n  .hn-duel-upgrade__label--right span {\n    color: rgba(var(--accent-rgb), .9);\n  }\n\n  .hn-duel-upgrade__racket {\n    position: absolute;\n    z-index: 3;\n    display: block;\n    width: min(82vh, 760px);\n    height: auto;\n    max-width: none;\n    pointer-events: none;\n    user-select: none;\n    will-change: transform, opacity, filter;\n  }\n\n  .hn-duel-upgrade__racket--prime {\n    left: 50%;\n    top: 50%;\n    opacity: calc(.52 - (var(--progress) * .22));\n    filter: grayscale(calc(.72 + (var(--progress) * .28))) saturate(.72) contrast(.92) brightness(.76);\n    transform:\n      translate(-53%, -46%)\n      rotate(-16deg)\n      scale(calc(.82 - (var(--progress) * .055)));\n  }\n\n  .hn-duel-upgrade__racket--evo {\n    right: 50%;\n    top: 50%;\n    opacity: calc(.86 + (var(--progress) * .14));\n    filter: saturate(calc(1.08 + (var(--progress) * .38))) contrast(calc(1.06 + (var(--progress) * .18))) brightness(calc(1.02 + (var(--progress) * .18)));\n    transform:\n      translate(54%, -48%)\n      rotate(-16deg)\n      scale(calc(.94 + (var(--progress) * .14)));\n  }\n\n  .hn-duel-upgrade__divider {\n    position: absolute;\n    z-index: 12;\n    top: 0;\n    left: 50%;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%);\n    background: rgba(255,255,255,.14);\n  }\n\n  .hn-duel-upgrade__divider span {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 3px;\n    height: calc(22vh + (var(--progress) * 58vh));\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(var(--accent-rgb), .2),\n      var(--accent),\n      rgba(255,255,255,.9),\n      var(--accent),\n      rgba(var(--accent-rgb), .2),\n      transparent\n    );\n    box-shadow:\n      0 0 22px rgba(var(--accent-rgb), .72),\n      0 0 48px rgba(var(--accent-rgb), .38);\n  }\n\n  .hn-duel-upgrade__center-copy {\n    position: absolute;\n    z-index: 15;\n    left: 50%;\n    top: 50%;\n    width: min(520px, calc(100% - 40px));\n    transform:\n      translate(-50%, -50%)\n      scale(calc(.96 + (var(--progress) * .04)));\n    text-align: center;\n    pointer-events: none;\n  }\n\n  .hn-duel-upgrade__center-copy p {\n    margin: 0 0 12px;\n    color: var(--accent);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    text-shadow:\n      0 0 18px rgba(var(--accent-rgb), .58),\n      0 10px 30px rgba(0,0,0,.9);\n  }\n\n  .hn-duel-upgrade__center-copy h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(42px, 5.6vw, 92px);\n    line-height: .88;\n    font-weight: 950;\n    letter-spacing: -.075em;\n    text-shadow:\n      0 0 28px rgba(255,255,255,.12),\n      0 18px 50px rgba(0,0,0,.92);\n  }\n\n  .hn-duel-upgrade__center-copy small {\n    display: block;\n    width: min(360px, 100%);\n    margin: 18px auto 0;\n    color: rgba(255,255,255,.8);\n    font-size: clamp(13px, 1vw, 15px);\n    line-height: 1.45;\n    font-weight: 700;\n    letter-spacing: -.015em;\n    text-shadow: 0 10px 28px rgba(0,0,0,.9);\n  }\n\n  .hn-duel-upgrade__bottom {\n    position: absolute;\n    z-index: 20;\n    left: 50%;\n    bottom: clamp(26px, 5vh, 58px);\n    width: min(1120px, calc(100% - 36px));\n    transform: translateX(-50%);\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n    gap: 20px;\n    padding: 14px 16px;\n    border: 1px solid rgba(255,255,255,.12);\n    border-radius: 999px;\n    background: rgba(0,0,0,.34);\n    backdrop-filter: blur(18px);\n    box-shadow:\n      0 20px 60px rgba(0,0,0,.36),\n      inset 0 0 0 1px rgba(255,255,255,.04);\n  }\n\n  .hn-duel-upgrade__bottom div {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n  }\n\n  .hn-duel-upgrade__bottom div:last-child {\n    text-align: right;\n    align-items: flex-end;\n  }\n\n  .hn-duel-upgrade__bottom span {\n    color: rgba(255,255,255,.48);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .hn-duel-upgrade__bottom strong {\n    color: rgba(255,255,255,.92);\n    font-size: clamp(12px, 1vw, 15px);\n    line-height: 1.1;\n    font-weight: 850;\n    letter-spacing: -.02em;\n  }\n\n  .hn-duel-upgrade__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 46px;\n    padding: 0 22px;\n    border-radius: 999px;\n    border: 1.5px solid transparent;\n    background:\n      linear-gradient(#050505, #050505) padding-box,\n      linear-gradient(90deg, rgba(255,255,255,.42), var(--accent), rgba(255,255,25