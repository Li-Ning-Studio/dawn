   letter-spacing: -.018em;\n  }\n\n  .hn-duel-upgrade__scene {\n    --progress: 0;\n    --left-fade: calc(1 - (var(--progress) * .55));\n    --right-push: var(--progress);\n\n    position: relative;\n    height: 185vh;\n    background: #020303;\n  }\n\n  .hn-duel-upgrade__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 700px;\n    overflow: hidden;\n    isolation: isolate;\n    background: #020303;\n  }\n\n  .hn-duel-upgrade__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(circle at 75% 45%, var(--side-glow), transparent 38%),\n      radial-gradient(circle at 25% 45%, rgba(255,255,255,.045), transparent 32%),\n      linear-gradient(90deg, rgba(255,255,255,.035) 0%, transparent 42%, transparent 58%, rgba(255,255,255,.045) 100%),\n      linear-gradient(180deg, #020303 0%, #050706 55%, #020303 100%);\n  }\n\n  .hn-duel-upgrade__bg::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: .2;\n    background:\n      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);\n    background-size: 52px 52px;\n    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 72%);\n  }\n\n  .hn-duel-upgrade__bg::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(90deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.12) 42%, rgba(0,0,0,.12) 58%, rgba(0,0,0,.38) 100%),\n      radial-gradient(circle at 50% 50%, transparent 0%, rgba(0,0,0,.56) 76%);\n  }\n\n  .hn-duel-upgrade__split {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    height: 100%;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .hn-duel-upgrade__side {\n    position: relative;\n    height: 100%;\n    overflow: hidden;\n  }\n\n  .hn-duel-upgrade__side--prime {\n    border-right: 1px solid rgba(255,255,255,.08);\n  }\n\n  .