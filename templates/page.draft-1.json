5,.42)) border-box;\n    color: #fff;\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    box-shadow:\n      0 0 24px rgba(var(--accent-rgb), .24),\n      inset 0 0 0 1px rgba(var(--accent-rgb), .08);\n    transition: transform .25s ease, box-shadow .25s ease, color .25s ease;\n  }\n\n  .hn-duel-upgrade__cta span {\n    color: var(--accent);\n    transition: transform .25s ease;\n  }\n\n  .hn-duel-upgrade__cta:hover {\n    transform: translateY(-2px);\n    color: #fff;\n    box-shadow:\n      0 0 34px rgba(var(--accent-rgb), .42),\n      inset 0 0 0 1px rgba(var(--accent-rgb), .16);\n  }\n\n  .hn-duel-upgrade__cta:hover span {\n    transform: translateX(4px);\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-duel-upgrade__intro {\n      min-height: 52vh;\n      padding: 76px 18px 56px;\n    }\n\n    .hn-duel-upgrade__scene {\n      height: 170svh;\n    }\n\n    .hn-duel-upgrade__sticky {\n      height: 100svh;\n      min-height: 690px;\n    }\n\n    .hn-duel-upgrade__split {\n      grid-template-columns: 1fr;\n      grid-template-rows: 1fr 1fr;\n    }\n\n    .hn-duel-upgrade__side--prime {\n      border-right: 0;\n      border-bottom: 1px solid rgba(255,255,255,.08);\n    }\n\n    .hn-duel-upgrade__divider {\n      top: 50%;\n      left: 0;\n      width: 100%;\n      height: 1px;\n      transform: translateY(-50%);\n    }\n\n    .hn-duel-upgrade__divider span {\n      top: 50%;\n      left: 50%;\n      width: calc(28vw + (var(--progress) * 54vw));\n      height: 3px;\n      transform: translate(-50%, -50%);\n      background: linear-gradient(\n        90deg,\n        transparent,\n        rgba(var(--accent-rgb), .2),\n        var(--accent),\n        rgba(255,255,255,.9),\n        var(--accent),\n        rgba(var(--accent-rgb), .2),\n        transparent\n      );\n    }\n\n    .hn-duel-upgrade__label {\n      left: 18px;\n      top: 22px;\n    }\n\n    .hn-duel-upgrade__label--right {\n      top: auto;\n      right: 18px;\n      bottom: 108px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(68vw, 430px);\n    }\n\n    .hn-duel-upgrade__racket--prime {\n      left: 50%;\n      top: 24%;\n      transform:\n        translate(-52%, -50%)\n        rotate(-18deg)\n        scale(calc(.78 - (var(--progress) * .05)));\n    }\n\n    .hn-duel-upgrade__racket--evo {\n      right: auto;\n      left: 50%;\n      top: 72%;\n      transform:\n        translate(-48%, -50%)\n        rotate(-18deg)\n        scale(calc(.9 + (var(--progress) * .12)));\n    }\n\n    .hn-duel-upgrade__center-copy {\n      top: 50%;\n      width: min(360px, calc(100% - 34px));\n      padding: 16px 14px 18px;\n      border: 1px solid rgba(255,255,255,.1);\n      border-radius: 26px;\n      background: rgba(0,0,0,.36);\n      backdrop-filter: blur(16px);\n    }\n\n    .hn-duel-upgrade__center-copy h3 {\n      font-size: clamp(34px, 10vw, 48px);\n    }\n\n    .hn-duel-upgrade__center-copy small {\n      margin-top: 12px;\n      font-size: 12px;\n    }\n\n    .hn-duel-upgrade__bottom {\n      width: calc(100% - 28px);\n      grid-template-columns: 1fr;\n      gap: 12px;\n      border-radius: 24px;\n      padding: 14px;\n      bottom: 16px;\n      text-align: center;\n    }\n\n    .hn-duel-upgrade__bottom div,\n    .hn-duel-upgrade__bottom div:last-child {\n      text-align: center;\n      align-items: center;\n    }\n\n    .hn-duel-upgrade__cta {\n      width: 100%;\n      min-height: 46px;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-duel-upgrade__sticky {\n      min-height: 650px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(78vw, 390px);\n    }\n\n    .hn-duel-upgrade__label strong {\n      font-size: 20px;\n    }\n\n    .hn-duel-upgrade__bottom strong {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnDuelUpgrade');\n    if (!section || section.dataset.hnDuelReady === 'true') return;\n\n    section.dataset.hnDuelReady = 'true';\n\n    var scenes = Array.prototype.slice.call(section.querySelectorAll('[data-duel-scene]'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function updateScenes() {\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n\n      scenes.forEach(function (scene) {\n        var rect = scene.getBoundingClientRect();\n        var total = Math.max(rect.height - vh, 1);\n        var progress = clamp(-rect.top / total, 0, 1);\n        var eased = easeInOutSine(progress);\n\n        scene.style.setProperty('--progress', eased.toFixed(3));\n      });\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateScenes);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    updateScenes();\n  })();\n</script>",
