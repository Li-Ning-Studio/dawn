      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-prime-system\" id=\"prime-trinity\">\n  <div class=\"hn-prime-system__flow-line\"></div>\n\n  <div class=\"hn-prime-system__inner\">\n\n    <div class=\"hn-prime-system__header\">\n      <p class=\"hn-prime-system__kicker\">Prime Trinity</p>\n\n      <h2 class=\"hn-prime-system__title\">\n        One Game. Three Personalities.\n      </h2>\n\n      <p class=\"hn-prime-system__sub\">\n        Pick the racket that moves the way you think.\n      </p>\n    </div>\n\n    <div\n      class=\"hn-prime-system__experience\"\n      data-active=\"nitrix\"\n      style=\"--active-accent:#E8432A; --active-rgb:232,67,42;\"\n    >\n\n      <div class=\"hn-prime-system__stage\">\n        <div class=\"hn-prime-system__orb\"></div>\n        <div class=\"hn-prime-system__ring hn-prime-system__ring--one\"></div>\n        <div class=\"hn-prime-system__ring hn-prime-system__ring--two\"></div>\n\n        <div class=\"hn-prime-system__visual hn-prime-system__visual--nitrix is-active\" data-hn-prime-visual=\"nitrix\">\n          <!-- Add Nitrix image here later -->\n          <!-- <img src=\"YOUR_NITRIX_IMAGE_LINK\" alt=\"NITRIX 10\"> -->\n        </div>\n\n        <div class=\"hn-prime-system__visual hn-prime-system__visual--flareon\" data-hn-prime-visual=\"flareon\">\n          <!-- Add Flareon image here later -->\n          <!-- <img src=\"YOUR_FLAREON_IMAGE_LINK\" alt=\"FLAREON 100\"> -->\n        </div>\n\n        <div class=\"hn-prime-system__visual hn-prime-system__visual--hyfonic\" data-hn-prime-visual=\"hyfonic\">\n          <!-- Add Hyfonic image here later -->\n          <!-- <img src=\"YOUR_HYFONIC_IMAGE_LINK\" alt=\"HYFONIC 1\"> -->\n        </div>\n\n        <div class=\"hn-prime-system__stage-label\">\n          <span>Current style</span>\n          <strong data-hn-prime-stage-title>Attack</strong>\n        </div>\n      </div>\n\n      <div class=\"hn-prime-system__panel\">\n\n        <div class=\"hn-prime-system__copy-panels\">\n\n          <div class=\"hn-prime-system__copy-panel is-active\" data-hn-prime-copy=\"nitrix\">\n            <span class=\"hn-prime-system__tag\">Attack</span>\n            <p class=\"hn-prime-system__series\">NITRIX 10</p>\n\n            <h3>Attack has a new address.</h3>\n\n            <p class=\"hn-prime-system__body\">\n              For the player who steps forward, takes space, and wants the rally finished early.\n            </p>\n\n            <div class=\"hn-prime-system__specs\">\n              <div>\n                <span>Built around</span>\n                <strong>Superlight Carbon Core</strong>\n              </div>\n              <div>\n                <span>Feels like</span>\n                <strong>Punchy. Whippy. Front-foot.</strong>\n              </div>\n              <div>\n                <span>Best thought</span>\n                <strong>“I want to hit through them.”</strong>\n              </div>\n            </div>\n\n            <div class=\"hn-prime-system__bottom\">\n              <p class=\"hn-prime-system__price\">₹1,799</p>\n\n              <a href=\"https://in.hndrd.co/products/nitrix-10-4u-unstrung\" class=\"hn-prime-system__button\">\n                Go All In\n                <span>→</span>\n              </a>\n            </div>\n          </div>\n\n          <div class=\"hn-prime-system__copy-panel\" data-hn-prime-copy=\"flareon\">\n            <span class=\"hn-prime-system__tag\">Speed</span>\n            <p class=\"hn-prime-system__series\">FLAREON 100</p>\n\n            <h3>Play the game a step faster.</h3>\n\n            <p class=\"hn-prime-system__body\">\n              For the player who wants quicker hands, faster recovery, and sharper reactions between shots.\n            </p>\n\n            <div class=\"hn-prime-system__specs\">\n              <div>\n                <span>Built around</span>\n                <strong>AECG+ Carbon Core</strong>\n              </div>\n              <div>\n                <span>Feels like</span>\n                <strong>Light. Whippy. Quick to reset.</strong>\n              </div>\n              <div>\n                <span>Best thought</span>\n                <strong>“I want to be faster than them.”</strong>\n              </div>\n            </div>\n\n            <div class=\"hn-prime-system__bottom\">\n              <p class=\"hn-prime-system__price\">₹1,890</p>\n\n              <a href=\"https://in.hndrd.co/products/flareon-100\" class=\"hn-prime-system__button\">\n                Pick Up the Pace\n                <span>→</span>\n              </a>\n            </div>\n          </div>\n\n          <div class=\"hn-prime-system__copy-panel\" data-hn-prime-copy=\"hyfonic\">\n            <span class=\"hn-prime-system__tag\">Precision</span>\n            <p class=\"hn-prime-system__series\">HYFONIC 1</p>\n\n            <h3>Make the shuttle listen.</h3>\n\n            <p class=\"hn-prime-system__body\">\n              For the player who builds the rally, finds the space, and wins by placement.\n            </p>\n\n            <div class=\"hn-prime-system__specs\">\n              <div>\n                <span>Built around</span>\n                <strong>Curve² Geometry</strong>\n              </div>\n              <div>\n                <span>Feels like</span>\n                <strong>Balanced. Controlled. Forgiving.</strong>\n              </div>\n              <div>\n                <span>Best thought</span>\n                <strong>“I want to out-think them.”</strong>\n              </div>\n            </div>\n\n            <div class=\"hn-prime-system__bottom\">\n              <p class=\"hn-prime-system__price\">₹1,890</p>\n\n              <a href=\"https://in.hndrd.co/products/hyfonic-1\" class=\"hn-prime-system__button\">\n                Trust the Play\n                <span>→</span>\n              </a>\n            </div>\n          </div>\n\n        </div>\n\n        <div class=\"hn-prime-system__selector\" aria-label=\"Choose your Prime Trinity racket\">\n\n          <button\n            class=\"hn-prime-system__choice is-active\"\n            type=\"button\"\n            data-hn-prinity-choice=\"nitrix\"\n            style=\"--accent:#E8432A; --accent-rgb:232,67,42;\"\n            aria-pressed=\"true\"\n          >\n            <span class=\"hn-prime-system__choice-count\">01</span>\n            <span class=\"hn-prime-system__choice-meta\">Attack</span>\n            <strong>NITRIX 10</strong>\n            <em>End the rally before they settle.</em>\n          </button>\n\n          <button\n            class=\"hn-prime-system__choice\"\n            type=\"button\"\n            data-hn-prinity-choice=\"flareon\"\n            style=\"--accent:#FF9C2A; --accent-rgb:255,156,42;\"\n            aria-pressed=\"false\"\n          >\n            <span class=\"hn-prime-system__choice-count\">02</span>\n            <span class=\"hn-prime-system__choice-meta\">Speed</span>\n            <strong>FLAREON 100</strong>\n            <em>Move first. Recover faster.</em>\n          </button>\n\n          <button\n            class=\"hn-prime-system__choice\"\n            type=\"button\"\n            data-hn-prinity-choice=\"hyfonic\"\n            style=\"--accent:#4361EE; --accent-rgb:67,97,238;\"\n            aria-pressed=\"false\"\n          >\n            <span class=\"hn-prime-system__choice-count\">03</span>\n            <span class=\"hn-prime-system__choice-meta\">Precision</span>\n            <strong>HYFONIC 1</strong>\n            <em>Place it where they are not.</em>\n          </button>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"hn-prime-system__quick-match\">\n      <div class=\"hn-prime-system__quick-item\" style=\"--accent:#E8432A; --accent-rgb:232,67,42;\">\n        <span>Nitrix 10</span>\n        <strong>Hit through them.</strong>\n      </div>\n\n      <div class=\"hn-prime-system__quick-item\" style=\"--accent:#FF9C2A; --accent-rgb:255,156,42;\">\n        <span>Flareon 100</span>\n        <strong>Get there faster.</strong>\n      </div>\n\n      <div class=\"hn-prime-system__quick-item\" style=\"--accent:#4361EE; --accent-rgb:67,97,238;\">\n        <span>Hyfonic 1</span>\n        <strong>Out-think the rally.</strong>\n      </div>\n    </div>\n\n    <div class=\"hn-prime-system__main-cta-wrap\">\n      <a href=\"https://in.hndrd.co/pages/the-prime-trinity\" class=\"hn-prime-system__main-cta\">\n        View the full Prime Trinity\n        <span>→</span>\n      </a>\n    </div>\n\n    <div class=\"hn-evolution-bridge\">\n      <p class=\"hn-evolution-bridge__kicker\">Unleash Your Game</p>\n\n      <h2 class=\"hn-evolution-bridge__title\">\n        The Evolution Series\n      </h2>\n\n      <p class=\"hn-evolution-bridge__sub\">\n        Crafted for power, speed, and total control.\n      </p>\n\n      <a href=\"/collections/the-evolution-series\" class=\"hn-evolution-bridge__cta\">\n        <span>Explore</span>\n      </a>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hn-prime-system,\n  .hn-prime-system *,\n  .hn-prime-system *::before,\n  .hn-prime-system *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-prime-system {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: 116px 20px 82px;\n    background:\n      radial-gradient(circle at 50% 0%, rgba(45, 159, 167, 0.16), transparent 34%),\n      radial-gradient(circle at 16% 18%, rgba(232, 67, 42, 0.16), transparent 30%),\n      radial-gradient(circle at 84% 22%, rgba(67, 97, 238, 0.13), transparent 30%),\n      linear-gradient(to bottom, #030403 0%, #070908 45%, #030403 100%);\n    font-family: inherit;\n    isolation: isolate;\n  }\n\n  .hn-prime-system::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(rgba(255,255,255,0.023) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);\n    background-size: 46px 46px;\n    opacity: 0.22;\n  }\n\n  .hn-prime-system::after {\n    content: \"\";\n    position: absolute;\n    width: 54vw;\n    height: 54vw;\n    min-width: 540px;\n    min-height: 540px;\n    left: 50%;\n    top: 10%;\n    z-index: 0;\n    pointer-events: none;\n    transform: translate(-50%, -50%);\n    background: radial-gradient(circle, rgba(31, 210, 159, 0.16), rgba(219, 162, 15, 0.08) 38%, transparent 72%);\n    filter: blur(48px);\n    opacity: 0.78;\n    animation: hnPrimeSystemGlow 5.4s ease-in-out infinite;\n  }\n\n  .hn-prime-system__flow-line {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    z-index: 3;\n    width: min(1180px, calc(100% - 40px));\n    height: 1px;\n    transform: translateX(-50%);\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);\n  }\n\n  .hn-prime-system__flow-line::after {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    top: -1px;\n    width: 22%;\n    height: 3px;\n    transform: translateX(-50%);\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.78), transparent);\n    filter: blur(3px);\n    animation: hnFlowMove 3.6s ease-in-out infinite;\n  }\n\n  .hn-prime-system__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1460px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-prime-system__header {\n    text-align: center;\n    margin: 0 auto 46px;\n    opacity: 0;\n    transform: translateY(28px);\n    transition: opacity 0.85s ease, transform 0.85s ease;\n  }\n\n  .hn-prime-system.is-visible .hn-prime-system__header {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-prime-system__kicker {\n    margin: 0 0 10px;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(13px, 1vw, 15px);\n    line-height: 1.2;\n    font-weight: 750;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-system__title {\n    margin: 0;\n    font-size: clamp(46px, 6.6vw, 104px);\n    line-height: 0.94;\n    font-weight: 900;\n    letter-spacing: -0.068em;\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    );\n    background-size: 120% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    filter: drop-shadow(0 18px 42px rgba(0,0,0,0.42));\n  }\n\n  .hn-prime-system__sub {\n    width: min(720px, 100%);\n    margin: 16px auto 0;\n    color: rgba(255,255,255,0.76);\n    font-size: clamp(15px, 1.25vw, 18px);\n    line-height: 1.45;\n    font-weight: 560;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-prime-system__experience {\n    --active-accent: #E8432A;\n    --active-rgb: 232,67,42;\n\n    position: relative;\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: 24px;\n    min-height: 650px;\n    padding: 22px;\n    border-radius: 40px;\n    border: 1px solid rgba(255,255,255,0.16);\n    background:\n      radial-gradient(circle at 28% 20%, rgba(var(--active-rgb), 0.2), transparent 34%),\n      linear-gradient(145deg, rgba(255,255,255,0.095), rgba(255,255,255,0.032)),\n      rgba(5, 7, 6, 0.82);\n    box-shadow:\n      0 36px 120px rgba(0,0,0,0.42),\n      inset 0 0 0 1px rgba(255,255,255,0.06);\n    backdrop-filter: blur(18px);\n    opacity: 0;\n    transform: translateY(54px) scale(0.985);\n    transition:\n      opacity 0.95s ease,\n      transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),\n      background 0.45s ease;\n  }\n\n  .hn-prime-system.is-visible .hn-prime-system__experience {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  .hn-prime-system__stage {\n    position: relative;\n    min-height: 606px;\n    overflow: hidden;\n    border-radius: 32px;\n    background:\n      radial-gradient(circle at 50% 34%, rgba(var(--active-rgb), 0.24), transparent 34%),\n      radial-gradient(circle at 50% 62%, rgba(255,255,255,0.07), transparent 42%),\n      linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.022)),\n      rgba(0,0,0,0.28);\n    border: 1px solid rgba(255,255,255,0.12);\n    transition: background 0.45s ease;\n  }\n\n  .hn-prime-system__stage::before {\n    content: \"\";\n    position: absolute;\n    inset: 34px;\n    z-index: 1;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.13);\n    transform: rotate(-12deg) scaleX(1.18);\n  }\n\n  .hn-prime-system__stage::after {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    bottom: 48px;\n    width: 62%;\n    height: 14%;\n    transform: translateX(-50%);\n    border-radius: 50%;\n    background: radial-gradient(ellipse, rgba(var(--active-rgb), 0.3), transparent 68%);\n    filter: blur(24px);\n    opacity: 0.85;\n    transition: background 0.45s ease;\n  }\n\n  .hn-prime-system__orb {\n    position: absolute;\n    left: 50%;\n    top: 47%;\n    z-index: 0;\n    width: 72%;\n    aspect-ratio: 1 / 1;\n    transform: translate(-50%, -50%);\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 38% 26%, rgba(255,255,255,0.16), transparent 20%),\n      radial-gradient(circle, rgba(var(--active-rgb), 0.2), rgba(255,255,255,0.035) 46%, transparent 68%);\n    filter: blur(2px);\n    opacity: 0.9;\n    transition: background 0.45s ease;\n  }\n\n  .hn-prime-system__ring {\n    position: absolute;\n    left: 50%;\n    top: 48%;\n    z-index: 2;\n    width: 78%;\n    aspect-ratio: 1 / 0.34;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.13);\n    transform: translate(-50%, -50%) rotate(-18deg);\n    pointer-events: none;\n  }\n\n  .hn-prime-system__ring--two {\n    width: 58%;\n    top: 53%;\n    transform: translate(-50%, -50%) rotate(16deg);\n    opacity: 0.65;\n  }\n\n  .hn-prime-system__visual {\n    position: absolute;\n    inset: 34px;\n    z-index: 4;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    transfo