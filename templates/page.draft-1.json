t:14px;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__shuttle-feather--3 {\n    left:18px;\n    transform:rotate(18deg);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__impact {\n    position:absolute;\n    left:83%;\n    top:68%;\n    width:10px;\n    height:10px;\n    border-radius:50%;\n    border:1px solid #fff;\n    opacity:0;\n    transform:translate(-50%,-50%) scale(.2);\n  }\n\n  #hmp-{{ hmp_id }}.is-impact .hmp__impact {\n    animation:hmp-impact .7s ease-out forwards;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner {\n    --winner-tone:255,102,0;\n    position:absolute;\n    inset:0;\n    z-index:20;\n    overflow:hidden;\n    background:#040404;\n    clip-path:circle(0% at var(--impact-x,83%) var(--impact-y,68%));\n    pointer-events:none;\n    transition:clip-path 1.1s var(--ease);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner.is-visible {\n    clip-path:circle(145% at var(--impact-x,83%) var(--impact-y,68%));\n    pointer-events:auto;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-wash {\n    position:absolute;\n    inset:0;\n    background:\n      radial-gradient(circle at 72% 20%,rgba(var(--winner-tone),.18),transparent 28%),\n      radial-gradient(circle at 18% 82%,rgba(var(--winner-tone),.08),transparent 30%),\n      linear-gradient(135deg,rgba(var(--winner-tone),.06),#040404 52%);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-top {\n    position:absolute;\n    top:0;\n    left:0;\n    right:0;\n    z-index:2;\n    display:flex;\n    justify-content:space-between;\n    padding:24px clamp(20px,4vw,64px);\n    font-size:10px;\n    font-weight:700;\n    letter-spacing:.17em;\n    color:var(--muted);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-copy {\n    position:absolute;\n    left:clamp(20px,6vw,96px);\n    right:clamp(20px,6vw,96px);\n    bottom:clamp(80px,10vh,120px);\n    z-index:2;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-kicker {\n    margin:0 0 12px;\n    font-size:10px;\n    font-weight:700;\n    letter-spacing:.16em;\n    text-transform:uppercase;\n    color:rgb(var(--winner-tone));\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-title {\n    margin:0;\n    max-width:1100px;\n    font-size:clamp(72px,13vw,210px);\n    line-height:.76;\n    letter-spacing:-.08em;\n    font-weight:760;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-list {\n    display:flex;\n    flex-wrap:wrap;\n    gap:8px 22px;\n    margin:30px 0 28px;\n    padding:0;\n    list-style:none;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-list li {\n    position:relative;\n    padding-left:12px;\n    font-size:13px;\n    color:rgba(255,255,255,.72);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-list li::before {\n    content:\"\";\n    position:absolute;\n    left:0;\n    top:.55em;\n    width:4px;\n    height:4px;\n    border-radius:50%;\n    background:rgb(var(--winner-tone));\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-cta {\n    display:inline-flex;\n    align-items:center;\n    gap:17px;\n    min-height:48px;\n    padding:0 8px 0 20px;\n    border:1px solid rgba(255,255,255,.38);\n    border-radius:999px;\n    color:#fff;\n    text-decoration:none;\n    font-size:11px;\n    font-weight:700;\n    letter-spacing:.07em;\n    text-transform:uppercase;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-cta svg {\n    width:32px;\n    height:32px;\n    padding:8px;\n    border-radius:50%;\n    background:rgb(var(--winner-tone));\n    color:#050505;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-cta path {\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.7;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__replay {\n    position:absolute;\n    right:clamp(20px,4vw,64px);\n    bottom:34px;\n    z-index:3;\n    border:0;\n    background:transparent;\n    color:rgba(255,255,255,.55);\n    font-size:9px;\n    font-weight:700;\n    letter-spacing:.16em;\n    text-transform:uppercase;\n    cursor:pointer;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__winner-ghost {\n    position:absolute;\n    right:-2vw;\n    bottom:-7vw;\n    font-size:clamp(230px,38vw,590px);\n    line-height:.7;\n    font-weight:800;\n    letter-spacing:-.1em;\n    color:rgba(255,255,255,.025);\n  }\n\n  @keyframes hmp-path-in {\n    0% { opacity:0; stroke-dashoffset:120; }\n    25% { opacity:1; }\n    100% { opacity:.4; stroke-dashoffset:0; }\n  }\n\n  @keyframes hmp-shuttle-flight {\n    0% {\n      left:7%;\n      top:68%;\n      transform:translate(-50%,-50%) rotate(24deg) scale(.82);\n    }\n    18% {\n      left:23%;\n      top:28%;\n      transform:translate(-50%,-50%) rotate(54deg) scale(.92);\n    }\n    48% {\n      left:50%;\n      top:13%;\n      transform:translate(-50%,-50%) rotate(90deg) scale(1);\n    }\n    76% {\n      left:72%;\n      top:30%;\n      transform:translate(-50%,-50%) rotate(126deg) scale(.94);\n    }\n    100% {\n      left:var(--impact-x,83%);\n      top:var(--impact-y,68%);\n      transform:translate(-50%,-50%) rotate(158deg) scale(.82);\n    }\n  }\n\n  @keyframes hmp-impact {\n    0% { opacity:1; transform:translate(-50%,-50%) scale(.2); }\n    70% { opacity:.5; transform:translate(-50%,-50%) scale(7); }\n    100% { opacity:0; transform:translate(-50%,-50%) scale(10); }\n  }\n\n  @media (max-width: 989px) {\n    #hmp-{{ hmp_id }} {\n      min-height:760px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__topbar {\n      padding:20px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series-grid {\n      padding:138px 20px 80px;\n      grid-template-columns:1fr;\n      gap:0;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series {\n      min-height:150px;\n      padding:22px 0;\n      border-left:0 !important;\n      border-bottom:1px solid rgba(255,255,255,.07);\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series-index {\n      left:0;\n      top:18px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series h2 {\n      font-size:clamp(48px,12vw,76px);\n    }\n\n    #hmp-{{ hmp_id }} .hmp__score {\n      top:76px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__score-number {\n      font-size:52px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner-copy {\n      left:20px;\n      right:20px;\n      bottom:90px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner-title {\n      font-size:clamp(56px,16vw,102px);\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner-list {\n      display:grid;\n      grid-template-columns:repeat(2,minmax(0,1fr));\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner-cta {\n      width:100%;\n      justify-content:space-between;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__replay {\n      right:20px;\n      bottom:24px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    #hmp-{{ hmp_id }} {\n      min-height:720px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__topbar span:last-child {\n      display:none;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series {\n      min-height:142px;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__series h2 {\n      font-size:clamp(42px,13vw,62px);\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner-list {\n      grid-template-columns:1fr;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hmp-{{ hmp_id }} .hmp__trajectory,\n    #hmp-{{ hmp_id }} .hmp__shuttle,\n    #hmp-{{ hmp_id }} .hmp__impact {\n      display:none !important;\n    }\n\n    #hmp-{{ hmp_id }} .hmp__winner {\n      clip-path:none !important;\n      transition:none !important;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hmp-{{ hmp_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const series = [...root.querySelectorAll('.hmp__series')];\n  const winner = root.querySelector('.hmp__winner');\n  const score = root.querySelector('.hmp__score-number');\n  const status = root.querySelector('.hmp__status');\n  const replay = root.querySelector('.hmp__replay');\n\n  let activeWinner = -1;\n  let timers = [];\n\n  const clearTimers = () => {\n    timers.forEach(timer => clearTimeout(timer));\n    timers = [];\n  };\n\n  const getImpactPosition = index => {\n    if (window.innerWidth < 990) {\n      return [\n        { x: 52, y: 31 },\n        { x: 50, y: 51 },\n        { x: 49, y: 72 }\n      ][index];\n    }\n\n    return [\n      { x: 18, y: 68 },\n      { x: 50, y: 68 },\n      { x: 83, y: 68 }\n    ][index];\n  };\n\n  const populateWinner = index => {\n    const target = series[index];\n    const rackets = target.dataset.rackets.split('|');\n    const tone = target.style.getPropertyValue('--tone');\n\n    winner.style.setProperty('--winner-tone', tone);\n    winner.querySelector('.hmp__winner-count').textContent = `0${index + 1} / 03`;\n    winner.querySelector('.hmp__winner-tag').textContent = target.dataset.tag;\n    winner.querySelector('.hmp__winner-kicker').textContent = target.dataset.kicker;\n    winner.querySelector('.hmp__winner-title').textContent = target.dataset.label;\n    winner.querySelector('.hmp__winner-list').innerHTML =\n      rackets.map(name => `<li>${name}</li>`).join('');\n\n    const cta = winner.querySelector('.hmp__winner-cta');\n    cta.href = target.dataset.link;\n    cta.querySelector('span').textContent = target.dataset.cta;\n\n    winner.querySelector('.hmp__winner-ghost').textContent = `0${index + 1}`;\n  };\n\n  const chooseWinner = () => {\n    let next = Math.floor(Math.random() * series.length);\n\n    if (series.length > 1 && next === activeWinner) {\n      next = (next + 1 + Math.floor(Math.random() * (series.length - 1))) % series.length;\n    }\n\n    activeWinner = next;\n    return next;\n  };\n\n  const play = () => {\n    clearTimers();\n\n    root.classList.remove('is-playing', 'is-impact');\n    winner.classList.remove('is-visible');\n    series.forEach(item => item.classList.remove('is-target'));\n\n    const index = chooseWinner();\n    const impact = getImpactPosition(index);\n\n    root.style.setProperty('--impact-x', `${impact.x}%`);\n    root.style.setProperty('--impact-y', `${impact.y}%`);\n    winner.style.setProperty('--impact-x', `${impact.x}%`);\n    winner.style.setProperty('--impact-y', `${impact.y}%`);\n\n    const impactNode = root.querySelector('.hmp__impact');\n    impactNode.style.left = `${impact.x}%`;\n    impactNode.style.top = `${impact.y}%`;\n\n    populateWinner(index);\n\n    score.textContent = '03';\n    status.textContent = 'RALLY IN PLAY';\n\n    requestAnimationFrame(() => {\n      root.classList.add('is-playing');\n    });\n\n    timers.push(setTimeout(() => {\n      score.textContent = '02';\n    }, 700));\n\n    timers.push(setTimeout(() => {\n      score.textContent = '01';\n      series[index].classList.add('is-target');\n    }, 1450));\n\n    timers.push(setTimeout(() => {\n      score.textContent = '00';\n      status.textContent = 'POINT WON';\n      root.classList.add('is-impact');\n    }, 2450));\n\n    timers.push(setTimeout(() => {\n      winner.classList.add('is-visible');\n    }, 2580));\n  };\n\n  replay.addEventListener('click', play);\n\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    const index = chooseWinner();\n    populateWinner(index);\n    winner.classList.add('is-visible');\n  } else {\n    play();\n  }\n})();\n</script>",
