      "settings": {
        "custom_liquid": "<section class=\"hq\" id=\"hq\">\n<div class=\"hqbg\"><i></i><i></i><b></b></div>\n<div class=\"hqwrap\">\n<div class=\"hqs hqintro on\" data-s=\"intro\">\n<div class=\"hqlock\"><span></span><span></span><em></em></div>\n<p class=\"hqey\">Hundred Badminton</p>\n<h2>3 quick questions.<br>1 smart match.</h2>\n<p>Answer how you play. We’ll show only the rackets that actually fit.</p>\n<div class=\"hqintroBtns\"><button id=\"hqStart\" type=\"button\">Let's go <span>→</span></button><button id=\"hqSaved\" type=\"button\" hidden>View saved match</button></div>\n</div>\n<div class=\"hqs hqquiz\" data-s=\"quiz\" aria-hidden=\"true\">\n<button class=\"hqback\" id=\"hqBack\" type=\"button\">←</button><div class=\"hqprog\" id=\"hqProg\"></div><p class=\"hqlabel\" id=\"hqLabel\"></p><h3 id=\"hqQuestion\"></h3><div class=\"hqopts\" id=\"hqOpts\"></div>\n</div>\n<div class=\"hqs hqres\" data-s=\"result\" aria-hidden=\"true\">\n<div class=\"hqflash\" id=\"hqFlash\"></div><div class=\"hqResultGrid\">\n<div class=\"hqProduct\" id=\"hqProduct\"><span></span><img id=\"hqImg\" src=\"\" alt=\"\"></div>\n<div class=\"hqCopy\"><p class=\"hqTag\" id=\"hqTag\"></p><h3 id=\"hqName\"></h3><p class=\"hqReason\" id=\"hqReason\"></p><div class=\"hqStats\" id=\"hqStats\"></div><div class=\"hqBuy\"><p id=\"hqPrice\"></p><a id=\"hqShop\" href=\"#\" target=\"_blank\" rel=\"noopener\">Shop now <span>→</span></a></div><div class=\"hqAlt\" id=\"hqAlt\"></div><button class=\"hqCompare\" id=\"hqCompare\" type=\"button\" hidden><span id=\"hqCompareText\">Compare matches</span><b>+</b></button><button class=\"hqAgain\" id=\"hqAgain\" type=\"button\">Take it again</button></div>\n</div></div>\n</div>\n<div class=\"hqModal\" id=\"hqModal\" hidden><button class=\"hqScrim\" id=\"hqScrim\" type=\"button\"></button><div class=\"hqPanel\"><button class=\"hqClose\" id=\"hqClose\" type=\"button\">✕</button><div class=\"hqModalHead\"><p>Compare Matches</p><h3>Every spec checked from the product page.</h3></div><div class=\"hqCards\" id=\"hqCards\"></div><div class=\"hqTableWrap\"><table class=\"hqTable\" id=\"hqTable\"></table></div></div></div>\n<style>\n.hq,.hq *{box-sizing:border-box}.hq{--a:#fff;--ar:255,255,255;--atk:#f0442e;--atkr:240,68,46;--spd:#f6a738;--spdr:246,167,56;--ctl:#4f68ff;--ctlr:79,104,255;--ven:#19b84a;--venr:25,184,74;--vol:#1f7ed8;--volr:31,126,216;--red:#ff3b24;--redr:255,59,36;--pur:#6f42d8;--purr:111,66,216;position:relative;width:100vw;min-height:100vh;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);padding:72px 18px;background:#030303;color:#fff;overflow:hidden;isolation:isolate;font-family:Figtree,Avenir,Arial,sans-serif;display:flex;align-items:center;justify-content:center}.hqbg{position:absolute;inset:0;background:linear-gradient(180deg,#050505,#000 55%,#050505);overflow:hidden}.hqbg:before{content:\"\";position:absolute;inset:0;opacity:.07;background-image:linear-gradient(rgba(255,255,255,.36) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.36) 1px,transparent 1px);background-size:3px 3px}.hqbg i:first-child{position:absolute;inset:-20%;background:radial-gradient(650px circle at var(--mx,50%) var(--my,40%),rgba(var(--ar),.16),transparent 60%);animation:hqSpin 44s linear infinite}.hqbg i:nth-child(2){position:absolute;left:-22%;top:0;width:30%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.09),transparent);filter:blur(16px);transform:skewX(-18deg);animation:hqBlade 6s ease-in-out infinite}.hqbg b{position:absolute;right:12%;top:-20%;width:220px;height:140%;background:linear-gradient(180deg,transparent,rgba(255,255,255,.06),transparent);transform:rotate(28deg);filter:blur(1px);animation:hqBlade2 5s ease-in-out infinite}.hqwrap{position:relative;z-index:2;width:min(1040px,100%)}.hqs{display:none}.hqs.on{display:block;animation:hqIn .55s cubic-bezier(.16,1,.3,1) both}.hqintro{text-align:center;min-height:min(680px,calc(100vh - 144px));align-items:center;justify-content:ce