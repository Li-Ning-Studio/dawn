rder-radius: 999px;\n    background: #050505;\n    color: #ffffff;\n  }\n\n  .hn-closing-cta__button-icon svg {\n    width: 22px;\n    height: 22px;\n    fill: currentColor;\n  }\n\n  .hn-closing-cta__arrow {\n    font-size: 20px;\n    line-height: 1;\n    transition: transform 220ms ease;\n  }\n\n  .hn-closing-cta__button:hover .hn-closing-cta__arrow {\n    transform: translateX(4px);\n  }\n\n  .hn-closing-cta__note {\n    margin: 18px 0 0;\n    color: rgba(255,255,255,0.44);\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 650;\n    letter-spacing: -0.01em;\n  }\n\n  @keyframes hnClosingGlow {\n    0%, 100% {\n      transform: translate3d(0, 0, 0) scale(0.94);\n      opacity: 0.28;\n    }\n\n    50% {\n      transform: translate3d(3vw, -2vw, 0) scale(1.08);\n      opacity: 0.42;\n    }\n  }\n\n  @keyframes hnClosingRing {\n    0%, 100% {\n      opacity: 0.38;\n      transform: scale(0.94);\n    }\n\n    50% {\n      opacity: 0.9;\n      transform: scale(1.08);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-closing-cta {\n      min-height: 82vh;\n      padding: 76px 14px;\n    }\n\n    .hn-closing-cta__inner {\n      padding: 34px 20px;\n      border-radius: 30px;\n    }\n\n    .hn-closing-cta__mark {\n      width: 74px;\n      height: 74px;\n      margin-bottom: 22px;\n    }\n\n    .hn-closing-cta__title {\n      font-size: clamp(42px, 12vw, 58px);\n      letter-spacing: -0.07em;\n    }\n\n    .hn-closing-cta__text {\n      margin-top: 20px;\n      font-size: 16px;\n    }\n\n    .hn-closing-cta__button {\n      width: 100%;\n      justify-content: center;\n      min-height: 56px;\n      margin-top: 30px;\n      font-size: 14px;\n    }\n\n    .hn-closing-cta__button-icon {\n      width: 40px;\n      height: 40px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-closing-cta__glow,\n    .hn-closing-cta__mark::before {\n      animation: none !important;\n    }\n\n    .hn-closing-cta__button,\n    .hn-closing-cta__button::before,\n    .hn-closing-cta__arrow {\n      transition: none !important;\n    }\n  }\n</style>\n<style>\n  /* Closing CTA size reduction */\n  .hn-closing-cta {\n    min-height: 72vh !important;\n    padding: clamp(68px, 7vw, 110px) 20px !important;\n  }\n\n  .hn-closing-cta__inner {\n    width: min(820px, 100%) !important;\n    padding: clamp(28px, 4vw, 48px) !important;\n  }\n\n  .hn-closing-cta__mark {\n    width: 68px !important;\n    height: 68px !important;\n    margin-bottom: 22px !important;\n  }\n\n  .hn-closing-cta__title {\n    max-width: 720px !important;\n    font-size: clamp(34px, 4.8vw, 68px) !important;\n    line-height: 0.95 !important;\n    letter-spacing: -0.06em !important;\n  }\n\n  .hn-closing-cta__text {\n    width: min(560px, 100%) !important;\n    margin-top: 18px !important;\n    font-size: clamp(15px, 1.15vw, 18px) !important;\n    line-height: 1.45 !important;\n  }\n\n  .hn-closing-cta__button {\n    min-height: 52px !important;\n    margin-top: 28px !important;\n    font-size: 14px !important;\n    padding: 7px 16px 7px 7px !important;\n  }\n\n  .hn-closing-cta__button-icon {\n    width: 38px !important;\n    height: 38px !important;\n  }\n\n  .hn-closing-cta__note {\n    margin-top: 14px !important;\n    font-size: 12px !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-closing-cta {\n      min-height: 70vh !important;\n      padding: 58px 14px !important;\n    }\n\n    .hn-closing-cta__inner {\n      padding: 28px 18px !important;\n      border-radius: 26px !important;\n    }\n\n    .hn-closing-cta__mark {\n      width: 60px !important;\n      height: 60px !important;\n      margin-bottom: 18px !important;\n    }\n\n    .hn-closing-cta__title {\n      font-size: clamp(32px, 9.5vw, 44px) !important;\n      line-height: 0.98 !important;\n    }\n\n    .hn-closing-cta__text {\n      margin-top: 16px !important;\n      font-size: 14px !important;\n      line-height: 1.42 !important;\n    }\n\n    .hn-closing-cta__bu