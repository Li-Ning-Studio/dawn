      "settings": {
        "custom_liquid": "<section class=\"hn-closing-cta\" aria-label=\"Talk to a Hundred expert\">\n  <div class=\"hn-closing-cta__glow hn-closing-cta__glow--one\"></div>\n  <div class=\"hn-closing-cta__glow hn-closing-cta__glow--two\"></div>\n\n  <div class=\"hn-closing-cta__inner\">\n\n    <div class=\"hn-closing-cta__mark\" aria-hidden=\"true\">\n      <span></span>\n      <span></span>\n      <span></span>\n    </div>\n\n    <p class=\"hn-closing-cta__eyebrow\">Still choosing?</p>\n\n    <h2 class=\"hn-closing-cta__title\">\n      Not sure which tier is yours?\n    </h2>\n\n    <p class=\"hn-closing-cta__text\">\n      Talk to a Hundred expert and we’ll match you with the racket that fits your game.\n    </p>\n\n    <a\n      class=\"hn-closing-cta__button\"\n      href=\"https://wa.me/918859100100\"\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      aria-label=\"Chat with a Hundred expert on WhatsApp\"\n    >\n      <span class=\"hn-closing-cta__button-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 32 32\" role=\"presentation\">\n          <path d=\"M16.04 3C9.42 3 4.02 8.27 4.02 14.76c0 2.08.56 4.1 1.62 5.88L4 29l8.58-1.55a12.3 12.3 0 0 0 3.46.5c6.62 0 12.02-5.27 12.02-11.76S22.66 3 16.04 3Zm0 22.9c-1.1 0-2.17-.17-3.2-.52l-.46-.16-5.08.92.96-4.87-.24-.48a9.65 9.65 0 0 1-1.16-4.6c0-5.36 4.13-9.72 9.18-9.72s9.18 4.36 9.18 9.72-4.13 9.71-9.18 9.71Zm5.12-7.28c-.28-.14-1.66-.8-1.92-.9-.26-.1-.45-.14-.64.14-.19.27-.73.9-.9 1.08-.16.18-.33.2-.61.07-.28-.14-1.18-.43-2.25-1.36-.83-.74-1.4-1.65-1.56-1.92-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.17.19-.28.28-.47.09-.18.05-.35-.02-.49-.07-.14-.64-1.51-.88-2.07-.23-.54-.47-.47-.64-.48h-.55c-.19 0-.5.07-.76.35-.26.27-1 1-1 2.43s1.03 2.82 1.18 3.02c.14.18 2.03 3.05 4.92 4.27.69.3 1.23.48 1.65.61.69.22 1.31.19 1.81.11.55-.08 1.66-.66 1.9-1.3.24-.64.24-1.19.16-1.3-.07-.12-.26-.19-.54-.33Z\"/>\n        </svg>\n      </span>\n\n      <span>Chat on WhatsApp</span>\n      <span class=\"hn-closing-cta__arrow\" aria-hidden=\"true\">→</span>\n    </a>\n\n    <p class=\"hn-closing-cta__note\">\n      Quick recommendation. No confusion. No wrong pick.\n    </p>\n\n  </div>\n</section>\n\n<style>\n  .hn-closing-cta,\n  .hn-closing-cta *,\n  .hn-closing-cta *::before,\n  .hn-closing-cta *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-closing-cta {\n    position: relative;\n    width: 100%;\n    min-height: 88vh;\n    padding: clamp(88px, 9vw, 150px) 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    background: #000000;\n    color: #ffffff;\n    isolation: isolate;\n  }\n\n  .hn-closing-cta::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);\n    background-size: 54px 54px;\n    opacity: 0.18;\n    mask-image: radial-gradient(circle at 50% 50%, black 0%, transparent 70%);\n    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 0%, transparent 70%);\n  }\n\n  .hn-closing-cta::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background:\n      radial-gradient(circle at 50% 50%, transparent 0%, transparent 42%, rgba(0,0,0,0.86) 100%),\n      linear-gradient(180deg, rgba(0,0,0,0.25), #000000 100%);\n  }\n\n  .hn-closing-cta__glow {\n    position: absolute;\n    z-index: 0;\n    width: 36vw;\n    height: 36vw;\n    min-width: 360px;\n    min-height: 360px;\n    border-radius: 999px;\n    filter: blur(70px);\n    opacity: 0.34;\n    pointer-events: none;\n    animation: hnClosingGlow 7s ease-in-out infinite;\n  }\n\n  .hn-closing-cta__glow--one {\n    left: -12%;\n    top: 12%;\n    background: rgba(228, 180, 51, 0.24);\n  }\n\n  .hn-closing-cta__glow--two {\n    right: -14%;\n    bottom: 4%;\n    background: rgba(67, 215, 182, 0.22);\n    animation-delay: -2.8s;\n  }\n\n  .hn-closing-cta__inner {\n    position: relative;\n    z-index: 3;\n    width: min(980px, 100%);\n    margin: 0 auto;\n    text-align: center;\n    padding: clamp(34px, 5vw, 64px);\n    border-radius: clamp(28px, 4vw, 48px);\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)),\n      rgba(5,5,5,0.82);\n    border: 1px solid rgba(255,255,255,0.10);\n    box-shadow:\n      0 40px 120px rgba(0,0,0,0.72),\n      inset 0 1px 0 rgba(255,255,255,0.08);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n  }\n\n  .hn-closing-cta__mark {\n    position: relative;\n    width: 86px;\n    height: 86px;\n    margin: 0 auto 26px;\n    display: grid;\n    place-items: center;\n    border-radius: 999px;\n    background:\n      radial-gradient(circle at 50% 50%, rgba(255,255,255,0.09), rgba(255,255,255,0.02));\n    border: 1px solid rgba(255,255,255,0.10);\n    box-shadow:\n      0 0 40px rgba(67,215,182,0.12),\n      inset 0 1px 0 rgba(255,255,255,0.08);\n  }\n\n  .hn-closing-cta__mark::before {\n    content: \"\";\n    position: absolute;\n    inset: -12px;\n    border-radius: inherit;\n    border: 1px solid rgba(255,255,255,0.07);\n    animation: hnClosingRing 2.8s ease-in-out infinite;\n  }\n\n  .hn-closing-cta__mark span {\n    position: absolute;\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: #ffffff;\n    box-shadow: 0 0 22px rgba(255,255,255,0.45);\n  }\n\n  .hn-closing-cta__mark span:nth-child(1) {\n    transform: translate(-22px, 16px);\n    background: #E4B433;\n  }\n\n  .hn-closing-cta__mark span:nth-child(2) {\n    transform: translate(0, -22px);\n    background: #48B8FF;\n  }\n\n  .hn-closing-cta__mark span:nth-child(3) {\n    transform: translate(22px, 16px);\n    background: #43D7B6;\n  }\n\n  .hn-closing-cta__eyebrow {\n    margin: 0 0 16px;\n    color: rgba(255,255,255,0.58);\n    font-size: 12px;\