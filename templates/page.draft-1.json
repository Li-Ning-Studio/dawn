s\" id=\"hnVersionCards\">\n  <div class=\"hn-version-cards__sticky\">\n    <div class=\"hn-version-cards__inner\">\n\n      <div class=\"hn-version-cards__heading-wrap\">\n        <h2 class=\"hn-version-cards__heading\">\n          Felt that? Now find your version of it.\n        </h2>\n      </div>\n\n      <div class=\"hn-version-cards__grid\">\n\n        <article class=\"hn-version-cards__card hn-version-cards__card--one\">\n          <span class=\"hn-version-cards__number\">01</span>\n\n          <div class=\"hn-version-cards__image\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_3bb28fc4-a079-4666-acc6-3f17fd65a486.jpg?v=1769775015\"\n              alt=\"Prime Trinity badminton racket banner\"\n              loading=\"lazy\"\n              width=\"800\"\n              height=\"1000\"\n            >\n          </div>\n\n          <div class=\"hn-version-cards__content\">\n            <h3>Still figuring it out, but I'm not casual anymore.</h3>\n\n            <p>\n              Every week on court. Shots getting sharper. I need a racket that keeps up with me, not one I outgrow in a month.\n            </p>\n\n            <a href=\"/collections/prime-trinity\" class=\"hn-version-cards__button\">\n              Start with Prime Trinity\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n        <article class=\"hn-version-cards__card hn-version-cards__card--two\">\n          <span class=\"hn-version-cards__number\">02</span>\n\n          <div class=\"hn-version-cards__image\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_3_2cbc6b88-cf66-4177-a259-42414dfc035a.jpg?v=1762454610\"\n              alt=\"Evolution Series badminton racket banner\"\n              loading=\"lazy\"\n              width=\"800\"\n              height=\"1000\"\n            >\n          </div>\n\n          <div class=\"hn-version-cards__content\">\n