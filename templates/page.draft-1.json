      "settings": {
        "custom_liquid": "<section\n  style=\"\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n  \"\n>\n  <p style=\"margin-bottom: 0\">Unleash Your Game</p>\n  <h1 style=\"margin: 0; font-weight: 900; letter-spacing: -1px\" class=\"title\">\n    The Evolution Series\n  </h1>\n  <p style=\"margin-top: 3px\">Crafted for power, speed, and total control.</p>\n  <a href=\"/collections/the-evolution-series\" class=\"cta\">\n    <span>Explore</span>\n  </a>\n</section>\n\n<style>\n  .cta {\n    margin-top: 2rem;\n    background: transparent;\n    border: 1.5px solid #ff5e00; /* vivid orange accent */\n    font-weight: 700;\n    padding: 1.6rem 3.1rem;\n    border-radius: 500px;\n    cursor: pointer;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: white;\n    text-decoration: none;\n    font-size: 1.5rem;\n    transition: all 0.3s ease;\n  }\n\n  .cta:hover {\n    background-color: #ff5e00;\n    color: #fff;\n  }\n\n  .title {\n    font-size: 3.2rem;\n    background-image: linear-gradient(-225deg, #ff9900 0%, #ff5e00 50%, #ff2e63 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n\n  @media screen and (min-width: 750px) {\n    .title {\n      font-size: 6rem;\n    }\n  }\n</style>",
