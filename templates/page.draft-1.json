ition:absolute;left:50%;top:50%;width:6px;height:6px;border-radius:50%;background:var(--a);animation:hqBurst .9s cubic-bezier(.2,.8,.2,1) both}.hqResultGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;align-items:center}.hqProduct{position:relative;aspect-ratio:4/5;border-radius:30px;overflow:hidden;background:radial-gradient(circle at 30% 20%,rgba(var(--ar),.14),transparent 56%),#030303;border:1px solid rgba(255,255,255,.11);transition:transform .15s;box-shadow:0 34px 100px rgba(0,0,0,.52),0 0 42px rgba(var(--ar),.14),inset 0 0 0 1px rgba(255,255,255,.05)}.hqProduct:before{content:\"\";position:absolute;inset:-40%;background:conic-gradient(from 180deg,transparent,rgba(var(--ar),.18),transparent,rgba(255,255,255,.08),transparent);opacity:.35;animation:hqSpin 9s linear infinite}.hqProduct span{position:absolute;inset:0;z-index:2;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.48) 50%,transparent 60%);transform:translateX(-140%)}.hqres.on .hqProduct span{animation:hqSweep 1.1s .3s both}.hqProduct img{position:relative;z-index:1;width:100%;height:100%;object-fit:contain;padding:26px;filter:saturate(1.12) contrast(1.04) drop-shadow(0 28px 36px rgba(0,0,0,.68));animation:hqFloat 4.8s ease-in-out infinite}.hqres.on .hqProduct{animation:hqVisual .75s cubic-bezier(.16,1,.3,1) both}.hqres.on .hqCopy{animation:hqCopy .75s cubic-bezier(.16,1,.3,1) .08s both}.hqTag{margin:0 0 10px;color:var(--a);font-size:12px;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.hqCopy h3{margin:0;font-size:clamp(34px,4.6vw,58px);line-height:.94;font-weight:950;letter-spacing:-.065em}.hqReason{margin:14px 0 0;max-width:45ch;color:rgba(255,255,255,.7);font-size:15px;line-height:1.55;font-weight:650}.hqStats{display:flex;gap:18px;margin-top:24px}.hqStat{min-width:74px}.hqStat p{margin:0 0 7px;color:rgba(255,255,255,.4);font-size:10px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.hqTrack{height:5px;border-radius:999px;background:rgba(255,255,255,.13);overflow:hidden}.hqFill{display:block;height:100%;border-radius:999px;width:0;min-width:2px;position:relative;overflow:hidden;box-shadow:0 0 16px currentColor}.hqFill:after{content:\"\";position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.72),transparent);animation:hqBar 1.8s infinite}.hqBuy{display:flex;align-items:center;gap:20px;margin-top:28px}.hqBuy p{margin:0;color:rgba(255,255,255,.55);font-weight:750}.hqBuy a{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:8px;padding:14px 24px;border-radius:999px;background:var(--a);color:#060606;text-decoration:none;font-size:13px;font-weight:900;box-shadow:0 14px 34px rgba(var(--ar),.22),0 0 26px rgba(var(--ar),.18)}.hqBuy a:after{content:\"\";position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.48),transparent);animation:hqBtn 2.4s infinite}.hqAlt{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.hqAltCard{display:grid;grid-template-columns:58px 1fr;gap:12px;align-items:center;width:min(280px,100%);padding:10px;border-radius:18px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);color:inherit;text-decoration:none;animation:hqMini .55s both}.hqAltImg{height:66px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 45%,rgba(var(--rrr),.22),transparent 48%),#050505;overflow:hidden}.hqAltImg img{max-width:82%;max-height:92%;object-fit:contain}.hqAltCard p{margin:0;color:rgba(255,255,255,.5);font-size:10px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.hqAltCard h4{margin:5px 0 0;font-size:15px;line-height:1;font-weight:900}.hqCompare{display:inline-flex;align-items:center;gap:10px;margin-top:22px;padding:12px 10px 12px 20px;border-radius:999px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.075);color:#fff;font-size:13.5px;font-weight:800;