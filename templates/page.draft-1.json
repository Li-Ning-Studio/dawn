prime-system__main-cta {\n    color: #050504;\n    background: #ffffff;\n    border: 1px solid #ffffff;\n    font-size: 12px;\n    letter-spacing: 0.05em;\n    box-shadow: 0 18px 48px rgba(255,255,255,0.12);\n  }\n\n  .hn-prime-system__main-cta:hover {\n    transform: translateY(-3px);\n    background: transparent;\n    color: #ffffff;\n  }\n\n  .hn-evolution-bridge {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    width: min(1080px, 100%);\n    margin: 104px auto 0;\n    padding: 78px 20px 24px;\n    text-align: center;\n    border-top: 1px solid rgba(255,255,255,0.16);\n    opacity: 0;\n    transform: translateY(30px);\n    transition: opacity 0.85s ease 0.62s, transform 0.85s ease 0.62s;\n  }\n\n  .hn-prime-system.is-visible .hn-evolution-bridge {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-evolution-bridge__kicker {\n    margin: 0 0 6px;\n    color: rgba(255,255,255,0.88);\n    font-size: clamp(14px, 1.15vw, 17px);\n    line-height: 1.2;\n    font-weight: 550;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-evolution-bridge__title {\n    margin: 0;\n    font-weight: 900;\n    letter-spacing: -1px;\n    font-size: 3.2rem;\n    line-height: 1;\n    background-image: linear-gradient(-225deg, #ff9900 0%, #ff5e00 50%, #ff2e63 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n\n  .hn-evolution-bridge__sub {\n    margin: 12px 0 0;\n    color: rgba(255,255,255,0.78);\n    font-size: clamp(14px, 1.15vw, 17px);\n    line-height: 1.45;\n    font-weight: 520;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-evolution-bridge__cta {\n    margin-top: 2rem;\n    background: transparent;\n    border: 1.5px solid #ff5e00;\n    font-weight: 700;\n    padding: 1.6rem 3.1rem;\n    border-radius: 500px;\n    cursor: pointer;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: white;\n    text-decoration: none;\n    font-size: 1.5rem;\n    transition: all 0.3s ease;\n  }\n\n  .hn-evolution-bridge__cta:hover {\n    background-color: #ff5e00;\n    color: #fff;\n    transform: translateY(-3px);\n  }\n\n  @keyframes hnPrimeSystemGlow {\n    0%, 100% {\n      opacity: 0.46;\n      transform: translate(-50%, -50%) scale(0.95);\n    }\n\n    50% {\n      opacity: 0.84;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @keyframes hnFlowMove {\n    0%, 100% {\n      opacity: 0.35;\n      transform: translateX(-80%);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translateX(20%);\n    }\n  }\n\n  @media screen and (min-width: 750px) {\n    .hn-evolution-bridge__title {\n      font-size: 6rem;\n    }\n  }\n\n  @media screen and (max-width: 1180px) {\n    .hn-prime-system__experience {\n      grid-template-columns: 0.92fr 1.08fr;\n    }\n\n    .hn-prime-system__copy-panel h3 {\n      font-size: clamp(34px, 4vw, 56px);\n    }\n\n    .hn-prime-system__specs {\n      grid-template-columns: 1fr;\n    }\n\n    .hn-prime-system__specs div {\n      min-height: 74px;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-prime-system {\n      padding: 84px 0 70px;\n    }\n\n    .hn-prime-system__inner {\n      width: 100%;\n    }\n\n    .hn-prime-system__header {\n      padding: 0 18px;\n      margin-bottom: 30px;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-prime-system__title {\n      font-size: clamp(42px, 12vw, 72px);\n    }\n\n    .hn-prime-system__sub {\n      font-size: 15px;\n    }\n\n    .hn-prime-system__experience {\n      display: block;\n      min-height: unset;\n      margin: 0 18px;\n      padding: 14px;\n      border-radius: 30px;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-prime-system__stage {\n      min-height: 390px;\n      border-radius: 24px;\n    }\n\n    .hn-prime-system__visual {\n      inset: 22px;\n    }\n\n    .hn-prime-system__visual::before {\n      width: min(66%, 260px);\n      border-radius: 26px;\n    }\n\n    .hn-prime-system__stage-label {\n      left: 16px;\n      right: 16px;\n      bottom: 16px;\n      padding: 14px 16px;\n    }\n\n    .hn-prime-system__panel {\n      min-height: unset;\n      margin-top: 14px;\n    }\n\n    .hn-prime-system__copy-panels {\n      min-height: 520px;\n      border-radius: 24px;\n    }\n\n    .hn-prime-system__copy-panel {\n      padding: 26px;\n    }\n\n    .hn-prime-system__copy-panel h3 {\n      font-size: clamp(38px, 11vw, 56px);\n    }\n\n    .hn-prime-system__body {\n      font-size: 15px;\n    }\n\n    .hn-prime-system__specs {\n      grid-template-columns: 1fr;\n      gap: 10px;\n      margin-top: 24px;\n    }\n\n    .hn-prime-system__bottom {\n      align-items: flex-start;\n      flex-direction: column;\n    }\n\n    .hn-prime-system__selector {\n      display: flex;\n      gap: 12px;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      padding: 0 2px 8px;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n\n    .hn-prime-system__selector::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-prime-system__choice {\n      flex: 0 0 min(78vw, 330px);\n      min-height: 112px;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n    }\n\n    .hn-prime-system__choice:hover,\n    .hn-prime-system__choice.is-active {\n      transform: none;\n    }\n\n    .hn-prime-system__quick-match {\n      display: flex;\n      gap: 14px;\n      overflow-x: auto;\n      padding: 0 18px 8px;\n      margin-top: 24px;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-prime-system__quick-match::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-prime-system__quick-item {\n      flex: 0 0 min(76vw, 330px);\n      scroll-snap-align: center;\n    }\n\n    .hn-prime-system__main-cta-wrap {\n      opacity: 1;\n      transform: none;\n      padding: 0 18px;\n      margin-top: 28px;\n    }\n\n    .hn-prime-system__main-cta {\n      width: min(420px, 100%);\n    }\n\n    .hn-evolution-bridge {\n      width: calc(100% - 36px);\n      margin-top: 72px;\n      padding: 60px 0 8px;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-evolution-bridge__title {\n      font-size: clamp(3.2rem, 12vw, 5.4rem);\n      line-height: 0.95;\n    }\n\n    .hn-evolution-bridge__cta {\n      font-size: 1.3rem;\n      padding: 1.4rem 2.6rem;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('prime-trinity');\n    if (!section || section.dataset.hnPrimeSystemReady === 'true') return;\n\n    section.dataset.hnPrimeSystemReady = 'true';\n\n    var shell = section.querySelector('.hn-prime-system__experience');\n    var choices = Array.prototype.slice.call(section.querySelectorAll('[data-hn-prinity-choice]'));\n    var visuals = Array.prototype.slice.call(section.querySelectorAll('[data-hn-prime-visual]'));\n    var copyPanels = Array.prototype.slice.call(section.querySelectorAll('[data-hn-prime-copy]'));\n    var stageTitle = section.querySelector('[data-hn-prime-stage-title]');\n\n    var data = {\n      nitrix: {\n        title: 'Attack',\n        hex: '#E8432A',\n        rgb: '232,67,42'\n      },\n      flareon: {\n        title: 'Speed',\n        hex: '#FF9C2A',\n        rgb: '255,156,42'\n      },\n      hyfonic: {\n        title: 'Precision',\n        hex: '#4361EE',\n        rgb: '67,97,238'\n      }\n    };\n\n    function setActive(key) {\n      if (!data[key]) return;\n\n      shell.setAttribute('data-active', key);\n      shell.style.setProperty('--active-accent', data[key].hex);\n      shell.style.setProperty('--active-rgb', data[key].rgb);\n\n      if (stageTitle) {\n        stageTitle.textContent = data[key].title;\n      }\n\n      choices.forEach(function (choice) {\n        var active = choice.getAttribute('data-hn-prinity-choice') === key;\n        choice.classList.toggle('is-active', active);\n        choice.setAttribute('aria-pressed', active ? 'true' : 'false');\n      });\n\n      visuals.forEach(function (visual) {\n        visual.classList.toggle('is-active', visual.getAttribute('data-hn-prime-visual') === key);\n      });\n\n      copyPanels.forEach(function (panel) {\n        panel.classList.toggle('is-active', panel.getAttribute('data-hn-prime-copy') === key);\n      });\n    }\n\n    choices.forEach(function (choice) {\n      var key = choice.getAttribute('data-hn-prinity-choice');\n\n      choice.addEventListener('mouseenter', function () {\n        if (window.matchMedia('(min-width: 990px)').matches) {\n          setActive(key);\n        }\n      });\n\n      choice.addEventListener('focus', function () {\n        setActive(key);\n      });\n\n      choice.addEventListener('click', function () {\n        setActive(key);\n      });\n    });\n\n    function revealPrimeSection() {\n      var rect = section.getBoundingClientRect();\n      var triggerPoint = window.innerHeight * 0.76;\n\n      if (rect.top < triggerPoint) {\n        section.classList.add('is-visible');\n      }\n    }\n\n    window.addEventListener('scroll', revealPrimeSection, { passive: true });\n    window.addEventListener('resize', revealPrimeSection);\n\n    revealPrimeSection();\n    setActive('nitrix');\n  })();\n</script>",
