      "settings": {
        "custom_liquid": "{% assign vq_sid = section.id | default: 'video-quiz' %}\n<section id=\"hn-vq-{{ vq_sid }}\" class=\"hn-vq\" aria-label=\"HNDRD racket finder\">\n  <div class=\"hn-vq__sticky\">\n    <div class=\"hn-vq__video-layer\">\n      <div class=\"hn-vq__frame\">\n        <video class=\"hn-vq__video\" muted loop playsinline preload=\"metadata\" aria-label=\"HNDRD badminton video\"></video>\n      </div>\n      <div class=\"hn-vq__cue\" aria-hidden=\"true\">\n        <span>Find your racket</span>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 5v14\"/><path d=\"m6 13 6 6 6-6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"hn-vq__quiz-layer\" aria-hidden=\"true\">\n      <section class=\"rf\" id=\"rf-{{ vq_sid }}\" aria-label=\"HNDRD racket finder quiz\">\n        <header class=\"rf__header\">\n          <div class=\"rf__brand\"><strong>HNDRD</strong><span>Racket Finder</span></div>\n          <div class=\"rf__state\" id=\"rfState\">00 / 03</div>\n        </header>\n\n        <main class=\"rf__main\">\n          <section class=\"rf__screen rf__intro is-active\" data-screen=\"intro\">\n            <div class=\"rf__intro-copy\">\n              <p class=\"rf__kicker\">3 questions. 1 match.</p>\n              <h2>Find your racket.</h2>\n              <p class=\"rf__lead\">Tell us how you play. We’ll do the rest.</p>\n              <div class=\"rf__intro-actions\">\n                <button class=\"rf__primary\" id=\"rfStart\" type=\"button\"><span>Start</span><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12h13\"/><path d=\"m13 6 6 6-6 6\"/></svg></button>\n                <button class=\"rf__link\" id=\"rfSkip\" type=\"button\">Explore all rackets</button>\n              </div>\n            </div>\n          </section>\n\n          <section class=\"rf__screen rf__question\" data-screen=\"question\" aria-hidden=\"true\">\n            <button class=\"rf__back\" id=\"rfBack\" type=\"button\" aria-label=\"Previous question\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M19 12H6\"/><path d=\"m11 6-6 6 6 6\"/></svg></button>\n            <div class=\"rf__question-copy\">\n              <div class=\"rf__progress\" id=\"rfProgress\" aria-hidden=\"true\"></div>\n              <p class=\"rf__step\" id=\"rfStep\"></p>\n              <h3 id=\"rfQuestion\"></h3>\n            </div>\n            <div class=\"rf__options\" id=\"rfOptions\"></div>\n          </section>\n\n          <section class=\"rf__screen rf__result\" data-screen=\"result\" aria-hidden=\"true\">\n            <div class=\"rf__result-visual\">\n              <div class=\"rf__visual-meta\"><span id=\"rfSeries\"></span><strong id=\"rfWeight\"></strong></div>\n              <img id=\"rfImage\" src=\"\" alt=\"\">\n              <span class=\"rf__visual-mark\">HNDRD / MATCH</span>\n            </div>\n            <div class=\"rf__result-copy\">\n              <p class=\"rf__kicker\">Your match</p>\n              <h3 id=\"rfName\"></h3>\n              <p class=\"rf__reason\" id=\"rfReason\"></p>\n              <dl class=\"rf__specs\" id=\"rfSpecs\"></dl>\n              <div class=\"rf__result-actions\">\n                <a class=\"rf__primary\" id=\"rfShop\" href=\"#\"><span>View racket</span><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12h13\"/><path d=\"m13 6 6 6-6 6\"/></svg></a>\n                <button class=\"rf__secondary\" id=\"rfCompare\" type=\"button\"><span>Compare matches</span><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M8 5v14M16 5v14M4 9h8M12 15h8\"/></svg></button>\n              </div>\n              <div class=\"rf__alternatives\" id=\"rfAlternatives\"></div>\n              <button class=\"rf__link rf__again\" id=\"rfAgain\" type=\"button\">Start again</button>\n            </div>\n          </section>\n        </main>\n\n        <div class=\"rfm\" id=\"rfModal\" hidden>\n          <button class=\"rfm__scrim\" id=\"rfScrim\" type=\"button\" aria-label=\"Close comparison\"></button>\n          <section class=\"rfm__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"rfmTitle\">\n            <header class=\"rfm__header\">\n              <div><p>Racket comparison</p><h3 id=\"rfmTitle\">Compare your matches.</h3></div>\n              <button class=\"rfm__close\" id=\"rfClose\" type=\"button\" aria-label=\"Close comparison\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button>\n            </header>\n            <div class=\"rfm__mobile-head\"><span>Swipe to compare</span><strong id=\"rfmCount\">1 / 3</strong></div>\n            <div class=\"rfm__cards\" id=\"rfmCards\"></div>\n            <div class=\"rfm__table-wrap\"><div class=\"rfm__table\" id=\"rfmTable\"></div></div>\n          </section>\n        </div>\n      </section>\n    </div>\n  </div>\n</section>\n\n<style>\n#shopify-section-{{ section.id }}{margin:0!important;padding:0!important;background:#000!important}\n#hn-vq-{{ vq_sid }},#hn-vq-{{ vq_sid }} *{box-sizing:border-box}\n#hn-vq-{{ vq_sid }}{position:relative;width:100vw;height:140svh;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);background:#000;color:#fff;isolation:isolate;font-family:Figtree,Avenir,Helvetica,Arial,sans-serif}\n#hn-vq-{{ vq_sid }} button,#hn-vq-{{ vq_sid }} a{font:inherit}\n#hn-vq-{{ vq_sid }} .hn-vq__sticky{position:sticky;top:0;width:100%;height:100svh;min-height:620px;overflow:hidden;background:#000}\n#hn-vq-{{ vq_sid }} .hn-vq__video-layer,#hn-vq-{{ vq_sid }} .hn-vq__quiz-layer{position:absolute;inset:0;width:100%;height:100%;will-change:opacity}\n#hn-vq-{{ vq_sid }} .hn-vq__video-layer{z-index:2;display:flex;align-items:center;justify-content:center;background:#000}\n#hn-vq-{{ vq_sid }} .hn-vq__quiz-layer{z-index:3;visibility:hidden;opacity:0;pointer-events:none;overflow-y:auto;overflow-x:hidden;background:#000;-webkit-overflow-scrolling:touch}\n#hn-vq-{{ vq_sid }} .hn-vq__frame{position:relative;width:min(1180px,calc(100% - 36px));max-height:calc(100svh - 44px);aspect-ratio:16/9;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:#000}\n#hn-vq-{{ vq_sid }} .hn-vq__frame:after{content:\"\";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.04),transparent 28%,rgba(0,0,0,.16))}\n#hn-vq-{{ vq_sid }} .hn-vq__video{display:block;width:100%;height:100%;object-fit:cover;background:#000}\n#hn-vq-{{ vq_sid }} .hn-vq__cue{position:absolute;left:50%;bottom:112px;z-index:4;display:flex;flex-direction:column;align-items:center;gap:9px;transform:translateX(-50%);color:rgba(255,255,255,.82);font-size:9px;line-height:1;font-weight:750;letter-spacing:.18em;text-transform:uppercase;pointer-events:none}\n#hn-vq-{{ vq_sid }} .hn-vq__cue svg{width:18px;height:18px;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;animation:rfCue-{{ vq_sid }} 1.8s ease-in-out infinite}\n@keyframes rfCue-{{ vq_sid }}{0%,100%{transform:translateY(0);opacity:.55}50%{transform:translateY(8px);opacity:1}}\n#hn-vq-{{ vq_sid }} .rf{width:100%;min-height:100%;background:#000;color:#fff}\n#hn-vq-{{ vq_sid }} .rf__header{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;height:62px;padding:0 clamp(20px,4vw,60px);border-bottom:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.88);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}\n#hn-vq-{{ vq_sid }} .rf__brand{display:flex;align-items:baseline;gap:14px}\n#hn-vq-{{ vq_sid }} .rf__brand strong,#hn-vq-{{ vq_sid }} .rf__brand span,#hn-vq-{{ vq_sid }} .rf__state{font-size:9px;line-height:1}\n#hn-vq-{{ vq_sid }} .rf__brand strong{font-weight:850;letter-spacing:.04em}\n#hn-vq-{{ vq_sid }} .rf__brand span,#hn-vq-{{ vq_sid }} .rf__state{color:rgba(255,255,255,.46);font-weight:650}\n#hn-vq-{{ vq_sid }} .rf__main{width:min(1280px,100%);min-height:calc(100svh - 62px);margin:0 auto;padding:clamp(28px,5vh,58px) clamp(20px,5vw,72px)}\n#hn-vq-{{ vq_sid }} .rf__screen{display:none;min-height:calc(100svh - 62px - clamp(56px,10vh,116px))}\n#hn-vq-{{ vq_sid }} .rf__screen.is-active{animation:rfIn-{{ vq_sid }} .48s cubic-bezier(.2,.8,.2,1) both}\n@keyframes rfIn-{{ vq_sid }}{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}\n#hn-vq-{{ vq_sid }} .rf__intro.is-active{display:grid;place-items:center;text-align:center}\n#hn-vq-{{ vq_sid }} .rf__intro-copy{width:min(760px,100%);transform:translateY(-2vh)}\n#hn-vq-{{ vq_sid }} .rf__kicker,#hn-vq-{{ vq_sid }} .rf__step{margin:0 0 16px;color:rgba(255,255,255,.46);font-size:10px;line-height:1.2;font-weight:750;letter-spacing:.14em;text-transform:uppercase}\n#hn-vq-{{ vq_sid }} .rf__intro h2{margin:0;font-size:clamp(58px,8vw,112px);line-height:.88;font-weight:650;letter-spacing:-.072em}\n#hn-vq-{{ vq_sid }} .rf__lead{margin:24px auto 0;color:rgba(255,255,255,.58);font-size:clamp(15px,1.35vw,18px);line-height:1.45;font-weight:500}\n#hn-vq-{{ vq_sid }} .rf__intro-actions{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:34px}\n#hn-vq-{{ vq_sid }} .rf__primary,#hn-vq-{{ vq_sid }} .rf__secondary{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:50px;padding:0 17px 0 21px;border-radius:999px;text-decoration:none;cursor:pointer;transition:transform .22s ease,background .22s ease,color .22s ease,border-color .22s ease}\n#hn-vq-{{ vq_sid }} .rf__primary{min-width:180px;border:1px solid #fff;background:#fff;color:#000}\n#hn-vq-{{ vq_sid }} .rf__secondary{min-width:210px;border:1px solid rgba(255,255,255,.28);background:transparent;color:#fff}\n#hn-vq-{{ vq_sid }} .rf__primary span,#hn-vq-{{ vq_sid }} .rf__secondary span{font-size:11px;line-height:1;font-weight:750}\n#hn-vq-{{ vq_sid }} .rf__primary svg,#hn-vq-{{ vq_sid }} .rf__secondary svg{width:17px;height:17px;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .22s ease}\n#hn-vq-{{ vq_sid }} .rf__primary:hover,#hn-vq-{{ vq_sid }} .rf__secondary:hover{transform:translateY(-2px)}\n#hn-vq-{{ vq_sid }} .rf__primary:hover{background:transparent;color:#fff}\n#hn-vq-{{ vq_sid }} .rf__secondary:hover{background:#fff;color:#000;border-color:#fff}\n#hn-vq-{{ vq_sid }} .rf__primary:hover svg,#hn-vq-{{ vq_sid }} .rf__secondary:hover svg{transform:translateX(3px)}\n#hn-vq-{{ vq_sid }} .rf__link{padding:7px 0;border:0;border-bottom:1px solid rgba(255,255,255,.34);background:transparent;color:#fff;font-size:11px;line-height:1;font-weight:650;cursor:pointer}\n#hn-vq-{{ vq_sid }} .rf__question.is-active{position:relative;display:flex;flex-direction:column;justify-content:center;width:100%}\n#hn-vq-{{ vq_sid }} .rf__back{position:absolute;top:0;left:0;display:grid;place-items:center;width:40px;height:40px;padding:0;border:1px solid rgba(255,255,255,.18);border-radius:50%;background:transparent;color:#fff;cursor:pointer;transition:.2s ease}\n#hn-vq-{{ vq_sid }} .rf__back:hover{background:#fff;color:#000}\n#hn-vq-{{ vq_sid }} .rf__back svg{width:16px;height:16px;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\n#hn-vq-{{ vq_sid }} .rf__question-copy{text-align:center}\n#hn-vq-{{ vq_sid }} .rf__progress{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;width:min(230px,52vw);margin:0 auto 26px}\n#hn-vq-{{ vq_sid }} .rf__progress span{height:2px;background:rgba(255,255,255,.15);overflow:hidden}\n#hn-vq-{{ vq_sid }} .rf__progress span:after{content:\"\";display:block;width:100%;height:100%;background:#fff;transform:scaleX(0);transform-origin:left;transition:transform .3s ease}\n#hn-vq-{{ vq_sid }} .rf__progress span.is-done:after,#hn-vq-{{ vq_sid }} .rf__progress span.is-current:after{transform:scaleX(1)}\n#hn-vq-{{ vq_sid }} .rf__question h3{max-width:850px;margin:0 auto;font-size:clamp(44px,6vw,82px);line-height:.92;font-weight:650;letter-spacing:-.064em}\n#hn-vq-{{ vq_sid }} .rf__options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;width:100%;margin-top:clamp(30px,4vh,48px)}\n#hn-vq-{{ vq_sid }} .rf__option{position:relative;min-height:150px;padding:22px;border:1px solid rgba(255,255,255,.14);border-radius:20px;background:#070707;color:#fff;text-align:left;cursor:pointer;transition:transform .22s ease,border-color .22s ease,background .22s ease,color .22s ease}\n#hn-vq-{{ vq_sid }} .rf__option:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.62)}\n#hn-vq-{{ vq_sid }} .rf__option.is-selected{border-color:#fff;background:#fff;color:#000}\n#hn-vq-{{ vq_sid }} .rf__option-top{display:flex;align-items:center;justify-content:space-between;gap:16px}\n#hn-vq-{{ vq_sid }} .rf__option-index{color:rgba(255,255,255,.36);font-size:9px;font-weight:750}\n#hn-vq-{{ vq_sid }} .rf__option-check{display:grid;place-items:center;width:21px;height:21px;border:1px solid rgba(255,255,255,.2);border-radius:50%;font-size:0;opacity:.7}\n#hn-vq-{{ vq_sid }} .rf__option.is-selected .rf__option-index{color:rgba(0,0,0,.46)}\n#hn-vq-{{ vq_sid }} .rf__option.is-selected .rf__option-check{border-color:#000;background:#000;color:#fff;opacity:1}#hn-vq-{{ vq_sid }} .rf__option.is-selected .rf__option-check:before{content:'✓';font-size:11px;font-weight:800}\n#hn-vq-{{ vq_sid }} .rf__option-title{display:block;margin-top:30px;font-size:clamp(22px,2.1vw,29px);line-height:1;font-weight:650;letter-spacing:-.035em}\n#hn-vq-{{ vq_sid }} .rf__option-copy{display:block;margin-top:9px;color:rgba(255,255,255,.5);font-size:11px;line-height:1.35;font-weight:500}\n#hn-vq-{{ vq_sid }} .rf__option.is-selected .rf__option-copy{color:rgba(0,0,0,.56)}\n#hn-vq-{{ vq_sid }} .rf__result.is-active{display:grid;grid-template-columns:minmax(340px,.82fr) minmax(0,1fr);gap:clamp(42px,7vw,100px);align-items:center;width:100%}\n#hn-vq-{{ vq_sid }} .rf__result-visual{position:relative;min-height:520px;overflow:hidden;border:1px solid rgba(255,255,255,.12);border-radius:26px;background:#070707}\n#hn-vq-{{ vq_sid }} .rf__result-visual:before{content:\"\";position:absolute;left:50%;top:49%;width:72%;aspect-ratio:1;transform:translate(-50%,-50%);border:1px solid rgba(255,255,255,.08);border-radius:50%}\n#hn-vq-{{ vq_sid }} .rf__result-visual img{position:absolute;inset:44px 20px 38px;width:calc(100% - 40px);height:calc(100% - 82px);object-fit:contain;filter:drop-shadow(0 28px 34px rgba(0,0,0,.58))}\n#hn-vq-{{ vq_sid }} .rf__visual-meta,#hn-vq-{{ vq_sid }} .rf__visual-mark{position:absolute;left:20px;right:20px;z-index:2;font-size:8px;line-height:1;font-weight:750;letter-spacing:.1em;text-transform:uppercase}\n#hn-vq-{{ vq_sid }} .rf__visual-meta{top:18px;display:flex;align-items:center;justify-content:space-between}\n#hn-vq-{{ vq_sid }} .rf__visual-meta span,#hn-vq-{{ vq_sid }} .rf__visual-mark{color:rgba(255,255,255,.4)}\n#hn-vq-{{ vq_sid }} .rf__visual-mark{bottom:18px}\n#hn-vq-{{ vq_sid }} .rf__result-copy{max-width:680px}\n#hn-vq-{{ vq_sid }} .rf__result h3{margin:0;font-size:clamp(56px,7vw,102px);line-height:.86;font-weight:650;letter-spacing:-.072em}\n#hn-vq-{{ vq_sid }} .rf__reason{max-width:540px;margin:22px 0 0;color:rgba(255,255,255,.6);font-size:clamp(14px,1.2vw,17px);line-height:1.5;font-weight:500}\n#hn-vq-{{ vq_sid }} .rf__specs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:28px 0 0;padding:0;border-top:1px solid rgba(255,255,255,.13);border-bottom:1px solid rgba(255,255,255,.13)}\n#hn-vq-{{ vq_sid }} .rf__spec{padding:16px 12px 16px 0}\n#hn-vq-{{ vq_sid }} .rf__spec+.rf__spec{padding-left:12px;border-left:1px solid rgba(255,255,255,.1)}\n#hn-vq-{{ vq_sid }} .rf__spec dt{margin:0 0 6px;color:rgba(255,255,255,.4);font-size:8px;line-height:1;font-weight:750;letter-spacing:.1em;text-transform:uppercase}\n#hn-vq-{{ vq_sid }} .rf__spec dd{margin:0;font-size:11px;line-height:1.25;font-weight:650}\n#hn-vq-{{ vq_sid }} .rf__result-actions{display:flex;align-items:center;gap:12px;margin-top:28px}\n#hn-vq-{{ vq_sid }} .rf__alternatives{margin-top:24px;padding-top:17px;border-top:1px solid rgba