ade__racket--evo {\n    right: 50%;\n    top: 50%;\n    opacity: calc(.86 + (var(--progress) * .14));\n    filter: saturate(calc(1.08 + (var(--progress) * .38))) contrast(calc(1.06 + (var(--progress) * .18))) brightness(calc(1.02 + (var(--progress) * .18)));\n    transform:\n      translate(54%, -48%)\n      rotate(-16deg)\n      scale(calc(.94 + (var(--progress) * .14)));\n  }\n\n  .hn-duel-upgrade__divider {\n    position: absolute;\n    z-index: 12;\n    top: 0;\n    left: 50%;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%);\n    background: rgba(255,255,255,.14);\n  }\n\n  .hn-duel-upgrade__divider span {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 3px;\n    height: calc(22vh + (var(--progress) * 58vh));\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(var(--accent-rgb), .2),\n      var(--accent),\n      rgba(255,255,255,.9),\n      var(--accent),\n      rgba(var(--accent-rgb), .2),\n      transparent\n    );\n    box-shadow:\n      0 0 22px rgba(var(--accent-rgb), .72),\n      0 0 48px rgba(var(--accent-rgb), .38);\n  }\n\n  .hn-duel-upgrade__center-copy {\n    position: absolute;\n    z-index: 15;\n    left: 50%;\n    top: 50%;\n    width: min(520px, calc(100% - 40px));\n    transform:\n      translate(-50%, -50%)\n      scale(calc(.96 + (var(--progress) * .04)));\n    text-align: center;\n    pointer-events: none;\n  }\n\n  .hn-duel-upgrade__center-copy p {\n    margin: 0 0 12px;\n    color: var(--accent);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    text-shadow:\n      0 0 18px rgba(var(--accent-rgb), .58),\n      0 10px 30px rgba(0,0,0,.9);\n  }\n\n  .hn-duel-upgrade__center-copy h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(42px, 5.6vw, 92px);\n    line-height: .88;\n    font-weight: 950;\n    letter-spacing: -.075e