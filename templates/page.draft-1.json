      "settings": {
        "custom_liquid": "<section class=\"hn-evo-final\" id=\"hnEvoFinalStack\" aria-label=\"The Evolution Series\">\n  <div class=\"hn-evo-final__sticky\">\n    <div class=\"hn-evo-final__bg\"></div>\n\n    <div class=\"hn-evo-final__inner\">\n\n      <div class=\"hn-evo-final__copy\">\n        <p class=\"hn-evo-final__pill\">\n          <span></span>\n          Evolution Series\n        </p>\n\n        <h2 class=\"hn-evo-final__title\">Choose your edge.</h2>\n\n        <p class=\"hn-evo-final__text\">\n          Attack, speed, or precision. Three rackets built from the same DNA, tuned for the way you win.\n        </p>\n\n        <a class=\"hn-evo-final__button\" href=\"/collections/pro-series\">\n          Explore the series\n          <span>→</span>\n        </a>\n\n        <div class=\"hn-evo-final__progress\" aria-label=\"Evolution Series progress\">\n          <span class=\"hn-evo-final__progress-current\">01</span>\n\n          <div class=\"hn-evo-final__progress-track\">\n            <span class=\"hn-evo-final__progress-fill\"></span>\n          </div>\n\n          <span class=\"hn-evo-final__progress-total\">03</span>\n        </div>\n\n        <div class=\"hn-evo-final__scroll-hint\">\n          <span>↓</span>\n          <strong>Scroll</strong>\n        </div>\n      </div>\n\n      <div class=\"hn-evo-final__stage\">\n\n        <!-- CARD 1 -->\n        <a\n          class=\"hn-evo-final-card\"\n          href=\"https://in.hndrd.co/products/nitrix-thunder\"\n          aria-label=\"Shop Nitrix Thunder\"\n          style=\"--accent:#E4B433; --accent-rgb:228,180,51;\"\n        >\n          <div class=\"hn-evo-final-card__media\">\n            <span class=\"hn-evo-final-card__glow\"></span>\n            <span class=\"hn-evo-final-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1400\"\n              alt=\"Nitrix Thunder badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-final-card__scrim\"></div>\n\n          <div class=\"hn-evo-final-card__content\">\n            <span class=\"hn-evo-final-card__chip\">ATTACK</span>\n            <h3>Nitrix Thunder</h3>\n            <p>Power that ends rallies.</p>\n\n            <div class=\"hn-evo-final-card__meta\">\n              <span>₹3,990</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n        <!-- CARD 2 -->\n        <a\n          class=\"hn-evo-final-card\"\n          href=\"https://in.hndrd.co/products/flareon-typhoon\"\n          aria-label=\"Shop Flareon Typhoon\"\n          style=\"--accent:#48B8FF; --accent-rgb:72,184,255;\"\n        >\n          <div class=\"hn-evo-final-card__media\">\n            <span class=\"hn-evo-final-card__glow\"></span>\n            <span class=\"hn-evo-final-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1400\"\n              alt=\"Flareon Typhoon badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-final-card__scrim\"></div>\n\n          <div class=\"hn-evo-final-card__content\">\n            <span class=\"hn-evo-final-card__chip\">SPEED</span>\n            <h3>Flareon Typhoon</h3>\n            <p>Speed that gets there first.</p>\n\n            <div class=\"hn-evo-final-card__meta\">\n              <span>₹3,490</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n        <!-- CARD 3 -->\n        <a\n          class=\"hn-evo-final-card\"\n          href=\"https://in.hndrd.co/products/hyfonic-lazer-4u\"\n          aria-label=\"Shop Hyfonic Lazer\"\n          style=\"--accent:#43D7B6; --accent-rgb:67,215,182;\"\n        >\n          <div class=\"hn-evo-final-card__media\">\n            <span class=\"hn-evo-final-card__glow\"></span>\n            <span class=\"hn-evo-final-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_4e02ab1d-f883-4e7b-aa23-f35a0808d797.png?v=1761629738&width=1400\"\n              alt=\"Hyfonic Lazer badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-final-card__scrim\"></div>\n\n          <div class=\"hn-evo-final-card__content\">\n            <span class=\"hn-evo-final-card__chip\">PRECISION</span>\n            <h3>Hyfonic Lazer</h3>\n            <p>Precision that stays composed.</p>\n\n            <div class=\"hn-evo-final-card__meta\">\n              <span>₹3,490</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-evo-final,\n  .hn-evo-final *,\n  .hn-evo-final *::before,\n  .hn-evo-final *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-evo-final {\n    --hn-evo-progress: 0;\n    position: relative;\n    width: 100%;\n    height: 300vh;\n    background: #030303;\n    color: #ffffff;\n    overflow: visible;\n  }\n\n  .hn-evo-final__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 720px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    background: #030303;\n    isolation: isolate;\n  }\n\n  .hn-evo-final__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(circle at 72% 38%, rgba(255,255,255,0.07), transparent 18%),\n      radial-gradient(circle at 78% 42%, rgba(67,215,182,0.12), transparent 28%),\n      radial-gradient(circle at 20% 24%, rgba(228,180,51,0.09), transparent 24%),\n      linear-gradient(180deg, #030303 0%, #070707 52%, #030303 100%);\n    pointer-events: none;\n  }\n\n  .hn-evo-final__bg::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(rgba(255,255,255,0.024) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);\n    background-size: 54px 54px;\n    opacity: 0.22;\n    mask-image: radial-gradient(circle at 60% 45%, black 0%, transparent 72%);\n    -webkit-mask-image: radial-gradient(circle at 60% 45%, black 0%, transparent 72%);\n  }\n\n  .hn-evo-final__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1280px, calc(100% - 40px));\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr);\n    gap: clamp(44px, 7vw, 110px);\n    align-items: center;\n  }\n\n  .hn-evo-final__copy {\n    max-width: 540px;\n  }\n\n  .hn-evo-final__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin: 0 0 22px;\n    padding: 8px 12px 8px 9px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.94);\n    color: #060606;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-evo-final__pill span {\n    width: 16px;\n    height: 16px;\n    border-radius: 999px;\n    background:\n      radial-gradient(circle at 50% 50%, #ffffff 0 28%, transparent 30%),\n      #050505;\n    flex: 0 0 auto;\n  }\n\n  .hn-evo-final__title {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(54px, 7vw, 104px);\n    line-height: 0.88;\n    font-weight: 900;\n    letter-spacing: -0.075em;\n  }\n\n  .hn-evo-final__text {\n    margin: 22px 0 0;\n    max-width: 470px;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(16px, 1.35vw, 20px);\n    line-height: 1.45;\n    font-weight: 520;\n    letter-spacing: -0.025em;\n  }\n\n  .hn-evo-final__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 30px;\n    min-height: 42px;\n    padding: 12px 17px;\n    border-radius: 9px;\n    background: #ffffff;\n    color: #050505;\n    text-decoration: none;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.02em;\n    transition: transform 260ms ease, background 260ms ease;\n  }\n\n  .hn-evo-final__button:hover {\n    transform: translateY(-2px);\n    background: rgba(255,255,255,0.86);\n  }\n\n  .hn-evo-final__progress {\n    display: grid;\n    grid-template-columns: 24px minmax(160px, 260px) 24px;\n    align-items: center;\n    column-gap: 12px;\n    margin-top: 36px;\n    width: fit-content;\n  }\n\n  .hn-evo-final__progress-current,\n  .hn-evo-final__progress-total {\n    color: rgba(255,255,255,0.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .hn-evo-final__progress-track {\n    position: relative;\n    width: 100%;\n    height: 2px;\n    border-radius: 999px;\n    overflow: hidden;\n    background: rgba(255,255,255,0.18);\n  }\n\n  .hn-evo-final__progress-fill {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n    background: #ffffff;\n    transform-origin: left center;\n    transform: scaleX(var(--hn-evo-progress));\n    will-change: transform;\n  }\n\n  .hn-evo-final__scroll-hint {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 14px;\n    color: rgba(255,255,255,0.58);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    pointer-events: none;\n    transition: opacity 220ms ease, transform 220ms ease;\n  }\n\n  .hn-evo-final__scroll-hint span {\n    width: 18px;\n    height: 18px;\n    display: inline-grid;\n    place-items: center;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    color: #ffffff;\n    font-size: 12px;\n    animation: hnEvoFinalDownBlink 1.15s ease-in-out infinite;\n  }\n\n  .hn-evo-final__scroll-hint.is-hidden {\n    opacity: 0;\n    transform: translateY(-6px);\n  }\n\n  .hn-evo-final__stage {\n    position: relative;\n    width: min(470px, 100%);\n    height: 620px;\n    margin-left: auto;\n    overflow: visible;\n    perspective: 1200px;\n  }\n\n  .hn-evo-final-card {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: min(400px, 100%);\n    height: 550px;\n    display: block;\n    overflow: hidden;\n    border-radius: 24px;\n    color: #ffffff;\n    text-decoration: none;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.02)),\n      #17171a;\n    border: 1px solid rgba(255,255,255,0.13);\n    box-shadow:\n      0 28px 70px rgba(0,0,0,0.42),\n      inset 0 1px 0 rgba(255,255,255,0.10);\n    transform:\n      translate3d(-50%, -50%, 0)\n      translateY(var(--card-y, 0px))\n      scale(var(--card-scale, 1));\n    opacity: var(--card-opacity, 0);\n    z-index: var(--card-z, 1);\n    pointer-events: var(--card-events, none);\n    visibility: var(--card-visibility, hidden);\n    will-change: transform, opacity;\n    transition:\n      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),\n      box-shadow 320ms ease,\n      border-color 320ms ease;\n  }\n\n  .hn-evo-final-card.is-active {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n  }\n\n  .hn-evo-final-card:hover {\n    border-color: rgba(255,255,255,0.22);\n    box-shadow:\n      0 36px 95px rgba(0,0,0,0.55),\n      0 0 38px rgba(var(--accent-rgb),0.16),\n      inset 0 1px 0 rgba(255,255,255,0.14);\n  }\n\n  .hn-evo-final-card__media {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 38px 24px 168px;\n    background:\n      radial-gradient(circle at 50% 28%, rgba(var(--accent-rgb),0.18), transparent 30%),\n      linear-gradient(180deg, #202024 0%, #111115 100%);\n  }\n\n  .hn-evo-final-card__glow {\n    position: absolute;\n    left: 50%;\n    top: 35%;\n    width: 76%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(var(--accent-rgb),0.34), transparent 68%);\n    filter: blur(24px);\n    opacity: 0.86;\n    animation: hnEvoFinalGlow 4.8s ease-in-out infinite;\n  }\n\n  .hn-evo-final-card__ring {\n    position: absolute;\n    left: 50%;\n    top: 34%;\n    width: 72%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%) rotate(-16deg);\n    border: 1px solid rgba(255,255,255,0.10);\n    border-radius: 999px;\n    opacity: 0.85;\n  }\n\n  .hn-evo-final-card__media img {\n    position: relative;\n    z-index: 2;\n    display: block;\n    width: min(88%, 360px);\n    height: auto;\n    object-fit: contain;\n    transform: rotate(-8deg) translateY(8px) scale(1.08);\n    filter:\n      drop-shadow(0 24px 32px rgba(0,0,0,0.48))\n      drop-shadow(0 0 24px rgba(var(--accent-rgb),0.12));\n    animation: hnEvoFinalFloat 5s ease-in-out infinite;\n  }\n\n  .hn-evo-final-card__scrim {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 52%;\n    z-index: 3;\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,0.88) 0%,\n        rgba(0,0,0,0.70) 38%,\n        rgba(0,0,0,0.26) 72%,\n        rgba(0,0,0,0) 100%\n      );\n    pointer-events: none;\n  }\n\n  .hn-evo-final-card__content {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 4;\n    padding: 0 22px 24px;\n  }\n\n  .hn-evo-final-card__chip {\n    display: inline-flex;\n    align-items: center;\n    width: fit-content;\n    min-height: 24px;\n    padding: 0 9px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.92);\n    color: #080808;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.11em;\n  }\n\n  .hn-evo-final-card__content h3 {\n    margin: 14px 0 0;\n    color: #ffffff;\n    font-size: 34px;\n    line-height: 0.94;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n  }\n\n  .hn-evo-final-card__content p {\n    margin: 10px 0 0;\n    max-width: 300px;\n    color: rgba(255,255,255,0.76);\n    font-size: 14px;\n    line-height: 1.35;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-evo-final-card__meta {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: 18px;\n    color: rgba(255,255,255,0.95);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-evo-final-card__meta span:last-child {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 5px;\n    text-decoration-color: rgba(255,255,255,0);\n    transition: text-decoration-color 220ms ease;\n  }\n\n  .hn-evo-final-card:hover .hn-evo-final-card__meta span:last-child {\n    text-decoration-color: rgba(255,255,255,0.9);\n  }\n\n  @keyframes hnEvoFinalGlow {\n    0%, 100% {\n      opacity: 0.68;\n      transform: translate(-50%, -50%) scale(0.96);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.06);\n    }\n  }\n\n  @keyframes hnEvoFinalFloat {\n    0%, 100% {\n      translate: 0 0;\n    }\n\n    50% {\n      translate: 0 -10px;\n    }\n  }\n\n  @keyframes hnEvoFinalDownBlink {\n    0%, 100% {\n      opacity: 0.45;\n      transform: translateY(0);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translateY(5px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-evo-final {\n      height: 300vh;\n    }\n\n    .hn-evo-final__sticky {\n      height: 100svh;\n      min-height: 700px;\n      align-items: center;\n    }\n\n    .hn-evo-final__inner {\n      width: min(520px, calc(100% - 28px));\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .hn-evo-final__copy {\n      max-width: none;\n    }\n\n    .hn-evo-final__pill {\n      margin-bottom: 14px;\n      padding: 7px 11px 7px 8px;\n      font-size: 11px;\n    }\n\n    .hn-evo-final__pill span {\n      width: 14px;\n      height: 14px;\n    }\n\n    .hn-evo-final__title {\n      font-size: clamp(40px, 12vw, 58px);\n      line-height: 0.88;\n    }\n\n    .hn-evo-final__text {\n      margin-top: 14px;\n      max-width: 96%;\n      font-size: 14px;\n      line-height: 1.36;\n    }\n\n    .hn-evo-final__button {\n      display: none;\n    }\n\n    .hn-evo-final__progress {\n      grid-template-columns: 24px minmax(145px, 230px) 24px;\n      margin-top: 16px;\n    }\n\n    .hn-evo-final__scroll-hint {\n      margin-top: 11px;\n      font-size: 10px;\n    }\n\n    .hn-evo-final__scroll-hint span {\n      width: 16px;\n      height: 16px;\n      font-size: 11px;\n    }\n\n    .hn-evo-final__stage {\n      width: 100%;\n      height: 455px;\n      margin: 0 auto;\n    }\n\n    .hn-evo-final-card {\n      width: min(330px, 100%);\n      height: 430px;\n      border-radius: 22px;\n    }\n\n    .hn-evo-final-card__media {\n      padding: 28px 18px 140px;\n    }\n\n    .hn-evo-final-card__media img {\n      width: min(88%, 285px);\n      transform: rotate(-8deg) translateY(2px) scale(1.02);\n    }\n\n    .hn-evo-final-card__scrim {\n      height: 56%;\n    }\n\n    .hn-evo-final-card__content {\n      padding: 0 18px 20px;\n    }\n\n    .hn-evo-final-card__chip {\n      min-height: 22px;\n      padding: 0 8px;\n      font-size: 9px;\n    }\n\n    .hn-evo-final-card__content h3 {\n      margin-top: 12px;\n      font-size: 28px;\n    }\n\n    .hn-evo-final-card__content p {\n      margin-top: 8px;\n      font-size: 13px;\n      line-height: 1.3;\n      max-width: 260px;\n    }\n\n    .hn-evo-final-card__meta {\n      margin-top: 14px;\n      font-size: 12px;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    .hn-evo-final__sticky {\n      min-height: 680px;\n    }\n\n    .hn-evo-final__inner {\n      gap: 16px;\n    }\n\n    .hn-evo-final__stage {\n      height: 420px;\n    }\n\n    .hn-evo-final-card {\n      width: min(310px, 100%);\n      height: 400px;\n    }\n\n    .hn-evo-final-card__media img {\n      width: min(86%, 260px);\n    }\n\n    .hn-evo-final-card__content h3 {\n      font-size: 26px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-evo-final {\n      height: auto;\n    }\n\n    .hn-evo-final__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 72px 0;\n    }\n\n    .hn-evo-final__inner {\n      display: block;\n      width: min(520px, calc(100% - 28px));\n    }\n\n    .hn-evo-final__stage {\n      height: auto;\n      display: grid;\n      gap: 18px;\n      margin-top: 30px;\n    }\n\n    .hn-evo-final-card {\n      position: relative;\n      left: auto;\n      top: auto;\n      transform: none !important;\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n      width: 100%;\n    }\n\n    .hn-evo-final-card,\n    .hn-evo-final-card__media img,\n    .hn-evo-final-card__glow {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnEvoFinalStack');\n    if (!section || section.dataset.ready === 'true') return;\n\n    section.dataset.ready = 'true';\n\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-final-card'));\n    var fill = section.querySelector('.hn-evo-final__progress-fill');\n    var current = section.querySelector('.hn-evo-final__progress-current');\n    var total = section.querySelector('.hn-evo-final__progress-total');\n    var hint = section.querySelector('.hn-evo-final__scroll-hint');\n    var ticking = false;\n\n    if (!cards.length || !fill || !current || !total) return;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function pad(value) {\n      return String(value).padStart(2, '0');\n    }\n\n    function getProgress() {\n      var rect = section.getBoundingClientRect();\n      var viewport = window.innerHeight || document.documentElement.clientHeight;\n      var scrollable = section.offsetHeight - viewport;\n\n      if (scrollable <= 0) return 0;\n\n      return clamp(-rect.top / scrollable, 0, 1);\n    }\n\n    function update() {\n      var progress = getProgress();\n      var maxIndex = cards.length - 1;\n      var activeIndex = clamp(Math.round(progress * maxIndex), 0, maxIndex);\n\n      section.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n      fill.style.setProperty('transform', 'scaleX(' + progress.toFixed(4) + ')', 'important');\n\n      current.textContent = pad(activeIndex + 1);\n      total.textContent = pad(cards.length);\n\n      if (hint) {\n        hint.classList.toggle('is-hidden', progress > 0.08);\n      }\n\n      cards.forEach(function (card, index) {\n        var isActive = index === activeIndex;\n\n        card.classList.toggle('is-active', isActive);\n\n        if (isActive) {\n          card.style.setProperty('--card-y', '0px');\n          card.style.setProperty('--card-scale', '1');\n          card.style.setProperty('--card-opacity', '1');\n          card.style.setProperty('--card-z', '10');\n          card.style.setProperty('--card-events', 'auto');\n          card.style.setProperty('--card-visibility', 'visible');\n        } else if (index < activeIndex) {\n          card.style.setProperty('--card-y', '-180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        } else {\n          card.style.setProperty('--card-y', '180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        }\n      });\n\n      ticking = false;\n    }\n\n    function requestUpdate() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestUpdate, { passive: true });\n    window.addEventListener('resize', requestUpdate);\n    window.addEventListener('load', requestUpdate);\n\n    update();\n  })();\n</script>\n<style>\n  /* EVOLUTION SECTION — PITCH DARK + NO CTA */\n  #hnEvoFinalStack,\n  #hnEvoFinalStack .hn-evo-final__sticky,\n  #hnEvoFinalStack .hn-evo-final__bg {\n    background: #000000 !important;\n  }\n\n  /* remove Explore the series CTA */\n  #hnEvoFinalStack .hn-evo-final__button {\n    display: none !important;\n  }\n\n  /* remove light/grid background */\n  #hnEvoFinalStack .hn-evo-final__bg {\n    background: #000000 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__bg::before,\n  #hnEvoFinalStack .hn-evo-final__bg::after {\n    content: none !important;\n    display: none !important;\n    opacity: 0 !important;\n    background: none !important;\n  }\n\n  /* keep left content clean on black */\n  #hnEvoFinalStack .hn-evo-final__copy {\n    position: relative;\n    z-index: 3;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__pill {\n    background: rgba(255,255,255,0.94) !important;\n    color: #050505 !important;\n    box-shadow: 0 18px 44px rgba(0,0,0,.5);\n  }\n\n  #hnEvoFinalStack .hn-evo-final__title {\n    color: #ffffff !important;\n    text-shadow:\n      0 18px 50px rgba(0,0,0,.95),\n      0 0 18px rgba(255,255,255,.06);\n  }\n\n  #hnEvoFinalStack .hn-evo-final__text {\n    color: rgba(255,255,255,.74) !important;\n    text-shadow: 0 12px 34px rgba(0,0,0,.9);\n  }\n\n  /* darker progress area */\n  #hnEvoFinalStack .hn-evo-final__progress-current,\n  #hnEvoFinalStack .hn-evo-final__progress-total {\n    color: rgba(255,255,255,.76) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__progress-track {\n    background: rgba(255,255,255,.16) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__progress-fill {\n    background: #ffffff !important;\n    box-shadow: 0 0 18px rgba(255,255,255,.24);\n  }\n\n  /* make cards pitch dark, not grey */\n  #hnEvoFinalStack .hn-evo-final-card {\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)),\n      #000000 !important;\n    border-color: rgba(255,255,255,.16) !important;\n    box-shadow:\n      0 32px 90px rgba(0,0,0,.75),\n      inset 0 1px 0 rgba(255,255,255,.08) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card:hover {\n    border-color: rgba(255,255,255,.26) !important;\n    box-shadow:\n      0 42px 110px rgba(0,0,0,.86),\n      0 0 38px rgba(var(--accent-rgb),.16),\n      inset 0 1px 0 rgba(255,255,255,.12) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__media {\n    background:\n      radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb),.16), transparent 34%),\n      radial-gradient(circle at 50% 44%, rgba(255,255,255,.035), transparent 50%),\n      #030304 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__glow {\n    opacity: .7 !important;\n    filter: blur(28px) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__ring {\n    border-color: rgba(255,255,255,.12) !important;\n    opacity: .7 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__scrim {\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,.94) 0%,\n        rgba(0,0,0,.78) 38%,\n        rgba(0,0,0,.32) 72%,\n        rgba(0,0,0,0) 100%\n      ) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__chip {\n    background: rgba(255,255,255,.94) !important;\n    color: #050505 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__content h3 {\n    color: #ffffff !important;\n    text-shadow:\n      0 16px 38px rgba(0,0,0,.9),\n      0 0 14px rgba(255,255,255,.06);\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__content p {\n    color: rgba(255,255,255,.76) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__meta {\n    color: rgba(255,255,255,.95) !important;\n  }\n\n  /* remove scroll hint if it feels too busy */\n  #hnEvoFinalStack .hn-evo-final__scroll-hint {\n    color: rgba(255,255,255,.42) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__scroll-hint span {\n    background: rgba(255,255,255,.08) !important;\n  }\n</style>\n<style>\n  /* =========================================\n     MOBILE PERFORMANCE OPTIMIZATION\n     For Evolution Series section only\n  ========================================= */\n\n  @media screen and (max-width: 989px) {\n    #hnEvoFinalStack {\n      height: auto !important;\n      min-height: 0 !important;\n      background: #000000 !important;\n      overflow: hidden !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__sticky {\n      position: relative !important;\n      top: auto !important;\n      height: auto !important;\n      min-height: 0 !important;\n      overflow: hidden !important;\n      display: block !important;\n      padding: 58px 0 64px !important;\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__bg {\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__bg::before,\n    #hnEvoFinalStack .hn-evo-final__bg::after {\n      display: none !important;\n      content: none !important;\n      opacity: 0 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__inner {\n      width: 100% !important;\n      display: block !important;\n      padding: 0 !important;\n      margin: 0 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__copy {\n      width: min(440px, calc(100% - 32px)) !important;\n      max-width: none !important;\n      margin: 0 auto 28px !important;\n      padding: 0 !important;\n      text-align: left !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__pill {\n      margin-bottom: 14px !important;\n      font-size: 10.5px !important;\n      padding: 7px 11px 7px 8px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__pill span {\n      width: 14px !important;\n      height: 14px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__title {\n      font-size: clamp(42px, 13vw, 58px) !important;\n      line-height: .88 !important;\n      letter-spacing: -0.075em !important;\n      max-width: 8ch !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__text {\n      margin-top: 15px !important;\n      max-width: 32ch !important;\n      font-size: 14px !important;\n      line-height: 1.38 !important;\n      color: rgba(255,255,255,.74) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__button,\n    #hnEvoFinalStack .hn-evo-final__scroll-hint {\n      display: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__progress {\n      margin-top: 18px !important;\n      grid-template-columns: 22px minmax(130px, 210px) 22px !important;\n      column-gap: 10px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      width: 100% !important;\n      height: auto !important;\n      margin: 0 !important;\n      padding: 0 16px 12px !important;\n\n      display: flex !important;\n      gap: 14px !important;\n      overflow-x: auto !important;\n      overflow-y: hidden !important;\n      scroll-snap-type: x mandatory !important;\n      scroll-padding: 16px !important;\n      -webkit-overflow-scrolling: touch !important;\n\n      perspective: none !important;\n      contain: layout paint !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage::-webkit-scrollbar {\n      display: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      scrollbar-width: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      position: relative !important;\n      left: auto !important;\n      top: auto !important;\n\n      flex: 0 0 min(82vw, 330px) !important;\n      width: min(82vw, 330px) !important;\n      height: 430px !important;\n\n      transform: none !important;\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n      z-index: 1 !important;\n\n      scroll-snap-align: center !important;\n      scroll-snap-stop: always !important;\n\n      border-radius: 22px !important;\n      background: #050505 !important;\n      box-shadow:\n        0 18px 46px rgba(0,0,0,.72),\n        inset 0 0 0 1px rgba(255,255,255,.07) !important;\n\n      transition: none !important;\n      will-change: auto !important;\n      contain: layout paint !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card.is-active {\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media {\n      padding: 24px 16px 138px !important;\n      background:\n        radial-gradient(circle at 50% 34%, rgba(var(--accent-rgb),.14), transparent 42%),\n        #050505 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__glow {\n      width: 62% !important;\n      opacity: .44 !important;\n      filter: blur(18px) !important;\n      animation: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__ring {\n      width: 64% !important;\n      opacity: .45 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(82%, 260px) !important;\n      transform: rotate(-8deg) translateY(2px) scale(1) !important;\n      animation: none !important;\n      filter: drop-shadow(0 18px 24px rgba(0,0,0,.68)) !important;\n      will-change: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__scrim {\n      height: 58% !important;\n      background:\n        linear-gradient(\n          to top,\n          rgba(0,0,0,.96) 0%,\n          rgba(0,0,0,.78) 44%,\n          rgba(0,0,0,.26) 78%,\n          rgba(0,0,0,0) 100%\n        ) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content {\n      padding: 0 18px 20px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__chip {\n      min-height: 22px !important;\n      padding: 0 8px !important;\n      font-size: 9px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      margin-top: 12px !important;\n      font-size: 27px !important;\n      line-height: .96 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content p {\n      margin-top: 8px !important;\n      max-width: 260px !important;\n      font-size: 12.5px !important;\n      line-height: 1.32 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__meta {\n      margin-top: 14px !important;\n      font-size: 12px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card,\n    #hnEvoFinalStack .hn-evo-final-card *,\n    #hnEvoFinalStack .hn-evo-final-card *::before,\n    #hnEvoFinalStack .hn-evo-final-card *::after {\n      animation-duration: 0s !important;\n      transition-duration: 0s !important;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    #hnEvoFinalStack .hn-evo-final__sticky {\n      padding: 50px 0 58px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      flex-basis: min(84vw, 310px) !important;\n      width: min(84vw, 310px) !important;\n      height: 405px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(80%, 240px) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      font-size: 25px !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var section = document.getElementById('hnEvoFinalStack');\n  if (!section || section.dataset.mobileOptimized === 'true') return;\n  section.dataset.mobileOptimized = 'true';\n\n  function isMobile() {\n    return window.matchMedia('(max-width: 989px)').matches;\n  }\n\n  function optimizeMobileImages() {\n    if (!isMobile()) return;\n\n    var imgs = section.querySelectorAll('.hn-evo-final-card__media img');\n\n    imgs.forEach(function (img) {\n      img.loading = 'lazy';\n      img.decoding = 'async';\n\n      try {\n        img.fetchPriority = 'low';\n      } catch (e) {}\n\n      if (img.src && img.src.indexOf('width=1400') > -1) {\n        img.src = img.src.replace('width=1400', 'width=700');\n      }\n\n      if (img.getAttribute('src') && img.getAttribute('src').indexOf('width=1400') > -1) {\n        img.setAttribute('src', img.getAttribute('src').replace('width=1400', 'width=700'));\n      }\n    });\n  }\n\n  function forceMobileFinalState() {\n    if (!isMobile()) return;\n\n    var cards = section.querySelectorAll('.hn-evo-final-card');\n    var current = section.querySelector('.hn-evo-final__progress-current');\n    var total = section.querySelector('.hn-evo-final__progress-total');\n    var fill = section.querySelector('.hn-evo-final__progress-fill');\n\n    section.style.setProperty('--hn-evo-progress', '1');\n\n    if (current) current.textContent = '01';\n    if (total) total.textContent = String(cards.length).padStart(2, '0');\n    if (fill) fill.style.setProperty('transform', 'scaleX(1)', 'important');\n\n    cards.forEach(function (card) {\n      card.classList.add('is-active');\n\n      card.style.setProperty('--card-y', '0px', 'important');\n      card.style.setProperty('--card-scale', '1', 'important');\n      card.style.setProperty('--card-opacity', '1', 'important');\n      card.style.setProperty('--card-z', '1', 'important');\n      card.style.setProperty('--card-events', 'auto', 'important');\n      card.style.setProperty('--card-visibility', 'visible', 'important');\n\n      card.style.opacity = '1';\n      card.style.visibility = 'visible';\n      card.style.pointerEvents = 'auto';\n    });\n  }\n\n  function runMobileLite() {\n    optimizeMobileImages();\n    forceMobileFinalState();\n  }\n\n  runMobileLite();\n\n  window.addEventListener('resize', runMobileLite, { passive: true });\n  window.addEventListener('orientationchange', function () {\n    setTimeout(runMobileLite, 120);\n  });\n\n  setTimeout(runMobileLite, 300);\n})();\n</script>\n<style>\n  /* =========================================\n     DESKTOP / TABLET RESTORE FIX\n     Mobile swipe only under 750px\n  ========================================= */\n\n  @media screen and (min-width: 750px) {\n    #hnEvoFinalStack {\n      height: 300vh !important;\n      overflow: visible !important;\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__sticky {\n      position: sticky !important;\n      top: 0 !important;\n      width: 100% !important;\n      height: 100vh !important;\n      min-height: 720px !important;\n      overflow: hidden !important;\n      display: flex !important;\n      align-items: center !important;\n      padding: 0 !important;\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__inner {\n      position: relative !important;\n      z-index: 2 !important;\n      width: min(1280px, calc(100% - 40px)) !important;\n      margin: 0 auto !important;\n      padding: 0 !important;\n      display: grid !important;\n      grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr) !important;\n      gap: clamp(44px, 7vw, 110px) !important;\n      align-items: center !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__copy {\n      width: auto !important;\n      max-width: 540px !important;\n      margin: 0 !important;\n      text-align: left !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__title {\n      font-size: clamp(54px, 7vw, 104px) !important;\n      line-height: 0.88 !important;\n      max-width: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__text {\n      max-width: 470px !important;\n      font-size: clamp(16px, 1.35vw, 20px) !important;\n      line-height: 1.45 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__progress {\n      display: grid !important;\n      grid-template-columns: 24px minmax(160px, 260px) 24px !important;\n      margin-top: 36px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      position: relative !important;\n      width: min(470px, 100%) !important;\n      height: 620px !important;\n      margin-left: auto !important;\n      padding: 0 !important;\n      display: block !important;\n      overflow: visible !important;\n      perspective: 1200px !important;\n      contain: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      position: absolute !important;\n      left: 50% !important;\n      top: 50% !important;\n      flex: none !important;\n\n      width: min(400px, 100%) !important;\n      height: 550px !important;\n\n      transform:\n        translate3d(-50%, -50%, 0)\n        translateY(var(--card-y, 0px))\n        scale(var(--card-scale, 1)) !important;\n\n      opacity: var(--card-opacity, 0) !important;\n      z-index: var(--card-z, 1) !important;\n      pointer-events: var(--card-events, none) !important;\n      visibility: var(--card-visibility, hidden) !important;\n\n      scroll-snap-align: none !important;\n      scroll-snap-stop: normal !important;\n\n      border-radius: 24px !important;\n      background:\n        linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)),\n        #000000 !important;\n\n      box-shadow:\n        0 32px 90px rgba(0,0,0,.75),\n        inset 0 1px 0 rgba(255,255,255,.08) !important;\n\n      transition:\n        transform 500ms cubic-bezier(0.22, 1, 0.36, 1),\n        box-shadow 320ms ease,\n        border-color 320ms ease !important;\n\n      will-change: transform, opacity !important;\n      contain: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card.is-active {\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media {\n      padding: 38px 24px 168px !important;\n      background:\n        radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb),.16), transparent 34%),\n        radial-gradient(circle at 50% 44%, rgba(255,255,255,.035), transparent 50%),\n        #030304 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__glow {\n      width: 76% !important;\n      opacity: .7 !important;\n      filter: blur(28px) !important;\n      animation: hnEvoFinalGlow 4.8s ease-in-out infinite !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__ring {\n      width: 72% !important;\n      opacity: .7 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(88%, 360px) !important;\n      transform: rotate(-8deg) translateY(8px) scale(1.08) !important;\n      animation: hnEvoFinalFloat 5s ease-in-out infinite !important;\n      filter:\n        drop-shadow(0 24px 32px rgba(0,0,0,.48))\n        drop-shadow(0 0 24px rgba(var(--accent-rgb),.12)) !important;\n      will-change: transform !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content {\n      padding: 0 22px 24px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      font-size: 34px !important;\n      line-height: .94 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content p {\n      font-size: 14px !important;\n      line-height: 1.35 !important;\n      max-width: 300px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__meta {\n      font-size: 13px !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var section = document.getElementById('hnEvoFinalStack');\n  if (!section || section.dataset.desktopRestore === 'true') return;\n  section.dataset.desktopRestore = 'true';\n\n  var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-final-card'));\n  var fill = section.querySelector('.hn-evo-final__progress-fill');\n  var current = section.querySelector('.hn-evo-final__progress-current');\n  var total = section.querySelector('.hn-evo-final__progress-total');\n  var hint = section.querySelector('.hn-evo-final__scroll-hint');\n  var ticking = false;\n\n  function isDesktopMode() {\n    return window.matchMedia('(min-width: 750px)').matches;\n  }\n\n  function clamp(value, min, max) {\n    return Math.min(Math.max(value, min), max);\n  }\n\n  function pad(value) {\n    return String(value).padStart(2, '0');\n  }\n\n  function updateDesktopCards() {\n    if (!isDesktopMode()) {\n      ticking = false;\n      return;\n    }\n\n    var rect = section.getBoundingClientRect();\n    var viewport = window.innerHeight || document.documentElement.clientHeight;\n    var scrollable = section.offsetHeight - viewport;\n    var progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;\n\n    var maxIndex = cards.length - 1;\n    var activeIndex = clamp(Math.round(progress * maxIndex), 0, maxIndex);\n\n    section.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n\n    if (fill) {\n      fill.style.setProperty('transform', 'scaleX(' + progress.toFixed(4) + ')', 'important');\n    }\n\n    if (current) current.textContent = pad(activeIndex + 1);\n    if (total) total.textContent = pad(cards.length);\n\n    if (hint) {\n      hint.classList.toggle('is-hidden', progress > 0.08);\n    }\n\n    cards.forEach(function (card, index) {\n      var isActive = index === activeIndex;\n\n      card.classList.toggle('is-active', isActive);\n\n      if (isActive) {\n        card.style.setProperty('--card-y', '0px', 'important');\n        card.style.setProperty('--card-scale', '1', 'important');\n        card.style.setProperty('--card-opacity', '1', 'important');\n        card.style.setProperty('--card-z', '10', 'important');\n        card.style.setProperty('--card-events', 'auto', 'important');\n        card.style.setProperty('--card-visibility', 'visible', 'important');\n      } else if (index < activeIndex) {\n        card.style.setProperty('--card-y', '-180px', 'important');\n        card.style.setProperty('--card-scale', '0.96', 'important');\n        card.style.setProperty('--card-opacity', '0', 'important');\n        card.style.setProperty('--card-z', '1', 'important');\n        card.style.setProperty('--card-events', 'none', 'important');\n        card.style.setProperty('--card-visibility', 'hidden', 'important');\n      } else {\n        card.style.setProperty('--card-y', '180px', 'important');\n        card.style.setProperty('--card-scale', '0.96', 'important');\n        card.style.setProperty('--card-opacity', '0', 'important');\n        card.style.setProperty('--card-z', '1', 'important');\n        card.style.setProperty('--card-events', 'none', 'important');\n        card.style.setProperty('--card-visibility', 'hidden', 'important');\n      }\n    });\n\n    ticking = false;\n  }\n\n  function requestUpdate() {\n    if (!ticking) {\n      window.requestAnimationFrame(updateDesktopCards);\n      ticking = true;\n    }\n  }\n\n  window.addEventListener('scroll', requestUpdate, { passive: true });\n  window.addEventListener('resize', requestUpdate);\n  window.addEventListener('orientationchange', function () {\n    setTimeout(requestUpdate, 120);\n  });\n\n  requestUpdate();\n})();\n</script>",
