top: 22px;\n    }\n\n    .hn-duel-upgrade__label--right {\n      top: auto;\n      right: 18px;\n      bottom: 108px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(68vw, 430px);\n    }\n\n    .hn-duel-upgrade__racket--prime {\n      left: 50%;\n      top: 24%;\n      transform:\n        translate(-52%, -50%)\n        rotate(-18deg)\n        scale(calc(.78 - (var(--progress) * .05)));\n    }\n\n    .hn-duel-upgrade__racket--evo {\n      right: auto;\n      left: 50%;\n      top: 72%;\n      transform:\n        translate(-48%, -50%)\n        rotate(-18deg)\n        scale(calc(.9 + (var(--progress) * .12)));\n    }\n\n    .hn-duel-upgrade__center-copy {\n      top: 50%;\n      width: min(360px, calc(100% - 34px));\n      padding: 16px 14px 18px;\n      border: 1px solid rgba(255,255,255,.1);\n      border-radius: 26px;\n      background: rgba(0,0,0,.36);\n      backdrop-filter: blur(16px);\n    }\n\n    .hn-duel-upgrade__center-copy h3 {\n      font-size: clamp(34px, 10vw, 48px);\n    }\n\n    .hn-duel-upgrade__center-copy small {\n      margin-top: 12px;\n      font-size: 12px;\n    }\n\n    .hn-duel-upgrade__bottom {\n      width: calc(100% - 28px);\n      grid-template-columns: 1fr;\n      gap: 12px;\n      border-radius: 24px;\n      padding: 14px;\n      bottom: 16px;\n      text-align: center;\n    }\n\n    .hn-duel-upgrade__bottom div,\n    .hn-duel-upgrade__bottom div:last-child {\n      text-align: center;\n      align-items: center;\n    }\n\n    .hn-duel-upgrade__cta {\n      width: 100%;\n      min-height: 46px;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-duel-upgrade__sticky {\n      min-height: 650px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(78vw, 390px);\n    }\n\n    .hn-duel-upgrade__label strong {\n      font-size: 20px;\n    }\n\n    .hn-duel-upgrade__bottom strong {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnDuelUpgrade');\n    if (!section || section.dataset.hnDuelReady === 'true') return;\n\n    section.dataset.hnDuelReady = 'true';\n\n    var scenes = Array.prototype.slice.call(section.querySelectorAll('[data-duel-scene]'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function updateScenes() {\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n\n      scenes.forEach(function (scene) {\n        var rect = scene.getBoundingClientRect();\n        var total = Math.max(rect.height - vh, 1);\n        var progress = clamp(-rect.top / total, 0, 1);\n        var eased = easeInOutSine(progress);\n\n        scene.style.setProperty('--progress', eased.toFixed(3));\n      });\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateScenes);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    updateScenes();\n  })();\n</script>",
