    "custom_liquid_pCGxF3": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD SERIES VAULT\n  Paste this complete block inside a Shopify \"Custom liquid\" section.\n\n  OPTIONAL:\n  Replace the three --image values below with your own Shopify CDN image URLs.\n{% endcomment %}\n\n{% assign hsv_id = section.id | default: 'hndrd-series-vault' %}\n\n<section id=\"hsv-{{ hsv_id }}\" class=\"hsv\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hsv__intro\">\n    <p class=\"hsv__eyebrow\">CHOOSE YOUR SERIES</p>\n    <h2 class=\"hsv__heading\">Three ways to play.</h2>\n    <p class=\"hsv__subheading\">Open a series. Find your frame.</p>\n  </div>\n\n  <div class=\"hsv__vault\">\n    <article\n      class=\"hsv__panel is-active\"\n      style=\"--accent:#ff6a00;--image:url('');\"\n      data-panel\n    >\n      <div class=\"hsv__media\" aria-hidden=\"true\"></div>\n      <button class=\"hsv__trigger\" type=\"button\" aria-expanded=\"true\">\n        <span class=\"hsv__index\">01</span>\n        <span class=\"hsv__spine\">PRO SERIES</span>\n        <span class=\"hsv__plus\" aria-hidden=\"true\"></span>\n      </button>\n\n      <div class=\"hsv__content\">\n        <div class=\"hsv__topline\">\n          <span>HNDRD PERFORMANCE</span>\n          <span>04 RACKETS</span>\n        </div>\n\n        <div class=\"hsv__copy\">\n          <p class=\"hsv__kicker\">Built for the highest level</p>\n          <h3>PRO<br>SERIES</h3>\n\n          <ul class=\"hsv__models\" aria-label=\"Pro Series rackets\">\n            <li>Nitrix 70 Venom</li>\n            <li>Nitrix 70 Volta</li>\n            <li>Hyfonic 7</li>\n            <li>Flareon 700</li>\n          </ul>\n\n          <a class=\"hsv__cta\" href=\"https://in.hndrd.co/pages/pro-series-rackets\">\n            <span>Enter Pro Series</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"hsv__mark\" aria-hidden=\"true\">PRO</div>\n      </div>\n    </article>\n\n    <article\n      class=\"hsv__panel\"\n      style=\"--accent:#d6ff00;--image:url('');\"\n      data-panel\n    >\n      <div class=\"hsv__media\" aria-hidden=\"true\"></div>\n      <button class=\"hsv__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"hsv__index\">02</span>\n        <span class=\"hsv__spine\">PRIME TRINITY</span>\n        <span class=\"hsv__plus\" aria-hidden=\"true\"></span>\n      </button>\n\n      <div class=\"hsv__content\">\n        <div class=\"hsv__topline\">\n          <span>ONE GAME. THREE PERSONALITIES.</span>\n          <span>03 RACKETS</span>\n        </div>\n\n        <div class=\"hsv__copy\">\n          <p class=\"hsv__kicker\">Choose your personality</p>\n          <h3>PRIME<br>TRINITY</h3>\n\n          <ul class=\"hsv__models\" aria-label=\"Prime Trinity rackets\">\n            <li>Nitrix 10</li>\n            <li>Flareon 100</li>\n            <li>Hyfonic 1</li>\n          </ul>\n\n          <a class=\"hsv__cta\" href=\"https://in.hndrd.co/pages/the-prime-trinity\">\n            <span>Enter Prime Trinity</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"hsv__mark\" aria-hidden=\"true\">III</div>\n      </div>\n    </article>\n\n    <article\n      class=\"hsv__panel\"\n      style=\"--accent:#55d9ff;--image:url('');\"\n      data-panel\n    >\n      <div class=\"hsv__media\" aria-hidden=\"true\"></div>\n      <button class=\"hsv__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"hsv__index\">03</span>\n        <span class=\"hsv__spine\">EVOLUTION SERIES</span>\n        <span class=\"hsv__plus\" aria-hidden=\"true\"></span>\n      </button>\n\n      <div class=\"hsv__content\">\n        <div class=\"hsv__topline\">\n          <span>ATTACK. SPEED. PRECISION.</span>\n          <span>03 RACKETS</span>\n        </div>\n\n        <div class=\"hsv__copy\">\n          <p class=\"hsv__kicker\">Three distinct expressions</p>\n          <h3>EVOLUTION<br>SERIES</h3>\n\n          <ul class=\"hsv__models\" aria-label=\"Evolution Series rackets\">\n            <li>Nitrix Thunder</li>\n            <li>Flareon Typhoon</li>\n            <li>Hyfonic Lazer</li>\n          </ul>\n\n          <a class=\"hsv__cta\" href=\"https://in.hndrd.co/pages/pro-series\">\n            <span>Enter Evolution Series</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"hsv__mark\" aria-hidden=\"true\">EVO</div>\n      </div>\n    </article>\n  </div>\n</section>\n\n<style>\n  #hsv-{{ hsv_id }} {\n    --bg: #080808;\n    --line: rgba(255,255,255,.14);\n    --muted: rgba(255,255,255,.64);\n    --ease: cubic-bezier(.2,.75,.2,1);\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    background: var(--bg);\n    color: #fff;\n    font-family: Figtree, Arial, sans-serif;\n  }\n\n  #hsv-{{ hsv_id }} *,\n  #hsv-{{ hsv_id }} *::before,\n  #hsv-{{ hsv_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__intro {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: end;\n    gap: 20px;\n    padding: clamp(42px,6vw,88px) clamp(20px,4.5vw,72px) clamp(24px,3vw,42px);\n    border-bottom: 1px solid var(--line);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__eyebrow {\n    grid-column: 1 / -1;\n    margin: 0 0 4px;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .19em;\n    color: var(--muted);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__heading {\n    margin: 0;\n    max-width: 820px;\n    font-size: clamp(38px,5vw,78px);\n    line-height: .92;\n    letter-spacing: -.055em;\n    font-weight: 700;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__subheading {\n    margin: 0 0 5px;\n    font-size: 13px;\n    letter-spacing: .02em;\n    color: var(--muted);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__vault {\n    display: flex;\n    height: min(720px,78vh);\n    min-height: 560px;\n    overflow: hidden;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__panel {\n    position: relative;\n    flex: 1 1 0;\n    min-width: 86px;\n    overflow: hidden;\n    isolation: isolate;\n    border-right: 1px solid var(--line);\n    background:\n      radial-gradient(circle at 78% 16%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 32%),\n      linear-gradient(135deg,#111 0%,#080808 72%);\n    transition: flex .85s var(--ease), background .5s ease;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__panel:last-child {\n    border-right: 0;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__panel.is-active {\n    flex: 5.4 1 0;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__media {\n    position: absolute;\n    inset: 0;\n    z-index: -2;\n    background-image:\n      linear-gradient(90deg,rgba(6,6,6,.88) 0%,rgba(6,6,6,.42) 54%,rgba(6,6,6,.76) 100%),\n      var(--image);\n    background-size: cover;\n    background-position: center;\n    transform: scale(1.055);\n    opacity: .74;\n    transition: transform 1.2s var(--ease), opacity .7s ease;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__panel.is-active .hsv__media {\n    transform: scale(1);\n    opacity: 1;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__panel::after {\n    content: \"\";\n    position: absolute;\n    inset: auto 0 0;\n    height: 42%;\n    z-index: -1;\n    background: linear-gradient(0deg,rgba(0,0,0,.94),transparent);\n    pointer-events: none;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__trigger {\n    position: absolute;\n    inset: 0 auto 0 0;\n    z-index: 5;\n    width: 86px;\n    padding: 22px 0;\n    border: 0;\n    border-right: 1px solid var(--line);\n    background: rgba(5,5,5,.46);\n    color: #fff;\n    cursor: pointer;\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__index {\n    position: absolute;\n    top: 22px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    color: var(--muted);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__spine {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: max-content;\n    transform: translate(-50%,-50%) rotate(-90deg);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: .2em;\n    white-space: nowrap;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__plus {\n    position: absolute;\n    left: 50%;\n    bottom: 24px;\n    width: 17px;\n    height: 17px;\n    transform: translateX(-50%);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__plus::before,\n  #hsv-{{ hsv_id }} .hsv__plus::after {\n    content: \"\";\n    position: absolute;\n    background: #fff;\n    transition: transform .45s var(--ease);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__plus::before {\n    left: 0;\n    top: 8px;\n    width: 17px;\n    height: 1px;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__plus::after {\n    left: 8px;\n    top: 0;\n    width: 1px;\n    height: 17px;\n  }\n\n  #hsv-{{ hsv_id }} .is-active .hsv__plus::after {\n    transform: rotate(90deg);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__content {\n    position: absolute;\n    inset: 0 0 0 86px;\n    padding: clamp(28px,3.6vw,58px);\n    opacity: 0;\n    transform: translateX(35px);\n    pointer-events: none;\n    transition:\n      opacity .3s ease,\n      transform .75s var(--ease);\n  }\n\n  #hsv-{{ hsv_id }} .is-active .hsv__content {\n    opacity: 1;\n    transform: translateX(0);\n    pointer-events: auto;\n    transition-delay: .18s;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__topline {\n    display: flex;\n    justify-content: space-between;\n    gap: 20px;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    color: var(--muted);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__copy {\n    position: absolute;\n    left: clamp(28px,3.6vw,58px);\n    bottom: clamp(34px,5vw,74px);\n    z-index: 2;\n    max-width: 620px;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__kicker {\n    margin: 0 0 12px;\n    color: var(--accent);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__copy h3 {\n    margin: 0;\n    max-width: 620px;\n    font-size: clamp(52px,7vw,112px);\n    line-height: .78;\n    letter-spacing: -.065em;\n    font-weight: 750;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__models {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 18px;\n    margin: 27px 0 30px;\n    padding: 0;\n    list-style: none;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__models li {\n    position: relative;\n    padding-left: 13px;\n    font-size: clamp(12px,1vw,15px);\n    font-weight: 550;\n    letter-spacing: .015em;\n    color: rgba(255,255,255,.82);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__models li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: .55em;\n    width: 5px;\n    height: 5px;\n    border-radius: 50%;\n    background: var(--accent);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 17px;\n    min-height: 48px;\n    padding: 0 8px 0 20px;\n    border: 1px solid rgba(255,255,255,.46);\n    border-radius: 999px;\n    color: #fff;\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .055em;\n    text-transform: uppercase;\n    transition: color .3s ease, background .3s ease, border-color .3s ease;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__cta svg {\n    width: 34px;\n    height: 34px;\n    padding: 9px;\n    border-radius: 50%;\n    background: var(--accent);\n    color: #080808;\n    transition: transform .35s var(--ease);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__cta path {\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__cta:hover {\n    background: #fff;\n    border-color: #fff;\n    color: #080808;\n  }\n\n  #hsv-{{ hsv_id }} .hsv__cta:hover svg {\n    transform: translateX(3px);\n  }\n\n  #hsv-{{ hsv_id }} .hsv__mark {\n    position: absolute;\n    right: -1.5vw;\n    bottom: -3vw;\n    z-index: 0;\n    color: rgba(255,255,255,.035);\n    font-size: clamp(130px,22vw,360px);\n    line-height: .7;\n    font-weight: 800;\n    letter-spacing: -.09em;\n    pointer-events: none;\n  }\n\n  @media (hover:hover) and (min-width: 990px) {\n    #hsv-{{ hsv_id }} .hsv__panel:not(.is-active):hover {\n      background-color: #111;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__trigger:hover .hsv__spine {\n      color: var(--accent);\n    }\n  }\n\n  @media (max-width: 989px) {\n    #hsv-{{ hsv_id }} .hsv__intro {\n      grid-template-columns: 1fr;\n      padding: 42px 20px 24px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__subheading {\n      margin: 0;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__vault {\n      display: block;\n      height: auto;\n      min-height: 0;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__panel,\n    #hsv-{{ hsv_id }} .hsv__panel.is-active {\n      min-width: 0;\n      height: 76px;\n      border-right: 0;\n      border-bottom: 1px solid var(--line);\n      transition: height .72s var(--ease);\n    }\n\n    #hsv-{{ hsv_id }} .hsv__panel.is-active {\n      height: min(650px,78svh);\n      min-height: 520px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__trigger {\n      inset: 0 0 auto;\n      width: 100%;\n      height: 76px;\n      padding: 0 20px;\n      border-right: 0;\n      border-bottom: 1px solid var(--line);\n      background: rgba(8,8,8,.78);\n      text-align: left;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__index {\n      top: 50%;\n      left: 20px;\n      transform: translateY(-50%);\n    }\n\n    #hsv-{{ hsv_id }} .hsv__spine {\n      left: 58px;\n      top: 50%;\n      transform: translateY(-50%);\n      font-size: 12px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__plus {\n      left: auto;\n      right: 20px;\n      bottom: 50%;\n      transform: translateY(50%);\n    }\n\n    #hsv-{{ hsv_id }} .hsv__content {\n      inset: 76px 0 0;\n      padding: 24px 20px;\n      transform: translateY(22px);\n    }\n\n    #hsv-{{ hsv_id }} .is-active .hsv__content {\n      transform: translateY(0);\n    }\n\n    #hsv-{{ hsv_id }} .hsv__topline {\n      font-size: 8px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__copy {\n      left: 20px;\n      right: 20px;\n      bottom: 28px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__copy h3 {\n      font-size: clamp(48px,14vw,78px);\n      line-height: .82;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__models {\n      display: grid;\n      grid-template-columns: repeat(2,minmax(0,1fr));\n      gap: 9px 12px;\n      margin: 20px 0 23px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__models li {\n      font-size: 12px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__mark {\n      right: -12px;\n      bottom: -6px;\n      font-size: 42vw;\n    }\n  }\n\n  @media (max-width: 480px) {\n    #hsv-{{ hsv_id }} .hsv__panel.is-active {\n      height: 570px;\n      min-height: 570px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__heading {\n      font-size: 42px;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__topline span:last-child {\n      display: none;\n    }\n\n    #hsv-{{ hsv_id }} .hsv__copy h3 {\n      font-size: clamp(44px,15vw,66px);\n    }\n\n    #hsv-{{ hsv_id }} .hsv__cta {\n      width: 100%;\n      justify-content: space-between;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hsv-{{ hsv_id }} *,\n    #hsv-{{ hsv_id }} *::before,\n    #hsv-{{ hsv_id }} *::after {\n      scroll-behavior: auto !important;\n      transition-duration: .01ms !important;\n      animation-duration: .01ms !important;\n      animation-iteration-count: 1 !important;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hsv-{{ hsv_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const panels = [...root.querySelectorAll('[data-panel]')];\n\n  const activate = (target) => {\n    panels.forEach((panel) => {\n      const active = panel === target;\n      panel.classList.toggle('is-active', active);\n      panel.querySelector('.hsv__trigger')\n        ?.setAttribute('aria-expanded', String(active));\n    });\n  };\n\n  panels.forEach((panel) => {\n    const trigger = panel.querySelector('.hsv__trigger');\n\n    trigger?.addEventListener('click', () => activate(panel));\n\n    if (window.matchMedia('(hover:hover) and (min-width:990px)').matches) {\n      panel.addEventListener('mouseenter', () => activate(panel));\n    }\n  });\n})();\n</script>",
