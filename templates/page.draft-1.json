on: transform 0.25s ease;\n  }\n\n  .hn-member-access__cta:hover {\n    transform: translateY(-2px);\n    box-shadow:\n      0 0 34px rgba(var(--accent-rgb),0.4),\n      inset 0 0 0 1px rgba(var(--accent-rgb),0.16);\n  }\n\n  .hn-member-access__cta:hover span {\n    transform: translateX(4px);\n  }\n\n  @keyframes hnMemberSpin {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n\n  @keyframes hnMemberSpinReverse {\n    from { transform: rotate(360deg); }\n    to { transform: rotate(0deg); }\n  }\n\n  @keyframes hnMemberPulseDot {\n    0%, 100% {\n      transform: translate(-50%, -50%) scale(0.92);\n      opacity: 0.85;\n    }\n    50% {\n      transform: translate(-50%, -50%) scale(1.12);\n      opacity: 1;\n    }\n  }\n\n  @media screen and (max-width: 1180px) and (min-width: 990px) {\n    .hn-member-access__cards {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      width: min(900px, 100%);\n      margin: 0 auto;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-member-access {\n      height: auto;\n      min-height: 100svh;\n      overflow: hidden;\n      background: #000000;\n    }\n\n    .hn-member-access__sticky {\n      position: relative;\n      height: auto;\n      min-height: 100svh;\n      overflow: hidden;\n      background: #000000;\n    }\n\n    .hn-member-access__dark-bg {\n      background:\n        radial-gradient(circle at 50% -10%, rgba(255,255,255,0.02), transparent 24%),\n        radial-gradient(circle at 14% 14%, rgba(25,184,74,0.03), transparent 22%),\n        radial-gradient(circle at 86% 16%, rgba(31,126,216,0.028), transparent 24%),\n        #000000;\n    }\n\n    .hn-member-access__gate {\n      position: absolute;\n      inset: 0;\n      z-index: 999;\n      min-height: 100svh;\n      pointer-events: auto;\n      opacity: 1;\n      visibility: visible;\n      background: #000000;\n    }\n\n    .hn-member-access.is-unlocked .hn-member-access__gate {\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n      transition: opacity 0.45s ease, visibility 0.45s ease;\n      transition-delay: 0.72s;\n    }\n\n    .hn-member-access__gate-panel {\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.01), transparent 24%, rgba(255,255,255,0.006)),\n        #000000;\n      transition: transform 0.85s cubic-bezier(.2,.8,.2,1);\n    }\n\n    .hn-member-access__gate-panel span {\n      font-size: clamp(54px, 16vw, 98px);\n      color: rgba(255,255,255,0.045);\n    }\n\n    .hn-member-access__gate-panel--left span {\n      right: -6vw;\n    }\n\n    .hn-member-access__gate-panel--right span {\n      left: -6vw;\n    }\n\n    .hn-member-access__lock {\n      top: 47%;\n      width: min(310px, calc(100% - 28px));\n      transform: translate(-50%, -50%);\n    }\n\n    .hn-member-access__lock-mark {\n      width: 76px;\n      height: 76px;\n      margin-bottom: 18px;\n    }\n\n    .hn-member-access__lock-mark::before {\n      inset: 10px;\n    }\n\n    .hn-member-access__lock-mark::after {\n      inset: 21px;\n    }\n\n    .hn-member-access__lock h3 {\n      font-size: clamp(28px, 9vw, 44px);\n      line-height: 0.94;\n      max-width: 280px;\n      margin-left: auto;\n      margin-right: auto;\n    }\n\n    .hn-member-access__lock p {\n      font-size: 10px;\n      margin-bottom: 12px;\n    }\n\n    .hn-member-access__mobile-unlock {\n      margin: 22px auto 0;\n      min-height: 46px;\n      padding: 0 24px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 999px;\n      border: 1.5px solid transparent;\n      background:\n        linear-gradient(#000000, #000000) padding-box,\n        linear-gradient(90deg, #19b84a, #1f7ed8, #6f42d8, #ff3b24) border-box;\n      color: #fff;\n      font-size: 11px;\n      line-height: 1;\n      font-weight: 950;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      cursor: pointer;\n      box-shadow: 0 0 18px rgba(31,126,216,0.16);\n    }\n\n    .hn-member-access__content {\n      height: auto;\n      min-height: 100svh;\n      padding: 54px 0 52px;\n      justify-content: flex-start;\n      gap: 28px;\n      opacity: var(--reveal);\n      transform: translateY(calc((1 - var(--reveal)) * 24px));\n    }\n\n    .hn-member-access.is-unlocked {\n      --unlock: 1;\n      --reveal: 1;\n      --card-1: 1;\n      --card-2: 1;\n      --card-3: 1;\n      --card-4: 1;\n    }\n\n    .hn-member-access__header {\n      padding: 0 18px;\n    }\n\n    .hn-member-access__eyebrow {\n      margin-bottom: 12px;\n      font-size: 10px;\n    }\n\n    .hn-member-access__header h2 {\n      font-size: clamp(34px, 10vw, 48px);\n      line-height: 0.92;\n      letter-spacing: -0.07em;\n    }\n\n    .hn-member-access__copy {\n      max-width: 320px;\n      margin-top: 16px;\n      font-size: 13.5px;\n      line-height: 1.55;\n    }\n\n    .hn-member-access__cards {\n      display: flex;\n      gap: 14px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding: 16px;\n      padding: 0 16px 10px;\n      -webkit-overflow-scrolling: touch;\n      align-items: stretch;\n    }\n\n    .hn-member-access__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-member-access__cards {\n      scrollbar-width: none;\n    }\n\n    .hn-member-access__card {\n      flex: 0 0 min(84vw, 340px);\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      border-radius: 26px;\n      padding: 16px;\n      background:\n        radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb),0.16), transparent 30%),\n        linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.014)),\n        #030303;\n      height: auto;\n    }\n\n    .hn-member-access__card-top {\n      margin-bottom: 14px;\n    }\n\n    .hn-member-access__media {\n      border-radius: 18px;\n      margin-bottom: 18px;\n    }\n\n    .hn-member-access__media img {\n      height: 98%;\n      max-width: 84%;\n    }\n\n    .hn-member-access__card-body {\n      min-height: 160px;\n    }\n\n    .hn-member-access__card-body h3 {\n      font-size: 28px;\n      line-height: 0.96;\n    }\n\n    .hn-member-access__card-body h4 {\n      margin-top: 10px;\n      font-size: 14px;\n      line-height: 1.16;\n    }\n\n    .hn-member-access__card-body p {\n      margin-top: 12px;\n      font-size: 12.5px;\n      line-height: 1.52;\n      color: rgba(255,255,255,0.84);\n    }\n\n    .hn-member-access__specs {\n      margin-top: 12px;\n    }\n\n    .hn-member-access__cta {\n      margin-top: 16px;\n      min-height: 42px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-member-access__content {\n      padding-top: 48px;\n      gap: 24px;\n    }\n\n    .hn-member-access__lock {\n      top: 46.5%;\n      width: min(290px, calc(100% - 22px));\n    }\n\n    .hn-member-access__lock h3 {\n      font-size: 36px;\n      max-width: 250px;\n    }\n\n    .hn-member-access__mobile-unlock {\n      min-height: 44px;\n      padding: 0 22px;\n      font-size: 10.5px;\n    }\n\n    .hn-member-access__card {\n      flex-basis: min(85vw, 320px);\n      padding: 15px;\n    }\n\n    .hn-member-access__card-body {\n      min-height: 150px;\n    }\n\n    .hn-member-access__card-body h3 {\n      font-size: 26px;\n    }\n\n    .hn-member-access__card-body p {\n      font-size: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-member-access *,\n    .hn-member-access *::before,\n    .hn-member-access *::after {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n/* HEADLINE COLOR GRADING UPDATE */\n#hnMemberAccess .hn-member-access__header h2 {\n  background-image: linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) !important;\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n  color: transparent !important;\n}\n\n/* Door unlock headline also matching */\n#hnMemberAccess .hn-member-access__lock h3 {\n  background-image: linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) !important;\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n  color: transparent !important;\n}\n/* DOOR CTA COLOR GRADING ONLY */\n#hnMemberAccess .hn-member-access__mobile-unlock {\n  background:\n    linear-gradient(#000000, #000000) padding-box,\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) border-box !important;\n  border: 1.5px solid transparent !important;\n  color: #ffffff !important;\n  box-shadow:\n    0 0 22px rgba(0, 201, 255, 0.22),\n    0 0 18px rgba(146, 254, 157, 0.14) !important;\n}\n\n#hnMemberAccess .hn-member-access__mobile-unlock:hover {\n  background:\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) padding-box,\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) border-box !important;\n  color: #000000 !important;\n  box-shadow:\n    0 0 30px rgba(0, 201, 255, 0.34),\n    0 0 24px rgba(146, 254, 157, 0.22) !important;\n}\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnMemberAccess');\n    if (!section || section.dataset.hnMemberReady === 'true') return;\n\n    section.dataset.hnMemberReady = 'true';\n\n    var unlockButton = section.querySelector('.hn-member-access__mobile-unlock');\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setVars(unlock, reveal, c1, c2, c3, c4) {\n      section.style.setProperty('--unlock', unlock.toFixed(3));\n      section.style.setProperty('--reveal', reveal.toFixed(3));\n      section.style.setProperty('--card-1', c1.toFixed(3));\n      section.style.setProperty('--card-2', c2.toFixed(3));\n      section.style.setProperty('--card-3', c3.toFixed(3));\n      section.style.setProperty('--card-4', c4.toFixed(3));\n    }\n\n    function updateDesktop() {\n      if (isMobile()) {\n        ticking = false;\n        return;\n      }\n\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n      var rect = section.getBoundingClientRect();\n      var total = Math.max(section.offsetHeight - vh, 1);\n      var progress = clamp(-rect.top / total, 0, 1);\n\n      var unlock = easeInOutSine(clamp((progress - 0.08) / 0.30, 0, 1));\n      var reveal = easeOutCubic(clamp((progress - 0.30) / 0.18, 0, 1));\n\n      var card1 = easeOutCubic(clamp((progress - 0.43) / 0.12, 0, 1));\n      var card2 = easeOutCubic(clamp((progress - 0.49) / 0.12, 0, 1));\n      var card3 = easeOutCubic(clamp((progress - 0.55) / 0.12, 0, 1));\n      var card4 = easeOutCubic(clamp((progress - 0.61) / 0.12, 0, 1));\n\n      setVars(unlock, reveal, card1, card2, card3, card4);\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateDesktop);\n        ticking = true;\n      }\n    }\n\n    if (unlockButton) {\n      unlockButton.addEventListener('click', function () {\n        section.classList.add('is-unlocked');\n        setVars(1, 1, 1, 1, 1, 1);\n      });\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      if (isMobile()) {\n        if (!section.classList.contains('is-unlocked')) {\n          setVars(0, 0, 0, 0, 0, 0);\n        }\n      } else {\n        section.classList.remove('is-unlocked');\n        requestTick();\n      }\n    });\n\n    if (isMobile()) {\n      setVars(0, 0, 0, 0, 0, 0);\n    } else {\n      updateDesktop();\n    }\n  })();\n</script>",
