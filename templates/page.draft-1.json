      "settings": {
        "custom_liquid": "<section class=\"hn-prime-editorial\" id=\"hnPrimeEditorial\" aria-label=\"Prime Trinity editorial racket journey\">\n\n  <!-- NITRIX 10 -->\n  <article class=\"hn-prime-editorial__scene hn-prime-editorial__scene--nitrix\" data-scene>\n    <div class=\"hn-prime-editorial__stage\">\n\n      <picture class=\"hn-prime-editorial__picture\">\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_2a158238-b426-4c12-bb43-9d86f6de9233.jpg?v=1769604070\"\n        >\n        <img\n          class=\"hn-prime-editorial__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_92a9a1f0-4100-43b6-8e7c-90b8b83247f9.jpg?v=1769604070\"\n          alt=\"Nitrix 10 badminton racket\"\n          loading=\"lazy\"\n          width=\"1920\"\n          height=\"1080\"\n        >\n      </picture>\n\n      <div class=\"hn-prime-editorial__wash\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--one\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--two\"></div>\n      <div class=\"hn-prime-editorial__scrim\"></div>\n      <div class=\"hn-prime-editorial__grain\"></div>\n\n      <div class=\"hn-prime-editorial__copy\">\n        <div class=\"hn-prime-editorial__eyebrow\">\n          <span class=\"hn-prime-editorial__tag\">Attack</span>\n          <span class=\"hn-prime-editorial__name\">Nitrix 10</span>\n        </div>\n\n        <h2 class=\"hn-prime-editorial__headline\">\n          Built to end rallies early.\n        </h2>\n\n        <p class=\"hn-prime-editorial__subline\">\n          Superlight Carbon Core and a 6.8mm Vaporshaft — whip-fast through impact, for players who take the front foot and don't give it back.\n        </p>\n\n        <div class=\"hn-prime-editorial__meta\">\n          <p class=\"hn-prime-editorial__price\">₹1,799</p>\n\n          <a class=\"hn-prime-editorial__link\" href=\"/products/nitrix-10-4u-unstrung\">\n            Go all in <span>→</span>\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </article>\n\n  <!-- FLAREON 100 -->\n  <article class=\"hn-prime-editorial__scene hn-prime-editorial__scene--flareon\" data-scene>\n    <div class=\"hn-prime-editorial__stage\">\n\n      <picture class=\"hn-prime-editorial__picture\">\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_be65f83a-7188-472e-910d-e2d1f66e2ea3.jpg?v=1769600799\"\n        >\n        <img\n          class=\"hn-prime-editorial__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_f45fedec-e15d-4a71-9e3e-60200be24a51.jpg?v=1769600799\"\n          alt=\"Flareon 100 badminton racket\"\n          loading=\"lazy\"\n          width=\"1920\"\n          height=\"1080\"\n        >\n      </picture>\n\n      <div class=\"hn-prime-editorial__wash\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--one\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--two\"></div>\n      <div class=\"hn-prime-editorial__scrim\"></div>\n      <div class=\"hn-prime-editorial__grain\"></div>\n\n      <div class=\"hn-prime-editorial__copy\">\n        <div class=\"hn-prime-editorial__eyebrow\">\n          <span class=\"hn-prime-editorial__tag\">Speed</span>\n          <span class=\"hn-prime-editorial__name\">Flareon 100</span>\n        </div>\n\n        <h2 class=\"hn-prime-editorial__headline\">\n          Get there before they do.\n        </h2>\n\n        <p class=\"hn-prime-editorial__subline\">\n          AECG+ carbon core in an ultra-light build — quick through the air, quicker back to base, made for players who outlast the rally.\n        </p>\n\n        <div class=\"hn-prime-editorial__meta\">\n          <p class=\"hn-prime-editorial__price\">₹1,890</p>\n\n          <a class=\"hn-prime-editorial__link\" href=\"/products/flareon-100\">\n            Pick up the pace <span>→</span>\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </article>\n\n  <!-- HYFONIC 1 -->\n  <article class=\"hn-prime-editorial__scene hn-prime-editorial__scene--hyfonic\" data-scene>\n    <div class=\"hn-prime-editorial__stage\">\n\n      <picture class=\"hn-prime-editorial__picture\">\n        <source\n          media=\"(max-width: 749px)\"\n          srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_e3ed8cf5-25c0-466d-8363-5aefd0c839a2.jpg?v=1769604111\"\n        >\n        <img\n          class=\"hn-prime-editorial__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_3307e0c2-9c11-459f-abc7-711b477d21b9.jpg?v=1769604111\"\n          alt=\"Hyfonic 1 badminton racket\"\n          loading=\"lazy\"\n          width=\"1920\"\n          height=\"1080\"\n        >\n      </picture>\n\n      <div class=\"hn-prime-editorial__wash\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--one\"></div>\n      <div class=\"hn-prime-editorial__light hn-prime-editorial__light--two\"></div>\n      <div class=\"hn-prime-editorial__scrim\"></div>\n      <div class=\"hn-prime-editorial__grain\"></div>\n\n      <div class=\"hn-prime-editorial__copy\">\n        <div class=\"hn-prime-editorial__eyebrow\">\n          <span class=\"hn-prime-editorial__tag\">Precision</span>\n          <span class=\"hn-prime-editorial__name\">Hyfonic 1</span>\n        </div>\n\n        <h2 class=\"hn-prime-editorial__headline\">\n          Place it where they aren't.\n        </h2>\n\n        <p class=\"hn-prime-editorial__subline\">\n          Curve² geometry widens the sweet spot — built for measured rallies and the player who's always two shots ahead.\n        </p>\n\n        <div class=\"hn-prime-editorial__meta\">\n          <p class=\"hn-prime-editorial__price\">₹1,890</p>\n\n          <a class=\"hn-prime-editorial__link\" href=\"/products/hyfonic-1\">\n            Trust the play <span>→</span>\n          </a>\n        </div>\n      </div>\n\n    </div>\n  </article>\n\n</section>\n\n<style>\n  .hn-prime-editorial,\n  .hn-prime-editorial *,\n  .hn-prime-editorial *::before,\n  .hn-prime-editorial *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-prime-editorial {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    background: #020202;\n    color: #ffffff;\n    position: relative;\n    overflow: clip;\n    isolation: isolate;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n  }\n\n  .hn-prime-editorial__scene {\n    --stage-opacity: 1;\n    --stage-y: 100px;\n    --stage-scale: 0.9;\n    --stage-radius: 54px;\n\n    --copy-opacity: 0;\n    --copy-y: 58px;\n\n    --image-scale: 1.13;\n    --image-y: 0px;\n    --image-opacity: 0.82;\n\n    --wash-opacity: 0.56;\n    --light-opacity: 0.22;\n    --line-scale: 0;\n\n    position: relative;\n    width: 100%;\n    min-height: 175vh;\n    z-index: 1;\n    background: #020202;\n  }\n\n  .hn-prime-editorial__scene:nth-child(1) {\n    z-index: 1;\n  }\n\n  .hn-prime-editorial__scene:nth-child(2) {\n    z-index: 2;\n  }\n\n  .hn-prime-editorial__scene:nth-child(3) {\n    z-index: 3;\n  }\n\n  .hn-prime-editorial__scene + .hn-prime-editorial__scene {\n    margin-top: -100vh;\n  }\n\n  .hn-prime-editorial__stage {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 650px;\n    overflow: hidden;\n    isolation: isolate;\n    opacity: var(--stage-opacity);\n    transform:\n      translate3d(0, var(--stage-y), 0)\n      scale(var(--stage-scale));\n    border-radius: var(--stage-radius);\n    background: #020202;\n    will-change: opacity, transform, border-radius;\n    box-shadow:\n      0 -40px 100px rgba(0,0,0,0.72),\n      0 50px 150px rgba(0,0,0,0.75);\n  }\n\n  .hn-prime-editorial__scene--nitrix {\n    --accent: #d7a20f;\n    --accent-soft: #ffd76a;\n    --accent-rgb: 215, 162, 15;\n    --wash-main: rgba(122, 83, 0, 0.74);\n    --wash-second: rgba(255, 194, 35, 0.26);\n    --image-position-desktop: center center;\n    --image-position-mobile: center center;\n  }\n\n  .hn-prime-editorial__scene--flareon {\n    --accent: #00d9e8;\n    --accent-soft: #8ff7ff;\n    --accent-rgb: 0, 217, 232;\n    --wash-main: rgba(0, 84, 98, 0.72);\n    --wash-second: rgba(0, 217, 232, 0.24);\n    --image-position-desktop: center center;\n    --image-position-mobile: center center;\n  }\n\n  .hn-prime-editorial__scene--hyfonic {\n    --accent: #4361ee;\n    --accent-soft: #9bacff;\n    --accent-rgb: 67, 97, 238;\n    --wash-main: rgba(10, 34, 112, 0.74);\n    --wash-second: rgba(67, 97, 238, 0.26);\n    --image-position-desktop: center center;\n    --image-position-mobile: center center;\n  }\n\n  .hn-prime-editorial__picture {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    display: block;\n    width: 100%;\n    height: 100%;\n    opacity: var(--image-opacity);\n    transform:\n      translate3d(0, var(--image-y), 0)\n      scale(var(--image-scale));\n    will-change: transform, opacity;\n    background: #020202;\n  }\n\n  .hn-prime-editorial__image {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: var(--image-position-desktop);\n    filter: saturate(1.08) contrast(1.16) brightness(0.42);\n  }\n\n  .hn-prime-editorial__wash {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    pointer-events: none;\n    opacity: var(--wash-opacity);\n    background:\n      radial-gradient(circle at 18% 22%, var(--wash-second), transparent 36%),\n      radial-gradient(circle at 80% 30%, var(--wash-main), transparent 50%),\n      radial-gradient(circle at 50% 72%, rgba(255,255,255,0.05), transparent 42%),\n      linear-gradient(135deg, rgba(0,0,0,0.56), var(--wash-main) 60%, rgba(0,0,0,0.92));\n    mix-blend-mode: screen;\n    will-change: opacity;\n  }\n\n  .hn-prime-editorial__light {\n    position: absolute;\n    z-index: 3;\n    pointer-events: none;\n    width: 62vw;\n    height: 1px;\n    left: -12vw;\n    top: 29%;\n    opacity: var(--light-opacity);\n    background: linear-gradient(90deg, transparent, var(--accent), rgba(255,255,255,0.52), transparent);\n    filter: blur(0.5px) drop-shadow(0 0 22px var(--accent));\n    transform: rotate(-18deg) translateX(calc((1 - var(--copy-opacity)) * -90px));\n    transform-origin: left center;\n  }\n\n  .hn-prime-editorial__light--two {\n    width: 48vw;\n    left: auto;\n    right: -8vw;\n    top: 66%;\n    opacity: calc(var(--light-opacity) * 0.72);\n    transform: rotate(-18deg) translateX(calc((1 - var(--copy-opacity)) * 90px));\n  }\n\n  .hn-prime-editorial__scrim {\n    position: absolute;\n    inset: 0;\n    z-index: 4;\n    pointer-events: none;\n    background:\n      linear-gradient(to bottom, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.22) 34%, rgba(0,0,0,0.92) 100%),\n      linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.44) 42%, rgba(0,0,0,0.7) 100%);\n  }\n\n  .hn-prime-editorial__grain {\n    position: absolute;\n    inset: 0;\n    z-index: 5;\n    pointer-events: none;\n    opacity: 0.12;\n    background-image:\n      linear-gradient(rgba(255,255,255,0.032) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.024) 1px, transparent 1px);\n    background-size: 42px 42px;\n    mix-blend-mode: screen;\n  }\n\n  .hn-prime-editorial__copy {\n    position: absolute;\n    z-index: 8;\n    left: clamp(20px, 5vw, 72px);\n    top: 48%;\n    width: min(660px, calc(100% - 40px));\n    opacity: var(--copy-opacity);\n    transform: translate3d(0, calc(-50% + var(--copy-y)), 0);\n    will-change: opacity, transform;\n  }\n\n  .hn-prime-editorial__copy::before {\n    content: \"\";\n    position: absolute;\n    left: -18px;\n    top: 2px;\n    width: 3px;\n    height: calc(100% - 4px);\n    border-radius: 999px;\n    background: linear-gradient(to bottom, var(--accent), transparent);\n    opacity: 0.9;\n    transform: scaleY(var(--line-scale));\n    transform-origin: top;\n    box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.38);\n  }\n\n  .hn-prime-editorial__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin: 0 0 18px;\n    opacity: var(--copy-opacity);\n    transform: translateY(calc(var(--copy-y) * 0.24));\n  }\n\n  .hn-prime-editorial__tag {\n    color: var(--accent);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    text-shadow:\n      0 0 16px rgba(var(--accent-rgb), 0.5),\n      0 12px 30px rgba(0,0,0,0.75);\n  }\n\n  .hn-prime-editorial__tag::after {\n    content: \"\";\n    display: inline-block;\n    width: 4px;\n    height: 4px;\n    margin-left: 12px;\n    border-radius: 50%;\n    background: rgba(255,255,255,0.42);\n    vertical-align: middle;\n  }\n\n  .hn-prime-editorial__name {\n    color: rgba(255,255,255,0.78);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    text-shadow: 0 12px 30px rgba(0,0,0,0.75);\n  }\n\n  .hn-prime-editorial__headline {\n    margin: 0;\n    max-width: 11.5ch;\n    color: #ffffff;\n    font-size: clamp(36px, 4.1vw, 66px);\n    line-height: 0.98;\n    font-weight: 950;\n    letter-spacing: -0.055em;\n    text-wrap: balance;\n    text-shadow:\n      0 18px 42px rgba(0,0,0,0.9),\n      0 0 30px rgba(255,255,255,0.14);\n    transform: translateY(calc(var(--copy-y) * 0.1));\n  }\n\n  .hn-prime-editorial__subline {\n    max-width: 44ch;\n    margin: 22px 0 0;\n    color: rgba(255,255,255,0.92);\n    font-size: clamp(14px, 1vw, 17px);\n    line-height: 1.58;\n    font-weight: 650;\n    letter-spacing: -0.01em;\n    text-shadow:\n      0 10px 28px rgba(0,0,0,0.92),\n      0 0 18px rgba(0,0,0,0.78);\n    transform: translateY(calc(var(--copy-y) * 0.18));\n  }\n\n  .hn-prime-editorial__meta {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    margin-top: clamp(28px, 3vw, 42px);\n    opacity: var(--copy-opacity);\n    transform: translateY(calc(var(--copy-y) * 0.24));\n    will-change: opacity, transform;\n  }\n\n  .hn-prime-editorial__price {\n    margin: 0;\n    color: rgba(255,255,255,0.72);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.03em;\n    white-space: nowrap;\n    text-shadow: 0 10px 24px rgba(0,0,0,0.78);\n  }\n\n  .hn-prime-editorial__link {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 48px;\n    padding: 0 25px;\n    border-radius: 999px;\n    border: 1.5px solid rgba(var(--accent-rgb), 0.92);\n    background: rgba(0,0,0,0.42);\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.04em;\n    white-space: nowrap;\n    text-transform: uppercase;\n    backdrop-filter: blur(12px);\n    box-shadow:\n      0 0 28px rgba(var(--accent-rgb), 0.2),\n      inset 0 0 0 1px rgba(255,255,255,0.04);\n    transition:\n      background 0.24s ease,\n      border-color 0.24s ease,\n      transform 0.24s ease,\n      color 0.24s ease,\n      box-shadow 0.24s ease;\n  }\n\n  .hn-prime-editorial__link span {\n    color: var(--accent);\n    font-size: 15px;\n    line-height: 1;\n    transition: transform 0.24s ease, color 0.24s ease;\n  }\n\n  .hn-prime-editorial__link:hover {\n    background: rgba(0,0,0,0.42);\n    border-color: var(--accent);\n    color: #ffffff;\n    transform: translateY(-3px);\n    box-shadow:\n      0 0 38px rgba(var(--accent-rgb), 0.38),\n      inset 0 0 0 1px rgba(var(--accent-rgb), 0.18);\n  }\n\n  .hn-prime-editorial__link:hover span {\n    color: var(--accent);\n    transform: translateX(4px);\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-prime-editorial {\n      overflow: clip;\n    }\n\n    .hn-prime-editorial__scene {\n      min-height: 175svh;\n    }\n\n    .hn-prime-editorial__scene + .hn-prime-editorial__scene {\n      margin-top: -100svh;\n    }\n\n    .hn-prime-editorial__stage {\n      height: 100svh;\n      min-height: 660px;\n    }\n\n    .hn-prime-editorial__image {\n      object-position: var(--image-position-mobile);\n      filter: saturate(1.08) contrast(1.16) brightness(0.38);\n    }\n\n    .hn-prime-editorial__copy {\n      top: 50%;\n      left: 50%;\n      width: min(370px, calc(100% - 44px));\n      text-align: center;\n      transform: translate3d(-50%, calc(-50% + var(--copy-y)), 0);\n    }\n\n    .hn-prime-editorial__copy::before {\n      display: none;\n    }\n\n    .hn-prime-editorial__eyebrow {\n      justify-content: center;\n      margin-bottom: 15px;\n    }\n\n    .hn-prime-editorial__tag,\n    .hn-prime-editorial__name {\n      font-size: 11px;\n    }\n\n    .hn-prime-editorial__headline {\n      max-width: 13ch;\n      margin-left: auto;\n      margin-right: auto;\n      font-size: clamp(34px, 9.5vw, 48px);\n      line-height: 1.02;\n      letter-spacing: -0.052em;\n    }\n\n    .hn-prime-editorial__subline {\n      max-width: 33ch;\n      margin: 16px auto 0;\n      font-size: 14px;\n      line-height: 1.5;\n      color: rgba(255,255,255,0.94);\n    }\n\n    .hn-prime-editorial__meta {\n      justify-content: center;\n      margin-top: 30px;\n      gap: 16px;\n      flex-wrap: wrap;\n    }\n\n    .hn-prime-editorial__link {\n      min-height: 46px;\n      padding: 0 22px;\n      font-size: 12px;\n      background: rgba(0,0,0,0.46);\n    }\n\n    .hn-prime-editorial__link:hover {\n      background: rgba(0,0,0,0.46);\n      color: #ffffff;\n      border-color: var(--accent);\n      box-shadow:\n        0 0 34px rgba(var(--accent-rgb), 0.36),\n        inset 0 0 0 1px rgba(var(--accent-rgb), 0.18);\n    }\n\n    .hn-prime-editorial__scrim {\n      background:\n        linear-gradient(to bottom, rgba(0,0,0,0.68) 0%, rgba(0,0,0,0.44) 32%, rgba(0,0,0,0.56) 62%, rgba(0,0,0,0.9) 100%),\n        linear-gradient(to right, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.46) 50%, rgba(0,0,0,0.62) 100%);\n    }\n\n    .hn-prime-editorial__light {\n      width: 86vw;\n      left: -30vw;\n      top: 34%;\n    }\n\n    .hn-prime-editorial__light--two {\n      width: 72vw;\n      right: -34vw;\n      top: 70%;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-prime-editorial__stage {\n      min-height: 640px;\n    }\n\n    .hn-prime-editorial__copy {\n      width: min(340px, calc(100% - 36px));\n    }\n\n    .hn-prime-editorial__headline {\n      font-size: 31px;\n      max-width: 13ch;\n    }\n\n    .hn-prime-editorial__subline {\n      font-size: 13px;\n      max-width: 31ch;\n    }\n\n    .hn-prime-editorial__meta {\n      margin-top: 26px;\n    }\n\n    .hn-prime-editorial__link {\n      min-height: 44px;\n      padding: 0 18px;\n      font-size: 11px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-prime-editorial__stage,\n    .hn-prime-editorial__picture,\n    .hn-prime-editorial__copy,\n    .hn-prime-editorial__meta,\n    .hn-prime-editorial__link,\n    .hn-prime-editorial__light,\n    .hn-prime-editorial__copy::before {\n      transition: none !important;\n      transform: none !important;\n    }\n  }\n/* ================================\n   TEXT BRIGHTNESS UPGRADE\n   Works for all 3 cards\n================================ */\n\n.hn-prime-editorial__copy {\n  z-index: 10;\n}\n\n.hn-prime-editorial__eyebrow {\n  opacity: 1 !important;\n}\n\n.hn-prime-editorial__tag {\n  color: var(--accent) !important;\n  text-shadow:\n    0 0 18px rgba(var(--accent-rgb), 0.42),\n    0 10px 28px rgba(0,0,0,0.82) !important;\n}\n\n.hn-prime-editorial__name {\n  color: rgba(255,255,255,0.96) !important;\n  text-shadow:\n    0 10px 30px rgba(0,0,0,0.88),\n    0 0 10px rgba(255,255,255,0.10) !important;\n}\n\n.hn-prime-editorial__headline {\n  color: #ffffff !important;\n  text-shadow:\n    0 14px 34px rgba(0,0,0,0.92),\n    0 0 20px rgba(255,255,255,0.10),\n    0 2px 0 rgba(255,255,255,0.04) !important;\n}\n\n.hn-prime-editorial__subline {\n  color: rgba(255,255,255,0.98) !important;\n  text-shadow:\n    0 10px 28px rgba(0,0,0,0.95),\n    0 0 10px rgba(255,255,255,0.06) !important;\n}\n\n.hn-prime-editorial__price {\n  color: rgba(255,255,255,0.94) !important;\n  text-shadow:\n    0 8px 22px rgba(0,0,0,0.88) !important;\n}\n\n/* little support glow behind text area */\n.hn-prime-editorial__copy::after {\n  content: \"\";\n  position: absolute;\n  inset: -24px -22px -24px -22px;\n  z-index: -1;\n  pointer-events: none;\n  border-radius: 28px;\n  background:\n    radial-gradient(circle at 30% 35%, rgba(0,0,0,0.34), transparent 42%),\n    linear-gradient(135deg, rgba(0,0,0,0.34), rgba(0,0,0,0.12));\n  filter: blur(10px);\n  opacity: 0.9;\n}\n\n/* brighten CTA text too */\n.hn-prime-editorial__link {\n  color: #ffffff !important;\n  text-shadow:\n    0 8px 18px rgba(0,0,0,0.72);\n}\n\n.hn-prime-editorial__link span {\n  color: var(--accent) !important;\n}\n\n/* mobile readability */\n@media screen and (max-width: 989px) {\n  .hn-prime-editorial__tag {\n    color: var(--accent) !important;\n  }\n\n  .hn-prime-editorial__name {\n    color: rgba(255,255,255,0.98) !important;\n  }\n\n  .hn-prime-editorial__headline {\n    color: #ffffff !important;\n    text-shadow:\n      0 12px 26px rgba(0,0,0,0.96),\n      0 0 12px rgba(255,255,255,0.08) !important;\n  }\n\n  .hn-prime-editorial__subline {\n    color: rgba(255,255,255,0.98) !important;\n    text-shadow:\n      0 8px 22px rgba(0,0,0,0.96),\n      0 0 8px rgba(255,255,255,0.05) !important;\n  }\n\n  .hn-prime-editorial__price {\n    color: rgba(255,255,255,0.96) !important;\n  }\n\n  .hn-prime-editorial__copy::after {\n    inset: -18px -14px -18px -14px;\n    border-radius: 24px;\n    background:\n      radial-gradient(circle at 50% 30%, rgba(0,0,0,0.30), transparent 40%),\n      linear-gradient(180deg, rgba(0,0,0,0.24), rgba(0,0,0,0.16));\n    filter: blur(8px);\n    opacity: 0.9;\n  }\n}\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnPrimeEditorial');\n    if (!section || section.dataset.hnPrimeEditorialReady === 'true') return;\n\n    section.dataset.hnPrimeEditorialReady = 'true';\n\n    var scenes = Array.prototype.slice.call(section.querySelectorAll('[data-scene]'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function updateScenes() {\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n\n      scenes.forEach(function (scene) {\n        var rect = scene.getBoundingClientRect();\n        var total = Math.max(rect.height - vh, 1);\n        var progress = clamp(-rect.top / total, 0, 1);\n        var smoothProgress = easeInOutSine(progress);\n\n        var enter = easeOutCubic(clamp((vh * 0.82 - rect.top) / (vh * 0.72), 0, 1));\n        var exit = 1 - easeOutCubic(clamp((vh * 0.02 - rect.bottom) / (vh * 0.72), 0, 1));\n        var active = clamp(enter * exit, 0, 1);\n\n        var stageY = (1 - active) * 118;\n        var stageScale = 0.9 + active * 0.1;\n        var stageRadius = (1 - active) * 54;\n\n        var copyY = (1 - active) * 58;\n        var imageY = (0.5 - smoothProgress) * 64;\n        var imageScale = 1.13 - active * 0.055 + smoothProgress * 0.012;\n        var imageOpacity = 0.62 + active * 0.25;\n        var washOpacity = 0.44 + active * 0.48;\n        var lightOpacity = active * 0.68;\n\n        scene.style.setProperty('--stage-opacity', active.toFixed(3));\n        scene.style.setProperty('--stage-y', stageY.toFixed(2) + 'px');\n        scene.style.setProperty('--stage-scale', stageScale.toFixed(3));\n        scene.style.setProperty('--stage-radius', stageRadius.toFixed(2) + 'px');\n\n        scene.style.setProperty('--copy-opacity', active.toFixed(3));\n        scene.style.setProperty('--copy-y', copyY.toFixed(2) + 'px');\n        scene.style.setProperty('--line-scale', active.toFixed(3));\n\n        scene.style.setProperty('--image-y', imageY.toFixed(2) + 'px');\n        scene.style.setProperty('--image-scale', imageScale.toFixed(3));\n        scene.style.setProperty('--image-opacity', imageOpacity.toFixed(3));\n\n        scene.style.setProperty('--wash-opacity', washOpacity.toFixed(3));\n        scene.style.setProperty('--light-opacity', lightOpacity.toFixed(3));\n      });\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateScenes);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    updateScenes();\n  })();\n</script>",
