pill {\n      margin-bottom: 14px !important;\n      font-size: 10.5px !important;\n      padding: 7px 11px 7px 8px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__pill span {\n      width: 14px !important;\n      height: 14px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__title {\n      font-size: clamp(42px, 13vw, 58px) !important;\n      line-height: .88 !important;\n      letter-spacing: -0.075em !important;\n      max-width: 8ch !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__text {\n      margin-top: 15px !important;\n      max-width: 32ch !important;\n      font-size: 14px !important;\n      line-height: 1.38 !important;\n      color: rgba(255,255,255,.74) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__button,\n    #hnEvoFinalStack .hn-evo-final__scroll-hint {\n      display: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__progress {\n      margin-top: 18px !important;\n      grid-template-columns: 22px minmax(130px, 210px) 22px !important;\n      column-gap: 10px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      width: 100% !important;\n      height: auto !important;\n      margin: 0 !important;\n      padding: 0 16px 12px !important;\n\n      display: flex !important;\n      gap: 14px !important;\n      overflow-x: auto !important;\n      overflow-y: hidden !important;\n      scroll-snap-type: x mandatory !important;\n      scroll-padding: 16px !important;\n      -webkit-overflow-scrolling: touch !important;\n\n      perspective: none !important;\n      contain: layout paint !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage::-webkit-scrollbar {\n      display: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      scrollbar-width: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      position: relative !important;\n      left: auto !important;\n      top: auto !important;\n\n      flex: 0 0 min(82vw, 330px) !important;\n      width: min(82vw, 330px) !important;\n      height: 430px !important;\n\n      transform: none !important;\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n      z-index: 1 !important;\n\n      scroll-snap-align: center !important;\n      scroll-snap-stop: always !important;\n\n      border-radius: 22px !important;\n      background: #050505 !important;\n      box-shadow:\n        0 18px 46px rgba(0,0,0,.72),\n        inset 0 0 0 1px rgba(255,255,255,.07) !important;\n\n      transition: none !important;\n      will-change: auto !important;\n      contain: layout paint !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card.is-active {\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media {\n      padding: 24px 16px 138px !important;\n      background:\n        radial-gradient(circle at 50% 34%, rgba(var(--accent-rgb),.14), transparent 42%),\n        #050505 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__glow {\n      width: 62% !important;\n      opacity: .44 !important;\n      filter: blur(18px) !important;\n      animation: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__ring {\n      width: 64% !important;\n      opacity: .45 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(82%, 260px) !important;\n      transform: rotate(-8deg) translateY(2px) scale(1) !important;\n      animation: none !important;\n      filter: drop-shadow(0 18px 24px rgba(0,0,0,.68)) !important;\n      will-change: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__scrim {\n      height: 58% !important;\n      background:\n        linear-gradient(\n          to top,\n          rgba(0,0,0,.96) 0%,\n          rgba(0,0,0,.78) 44%,\n          rgba(0,0,0,.26) 78%,\n          rgba(0,0,0,0) 100%\n        ) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content {\n      padding: 0 18px 20px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__chip {\n      min-height: 22px !important;\n      padding: 0 8px !important;\n      font-size: 9px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      margin-top: 12px !important;\n      font-size: 27px !important;\n      line-height: .96 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content p {\n      margin-top: 8px !important;\n      max-width: 260px !important;\n      font-size: 12.5px !important;\n      line-height: 1.32 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__meta {\n      margin-top: 14px !important;\n      font-size: 12px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card,\n    #hnEvoFinalStack .hn-evo-final-card *,\n    #hnEvoFinalStack .hn-evo-final-card *::before,\n    #hnEvoFinalStack .hn-evo-final-card *::after {\n      animation-duration: 0s !important;\n      transition-duration: 0s !important;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    #hnEvoFinalStack .hn-evo-final__sticky {\n      padding: 50px 0 58px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      flex-basis: min(84vw, 310px) !important;\n      width: min(84vw, 310px) !important;\n      height: 405px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(80%, 240px) !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      font-size: 25px !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var section = document.getElementById('hnEvoFinalStack');\n  if (!section || section.dataset.mobileOptimized === 'true') return;\n  section.dataset.mobileOptimized = 'true';\n\n  function isMobile() {\n    return window.matchMedia('(max-width: 989px)').matches;\n  }\n\n  function optimizeMobileImages() {\n    if (!isMobile()) return;\n\n    var imgs = section.querySelectorAll('.hn-evo-final-card__media img');\n\n    imgs.forEach(function (img) {\n      img.loading = 'lazy';\n      img.decoding = 'async';\n\n      try {\n        img.fetchPriority = 'low';\n      } catch (e) {}\n\n      if (img.src && img.src.indexOf('width=1400') > -1) {\n        img.src = img.src.replace('width=1400', 'width=700');\n      }\n\n      if (img.getAttribute('src') && img.getAttribute('src').indexOf('width=1400') > -1) {\n        img.setAttribute('src', img.getAttribute('src').replace('width=1400', 'width=700'));\n      }\n    });\n  }\n\n  function forceMobileFinalState() {\n    if (!isMobile()) return;\n\n    var cards = section.querySelectorAll('.hn-evo-final-card');\n    var current = section.querySelector('.hn-evo-final__progress-current');\n    var total = section.querySelector('.hn-evo-final__progress-total');\n    var fill = section.querySelector('.hn-evo-final__progress-fill');\n\n    section.style.setProperty('--hn-evo-progress', '1');\n\n    if (current) current.textContent = '01';\n    if (total) total.textContent = String(cards.length).padStart(2, '0');\n    if (fill) fill.style.setProperty('transform', 'scaleX(1)', 'important');\n\n    cards.forEach(function (card) {\n      card.classList.add('is-active');\n\n      card.style.setProperty('--card-y', '0px', 'important');\n      card.style.setProperty('--card-scale', '1', 'important');\n      card.style.setProperty('--card-opacity', '1', 'important');\n      card.style.setProperty('--card-z', '1', 'important');\n      card.style.setProperty('--card-events', 'auto', 'important');\n      card.style.setProperty('--card-visibility', 'visible', 'important');\n\n      card.style.opacity = '1';\n      card.style.visibility = 'visible';\n      card.style.pointerEvents = 'auto';\n    });\n  }\n\n  function runMobileLite() {\n    optimizeMobileImages();\n    forceMobileFinalState();\n  }\n\n  runMobileLite();\n\n  window.addEventListener('resize', runMobileLite, { passive: true });\n  window.addEventListener('orientationchange', function () {\n    setTimeout(runMobileLite, 120);\n  });\n\n  setTimeout(runMobileLite, 300);\n})();\n</script>\n<style>\n  /* =========================================\n     DESKTOP / TABLET RESTORE FIX\n     Mobile swipe only under 750px\n  ========================================= */\n\n  @media screen and (min-width: 750px) {\n    #hnEvoFinalStack {\n      height: 300vh !important;\n      overflow: visible !important;\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__sticky {\n      position: sticky !important;\n      top: 0 !important;\n      width: 100% !important;\n      height: 100vh !important;\n      min-height: 720px !important;\n      overflow: hidden !important;\n      display: flex !important;\n      align-items: center !important;\n      padding: 0 !important;\n      background: #000000 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__inner {\n      position: relative !important;\n      z-index: 2 !important;\n      width: min(1280px, calc(100% - 40px)) !important;\n      margin: 0 auto !important;\n      padding: 0 !important;\n      display: grid !important;\n      grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr) !important;\n      gap: clamp(44px, 7vw, 110px) !important;\n      align-items: center !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__copy {\n      width: auto !important;\n      max-width: 540px !important;\n      margin: 0 !important;\n      text-align: left !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__title {\n      font-size: clamp(54px, 7vw, 104px) !important;\n      line-height: 0.88 !important;\n      max-width: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__text {\n      max-width: 470px !important;\n      font-size: clamp(16px, 1.35vw, 20px) !important;\n      line-height: 1.45 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__progress {\n      display: grid !important;\n      grid-template-columns: 24px minmax(160px, 260px) 24px !important;\n      margin-top: 36px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final__stage {\n      position: relative !important;\n      width: min(470px, 100%) !important;\n      height: 620px !important;\n      margin-left: auto !important;\n      padding: 0 !important;\n      display: block !important;\n      overflow: visible !important;\n      perspective: 1200px !important;\n      contain: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card {\n      position: absolute !important;\n      left: 50% !important;\n      top: 50% !important;\n      flex: none !important;\n\n      width: min(400px, 100%) !important;\n      height: 550px !important;\n\n      transform:\n        translate3d(-50%, -50%, 0)\n        translateY(var(--card-y, 0px))\n        scale(var(--card-scale, 1)) !important;\n\n      opacity: var(--card-opacity, 0) !important;\n      z-index: var(--card-z, 1) !important;\n      pointer-events: var(--card-events, none) !important;\n      visibility: var(--card-visibility, hidden) !important;\n\n      scroll-snap-align: none !important;\n      scroll-snap-stop: normal !important;\n\n      border-radius: 24px !important;\n      background:\n        linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)),\n        #000000 !important;\n\n      box-shadow:\n        0 32px 90px rgba(0,0,0,.75),\n        inset 0 1px 0 rgba(255,255,255,.08) !important;\n\n      transition:\n        transform 500ms cubic-bezier(0.22, 1, 0.36, 1),\n        box-shadow 320ms ease,\n        border-color 320ms ease !important;\n\n      will-change: transform, opacity !important;\n      contain: none !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card.is-active {\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media {\n      padding: 38px 24px 168px !important;\n      background:\n        radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb),.16), transparent 34%),\n        radial-gradient(circle at 50% 44%, rgba(255,255,255,.035), transparent 50%),\n        #030304 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__glow {\n      width: 76% !important;\n      opacity: .7 !important;\n      filter: blur(28px) !important;\n      animation: hnEvoFinalGlow 4.8s ease-in-out infinite !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__ring {\n      width: 72% !important;\n      opacity: .7 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__media img {\n      width: min(88%, 360px) !important;\n      transform: rotate(-8deg) translateY(8px) scale(1.08) !important;\n      animation: hnEvoFinalFloat 5s ease-in-out infinite !important;\n      filter:\n        drop-shadow(0 24px 32px rgba(0,0,0,.48))\n        drop-shadow(0 0 24px rgba(var(--accent-rgb),.12)) !important;\n      will-change: transform !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content {\n      padding: 0 22px 24px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content h3 {\n      font-size: 34px !important;\n      line-height: .94 !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__content p {\n      font-size: 14px !important;\n      line-height: 1.35 !important;\n      max-width: 300px !important;\n    }\n\n    #hnEvoFinalStack .hn-evo-final-card__meta {\n      font-size: 13px !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var section = document.getElementById('hnEvoFinalStack');\n  if (!section || section.dataset.desktopRestore === 'true') return;\n  section.dataset.desktopRestore = 'true';\n\n  var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-final-card'));\n  var fill = section.querySelector('.hn-evo-final__progress-fill');\n  var current = section.querySelector('.hn-evo-final__progress-current');\n  var total = section.querySelector('.hn-evo-final__progress-total');\n  var hint = section.querySelector('.hn-evo-final__scroll-hint');\n  var ticking = false;\n\n  function isDesktopMode() {\n    return window.matchMedia('(min-width: 750px)').matches;\n  }\n\n  function clamp(value, min, max) {\n    return Math.min(Math.max(value, min), max);\n  }\n\n  function pad(value) {\n    return String(value).padStart(2, '0');\n  }\n\n  function updateDesktopCards() {\n    if (!isDesktopMode()) {\n      ticking = false;\n      return;\n    }\n\n    var rect = section.getBoundingClientRect();\n    var viewport = window.innerHeight || document.documentElement.clientHeight;\n    var scrollable = section.offsetHeight - viewport;\n    var progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;\n\n    var maxIndex = cards.length - 1;\n    var activeIndex = clamp(Math.round(progress * maxIndex), 0, maxIndex);\n\n    section.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n\n    if (fill) {\n      fill.style.setProperty('transform', 'scaleX(' + progress.toFixed(4) + ')', 'important');\n    }\n\n    if (current) current.textContent = pad(activeIndex + 1);\n    if (total) total.textContent = pad(cards.length);\n\n    if (hint) {\n      hint.classList.toggle('is-hidden', progress > 0.08);\n    }\n\n    cards.forEach(function (card, index) {\n      var isActive = index === activeIndex;\n\n      card.classList.toggle('is-active', isActive);\n\n      if (isActive) {\n        card.style.setProperty('--card-y', '0px', 'important');\n        card.style.setProperty('--card-scale', '1', 'important');\n        card.style.setProperty('--card-opacity', '1', 'important');\n        card.style.setProperty('--card-z', '10', 'important');\n        card.style.setProperty('--card-events', 'auto', 'important');\n        card.style.setProperty('--card-visibility', 'visible', 'important');\n      } else if (index < activeIndex) {\n        card.style.setProperty('--card-y', '-180px', 'important');\n        card.style.setProperty('--card-scale', '0.96', 'important');\n        card.style.setProperty('--card-opacity', '0', 'important');\n        card.style.setProperty('--card-z', '1', 'important');\n        card.style.setProperty('--card-events', 'none', 'important');\n        card.style.setProperty('--card-visibility', 'hidden', 'important');\n      } else {\n        card.style.setProperty('--card-y', '180px', 'important');\n        card.style.setProperty('--card-scale', '0.96', 'important');\n        card.style.setProperty('--card-opacity', '0', 'important');\n        card.style.setProperty('--card-z', '1', 'important');\n        card.style.setProperty('--card-events', 'none', 'important');\n        card.style.setProperty('--card-visibility', 'hidden', 'important');\n      }\n    });\n\n    ticking = false;\n  }\n\n  function requestUpdate() {\n    if (!ticking) {\n      window.requestAnimationFrame(updateDesktopCards);\n      ticking = true;\n    }\n  }\n\n  window.addEventListener('scroll', requestUpdate, { passive: true });\n  window.addEventListener('resize', requestUpdate);\n  window.addEventListener('orientationchange', function () {\n    setTimeout(requestUpdate, 120);\n  });\n\n  requestUpdate();\n})();\n</script>",
