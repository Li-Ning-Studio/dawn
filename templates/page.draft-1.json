    "custom_liquid_CXTRQN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-evo-clean-stack\" id=\"hnEvoCleanStack\" aria-label=\"The Evolution Series\">\n  <div class=\"hn-evo-clean-stack__sticky\">\n    <div class=\"hn-evo-clean-stack__bg\"></div>\n\n    <div class=\"hn-evo-clean-stack__inner\">\n\n      <div class=\"hn-evo-clean-stack__copy\">\n        <p class=\"hn-evo-clean-stack__pill\">\n          <span></span>\n          Evolution Series\n        </p>\n\n        <h2 class=\"hn-evo-clean-stack__title\">Choose your edge.</h2>\n\n        <p class=\"hn-evo-clean-stack__text\">\n          Attack, speed, or precision. Three rackets built from the same DNA, tuned for the way you win.\n        </p>\n\n        <a class=\"hn-evo-clean-stack__button\" href=\"/collections/pro-series\">\n          Explore the series\n          <span>→</span>\n        </a>\n\n        <div class=\"hn-evo-clean-stack__progress\" aria-hidden=\"true\">\n          <span>01</span>\n          <div class=\"hn-evo-clean-stack__progress-track\">\n            <div class=\"hn-evo-clean-stack__progress-fill\"></div>\n          </div>\n          <span>03</span>\n        </div>\n      </div>\n\n      <div class=\"hn-evo-clean-stack__stage\">\n\n        <!-- CARD 1 -->\n        <a\n          class=\"hn-evo-clean-card\"\n          href=\"https://in.hndrd.co/products/nitrix-thunder\"\n          aria-label=\"Shop Nitrix Thunder\"\n          style=\"--accent:#E4B433; --accent-rgb:228,180,51;\"\n        >\n          <div class=\"hn-evo-clean-card__media\">\n            <span class=\"hn-evo-clean-card__glow\"></span>\n            <span class=\"hn-evo-clean-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1400\"\n              alt=\"Nitrix Thunder badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-clean-card__scrim\"></div>\n\n          <div class=\"hn-evo-clean-card__content\">\n            <span class=\"hn-evo-clean-card__chip\">ATTACK</span>\n            <h3>Nitrix Thunder</h3>\n            <p>Power that ends rallies.</p>\n\n            <div class=\"hn-evo-clean-card__meta\">\n              <span>₹3,990</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n        <!-- CARD 2 -->\n        <a\n          class=\"hn-evo-clean-card\"\n          href=\"https://in.hndrd.co/products/flareon-typhoon\"\n          aria-label=\"Shop Flareon Typhoon\"\n          style=\"--accent:#48B8FF; --accent-rgb:72,184,255;\"\n        >\n          <div class=\"hn-evo-clean-card__media\">\n            <span class=\"hn-evo-clean-card__glow\"></span>\n            <span class=\"hn-evo-clean-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1400\"\n              alt=\"Flareon Typhoon badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-clean-card__scrim\"></div>\n\n          <div class=\"hn-evo-clean-card__content\">\n            <span class=\"hn-evo-clean-card__chip\">SPEED</span>\n            <h3>Flareon Typhoon</h3>\n            <p>Speed that gets there first.</p>\n\n            <div class=\"hn-evo-clean-card__meta\">\n              <span>₹3,490</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n        <!-- CARD 3 -->\n        <a\n          class=\"hn-evo-clean-card\"\n          href=\"https://in.hndrd.co/products/hyfonic-lazer-4u\"\n          aria-label=\"Shop Hyfonic Lazer\"\n          style=\"--accent:#43D7B6; --accent-rgb:67,215,182;\"\n        >\n          <div class=\"hn-evo-clean-card__media\">\n            <span class=\"hn-evo-clean-card__glow\"></span>\n            <span class=\"hn-evo-clean-card__ring\"></span>\n\n            <img\n              src=\"https://in.hndrd.co/cdn/shop/files/1_4e02ab1d-f883-4e7b-aa23-f35a0808d797.png?v=1761629738&width=1400\"\n              alt=\"Hyfonic Lazer badminton racket\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <div class=\"hn-evo-clean-card__scrim\"></div>\n\n          <div class=\"hn-evo-clean-card__content\">\n            <span class=\"hn-evo-clean-card__chip\">PRECISION</span>\n            <h3>Hyfonic Lazer</h3>\n            <p>Precision that stays composed.</p>\n\n            <div class=\"hn-evo-clean-card__meta\">\n              <span>₹3,490</span>\n              <span>Shop now →</span>\n            </div>\n          </div>\n        </a>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-evo-clean-stack,\n  .hn-evo-clean-stack *,\n  .hn-evo-clean-stack *::before,\n  .hn-evo-clean-stack *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-evo-clean-stack {\n    position: relative;\n    width: 100%;\n    height: 300vh;\n    background: #030303;\n    color: #ffffff;\n    overflow: visible;\n  }\n\n  .hn-evo-clean-stack__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 720px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    background: #030303;\n    isolation: isolate;\n  }\n\n  .hn-evo-clean-stack__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(circle at 72% 38%, rgba(255,255,255,0.07), transparent 18%),\n      radial-gradient(circle at 78% 42%, rgba(67,215,182,0.12), transparent 28%),\n      radial-gradient(circle at 20% 24%, rgba(228,180,51,0.09), transparent 24%),\n      linear-gradient(180deg, #030303 0%, #070707 52%, #030303 100%);\n    pointer-events: none;\n  }\n\n  .hn-evo-clean-stack__bg::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(rgba(255,255,255,0.024) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);\n    background-size: 54px 54px;\n    opacity: 0.22;\n    mask-image: radial-gradient(circle at 60% 45%, black 0%, transparent 72%);\n    -webkit-mask-image: radial-gradient(circle at 60% 45%, black 0%, transparent 72%);\n  }\n\n  .hn-evo-clean-stack__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1280px, calc(100% - 40px));\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr);\n    gap: clamp(44px, 7vw, 110px);\n    align-items: center;\n  }\n\n  .hn-evo-clean-stack__copy {\n    max-width: 540px;\n  }\n\n  .hn-evo-clean-stack__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin: 0 0 22px;\n    padding: 8px 12px 8px 9px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.94);\n    color: #060606;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-evo-clean-stack__pill span {\n    width: 16px;\n    height: 16px;\n    border-radius: 999px;\n    background:\n      radial-gradient(circle at 50% 50%, #ffffff 0 28%, transparent 30%),\n      #050505;\n    flex: 0 0 auto;\n  }\n\n  .hn-evo-clean-stack__title {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(54px, 7vw, 104px);\n    line-height: 0.88;\n    font-weight: 900;\n    letter-spacing: -0.075em;\n  }\n\n  .hn-evo-clean-stack__text {\n    margin: 22px 0 0;\n    max-width: 470px;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(16px, 1.35vw, 20px);\n    line-height: 1.45;\n    font-weight: 520;\n    letter-spacing: -0.025em;\n  }\n\n  .hn-evo-clean-stack__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 30px;\n    min-height: 42px;\n    padding: 12px 17px;\n    border-radius: 9px;\n    background: #ffffff;\n    color: #050505;\n    text-decoration: none;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.02em;\n    transition: transform 260ms ease, background 260ms ease;\n  }\n\n  .hn-evo-clean-stack__button:hover {\n    transform: translateY(-2px);\n    background: rgba(255,255,255,0.86);\n  }\n\n  .hn-evo-clean-stack__progress {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-top: 44px;\n    width: min(300px, 100%);\n  }\n\n  .hn-evo-clean-stack__progress span {\n    color: rgba(255,255,255,0.58);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n  }\n\n  .hn-evo-clean-stack__progress-track {\n    position: relative;\n    flex: 1;\n    height: 2px;\n    background: rgba(255,255,255,0.16);\n    overflow: hidden;\n    border-radius: 999px;\n  }\n\n  .hn-evo-clean-stack__progress-fill {\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 0%;\n    height: 100%;\n    background: #ffffff;\n    border-radius: inherit;\n  }\n\n  .hn-evo-clean-stack__stage {\n    position: relative;\n    width: min(470px, 100%);\n    height: 620px;\n    margin-left: auto;\n    overflow: visible;\n    perspective: 1200px;\n  }\n\n  .hn-evo-clean-card {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: min(400px, 100%);\n    height: 550px;\n    display: block;\n    overflow: hidden;\n    border-radius: 24px;\n    color: #ffffff;\n    text-decoration: none;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.02)),\n      #17171a;\n    border: 1px solid rgba(255,255,255,0.13);\n    box-shadow:\n      0 28px 70px rgba(0,0,0,0.42),\n      inset 0 1px 0 rgba(255,255,255,0.10);\n    transform:\n      translate3d(-50%, -50%, 0)\n      translateY(var(--card-y, 0px))\n      scale(var(--card-scale, 1));\n    opacity: var(--card-opacity, 0);\n    z-index: var(--card-z, 1);\n    pointer-events: var(--card-events, none);\n    visibility: var(--card-visibility, hidden);\n    will-change: transform, opacity;\n    transition:\n      opacity 260ms ease,\n      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),\n      visibility 0ms linear 260ms,\n      box-shadow 320ms ease,\n      border-color 320ms ease;\n  }\n\n  .hn-evo-clean-card.is-active {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n    transition:\n      opacity 260ms ease,\n      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),\n      visibility 0ms,\n      box-shadow 320ms ease,\n      border-color 320ms ease;\n  }\n\n  .hn-evo-clean-card:hover {\n    border-color: rgba(255,255,255,0.22);\n    box-shadow:\n      0 36px 95px rgba(0,0,0,0.55),\n      0 0 38px rgba(var(--accent-rgb),0.16),\n      inset 0 1px 0 rgba(255,255,255,0.14);\n  }\n\n  .hn-evo-clean-card__media {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 38px 24px 168px;\n    background:\n      radial-gradient(circle at 50% 28%, rgba(var(--accent-rgb),0.18), transparent 30%),\n      linear-gradient(180deg, #202024 0%, #111115 100%);\n  }\n\n  .hn-evo-clean-card__glow {\n    position: absolute;\n    left: 50%;\n    top: 35%;\n    width: 76%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(var(--accent-rgb),0.34), transparent 68%);\n    filter: blur(24px);\n    opacity: 0.86;\n    animation: hnEvoCleanGlow 4.8s ease-in-out infinite;\n  }\n\n  .hn-evo-clean-card__ring {\n    position: absolute;\n    left: 50%;\n    top: 34%;\n    width: 72%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%) rotate(-16deg);\n    border: 1px solid rgba(255,255,255,0.10);\n    border-radius: 999px;\n    opacity: 0.85;\n  }\n\n  .hn-evo-clean-card__media img {\n    position: relative;\n    z-index: 2;\n    display: block;\n    width: min(88%, 360px);\n    height: auto;\n    object-fit: contain;\n    transform: rotate(-8deg) translateY(8px) scale(1.08);\n    filter:\n      drop-shadow(0 24px 32px rgba(0,0,0,0.48))\n      drop-shadow(0 0 24px rgba(var(--accent-rgb),0.12));\n    animation: hnEvoCleanFloat 5s ease-in-out infinite;\n  }\n\n  .hn-evo-clean-card__scrim {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 52%;\n    z-index: 3;\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,0.88) 0%,\n        rgba(0,0,0,0.70) 38%,\n        rgba(0,0,0,0.26) 72%,\n        rgba(0,0,0,0) 100%\n      );\n    pointer-events: none;\n  }\n\n  .hn-evo-clean-card__content {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 4;\n    padding: 0 22px 24px;\n  }\n\n  .hn-evo-clean-card__chip {\n    display: inline-flex;\n    align-items: center;\n    width: fit-content;\n    min-height: 24px;\n    padding: 0 9px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.92);\n    color: #080808;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.11em;\n  }\n\n  .hn-evo-clean-card__content h3 {\n    margin: 14px 0 0;\n    color: #ffffff;\n    font-size: 34px;\n    line-height: 0.94;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n  }\n\n  .hn-evo-clean-card__content p {\n    margin: 10px 0 0;\n    max-width: 300px;\n    color: rgba(255,255,255,0.76);\n    font-size: 14px;\n    line-height: 1.35;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-evo-clean-card__meta {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: 18px;\n    color: rgba(255,255,255,0.95);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-evo-clean-card__meta span:last-child {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 5px;\n    text-decoration-color: rgba(255,255,255,0);\n    transition: text-decoration-color 220ms ease;\n  }\n\n  .hn-evo-clean-card:hover .hn-evo-clean-card__meta span:last-child {\n    text-decoration-color: rgba(255,255,255,0.9);\n  }\n\n  @keyframes hnEvoCleanGlow {\n    0%, 100% {\n      opacity: 0.68;\n      transform: translate(-50%, -50%) scale(0.96);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.06);\n    }\n  }\n\n  @keyframes hnEvoCleanFloat {\n    0%, 100% {\n      translate: 0 0;\n    }\n\n    50% {\n      translate: 0 -10px;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-evo-clean-stack {\n      height: 300vh;\n    }\n\n    .hn-evo-clean-stack__sticky {\n      height: 100svh;\n      min-height: 700px;\n      align-items: center;\n    }\n\n    .hn-evo-clean-stack__inner {\n      width: min(520px, calc(100% - 28px));\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .hn-evo-clean-stack__copy {\n      max-width: none;\n    }\n\n    .hn-evo-clean-stack__pill {\n      margin-bottom: 14px;\n      padding: 7px 11px 7px 8px;\n      font-size: 11px;\n    }\n\n    .hn-evo-clean-stack__pill span {\n      width: 14px;\n      height: 14px;\n    }\n\n    .hn-evo-clean-stack__title {\n      font-size: clamp(40px, 12vw, 58px);\n      line-height: 0.88;\n    }\n\n    .hn-evo-clean-stack__text {\n      margin-top: 14px;\n      max-width: 96%;\n      font-size: 14px;\n      line-height: 1.36;\n    }\n\n    .hn-evo-clean-stack__button {\n      display: none;\n    }\n\n    .hn-evo-clean-stack__progress {\n      margin-top: 16px;\n      width: min(230px, 100%);\n    }\n\n    .hn-evo-clean-stack__stage {\n      width: 100%;\n      height: 455px;\n      margin: 0 auto;\n    }\n\n    .hn-evo-clean-card {\n      width: min(330px, 100%);\n      height: 430px;\n      border-radius: 22px;\n    }\n\n    .hn-evo-clean-card__media {\n      padding: 28px 18px 140px;\n    }\n\n    .hn-evo-clean-card__media img {\n      width: min(88%, 285px);\n      transform: rotate(-8deg) translateY(2px) scale(1.02);\n    }\n\n    .hn-evo-clean-card__scrim {\n      height: 56%;\n    }\n\n    .hn-evo-clean-card__content {\n      padding: 0 18px 20px;\n    }\n\n    .hn-evo-clean-card__chip {\n      min-height: 22px;\n      padding: 0 8px;\n      font-size: 9px;\n    }\n\n    .hn-evo-clean-card__content h3 {\n      margin-top: 12px;\n      font-size: 28px;\n    }\n\n    .hn-evo-clean-card__content p {\n      margin-top: 8px;\n      font-size: 13px;\n      line-height: 1.3;\n      max-width: 260px;\n    }\n\n    .hn-evo-clean-card__meta {\n      margin-top: 14px;\n      font-size: 12px;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    .hn-evo-clean-stack__sticky {\n      min-height: 680px;\n    }\n\n    .hn-evo-clean-stack__inner {\n      gap: 16px;\n    }\n\n    .hn-evo-clean-stack__stage {\n      height: 420px;\n    }\n\n    .hn-evo-clean-card {\n      width: min(310px, 100%);\n      height: 400px;\n    }\n\n    .hn-evo-clean-card__media img {\n      width: min(86%, 260px);\n    }\n\n    .hn-evo-clean-card__content h3 {\n      font-size: 26px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-evo-clean-stack {\n      height: auto;\n    }\n\n    .hn-evo-clean-stack__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 72px 0;\n    }\n\n    .hn-evo-clean-stack__inner {\n      display: block;\n      width: min(520px, calc(100% - 28px));\n    }\n\n    .hn-evo-clean-stack__stage {\n      height: auto;\n      display: grid;\n      gap: 18px;\n      margin-top: 30px;\n    }\n\n    .hn-evo-clean-card {\n      position: relative;\n      left: auto;\n      top: auto;\n      transform: none !important;\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n      width: 100%;\n    }\n\n    .hn-evo-clean-card,\n    .hn-evo-clean-card__media img,\n    .hn-evo-clean-card__glow {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnEvoCleanStack');\n    if (!section || section.dataset.ready === 'true') return;\n    section.dataset.ready = 'true';\n\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-clean-card'));\n    var fill = section.querySelector('.hn-evo-clean-stack__progress-fill');\n    var ticking = false;\n\n    if (!cards.length) return;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function getProgress() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      return total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n    }\n\n    function update() {\n      var progress = getProgress();\n      var maxIndex = cards.length - 1;\n      var exact = progress * maxIndex;\n      var activeIndex = Math.round(exact);\n\n      activeIndex = clamp(activeIndex, 0, maxIndex);\n\n      if (fill) {\n        fill.style.width = (progress * 100).toFixed(2) + '%';\n      }\n\n      cards.forEach(function (card, index) {\n        var isActive = index === activeIndex;\n\n        card.classList.toggle('is-active', isActive);\n\n        if (isActive) {\n          card.style.setProperty('--card-y', '0px');\n          card.style.setProperty('--card-scale', '1');\n          card.style.setProperty('--card-opacity', '1');\n          card.style.setProperty('--card-z', '10');\n          card.style.setProperty('--card-events', 'auto');\n          card.style.setProperty('--card-visibility', 'visible');\n        } else if (index < activeIndex) {\n          card.style.setProperty('--card-y', '-180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        } else {\n          card.style.setProperty('--card-y', '180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        }\n      });\n\n      ticking = false;\n    }\n\n    function requestUpdate() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestUpdate, { passive: true });\n    window.addEventListener('resize', requestUpdate);\n    window.addEventListener('load', requestUpdate);\n\n    update();\n  })();\n</script>\n<style>\n  /* =========================================\n     HNDRD EVO STACK - PROGRESS + SCROLL HINT FIX\n  ========================================= */\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-top: 44px;\n    width: min(320px, 100%);\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-step,\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-total {\n    color: rgba(255,255,255,0.7);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n    min-width: 22px;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-track {\n    position: relative;\n    flex: 1;\n    height: 2px;\n    background: rgba(255,255,255,0.16);\n    border-radius: 999px;\n    overflow: hidden;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-fill {\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 0%;\n    background: #ffffff;\n    border-radius: inherit;\n    transition: width 220ms ease;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-fill::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    top: 50%;\n    width: 8px;\n    height: 8px;\n    border-radius: 999px;\n    background: #ffffff;\n    transform: translate(50%, -50%);\n    box-shadow: 0 0 0 4px rgba(255,255,255,0.08);\n  }\n\n  /* Scroll hint */\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 16px;\n    color: rgba(255,255,255,0.56);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    user-select: none;\n    pointer-events: none;\n    transition: opacity 240ms ease, transform 240ms ease;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint.is-hidden {\n    opacity: 0;\n    transform: translateY(-6px);\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-icon {\n    width: 18px;\n    height: 18px;\n    display: inline-grid;\n    place-items: center;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    color: #ffffff;\n    font-size: 12px;\n    line-height: 1;\n    animation: hnEvoScrollBlink 1.2s ease-in-out infinite;\n  }\n\n  @keyframes hnEvoScrollBlink {\n    0%, 100% {\n      opacity: 0.45;\n      transform: translateY(0);\n    }\n    50% {\n      opacity: 1;\n      transform: translateY(4px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #hnEvoCleanStack .hn-evo-clean-stack__progress {\n      margin-top: 16px;\n      width: min(230px, 100%);\n    }\n\n    #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint {\n      margin-top: 12px;\n      font-size: 10px;\n    }\n\n    #hnEvoCleanStack .hn-evo-clean-stack__scroll-icon {\n      width: 16px;\n      height: 16px;\n      font-size: 11px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnEvoCleanStack');\n    if (!section) return;\n\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-clean-card'));\n    var progressWrap = section.querySelector('.hn-evo-clean-stack__progress');\n    var fill = section.querySelector('.hn-evo-clean-stack__progress-fill');\n    var copy = section.querySelector('.hn-evo-clean-stack__copy');\n\n    if (!cards.length || !progressWrap || !fill || !copy) return;\n\n    /* Replace old progress text nodes with dedicated elements if needed */\n    var currentStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-step');\n    var totalStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-total');\n\n    if (!currentStep || !totalStep) {\n      progressWrap.innerHTML = `\n        <span class=\"hn-evo-clean-stack__progress-step\">01</span>\n        <div class=\"hn-evo-clean-stack__progress-track\">\n          <div class=\"hn-evo-clean-stack__progress-fill\"></div>\n        </div>\n        <span class=\"hn-evo-clean-stack__progress-total\">03</span>\n      `;\n      currentStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-step');\n      totalStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-total');\n      fill = progressWrap.querySelector('.hn-evo-clean-stack__progress-fill');\n    }\n\n    /* Add scroll hint once */\n    var scrollHint = copy.querySelector('.hn-evo-clean-stack__scroll-hint');\n    if (!scrollHint) {\n      scrollHint = document.createElement('div');\n      scrollHint.className = 'hn-evo-clean-stack__scroll-hint';\n      scrollHint.innerHTML = `\n        <span class=\"hn-evo-clean-stack__scroll-icon\">↓</span>\n        <span>Scroll</span>\n      `;\n      copy.appendChild(scrollHint);\n    }\n\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function formatStep(value) {\n      return String(value).padStart(2, '0');\n    }\n\n    function updateProgressAndHint() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var maxIndex = cards.length - 1;\n      var exact = progress * maxIndex;\n      var activeIndex = Math.round(exact);\n      activeIndex = clamp(activeIndex, 0, maxIndex);\n\n      /* Smooth full progress line */\n      fill.style.width = (progress * 100).toFixed(2) + '%';\n\n      /* Step count */\n      currentStep.textContent = formatStep(activeIndex + 1);\n      totalStep.textContent = formatStep(cards.length);\n\n      /* Hide hint after user starts scrolling section */\n      if (progress > 0.08) {\n        scrollHint.classList.add('is-hidden');\n      } else {\n        scrollHint.classList.remove('is-hidden');\n      }\n\n      ticking = false;\n    }\n\n    function requestUpdate() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateProgressAndHint);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestUpdate, { passive: true });\n    window.addEventListener('resize', requestUpdate);\n    window.addEventListener('load', requestUpdate);\n\n    updateProgressAndHint();\n  })();\n</script>\n<style>\n  /* ==================================================\n     HNDRD EVO PROGRESS BAR HARD FIX\n     Works even if old width styles are breaking it\n  ================================================== */\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress {\n    display: flex !important;\n    align-items: center !important;\n    gap: 12px !important;\n    margin-top: 18px !important;\n    width: min(320px, 100%) !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-step,\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-total {\n    color: rgba(255,255,255,0.72) !important;\n    font-size: 11px !important;\n    line-height: 1 !important;\n    font-weight: 850 !important;\n    letter-spacing: 0.12em !important;\n    min-width: 22px !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-track {\n    position: relative !important;\n    flex: 1 !important;\n    height: 2px !important;\n    background: rgba(255,255,255,0.18) !important;\n    border-radius: 999px !important;\n    overflow: visible !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-fill {\n    position: absolute !important;\n    left: 0 !important;\n    top: 0 !important;\n    bottom: 0 !important;\n    width: 100% !important;\n    height: 100% !important;\n    background: #ffffff !important;\n    border-radius: 999px !important;\n    transform-origin: left center !important;\n    transform: scaleX(var(--hn-evo-progress, 0)) !important;\n    transition: transform 120ms linear !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__progress-fill::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    top: 50%;\n    width: 7px;\n    height: 7px;\n    border-radius: 999px;\n    background: #ffffff;\n    transform: translate(50%, -50%);\n    box-shadow: 0 0 0 4px rgba(255,255,255,0.08);\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint {\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    margin-top: 12px !important;\n    color: rgba(255,255,255,0.58) !important;\n    font-size: 11px !important;\n    line-height: 1 !important;\n    font-weight: 850 !important;\n    letter-spacing: 0.12em !important;\n    text-transform: uppercase !important;\n    pointer-events: none !important;\n    transition: opacity 220ms ease, transform 220ms ease !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint.is-hidden {\n    opacity: 0 !important;\n    transform: translateY(-6px) !important;\n  }\n\n  #hnEvoCleanStack .hn-evo-clean-stack__scroll-icon {\n    width: 18px !important;\n    height: 18px !important;\n    display: inline-grid !important;\n    place-items: center !important;\n    border-radius: 999px !important;\n    background: rgba(255,255,255,0.08) !important;\n    color: #ffffff !important;\n    font-size: 12px !important;\n    animation: hnEvoDownBlink 1.15s ease-in-out infinite !important;\n  }\n\n  @keyframes hnEvoDownBlink {\n    0%, 100% {\n      opacity: 0.45;\n      transform: translateY(0);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translateY(5px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #hnEvoCleanStack .hn-evo-clean-stack__progress {\n      margin-top: 14px !important;\n      width: min(230px, 100%) !important;\n    }\n\n    #hnEvoCleanStack .hn-evo-clean-stack__scroll-hint {\n      margin-top: 10px !important;\n      font-size: 10px !important;\n    }\n\n    #hnEvoCleanStack .hn-evo-clean-stack__scroll-icon {\n      width: 16px !important;\n      height: 16px !important;\n      font-size: 11px !important;\n    }\n  }\n</style>\n\n<script>\n  /* ==================================================\n     HNDRD EVO PROGRESS BAR HARD FIX\n     Uses transform scaleX instead of width\n  ================================================== */\n  (function () {\n    var section = document.getElementById('hnEvoCleanStack');\n    if (!section) return;\n\n    var copy = section.querySelector('.hn-evo-clean-stack__copy');\n    var progressWrap = section.querySelector('.hn-evo-clean-stack__progress');\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-clean-card'));\n\n    if (!copy || !progressWrap || !cards.length) return;\n\n    /* Rebuild progress markup cleanly */\n    progressWrap.innerHTML =\n      '<span class=\"hn-evo-clean-stack__progress-step\">01</span>' +\n      '<div class=\"hn-evo-clean-stack__progress-track\">' +\n        '<div class=\"hn-evo-clean-stack__progress-fill\"></div>' +\n      '</div>' +\n      '<span class=\"hn-evo-clean-stack__progress-total\">03</span>';\n\n    var currentStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-step');\n    var totalStep = progressWrap.querySelector('.hn-evo-clean-stack__progress-total');\n    var fill = progressWrap.querySelector('.hn-evo-clean-stack__progress-fill');\n\n    /* Add scroll hint once */\n    var scrollHint = copy.querySelector('.hn-evo-clean-stack__scroll-hint');\n\n    if (!scrollHint) {\n      scrollHint = document.createElement('div');\n      scrollHint.className = 'hn-evo-clean-stack__scroll-hint';\n      scrollHint.innerHTML =\n        '<span class=\"hn-evo-clean-stack__scroll-icon\">↓</span>' +\n        '<span>Scroll</span>';\n      copy.appendChild(scrollHint);\n    }\n\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function twoDigits(value) {\n      return String(value).padStart(2, '0');\n    }\n\n    function getProgress() {\n      var rect = section.getBoundingClientRect();\n      var viewport = window.innerHeight || document.documentElement.clientHeight;\n      var total = section.offsetHeight - viewport;\n\n      if (total <= 0) return 0;\n\n      return clamp(-rect.top / total, 0, 1);\n    }\n\n    function updateProgress() {\n      var progress = getProgress();\n      var maxIndex = cards.length - 1;\n      var activeIndex = Math.round(progress * maxIndex);\n\n      activeIndex = clamp(activeIndex, 0, maxIndex);\n\n      /* This is the actual moving bar */\n      section.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n      progressWrap.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n      fill.style.setProperty('transform', 'scaleX(' + progress.toFixed(4) + ')', 'important');\n\n      currentStep.textContent = twoDigits(activeIndex + 1);\n      totalStep.textContent = twoDigits(cards.length);\n\n      if (progress > 0.08) {\n        scrollHint.classList.add('is-hidden');\n      } else {\n        scrollHint.classList.remove('is-hidden');\n      }\n\n      ticking = false;\n    }\n\n    function requestProgress() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateProgress);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestProgress, { passive: true });\n    window.addEventListener('resize', requestProgress);\n    window.addEventListener('load', requestProgress);\n\n    /* Keeps it synced inside Shopify editor too */\n    setInterval(updateProgress, 180);\n\n    updateProgress();\n  })();\n</script>",
