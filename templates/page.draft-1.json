: 0 0 56%;\n    border-radius: 24px;\n    overflow: hidden;\n    background: #050504;\n    border: 1px solid rgba(255,255,255,0.1);\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 20px));\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-version-cards__image img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: contain;\n    object-position: center;\n    background: #050504;\n  }\n\n  .hn-version-cards__content {\n    position: relative;\n    z-index: 4;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 24px 10px 2px;\n    color: #fff;\n  }\n\n  .hn-version-cards__content h3 {\n    margin: 0;\n    max-width: 96%;\n    color: rgba(255,255,255,0.98);\n    font-size: clamp(24px, 1.9vw, 34px);\n    line-height: 0.98;\n    font-weight: 900;\n    letter-spacing: -0.055em;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 22px));\n    text-shadow: 0 14px 36px rgba(0,0,0,0.48);\n  }\n\n  .hn-version-cards__content p {\n    margin: 14px 0 0;\n    max-width: 95%;\n    color: rgba(255,255,255,0.74);\n    font-size: clamp(13px, 0.95vw, 15px);\n    line-height: 1.42;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 18px));\n  }\n\n  .hn-version-cards__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    width: fit-content;\n    margin-top: auto;\n    min-height: 42px;\n    padding: 13px 18px;\n    border-radius: 999px;\n    color: #ffffff;\n    background: rgba(255,255,255,0.1);\n    border: 1px solid rgba(255,255,255,0.24);\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 16px));\n    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;\n  }\n\n  .hn-version-cards__button span {\n    font-size: 14px;\n    line-height: 1;\n  }\n\n  .hn-version-cards__button:hover {\n    background: #ffffff;\n    color: #050504;\n    border-color: #ffffff;\n    transform: translateX(4px) !important;\n  }\n\n  @keyframes hnFightPulse {\n    0%, 100% {\n      opacity: 0.65;\n      transform: translate(-50%, -50%) scale(0.94);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @keyframes hnFightScroll {\n    0%, 100% {\n      transform: translateY(0);\n      opacity: 0.72;\n    }\n\n    50% {\n      transform: translateY(7px);\n      opacity: 1;\n    }\n  }\n\n  @keyframes hnVersionGlow {\n    0%, 100% {\n      opacity: 0.52;\n      transform: translate(-50%, -50%) scale(0.95);\n    }\n\n    50% {\n      opacity: 0.9;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-version-cards {\n      height: auto;\n      padding: 76px 0 86px;\n      overflow: hidden;\n    }\n\n    .hn-version-cards__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 0;\n      overflow: visible;\n      display: block;\n    }\n\n    .hn-version-cards__inner {\n      width: 100%;\n    }\n\n    .hn-version-cards__heading-wrap {\n      margin-bottom: 28px;\n      padding: 0 16px;\n      overflow: hidden;\n    }\n\n    .hn-version-cards__heading {\n      white-space: normal;\n      font-size: clamp(25px, 7vw, 38px);\n      line-height: 1;\n      letter-spacing: -0.055em;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-version-cards__grid {\n      display: flex;\n      grid-template-columns: none;\n      gap: 16px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding: 18px;\n      padding: 0 18px 10px;\n      -webkit-overflow-scrolling: touch;\n      perspective: none;\n    }\n\n    .hn-version-cards__grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-version-cards__grid {\n      scrollbar-width: none;\n    }\n\n    .hn-version-cards__card {\n      flex: 0 0 min(84vw, 410px);\n      aspect-ratio: 3 / 4;\n      min-height: auto;\n      border-radius: 28px;\n      padding: 14px;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      opacity: 1;\n      transform: none;\n      --card-show: 1 !important;\n      --content-show: 1 !important;\n    }\n\n    .hn-version-cards__number {\n      top: 26px;\n      right: 28px;\n      font-size: 12px;\n    }\n\n    .hn-version-cards__image {\n      height: 55%;\n      flex-basis: 55%;\n      border-radius: 22px;\n    }\n\n    .hn-version-cards__content {\n      padding: 21px 8px 2px;\n    }\n\n    .hn-version-cards__content h3 {\n      max-width: 100%;\n      font-size: clamp(23px, 7vw, 34px);\n    }\n\n    .hn-version-cards__content p {\n      max-width: 100%;\n      font-size: 13px;\n      line-height: 1.4;\n      margin-top: 12px;\n    }\n\n    .hn-version-cards__button {\n      min-height: 40px;\n      padding: 12px 16px;\n      font-size: 11px;\n      margin-top: auto;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-fight-video-hero {\n      height: 140vh;\n    }\n\n    .hn-fight-video-hero__sticky {\n      min-height: 620px;\n    }\n\n    .hn-fight-video-hero__content {\n      width: min(100%, calc(100% - 24px));\n    }\n\n    .hn-fight-video-hero__kicker {\n      font-size: 13px;\n      margin-bottom: 10px;\n    }\n\n    .hn-fight-video-hero__title {\n      font-size: clamp(48px, 15vw, 76px);\n      letter-spacing: -0.06em;\n    }\n\n    .hn-fight-video-hero__subline {\n      max-width: 340px;\n      font-size: 15px;\n    }\n\n    .hn-fight-video-hero__scroll {\n      margin-top: 34px;\n      font-size: 11px;\n    }\n\n    .hn-fight-video-hero__frame {\n      width: min(390px, calc(100% - 34px));\n      aspect-ratio: 9 / 16;\n      border-radius: 22px;\n    }\n\n    .hn-fight-video-hero__panels {\n      gap: 8px;\n    }\n\n    .hn-fight-video-hero__panel {\n      border-radius: 14px;\n    }\n  }\n/* ================================\n   GRADIENT TEXT DISAPPEARING FIX\n   NO COLOR / CONTENT CHANGE\n================================ */\n\n#hnFightVideoHero .hn-fight-video-hero__content {\n  z-index: 60 !important;\n  isolation: isolate !important;\n}\n\n#hnFightVideoHero .hn-fight-video-hero__title {\n  position: relative !important;\n  display: inline-block !important;\n  z-index: 61 !important;\n\n  isolation: isolate !important;\n  -webkit-transform: translate3d(0, 0, 0) !important;\n  transform: translate3d(0, 0, 0) !important;\n  -webkit-backface-visibility: hidden !important;\n  backface-visibility: hidden !important;\n  will-change: transform !important;\n\n  /* Important: filter can break gradient clipped text during scroll */\n  filter: none !important;\n  text-shadow: 0 16px 34px rgba(0, 0, 0, 0.46) !important;\n\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n}\n\n/* Also protect the smaller hero text */\n#hnFightVideoHero .hn-fight-video-hero__kicker,\n#hnFightVideoHero .hn-fight-video-hero__subline,\n#hnFightVideoHero .hn-fight-video-hero__scroll {\n  position: relative !important;\n  z-index: 61 !important;\n  isolation: isolate !important;\n  -webkit-transform: translate3d(0, 0, 0) !important;\n  transform: translate3d(0, 0, 0) !important;\n  -webkit-backface-visibility: hidden !important;\n  backface-visibility: hidden !important;\n}\n\n/* Keep video/frame behind content until animation handles it */\n#hnFightVideoHero .hn-fight-video-hero__frame {\n  z-index: 20 !important;\n}\n\n#hnFightVideoHero .hn-fight-video-hero__bg {\n  z-index: 1 !important;\n}\n\n/* Same protection for the gradient heading in next section */\n.hn-version-cards__heading {\n  isolation: isolate !important;\n  -webkit-transform: translate3d(0, 0, 0) !important;\n  transform: translate3d(0, 0, 0) !important;\n  -webkit-backface-visibility: hidden !important;\n  backface-visibility: hidden !important;\n  will-change: opacity, transform !important;\n\n  filter: none !important;\n  text-shadow: 0 18px 42px rgba(0, 0, 0, 0.42) !important;\n\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n}\n\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section) return;\n\n    var desktopVideo = 'https://cdn.shopify.com/videos/c/o/v/ce41e89287c0430e9d9c2d5d1d105beb.mp4';\n    var mobileVideo = 'https://cdn.shopify.com/videos/c/o/v/04e8c483b0904cc1bfd6c5ce8645d553.mp4';\n\n    var content = section.querySelector('.hn-fight-video-hero__content');\n    var bgVideo = section.querySelector('.hn-fight-video-hero__bg-video');\n    var frame = section.querySelector('.hn-fight-video-hero__frame');\n    var mainVideo = section.querySelector('.hn-fight-video-hero__main-video');\n    var panelsWrap = section.querySelector('.hn-fight-video-hero__panels');\n    var panels = section.querySelectorAll('.hn-fight-video-hero__panel');\n    var allVideos = section.querySelectorAll('.js-hn-fight-video');\n\n    var currentSrc = '';\n    var videosLoaded = false;\n    var ticking = false;\n\n    function getVideoSrc() {\n      return window.matchMedia('(max-width: 749px)').matches ? mobileVideo : desktopVideo;\n    }\n\n    function loadVideosOnlyAfterScroll() {\n      if (videosLoaded) return;\n\n      var rect = section.getBoundingClientRect();\n      var sectionIsNear = rect.top < window.innerHeight * 1.15 && rect.bottom > -window.innerHeight * 0.25;\n      var userHasScrolled = window.scrollY > 20 || window.pageYOffset > 20;\n\n      if (!sectionIsNear || !userHasScrolled) return;\n\n      videosLoaded = true;\n      currentSrc = getVideoSrc();\n\n      allVideos.forEach(function (video) {\n        video.src = currentSrc;\n        video.muted = true;\n        video.loop = true;\n        video.playsInline = true;\n        video.preload = 'auto';\n        video.load();\n\n        var playPromise = video.play();\n        if (playPromise && typeof playPromise.catch === 'function') {\n          playPromise.catch(function () {});\n        }\n      });\n    }\n\n    function updateVideoSourceOnResize() {\n      if (!videosLoaded) return;\n\n      var nextSrc = getVideoSrc();\n      if (nextSrc === currentSrc) return;\n\n      currentSrc = nextSrc;\n\n      allVideos.forEach(function (video) {\n        var oldTime = video.currentTime || 0;\n\n        video.src = currentSrc;\n        video.load();\n\n        video.addEventListener('loadedmetadata', function setTimeOnce() {\n          video.removeEventListener('loadedmetadata', setTimeOnce);\n\n          try {\n            video.currentTime = oldTime;\n          } catch (e) {}\n\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        });\n      });\n    }\n\n    function syncVideos(force) {\n      if (!videosLoaded || !allVideos.length) return;\n\n      var master = bgVideo && bgVideo.duration ? bgVideo : mainVideo;\n      if (!master || !master.duration) return;\n\n      allVideos.forEach(function (video) {\n        if (video === master || !video.duration) return;\n\n        var diff = Math.abs(video.currentTime - master.currentTime);\n\n        if (force || diff > 0.055) {\n          try {\n            video.currentTime = master.currentTime;\n          } catch (e) {}\n        }\n\n        if (video.paused) {\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        }\n      });\n    }\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function updateHero() {\n      loadVideosOnlyAfterScroll();\n      syncVideos(false);\n\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var textFade = easeOutCubic(clamp(progress / 0.28, 0, 1));\n      var frameIn = easeOutCubic(clamp((progress - 0.16) / 0.24, 0, 1));\n      var merge = easeOutCubic(clamp((progress - 0.42) / 0.34, 0, 1));\n      var finalVideo = easeOutCubic(clamp((progress - 0.66) / 0.18, 0, 1));\n\n      if (content) {\n        content.style.opacity = 1 - textFade;\n        content.style.transform =\n          'translateY(' + (-2 - textFade * 9) + 'vh) scale(' + (1 - textFade * 0.035) + ')';\n      }\n\n      if (bgVideo) {\n        bgVideo.style.opacity = 1 - frameIn * 0.5;\n        bgVideo.style.transform = 'scale(' + (1.08 + progress * 0.08) + ')';\n      }\n\n      if (frame) {\n        frame.style.opacity = frameIn;\n        frame.style.transform =\n          'translate(-50%, -50%) scale(' + (1.12 - frameIn * 0.12) + ')';\n      }\n\n      if (panelsWrap) {\n        panelsWrap.style.gap = (18 - merge * 18) + 'px';\n        panelsWrap.style.opacity = 1 - finalVideo;\n      }\n\n      if (mainVideo) {\n        mainVideo.style.opacity = finalVideo;\n      }\n\n      if (panels.length) {\n        var isMobile = window.matchMedia('(max-width: 749px)').matches;\n        var startMove = isMobile ? 12 : 18;\n        var sideMove = startMove - merge * startMove;\n        var centerDrop = 10 - merge * 10;\n        var radius = isMobile ? 14 - merge * 14 : 22 - merge * 22;\n\n        panels[0].style.transform = 'translateX(-' + sideMove + 'vw)';\n        panels[1].style.transform = 'translateY(' + centerDrop + 'vh)';\n        panels[2].style.transform = 'translateX(' + sideMove + 'vw)';\n\n        panels.forEach(function (panel) {\n          panel.style.borderRadius = radius + 'px';\n        });\n      }\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateHero);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      updateVideoSourceOnResize();\n      requestTick();\n    });\n\n    setInterval(function () {\n      syncVideos(true);\n    }, 300);\n\n    updateHero();\n  })();\n\n  (function () {\n    var section = document.getElementById('hnVersionCards');\n    if (!section || section.dataset.hnReady === 'true') return;\n    section.dataset.hnReady = 'true';\n\n    var heading = section.querySelector('.hn-version-cards__heading');\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-version-cards__card'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobileLayout() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setMobileFinalState() {\n      if (heading) {\n        heading.style.opacity = 1;\n        heading.style.transform = 'none';\n      }\n\n      cards.forEach(function (card) {\n        card.style.setProperty('--card-show', 1);\n        card.style.setProperty('--content-show', 1);\n      });\n    }\n\n    function setDesktopMotion() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var headingProgress = easeOutCubic(clamp(progress / 0.30, 0, 1));\n\n      if (heading) {\n        heading.style.opacity = headingProgress;\n        heading.style.transform =\n          'translateY(' + ((1 - headingProgress) * 28) + 'px) scale(' + (0.98 + headingProgress * 0.02) + ')';\n      }\n\n      cards.forEach(function (card, index) {\n        var stagger = index * 0.12;\n        var cardShow = easeOutCubic(clamp((progress - 0.22 - stagger) / 0.34, 0, 1));\n        var contentShow = easeOutCubic(clamp((progress - 0.32 - stagger) / 0.34, 0, 1));\n\n        card.style.setProperty('--card-show', cardShow.toFixed(3));\n        card.style.setProperty('--content-show', contentShow.toFixed(3));\n      });\n    }\n\n    function update() {\n      if (isMobileLayout()) {\n        setMobileFinalState();\n      } else {\n        setDesktopMotion();\n      }\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    update();\n  })();\n</script>\n<style>\n  /* =========================================\n     HERO VIDEO BLUR TWEAK\n     Desktop + Mobile optimized\n  ========================================= */\n\n  #hnFightVideoHero {\n    --hn-hero-bg-blur: 5px;\n    --hn-hero-frame-blur: 0px;\n    --hn-hero-text-blur-opacity: 0.72;\n  }\n\n  /* Main background video blur */\n  #hnFightVideoHero .hn-fight-video-hero__bg-video {\n    filter:\n      blur(var(--hn-hero-bg-blur))\n      grayscale(0%)\n      saturate(112%)\n      contrast(1.04)\n      brightness(1.08) !important;\n  }\n\n  /* Frame / played video blur when it comes in */\n  #hnFightVideoHero .hn-fight-video-hero__main-video,\n  #hnFightVideoHero .hn-fight-video-hero__panel video {\n    filter:\n      blur(var(--hn-hero-frame-blur))\n      grayscale(0%)\n      saturate(112%)\n      contrast(1.04)\n      brightness(1.08) !important;\n  }\n\n  /* Soft blur spot behind hero text */\n  #hnFightVideoHero .hn-fight-video-hero__content {\n    position: relative !important;\n    isolation: isolate !important;\n  }\n\n  #hnFightVideoHero .hn-fight-video-hero__content::before {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    left: 50%;\n    top: 50%;\n    width: min(760px, 90vw);\n    height: min(330px, 42vh);\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background:\n      radial-gradient(\n        circle at 50% 50%,\n        rgba(0, 0, 0, 0.34) 0%,\n        rgba(0, 0, 0, 0.24) 42%,\n        rgba(0, 0, 0, 0.00) 72%\n      );\n    backdrop-filter: blur(9px);\n    -webkit-backdrop-filter: blur(9px);\n    opacity: var(--hn-hero-text-blur-opacity);\n    pointer-events: none;\n  }\n\n  /* Keep text ultra clear above the blur */\n  #hnFightVideoHero .hn-fight-video-hero__kicker,\n  #hnFightVideoHero .hn-fight-video-hero__title,\n  #hnFightVideoHero .hn-fight-video-hero__subline,\n  #hnFightVideoHero .hn-fight-video-hero__scroll {\n    position: relative !important;\n    z-index: 2 !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    #hnFightVideoHero {\n      --hn-hero-bg-blur: 6px;\n      --hn-hero-frame-blur: 1.5px;\n      --hn-hero-text-blur-opacity: 0.78;\n    }\n\n    #hnFightVideoHero .hn-fight-video-hero__content::before {\n      width: min(360px, 92vw);\n      height: 310px;\n      backdrop-filter: blur(8px);\n      -webkit-backdrop-filter: blur(8px);\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section || section.dataset.hnBlurTweak === 'true') return;\n\n    section.dataset.hnBlurTweak = 'true';\n\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 749px)').matches;\n    }\n\n    function updateHeroBlur() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      /*\n        Blur behavior:\n        - Base bg stays medium blurred.\n        - As the frame/card comes in, bg gets slightly more blur.\n        - Played/frame video gets a light blur only after it appears.\n      */\n      var frameIn = easeOutCubic(clamp((progress - 0.16) / 0.24, 0, 1));\n      var finalVideo = easeOutCubic(clamp((progress - 0.66) / 0.18, 0, 1));\n\n      var baseBgBlur = isMobile() ? 6 : 5;\n      var extraBgBlur = isMobile() ? 3 : 2.5;\n      var frameBlurMax = isMobile() ? 2.2 : 2;\n\n      var bgBlur = baseBgBlur + frameIn * extraBgBlur;\n      var frameBlur = finalVideo * frameBlurMax;\n      var textBlurOpacity = 0.72 + frameIn * 0.08;\n\n      section.style.setProperty('--hn-hero-bg-blur', bgBlur.toFixed(2) + 'px');\n      section.style.setProperty('--hn-hero-frame-blur', frameBlur.toFixed(2) + 'px');\n      section.style.setProperty('--hn-hero-text-blur-opacity', textBlurOpacity.toFixed(2));\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateHeroBlur);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    updateHeroBlur();\n  })();\n</script>\n<style>\n  /* ==================================================\n     HNDRD HERO CORRECT BLUR LOGIC\n     Outer bg blurred. Inner card always sharp.\n  ================================================== */\n\n  #hnFightVideoHero {\n    --hn-hero-bg-blur: 6px !important;\n    --hn-hero-frame-blur: 0px !important;\n    --hn-hero-text-blur-opacity: 0 !important;\n  }\n\n  /* OUTER BACKGROUND VIDEO: always blurred */\n  #hnFightVideoHero .hn-fight-video-hero__bg-video {\n    filter:\n      blur(var(--hn-hero-bg-blur))\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.16) !important;\n\n    -webkit-filter:\n      blur(var(--hn-hero-bg-blur))\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.16) !important;\n  }\n\n  /* INNER CARD MAIN VIDEO: never blurred */\n  #hnFightVideoHero .hn-fight-video-hero__main-video {\n    filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(118%)\n      contrast(1.02)\n      brightness(1.12) !important;\n\n    -webkit-filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(118%)\n      contrast(1.02)\n      brightness(1.12) !important;\n  }\n\n  /* INNER 3 SPLIT VIDEOS: never blurred */\n  #hnFightVideoHero .hn-fight-video-hero__panel video {\n    filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.08) !important;\n\n    -webkit-filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.08) !important;\n  }\n\n  /* Keep card clean during transform animation */\n  #hnFightVideoHero .hn-fight-video-hero__frame,\n  #hnFightVideoHero .hn-fight-video-hero__panels,\n  #hnFightVideoHero .hn-fight-video-hero__panel,\n  #hnFightVideoHero .hn-fight-video-hero__main-video,\n  #hnFightVideoHero .hn-fight-video-hero__panel video {\n    filter: none;\n    backface-visibility: hidden !important;\n    -webkit-backface-visibility: hidden !important;\n    transform-style: flat !important;\n  }\n\n  /* But keep actual video filters on videos */\n  #hnFightVideoHero .hn-fight-video-hero__main-video,\n  #hnFightVideoHero .hn-fight-video-hero__panel video {\n    filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.08) !important;\n  }\n\n  /* Remove only the black blur patch behind text */\n  #hnFightVideoHero .hn-fight-video-hero__content::before {\n    content: none !important;\n    display: none !important;\n    opacity: 0 !important;\n    background: none !important;\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n\n  /* Keep original title gradient colors */\n  #hnFightVideoHero .hn-fight-video-hero__title {\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    ) !important;\n    -webkit-background-clip: text !important;\n    background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    color: transparent !important;\n    filter: none !important;\n    -webkit-filter: none !important;\n    text-shadow:\n      0 3px 10px rgba(0, 0, 0, 0.72),\n      0 16px 38px rgba(0, 0, 0, 0.62) !important;\n  }\n\n  #hnFightVideoHero .hn-fight-video-hero__kicker,\n  #hnFightVideoHero .hn-fight-video-hero__subline,\n  #hnFightVideoHero .hn-fight-video-hero__scroll {\n    color: rgba(255, 255, 255, 0.96) !important;\n    text-shadow:\n      0 3px 10px rgba(0, 0, 0, 0.82),\n      0 12px 30px rgba(0, 0, 0, 0.68) !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    #hnFightVideoHero {\n      --hn-hero-bg-blur: 7px !important;\n      --hn-hero-frame-blur: 0px !important;\n    }\n  }\n</style>\n\n<script>\n  /* ==================================================\n     LOCK ONLY THE CARD VIDEO BLUR TO ZERO\n     Background stays blurred.\n  ================================================== */\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section) return;\n\n    var frame = section.querySelector('.hn-fight-video-hero__frame');\n    var bgVideo = section.querySelector('.hn-fight-video-hero__bg-video');\n    var mainVideo = section.querySelector('.hn-fight-video-hero__main-video');\n    var panelVideos = section.querySelectorAll('.hn-fight-video-hero__panel video');\n\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 749px)').matches;\n    }\n\n    function lockCorrectBlur() {\n      var bgBlur = isMobile() ? '7px' : '6px';\n\n      section.style.setProperty('--hn-hero-bg-blur', bgBlur, 'important');\n      section.style.setProperty('--hn-hero-frame-blur', '0px', 'important');\n      section.style.setProperty('--hn-hero-text-blur-opacity', '0', 'important');\n\n      if (bgVideo) {\n        bgVideo.style.setProperty(\n          'filter',\n          'blur(' + bgBlur + ') grayscale(0%) saturate(115%) contrast(1.02) brightness(1.16)',\n          'important'\n        );\n        bgVideo.style.setProperty(\n          '-webkit-filter',\n          'blur(' + bgBlur + ') grayscale(0%) saturate(115%) contrast(1.02) brightness(1.16)',\n          'important'\n        );\n      }\n\n      if (mainVideo) {\n        mainVideo.style.setProperty(\n          'filter',\n          'blur(0px) grayscale(0%) saturate(118%) contrast(1.02) brightness(1.12)',\n          'important'\n        );\n        mainVideo.style.setProperty(\n          '-webkit-filter',\n          'blur(0px) grayscale(0%) saturate(118%) contrast(1.02) brightness(1.12)',\n          'important'\n        );\n      }\n\n      panelVideos.forEach(function (video) {\n        video.style.setProperty(\n          'filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n        video.style.setProperty(\n          '-webkit-filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n      });\n\n      /*\n        This restores the original frame scale animation.\n        Important because the earlier fix had forced the frame to scale(1).\n      */\n      if (frame) {\n        var rect = section.getBoundingClientRect();\n        var total = section.offsetHeight - window.innerHeight;\n        var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n        var frameIn = easeOutCubic(clamp((progress - 0.16) / 0.24, 0, 1));\n        var frameScale = 1.12 - frameIn * 0.12;\n\n        frame.style.setProperty(\n          'transform',\n          'translate(-50%, -50%) scale(' + frameScale + ')',\n          'important'\n        );\n      }\n\n      ticking = false;\n    }\n\n    function requestLock() {\n      if (!ticking) {\n        window.requestAnimationFrame(lockCorrectBlur);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestLock, { passive: true });\n    window.addEventListener('resize', requestLock);\n\n    setInterval(lockCorrectBlur, 120);\n\n    lockCorrectBlur();\n  })();\n</script>\n<style>\n  /* ==================================================\n     FINAL CLEAN FIX\n     Do not touch title gradient/color\n     Background blurred, inner card sharp\n  ================================================== */\n\n  #hnFightVideoHero {\n    --hn-hero-bg-blur: 6px !important;\n    --hn-hero-frame-blur: 0px !important;\n    --hn-hero-text-blur-opacity: 0 !important;\n  }\n\n  /* OUTER BACKGROUND VIDEO: always blurred */\n  #hnFightVideoHero .hn-fight-video-hero__bg-video {\n    filter:\n      blur(var(--hn-hero-bg-blur))\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.16) !important;\n\n    -webkit-filter:\n      blur(var(--hn-hero-bg-blur))\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.16) !important;\n  }\n\n  /* INNER CARD VIDEO: never blurred */\n  #hnFightVideoHero .hn-fight-video-hero__main-video,\n  #hnFightVideoHero .hn-fight-video-hero__panel video {\n    filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.08) !important;\n\n    -webkit-filter:\n      blur(0px)\n      grayscale(0%)\n      saturate(115%)\n      contrast(1.02)\n      brightness(1.08) !important;\n  }\n\n  /* Remove the black/blurred patch behind text */\n  #hnFightVideoHero .hn-fight-video-hero__content::before {\n    content: none !important;\n    display: none !important;\n    opacity: 0 !important;\n    background: none !important;\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n\n  #hnFightVideoHero .hn-fight-video-hero__content {\n    background: transparent !important;\n    box-shadow: none !important;\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n\n  /* IMPORTANT:\n     Reset the title look.\n     No new gradient. No glow. No dark embossed shadow.\n     This keeps the original gradient clean.\n  */\n  #hnFightVideoHero .hn-fight-video-hero__title {\n    filter: none !important;\n    -webkit-filter: none !important;\n\n    text-shadow: none !important;\n\n    -webkit-background-clip: text !important;\n    background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    color: transparent !important;\n  }\n\n  /* Keep smaller text readable without changing title gradient */\n  #hnFightVideoHero .hn-fight-video-hero__kicker,\n  #hnFightVideoHero .hn-fight-video-hero__subline,\n  #hnFightVideoHero .hn-fight-video-hero__scroll {\n    text-shadow:\n      0 2px 8px rgba(0, 0, 0, 0.72),\n      0 8px 22px rgba(0, 0, 0, 0.55) !important;\n  }\n\n  /* Keep the inner card clean during split animation */\n  #hnFightVideoHero .hn-fight-video-hero__frame,\n  #hnFightVideoHero .hn-fight-video-hero__panels,\n  #hnFightVideoHero .hn-fight-video-hero__panel {\n    filter: none !important;\n    -webkit-filter: none !important;\n    backface-visibility: hidden !important;\n    -webkit-backface-visibility: hidden !important;\n    transform-style: flat !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    #hnFightVideoHero {\n      --hn-hero-bg-blur: 7px !important;\n      --hn-hero-frame-blur: 0px !important;\n    }\n  }\n</style>\n\n<script>\n  /*\n    This only controls video blur.\n    It does NOT touch title gradient, color, or title shadow.\n  */\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section) return;\n\n    var bgVideo = section.querySelector('.hn-fight-video-hero__bg-video');\n    var mainVideo = section.querySelector('.hn-fight-video-hero__main-video');\n    var panelVideos = section.querySelectorAll('.hn-fight-video-hero__panel video');\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 749px)').matches;\n    }\n\n    function keepCorrectBlur() {\n      var bgBlur = isMobile() ? '7px' : '6px';\n\n      section.style.setProperty('--hn-hero-bg-blur', bgBlur, 'important');\n      section.style.setProperty('--hn-hero-frame-blur', '0px', 'important');\n      section.style.setProperty('--hn-hero-text-blur-opacity', '0', 'important');\n\n      if (bgVideo) {\n        bgVideo.style.setProperty(\n          'filter',\n          'blur(' + bgBlur + ') grayscale(0%) saturate(115%) contrast(1.02) brightness(1.16)',\n          'important'\n        );\n\n        bgVideo.style.setProperty(\n          '-webkit-filter',\n          'blur(' + bgBlur + ') grayscale(0%) saturate(115%) contrast(1.02) brightness(1.16)',\n          'important'\n        );\n      }\n\n      if (mainVideo) {\n        mainVideo.style.setProperty(\n          'filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n\n        mainVideo.style.setProperty(\n          '-webkit-filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n      }\n\n      panelVideos.forEach(function (video) {\n        video.style.setProperty(\n          'filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n\n        video.style.setProperty(\n          '-webkit-filter',\n          'blur(0px) grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08)',\n          'important'\n        );\n      });\n    }\n\n    keepCorrectBlur();\n\n    window.addEventListener('scroll', keepCorrectBlur, { passive: true });\n    window.addEventListener('resize', keepCorrectBlur);\n\n    setInterval(keepCorrectBlur, 150);\n  })();\n</script>",
