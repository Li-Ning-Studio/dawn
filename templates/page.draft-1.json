    "custom_liquid_i3BYKa": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-member-access\" id=\"hnMemberAccess\" aria-label=\"Member access pro series rackets\">\n\n  <div class=\"hn-member-access__sticky\">\n\n    <div class=\"hn-member-access__dark-bg\"></div>\n\n    <div class=\"hn-member-access__gate\">\n      <div class=\"hn-member-access__gate-panel hn-member-access__gate-panel--left\">\n        <span>MEMBER</span>\n      </div>\n\n      <div class=\"hn-member-access__gate-panel hn-member-access__gate-panel--right\">\n        <span>ACCESS</span>\n      </div>\n\n      <div class=\"hn-member-access__gate-line\"></div>\n      <div class=\"hn-member-access__gate-light\"></div>\n\n      <div class=\"hn-member-access__lock\">\n        <div class=\"hn-member-access__lock-mark\">\n          <span></span>\n        </div>\n\n        <p>Top Tier Detected</p>\n        <h3>You’ve reached the top tier.</h3>\n\n        <button type=\"button\" class=\"hn-member-access__mobile-unlock\">\n          Touch to Unlock\n        </button>\n      </div>\n    </div>\n\n    <div class=\"hn-member-access__content\">\n\n      <header class=\"hn-member-access__header\">\n        <p class=\"hn-member-access__eyebrow\">Access Granted</p>\n\n        <h2>\n          You’ve reached<br>\n          the top tier.\n        </h2>\n\n        <p class=\"hn-member-access__copy\">\n          No warm-up rackets here. Just professional frames built for players who already know how they win.\n        </p>\n      </header>\n\n      <div class=\"hn-member-access__cards\">\n\n        <!-- VENOM - GREEN -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#19b84a; --accent-rgb:25,184,74; --card-show:var(--card-1);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Attack Access</p>\n            <span>01</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756\"\n              alt=\"Nitrix 70 Venom badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Nitrix 70 Venom</h3>\n            <h4>Violence, refined.</h4>\n            <p>\n              Head-heavy pressure with a razor-thin 6.1mm shaft. Built for players who finish rallies before they get comfortable.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>6.1MM</span>\n            <span>ATTACK</span>\n          </div>\n\n          <a href=\"/products/nitrix-70-venom\" class=\"hn-member-access__cta\">\n            Enter Venom\n            <span>→</span>\n          </a>\n        </article>\n\n        <!-- VOLTA - BLUE -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#1f7ed8; --accent-rgb:31,126,216; --card-show:var(--card-2);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Power Access</p>\n            <span>02</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756\"\n              alt=\"Nitrix 70 Volta badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Nitrix 70 Volta</h3>\n            <h4>Power with a cleaner cut.</h4>\n            <p>\n              Fast frame response, hard contact, and enough bite to turn half chances into winners.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>7.0MM</span>\n            <span>POWER</s