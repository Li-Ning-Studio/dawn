50%;\n    background: rgba(255,255,255,.36);\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    width: min(100%, 330px);\n    min-height: 50px;\n    padding: 0 18px 0 21px;\n    border: 1px solid #fff;\n    border-radius: 999px;\n    background: #fff;\n    color: #050505;\n    text-decoration: none;\n    transition:\n      transform .25s cubic-bezier(.2,.8,.2,1),\n      background .25s ease,\n      color .25s ease;\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__cta span {\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 680;\n    white-space: nowrap;\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__cta svg {\n    width: 17px;\n    height: 17px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    transition: transform .25s cubic-bezier(.2,.8,.2,1);\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__cta:hover {\n    transform: translateY(-2px);\n    background: transparent;\n    color: #fff;\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__cta:hover svg {\n    transform: translateX(4px);\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__timer {\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    z-index: 8;\n    display: block;\n    width: 100%;\n    height: 2px;\n    background: rgba(255,255,255,.1);\n    overflow: hidden;\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__timer::after {\n    content: \"\";\n    display: block;\n    width: 100%;\n    height: 100%;\n    background: #fff;\n    transform: scaleX(0);\n    transform-origin: left center;\n  }\n\n  #hcs-{{ hcs_sid }}.is-running .hcs__timer::after {\n    animation: hcsTimer-{{ hcs_sid }} var(--duration) linear forwards;\n  }\n\n  #hcs-{{ hcs_sid }}.is-paused .hcs__timer::after {\n    animation-play-state: paused;\n  }\n\n  @keyframes hcsTimer-{{ hcs_sid }} {\n    to { transform: scaleX(1); }\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__wipe {\n    position: fixed;\n    inset: 0;\n    z-index: 9999999;\n    display: grid;\n    place-items: center;\n    padding: 24px;\n    background: #fff;\n    color: #050505;\n    pointer-events: none;\n    transform: translateY(100%);\n    transition: transform .46s cubic-bezier(.76,0,.24,1);\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__wipe.is-active {\n    transform: translateY(0);\n  }\n\n  #hcs-{{ hcs_sid }} .hcs__wipe span {\n    font-size: clamp(46px, 8vw, 124px);\n    line-height: .86;\n    font-weight: 610;\n    letter-spacing: -.07em;\n    text-align: center;\n  }\n\n  @media (max-width: 820px) {\n    #hcs-{{ hcs_sid }} {\n      padding: 7px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__viewport {\n      height: clamp(350px, 62svh, 430px);\n      border-radius: 17px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__inner {\n      grid-template-columns: 1fr;\n      grid-template-rows: auto auto;\n      gap: 25px;\n      align-content: center;\n      padding: 26px 20px 22px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__title {\n      font-size: clamp(50px, 14vw, 72px);\n      line-height: .84;\n      letter-spacing: -.068em;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__content {\n      gap: 20px;\n      min-height: 0;\n      padding: 18px 0 0;\n      border-left: 0;\n      border-top: 1px solid rgba(255,255,255,.17);\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__label {\n      margin-bottom: 12px;\n      font-size: 8px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__products {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 10px 18px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__products li {\n      padding-left: 11px;\n      font-size: clamp(12.5px, 3.6vw, 14px);\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__products li::before {\n      width: 3px;\n      height: 3px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__cta {\n      width: 100%;\n      min-height: 48px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__cta:hover {\n      transform: none;\n      background: #fff;\n      color: #050505;\n    }\n  }\n\n  @media (max-width: 430px) {\n    #hcs-{{ hcs_sid }} .hcs__viewport {\n      height: 390px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__inner {\n      gap: 22px;\n      padding: 24px 18px 20px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__products {\n      gap: 9px 14px;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__products li {\n      font-size: 12.5px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hcs-{{ hcs_sid }} .hcs__scene,\n    #hcs-{{ hcs_sid }} .hcs__title b,\n    #hcs-{{ hcs_sid }} .hcs__content,\n    #hcs-{{ hcs_sid }} .hcs__wipe,\n    #hcs-{{ hcs_sid }} .hcs__cta,\n    #hcs-{{ hcs_sid }} .hcs__cta svg {\n      transition: none !important;\n    }\n\n    #hcs-{{ hcs_sid }} .hcs__timer {\n      display: none;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hcs-{{ hcs_sid }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const scenes = [...root.querySelectorAll('.hcs__scene')];\n  const links = [...root.querySelectorAll('.hcs__cta')];\n  const wipe = root.querySelector('.hcs__wipe');\n  const wipeText = wipe?.querySelector('span');\n  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  const DURATION = 4200;\n\n  let active = 0;\n  let timer = 0;\n  let visible = false;\n  let paused = false;\n  let touchStartX = 0;\n  let touchStartY = 0;\n\n  const paint = next => {\n    const previous = active;\n    active = (next + scenes.length) % scenes.length;\n\n    scenes.forEach((scene, index) => {\n      scene.classList.remove('is-active', 'is-previous', 'is-next');\n\n      if (index === active) {\n        scene.classList.add('is-active');\n        scene.setAttribute('aria-hidden', 'false');\n      } else {\n        scene.classList.add(index === previous ? 'is-previous' : 'is-next');\n        scene.setAttribute('aria-hidden', 'true');\n      }\n    });\n\n    root.classList.remove('is-running');\n    void root.offsetWidth;\n\n    if (visible && !paused && !reduceMotion.matches) {\n      root.classList.add('is-running');\n    }\n  };\n\n  const stop = () => {\n    window.clearTimeout(timer);\n    timer = 0;\n    root.classList.remove('is-running');\n  };\n\n  const schedule = () => {\n    stop();\n\n    if (!visible || paused || reduceMotion.matches) return;\n\n    root.classList.add('is-running');\n\n    timer = window.setTimeout(() => {\n      paint(active + 1);\n      schedule();\n    }, DURATION);\n  };\n\n  const setPaused = state => {\n    paused = state;\n    root.classList.toggle('is-paused', state);\n    state ? stop() : schedule();\n  };\n\n  const observer = new IntersectionObserver(entries => {\n    visible = Boolean(\n      entries[0]?.isIntersecting &&\n      entries[0].intersectionRatio > .25\n    );\n\n    visible ? schedule() : stop();\n  }, {\n    threshold: [0, .25, .6]\n  });\n\n  observer.observe(root);\n\n  root.addEventListener('mouseenter', () => setPaused(true));\n  root.addEventListener('mouseleave', () => setPaused(false));\n  root.addEventListener('focusin', () => setPaused(true));\n\n  root.addEventListener('focusout', event => {\n    if (!root.contains(event.relatedTarget)) setPaused(false);\n  });\n\n  root.addEventListener('keydown', event => {\n    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {\n      event.preventDefault();\n      paint(active + 1);\n      schedule();\n    }\n\n    if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {\n      event.preventDefault();\n      paint(active - 1);\n      schedule();\n    }\n  });\n\n  root.addEventListener('touchstart', event => {\n    const touch = event.changedTouches[0];\n    touchStartX = touch.clientX;\n    touchStartY = touch.clientY;\n  }, {\n    passive: true\n  });\n\n  root.addEventListener('touchend', event => {\n    const touch = event.changedTouches[0];\n    const dx = touch.clientX - touchStartX;\n    const dy = touch.clientY - touchStartY;\n\n    if (Math.abs(dx) < 42 || Math.abs(dx) < Math.abs(dy)) return;\n\n    paint(dx < 0 ? active + 1 : active - 1);\n    schedule();\n  }, {\n    passive: true\n  });\n\n  links.forEach(link => {\n    link.addEventListener('click', event => {\n      if (\n        event.metaKey ||\n        event.ctrlKey ||\n        event.shiftKey ||\n        event.altKey\n      ) {\n        return;\n      }\n\n      event.preventDefault();\n\n      const title =\n        link.closest('.hcs__scene')?.dataset.title ||\n        'HNDRD';\n\n      if (wipeText) wipeText.textContent = title;\n      wipe?.classList.add('is-active');\n\n      window.setTimeout(() => {\n        window.location.href = link.href;\n      }, reduceMotion.matches ? 0 : 510);\n    });\n  });\n\n  areduceMotion.addEventListener?.('change', schedule);\n  paint(0);\n})();\n</script>",
