  width: min(310px, 100%);\n      height: 400px;\n    }\n\n    .hn-evo-final-card__media img {\n      width: min(86%, 260px);\n    }\n\n    .hn-evo-final-card__content h3 {\n      font-size: 26px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-evo-final {\n      height: auto;\n    }\n\n    .hn-evo-final__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 72px 0;\n    }\n\n    .hn-evo-final__inner {\n      display: block;\n      width: min(520px, calc(100% - 28px));\n    }\n\n    .hn-evo-final__stage {\n      height: auto;\n      display: grid;\n      gap: 18px;\n      margin-top: 30px;\n    }\n\n    .hn-evo-final-card {\n      position: relative;\n      left: auto;\n      top: auto;\n      transform: none !important;\n      opacity: 1 !important;\n      visibility: visible !important;\n      pointer-events: auto !important;\n      width: 100%;\n    }\n\n    .hn-evo-final-card,\n    .hn-evo-final-card__media img,\n    .hn-evo-final-card__glow {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnEvoFinalStack');\n    if (!section || section.dataset.ready === 'true') return;\n\n    section.dataset.ready = 'true';\n\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-evo-final-card'));\n    var fill = section.querySelector('.hn-evo-final__progress-fill');\n    var current = section.querySelector('.hn-evo-final__progress-current');\n    var total = section.querySelector('.hn-evo-final__progress-total');\n    var hint = section.querySelector('.hn-evo-final__scroll-hint');\n    var ticking = false;\n\n    if (!cards.length || !fill || !current || !total) return;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function pad(value) {\n      return String(value).padStart(2, '0');\n    }\n\n    function getProgress() {\n      var rect = section.getBoundingClientRect();\n      var viewport = window.innerHeight || document.documentElement.clientHeight;\n      var scrollable = section.offsetHeight - viewport;\n\n      if (scrollable <= 0) return 0;\n\n      return clamp(-rect.top / scrollable, 0, 1);\n    }\n\n    function update() {\n      var progress = getProgress();\n      var maxIndex = cards.length - 1;\n      var activeIndex = clamp(Math.round(progress * maxIndex), 0, maxIndex);\n\n      section.style.setProperty('--hn-evo-progress', progress.toFixed(4));\n      fill.style.setProperty('transform', 'scaleX(' + progress.toFixed(4) + ')', 'important');\n\n      current.textContent = pad(activeIndex + 1);\n      total.textContent = pad(cards.length);\n\n      if (hint) {\n        hint.classList.toggle('is-hidden', progress > 0.08);\n      }\n\n      cards.forEach(function (card, index) {\n        var isActive = index === activeIndex;\n\n        card.classList.toggle('is-active', isActive);\n\n        if (isActive) {\n          card.style.setProperty('--card-y', '0px');\n          card.style.setProperty('--card-scale', '1');\n          card.style.setProperty('--card-opacity', '1');\n          card.style.setProperty('--card-z', '10');\n          card.style.setProperty('--card-events', 'auto');\n          card.style.setProperty('--card-visibility', 'visible');\n        } else if (index < activeIndex) {\n          card.style.setProperty('--card-y', '-180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        } else {\n          card.style.setProperty('--card-y', '180px');\n          card.style.setProperty('--card-scale', '0.96');\n          card.style.setProperty('--card-opacity', '0');\n          card.style.setProperty('--card-z', '1');\n          card.style.setProperty('--card-events', 'none');\n          card.style.setProperty('--card-visibility', 'hidden');\n        }\n      });\n\n      ticking = false;\n    }\n\n    function requestUpdate() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestUpdate, { passive: true });\n    window.addEventListener('resize', requestUpdate);\n    window.addEventListener('load', requestUpdate);\n\n    update();\n  })();\n</script>\n<style>\n  /* EVOLUTION SECTION — PITCH DARK + NO CTA */\n  #hnEvoFinalStack,\n  #hnEvoFinalStack .hn-evo-final__sticky,\n  #hnEvoFinalStack .hn-evo-final__bg {\n    background: #000000 !important;\n  }\n\n  /* remove Explore the series CTA */\n  #hnEvoFinalStack .hn-evo-final__button {\n    display: none !important;\n  }\n\n  /* remove light/grid background */\n  #hnEvoFinalStack .hn-evo-final__bg {\n    background: #000000 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__bg::before,\n  #hnEvoFinalStack .hn-evo-final__bg::after {\n    content: none !important;\n    display: none !important;\n    opacity: 0 !important;\n    background: none !important;\n  }\n\n  /* keep left content clean on black */\n  #hnEvoFinalStack .hn-evo-final__copy {\n    position: relative;\n    z-index: 3;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__pill {\n    background: rgba(255,255,255,0.94) !important;\n    color: #050505 !important;\n    box-shadow: 0 18px 44px rgba(0,0,0,.5);\n  }\n\n  #hnEvoFinalStack .hn-evo-final__title {\n    color: #ffffff !important;\n    text-shadow:\n      0 18px 50px rgba(0,0,0,.95),\n      0 0 18px rgba(255,255,255,.06);\n  }\n\n  #hnEvoFinalStack .hn-evo-final__text {\n    color: rgba(255,255,255,.74) !important;\n    text-shadow: 0 12px 34px rgba(0,0,0,.9);\n  }\n\n  /* darker progress area */\n  #hnEvoFinalStack .hn-evo-final__progress-current,\n  #hnEvoFinalStack .hn-evo-final__progress-total {\n    color: rgba(255,255,255,.76) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__progress-track {\n    background: rgba(255,255,255,.16) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final__progress-fill {\n    background: #ffffff !important;\n    box-shadow: 0 0 18px rgba(255,255,255,.24);\n  }\n\n  /* make cards pitch dark, not grey */\n  #hnEvoFinalStack .hn-evo-final-card {\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)),\n      #000000 !important;\n    border-color: rgba(255,255,255,.16) !important;\n    box-shadow:\n      0 32px 90px rgba(0,0,0,.75),\n      inset 0 1px 0 rgba(255,255,255,.08) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card:hover {\n    border-color: rgba(255,255,255,.26) !important;\n    box-shadow:\n      0 42px 110px rgba(0,0,0,.86),\n      0 0 38px rgba(var(--accent-rgb),.16),\n      inset 0 1px 0 rgba(255,255,255,.12) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__media {\n    background:\n      radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb),.16), transparent 34%),\n      radial-gradient(circle at 50% 44%, rgba(255,255,255,.035), transparent 50%),\n      #030304 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__glow {\n    opacity: .7 !important;\n    filter: blur(28px) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__ring {\n    border-color: rgba(255,255,255,.12) !important;\n    opacity: .7 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__scrim {\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,.94) 0%,\n        rgba(0,0,0,.78) 38%,\n        rgba(0,0,0,.32) 72%,\n        rgba(0,0,0,0) 100%\n      ) !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__chip {\n    background: rgba(255,255,255,.94) !important;\n    color: #050505 !important;\n  }\n\n  #hnEvoFinalStack .hn-evo-final-card__content h3 {\n    color: #ffffff !important;\n    text-shadow:\n      0 16px 38px rgba(0,0,0,.9),\n      0 0 14px