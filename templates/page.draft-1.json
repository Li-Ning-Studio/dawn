    "custom_liquid_q66JjR": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-felt-that\" id=\"hnFeltThatSection\" aria-label=\"Find your racket version\">\n  <div class=\"hn-felt-that__sticky\">\n    <div class=\"hn-felt-that__inner\">\n\n      <div class=\"hn-felt-that__heading-wrap\">\n        <h2 class=\"hn-felt-that__heading\">\n          See everything, tier by tier.\n        </h2>\n      </div>\n\n      <div class=\"hn-felt-that__grid\">\n\n        <article class=\"hn-felt-that__card hn-felt-that__card--one\">\n          <span class=\"hn-felt-that__number\">01</span>\n\n          <div class=\"hn-felt-that__image\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_R_2bf5ad30-1612-4d36-95dd-f91f0012bec7.jpg?v=1762454610\"\n              alt=\"Prime Trinity badminton racket banner\"\n              loading=\"lazy\"\n              width=\"100%\"\n              height=\"100%\"\n            >\n          </div>\n\n          <div class=\"hn-felt-that__content\">\n            <h3>Still figuring it out, but I'm not casual anymore.</h3>\n\n            <p>\n              Every week on court. Shots getting sharper. I need a racket that keeps up with me, not one I outgrow in a month.\n            </p>\n\n            <a href=\"https://in.hndrd.co/pages/the-prime-trinity\" class=\"hn-felt-that__button\">\n              Start with Prime Trinity\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n        <article class=\"hn-felt-that__card hn-felt-that__card--two\">\n          <span class=\"hn-felt-that__number\">02</span>\n\n          <div class=\"hn-felt-that__image\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_3_2cbc6b88-cf66-4177-a259-42414dfc035a.jpg?v=1762454610\"\n              alt=\"Evolution Series badminton racket banner\"\n              loading=\"lazy\"\n              width=\"800\"\n              height=\"1000\"\n            >\n          </div>\n\n          <div class=\"hn-felt-that__content\">\n            <h3>I play to win my matches, not just enjoy the game.</h3>\n\n            <p>\n              Club level, maybe higher soon. I don't need the flagship, I need real tech without flagship pricing.\n            </p>\n\n            <a href=\"https://in.hndrd.co/pages/pro-series\" class=\"hn-felt-that__button\">\n              Explore Evolution Series\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n        <article class=\"hn-felt-that__card hn-felt-that__card--three\">\n          <span class=\"hn-felt-that__number\">03</span>\n\n          <div class=\"hn-felt-that__image\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/02_08a1856e-7356-4981-b28f-9d54327b25ea.jpg?v=1752831283\"\n              alt=\"Pro Series badminton racket banner\"\n              loading=\"lazy\"\n              width=\"800\"\n              height=\"1000\"\n            >\n          </div>\n\n          <div class=\"hn-felt-that__content\">\n            <h3>Second place isn't a result.</h3>\n\n            <p>\n              This is what I do. Give me the best Hundred makes. No compromises.\n            </p>\n\n            <a href=\"https://in.hndrd.co/pages/pro-series-rackets\" class=\"hn-felt-that__button\">\n              See Pro Series Rackets\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-felt-that,\n  .hn-felt-that *,\n  .hn-felt-that *::before,\n  .hn-felt-that *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-felt-that {\n    position: relative;\n    width: 100vw;\n    height: 155vh;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    background: #000000;\n    overflow: visible;\n    isolation: isolate;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    color: #ffffff;\n  }\n\n  .hn-felt-that__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 760px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 52px 20px;\n    background: #000000;\n  }\n\n  .hn-felt-that__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1460px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-felt-that__heading-wrap {\n    width: 100%;\n    text-align: center;\n    margin: 0 auto 36px;\n  }\n\n  .hn-felt-that__heading {\n    margin: 0 auto;\n    max-width: 100%;\n    color: #ffffff;\n    font-size: clamp(34px, 4.6vw, 64px);\n    line-height: 0.95;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n    white-space: nowrap;\n    opacity: 0;\n    transform: translateY(28px) scale(0.98);\n    will-change: opacity, transform;\n  }\n\n  .hn-felt-that__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 24px;\n    width: 100%;\n    perspective: 1400px;\n  }\n\n  .hn-felt-that__card {\n    --card-show: 0;\n    --content-show: 0;\n\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    aspect-ratio: 3 / 4;\n    min-height: 560px;\n    overflow: hidden;\n    border-radius: 34px;\n    padding: 18px;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)),\n      #070707;\n    border: 1px solid rgba(255,255,255,0.12);\n    box-shadow:\n      0 30px 90px rgba(0,0,0,0.62),\n      inset 0 1px 0 rgba(255,255,255,0.07);\n    opacity: var(--card-show);\n    transform:\n      translateY(calc((1 - var(--card-show)) * 80px))\n      scale(calc(0.94 + (var(--card-show) * 0.06)))\n      rotateX(calc((1 - var(--card-show)) * 7deg));\n    transform-origin: center bottom;\n    will-change: opacity, transform;\n  }\n\n  .hn-felt-that__card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background:\n      linear-gradient(to bottom, rgba(255,255,255,0.045), transparent 30%, rgba(0,0,0,0.22));\n  }\n\n  .hn-felt-that__number {\n    position: absolute;\n    top: 30px;\n    right: 32px;\n    z-index: 6;\n    color: rgba(255,255,255,0.34);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    opacity: calc(var(--content-show) * 1);\n    transform: translateY(calc((1 - var(--content-show)) * 10px));\n  }\n\n  .hn-felt-that__image {\n    position: relative;\n    z-index: 3;\n    width: 100%;\n    height: 56%;\n    flex: 0 0 56%;\n    border-radius: 24px;\n    overflow: hidden;\n    background: #000000;\n    border: 1px solid rgba(255,255,255,0.1);\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 20px));\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-felt-that__image img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: contain;\n    object-position: center;\n    background: #000000;\n  }\n\n  .hn-felt-that__content {\n    position: relative;\n    z-index: 4;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 24px 10px 2px;\n    color: #ffffff;\n  }\n\n  .hn-felt-that__content h3 {\n    margin: 0;\n    max-width: 96%;\n    color: rgba(255,255,255,0.98);\n    font-size: clamp(24px, 1.9vw, 34px);\n    line-height: 0.98;\n    font-weight: 900;\n    letter-spacing: -0.055em;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 22px));\n    text-shadow: 0 14px 36px rgba(0,0,0,0.48);\n  }\n\n  .hn-felt-that__content p {\n    margin: 14px 0 0;\n    max-width: 95%;\n    color: rgba(255,255,255,0.74);\n    font-size: clamp(13px, 0.95vw, 15px);\n    line-height: 1.42;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 18px));\n  }\n\n  .hn-felt-that__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    width: fit-content;\n    margin-top: auto;\n    min-height: 42px;\n    padding: 13px 18px;\n    border-radius: 999px;\n    color: #ffffff;\n    background: rgba(255,255,255,0.1);\n    border: 1px solid rgba(255,255,255,0.24);\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 16px));\n    transition:\n      background 0.25s ease,\n      color 0.25s ease,\n      transform 0.25s ease,\n      border-color 0.25s ease;\n  }\n\n  .hn-felt-that__button span {\n    font-size: 14px;\n    line-height: 1;\n  }\n\n  .hn-felt-that__button:hover {\n    background: #ffffff;\n    color: #050504;\n    border-color: #ffffff;\n    transform: translateX(4px) !important;\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-felt-that {\n      height: auto;\n      padding: 82px 0 96px;\n      overflow: hidden;\n      background: #000000;\n    }\n\n    .hn-felt-that__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 0;\n      overflow: visible;\n      display: block;\n      background: #000000;\n    }\n\n    .hn-felt-that__inner {\n      width: 100%;\n    }\n\n    .hn-felt-that__heading-wrap {\n      margin-bottom: 36px;\n      padding: 0 18px;\n      overflow: hidden;\n    }\n\n    .hn-felt-that__heading {\n      white-space: normal;\n      font-size: clamp(28px, 7.8vw, 40px);\n      line-height: 1.04;\n      letter-spacing: -0.055em;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-felt-that__grid {\n      display: flex;\n      gap: 18px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding: 18px;\n      padding: 0 18px 18px;\n      -webkit-overflow-scrolling: touch;\n      perspective: none;\n      scrollbar-width: none;\n      align-items: stretch;\n    }\n\n    .hn-felt-that__grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-felt-that__card {\n      flex: 0 0 min(86vw, 370px);\n      aspect-ratio: auto;\n      min-height: 640px;\n      height: auto;\n      border-radius: 30px;\n      padding: 16px;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      opacity: 1;\n      transform: none;\n      --card-show: 1 !important;\n      --content-show: 1 !important;\n    }\n\n    .hn-felt-that__number {\n      top: 26px;\n      right: 28px;\n      font-size: 12px;\n    }\n\n    .hn-felt-that__image {\n      height: 235px;\n      flex: 0 0 235px;\n      border-radius: 22px;\n    }\n\n    .hn-felt-that__content {\n      flex: 1;\n      padding: 28px 10px 6px;\n      min-height: 0;\n    }\n\n    .hn-felt-that__content h3 {\n      max-width: 100%;\n      font-size: clamp(25px, 7.5vw, 35px);\n      line-height: 1.04;\n      letter-spacing: -0.052em;\n    }\n\n    .hn-felt-that__content p {\n      max-width: 96%;\n      margin-top: 20px;\n      font-size: 14px;\n      line-height: 1.58;\n      color: rgba(255,255,255,0.74);\n    }\n\n    .hn-felt-that__button {\n      margin-top: auto;\n      min-height: 46px;\n      padding: 14px 18px;\n      font-size: 11px;\n      transform: none;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-felt-that {\n      padding: 76px 0 90px;\n    }\n\n    .hn-felt-that__heading-wrap {\n      margin-bottom: 32px;\n    }\n\n    .hn-felt-that__grid {\n      padding: 0 16px 18px;\n      gap: 16px;\n      scroll-padding: 16px;\n    }\n\n    .hn-felt-that__card {\n      flex-basis: min(87vw, 340px);\n      min-height: 620px;\n      padding: 15px;\n    }\n\n    .hn-felt-that__image {\n      height: 220px;\n      flex-basis: 220px;\n    }\n\n    .hn-felt-that__content {\n      padding: 26px 8px 6px;\n    }\n\n    .hn-felt-that__content h3 {\n      font-size: clamp(24px, 7.6vw, 31px);\n      line-height: 1.05;\n    }\n\n    .hn-felt-that__content p {\n      margin-top: 18px;\n      font-size: 13.5px;\n      line-height: 1.56;\n    }\n\n    .hn-felt-that__button {\n      min-height: 44px;\n      margin-top: auto;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-felt-that__heading,\n    .hn-felt-that__card,\n    .hn-felt-that__image,\n    .hn-felt-that__content h3,\n    .hn-felt-that__content p,\n    .hn-felt-that__button {\n      transition: none !important;\n      transform: none !important;\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFeltThatSection');\n    if (!section || section.dataset.hnFeltReady === 'true') return;\n\n    section.dataset.hnFeltReady = 'true';\n\n    var heading = section.querySelector('.hn-felt-that__heading');\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-felt-that__card'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobileLayout() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setMobileFinalState() {\n      if (heading) {\n        heading.style.opacity = 1;\n        heading.style.transform = 'none';\n      }\n\n      cards.forEach(function (card) {\n        card.style.setProperty('--card-show', 1);\n        card.style.setProperty('--content-show', 1);\n      });\n    }\n\n    function setDesktopMotion() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var headingProgress = easeOutCubic(clamp(progress / 0.30, 0, 1));\n\n      if (heading) {\n        heading.style.opacity = headingProgress;\n        heading.style.transform =\n          'translateY(' + ((1 - headingProgress) * 28) + 'px) scale(' + (0.98 + headingProgress * 0.02) + ')';\n      }\n\n      cards.forEach(function (card, index) {\n        var stagger = index * 0.12;\n        var cardShow = easeOutCubic(clamp((progress - 0.22 - stagger) / 0.34, 0, 1));\n        var contentShow = easeOutCubic(clamp((progress - 0.32 - stagger) / 0.34, 0, 1));\n\n        card.style.setProperty('--card-show', cardShow.toFixed(3));\n        card.style.setProperty('--content-show', contentShow.toFixed(3));\n      });\n\n      ticking = false;\n    }\n\n    function update() {\n      if (isMobileLayout()) {\n        setMobileFinalState();\n        ticking = false;\n      } else {\n        setDesktopMotion();\n      }\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    update();\n  })();\n</script>",
