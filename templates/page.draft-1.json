ansform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-panel--right span {\n    left: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-line {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%) scaleY(calc(1 - (var(--unlock) * 0.92)));\n    transform-origin: center;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(255,255,255,0.12),\n      #19b84a,\n      #1f7ed8,\n      #6f42d8,\n      #ff3b24,\n      rgba(255,255,255,0.12),\n      transparent\n    );\n    box-shadow:\n      0 0 18px rgba(255,255,255,0.12),\n      0 0 44px rgba(31,126,216,0.16);\n  }\n\n  .hn-member-access__gate-light {\n    position: absolute;\n    z-index: 8;\n    left: -28%;\n    top: 0;\n    width: 24%;\n    height: 100%;\n    transform: translateX(calc(var(--unlock) * 530%)) skewX(-15deg);\n    opacity: calc(0.015 + (var(--unlock) * 0.3));\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);\n    filter: blur(12px);\n  }\n\n  .hn-member-access__lock {\n    position: absolute;\n    z-index: 12;\n    left: 50%;\n    top: 50%;\n    width: min(480px, calc(100% - 44px));\n    transform: translate(-50%, -50%) scale(calc(1 - (var(--unlock) * 0.14)));\n    opacity: calc(1 - (var(--unlock) * 1.15));\n    text-align: center;\n    pointer-events: auto;\n  }\n\n  .hn-member-access__lock-mark {\n    position: relative;\n    width: 112px;\n    height: 112px;\n    margin: 0 auto 24px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.12);\n    background:\n      radial-gradient(circle, rgba(255,255,255,0.055), transparent 44%),\n      #000000;\n    box-shadow:\n      0 0 36px rgba(255,255,255,0.04),\n      inset 0 0 0 1px rgba(255,255,255,0.035);\n  }\n\n  .hn-member-access__lock-mark::before,\n  .hn-member-access__lock-mark::after {\n    content: \"\";\n    position: absolute;\n    border-radius: 999px;\n    pointer-events: none;\n  }\n\n  .hn-member-access__lock-mark::before {\n    inset: 12px;\n    border: 1px solid transparent;\n    border-top-color: #19b84a;\n    border-right-color: #1f7ed8;\n    animation: hnMemberSpin 4.2s linear infinite;\n  }\n\n  .hn-member-access__lock-mark::after {\n    inset: 30px;\n    border: 1px solid transparent;\n    border-left-color: #6f42d8;\n    border-bottom-color: #ff3b24;\n    animation: hnMemberSpinReverse 2.8s linear infinite;\n  }\n\n  .hn-member-access__lock-mark span {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 13px;\n    height: 13px;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: #fff;\n    box-shadow:\n      0 0 16px rgba(255,255,255,0.35),\n      0 0 32px rgba(31,126,216,0.18);\n    animation: hnMemberPulseDot 1.6s ease-in-out infinite;\n  }\n\n  .hn-member-access__lock p {\n    margin: 0 0 14px;\n    color: rgba(255,255,255,0.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-member-access__lock h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(36px, 5vw, 72px);\n    line-height: 0.9;\n    font-weight: 950;\n    letter-spacing: -0.075em;\n    text-shadow: 0 18px 50px rgba(0,0,0,0.92);\n  }\n\n  .hn-member-access__mobile-unlock {\n    display: none;\n  }\n\n  .hn-member-access__content {\n    position: relative;\n    z-index: 10;\n    width: min(1480px, 100%);\n    height: 100%;\n    margin: 0 auto;\n    padding: clamp(58px, 7vh, 86px) clamp(18px, 2.6vw, 38px) clamp(38px, 5vh, 60px);\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: clamp(34px, 4.4vh, 56px);\n    opacity: var(--reveal);\n    transform: translateY(calc((1 - var(--reveal)) * 46px));\n    will-change: opacity, transform;\n  }\n\n  .hn-member-access__header {\n    text-align: center;\n  }\n\n  .hn-member-access__eyebrow {\n    margin: 0 0 16px;\n    color: rgba(255,255,255,0.7);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-member-access__header h2 {\n    margin: 0;\n    font-size: clamp(48px, 7vw, 104px);\n    line-height: 0.86;\n    font-weight: 950;\n    letter-spacing: -0.08em;\n    background-image: linear-gradient(\n      90deg,\n      #ffffff 0%,\n      #19b84a 28%,\n      #1f7ed8 52%,\n      #6f42d8 76%,\n      #ff3b24 100%\n    );\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    text-shadow: 0 20px 54px rgba(0,0,0,0.84);\n  }\n\n  .hn-member-access__copy {\n    width: min(680px, 100%);\n    margin: 22px auto 0;\n    color: rgba(255,255,255,0.86);\n    font-size: clamp(15px, 1.12vw, 18px);\n    line-height: 1.55;\n    font-weight: 650;\n    letter-spacing: -0.018em;\n    text-shadow: 0 10px 34px rgba(0,0,0,0.82);\n  }\n\n  .hn-member-access__cards {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: clamp(16px, 1.5vw, 22px);\n    width: 100%;\n    align-items: stretch;\n  }\n\n  .hn-member-access__card {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    overflow: hidden;\n    border-radius: 32px;\n    padding: 20px;\n    isolation: isolate;\n    border: 1px solid rgba(255,255,255,0.13);\n    background:\n      radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb),0.18), transparent 30%),\n      linear-gradient(180deg, rgba(255,255,255,0.065), rgba(255,255,255,0.018)),\n      #030303;\n    box-shadow:\n      0 28px 90px rgba(0,0,0,0.56),\n      inset 0 0 0 1px rgba(255,255,255,0.04);\n    opacity: var(--card-show);\n    transform: translateY(calc((1 - var(--card-show)) * 48px)) scale(calc(0.94 + (var(--card-show) * 0.06)));\n    will-change: opacity, transform;\n  }\n\n  .hn-member-access__card::before {\n    content: \"\";\n    position: absolute;\n    in