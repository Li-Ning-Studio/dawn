      "settings": {
        "custom_liquid": "<section class=\"hn-felt-heading\" id=\"hnFeltHeadingOnly\" aria-label=\"Felt that heading\">\n  <div class=\"hn-felt-heading__inner\">\n    <h2 class=\"hn-felt-heading__title\">\n      Felt that? Now find your version of it.\n    </h2>\n  </div>\n</section>\n\n<style>\n  .hn-felt-heading,\n  .hn-felt-heading *,\n  .hn-felt-heading *::before,\n  .hn-felt-heading *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-felt-heading {\n    position: relative;\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n\n    min-height: 0 !important;\n    height: auto !important;\n    padding: 2px 19px !important;\n\n    background: #000000 !important;\n    overflow: hidden;\n    isolation: isolate;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    color: #ffffff;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-felt-heading__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1460px, 100%);\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .hn-felt-heading__title {\n    --heading-show: 0;\n\n    margin: 0 auto !important;\n    padding: 0 !important;\n    max-width: 100%;\n    white-space: nowrap;\n\n    font-size: clamp(38px, 5.2vw, 72px);\n    line-height: 0.95;\n    font-weight: 950;\n    letter-spacing: -0.065em;\n\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    );\n    background-size: 120% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n\n    opacity: var(--heading-show);\n    transform:\n      translateY(calc((1 - var(--heading-show)) * 18px))\n      scale(calc(0.985 + (var(--heading-show) * 0.015)));\n\n    text-shadow: 0 18px 42px rgba(0,0,0,0.42);\n    isolation: isolate;\n    -webkit-backface-visibility: hidden;\n    backface-visibility: hidden;\n    will-change: opacity, transform;\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-felt-heading {\n      min-height: 0 !important;\n      height: auto !important;\n      padding: 2px 14px !important;\n      background: #000000 !important;\n    }\n\n    .hn-felt-heading__title {\n      white-space: normal;\n      font-size: clamp(30px, 9.2vw, 44px);\n      line-height: 1;\n      letter-spacing: -0.058em;\n      --heading-show: 1;\n      transform: none;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-felt-heading {\n      padding: 2px 12px !important;\n    }\n\n    .hn-felt-heading__title {\n      font-size: clamp(28px, 9vw, 38px);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-felt-heading__title {\n      transition: none !important;\n      transform: none !important;\n      opacity: 1 !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFeltHeadingOnly');\n    if (!section || section.dataset.hnFeltHeadingReady === 'true') return;\n\n    section.dataset.hnFeltHeadingReady = 'true';\n\n    var heading = section.querySelector('.hn-felt-heading__title');\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobileLayout() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function update() {\n      if (!heading) return;\n\n      if (isMobileLayout()) {\n        heading.style.setProperty('--heading-show', '1');\n        ticking = false;\n        return;\n      }\n\n      var rect = section.getBoundingClientRect();\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n\n      var progress = easeOutCubic(\n        clamp((vh * 0.92 - rect.top) / (vh * 0.38), 0, 1)\n      );\n\n      heading.style.setProperty('--heading-show', progress.toFixed(3));\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    update();\n  })();\n</script>\n<style>\n  #hnFeltHeadingOnly .hn-felt-heading__title {\n    font-size: clamp(28px, 3.8vw, 52px) !important;\n    line-height: 1 !important;\n    letter-spacing: -0.052em !important;\n  }\n\n  @media screen and (max-width: 989px) {\n    #hnFeltHeadingOnly .hn-felt-heading__title {\n      font-size: clamp(24px, 7.4vw, 34px) !important;\n      line-height: 1.05 !important;\n      letter-spacing: -0.048em !important;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    #hnFeltHeadingOnly .hn-felt-heading__title {\n      font-size: clamp(23px, 7vw, 30px) !important;\n    }\n  }\n</style>\n<style>\n  /* Mobile heading size increase */\n  @media screen and (max-width: 989px) {\n    #hnFeltHeadingOnly .hn-felt-heading__title {\n      font-size: clamp(28px, 8.4vw, 40px) !important;\n      line-height: 1.04 !important;\n      letter-spacing: -0.052em !important;\n      max-width: 92vw !important;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    #hnFeltHeadingOnly .hn-felt-heading__title {\n      font-size: clamp(27px, 8.2vw, 36px) !important;\n      line-height: 1.05 !important;\n      max-width: 94vw !important;\n    }\n  }\n\n  @media screen and (max-width: 360px) {\n    #hnFeltHeadingOnly .hn-felt-heading__title {\n      font-size: 27px !important;\n      line-height: 1.06 !important;\n    }\n  }\n</style>",
