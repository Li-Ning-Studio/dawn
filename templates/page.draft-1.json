-access__media img {\n      height: 98%;\n      max-width: 84%;\n    }\n\n    .hn-member-access__card-body {\n      min-height: 160px;\n    }\n\n    .hn-member-access__card-body h3 {\n      font-size: 28px;\n      line-height: 0.96;\n    }\n\n    .hn-member-access__card-body h4 {\n      margin-top: 10px;\n      font-size: 14px;\n      line-height: 1.16;\n    }\n\n    .hn-member-access__card-body p {\n      margin-top: 12px;\n      font-size: 12.5px;\n      line-height: 1.52;\n      color: rgba(255,255,255,0.84);\n    }\n\n    .hn-member-access__specs {\n      margin-top: 12px;\n    }\n\n    .hn-member-access__cta {\n      margin-top: 16px;\n      min-height: 42px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-member-access__content {\n      padding-top: 48px;\n      gap: 24px;\n    }\n\n    .hn-member-access__lock {\n      top: 46.5%;\n      width: min(290px, calc(100% - 22px));\n    }\n\n    .hn-member-access__lock h3 {\n      font-size: 36px;\n      max-width: 250px;\n    }\n\n    .hn-member-access__mobile-unlock {\n      min-height: 44px;\n      padding: 0 22px;\n      font-size: 10.5px;\n    }\n\n    .hn-member-access__card {\n      flex-basis: min(85vw, 320px);\n      padding: 15px;\n    }\n\n    .hn-member-access__card-body {\n      min-height: 150px;\n    }\n\n    .hn-member-access__card-body h3 {\n      font-size: 26px;\n    }\n\n    .hn-member-access__card-body p {\n      font-size: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-member-access *,\n    .hn-member-access *::before,\n    .hn-member-access *::after {\n      animation: none !important;\n      transition: none !important;\n    }\n  }\n/* HEADLINE COLOR GRADING UPDATE */\n#hnMemberAccess .hn-member-access__header h2 {\n  background-image: linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) !important;\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n  color: transparent !important;\n}\n\n/* Door unlock headline also matching */\n#hnMemberAccess .hn-member-access__lock h3 {\n  background-image: linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) !important;\n  -webkit-background-clip: text !important;\n  background-clip: text !important;\n  -webkit-text-fill-color: transparent !important;\n  color: transparent !important;\n}\n/* DOOR CTA COLOR GRADING ONLY */\n#hnMemberAccess .hn-member-access__mobile-unlock {\n  background:\n    linear-gradient(#000000, #000000) padding-box,\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) border-box !important;\n  border: 1.5px solid transparent !important;\n  color: #ffffff !important;\n  box-shadow:\n    0 0 22px rgba(0, 201, 255, 0.22),\n    0 0 18px rgba(146, 254, 157, 0.14) !important;\n}\n\n#hnMemberAccess .hn-member-access__mobile-unlock:hover {\n  background:\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) padding-box,\n    linear-gradient(to right, #92fe9d 0%, #00c9ff 100%) border-box !important;\n  color: #000000 !important;\n  box-shadow:\n    0 0 30px rgba(0, 201, 255, 0.34),\n    0 0 24px rgba(146, 254, 157, 0.22) !important;\n}\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnMemberAccess');\n    if (!section || section.dataset.hnMemberReady === 'true') return;\n\n    section.dataset.hnMemberReady = 'true';\n\n    var unlockButton = section.querySelector('.hn-member-access__mobile-unlock');\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setVars(unlock, reveal, c1, c2, c3, c4) {\n      section.style.setProperty('--unlock', unlock.toFixed(3));\n      section.style.setProperty('--reveal', reveal.toFixed(3));\n      section.style.setProperty('--card-1', c1.toFixed(3));\n      section.style.setProperty('--card-2', c2.toFixed(3));\n      section.style.setProperty('--card-3', c3.toFixed(3));\n      section.style.setProperty('--card-4', c4.toFixed(3));\n    }\n\n    function updateDesktop() {\n      if (isMobile()) {\n        ticking = false;\n        return;\n      }\n\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n      var rect = section.getBoundingClientRect();\n      var total = Math.max(section.offsetHeight - vh, 1);\n      var progress = clamp(-rect.top / total, 0, 1);\n\n      var unlock = easeInOutSine(clamp((progress - 0.08) / 0.30, 0, 1));\n      var reveal = easeOutCubic(clamp((progress - 0.30) / 0.18, 0, 1));\n\n      var card1 = easeOutCubic(clamp((progress - 0.43) / 0.12, 0, 1));\n      var card2 = easeOutCubic(clamp((progress - 0.49) / 0.12, 0, 1));\n      var card3 = easeOutCubic(clamp((progress - 0.55) / 0.12, 0, 1));\n      var card4 = easeOutCubic(clamp((progress - 0.61) / 0.12, 0, 1));\n\n      setVars(unlock, reveal, card1, card2, card3, card4);\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateDesktop);\n        ticking = true;\n      }\n    }\n\n    if (unlockButton) {\n      unlockButton.addEventListener('click', function () {\n        section.classList.add('is-unlocked');\n        setVars(1, 1, 1, 1, 1, 1);\n      });\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      if (isMobile()) {\n        if (!section.classList.contains('is-unlocked')) {\n          setVars(0, 0, 0, 0, 0, 0);\n        }\n      } else {\n        section.classList.remove('is-unlocked');\n        requestTick();\n      }\n    });\n\n    if (isMobile()) {\n      setVars(0, 0, 0, 0, 0, 0);\n    } else {\n      updateDesktop();\n    }\n  })();\n</script>\n<style>\n  /* PEAK PERFORMANCE TRIO GRADIENT HEADING UPDATE */\n  #hnMemberAccess .hn-member-access__header h2,\n  #hnMemberAccess .hn-member-access__lock h3 {\n    background-image: linear-gradient(\n      90deg,\n      #b54cff 0%,\n      #d735c9 42%,\n      #ff006e 100%\n    ) !important;\n    -webkit-background-clip: text !important;\n    background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    color: transparent !important;\n    text-shadow:\n      0 18px 54px rgba(0,0,0,0.88),\n      0 0 26px rgba(255,0,110,0.14) !important;\n  }\n\n  @media screen and (max-width: 989px) {\n    #hnMemberAccess .hn-member-access__header h2,\n    #hnMemberAccess .hn-member-access__lock h3 {\n      background-image: linear-gradient(\n        90deg,\n        #b54cff 0%,\n        #d735c9 42%,\n        #ff006e 100%\n      ) !important;\n      -webkit-background-clip: text !important;\n      background-clip: text !important;\n      -webkit-text-fill-color: transparent !important;\n      color: transparent !important;\n    }\n  }\n</style>\n<style>\n  /* ==================================================\n     HN MEMBER ACCESS CTA VISIBILITY FIX\n     Keeps card CTAs visible after unlock/click\n  ================================================== */\n\n  #hnMemberAccess .hn-member-access__content {\n    overflow: visible !important;\n  }\n\n  #hnMemberAccess .hn-member-access__cta {\n    display: inline-flex !important;\n    opacity: 1 !important;\n    visibility: visible !important;\n    pointer-events: auto !important;\n    position: relative !important;\n    z-index: 20 !important;\n    flex-shrink: 0 !important;\n  }\n\n  /* DESKTOP: make the cards fit inside sticky viewport */\n  @media screen and (min-width: 990px) {\n    #hnMemberAccess .hn-member-access__sticky {\n      height: 100svh !important;\n      min-height: 720px !important;\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess .hn-member-access__content {\n      padding:\n        clamp(34px, 4vh, 52px)\n        clamp(18px, 2.4vw, 34px)\n        clamp(24px, 3vh, 36px) !important;\n      gap: clamp(20px, 2.8vh, 34px) !important;\n      justify-content: center !important;\n    }\n\n    #hnMemberAccess .hn-member-access__header h2 {\n      font-size: clamp(42px, 5.2vw, 78px) !important;\n      line-height: 0.88 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__copy {\n      margin-top: 14px !important;\n      font-size: clamp(13px, 1vw, 16px) !important;\n      line-height: 1.45 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__cards {\n      align-items: stretch !important;\n      gap: clamp(14px, 1.2vw, 20px) !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card {\n      height: min(58vh, 560px) !important;\n      min-height: 500px !important;\n      padding: 14px !important;\n      border-radius: 26px !important;\n      display: flex !important;\n      flex-direction: column !important;\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-top {\n      margin-bottom: 10px !important;\n      flex-shrink: 0 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__media {\n      height: clamp(150px, 22vh, 245px) !important;\n      aspect-ratio: auto !important;\n      flex: 0 0 auto !important;\n      margin-bottom: 14px !important;\n      border-radius: 20px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__media img {\n      height: 100% !important;\n      max-width: 88% !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body {\n      min-height: 0 !important;\n      flex: 1 1 auto !important;\n      overflow: hidden !important;\n      padding: 0 2px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body h3 {\n      font-size: clamp(21px, 1.55vw, 28px) !important;\n      line-height: 0.98 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body h4 {\n      margin-top: 8px !important;\n      font-size: clamp(12px, 0.9vw, 15px) !important;\n      line-height: 1.12 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body p {\n      margin-top: 9px !important;\n      font-size: clamp(11px, 0.78vw, 13px) !important;\n      line-height: 1.4 !important;\n\n      display: -webkit-box !important;\n      -webkit-line-clamp: 3 !important;\n      -webkit-box-orient: vertical !important;\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess .hn-member-access__specs {\n      margin-top: 10px !important;\n      flex-shrink: 0 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__specs span {\n      min-height: 23px !important;\n      padding: 0 9px !important;\n      font-size: 8.5px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__cta {\n      margin-top: 12px !important;\n      min-height: 38px !important;\n      font-size: 10px !important;\n    }\n  }\n\n  /* Medium desktop / tablet landscape */\n  @media screen and (max-width: 1180px) and (min-width: 990px) {\n    #hnMemberAccess .hn-member-access__sticky {\n      min-height: 780px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card {\n      height: min(64vh, 600px) !important;\n      min-height: 540px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__media {\n      height: clamp(170px, 24vh, 270px) !important;\n    }\n  }\n\n  /* MOBILE: keep CTA inside horizontal cards */\n  @media screen and (max-width: 989px) {\n    #hnMemberAccess.hn-member-access {\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess .hn-member-access__sticky {\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess.is-unlocked .hn-member-access__gate {\n      display: none !important;\n      opacity: 0 !important;\n      visibility: hidden !important;\n      pointer-events: none !important;\n    }\n\n    #hnMemberAccess .hn-member-access__content {\n      padding-bottom: 76px !important;\n      overflow: visible !important;\n    }\n\n    #hnMemberAccess .hn-member-access__cards {\n      padding-bottom: 22px !important;\n      align-items: stretch !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card {\n      min-height: 610px !important;\n      height: auto !important;\n      display: flex !important;\n      flex-direction: column !important;\n      overflow: hidden !important;\n    }\n\n    #hnMemberAccess .hn-member-access__media {\n      height: min(54vw, 260px) !important;\n      aspect-ratio: auto !important;\n      flex: 0 0 auto !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body {\n      min-height: 0 !important;\n      flex: 1 1 auto !important;\n    }\n\n    #hnMemberAccess .hn-member-access__cta {\n      margin-top: 16px !important;\n      min-height: 42px !important;\n      flex-shrink: 0 !important;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    #hnMemberAccess .hn-member-access__card {\n      min-height: 590px !important;\n    }\n\n    #hnMemberAccess .hn-member-access__media {\n      height: min(56vw, 238px) !important;\n    }\n\n    #hnMemberAccess .hn-member-access__card-body p {\n      font-size: 12px !important;\n      line-height: 1.45 !important;\n    }\n\n    #hnMemberAccess .hn-member-access__cta {\n      min-height: 40px !important;\n      margin-top: 14px !important;\n    }\n  }\n</style>",
