      "settings": {
        "custom_liquid": "<section class=\"hq\" id=\"hq\">\n<div class=\"hqbg\"><i></i><b></b></div>\n<div class=\"hqwrap\">\n<div class=\"hqs hqintro on\" data-s=\"intro\"><div class=\"hqlock\"><span></span><span></span><em></em></div><p class=\"hqey\">Hundred Badminton</p><h2>3 quick questions.<br>1 smart match.</h2><p>Answer how you play. We’ll show the rackets that is right for you.</p><div class=\"hqintroBtns\"><button id=\"hqStart\" type=\"button\">Let's go <span>→</span></button><button id=\"hqSaved\" type=\"button\" hidden>View saved match</button></div></div>\n<div class=\"hqs hqquiz\" data-s=\"quiz\" aria-hidden=\"true\"><button class=\"hqback\" id=\"hqBack\" type=\"button\">←</button><div class=\"hqprog\" id=\"hqProg\"></div><p class=\"hqlabel\" id=\"hqLabel\"></p><h3 id=\"hqQuestion\"></h3><div class=\"hqopts\" id=\"hqOpts\"></div></div>\n<div class=\"hqs hqres\" data-s=\"result\" aria-hidden=\"true\"><div class=\"hqflash\" id=\"hqFlash\"></div><div class=\"hqResultGrid\"><div class=\"hqProduct\" id=\"hqProduct\"><span></span><img id=\"hqImg\" src=\"\" alt=\"\"></div><div class=\"hqCopy\"><p class=\"hqTag\" id=\"hqTag\"></p><h3 id=\"hqName\"></h3><p class=\"hqReason\" id=\"hqReason\"></p><div class=\"hqStats\" id=\"hqStats\"></div><div class=\"hqBuy\"><p id=\"hqPrice\"></p><a id=\"hqShop\" href=\"#\" target=\"_blank\" rel=\"noopener\">Shop now <span>→</span></a></div><div class=\"hqAlt\" id=\"hqAlt\"></div><button class=\"hqCompare\" id=\"hqCompare\" type=\"button\" hidden><span id=\"hqCompareText\">Compare matches</span><b>+</b></button><button class=\"hqAgain\" id=\"hqAgain\" type=\"button\">Take it again</button></div></div></div>\n</div>\n<div class=\"hqModal\" id=\"hqModal\" hidden><button class=\"hqScrim\" id=\"hqScrim\" type=\"button\"></button><div class=\"hqPanel\"><button class=\"hqClose\" id=\"hqClose\" type=\"button\">✕</button><div class=\"hqModalHead\"><p>Compare Matches</p><h3>Pick the one that fits your game.</h3></div><div class=\"hqCards\" id=\"hqCards\"></div><div class=\"hqMobileSpecCards\" id=\"hqMobSpecs\"></div><div class=\"hqTableWrap\"><table class=\"hqTable\" id=\"hqTable\"></table></div><div class=\"hqSeriesDock\" id=\"hqSeriesDock\"></div></div></div>\n<style>\n.hq,.hq *{box-sizing:border-box}.hq{--a:#fff;--ar:255,255,255;--atk:#f0442e;--atkr:240,68,46;--spd:#f6a738;--spdr:246,167,56;--ctl:#4f68ff;--ctlr:79,104,255;--ven:#19b84a;--venr:25,184,74;--vol:#1f7ed8;--volr:31,126,216;--red:#ff3b24;--redr:255,59,36;--pur:#6f42d8;--purr:111,66,216;position:relative;width:100vw;min-height:100vh;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);padding:72px 18px;background:#000;color:#fff;overflow:hidden;isolation:isolate;font-family:Figtree,Avenir,Arial,sans-serif;display:flex;align-items:center;justify-content:center}.hqbg{position:absolute;inset:0;background:#000;overflow:hidden}.hqbg i{position:absolute;inset:-20%;background:radial-gradient(650px circle at var(--mx,50%) var(--my,40%),rgba(var(--ar),.13),transparent 60%)}.hqbg b{position:absolute;right:12%;top:-20%;width:220px;height:140%;background:linear-gradient(180deg,transparent,rgba(255,255,255,.04),transparent);transform:rotate(28deg);filter:blur(2px);animation:hqBlade 5s ease-in-out infinite}.hqwrap{position:relative;z-index:2;width:min(1040px,100%)}.hqs{display:none}.hqs.on{display:block;animation:hqIn .55s cubic-bezier(.16,1,.3,1) both}.hqintro{text-align:center;min-height:min(680px,calc(100vh - 144px));align-items:center;justify-content:center;flex-direction:column}.hqintro.on{display:flex}.hqlock{position:relative;width:124px;height:124px;margin:0 auto 32px}.hqlock span{position:absolute;inset:0;border-radius:999px;border:1px solid rgba(255,255,255,.18)}.hqlock span:first-child{border-top-color:#fff;border-right-color:rgba(255,255,255,.75);animation:hqSpin 6s linear infinite}.hqlock span:nth-child(2){inset:24px;border-left-color:rgba(255,255,255,.7);border-bottom-color:#fff;animation:hqSpinR 4s linear infinite}.hqlock:before,.hqlock:after{content:\"\";position:absolute;left:50%;top:50%;width:160px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent)}.hqlock:before{transform:translate(-50%,-50%) rotate(25deg)}.hqlock:after{transform:translate(-50%,-50%) rotate(-42deg);opacity:.55}.hqlock em{position:absolute;left:50%;top:50%;width:13px;height:13px;transform:translate(-50%,-50%);border-radius:999px;background:#fff;box-shadow:0 0 22px rgba(255,255,255,.7),0 0 50px rgba(255,255,255,.25);animation:hqPulse 1.7s infinite}.hqey{margin:0 0 16px;color:rgba(255,255,255,.58);font-size:12px;font-weight:850;letter-spacing:.2em;text-transform:uppercase}.hqintro h2{margin:0;max-width:900px;font-size:clamp(36px,5.4vw,68px);line-height:1.03;font-weight:950;letter-spacing:-.055em}.hqintro p:not(.hqey){margin:20px auto 0;max-width:45ch;color:rgba(255,255,255,.66);font-size:16px;line-height:1.55;font-weight:650}.hqintroBtns{margin-top:38px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.hqintroBtns button{min-height:52px;padding:0 28px;border-radius:999px;font-size:14px;font-weight:900;cursor:pointer;transition:.22s}.hqintroBtns button:first-child{border:0;background:#fff;color:#060606;box-shadow:0 18px 44px rgba(255,255,255,.12)}.hqintroBtns button:first-child:hover{transform:translateY(-2px)}.hqintroBtns button:last-child{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.045);color:rgba(255,255,255,.78)}.hqquiz{position:relative;width:min(860px,100%);margin:auto}.hqback{position:absolute;left:-6px;top:-4px;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.04);color:#fff;cursor:pointer}.hqback[disabled]{opacity:0;pointer-events:none}.hqprog{display:flex;justify-content:center;gap:8px;margin-bottom:44px}.hqprog span{width:34px;height:4px;border-radius:999px;background:rgba(255,255,255,.16);overflow:hidden;position:relative}.hqprog span:after{content:\"\";position:absolute;inset:0;