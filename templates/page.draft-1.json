      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD STRINGED CURSOR MESH\n  Paste this full block into a Shopify Custom Liquid section.\n\n  Concept:\n  - No cards, panels, images, or borders\n  - Cursor becomes a thin shuttle/string trail\n  - SVG string mesh reacts to pointer position\n  - Series names become clearer as tension moves near them\n  - Touch devices use tap / drag tension pulses\n{% endcomment %}\n\n{% assign hsm_id = section.id | default: 'hndrd-string-mesh' %}\n\n<section id=\"hsm-{{ hsm_id }}\" class=\"hsm\" aria-label=\"Explore HNDRD racket series\">\n  <svg class=\"hsm__mesh\" viewBox=\"0 0 1600 900\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    <defs>\n      <filter id=\"hsm-glow-{{ hsm_id }}\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n        <feGaussianBlur stdDeviation=\"2.2\" result=\"blur\"/>\n        <feMerge>\n          <feMergeNode in=\"blur\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n    </defs>\n\n    <g class=\"hsm__grid-lines\">\n      {% for i in (0..14) %}\n        <line class=\"hsm__vline\" x1=\"{{ i | times: 114.2857 }}\" y1=\"0\" x2=\"{{ i | times: 114.2857 }}\" y2=\"900\"/>\n      {% endfor %}\n\n      {% for i in (0..9) %}\n        <line class=\"hsm__hline\" x1=\"0\" y1=\"{{ i | times: 100 }}\" x2=\"1600\" y2=\"{{ i | times: 100 }}\"/>\n      {% endfor %}\n    </g>\n\n    <path class=\"hsm__trail-path\" d=\"\" filter=\"url(#hsm-glow-{{ hsm_id }})\"/>\n    <circle class=\"hsm__cursor-core\" cx=\"800\" cy=\"450\" r=\"2.8\"/>\n    <circle class=\"hsm__cursor-ring\" cx=\"800\" cy=\"450\" r=\"18\"/>\n  </svg>\n\n  <div class=\"hsm__topline\">\n    <span>HNDRD RACKET SERIES</span>\n    <span class=\"hsm__instruction\">MOVE TO TENSION THE STRINGS</span>\n  </div>\n\n  <div class=\"hsm__names\">\n    <a\n      class=\"hsm__name is-near\"\n      href=\"https://in.hndrd.co/pages/pro-series-rackets\"\n      data-x=\".25\"\n      data-y=\".32\"\n      data-label=\"PRO SERIES\"\n      aria-label=\"Explore Pro Series\"\n    >\n      <span class=\"hsm__index\">01</span>\n      <span class=\"hsm__title\">PRO SERIES</span>\n      <span class=\"hsm__lineup\">Nitrix 70 Venom · Nitrix 70 Volta · Hyfonic 7 · Flareon 700</span>\n    </a>\n\n    <a\n      class=\"hsm__name\"\n      href=\"https://in.hndrd.co/pages/the-prime-trinity\"\n      data-x=\".72\"\n      data-y=\".50\"\n      data-label=\"PRIME TRINITY\"\n      aria-label=\"Explore Prime Trinity\"\n    >\n      <span class=\"hsm__index\">02</span>\n      <span class=\"hsm__title\">PRIME TRINITY</span>\n      <span class=\"hsm__lineup\">Nitrix 10 · Flareon 100 · Hyfonic 1</span>\n    </a>\n\n    <a\n      class=\"hsm__name\"\n      href=\"https://in.hndrd.co/pages/pro-series\"\n      data-x=\".42\"\n      data-y=\".73\"\n      data-label=\"EVOLUTION SERIES\"\n      aria-label=\"Explore Evolution Series\"\n    >\n      <span class=\"hsm__index\">03</span>\n      <span class=\"hsm__title\">EVOLUTION SERIES</span>\n      <span class=\"hsm__lineup\">Nitrix Thunder · Flareon Typhoon · Hyfonic Lazer</span>\n    </a>\n  </div>\n\n  <div class=\"hsm__footer\">\n    <span>STRING FIELD 01</span>\n    <span>CLICK A SERIES TO ENTER</span>\n  </div>\n</section>\n\n<style>\n  #hsm-{{ hsm_id }} {\n    --bg:#050505;\n    --text:#f3f0e8;\n    --muted:rgba(243,240,232,.34);\n    --soft:rgba(243,240,232,.62);\n    --mesh:rgba(255,255,255,.10);\n    --mesh-hot:rgba(255,255,255,.72);\n    --ease:cubic-bezier(.2,.75,.2,1);\n    position:relative;\n    min-height:min(900px,95vh);\n    overflow:hidden;\n    background:\n      radial-gradient(circle at 50% 50%, rgba(255,255,255,.025), transparent 34%),\n      #050505;\n    color:var(--text);\n    font-family:Figtree,Arial,sans-serif;\n    cursor:none;\n  }\n\n  #hsm-{{ hsm_id }} *,\n  #hsm-{{ hsm_id }} *::before,\n  #hsm-{{ hsm_id }} *::after {\n    box-sizing:border-box;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__mesh {\n    position:absolute;\n    inset:0;\n    width:100%;\n    height:100%;\n    z-index:0;\n    pointer-events:none;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__grid-lines line {\n    stroke:var(--mesh);\n    stroke-width:.7;\n    vector-effect:non-scaling-stroke;\n    transition:\n      stroke .2s ease,\n      stroke-width .2s ease,\n      opacity .2s ease;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__trail-path {\n    fill:none;\n    stroke:rgba(255,255,255,.9);\n    stroke-width:1.25;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n    vector-effect:non-scaling-stroke;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__cursor-core {\n    fill:#fff;\n    opacity:.95;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__cursor-ring {\n    fill:none;\n    stroke:rgba(255,255,255,.4);\n    stroke-width:1;\n    vector-effect:non-scaling-stroke;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__topline,\n  #hsm-{{ hsm_id }} .hsm__footer {\n    position:absolute;\n    left:clamp(20px,4vw,64px);\n    right:clamp(20px,4vw,64px);\n    z-index:3;\n    display:flex;\n    justify-content:space-between;\n    gap:20px;\n    font-size:9px;\n    font-weight:700;\n    letter-spacing:.18em;\n    text-transform:uppercase;\n    color:var(--muted);\n    pointer-events:none;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__topline {\n    top:24px;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__footer {\n    bottom:24px;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__names {\n    position:relative;\n    z-index:2;\n    min-height:inherit;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name {\n    position:absolute;\n    display:block;\n    width:max-content;\n    max-width:min(82vw,1050px);\n    color:rgba(243,240,232,.09);\n    text-decoration:none;\n    transform:translate(-50%,-50%);\n    transition:\n      color .3s ease,\n      filter .3s ease,\n      opacity .3s ease,\n      transform .35s var(--ease);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name:nth-child(1) {\n    left:25%;\n    top:32%;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name:nth-child(2) {\n    left:72%;\n    top:50%;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name:nth-child(3) {\n    left:42%;\n    top:73%;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__index {\n    display:block;\n    margin-bottom:8px;\n    font-size:9px;\n    font-weight:700;\n    letter-spacing:.14em;\n    color:var(--muted);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__title {\n    display:block;\n    font-family:\"Times New Roman\",Times,Georgia,serif;\n    font-size:clamp(58px,9vw,152px);\n    line-height:.8;\n    letter-spacing:-.075em;\n    white-space:nowrap;\n    filter:blur(8px);\n    transition:\n      filter .3s ease,\n      letter-spacing .35s var(--ease),\n      transform .35s var(--ease),\n      text-shadow .3s ease;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__lineup {\n    display:block;\n    max-width:720px;\n    margin-top:14px;\n    font-size:11px;\n    line-height:1.5;\n    letter-spacing:.03em;\n    color:transparent;\n    transform:translateY(8px);\n    opacity:0;\n    transition:\n      color .3s ease,\n      opacity .3s ease,\n      transform .35s var(--ease);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name.is-near {\n    color:var(--text);\n    transform:translate(-50%,-50%) scale(1.02);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name.is-near .hsm__title {\n    filter:blur(0);\n    letter-spacing:-.045em;\n    text-shadow:0 0 18px rgba(255,255,255,.08);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name.is-near .hsm__lineup {\n    color:var(--soft);\n    opacity:1;\n    transform:translateY(0);\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name:hover {\n    color:#fff;\n  }\n\n  #hsm-{{ hsm_id }} .hsm__name:hover .hsm__title {\n    filter:blur(0);\n    letter-spacing:-.035em;\n  }\n\n  @media (max-width:989px) {\n    #hsm-{{ hsm_id }} {\n      min-height:780px;\n      cursor:auto;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__instruction {\n      font-size:0;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__instruction::after {\n      content:\"DRAG TO TENSION\";\n      font-size:9px;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__name {\n      max-width:88vw;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__name:nth-child(1) {\n      left:46%;\n      top:27%;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__name:nth-child(2) {\n      left:56%;\n      top:50%;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__name:nth-child(3) {\n      left:46%;\n      top:73%;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__title {\n      font-size:clamp(46px,12vw,88px);\n      white-space:normal;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__lineup {\n      max-width:82vw;\n      font-size:10px;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__cursor-ring,\n    #hsm-{{ hsm_id }} .hsm__cursor-core {\n      opacity:0;\n    }\n  }\n\n  @media (max-width:560px) {\n    #hsm-{{ hsm_id }} {\n      min-height:720px;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__topline,\n    #hsm-{{ hsm_id }} .hsm__footer {\n      left:16px;\n      right:16px;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__topline span:last-child,\n    #hsm-{{ hsm_id }} .hsm__footer span:last-child {\n      display:none;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__title {\n      font-size:clamp(40px,13vw,62px);\n      line-height:.86;\n    }\n\n    #hsm-{{ hsm_id }} .hsm__lineup {\n      max-width:86vw;\n      font-size:9px;\n    }\n  }\n\n  @media (prefers-reduced-motion:reduce) {\n    #hsm-{{ hsm_id }} .hsm__name,\n    #hsm-{{ hsm_id }} .hsm__title,\n    #hsm-{{ hsm_id }} .hsm__lineup,\n    #hsm-{{ hsm_id }} .hsm__grid-lines line {\n      transition:none !important;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hsm-{{ hsm_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const svg = root.querySelector('.hsm__mesh');\n  const trailPath = root.querySelector('.hsm__trail-path');\n  const cursorCore = root.querySelector('.hsm__cursor-core');\n  const cursorRing = root.querySelector('.hsm__cursor-ring');\n  const verticalLines = [...root.querySelectorAll('.hsm__vline')];\n  const horizontalLines = [...root.querySelectorAll('.hsm__hline')];\n  const names = [...root.querySelectorAll('.hsm__name')];\n\n  const points = [];\n  const maxPoints = 34;\n  let px = 800;\n  let py = 450;\n  let targetX = 800;\n  let targetY = 450;\n  let raf = null;\n  let active = false;\n\n  const clamp = (v, min, max) => Math.min(Math.max(v, min), max);\n\n  const toSvgPoint = (clientX, clientY) => {\n    const rect = root.getBoundingClientRect();\n    return {\n      x: clamp(((clientX - rect.left) / rect.width) * 1600, 0, 1600),\n      y: clamp(((clientY - rect.top) / rect.height) * 900, 0, 900)\n    };\n  };\n\n  const updateTrail = () => {\n    if (!points.length) {\n      trailPath.setAttribute('d', '');\n      return;\n    }\n\n    let d = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;\n    for (let i = 1; i < points.length; i++) {\n      const p = points[i];\n      d += ` L ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;\n    }\n    trailPath.setAttribute('d', d);\n  };\n\n  const updateMesh = () => {\n    verticalLines.forEach((line, index) => {\n      const x = index * (1600 / 14);\n      const dist = Math.abs(px - x);\n      const pull = clamp(1 - dist / 280, 0, 1);\n\n      line.setAttribute('x1', x + (px - x) * pull * .08);\n      line.setAttribute('x2', x + (px - x) * pull * .08);\n      line.style.stroke = `rgba(255,255,255,${0.08 + pull * 0.48})`;\n      line.style.strokeWidth = `${0.7 + pull * 1.15}`;\n      line.style.opacity = `${0.48 + pull * .52}`;\n    });\n\n    horizontalLines.forEach((line, index) => {\n      const y = index * 100;\n      const dist = Math.abs(py - y);\n      const pull = clamp(1 - dist / 220, 0, 1);\n\n      line.setAttribute('y1', y + (py - y) * pull * .08);\n      line.setAttribute('y2', y + (py - y) * pull * .08);\n      line.style.stroke = `rgba(255,255,255,${0.08 + pull * 0.48})`;\n      line.style.strokeWidth = `${0.7 + pull * 1.15}`;\n      line.style.opacity = `${0.48 + pull * .52}`;\n    });\n  };\n\n  const updateNames = () => {\n    names.forEach(name => {\n      const nx = Number(name.dataset.x) * 1600;\n      const ny = Number(name.dataset.y) * 900;\n      const dx = px - nx;\n      const dy = py - ny;\n      const dist = Math.sqrt(dx * dx + dy * dy);\n      const near = dist < 260;\n\n      name.classList.toggle('is-near', near);\n      name.style.opacity = `${0.46 + clamp(1 - dist / 720, 0, 1) * .54}`;\n    });\n  };\n\n  const animate = () => {\n    px += (targetX - px) * .18;\n    py += (targetY - py) * .18;\n\n    cursorCore.setAttribute('cx', px);\n    cursorCore.setAttribute('cy', py);\n    cursorRing.setAttribute('cx', px);\n    cursorRing.setAttribute('cy', py);\n\n    if (active) {\n      points.push({ x: px, y: py });\n      if (points.length > maxPoints) points.shift();\n    } else if (points.length) {\n      points.shift();\n    }\n\n    updateTrail();\n    updateMesh();\n    updateNames();\n\n    if (active || points.length || Math.abs(targetX - px) > .5 || Math.abs(targetY - py) > .5) {\n      raf = requestAnimationFrame(animate);\n    } else {\n      raf = null;\n    }\n  };\n\n  const start = () => {\n    if (!raf) raf = requestAnimationFrame(animate);\n  };\n\n  const handlePointer = event => {\n    const p = toSvgPoint(event.clientX, event.clientY);\n    targetX = p.x;\n    targetY = p.y;\n    active = true;\n    start();\n  };\n\n  root.addEventListener('pointerenter', event => {\n    handlePointer(event);\n  });\n\n  root.addEventListener('pointermove', handlePointer);\n\n  root.addEventListener('pointerleave', () => {\n    active = false;\n    start();\n  });\n\n  root.addEventListener('pointerdown', event => {\n    const p = toSvgPoint(event.clientX, event.clientY);\n    targetX = p.x;\n    targetY = p.y;\n    active = true;\n    points.length = 0;\n    points.push(p);\n    start();\n  });\n\n  root.addEventListener('pointerup', () => {\n    if (window.matchMedia('(pointer:coarse)').matches) {\n      active = false;\n      start();\n    }\n  });\n\n  names.forEach(name => {\n    name.addEventListener('focus', () => {\n      names.forEach(item => item.classList.toggle('is-near', item === name));\n    });\n  });\n\n  updateMesh();\n  updateNames();\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_xebWqz": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD ANTI-DESIGN SERIES SWITCHER\n  Paste this complete block into a Shopify Custom Liquid section.\n\n  Concept:\n  - Full-bleed black\n  - One white hairline\n  - Stark monospace typography\n  - Zero easing\n  - Instant hard-cut between full-screen series states\n{% endcomment %}\n\n{% assign had_id = section.id | default: 'hndrd-antidesign' %}\n\n<section id=\"had-{{ had_id }}\" class=\"had\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"had__screen is-active\" data-screen=\"0\">\n    <div class=\"had__top\">\n      <span>HNDRD</span>\n      <span>01 / 03</span>\n    </div>\n\n    <div class=\"had__center\">\n      <p class=\"had__label\">SERIES 01</p>\n      <h2>PRO SERIES</h2>\n      <p class=\"had__models\">NITRIX 70 VENOM / NITRIX 70 VOLTA / HYFONIC 7 / FLAREON 700</p>\n    </div>\n\n    <a class=\"had__link\" href=\"https://in.hndrd.co/pages/pro-series-rackets\">\n      OPEN PRO SERIES\n    </a>\n  </div>\n\n  <div class=\"had__screen\" data-screen=\"1\">\n    <div class=\"had__top\">\n      <span>HNDRD</span>\n      <span>02 / 03</span>\n    </div>\n\n    <div class=\"had__center\">\n      <p class=\"had__label\">SERIES 02</p>\n      <h2>PRIME TRINITY</h2>\n      <p class=\"had__models\">NITRIX 10 / FLAREON 100 / HYFONIC 1</p>\n    </div>\n\n    <a class=\"had__link\" href=\"https://in.hndrd.co/pages/the-prime-trinity\">\n      OPEN PRIME TRINITY\n    </a>\n  </div>\n\n  <div class=\"had__screen\" data-screen=\"2\">\n    <div class=\"had__top\">\n      <span>HNDRD</span>\n      <span>03 / 03</span>\n    </div>\n\n    <div class=\"had__center\">\n      <p class=\"had__label\">SERIES 03</p>\n      <h2>EVOLUTION SERIES</h2>\n      <p class=\"had__models\">NITRIX THUNDER / FLAREON TYPHOON / HYFONIC LAZER</p>\n    </div>\n\n    <a class=\"had__link\" href=\"https://in.hndrd.co/pages/pro-series\">\n      OPEN EVOLUTION SERIES\n    </a>\n  </div>\n\n  <div class=\"had__hairline\" aria-hidden=\"true\"></div>\n\n  <nav class=\"had__nav\" aria-label=\"Choose racket series\">\n    <button type=\"button\" class=\"is-active\" data-go=\"0\">PRO SERIES</button>\n    <button type=\"button\" data-go=\"1\">PRIME TRINITY</button>\n    <button type=\"button\" data-go=\"2\">EVOLUTION SERIES</button>\n  </nav>\n</section>\n\n<style>\n  #had-{{ had_id }} {\n    position: relative;\n    width: 100%;\n    min-height: min(900px, 95vh);\n    overflow: hidden;\n    background: #000;\n    color: #fff;\n    font-family: \"Courier New\", Courier, monospace;\n  }\n\n  #had-{{ had_id }} *,\n  #had-{{ had_id }} *::before,\n  #had-{{ had_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #had-{{ had_id }} .had__screen {\n    position: absolute;\n    inset: 0;\n    display: none;\n    padding: 24px clamp(20px,4vw,64px) 96px;\n    background: #000;\n  }\n\n  #had-{{ had_id }} .had__screen.is-active {\n    display: block;\n  }\n\n  #had-{{ had_id }} .had__top {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: .14em;\n  }\n\n  #had-{{ had_id }} .had__center {\n    position: absolute;\n    left: clamp(20px,4vw,64px);\n    right: clamp(20px,4vw,64px);\n    top: 50%;\n    transform: translateY(-50%);\n  }\n\n  #had-{{ had_id }} .had__label {\n    margin: 0 0 16px;\n    font-size: 10px;\n    letter-spacing: .14em;\n  }\n\n  #had-{{ had_id }} h2 {\n    margin: 0;\n    max-width: 95%;\n    font-size: clamp(54px,10vw,170px);\n    line-height: .82;\n    letter-spacing: -.08em;\n    font-weight: 400;\n    text-transform: uppercase;\n  }\n\n  #had-{{ had_id }} .had__models {\n    margin: 26px 0 0;\n    max-width: 920px;\n    font-size: 11px;\n    line-height: 1.65;\n    letter-spacing: .08em;\n  }\n\n  #had-{{ had_id }} .had__link {\n    position: absolute;\n    right: clamp(20px,4vw,64px);\n    bottom: 96px;\n    color: #fff;\n    text-decoration: none;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: .14em;\n  }\n\n  #had-{{ had_id }} .had__link:hover,\n  #had-{{ had_id }} .had__link:focus-visible {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  #had-{{ had_id }} .had__hairline {\n    position: absolute;\n    left: clamp(20px,4vw,64px);\n    right: clamp(20px,4vw,64px);\n    bottom: 72px;\n    height: 1px;\n    background: #fff;\n  }\n\n  #had-{{ had_id }} .had__nav {\n    position: absolute;\n    left: clamp(20px,4vw,64px);\n    right: clamp(20px,4vw,64px);\n    bottom: 24px;\n    display: grid;\n    grid-template-columns: repeat(3,1fr);\n    gap: 0;\n  }\n\n  #had-{{ had_id }} .had__nav button {\n    appearance: none;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: rgba(255,255,255,.35);\n    text-align: left;\n    font: inherit;\n    font-size: 10px;\n    line-height: 1;\n    letter-spacing: .14em;\n    cursor: pointer;\n  }\n\n  #had-{{ had_id }} .had__nav button:nth-child(2) {\n    text-align: center;\n  }\n\n  #had-{{ had_id }} .had__nav button:nth-child(3) {\n    text-align: right;\n  }\n\n  #had-{{ had_id }} .had__nav button.is-active {\n    color: #fff;\n  }\n\n  #had-{{ had_id }} .had__nav button:hover,\n  #had-{{ had_id }} .had__nav button:focus-visible {\n    color: #fff;\n    outline: none;\n  }\n\n  @media (max-width: 760px) {\n    #had-{{ had_id }} {\n      min-height: 720px;\n    }\n\n    #had-{{ had_id }} .had__screen {\n      padding: 20px 16px 118px;\n    }\n\n    #had-{{ had_id }} .had__center {\n      left: 16px;\n      right: 16px;\n    }\n\n    #had-{{ had_id }} h2 {\n      max-width: 100%;\n      font-size: clamp(46px,15vw,78px);\n      line-height: .86;\n    }\n\n    #had-{{ had_id }} .had__models {\n      font-size: 10px;\n    }\n\n    #had-{{ had_id }} .had__link {\n      left: 16px;\n      right: auto;\n      bottom: 118px;\n    }\n\n    #had-{{ had_id }} .had__hairline {\n      left: 16px;\n      right: 16px;\n      bottom: 92px;\n    }\n\n    #had-{{ had_id }} .had__nav {\n      left: 16px;\n      right: 16px;\n      bottom: 20px;\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    #had-{{ had_id }} .had__nav button,\n    #had-{{ had_id }} .had__nav button:nth-child(2),\n    #had-{{ had_id }} .had__nav button:nth-child(3) {\n      text-align: left;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('had-{{ had_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const screens = [...root.querySelectorAll('[data-screen]')];\n  const buttons = [...root.querySelectorAll('[data-go]')];\n\n  const show = index => {\n    screens.forEach((screen, i) => {\n      screen.classList.toggle('is-active', i === index);\n    });\n\n    buttons.forEach((button, i) => {\n      button.classList.toggle('is-active', i === index);\n      button.setAttribute('aria-pressed', i === index ? 'true' : 'false');\n    });\n  };\n\n  buttons.forEach(button => {\n    button.addEventListener('click', () => {\n      show(Number(button.dataset.go));\n    });\n  });\n})();\n</script>",
