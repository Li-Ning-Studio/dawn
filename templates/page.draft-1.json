    "custom_liquid_4rqj3i": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-prime-trinity\" id=\"prime-trinity\">\n  <div class=\"hn-prime-trinity__inner\">\n\n    <div class=\"hn-prime-trinity__header\">\n      <p class=\"hn-prime-trinity__kicker\">Prime Trinity</p>\n\n      <h2 class=\"hn-prime-trinity__title\">\n        One Game. Three Personalities.\n      </h2>\n\n      <p class=\"hn-prime-trinity__sub\">\n        Pick the one that matches the way you play.\n      </p>\n    </div>\n\n    <div class=\"hn-prime-trinity__cards\">\n\n      <article class=\"hn-prime-card hn-prime-card--nitrix\" style=\"--accent:#E8432A;\">\n        <div class=\"hn-prime-card__image\">\n          <!-- Add Nitrix 10 image here later -->\n          <!-- <img src=\"YOUR_NITRIX_IMAGE_LINK\" alt=\"Nitrix 10 racket\"> -->\n          <span class=\"hn-prime-card__image-glow\"></span>\n        </div>\n\n        <div class=\"hn-prime-card__body\">\n          <div class=\"hn-prime-card__top\">\n            <p class=\"hn-prime-card__name\">NITRIX 10</p>\n            <span class=\"hn-prime-card__tag\">Attack</span>\n          </div>\n\n          <h3>Attack has a new address.</h3>\n\n          <p class=\"hn-prime-card__copy\">\n            Built for players who step in and take over.\n          </p>\n\n          <ul class=\"hn-prime-card__features\">\n            <li>\n              <span>Superlight Carbon Core</span>\n              flexible shaft, powerful whip for aggressive impact\n            </li>\n            <li>\n              <span>Vaporshaft 6.8mm</span>\n              slim, whip-effect on smashes\n            </li>\n          </ul>\n\n          <div class=\"hn-prime-card__bottom\">\n            <p class=\"hn-prime-card__price\">₹1,799</p>\n            <a href=\"/products/nitrix-10\" class=\"hn-prime-card__button\">\n              Go All In\n              <span>→</span>\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"hn-prime-card hn-prime-card--flareon\" style=\"--accent:#FF9C2A;\">\n        <div class=\"hn-prime-card__image\">\n          <!-- Add Flareon 100 image here later -->\n          <!-- <img src=\"YOUR_FLAREON_IMAGE_LINK\" alt=\"Flareon 100 racket\"> -->\n          <span class=\"hn-prime-card__image-glow\"></span>\n        </div>\n\n        <div class=\"hn-prime-card__body\">\n          <div class=\"hn-prime-card__top\">\n            <p class=\"hn-prime-card__name\">FLAREON 100</p>\n            <span class=\"hn-prime-card__tag\">Speed</span>\n          </div>\n\n          <h3>Play the game a step faster.</h3>\n\n          <p class=\"hn-prime-card__copy\">\n            Quick through the air, quicker between shots.\n          </p>\n\n          <ul class=\"hn-prime-card__features\">\n            <li>\n              <span>AECG+ Carbon Core</span>\n              max repulsion, effortless pace\n            </li>\n            <li>\n              <span>Ultra-light Build</span>\n              maximizes swing speed\n            </li>\n          </ul>\n\n          <div class=\"hn-prime-card__bottom\">\n            <p class=\"hn-prime-card__price\">₹1,890</p>\n            <a href=\"/products/flareon-100\" class=\"hn-prime-card__button\">\n              Pick Up the Pace\n              <span>→</span>\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"hn-prime-card hn-prime-card--hyfonic\" style=\"--accent:#4361EE;\">\n        <div class=\"hn-prime-card__image\">\n          <!-- Add Hyfonic 1 image here later -->\n          <!-- <img src=\"YOUR_HYFONIC_IMAGE_LINK\" alt=\"Hyfonic 1 racket\"> -->\n          <span class=\"hn-prime-card__image-glow\"></span>\n        </div>\n\n        <div class=\"hn-prime-card__body\">\n          <div class=\"hn-prime-card__top\">\n            <p class=\"hn-prime-card__name\">HYFONIC 1</p>\n            <span class=\"hn-prime-card__tag\">Precision</span>\n          </div>\n\n          <h3>Make the shuttle listen.</h3>\n\n          <p class=\"hn-prime-card__copy\">\n            Built for measured rallies and smart play.\n          </p>\n\n          <ul class=\"hn-prime-card__features\">\n            <li>\n              <span>Curve² Geometry</span>\n              expanded sweet spot, easier consistency\n            </li>\n            <li>\n              <span>Precision Racket</span>\n              gives direction to every shot\n            </li>\n          </ul>\n\n          <div class=\"hn-prime-card__bottom\">\n            <p class=\"hn-prime-card__price\">₹1,890</p>\n            <a href=\"/products/hyfonic-1\" class=\"hn-prime-card__button\">\n              Trust the Play\n              <span>→</span>\n            </a>\n          </div>\n        </div>\n      </article>\n\n    </div>\n\n    <div class=\"hn-prime-table-wrap\">\n      <div class=\"hn-prime-table\">\n        <div class=\"hn-prime-table__cell hn-prime-table__blank\"></div>\n        <div class=\"hn-prime-table__cell hn-prime-table__head\">Nitrix 10</div>\n        <div class=\"hn-prime-table__cell hn-prime-table__head\">Flareon 100</div>\n        <div class=\"hn-prime-table__cell hn-prime-table__head\">Hyfonic 1</div>\n\n        <div class=\"hn-prime-table__cell hn-prime-table__label\">Best for</div>\n        <div class=\"hn-prime-table__cell\">Players who like to end the rally</div>\n        <div class=\"hn-prime-table__cell\">Players who like to outlast the rally</div>\n        <div class=\"hn-prime-table__cell\">Players who like to out-place the rally</div>\n\n        <div class=\"hn-prime-table__cell hn-prime-table__label\">Feels like</div>\n        <div class=\"hn-prime-table__cell\">Punchy, front-foot, made to attack</div>\n        <div class=\"hn-prime-table__cell\">Light, whippy, quick to recover</div>\n        <div class=\"hn-prime-table__cell\">Balanced, controlled, forgiving on off-center hits</div>\n\n        <div class=\"hn-prime-table__cell hn-prime-table__label\">Pick this if</div>\n        <div class=\"hn-prime-table__cell\">“I want to hit through them.”</div>\n        <div class=\"hn-prime-table__cell\">“I want to be faster than them.”</div>\n        <div class=\"hn-prime-table__cell\">“I want to out-think them.”</div>\n      </div>\n    </div>\n\n    <div class=\"hn-prime-trinity__cta-wrap\">\n      <a href=\"/pages/the-prime-trinity\" class=\"hn-prime-trinity__cta\">\n        View the full Prime Trinity\n        <span>→</span>\n      </a>\n    </div>\n\n    <div class=\"hn-evolution-divider\">\n      <span class=\"hn-evolution-divider__line\"></span>\n\n      <div class=\"hn-evolution-divider__content\">\n        <h2>You've found your style. Now evolve it.</h2>\n        <p>\n          Same DNA, more everything. The Evolution Series is Nitrix, Flareon, and Hyfonic pushed further.\n        </p>\n      </div>\n\n      <span class=\"hn-evolution-divider__line\"></span>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hn-prime-trinity,\n  .hn-prime-trinity *,\n  .hn-prime-trinity *::before,\n  .hn-prime-trinity *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-prime-trinity {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: 116px 20px 90px;\n    background:\n      radial-gradient(circle at 50% 0%, rgba(45, 159, 167, 0.15), transparent 34%),\n      radial-gradient(circle at 16% 20%, rgba(232, 67, 42, 0.13), transparent 30%),\n      radial-gradient(circle at 84% 24%, rgba(67, 97, 238, 0.12), transparent 30%),\n      linear-gradient(to bottom, #030403 0%, #070908 44%, #030403 100%);\n    font-family: inherit;\n    isolation: isolate;\n  }\n\n  .hn-prime-trinity::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);\n    background-size: 46px 46px;\n    opacity: 0.22;\n  }\n\n  .hn-prime-trinity::after {\n    content: \"\";\n    position: absolute;\n    width: 56vw;\n    height: 56vw;\n    min-width: 520px;\n    min-height: 520px;\n    left: 50%;\n    top: 8%;\n    z-index: 0;\n    pointer-events: none;\n    transform: translate(-50%, -50%);\n    background: radial-gradient(circle, rgba(31, 210, 159, 0.14), rgba(219, 162, 15, 0.08) 38%, transparent 72%);\n    filter: blur(48px);\n    opacity: 0.75;\n    animation: hnPrimeGlow 5.4s ease-in-out infinite;\n  }\n\n  .hn-prime-trinity__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1460px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-prime-trinity__header {\n    text-align: center;\n    margin: 0 auto 42px;\n    opacity: 0;\n    transform: translateY(24px);\n    transition: opacity 0.9s ease, transform 0.9s ease;\n  }\n\n  .hn-prime-trinity.is-visible .hn-prime-trinity__header {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-prime-trinity__kicker {\n    margin: 0 0 10px;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(13px, 1.1vw, 16px);\n    line-height: 1.2;\n    font-weight: 650;\n    letter-spacing: 0.02em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-trinity__title {\n    margin: 0;\n    font-size: clamp(46px, 6.6vw, 104px);\n    line-height: 0.94;\n    font-weight: 900;\n    letter-spacing: -0.065em;\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    );\n    background-size: 120% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    filter: drop-shadow(0 18px 42px rgba(0,0,0,0.42));\n  }\n\n  .hn-prime-trinity__sub {\n    width: min(720px, 100%);\n    margin: 16px auto 0;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(15px, 1.25vw, 18px);\n    line-height: 1.45;\n    font-weight: 550;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-prime-trinity__cards {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0