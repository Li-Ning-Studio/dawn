      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD ASYMMETRIC GRID BREAK\n  Paste this complete block inside a Shopify Custom Liquid section.\n\n  Concept:\n  - Prime Trinity = slim vertical strip on the left\n  - Evolution Series = dominant oversized block on the upper right\n  - Pro Series = thin horizontal band along the bottom cutting across\n  - Broken editorial layout, dark premium styling, no rigid equal grid\n{% endcomment %}\n\n{% assign hag_id = section.id | default: 'hndrd-asymmetric-grid-break' %}\n\n<section id=\"hag-{{ hag_id }}\" class=\"hag\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hag__intro\">\n    <p class=\"hag__eyebrow\">HNDRD RACKET SERIES</p>\n    <p class=\"hag__note\">Three systems. One standard.</p>\n  </div>\n\n  <div class=\"hag__canvas\">\n    <a class=\"hag__card hag__card--prime\" href=\"https://in.hndrd.co/pages/the-prime-trinity\" aria-label=\"Explore Prime Trinity\">\n      <div class=\"hag__wash\" aria-hidden=\"true\"></div>\n      <div class=\"hag__frame\" aria-hidden=\"true\"></div>\n\n      <div class=\"hag__meta\">\n        <span>01</span>\n        <span>PRIME TRINITY</span>\n      </div>\n\n      <div class=\"hag__body\">\n        <p class=\"hag__kicker\">One game. Three expressions.</p>\n        <h2 class=\"hag__title hag__title--vertical\">\n          <span>PRIME</span>\n          <span>TRINITY</span>\n        </h2>\n\n        <ul class=\"hag__list\" aria-label=\"Prime Trinity rackets\">\n          <li>Nitrix 10</li>\n          <li>Flareon 100</li>\n          <li>Hyfonic 1</li>\n        </ul>\n      </div>\n\n      <div class=\"hag__cta\">\n        <span>Explore</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n        </svg>\n      </div>\n\n      <div class=\"hag__ghost\" aria-hidden=\"true\">I</div>\n    </a>\n\n    <a class=\"hag__card hag__card--evolution\" href=\"https://in.hndrd.co/pages/pro-series\" aria-label=\"Explore Evolution Series\">\n      <div class=\"hag__wash\" aria-hidden=\"true\"></div>\n      <div class=\"hag__frame\" aria-hidden=\"true\"></div>\n\n      <div class=\"hag__meta\">\n        <span>02</span>\n        <span>EVOLUTION SERIES</span>\n      </div>\n\n      <div class=\"hag__body\">\n        <p class=\"hag__kicker\">Attack. Speed. Precision.</p>\n        <h2 class=\"hag__title hag__title--hero\">\n          <span>EVOLUTION</span>\n          <span>SERIES</span>\n        </h2>\n\n        <ul class=\"hag__list hag__list--wide\" aria-label=\"Evolution Series rackets\">\n          <li>Nitrix Thunder</li>\n          <li>Flareon Typhoon</li>\n          <li>Hyfonic Lazer</li>\n        </ul>\n      </div>\n\n      <div class=\"hag__cta\">\n        <span>Explore</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n        </svg>\n      </div>\n\n      <div class=\"hag__ghost\" aria-hidden=\"true\">EVO</div>\n    </a>\n\n    <a class=\"hag__card hag__card--pro\" href=\"https://in.hndrd.co/pages/pro-series-rackets\" aria-label=\"Explore Pro Series\">\n      <div class=\"hag__wash\" aria-hidden=\"true\"></div>\n      <div class=\"hag__frame\" aria-hidden=\"true\"></div>\n\n      <div class=\"hag__meta\">\n        <span>03</span>\n        <span>PRO SERIES</span>\n      </div>\n\n      <div class=\"hag__body hag__body--band\">\n        <div class=\"hag__band-copy\">\n          <p class=\"hag__kicker\">Built for the highest level</p>\n          <h2 class=\"hag__title hag__title--band\">PRO SERIES</h2>\n        </div>\n\n        <ul class=\"hag__list hag__list--band\" aria-label=\"Pro Series rackets\">\n          <li>Nitrix 70 Venom</li>\n          <li>Nitrix 70 Volta</li>\n          <li>Hyfonic 7</li>\n          <li>Flareon 700</li>\n        </ul>\n      </div>\n\n      <div class=\"hag__cta hag__cta--band\">\n        <span>Explore</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n        </svg>\n      </div>\n\n      <div class=\"hag__ghost hag__ghost--band\" aria-hidden=\"true\">PRO</div>\n    </a>\n  </div>\n</section>\n\n<style>\n  #hag-{{ hag_id }} {\n    --bg: #050505;\n    --line: rgba(255,255,255,.12);\n    --muted: rgba(255,255,255,.54);\n    --soft: rgba(255,255,255,.76);\n    --prime: #d9ff26;\n    --evolution: #5ee2ff;\n    --pro: #ff6a00;\n    --ease: cubic-bezier(.2,.75,.2,1);\n    position: relative;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 80% 10%, rgba(255,255,255,.03), transparent 22%),\n      radial-gradient(circle at 15% 85%, rgba(255,255,255,.025), transparent 22%),\n      var(--bg);\n    color: #fff;\n    font-family: Figtree, Arial, sans-serif;\n  }\n\n  #hag-{{ hag_id }} *,\n  #hag-{{ hag_id }} *::before,\n  #hag-{{ hag_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #hag-{{ hag_id }} .hag__intro {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n    padding: clamp(26px,4vw,54px) clamp(20px,4.2vw,64px) 18px;\n  }\n\n  #hag-{{ hag_id }} .hag__eyebrow,\n  #hag-{{ hag_id }} .hag__note,\n  #hag-{{ hag_id }} .hag__meta {\n    margin: 0;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  #hag-{{ hag_id }} .hag__eyebrow {\n    color: rgba(255,255,255,.8);\n  }\n\n  #hag-{{ hag_id }} .hag__note {\n    color: var(--muted);\n    text-align: right;\n  }\n\n  #hag-{{ hag_id }} .hag__canvas {\n    position: relative;\n    min-height: 760px;\n    padding: 10px clamp(20px,4.2vw,64px) clamp(30px,4vw,44px);\n  }\n\n  #hag-{{ hag_id }} .hag__card {\n    position: absolute;\n    overflow: hidden;\n    display: block;\n    color: #fff;\n    text-decoration: none;\n    border: 1px solid var(--line);\n    background: rgba(255,255,255,.015);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    transition:\n      transform .65s var(--ease),\n      border-color .35s ease,\n      background .35s ease;\n  }\n\n  #hag-{{ hag_id }} .hag__card:hover {\n    transform: translate3d(0,-6px,0);\n    border-color: rgba(255,255,255,.22);\n    background: rgba(255,255,255,.03);\n  }\n\n  #hag-{{ hag_id }} .hag__wash,\n  #hag-{{ hag_id }} .hag__frame {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  #hag-{{ hag_id }} .hag__frame {\n    border: 1px solid rgba(255,255,255,.05);\n    inset: 12px;\n  }\n\n  #hag-{{ hag_id }} .hag__card--prime {\n    left: clamp(20px,4.2vw,64px);\n    top: 10px;\n    width: 17%;\n    min-width: 170px;\n    height: 560px;\n    z-index: 2;\n  }\n\n  #hag-{{ hag_id }} .hag__card--prime .hag__wash {\n    background:\n      radial-gradient(circle at 72% 15%, rgba(217,255,38,.18), transparent 30%),\n      linear-gradient(180deg, rgba(217,255,38,.08), rgba(5,5,5,.12) 22%, rgba(5,5,5,.9));\n  }\n\n  #hag-{{ hag_id }} .hag__card--evolution {\n    right: clamp(20px,4.2vw,64px);\n    top: 58px;\n    width: 70%;\n    height: 470px;\n    z-index: 1;\n    transform: rotate(-2.25deg);\n    transform-origin: center center;\n  }\n\n  #hag-{{ hag_id }} .hag__card--evolution:hover {\n    transform: rotate(-2.25deg) translate3d(0,-6px,0);\n  }\n\n  #hag-{{ hag_id }} .hag__card--evolution .hag__wash {\n    background:\n      radial-gradient(circle at 82% 18%, rgba(94,226,255,.16), transparent 28%),\n      radial-gradient(circle at 25% 78%, rgba(94,226,255,.08), transparent 28%),\n      linear-gradient(135deg, rgba(4,18,22,.95), rgba(3,3,3,.94));\n  }\n\n  #hag-{{ hag_id }} .hag__card--pro {\n    left: 11%;\n    right: clamp(20px,4.2vw,64px);\n    bottom: clamp(30px,4vw,44px);\n    height: 176px;\n    z-index: 3;\n  }\n\n  #hag-{{ hag_id }} .hag__card--pro .hag__wash {\n    background:\n      radial-gradient(circle at 88% 20%, rgba(255,106,0,.13), transparent 26%),\n      linear-gradient(90deg, rgba(255,106,0,.07), rgba(255,255,255,.02) 34%, rgba(3,3,3,.9));\n  }\n\n  #hag-{{ hag_id }} .hag__meta {\n    position: absolute;\n    left: 18px;\n    right: 18px;\n    top: 16px;\n    z-index: 2;\n    display: flex;\n    justify-content: space-between;\n    gap: 14px;\n    color: var(--muted);\n  }\n\n  #hag-{{ hag_id }} .hag__body {\n    position: relative;\n    z-index: 2;\n    height: 100%;\n    padding: 54px 22px 22px;\n  }\n\n  #hag-{{ hag_id }} .hag__kicker {\n    margin: 0 0 10px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n    color: var(--soft);\n  }\n\n  #hag-{{ hag_id }} .hag__title {\n    margin: 0;\n    line-height: .82;\n    letter-spacing: -.075em;\n    font-weight: 760;\n  }\n\n  #hag-{{ hag_id }} .hag__title--vertical {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    font-size: clamp(40px,4vw,58px);\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    height: 290px;\n    margin-top: 18px;\n  }\n\n  #hag-{{ hag_id }} .hag__title--hero {\n    display: block;\n    font-size: clamp(62px,8vw,132px);\n    line-height: .78;\n    max-width: 850px;\n    transform: translateX(2%) translateY(8px);\n  }\n\n  #hag-{{ hag_id }} .hag__title--hero span:last-child {\n    display: block;\n    margin-left: 16%;\n  }\n\n  #hag-{{ hag_id }} .hag__title--band {\n    font-size: clamp(34px,4vw,72px);\n    line-height: .88;\n  }\n\n  #hag-{{ hag_id }} .hag__list {\n    margin: 22px 0 0;\n    padding: 0;\n    list-style: none;\n    display: grid;\n    gap: 8px;\n  }\n\n  #hag-{{ hag_id }} .hag__list li {\n    position: relative;\n    padding-left: 12px;\n    font-size: 12px;\n    font-weight: 550;\n    letter-spacing: .015em;\n    color: rgba(255,255,255,.7);\n  }\n\n  #hag-{{ hag_id }} .hag__list li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: .56em;\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: currentColor;\n    opacity: .72;\n  }\n\n  #hag-{{ hag_id }} .hag__card--prime .hag__list li { color: rgba(217,255,38,.95); }\n  #hag-{{ hag_id }} .hag__card--evolution .hag__list li { color: rgba(94,226,255,.95); }\n  #hag-{{ hag_id }} .hag__card--pro .hag__list li { color: rgba(255,255,255,.82); }\n\n  #hag-{{ hag_id }} .hag__list--wide {\n    grid-template-columns: repeat(3,minmax(0,1fr));\n    max-width: 760px;\n    margin-top: 24px;\n  }\n\n  #hag-{{ hag_id }} .hag__body--band {\n    display: grid;\n    grid-template-columns: minmax(260px, 1fr) auto;\n    align-items: end;\n    gap: 22px 34px;\n    padding: 52px 22px 20px;\n    height: 100%;\n  }\n\n  #hag-{{ hag_id }} .hag__band-copy {\n    min-width: 0;\n  }\n\n  #hag-{{ hag_id }} .hag__list--band {\n    grid-template-columns: repeat(2,minmax(0,1fr));\n    align-self: center;\n    margin: 0;\n    min-width: 260px;\n  }\n\n  #hag-{{ hag_id }} .hag__cta {\n    position: absolute;\n    left: 22px;\n    bottom: 18px;\n    z-index: 2;\n    display: inline-flex;\n    align-items: center;\n    gap: 16px;\n    min-height: 44px;\n    padding: 0 7px 0 16px;\n    border: 1px solid rgba(255,255,255,.34);\n    border-radius: 999px;\n    color: #fff;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    transition: background .3s ease, color .3s ease, border-color .3s ease;\n  }\n\n  #hag-{{ hag_id }} .hag__cta svg {\n    width: 30px;\n    height: 30px;\n    padding: 8px;\n    border-radius: 50%;\n    background: #fff;\n    color: #050505;\n    transition: transform .35s var(--ease);\n  }\n\n  #hag-{{ hag_id }} .hag__cta path {\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  #hag-{{ hag_id }} .hag__card:hover .hag__cta {\n    background: #fff;\n    color: #050505;\n    border-color: #fff;\n  }\n\n  #hag-{{ hag_id }} .hag__card:hover .hag__cta svg {\n    transform: translateX(3px);\n  }\n\n  #hag-{{ hag_id }} .hag__cta--band {\n    left: auto;\n    right: 22px;\n    bottom: 18px;\n  }\n\n  #hag-{{ hag_id }} .hag__ghost {\n    position: absolute;\n    right: -10px;\n    bottom: -18px;\n    z-index: 1;\n    font-size: clamp(110px,12vw,180px);\n    line-height: .7;\n    font-weight: 800;\n    letter-spacing: -.1em;\n    color: rgba(255,255,255,.04);\n    pointer-events: none;\n  }\n\n  #hag-{{ hag_id }} .hag__card--prime .hag__ghost {\n    right: -14px;\n    bottom: -10px;\n    font-size: clamp(120px,10vw,150px);\n    color: rgba(217,255,38,.07);\n  }\n\n  #hag-{{ hag_id }} .hag__card--evolution .hag__ghost {\n    right: 10px;\n    bottom: -20px;\n    font-size: clamp(150px,18vw,280px);\n    color: rgba(94,226,255,.05);\n  }\n\n  #hag-{{ hag_id }} .hag__ghost--band {\n    right: 18%;\n    bottom: -26px;\n    font-size: clamp(130px,13vw,220px);\n    color: rgba(255,106,0,.05);\n  }\n\n  @media (max-width: 1200px) {\n    #hag-{{ hag_id }} .hag__canvas {\n      min-height: 820px;\n    }\n\n    #hag-{{ hag_id }} .hag__card--prime {\n      width: 20%;\n      min-width: 160px;\n    }\n\n    #hag-{{ hag_id }} .hag__card--evolution {\n      width: 67%;\n    }\n\n    #hag-{{ hag_id }} .hag__title--hero {\n      font-size: clamp(54px,8.6vw,110px);\n    }\n\n    #hag-{{ hag_id }} .hag__title--hero span:last-child {\n      margin-left: 12%;\n    }\n\n    #hag-{{ hag_id }} .hag__body--band {\n      grid-template-columns: minmax(220px,1fr) auto;\n    }\n  }\n\n  @media (max-width: 989px) {\n    #hag-{{ hag_id }} .hag__intro {\n      padding: 26px 20px 16px;\n      align-items: flex-start;\n      flex-direction: column;\n    }\n\n    #hag-{{ hag_id }} .hag__note {\n      text-align: left;\n    }\n\n    #hag-{{ hag_id }} .hag__canvas {\n      min-height: 0;\n      padding: 8px 20px 24px;\n      display: grid;\n      gap: 14px;\n    }\n\n    #hag-{{ hag_id }} .hag__card {\n      position: relative;\n      left: auto;\n      right: auto;\n      top: auto;\n      bottom: auto;\n      width: 100%;\n      height: auto;\n      min-width: 0;\n      transform: none !important;\n    }\n\n    #hag-{{ hag_id }} .hag__card--prime,\n    #hag-{{ hag_id }} .hag__card--evolution,\n    #hag-{{ hag_id }} .hag__card--pro {\n      height: auto;\n    }\n\n    #hag-{{ hag_id }} .hag__body {\n      padding: 50px 18px 74px;\n    }\n\n    #hag-{{ hag_id }} .hag__card--prime {\n      order: 1;\n    }\n\n    #hag-{{ hag_id }} .hag__card--evolution {\n      order: 2;\n    }\n\n    #hag-{{ hag_id }} .hag__card--pro {\n      order: 3;\n    }\n\n    #hag-{{ hag_id }} .hag__title--vertical {\n      writing-mode: initial;\n      transform: none;\n      height: auto;\n      font-size: clamp(44px,10vw,72px);\n      gap: 0;\n      margin-top: 8px;\n    }\n\n    #hag-{{ hag_id }} .hag__title--hero {\n      transform: none;\n      font-size: clamp(50px,11vw,88px);\n      max-width: 100%;\n    }\n\n    #hag-{{ hag_id }} .hag__title--hero span:last-child {\n      margin-left: 0;\n    }\n\n    #hag-{{ hag_id }} .hag__title--band {\n      font-size: clamp(42px,10vw,74px);\n    }\n\n    #hag-{{ hag_id }} .hag__list--wide {\n      grid-template-columns: 1fr;\n      max-width: none;\n    }\n\n    #hag-{{ hag_id }} .hag__body--band {\n      display: block;\n      padding: 50px 18px 74px;\n    }\n\n    #hag-{{ hag_id }} .hag__list--band {\n      grid-template-columns: 1fr 1fr;\n      margin-top: 20px;\n      min-width: 0;\n    }\n\n    #hag-{{ hag_id }} .hag__cta,\n    #hag-{{ hag_id }} .hag__cta--band {\n      left: 18px;\n      right: 18px;\n      bottom: 18px;\n      width: calc(100% - 36px);\n      justify-content: space-between;\n    }\n\n    #hag-{{ hag_id }} .hag__ghost,\n    #hag-{{ hag_id }} .hag__ghost--band {\n      right: 4px;\n      bottom: -10px;\n      font-size: 28vw;\n    }\n  }\n\n  @media (max-width: 560px) {\n    #hag-{{ hag_id }} .hag__meta {\n      left: 16px;\n      right: 16px;\n      top: 14px;\n      font-size: 9px;\n    }\n\n    #hag-{{ hag_id }} .hag__body,\n    #hag-{{ hag_id }} .hag__body--band {\n      padding: 46px 16px 72px;\n    }\n\n    #hag-{{ hag_id }} .hag__list,\n    #hag-{{ hag_id }} .hag__list--band,\n    #hag-{{ hag_id }} .hag__list--wide {\n      grid-template-columns: 1fr;\n      gap: 9px;\n    }\n\n    #hag-{{ hag_id }} .hag__title--vertical,\n    #hag-{{ hag_id }} .hag__title--hero,\n    #hag-{{ hag_id }} .hag__title--band {\n      font-size: clamp(40px,12vw,58px);\n      line-height: .9;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hag-{{ hag_id }} .hag__card,\n    #hag-{{ hag_id }} .hag__cta svg {\n      transition: none !important;\n    }\n  }\n</style>",
        "color_scheme": "scheme-4",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_Eg9Key": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD KINETIC TYPOGRAPHY SERIES SELECTOR\n  Paste this complete block into a Shopify Custom Liquid section.\n\n  Concept:\n  - No panels, borders, images, or card backgrounds\n  - Three oversized serif series names\n  - Variable-weight breathing animation\n  - Clicking a word triggers a full-screen typographic wipe\n  - Responsive desktop and mobile layouts\n{% endcomment %}\n\n{% assign hkt_id = section.id | default: 'hndrd-kinetic-type' %}\n\n<section id=\"hkt-{{ hkt_id }}\" class=\"hkt\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hkt__topline\">\n    <span>HNDRD RACKET SERIES</span>\n    <span>SELECT A SERIES</span>\n  </div>\n\n  <div class=\"hkt__words\">\n    <a\n      class=\"hkt__word is-active\"\n      href=\"https://in.hndrd.co/pages/pro-series-rackets\"\n      data-label=\"PRO SERIES\"\n      data-index=\"01\"\n      aria-label=\"Explore Pro Series\"\n    >\n      <span class=\"hkt__index\">01</span>\n      <span class=\"hkt__letters\" aria-hidden=\"true\">\n        <span>P</span><span>R</span><span>O</span>\n        <span class=\"hkt__space\">&nbsp;</span>\n        <span>S</span><span>E</span><span>R</span><span>I</span><span>E</span><span>S</span>\n      </span>\n      <span class=\"visually-hidden\">Pro Series</span>\n    </a>\n\n    <a\n      class=\"hkt__word\"\n      href=\"https://in.hndrd.co/pages/the-prime-trinity\"\n      data-label=\"PRIME TRINITY\"\n      data-index=\"02\"\n      aria-label=\"Explore Prime Trinity\"\n    >\n      <span class=\"hkt__index\">02</span>\n      <span class=\"hkt__letters\" aria-hidden=\"true\">\n        <span>P</span><span>R</span><span>I</span><span>M</span><span>E</span>\n        <span class=\"hkt__space\">&nbsp;</span>\n        <span>T</span><span>R</span><span>I</span><span>N</span><span>I</span><span>T</span><span>Y</span>\n      </span>\n      <span class=\"visually-hidden\">Prime Trinity</span>\n    </a>\n\n    <a\n      class=\"hkt__word\"\n      href=\"https://in.hndrd.co/pages/pro-series\"\n      data-label=\"EVOLUTION SERIES\"\n      data-index=\"03\"\n      aria-label=\"Explore Evolution Series\"\n    >\n      <span class=\"hkt__index\">03</span>\n      <span class=\"hkt__letters\" aria-hidden=\"true\">\n        <span>E</span><span>V</span><span>O</span><span>L</span><span>U</span><span>T</span><span>I</span><span>O</span><span>N</span>\n        <span class=\"hkt__space\">&nbsp;</span>\n        <span>S</span><span>E</span><span>R</span><span>I</span><span>E</span><span>S</span>\n      </span>\n      <span class=\"visually-hidden\">Evolution Series</span>\n    </a>\n  </div>\n\n  <div class=\"hkt__footer\">\n    <p class=\"hkt__lineup\" aria-live=\"polite\">\n      Nitrix 70 Venom&nbsp;&nbsp;·&nbsp;&nbsp;Nitrix 70 Volta&nbsp;&nbsp;·&nbsp;&nbsp;Hyfonic 7&nbsp;&nbsp;·&nbsp;&nbsp;Flareon 700\n    </p>\n    <span class=\"hkt__hint\">CLICK ANY LETTER</span>\n  </div>\n\n  <div class=\"hkt__wipe\" aria-hidden=\"true\">\n    <span class=\"hkt__wipe-word\">PRO SERIES</span>\n  </div>\n</section>\n\n<style>\n  #hkt-{{ hkt_id }} {\n    --bg: #050505;\n    --text: #f4f1ea;\n    --muted: rgba(244,241,234,.42);\n    --soft: rgba(244,241,234,.7);\n    --ease: cubic-bezier(.22,.75,.18,1);\n    position: relative;\n    min-height: min(860px, 94vh);\n    overflow: hidden;\n    background: var(--bg);\n    color: var(--text);\n    font-family: Figtree, Arial, sans-serif;\n  }\n\n  #hkt-{{ hkt_id }} *,\n  #hkt-{{ hkt_id }} *::before,\n  #hkt-{{ hkt_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #hkt-{{ hkt_id }} .visually-hidden {\n    position: absolute !important;\n    width: 1px !important;\n    height: 1px !important;\n    padding: 0 !important;\n    margin: -1px !important;\n    overflow: hidden !important;\n    clip: rect(0,0,0,0) !important;\n    white-space: nowrap !important;\n    border: 0 !important;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__topline {\n    position: absolute;\n    inset: 0 0 auto;\n    z-index: 4;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 24px clamp(20px,4.5vw,68px);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .19em;\n    text-transform: uppercase;\n    color: var(--muted);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__words {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    min-height: inherit;\n    padding: 86px clamp(20px,4.5vw,68px) 110px;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word {\n    position: relative;\n    display: grid;\n    grid-template-columns: 44px 1fr;\n    align-items: baseline;\n    width: 100%;\n    color: rgba(244,241,234,.14);\n    text-decoration: none;\n    cursor: pointer;\n    transition:\n      color .4s ease,\n      transform .5s var(--ease),\n      opacity .4s ease;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__index {\n    position: relative;\n    top: -.7em;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    color: var(--muted);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__letters {\n    display: flex;\n    flex-wrap: nowrap;\n    align-items: baseline;\n    font-family: \"Times New Roman\", Times, Georgia, serif;\n    font-size: clamp(64px,10.5vw,172px);\n    line-height: .78;\n    letter-spacing: -.075em;\n    white-space: nowrap;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__letters > span {\n    display: inline-block;\n    min-width: .38em;\n    font-weight: 200;\n    font-variation-settings: \"wght\" 200;\n    transform-origin: 50% 70%;\n    animation: hkt-breathe 3.8s ease-in-out infinite;\n    animation-delay: calc(var(--letter, 0) * 70ms);\n    transition:\n      color .35s ease,\n      transform .35s var(--ease),\n      font-weight .35s ease,\n      font-variation-settings .35s ease;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(1) { --letter:0; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(2) { --letter:1; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(3) { --letter:2; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(5) { --letter:3; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(6) { --letter:4; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(7) { --letter:5; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(8) { --letter:6; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(9) { --letter:7; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(1) .hkt__letters > span:nth-child(10) { --letter:8; }\n\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(1) { --letter:0; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(2) { --letter:1; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(3) { --letter:2; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(4) { --letter:3; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(5) { --letter:4; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(7) { --letter:5; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(8) { --letter:6; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(9) { --letter:7; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(10) { --letter:8; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(11) { --letter:9; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(12) { --letter:10; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(13) { --letter:11; }\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(2) .hkt__letters > span:nth-child(14) { --letter:12; }\n\n  #hkt-{{ hkt_id }} .hkt__word:nth-child(3) .hkt__letters > span:nth-child(n) {\n    --letter: calc(var(--n, 0));\n  }\n\n  #hkt-{{ hkt_id }} .hkt__space {\n    min-width: .28em !important;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word.is-active {\n    color: var(--text);\n    transform: translateX(8px);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word:not(.is-active) {\n    opacity: .74;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word:hover {\n    color: var(--text);\n    transform: translateX(8px);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__word:hover .hkt__letters > span {\n    animation-play-state: paused;\n    font-weight: 900;\n    font-variation-settings: \"wght\" 900;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__letters > span:hover {\n    transform: translateY(-8px) scale(1.05);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__footer {\n    position: absolute;\n    left: clamp(20px,4.5vw,68px);\n    right: clamp(20px,4.5vw,68px);\n    bottom: 28px;\n    z-index: 4;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: 24px;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__lineup {\n    margin: 0;\n    max-width: 760px;\n    font-size: 11px;\n    line-height: 1.5;\n    letter-spacing: .03em;\n    color: var(--soft);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__hint {\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    color: var(--muted);\n    white-space: nowrap;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__wipe {\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    display: grid;\n    place-items: center;\n    background: #f1eee6;\n    color: #050505;\n    transform: translateY(101%);\n    pointer-events: none;\n    transition: transform .72s var(--ease);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__wipe.is-active {\n    transform: translateY(0);\n  }\n\n  #hkt-{{ hkt_id }} .hkt__wipe-word {\n    display: block;\n    width: 100%;\n    padding: 0 5vw;\n    overflow: hidden;\n    font-family: \"Times New Roman\", Times, Georgia, serif;\n    font-size: clamp(66px,13vw,220px);\n    font-weight: 900;\n    line-height: .8;\n    letter-spacing: -.08em;\n    text-align: center;\n    transform: translateY(35px);\n    opacity: 0;\n    transition:\n      transform .55s var(--ease) .18s,\n      opacity .4s ease .18s;\n  }\n\n  #hkt-{{ hkt_id }} .hkt__wipe.is-active .hkt__wipe-word {\n    transform: translateY(0);\n    opacity: 1;\n  }\n\n  @keyframes hkt-breathe {\n    0%, 100% {\n      font-weight: 200;\n      font-variation-settings: \"wght\" 200;\n      transform: scaleX(.98);\n    }\n    50% {\n      font-weight: 900;\n      font-variation-settings: \"wght\" 900;\n      transform: scaleX(1.035);\n    }\n  }\n\n  @media (max-width: 989px) {\n    #hkt-{{ hkt_id }} {\n      min-height: 760px;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__topline {\n      padding: 20px;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__words {\n      padding: 78px 20px 132px;\n      gap: 16px;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__word {\n      grid-template-columns: 28px 1fr;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__letters {\n      flex-wrap: wrap;\n      font-size: clamp(50px,12vw,82px);\n      line-height: .84;\n      white-space: normal;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__letters > span {\n      min-width: .36em;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__footer {\n      left: 20px;\n      right: 20px;\n      bottom: 22px;\n      display: block;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__hint {\n      display: block;\n      margin-top: 12px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    #hkt-{{ hkt_id }} {\n      min-height: 700px;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__topline span:last-child {\n      display: none;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__words {\n      justify-content: center;\n      gap: 22px;\n      padding-top: 68px;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__letters {\n      font-size: clamp(42px,13vw,62px);\n      letter-spacing: -.065em;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__index {\n      top: -.35em;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__lineup {\n      font-size: 10px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hkt-{{ hkt_id }} .hkt__letters > span {\n      animation: none !important;\n      font-weight: 500;\n      font-variation-settings: \"wght\" 500;\n    }\n\n    #hkt-{{ hkt_id }} .hkt__wipe {\n      transition-duration: .01ms !important;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hkt-{{ hkt_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const words = [...root.querySelectorAll('.hkt__word')];\n  const lineup = root.querySelector('.hkt__lineup');\n  const wipe = root.querySelector('.hkt__wipe');\n  const wipeWord = root.querySelector('.hkt__wipe-word');\n\n  const details = {\n    'PRO SERIES': 'Nitrix 70 Venom  ·  Nitrix 70 Volta  ·  Hyfonic 7  ·  Flareon 700',\n    'PRIME TRINITY': 'Nitrix 10  ·  Flareon 100  ·  Hyfonic 1',\n    'EVOLUTION SERIES': 'Nitrix Thunder  ·  Flareon Typhoon  ·  Hyfonic Lazer'\n  };\n\n  const setActive = (word) => {\n    words.forEach(item => item.classList.toggle('is-active', item === word));\n    lineup.textContent = details[word.dataset.label] || '';\n  };\n\n  words.forEach(word => {\n    word.addEventListener('mouseenter', () => setActive(word));\n    word.addEventListener('focus', () => setActive(word));\n\n    word.addEventListener('click', event => {\n      event.preventDefault();\n\n      const destination = word.href;\n      const label = word.dataset.label;\n\n      setActive(word);\n      wipeWord.textContent = label;\n      wipe.classList.add('is-active');\n\n      window.setTimeout(() => {\n        window.location.href = destination;\n      }, 760);\n    });\n  });\n})();\n</script>",
        "color_scheme": "scheme-4",
        "padding_top": 40,
        "padding_bottom": 52
      }
