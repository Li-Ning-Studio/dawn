      "settings": {
        "custom_liquid": "<section class=\"hn-prime-deck\" id=\"hnPrimeDeck\" aria-label=\"Prime Trinity racket cards\">\n  <div class=\"hn-prime-deck__inner\">\n\n    <header class=\"hn-prime-deck__header\">\n      <p class=\"hn-prime-deck__eyebrow\">Prime Trinity</p>\n      <h2 class=\"hn-prime-deck__title\">Pick your first edge.</h2>\n      <p class=\"hn-prime-deck__subline\">\n        Three entry points. Attack, speed, or precision. Same Hundred DNA, tuned for how you play.\n      </p>\n    </header>\n\n    <div class=\"hn-prime-deck__cards\">\n\n      <!-- NITRIX 10 -->\n      <article\n        class=\"hn-prime-card is-active\"\n        style=\"--accent:#d7a20f; --accent-rgb:215,162,15;\"\n      >\n        <a href=\"/products/nitrix-10-4u-unstrung\" class=\"hn-prime-card__link\" aria-label=\"Shop Nitrix 10\">\n          <div class=\"hn-prime-card__visual\">\n            <span class=\"hn-prime-card__orb\"></span>\n            <span class=\"hn-prime-card__ring\"></span>\n\n            <picture>\n              <source\n                media=\"(max-width: 749px)\"\n                srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_2a158238-b426-4c12-bb43-9d86f6de9233.jpg?v=1769604070\"\n              >\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_92a9a1f0-4100-43b6-8e7c-90b8b83247f9.jpg?v=1769604070\"\n                alt=\"Nitrix 10 badminton racket\"\n                loading=\"lazy\"\n              >\n            </picture>\n          </div>\n\n          <div class=\"hn-prime-card__content\">\n            <div class=\"hn-prime-card__top\">\n              <span>Attack</span>\n              <small>Nitrix 10</small>\n            </div>\n\n            <h3>Built to end rallies early.</h3>\n\n            <p>\n              Superlight Carbon Core and a 6.8mm Vaporshaft. Whip-fast through impact for players who take the front foot and don't give it back.\n            </p>\n\n            <div class=\"hn-prime-card__bottom\">\n              <strong>₹1,799</strong>\n              <span>Go all in →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n      <!-- FLAREON 100 -->\n      <article\n        class=\"hn-prime-card\"\n        style=\"--accent:#00d9e8; --accent-rgb:0,217,232;\"\n      >\n        <a href=\"/products/flareon-100\" class=\"hn-prime-card__link\" aria-label=\"Shop Flareon 100\">\n          <div class=\"hn-prime-card__visual\">\n            <span class=\"hn-prime-card__orb\"></span>\n            <span class=\"hn-prime-card__ring\"></span>\n\n            <picture>\n              <source\n                media=\"(max-width: 749px)\"\n                srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_be65f83a-7188-472e-910d-e2d1f66e2ea3.jpg?v=1769600799\"\n              >\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_f45fedec-e15d-4a71-9e3e-60200be24a51.jpg?v=1769600799\"\n                alt=\"Flareon 100 badminton racket\"\n                loading=\"lazy\"\n              >\n            </picture>\n          </div>\n\n          <div class=\"hn-prime-card__content\">\n            <div class=\"hn-prime-card__top\">\n              <span>Speed</span>\n              <small>Flareon 100</small>\n            </div>\n\n            <h3>Get there before they do.</h3>\n\n            <p>\n              AECG+ carbon core in an ultra-light build. Quick through the air, quicker back to base, made for players who outlast the rally.\n            </p>\n\n            <div class=\"hn-prime-card__bottom\">\n              <strong>₹1,890</strong>\n              <span>Pick up the pace →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n      <!-- HYFONIC 1 -->\n      <article\n        class=\"hn-prime-card\"\n        style=\"--accent:#4361ee; --accent-rgb:67,97,238;\"\n      >\n        <a href=\"/products/hyfonic-1\" class=\"hn-prime-card__link\" aria-label=\"Shop Hyfonic 1\">\n          <div class=\"hn-prime-card__visual\">\n            <span class=\"hn-prime-card__orb\"></span>\n            <span class=\"hn-prime-card__ring\"></span>\n\n            <picture>\n              <source\n                media=\"(max-width: 749px)\"\n                srcset=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_R_e3ed8cf5-25c0-466d-8363-5aefd0c839a2.jpg?v=1769604111\"\n              >\n              <img\n                src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_1_3307e0c2-9c11-459f-abc7-711b477d21b9.jpg?v=1769604111\"\n                alt=\"Hyfonic 1 badminton racket\"\n                loading=\"lazy\"\n              >\n            </picture>\n          </div>\n\n          <div class=\"hn-prime-card__content\">\n            <div class=\"hn-prime-card__top\">\n              <span>Precision</span>\n              <small>Hyfonic 1</small>\n            </div>\n\n            <h3>Place it where they aren't.</h3>\n\n            <p>\n              Curve² geometry widens the sweet spot. Built for measured rallies and the player who's always two shots ahead.\n            </p>\n\n            <div class=\"hn-prime-card__bottom\">\n              <strong>₹1,890</strong>\n              <span>Trust the play →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-prime-deck,\n  .hn-prime-deck *,\n  .hn-prime-deck *::before,\n  .hn-prime-deck *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-prime-deck {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    padding: clamp(76px, 8vw, 122px) 20px;\n    background: #000000;\n    color: #ffffff;\n    overflow: hidden;\n    font-family: Figtree, Avenir, Montserrat, Arial, sans-serif;\n    isolation: isolate;\n  }\n\n  .hn-prime-deck__inner {\n    width: min(1480px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-prime-deck__header {\n    width: min(820px, 100%);\n    margin-bottom: clamp(34px, 5vw, 64px);\n  }\n\n  .hn-prime-deck__eyebrow {\n    margin: 0 0 14px;\n    color: rgba(255,255,255,0.52);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-deck__title {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(42px, 6vw, 88px);\n    line-height: 0.92;\n    font-weight: 950;\n    letter-spacing: -0.075em;\n  }\n\n  .hn-prime-deck__subline {\n    margin: 18px 0 0;\n    max-width: 620px;\n    color: rgba(255,255,255,0.66);\n    font-size: clamp(15px, 1.35vw, 20px);\n    line-height: 1.55;\n    font-weight: 560;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-prime-deck__cards {\n    display: grid;\n    grid-template-columns: 1.15fr 0.92fr 0.92fr;\n    gap: clamp(14px, 1.7vw, 24px);\n    min-height: 680px;\n    transition: grid-template-columns 520ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .hn-prime-deck__cards:has(.hn-prime-card:nth-child(2):hover) {\n    grid-template-columns: 0.92fr 1.15fr 0.92fr;\n  }\n\n  .hn-prime-deck__cards:has(.hn-prime-card:nth-child(3):hover) {\n    grid-template-columns: 0.92fr 0.92fr 1.15fr;\n  }\n\n  .hn-prime-card {\n    min-width: 0;\n    min-height: 680px;\n    border-radius: 34px;\n    overflow: hidden;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.018)),\n      #070707;\n    border: 1px solid rgba(255,255,255,0.105);\n    box-shadow:\n      0 34px 100px rgba(0,0,0,0.52),\n      inset 0 1px 0 rgba(255,255,255,0.07);\n    opacity: 0;\n    transform: translateY(24px);\n    transition:\n      opacity 720ms ease,\n      transform 720ms cubic-bezier(0.22, 1, 0.36, 1),\n      border-color 300ms ease,\n      box-shadow 300ms ease;\n  }\n\n  .hn-prime-card.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-prime-card:hover {\n    border-color: rgba(var(--accent-rgb), 0.5);\n    box-shadow:\n      0 42px 120px rgba(0,0,0,0.66),\n      0 0 48px rgba(var(--accent-rgb),0.15),\n      inset 0 1px 0 rgba(255,255,255,0.08);\n  }\n\n  .hn-prime-card__link {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    min-height: inherit;\n    display: flex;\n    flex-direction: column;\n    color: inherit;\n    text-decoration: none;\n    isolation: isolate;\n  }\n\n  .hn-prime-card__visual {\n    position: relative;\n    height: 58%;\n    min-height: 370px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 50% 50%, rgba(var(--accent-rgb),0.18), transparent 42%),\n      #000000;\n  }\n\n  .hn-prime-card__orb {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 72%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(var(--accent-rgb),0.26), transparent 68%);\n    filter: blur(28px);\n    opacity: 0.8;\n    transition: opacity 320ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .hn-prime-card__ring {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 62%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%) rotate(-10deg);\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.11);\n    box-shadow:\n      0 0 52px rgba(var(--accent-rgb),0.12),\n      inset 0 0 42px rgba(var(--accent-rgb),0.04);\n    opacity: 0.72;\n  }\n\n  .hn-prime-card__visual picture {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n  }\n\n  .hn-prime-card__visual img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n    filter:\n      saturate(1.1)\n      contrast(1.12)\n      brightness(0.72);\n    transform: scale(1.03);\n    transition:\n      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),\n      filter 360ms ease;\n  }\n\n  .hn-prime-card:hover .hn-prime-card__visual img {\n    transform: scale(1.08);\n    filter:\n      saturate(1.14)\n      contrast(1.15)\n      brightness(0.86);\n  }\n\n  .hn-prime-card:hover .hn-prime-card__orb {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1.08);\n  }\n\n  .hn-prime-card__content {\n    position: relative;\n    z-index: 4;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: clamp(22px, 2.2vw, 34px);\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012)),\n      #050505;\n    border-top: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .hn-prime-card__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n\n  .hn-prime-card__top span {\n    color: var(--accent);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    text-shadow: 0 0 18px rgba(var(--accent-rgb),0.35);\n  }\n\n  .hn-prime-card__top small {\n    color: rgba(255,255,255,0.5);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-card__content h3 {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(30px, 2.7vw, 48px);\n    line-height: 0.95;\n    font-weight: 950;\n    letter-spacing: -0.065em;\n    max-width: 12ch;\n  }\n\n  .hn-prime-card__content p {\n    margin: 16px 0 0;\n    max-width: 48ch;\n    color: rgba(255,255,255,0.72);\n    font-size: clamp(13px, 1vw, 15px);\n    line-height: 1.5;\n    font-weight: 560;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-prime-card__bottom {\n    margin-top: auto;\n    padding-top: 24px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n  }\n\n  .hn-prime-card__bottom strong {\n    color: rgba(255,255,255,0.76);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    white-space: nowrap;\n  }\n\n  .hn-prime-card__bottom span {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 40px;\n    padding: 0 16px;\n    border-radius: 999px;\n    border: 1px solid rgba(var(--accent-rgb),0.78);\n    color: #ffffff;\n    background: rgba(var(--accent-rgb),0.08);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    transition:\n      background 240ms ease,\n      transform 240ms ease,\n      box-shadow 240ms ease;\n  }\n\n  .hn-prime-card:hover .hn-prime-card__bottom span {\n    transform: translateY(-2px);\n    background: rgba(var(--accent-rgb),0.14);\n    box-shadow: 0 0 24px rgba(var(--accent-rgb),0.18);\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-prime-deck {\n      padding: 66px 14px 82px;\n    }\n\n    .hn-prime-deck__header {\n      margin-bottom: 28px;\n    }\n\n    .hn-prime-deck__title {\n      font-size: clamp(40px, 11vw, 58px);\n      line-height: 0.92;\n    }\n\n    .hn-prime-deck__subline {\n      font-size: 15px;\n      line-height: 1.48;\n    }\n\n    .hn-prime-deck__cards,\n    .hn-prime-deck__cards:has(.hn-prime-card:nth-child(2):hover),\n    .hn-prime-deck__cards:has(.hn-prime-card:nth-child(3):hover) {\n      display: flex;\n      grid-template-columns: none;\n      min-height: 0;\n      gap: 16px;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding: 16px;\n      padding: 0 2px 12px;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n\n    .hn-prime-deck__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-prime-card {\n      flex: 0 0 min(86vw, 390px);\n      min-height: 620px;\n      border-radius: 28px;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-prime-card__visual {\n      height: 350px;\n      min-height: 350px;\n    }\n\n    .hn-prime-card__content {\n      padding: 24px 20px;\n    }\n\n    .hn-prime-card__content h3 {\n      font-size: 34px;\n      max-width: 13ch;\n    }\n\n    .hn-prime-card__content p {\n      font-size: 14px;\n      line-height: 1.48;\n    }\n\n    .hn-prime-card__bottom {\n      flex-wrap: wrap;\n      row-gap: 14px;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-prime-card {\n      flex-basis: min(88vw, 360px);\n      min-height: 600px;\n    }\n\n    .hn-prime-card__visual {\n      height: 326px;\n      min-height: 326px;\n    }\n\n    .hn-prime-card__content h3 {\n      font-size: 31px;\n    }\n\n    .hn-prime-card__bottom span {\n      width: 100%;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-prime-card,\n    .hn-prime-card *,\n    .hn-prime-card *::before,\n    .hn-prime-card *::after {\n      transition: none !important;\n      animation: none !important;\n    }\n\n    .hn-prime-card {\n      opacity: 1 !important;\n      transform: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnPrimeDeck');\n    if (!section || section.dataset.ready === 'true') return;\n    section.dataset.ready = 'true';\n\n    var cards = section.querySelectorAll('.hn-prime-card');\n\n    if (!cards.length) return;\n\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      cards.forEach(function (card) {\n        card.classList.add('is-visible');\n      });\n      return;\n    }\n\n    var observer = new IntersectionObserver(function (entries, obs) {\n      entries.forEach(function (entry) {\n        if (!entry.isIntersecting) return;\n\n        entry.target.classList.add('is-visible');\n        obs.unobserve(entry.target);\n      });\n    }, {\n      threshold: 0.16,\n      rootMargin: '0px 0px -10% 0px'\n    });\n\n    cards.forEach(function (card, index) {\n      card.style.transitionDelay = index * 90 + 'ms';\n      observer.observe(card);\n    });\n  })();\n</script>",
