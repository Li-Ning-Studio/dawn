transparent 30%, rgba(0,0,0,0.14));\n  }\n\n  .hn-prime-card__image {\n    position: relative;\n    z-index: 3;\n    width: 100%;\n    height: 50%;\n    flex: 0 0 50%;\n    overflow: hidden;\n    border-radius: 24px;\n    background:\n      radial-gradient(circle at 50% 28%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 42%),\n      linear-gradient(145deg, rgba(255,255,255,0.09), rgba(255,255,255,0.025)),\n      rgba(255,255,255,0.025);\n    border: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .hn-prime-card__image::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(to bottom, rgba(255,255,255,0.08), transparent 34%, rgba(0,0,0,0.14)),\n      radial-gradient(circle at 50% 0%, rgba(255,255,255,0.11), transparent 40%);\n  }\n\n  .hn-prime-card__image-glow {\n    position: absolute;\n    width: 52%;\n    height: 52%;\n    left: 50%;\n    top: 52%;\n    transform: translate(-50%, -50%);\n    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 38%, transparent), transparent 68%);\n    filter: blur(32px);\n    opacity: 0.76;\n  }\n\n  .hn-prime-card__image img {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n  }\n\n  .hn-prime-card__body {\n    position: relative;\n    z-index: 4;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 24px 10px 2px;\n    color: #ffffff;\n  }\n\n  .hn-prime-card__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-bottom: 18px;\n  }\n\n  .hn-prime-card__name {\n    margin: 0;\n    color: rgba(255,255,255,0.96);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n  }\n\n  .hn-prime-card__tag {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 28px;\n    padding: 8px 12px;\n    border-radius: 999px;\n    color: #ffffff;\n    background: color-mix(in srgb, var(--accent) 38%, transparent);\n    border: 1px solid color-mix(in srgb, var(--accent) 72%, rgba(255,255,255,0.18));\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-card h3 {\n    margin: 0;\n    max-width: 96%;\n    color: rgba(255,255,255,0.98);\n    font-size: clamp(25px, 1.9vw, 34px);\n    line-height: 0.98;\n    font-weight: 900;\n    letter-spacing: -0.055em;\n    text-shadow: 0 14px 36px rgba(0,0,0,0.48);\n  }\n\n  .hn-prime-card__copy {\n    margin: 13px 0 0;\n    max-width: 94%;\n    color: rgba(255,255,255,0.75);\n    font-size: 14px;\n    line-height: 1.42;\n    font-weight: 550;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-prime-card__features {\n    display: grid;\n    gap: 10px;\n    margin: 20px 0 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .hn-prime-card__features li {\n    position: relative;\n    padding-left: 16px;\n    color: rgba(255,255,255,0.62);\n    font-size: 13px;\n    line-height: 1.38;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-prime-card__features li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0.55em;\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--accent);\n    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 70%, transparent);\n  }\n\n  .hn-prime-card__features span {\n    display: block;\n    margin-bottom: 2px;\n    color: rgba(255,255,255,0.92);\n    font-weight: 800;\n  }\n\n  .hn-prime-card__bottom {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: auto;\n    padding-top: 22px;\n  }\n\n  .hn-prime-card__price {\n    margin: 0;\n    color: #ffffff;\n    font-size: 22px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: -0.04em;\n  }\n\n  .hn-prime-card__button,\n  .hn-prime-trinity__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 42px;\n    padding: 13px 18px;\n    border-radius: 999px;\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;\n  }\n\n  .hn-prime-card__button {\n    color: #ffffff;\n    background: color-mix(in srgb, var(--accent) 30%, rgba(255,255,255,0.08));\n    border: 1px solid color-mix(in srgb, var(--accent) 65%, rgba(255,255,255,0.2));\n  }\n\n  .hn-prime-card__button:hover {\n    color: #050504;\n    background: #ffffff;\n    border-color: #ffffff;\n    transform: translateX(4px);\n  }\n\n  .hn-prime-table-wrap {\n    width: 100%;\n    margin: 34px auto 0;\n    opacity: 0;\n    transform: translateY(32px);\n    transition: opacity 0.9s ease 0.45s, transform 0.9s ease 0.45s;\n  }\n\n  .hn-prime-trinity.is-visible .hn-prime-table-wrap {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-prime-table {\n    display: grid;\n    grid-template-columns: 0.74fr repeat(3, 1fr);\n    border: 1px solid rgba(255,255,255,0.14);\n    border-radius: 26px;\n    overflow: hidden;\n    background: rgba(255,255,255,0.045);\n    box-shadow:\n      0 24px 80px rgba(0,0,0,0.28),\n      inset 0 0 0 1px rgba(255,255,255,0.05);\n    backdrop-filter: blur(18px);\n  }\n\n  .hn-prime-table__cell {\n    min-height: 72px;\n    padding: 20px 22px;\n    color: rgba(255,255,255,0.7);\n    font-size: 14px;\n    line-height: 1.35;\n    font-weight: 550;\n    letter-spacing: -0.015em;\n    border-right: 1px solid rgba(255,255,255,0.1);\n    border-bottom: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .hn-prime-table__cell:nth-child(4n) {\n    border-right: 0;\n  }\n\n  .hn-prime-table__cell:nth-last-child(-n + 4) {\n    border-bottom: 0;\n  }\n\n  .hn-prime-table__head {\n    color: #ffffff;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    font-size: 13px;\n    background: rgba(255,255,255,0.045);\n  }\n\n  .hn-prime-table__label {\n    color: rgba(255,255,255,0.92);\n    font-weight: 850;\n    background: rgba(255,255,255,0.035);\n  }\n\n  .hn-prime-trinity__cta-wrap {\n    display: flex;\n    justify-content: center;\n    margin: 34px auto 0;\n    opacity: 0;\n    transform: translateY(26px);\n    transition: opacity 0.9s ease 0.58s, transform 0.9s ease 0.58s;\n  }\n\n  .hn-prime-trinity.is-visible .hn-prime-trinity__cta-wrap {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-prime-trinity__cta {\n    color: #050504;\n    background: #ffffff;\n    border: 1px solid #ffffff;\n    box-shadow: 0 18px 48px rgba(255,255,255,0.12);\n  }\n\n  .hn-prime-trinity__cta:hover {\n    transform: translateY(-3px);\n    background: transparent;\n    color: #ffffff;\n  }\n\n  .hn-evolution-divider {\n    width: min(1040px, 100%);\n    margin: 86px auto 0;\n    text-align: center;\n    opacity: 0;\n    transform: translateY(30px);\n    transition: opacity 0.9s ease 0.72s, transform 0.9s ease 0.72s;\n  }\n\n  .hn-prime-trinity.is-visible .hn-evolution-divider {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-evolution-divider__line {\n    display: block;\n    width: 100%;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.26), transparent);\n  }\n\n  .hn-evolution-divider__content {\n    padding: 38px 0;\n  }\n\n  .hn-evolution-divider h2 {\n    margin: 0;\n    color: rgba(255,255,255,0.96);\n    font-size: clamp(34px, 4.4vw, 68px);\n    line-height: 0.98;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n  }\n\n  .hn-evolution-divider p {\n    width: min(720px, 100%);\n    margin: 16px auto 0;\n    color: rgba(255,255,255,0.64);\n    font-size: clamp(15px, 1.15vw, 17px);\n    line-height: 1.45;\n    font-weight: 520;\n    le