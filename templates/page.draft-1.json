   letter-spacing: -.018em;\n  }\n\n  .hn-duel-upgrade__scene {\n    --progress: 0;\n    --left-fade: calc(1 - (var(--progress) * .55));\n    --right-push: var(--progress);\n\n    position: relative;\n    height: 185vh;\n    background: #020303;\n  }\n\n  .hn-duel-upgrade__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 700px;\n    overflow: hidden;\n    isolation: isolate;\n    background: #020303;\n  }\n\n  .hn-duel-upgrade__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(circle at 75% 45%, var(--side-glow), transparent 38%),\n      radial-gradient(circle at 25% 45%, rgba(255,255,255,.045), transparent 32%),\n      linear-gradient(90deg, rgba(255,255,255,.035) 0%, transparent 42%, transparent 58%, rgba(255,255,255,.045) 100%),\n      linear-gradient(180deg, #020303 0%, #050706 55%, #020303 100%);\n  }\n\n  .hn-duel-upgrade__bg::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: .2;\n    background:\n      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);\n    background-size: 52px 52px;\n    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 72%);\n  }\n\n  .hn-duel-upgrade__bg::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(90deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.12) 42%, rgba(0,0,0,.12) 58%, rgba(0,0,0,.38) 100%),\n      radial-gradient(circle at 50% 50%, transparent 0%, rgba(0,0,0,.56) 76%);\n  }\n\n  .hn-duel-upgrade__split {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    height: 100%;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .hn-duel-upgrade__side {\n    position: relative;\n    height: 100%;\n    overflow: hidden;\n  }\n\n  .hn-duel-upgrade__side--prime {\n    border-right: 1px solid rgba(255,255,255,.08);\n  }\n\n  .hn-duel-upgrade__side--prime::after,\n  .hn-duel-upgrade__side--evo::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 4;\n    pointer-events: none;\n  }\n\n  .hn-duel-upgrade__side--prime::after {\n    background: rgba(0,0,0, calc(.34 + (var(--progress) * .28)));\n  }\n\n  .hn-duel-upgrade__side--evo::after {\n    background:\n      radial-gradient(circle at 50% 48%, rgba(var(--accent-rgb), calc(.06 + (var(--progress) * .14))), transparent 48%);\n  }\n\n  .hn-duel-upgrade__label {\n    position: absolute;\n    z-index: 8;\n    left: clamp(20px, 4vw, 64px);\n    top: clamp(36px, 7vh, 82px);\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    text-transform: uppercase;\n  }\n\n  .hn-duel-upgrade__label--right {\n    left: auto;\n    right: clamp(20px, 4vw, 64px);\n    text-align: right;\n    align-items: flex-end;\n  }\n\n  .hn-duel-upgrade__label span {\n    color: rgba(255,255,255,.48);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .14em;\n  }\n\n  .hn-duel-upgrade__label strong {\n    color: #fff;\n    font-size: clamp(18px, 2.2vw, 34px);\n    line-height: .95;\n    font-weight: 950;\n    letter-spacing: -.055em;\n    text-shadow: 0 12px 34px rgba(0,0,0,.78);\n  }\n\n  .hn-duel-upgrade__label--right span {\n    color: rgba(var(--accent-rgb), .9);\n  }\n\n  .hn-duel-upgrade__racket {\n    position: absolute;\n    z-index: 3;\n    display: block;\n    width: min(82vh, 760px);\n    height: auto;\n    max-width: none;\n    pointer-events: none;\n    user-select: none;\n    will-change: transform, opacity, filter;\n  }\n\n  .hn-duel-upgrade__racket--prime {\n    left: 50%;\n    top: 50%;\n    opacity: calc(.52 - (var(--progress) * .22));\n    filter: grayscale(calc(.72 + (var(--progress) * .28))) saturate(.72) contrast(.92) brightness(.76);\n    transform:\n      translate(-53%, -46%)\n      rotate(-16deg)\n      scale(calc(.82 - (var(--progress) * .055)));\n  }\n\n  .hn-duel-upgrade__racket--evo {\n    right: 50%;\n    top: 50%;\n    opacity: calc(.86 + (var(--progress) * .14));\n    filter: saturate(calc(1.08 + (var(--progress) * .38))) contrast(calc(1.06 + (var(--progress) * .18))) brightness(calc(1.02 + (var(--progress) * .18)));\n    transform:\n      translate(54%, -48%)\n      rotate(-16deg)\n      scale(calc(.94 + (var(--progress) * .14)));\n  }\n\n  .hn-duel-upgrade__divider {\n    position: absolute;\n    z-index: 12;\n    top: 0;\n    left: 50%;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%);\n    background: rgba(255,255,255,.14);\n  }\n\n  .hn-duel-upgrade__divider span {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 3px;\n    height: calc(22vh + (var(--progress) * 58vh));\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(var(--accent-rgb), .2),\n      var(--accent),\n      rgba(255,255,255,.9),\n      var(--accent),\n      rgba(var(--accent-rgb), .2),\n      transparent\n    );\n    box-shadow:\n      0 0 22px rgba(var(--accent-rgb), .72),\n      0 0 48px rgba(var(--accent-rgb), .38);\n  }\n\n  .hn-duel-upgrade__center-copy {\n    position: absolute;\n    z-index: 15;\n    left: 50%;\n    top: 50%;\n    width: min(520px, calc(100% - 40px));\n    transform:\n      translate(-50%, -50%)\n      scale(calc(.96 + (var(--progress) * .04)));\n    text-align: center;\n    pointer-events: none;\n  }\n\n  .hn-duel-upgrade__center-copy p {\n    margin: 0 0 12px;\n    color: var(--accent);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    text-shadow:\n      0 0 18px rgba(var(--accent-rgb), .58),\n      0 10px 30px rgba(0,0,0,.9);\n  }\n\n  .hn-duel-upgrade__center-copy h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(42px, 5.6vw, 92px);\n    line-height: .88;\n    font-weight: 950;\n    letter-spacing: -.075em;\n    text-shadow:\n      0 0 28px rgba(255,255,255,.12),\n      0 18px 50px rgba(0,0,0,.92);\n  }\n\n  .hn-duel-upgrade__center-copy small {\n    display: block;\n    width: min(360px, 100%);\n    margin: 18px auto 0;\n    color: rgba(255,255,255,.8);\n    font-size: clamp(13px, 1vw, 15px);\n    line-height: 1.45;\n    font-weight: 700;\n    letter-spacing: -.015em;\n    text-shadow: 0 10px 28px rgba(0,0,0,.9);\n  }\n\n  .hn-duel-upgrade__bottom {\n    position: absolute;\n    z-index: 20;\n    left: 50%;\n    bottom: clamp(26px, 5vh, 58px);\n    width: min(1120px, calc(100% - 36px));\n    transform: translateX(-50%);\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n    gap: 20px;\n    padding: 14px 16px;\n    border: 1px solid rgba(255,255,255,.12);\n    border-radius: 999px;\n    background: rgba(0,0,0,.34);\n    backdrop-filter: blur(18px);\n    box-shadow:\n      0 20px 60px rgba(0,0,0,.36),\n      inset 0 0 0 1px rgba(255,255,255,.04);\n  }\n\n  .hn-duel-upgrade__bottom div {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n  }\n\n  .hn-duel-upgrade__bottom div:last-child {\n    text-align: right;\n    align-items: flex-end;\n  }\n\n  .hn-duel-upgrade__bottom span {\n    color: rgba(255,255,255,.48);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .hn-duel-upgrade__bottom strong {\n    color: rgba(255,255,255,.92);\n    font-size: clamp(12px, 1vw, 15px);\n    line-height: 1.1;\n    font-weight: 850;\n    letter-spacing: -.02em;\n  }\n\n  .hn-duel-upgrade__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 46px;\n    padding: 0 22px;\n    border-radius: 999px;\n    border: 1.5px solid transparent;\n    background:\n      linear-gradient(#050505, #050505) padding-box,\n      linear-gradient(90deg, rgba(255,255,255,.42), var(--accent), rgba(255,255,255,.42)) border-box;\n    color: #fff;\n    text-decoration: none;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    box-shadow:\n      0 0 24px rgba(var(--accent-rgb), .24),\n      inset 0 0 0 1px rgba(var(--accent-rgb), .08);\n    transition: transform .25s ease, box-shadow .25s ease, color .25s ease;\n  }\n\n  .hn-duel-upgrade__cta span {\n    color: var(--accent);\n    transition: transform .25s ease;\n  }\n\n  .hn-duel-upgrade__cta:hover {\n    transform: translateY(-2px);\n    color: #fff;\n    box-shadow:\n      0 0 34px rgba(var(--accent-rgb), .42),\n      inset 0 0 0 1px rgba(var(--accent-rgb), .16);\n  }\n\n  .hn-duel-upgrade__cta:hover span {\n    transform: translateX(4px);\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-duel-upgrade__intro {\n      min-height: 52vh;\n      padding: 76px 18px 56px;\n    }\n\n    .hn-duel-upgrade__scene {\n      height: 170svh;\n    }\n\n    .hn-duel-upgrade__sticky {\n      height: 100svh;\n      min-height: 690px;\n    }\n\n    .hn-duel-upgrade__split {\n      grid-template-columns: 1fr;\n      grid-template-rows: 1fr 1fr;\n    }\n\n    .hn-duel-upgrade__side--prime {\n      border-right: 0;\n      border-bottom: 1px solid rgba(255,255,255,.08);\n    }\n\n    .hn-duel-upgrade__divider {\n      top: 50%;\n      left: 0;\n      width: 100%;\n      height: 1px;\n      transform: translateY(-50%);\n    }\n\n    .hn-duel-upgrade__divider span {\n      top: 50%;\n      left: 50%;\n      width: calc(28vw + (var(--progress) * 54vw));\n      height: 3px;\n      transform: translate(-50%, -50%);\n      background: linear-gradient(\n        90deg,\n        transparent,\n        rgba(var(--accent-rgb), .2),\n        var(--accent),\n        rgba(255,255,255,.9),\n        var(--accent),\n        rgba(var(--accent-rgb), .2),\n        transparent\n      );\n    }\n\n    .hn-duel-upgrade__label {\n      left: 18px;\n      top: 22px;\n    }\n\n    .hn-duel-upgrade__label--right {\n      top: auto;\n      right: 18px;\n      bottom: 108px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(68vw, 430px);\n    }\n\n    .hn-duel-upgrade__racket--prime {\n      left: 50%;\n      top: 24%;\n      transform:\n        translate(-52%, -50%)\n        rotate(-18deg)\n        scale(calc(.78 - (var(--progress) * .05)));\n    }\n\n    .hn-duel-upgrade__racket--evo {\n      right: auto;\n      left: 50%;\n      top: 72%;\n      transform:\n        translate(-48%, -50%)\n        rotate(-18deg)\n        scale(calc(.9 + (var(--progress) * .12)));\n    }\n\n    .hn-duel-upgrade__center-copy {\n      top: 50%;\n      width: min(360px, calc(100% - 34px));\n      padding: 16px 14px 18px;\n      border: 1px solid rgba(255,255,255,.1);\n      border-radius: 26px;\n      background: rgba(0,0,0,.36);\n      backdrop-filter: blur(16px);\n    }\n\n    .hn-duel-upgrade__center-copy h3 {\n      font-size: clamp(34px, 10vw, 48px);\n    }\n\n    .hn-duel-upgrade__center-copy small {\n      margin-top: 12px;\n      font-size: 12px;\n    }\n\n    .hn-duel-upgrade__bottom {\n      width: calc(100% - 28px);\n      grid-template-columns: 1fr;\n      gap: 12px;\n      border-radius: 24px;\n      padding: 14px;\n      bottom: 16px;\n      text-align: center;\n    }\n\n    .hn-duel-upgrade__bottom div,\n    .hn-duel-upgrade__bottom div:last-child {\n      text-align: center;\n      align-items: center;\n    }\n\n    .hn-duel-upgrade__cta {\n      width: 100%;\n      min-height: 46px;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-duel-upgrade__sticky {\n      min-height: 650px;\n    }\n\n    .hn-duel-upgrade__racket {\n      width: min(78vw, 390px);\n    }\n\n    .hn-duel-upgrade__label strong {\n      font-size: 20px;\n    }\n\n    .hn-duel-upgrade__bottom strong {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnDuelUpgrade');\n    if (!section || section.dataset.hnDuelReady === 'true') return;\n\n    section.dataset.hnDuelReady = 'true';\n\n    var scenes = Array.prototype.slice.call(section.querySelectorAll('[data-duel-scene]'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeInOutSine(x) {\n      return -(Math.cos(Math.PI * x) - 1) / 2;\n    }\n\n    function updateScenes() {\n      var vh = window.innerHeight || document.documentElement.clientHeight;\n\n      scenes.forEach(function (scene) {\n        var rect = scene.getBoundingClientRect();\n        var total = Math.max(rect.height - vh, 1);\n        var progress = clamp(-rect.top / total, 0, 1);\n        var eased = easeInOutSine(progress);\n\n        scene.style.setProperty('--progress', eased.toFixed(3));\n      });\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateScenes);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    updateScenes();\n  })();\n</script>",
