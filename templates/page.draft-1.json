ansform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-panel--right span {\n    left: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-line {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%) scaleY(calc(1 - (var(--unlock) * 0.92)));\n    transform-origin: center;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(255,255,255,0.12),\n      #19b84a,\n      #1f7ed8,\n      #6f42d8,\n      #ff3b24,\n      rgba(255,255,255,0.12),\n      transparent\n    );\n    box-shadow:\n      0 0 18px rgba(255,255,255,0.12),\n      0 0 44px rgba(31,126,216,0.16);\n  }\n\n  .hn-member-access__gate-light {\n    position: absolute;\n    z-index: 8;\n    left: -28%;\n    top: 0;\n    width: 24%;\n    height: 100%;\n    transform: translateX(calc(var(--unlock) * 530%)) skewX(-15deg);\n    opacity: calc(0.015 + (var(--unlock) * 0.3));\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);\n    filter: blur(12px);\n  }\n\n  .hn-member-access__lock {\n    position: absolute;\n    z-index: 12;\n    left: 50%;\n    top: 50%;\n    width: min(480px, calc(100% - 44px));\n    transform: translate(-50%, -50%) scale(calc(1 - (var(--unlock) * 0.14)));\n    opacity: calc(1 - (var(--unlock) * 1.15));\n    text-align: center;\n    pointer-events: auto;\n  }\n\n  .hn-member-access__lock-mark {\n    position: relative;\n    width: 112px;\n    height: 112px;\n    margin: 0 auto 24px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.12);\n    background:\n      radial-gradient(circle, rgba(255,255,255,0.055), transparent 44%),\n      #000000;\n    box-shadow:\n      0 0 36px rgba(255,255,255,0.04),\n      inset 0 0 0 1px rgba(255,255,255,0.035);\n  }\n\n  .hn-member-access__lock-mark::before,\n  .hn-member-access__lock-mark::after {\n    content: \"\";\n    position: absolute;\n    border-radius: 999px;\n    pointer-e