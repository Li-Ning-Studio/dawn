    "custom_liquid_EpQTLb": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD CURSOR SPOTLIGHT SERIES SELECTOR\n  Paste this complete block inside a Shopify Custom Liquid section.\n\n  Notes:\n  - Desktop: spotlight follows the cursor and activates the nearest series name.\n  - Mobile/tablet: tap a series name to reveal its lineup.\n  - Replace image URLs in --image:url('') if desired.\n{% endcomment %}\n\n{% assign hcs_id = section.id | default: 'hndrd-cursor-spotlight' %}\n\n<section id=\"hcs-{{ hcs_id }}\" class=\"hcs\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hcs__spotlight\" aria-hidden=\"true\"></div>\n  <div class=\"hcs__grain\" aria-hidden=\"true\"></div>\n\n  <div class=\"hcs__layout\">\n    <div class=\"hcs__left\">\n      <div class=\"hcs__header\">\n        <p class=\"hcs__eyebrow\">HNDRD RACKET SERIES</p>\n        <p class=\"hcs__instruction\">Move through the dark.</p>\n      </div>\n\n      <div class=\"hcs__names\" role=\"list\">\n        <button\n          class=\"hcs__name is-active\"\n          type=\"button\"\n          data-series=\"pro\"\n          aria-pressed=\"true\"\n        >\n          <span class=\"hcs__number\">01</span>\n          <span class=\"hcs__label\">Pro Series</span>\n        </button>\n\n        <button\n          class=\"hcs__name\"\n          type=\"button\"\n          data-series=\"prime\"\n          aria-pressed=\"false\"\n        >\n          <span class=\"hcs__number\">02</span>\n          <span class=\"hcs__label\">Prime Trinity</span>\n        </button>\n\n        <button\n          class=\"hcs__name\"\n          type=\"button\"\n          data-series=\"evolution\"\n          aria-pressed=\"false\"\n        >\n          <span class=\"hcs__number\">03</span>\n          <span class=\"hcs__label\">Evolution Series</span>\n        </button>\n      </div>\n\n      <div class=\"hcs__footer-note\">\n        <span>THREE SYSTEMS</span>\n        <span>ONE STANDARD</span>\n      </div>\n    </div>\n\n    <aside class=\"hcs__panel\" aria-live=\"polite\">\n      <div class=\"hcs__panel-inner\">\n        <div class=\"hcs__panel-top\">\n          <span class=\"hcs__panel-index\">01 / 03</span>\n          <span class=\"hcs__panel-tag\">PERFORMANCE</span>\n        </div>\n\n        <div class=\"hcs__visual\" style=\"--image:url('');\">\n          <div class=\"hcs__visual-word\">PRO</div>\n        </div>\n\n        <div class=\"hcs__panel-copy\">\n          <p class=\"hcs__kicker\">Built for the highest level</p>\n          <h2 class=\"hcs__title\">Pro Series</h2>\n\n          <ul class=\"hcs__lineup\">\n            <li>Nitrix 70 Venom</li>\n            <li>Nitrix 70 Volta</li>\n            <li>Hyfonic 7</li>\n            <li>Flareon 700</li>\n          </ul>\n\n          <a class=\"hcs__cta\" href=\"https://in.hndrd.co/pages/pro-series-rackets\">\n            <span>Explore Pro Series</span>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n    </aside>\n  </div>\n</section>\n\n<style>\n  #hcs-{{ hcs_id }} {\n    --bg: #050505;\n    --panel: rgba(255,255,255,.035);\n    --line: rgba(255,255,255,.12);\n    --muted: rgba(255,255,255,.46);\n    --soft: rgba(255,255,255,.74);\n    --spot-x: 28%;\n    --spot-y: 50%;\n    --ease: cubic-bezier(.2,.75,.2,1);\n    position: relative;\n    min-height: min(820px, 92vh);\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 50% 120%, rgba(255,255,255,.035), transparent 36%),\n      var(--bg);\n    color: #fff;\n    font-family: Figtree, Arial, sans-serif;\n  }\n\n  #hcs-{{ hcs_id }} *,\n  #hcs-{{ hcs_id }} *::before,\n  #hcs-{{ hcs_id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__spotlight {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background:\n      radial-gradient(\n        circle 220px at var(--spot-x) var(--spot-y),\n        rgba(255,255,255,.17) 0%,\n        rgba(255,255,255,.09) 24%,\n        rgba(255,255,255,.035) 48%,\n        transparent 72%\n      );\n    mix-blend-mode: screen;\n    transition: opacity .25s ease;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__grain {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    opacity: .06;\n    background-image:\n      linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);\n    background-size: 4px 4px, 4px 4px;\n    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__layout {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: minmax(0, 1.4fr) minmax(360px, .7fr);\n    min-height: inherit;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__left {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: clamp(30px, 4vw, 66px);\n    border-right: 1px solid var(--line);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__eyebrow,\n  #hcs-{{ hcs_id }} .hcs__instruction,\n  #hcs-{{ hcs_id }} .hcs__footer-note,\n  #hcs-{{ hcs_id }} .hcs__panel-top {\n    margin: 0;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__eyebrow {\n    color: rgba(255,255,255,.78);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__instruction {\n    color: var(--muted);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__names {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(8px, 1.2vw, 18px);\n    margin: auto 0;\n    padding: clamp(40px, 8vh, 88px) 0;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__name {\n    position: relative;\n    display: grid;\n    grid-template-columns: 48px minmax(0,1fr);\n    align-items: baseline;\n    width: 100%;\n    padding: 4px 0 10px;\n    border: 0;\n    background: transparent;\n    color: rgba(255,255,255,.18);\n    text-align: left;\n    cursor: pointer;\n    transition: color .45s var(--ease), transform .45s var(--ease);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__name::after {\n    content: \"\";\n    position: absolute;\n    left: 48px;\n    right: 0;\n    bottom: 0;\n    height: 1px;\n    background: linear-gradient(90deg, rgba(255,255,255,.5), transparent 42%);\n    transform: scaleX(0);\n    transform-origin: left;\n    opacity: 0;\n    transition: transform .55s var(--ease), opacity .4s ease;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__number {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    color: var(--muted);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__label {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(58px, 8.6vw, 146px);\n    font-weight: 400;\n    line-height: .88;\n    letter-spacing: -.055em;\n    white-space: nowrap;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__name.is-active {\n    color: #fff;\n    transform: translateX(8px);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__name.is-active::after {\n    transform: scaleX(1);\n    opacity: 1;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__footer-note {\n    display: flex;\n    justify-content: space-between;\n    color: var(--muted);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel {\n    position: relative;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.018), rgba(255,255,255,.045)),\n      rgba(255,255,255,.012);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(90deg, rgba(255,255,255,.04), transparent 18%),\n      radial-gradient(circle at 85% 10%, rgba(255,255,255,.055), transparent 26%);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel-inner {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    flex-direction: column;\n    min-height: 100%;\n    padding: clamp(28px, 3.4vw, 54px);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel-top {\n    display: flex;\n    justify-content: space-between;\n    gap: 16px;\n    color: var(--muted);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__visual {\n    position: relative;\n    min-height: 250px;\n    margin: clamp(32px, 5vh, 58px) 0 28px;\n    overflow: hidden;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    background:\n      linear-gradient(180deg, rgba(5,5,5,.2), rgba(5,5,5,.82)),\n      var(--image),\n      radial-gradient(circle at 50% 35%, rgba(255,255,255,.08), transparent 42%);\n    background-size: cover;\n    background-position: center;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__visual::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(110deg, transparent 0 35%, rgba(255,255,255,.08) 46%, transparent 56%),\n      linear-gradient(180deg, transparent, rgba(0,0,0,.58));\n    transform: translateX(-28%);\n    transition: transform 1s var(--ease);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel.is-changing .hcs__visual::before {\n    transform: translateX(28%);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__visual-word {\n    position: absolute;\n    left: -6px;\n    bottom: -18px;\n    font-size: clamp(110px, 15vw, 230px);\n    font-weight: 800;\n    line-height: .72;\n    letter-spacing: -.08em;\n    color: rgba(255,255,255,.055);\n    pointer-events: none;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel-copy {\n    margin-top: auto;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__kicker {\n    margin: 0 0 10px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    color: var(--soft);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__title {\n    margin: 0;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(42px, 4.6vw, 72px);\n    line-height: .95;\n    letter-spacing: -.045em;\n    font-weight: 400;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__lineup {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px 18px;\n    margin: 26px 0 28px;\n    padding: 0;\n    list-style: none;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__lineup li {\n    position: relative;\n    padding-left: 12px;\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: .02em;\n    color: rgba(255,255,255,.7);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__lineup li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: .58em;\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: rgba(255,255,255,.72);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 18px;\n    min-height: 48px;\n    padding: 0 8px 0 18px;\n    border: 1px solid rgba(255,255,255,.36);\n    border-radius: 999px;\n    color: #fff;\n    text-decoration: none;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .075em;\n    text-transform: uppercase;\n    transition: background .3s ease, color .3s ease, border-color .3s ease;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__cta svg {\n    width: 32px;\n    height: 32px;\n    padding: 8px;\n    border-radius: 50%;\n    background: #fff;\n    color: #050505;\n    transition: transform .35s var(--ease);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__cta path {\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__cta:hover {\n    background: #fff;\n    border-color: #fff;\n    color: #050505;\n  }\n\n  #hcs-{{ hcs_id }} .hcs__cta:hover svg {\n    transform: translateX(3px);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel-copy,\n  #hcs-{{ hcs_id }} .hcs__visual,\n  #hcs-{{ hcs_id }} .hcs__panel-top {\n    transition: opacity .24s ease, transform .45s var(--ease);\n  }\n\n  #hcs-{{ hcs_id }} .hcs__panel.is-changing .hcs__panel-copy,\n  #hcs-{{ hcs_id }} .hcs__panel.is-changing .hcs__visual,\n  #hcs-{{ hcs_id }} .hcs__panel.is-changing .hcs__panel-top {\n    opacity: 0;\n    transform: translateY(12px);\n  }\n\n  @media (max-width: 1099px) {\n    #hcs-{{ hcs_id }} {\n      min-height: auto;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__layout {\n      grid-template-columns: 1fr;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__left {\n      min-height: auto;\n      padding: 34px 20px 26px;\n      border-right: 0;\n      border-bottom: 1px solid var(--line);\n    }\n\n    #hcs-{{ hcs_id }} .hcs__instruction {\n      display: none;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__names {\n      gap: 0;\n      margin: 34px 0 18px;\n      padding: 0;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__name {\n      grid-template-columns: 34px 1fr;\n      padding: 14px 0 16px;\n      border-bottom: 1px solid rgba(255,255,255,.08);\n    }\n\n    #hcs-{{ hcs_id }} .hcs__name::after {\n      left: 34px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__label {\n      font-size: clamp(42px, 10vw, 74px);\n      white-space: normal;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__footer-note {\n      display: none;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__panel-inner {\n      padding: 26px 20px 34px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__visual {\n      min-height: 220px;\n      margin: 26px 0 24px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__spotlight {\n      opacity: 0;\n    }\n  }\n\n  @media (max-width: 560px) {\n    #hcs-{{ hcs_id }} .hcs__header {\n      display: block;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__name {\n      transform: none;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__name.is-active {\n      transform: translateX(4px);\n    }\n\n    #hcs-{{ hcs_id }} .hcs__label {\n      font-size: clamp(38px, 12vw, 58px);\n    }\n\n    #hcs-{{ hcs_id }} .hcs__panel-top {\n      font-size: 8px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__visual {\n      min-height: 190px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__title {\n      font-size: 48px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__lineup {\n      grid-template-columns: 1fr;\n      gap: 9px;\n    }\n\n    #hcs-{{ hcs_id }} .hcs__cta {\n      width: 100%;\n      justify-content: space-between;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hcs-{{ hcs_id }} *,\n    #hcs-{{ hcs_id }} *::before,\n    #hcs-{{ hcs_id }} *::after {\n      transition-duration: .01ms !important;\n      animation-duration: .01ms !important;\n      animation-iteration-count: 1 !important;\n      scroll-behavior: auto !important;\n    }\n  }\n</style>\n\n<script>\n(() => {\n  const root = document.getElementById('hcs-{{ hcs_id }}');\n  if (!root || root.dataset.ready === 'true') return;\n  root.dataset.ready = 'true';\n\n  const panel = root.querySelector('.hcs__panel');\n  const names = [...root.querySelectorAll('.hcs__name')];\n  const desktopQuery = window.matchMedia('(hover:hover) and (pointer:fine) and (min-width:1100px)');\n\n  const series = {\n    pro: {\n      index: '01 / 03',\n      tag: 'PERFORMANCE',\n      kicker: 'Built for the highest level',\n      title: 'Pro Series',\n      visual: 'PRO',\n      image: '',\n      href: 'https://in.hndrd.co/pages/pro-series-rackets',\n      cta: 'Explore Pro Series',\n      rackets: ['Nitrix 70 Venom', 'Nitrix 70 Volta', 'Hyfonic 7', 'Flareon 700']\n    },\n    prime: {\n      index: '02 / 03',\n      tag: 'THREE PERSONALITIES',\n      kicker: 'One game. Three expressions.',\n      title: 'Prime Trinity',\n      visual: 'III',\n      image: '',\n      href: 'https://in.hndrd.co/pages/the-prime-trinity',\n      cta: 'Explore Prime Trinity',\n      rackets: ['Nitrix 10', 'Flareon 100', 'Hyfonic 1']\n    },\n    evolution: {\n      index: '03 / 03',\n      tag: 'ATTACK. SPEED. PRECISION.',\n      kicker: 'Three distinct expressions',\n      title: 'Evolution Series',\n      visual: 'EVO',\n      image: '',\n      href: 'https://in.hndrd.co/pages/pro-series',\n      cta: 'Explore Evolution Series',\n      rackets: ['Nitrix Thunder', 'Flareon Typhoon', 'Hyfonic Lazer']\n    }\n  };\n\n  let activeKey = 'pro';\n  let changeTimer;\n\n  const render = (key) => {\n    if (!series[key] || key === activeKey) return;\n    activeKey = key;\n    const data = series[key];\n\n    names.forEach((name) => {\n      const active = name.dataset.series === key;\n      name.classList.toggle('is-active', active);\n      name.setAttribute('aria-pressed', String(active));\n    });\n\n    panel.classList.add('is-changing');\n    clearTimeout(changeTimer);\n\n    changeTimer = setTimeout(() => {\n      panel.querySelector('.hcs__panel-index').textContent = data.index;\n      panel.querySelector('.hcs__panel-tag').textContent = data.tag;\n      panel.querySelector('.hcs__kicker').textContent = data.kicker;\n      panel.querySelector('.hcs__title').textContent = data.title;\n      panel.querySelector('.hcs__visual-word').textContent = data.visual;\n\n      const visual = panel.querySelector('.hcs__visual');\n      visual.style.setProperty('--image', data.image ? `url(\"${data.image}\")` : 'url(\"\")');\n\n      const list = panel.querySelector('.hcs__lineup');\n      list.innerHTML = data.rackets.map(name => `<li>${name}</li>`).join('');\n\n      const cta = panel.querySelector('.hcs__cta');\n      cta.href = data.href;\n      cta.querySelector('span').textContent = data.cta;\n\n      requestAnimationFrame(() => panel.classList.remove('is-changing'));\n    }, 180);\n  };\n\n  const activateNearestName = (clientY) => {\n    if (!desktopQuery.matches) return;\n\n    let nearest = null;\n    let nearestDistance = Infinity;\n\n    names.forEach((name) => {\n      const rect = name.getBoundingClientRect();\n      const center = rect.top + rect.height / 2;\n      const distance = Math.abs(clientY - center);\n\n      if (distance < nearestDistance) {\n        nearestDistance = distance;\n        nearest = name;\n      }\n    });\n\n    if (nearest && nearestDistance < 120) {\n      render(nearest.dataset.series);\n    }\n  };\n\n  root.addEventListener('pointermove', (event) => {\n    if (!desktopQuery.matches) return;\n\n    const rect = root.getBoundingClientRect();\n    root.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);\n    root.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);\n\n    activateNearestName(event.clientY);\n  });\n\n  names.forEach((name) => {\n    name.addEventListener('click', () => render(name.dataset.series));\n\n    name.addEventListener('mouseenter', () => {\n      if (desktopQuery.matches) render(name.dataset.series);\n    });\n  });\n})();\n</script>",
