        "custom_liquid": "<section class=\"hn-duel-upgrade\" id=\"hnDuelUpgrade\" aria-label=\"Prime Trinity to Evolution Series upgrade comparison\">\n\n  <div class=\"hn-duel-upgrade__intro\">\n    <p class=\"hn-duel-upgrade__eyebrow\">Prime Trinity → Evolution Series</p>\n    <h2 class=\"hn-duel-upgrade__main-title\">Same game. New gear ceiling.</h2>\n    <p class=\"hn-duel-upgrade__main-copy\">\n      Three familiar playing styles, rebuilt with sharper speed, heavier response, and cleaner control.\n    </p>\n  </div>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--attack\"\n    data-duel-scene\n    style=\"\n      --accent: #dba20f;\n      --accent-rgb: 219, 162, 15;\n      --side-glow: rgba(219, 162, 15, 0.26);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Nitrix 10</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_fe068018-61b0-4d27-a662-e5df945e4492.png?v=1769778461&width=1200\"\n            alt=\"Nitrix 10 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Nitrix Thunder</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1200\"\n            alt=\"Nitrix Thunder racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__divider\">\n          <span></span>\n        </div>\n\n        <div class=\"hn-duel-upgrade__center-copy\">\n          <p>Attack DNA</p>\n          <h3>Same DNA.<br>More everything.</h3>\n          <small>From quick attacking power to a heavier, cleaner strike.</small>\n        </div>\n      </div>\n\n      <div class=\"hn-duel-upgrade__bottom\">\n        <div>\n          <span>Prime feel</span>\n          <strong>Fast attacking base</strong>\n        </div>\n\n        <a href=\"/products/nitrix-thunder\" class=\"hn-duel-upgrade__cta\">\n          Upgrade to Thunder\n          <span>→</span>\n        </a>\n\n        <div>\n          <span>Evolution gain</span>\n          <strong>32 LBS / Head Heavy / Attack</strong>\n        </div>\n      </div>\n    </div>\n  </article>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--speed\"\n    data-duel-scene\n    style=\"\n      --accent: #2d9fa7;\n      --accent-rgb: 45, 159, 167;\n      --side-glow: rgba(45, 159, 167, 0.26);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Flareon 100</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/Template-01_b87a1cf0-54d3-4771-8cd9-7012109a497c.png?v=1768643121&width=1200\"\n            alt=\"Flareon 100 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Flareon Typhoon</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1200\"\n            alt=\"Flareon Typhoon racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__divider\">\n          <span></span>\n        </div>\n\n        <div class=\"hn-duel-upgrade__center-copy\">\n          <p>Speed DNA</p>\n          <h3>Same DNA.<br>More everything.</h3>\n          <small>From fast handling to storm-level reaction speed.</small>\n        </div>\n      </div>\n\n      <div class=\"hn-duel-upgrade__bottom\">\n        <div>\n          <span>Prime feel</span>\n          <strong>Quick swing control</strong>\n        </div>\n\n        <a href=\"/products/flareon-typhoon\" class=\"hn-duel-upgrade__cta\">\n          Upgrade to Typhoon\n          <span>→</span>\n        </a>\n\n        <div>\n          <span>Evolution gain</span>\n          <strong>32 LBS / Head Light / Speed</strong>\n        </div>\n      </div>\n    </div>\n  </article>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--precision\"\n    data-duel-scene\n    style=\"\n      --accent: #0c8642;\n      --accent-rgb: 12, 134, 66;\n      --side-glow: rgba(12, 134, 66, 0.28);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Hyfonic 1</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/Template-01_b406d4ea-171b-462e-9c87-9232e1399947.png?v=1768642309&width=1200\"\n            alt=\"Hyfonic 1 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Hyfonic Lazer</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_4e02ab1d-f883-4e7b-aa23-f35a0808d797.png?v=1761629738&width=1200\"\n            alt=\"Hyfonic Lazer racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__divider\">\n          <span></span>\n        </div>\n\n        <div class=\"hn-duel-upgrade__center-copy\">\n          <p>Precision DNA</p>\n          <h3>Same DNA.<br>More everything.</h3>\n          <small>From clean placement to sharper, more intentional control.</small>\n        </div>\n      </div>\n\n      <div class=\"hn-duel-upgrade__bottom\">\n        <div>\n          <span>Prime feel</span>\n          <strong>Stable shot placement</strong>\n        </div>\n\n        <a href=\"/products/hyfonic-lazer-4u\" class=\"hn-duel-upgrade__cta\">\n          Upgrade to Lazer\n          <span>→</span>\n        </a>\n\n        <div>\n          <span>Evolution gain</span>\n          <strong>32 LBS / Curve² / Control</strong>\n        </div>\n      </div>\n    </div>\n  </article>\n\n</section>\n\n<style>\n  .hn-duel-upgrade,\n  .hn-duel-upgrade *,\n  .hn-duel-upgrade *::before,\n  .hn-duel-upgrade *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-duel-upgrade {\n    position: relative;\n    width: 100%;\n    background: #020303;\n    color: #fff;\n    overflow: clip;\n    font-family: inherit;\n  }\n\n  .hn-duel-upgrade__intro {\n    position: relative;\n    z-index: 3;\n    min-height: 58vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    padding: 90px 18px 70px;\n    text-align: center;\n    background:\n      radial-gradient(circle at 50% 0%, rgba(45,159,167,.18), transparent 34%),\n      radial-gradient(circle at 28% 20%, rgba(219,162,15,.13), transparent 32%),\n      radial-gradient(circle at 72% 20%, rgba(12,134,66,.14), transparent 34%),\n      linear-gradient(180deg, #020303 0%, #050706 100%);\n  }\n\n  .hn-duel-upgrade__intro::after {\n    content: \"\";\n    position: absolute;\n    inset: auto 50% 0;\n    width: min(760px, 86vw);\n    height: 1px;\n    transform: translateX(-50%);\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,.36), transparent);\n  }\n\n  .hn-duel-upgrade__eyebrow {\n    margin: 0 0 14px;\n    color: rgba(255,255,255,.78);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .hn-duel-upgrade__main-title {\n    margin: 0;\n    max-width: 980px;\n    font-size: clamp(42px, 7.6vw, 112px);\n    line-height: .9;\n    font-weight: 950;\n    letter-spacing: -.075em;\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #2d9fa7 54%,\n      #0c8642 100%\n    );\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    filter: drop-shadow(0 18px 46px rgba(0,0,0,.56));\n  }\n\n  .hn-duel-upgrade__main-copy {\n    width: min(660px, 100%);\n    margin: 20px auto 0;\n    color: rgba(255,255,255,.82);\n    font-size: clamp(15px, 1.25vw, 19px);\n    line-height: 1.45;\n    font-weight: 650;\n 