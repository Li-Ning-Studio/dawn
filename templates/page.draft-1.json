t(circle, rgba(31, 210, 159, 0.18), rgba(219, 162, 15, 0.08) 38%, transparent 70%);\n    filter: blur(46px);\n    opacity: 0.76;\n    animation: hnVersionGlow 5s ease-in-out infinite;\n  }\n\n  .hn-version-cards__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1460px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-version-cards__heading-wrap {\n    width: 100%;\n    text-align: center;\n    margin: 0 auto 34px;\n  }\n\n  /*\n    Same class of bug can hit this gradient heading too, since its\n    ancestor sticky wrapper is also being transformed via JS on\n    scroll. Pre-emptively isolate it the same way.\n  */\n  .hn-version-cards__heading {\n    margin: 0 auto;\n    max-width: 100%;\n    white-space: nowrap;\n    font-size: clamp(34px, 4.6vw, 64px);\n    line-height: 0.95;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    );\n    background-size: 120% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    text-shadow: 0 18px 42px rgba(0,0,0,0.42);\n    opacity: 0;\n    transform: translateY(28px) scale(0.98);\n    isolation: isolate;\n    -webkit-backface-visibility: hidden;\n    backface-visibility: hidden;\n    will-change: opacity, transform;\n  }\n\n  .hn-version-cards__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 24px;\n    width: 100%;\n    perspective: 1400px;\n  }\n\n  .hn-version-cards__card {\n    --card-show: 0;\n    --content-show: 0;\n\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    aspect-ratio: 3 / 4;\n    min-height: 560px;\n    overflow: hidden;\n    border-radius: 34px;\n    padding: 18px;\n    background:\n      linear-gradient(145deg, rgba(255,255,255,0.12), rgba(255,255,255,0.035)),\n      rgba(8, 10, 9, 0.96)