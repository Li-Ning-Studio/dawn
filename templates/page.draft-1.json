t-size: 12px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    opacity: var(--content-show);\n    transform: translateY(calc((1 - var(--content-show)) * 16px));\n    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;\n  }\n\n  .hn-version-cards__button span {\n    font-size: 14px;\n    line-height: 1;\n  }\n\n  .hn-version-cards__button:hover {\n    background: #ffffff;\n    color: #050504;\n    border-color: #ffffff;\n    transform: translateX(4px) !important;\n  }\n\n  @keyframes hnFightPulse {\n    0%, 100% {\n      opacity: 0.65;\n      transform: translate(-50%, -50%) scale(0.94);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @keyframes hnFightScroll {\n    0%, 100% {\n      transform: translateY(0);\n      opacity: 0.72;\n    }\n\n    50% {\n      transform: translateY(7px);\n      opacity: 1;\n    }\n  }\n\n  @keyframes hnVersionGlow {\n    0%, 100% {\n      opacity: 0.52;\n      transform: translate(-50%, -50%) scale(0.95);\n    }\n\n    50% {\n      opacity: 0.9;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-version-cards {\n      height: auto;\n      padding: 76px 0 86px;\n      overflow: hidden;\n    }\n\n    .hn-version-cards__sticky {\n      position: relative;\n      height: auto;\n      min-height: unset;\n      padding: 0;\n      overflow: visible;\n      display: block;\n    }\n\n    .hn-version-cards__inner {\n      width: 100%;\n    }\n\n    .hn-version-cards__heading-wrap {\n      margin-bottom: 28px;\n      padding: 0 16px;\n      overflow: hidden;\n    }\n\n    .hn-version-cards__heading {\n      white-space: nowrap;\n      font-size: clamp(21px, 6vw, 32px);\n      line-height: 1;\n      letter-spacing: -0.055em;\n      opacity: 1;\n      transform: none;\n    }\n\n    .hn-version-cards__grid {\n      display: flex;\n      grid-template-columns: none;\n      gap: 16px;\n      width: 100%;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding: 18px;\n      padding: 0 18px 10px;\n      -webkit-overflow-scrolling: touch;\n      perspective: none;\n    }\n\n    .hn-version-cards__grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hn-version-cards__grid {\n      scrollbar-width: none;\n    }\n\n    .hn-version-cards__card {\n      flex: 0 0 min(84vw, 410px);\n      aspect-ratio: 3 / 4;\n      min-height: auto;\n      border-radius: 28px;\n      padding: 14px;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      opacity: 1;\n      transform: none;\n      --card-show: 1 !important;\n      --content-show: 1 !important;\n    }\n\n    .hn-version-cards__number {\n      top: 26px;\n      right: 28px;\n      font-size: 12px;\n    }\n\n    .hn-version-cards__image {\n      height: 55%;\n      flex-basis: 55%;\n      border-radius: 22px;\n    }\n\n    .hn-version-cards__content {\n      padding: 21px 8px 2px;\n    }\n\n    .hn-version-cards__content h3 {\n      max-width: 100%;\n      font-size: clamp(23px, 7vw, 34px);\n    }\n\n    .hn-version-cards__content p {\n      max-width: 100%;\n      font-size: 13px;\n      line-height: 1.4;\n      margin-top: 12px;\n    }\n\n    .hn-version-cards__button {\n      min-height: 40px;\n      padding: 12px 16px;\n      font-size: 11px;\n      margin-top: auto;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-fight-video-hero {\n      height: 140vh;\n    }\n\n    .hn-fight-video-hero__sticky {\n      min-height: 620px;\n    }\n\n    .hn-fight-video-hero__content {\n      width: min(100%, calc(100% - 24px));\n    }\n\n    .hn-fight-video-hero__kicker {\n      font-size: 13px;\n      margin-bottom: 10px;\n    }\n\n    .hn-fight-video-hero__title {\n      font-size: clamp(48px, 15vw, 76px);\n      letter-spacing: -0.06em;\n    }\n\n    .hn-fight-video-hero__subline {\n      max-width: 340px;\n      font-size: 15px;\n    }\n\n    .hn-fight-video-hero__scroll {\n      margin-top: 34px;\n      font-size: 11px;\n    }\n\n    .hn-fight-video-hero__frame {\n      width: min(390px, calc(100% - 34px));\n      aspect-ratio: 9 / 16;\n      border-radius: 22px;\n    }\n\n    .hn-fight-video-hero__panels {\n      gap: 8px;\n    }\n\n    .hn-fight-video-hero__panel {\n      border-radius: 14px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section) return;\n\n    var desktopVideo = 'https://cdn.shopify.com/videos/c/o/v/ce41e89287c0430e9d9c2d5d1d105beb.mp4';\n    var mobileVideo = 'https://cdn.shopify.com/videos/c/o/v/04e8c483b0904cc1bfd6c5ce8645d553.mp4';\n\n    var content = section.querySelector('.hn-fight-video-hero__content');\n    var bgVideo = section.querySelector('.hn-fight-video-hero__bg-video');\n    var frame = section.querySelector('.hn-fight-video-hero__frame');\n    var mainVideo = section.querySelector('.hn-fight-video-hero__main-video');\n    var panelsWrap = section.querySelector('.hn-fight-video-hero__panels');\n    var panels = section.querySelectorAll('.hn-fight-video-hero__panel');\n    var allVideos = section.querySelectorAll('.js-hn-fight-video');\n\n    var currentSrc = '';\n    var videosLoaded = false;\n    var ticking = false;\n\n    function getVideoSrc() {\n      return window.matchMedia('(max-width: 749px)').matches ? mobileVideo : desktopVideo;\n    }\n\n    function loadVideosOnlyAfterScroll() {\n      if (videosLoaded) return;\n\n      var rect = section.getBoundingClientRect();\n      var sectionIsNear = rect.top < window.innerHeight * 1.15 && rect.bottom > -window.innerHeight * 0.25;\n      var userHasScrolled = window.scrollY > 20 || window.pageYOffset > 20;\n\n      if (!sectionIsNear || !userHasScrolled) return;\n\n      videosLoaded = true;\n      currentSrc = getVideoSrc();\n\n      allVideos.forEach(function (video) {\n        video.src = currentSrc;\n        video.muted = true;\n        video.loop = true;\n        video.playsInline = true;\n        video.preload = 'auto';\n        video.load();\n\n        var playPromise = video.play();\n        if (playPromise && typeof playPromise.catch === 'function') {\n          playPromise.catch(function () {});\n        }\n      });\n    }\n\n    function updateVideoSourceOnResize() {\n      if (!videosLoaded) return;\n\n      var nextSrc = getVideoSrc();\n      if (nextSrc === currentSrc) return;\n\n      currentSrc = nextSrc;\n\n      allVideos.forEach(function (video) {\n        var oldTime = video.currentTime || 0;\n\n        video.src = currentSrc;\n        video.load();\n\n        video.addEventListener('loadedmetadata', function setTimeOnce() {\n          video.removeEventListener('loadedmetadata', setTimeOnce);\n\n          try {\n            video.currentTime = oldTime;\n          } catch (e) {}\n\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        });\n      });\n    }\n\n    function syncVideos(force) {\n      if (!videosLoaded || !allVideos.length) return;\n\n      var master = bgVideo && bgVideo.duration ? bgVideo : mainVideo;\n      if (!master || !master.duration) return;\n\n      allVideos.forEach(function (video) {\n        if (video === master || !video.duration) return;\n\n        var diff = Math.abs(video.currentTime - master.currentTime);\n\n        if (force || diff > 0.055) {\n          try {\n            video.currentTime = master.currentTime;\n          } catch (e) {}\n        }\n\n        if (video.paused) {\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        }\n      });\n    }\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function updateHero() {\n      loadVideosOnlyAfterScroll();\n      syncVideos(false);\n\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var textFade = easeOutCubic(clamp(progress / 0.28, 0, 1));\n      var frameIn = easeOutCubic(clamp((progress - 0.16) / 0.24, 0, 1));\n      var merge = easeOutCubic(clamp((progress - 0.42) / 0.34, 0, 1));\n      var finalVideo = easeOutCubic(clamp((progress - 0.66) / 0.18, 0, 1));\n\n      if (content) {\n        content.style.opacity = 1 - textFade;\n        content.style.transform =\n          'translateY(' + (-2 - textFade * 9) + 'vh) scale(' + (1 - textFade * 0.035) + ')';\n      }\n\n      if (bgVideo) {\n        bgVideo.style.opacity = 1 - frameIn * 0.5;\n        bgVideo.style.transform = 'scale(' + (1.08 + progress * 0.08) + ')';\n      }\n\n      if (frame) {\n        frame.style.opacity = frameIn;\n        frame.style.transform =\n          'translate(-50%, -50%) scale(' + (1.12 - frameIn * 0.12) + ')';\n      }\n\n      if (panelsWrap) {\n        panelsWrap.style.gap = (18 - merge * 18) + 'px';\n        panelsWrap.style.opacity = 1 - finalVideo;\n      }\n\n      if (mainVideo) {\n        mainVideo.style.opacity = finalVideo;\n      }\n\n      if (panels.length) {\n        var isMobile = window.matchMedia('(max-width: 749px)').matches;\n        var startMove = isMobile ? 12 : 18;\n        var sideMove = startMove - merge * startMove;\n        var centerDrop = 10 - merge * 10;\n        var radius = isMobile ? 14 - merge * 14 : 22 - merge * 22;\n\n        panels[0].style.transform = 'translateX(-' + sideMove + 'vw)';\n        panels[1].style.transform = 'translateY(' + centerDrop + 'vh)';\n        panels[2].style.transform = 'translateX(' + sideMove + 'vw)';\n\n        panels.forEach(function (panel) {\n          panel.style.borderRadius = radius + 'px';\n        });\n      }\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateHero);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      updateVideoSourceOnResize();\n      requestTick();\n    });\n\n    setInterval(function () {\n      syncVideos(true);\n    }, 300);\n\n    updateHero();\n  })();\n\n  (function () {\n    var section = document.getElementById('hnVersionCards');\n    if (!section || section.dataset.hnReady === 'true') return;\n    section.dataset.hnReady = 'true';\n\n    var heading = section.querySelector('.hn-version-cards__heading');\n    var cards = Array.prototype.slice.call(section.querySelectorAll('.hn-version-cards__card'));\n    var ticking = false;\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function isMobileLayout() {\n      return window.matchMedia('(max-width: 989px)').matches;\n    }\n\n    function setMobileFinalState() {\n      if (heading) {\n        heading.style.opacity = 1;\n        heading.style.transform = 'none';\n      }\n\n      cards.forEach(function (card) {\n        card.style.setProperty('--card-show', 1);\n        card.style.setProperty('--content-show', 1);\n      });\n    }\n\n    function setDesktopMotion() {\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var headingProgress = easeOutCubic(clamp(progress / 0.30, 0, 1));\n\n      if (heading) {\n        heading.style.opacity = headingProgress;\n        heading.style.transform =\n          'translateY(' + ((1 - headingProgress) * 28) + 'px) scale(' + (0.98 + headingProgress * 0.02) + ')';\n      }\n\n      cards.forEach(function (card, index) {\n        var stagger = index * 0.12;\n        var cardShow = easeOutCubic(clamp((progress - 0.22 - stagger) / 0.34, 0, 1));\n        var contentShow = easeOutCubic(clamp((progress - 0.32 - stagger) / 0.34, 0, 1));\n\n        card.style.setProperty('--card-show', cardShow.toFixed(3));\n        card.style.setProperty('--content-show', contentShow.toFixed(3));\n      });\n    }\n\n    function update() {\n      if (isMobileLayout()) {\n        setMobileFinalState();\n      } else {\n        setDesktopMotion();\n      }\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(update);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n    window.addEventListener('resize', requestTick);\n\n    update();\n  })();\n</script>",
