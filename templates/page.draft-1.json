controlled game.',\n        tag: 'Control pick',\n        weight: '4U',\n        tension: '30 LBS',\n        shaft: '7.0mm',\n        link: '/products/hyfonic-1',\n        image: 'https://in.hndrd.co/cdn/shop/files/Template-01_b406d4ea-171b-462e-9c87-9232e1399947.png?v=1768642309&width=1200',\n        color: '#50d16e',\n        rgb: '80,209,110'\n      },\n      {\n        id: 'nitrix-thunder',\n        name: 'Nitrix Thunder',\n        series: 'Evolution Series',\n        tier: 'evolution',\n        family: 'power',\n        feel: 'Heavy hit',\n        level: 'Regular / match player',\n        bestFor: 'Players who want more punch from the back court.',\n        tag: 'Attack upgrade',\n        weight: '4U',\n        tension: '32 LBS',\n        shaft: '6.8mm',\n        link: '/products/nitrix-thunder',\n        image: 'https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1200',\n        color: '#d7a20f',\n        rgb: '215,162,15'\n      },\n      {\n        id: 'flareon-typhoon',\n        name: 'Flareon Typhoon',\n        series: 'Evolution Series',\n        tier: 'evolution',\n        family: 'speed',\n        feel: 'Fast swing',\n        level: 'Regular / match player',\n        bestFor: 'Fast exchanges, quick counters, and easy movement.',\n        tag: 'Speed upgrade',\n        weight: '4U',\n        tension: '32 LBS',\n        shaft: '7.0mm',\n        link: '/products/flareon-typhoon',\n        image: 'https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1200',\n        color: '#00c9ff',\n        rgb: '0,201,255'\n      },\n      {\n        id: 'hyfonic-lazer',\n        name: 'Hyfonic Lazer',\n        series: 'Evolution Series',\n        tier: 'evolution',\n        family: 'control',\n        feel: 'Stable feel',\n        level: 'Regular / match player',\n        bestFor: 'Sharper placement and cleaner control under pressure.',\n        tag: 'Control upgrade',\n        weight: '4U',\n        tension: '32 LBS',\n        shaft: '7.0mm',\n        link: '/products/hyfonic-lazer-4u',\n        image: 'https://in.hndrd.co/cdn/shop/files/1_4e02ab1d-f883-4e7b-aa23-f35a0808d797.png?v=1761629738&width=1200',\n        color: '#4361ee',\n        rgb: '67,97,238'\n      },\n      {\n        id: 'nitrix-70-venom',\n        name: 'Nitrix 70 Venom',\n        series: 'Pro Series',\n        tier: 'pro',\n        family: 'power',\n        feel: 'Heavy hit',\n        level: 'Advanced / tournament',\n        bestFor: 'Hard attacking play and early rally finishes.',\n        tag: 'Pro attack',\n        weight: '3U / 4U',\n        tension: '32 LBS',\n        shaft: '6.1mm',\n        link: '/products/nitrix-70-venom',\n        image: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756',\n        color: '#19b84a',\n        rgb: '25,184,74'\n      },\n      {\n        id: 'nitrix-70-volta',\n        name: 'Nitrix 70 Volta',\n        series: 'Pro Series',\n        tier: 'pro',\n        family: 'power',\n        feel: 'Heavy hit',\n        level: 'Advanced / tournament',\n        bestFor: 'Power players who want a cleaner, faster strike.',\n        tag: 'Pro power',\n        weight: '3U / 4U',\n        tension: '32 LBS',\n        shaft: '7.0mm',\n        link: '/products/nitrix-70-volta',\n        image: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756',\n        color: '#1f7ed8',\n        rgb: '31,126,216'\n      },\n      {\n        id: 'hyfonic-7',\n        name: 'Hyfonic 7',\n        series: 'Pro Series',\n        tier: 'pro',\n        family: 'control',\n        feel: 'Stable feel',\n        level: 'Advanced / tournament',\n        bestFor: 'Players who want control, stability, and clean placement.',\n        tag: 'Pro control',\n        weight: '3U / 4U',\n        tension: '32 LBS',\n        shaft: '7.0mm',\n        link: '/products/hyfonic-7-4u',\n        image: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Hyfonic.png?v=1753182756',\n        color: '#6f42d8',\n        rgb: '111,66,216'\n      },\n      {\n        id: 'flareon-700',\n        name: 'Flareon 700',\n        series: 'Pro Series',\n        tier: 'pro',\n        family: 'speed',\n        feel: 'Fast swing',\n        level: 'Advanced / tournament',\n        bestFor: 'Fast hands, quick reactions, and early interceptions.',\n        tag: 'Pro speed',\n        weight: '3U / 4U',\n        tension: '32 LBS',\n        shaft: '7.0mm',\n        link: '/products/flareon-700',\n        image: 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon.png?v=1753182756',\n        color: '#ff3b24',\n        rgb: '255,59,36'\n      }\n    ];\n\n    var steps = [\n      {\n        id: 'level',\n        kicker: 'Step 01',\n        title: 'How often do you play?',\n        helper: 'This helps us pick the right level. No overkill. No underpowered picks.',\n        options: [\n          { value: 'start', title: 'Just started', copy: 'I’m learning the game.' },\n          { value: 'regular', title: 'Weekend regular', copy: 'I play often and want a better racket.' },\n          { value: 'match', title: 'Match player', copy: 'I play to win games.' },\n          { value: 'advanced', title: 'Advanced / tournament', copy: 'I need serious performance.' }\n        ]\n      },\n      {\n        id: 'style',\n        kicker: 'Step 02',\n        title: 'What do you want more of?',\n        helper: 'Pick the one thing you want your racket to help with the most.',\n        options: [\n          { value: 'power', title: 'More power', copy: 'Stronger smashes and heavier hits.' },\n          { value: 'speed', title: 'More speed', copy: 'Faster reactions and quick hands.' },\n          { value: 'control', title: 'More control', copy: 'Cleaner placement and stable shots.' },\n          { value: 'balanced', title: 'Balanced feel', copy: 'A bit of everything.' }\n        ]\n      },\n      {\n        id: 'game',\n        kicker: 'Step 03',\n        title: 'How do you usually play?',\n        helper: 'Keep it simple. Choose what sounds most like you.',\n        options: [\n          { value: 'attack', title: 'I attack first', copy: 'I like taking control early.' },\n          { value: 'counter', title: 'I defend and counter', copy: 'I react fast and punish mistakes.' },\n          { value: 'placement', title: 'I play placement', copy: 'I move opponents around.' },\n          { value: 'unsure', title: 'Still figuring it out', copy: 'I want a safe, easy pick.' }\n        ]\n      },\n      {\n        id: 'feel',\n        kicker: 'Step 04',\n        title: 'What racket feel do you like?',\n        helper: 'No technical terms. Just choose the feel you want in your hand.',\n        options: [\n          { value: 'heavy', title: 'Heavy hit', copy: 'More punch behind the shuttle.' },\n          { value: 'fast', title: 'Fast swing', copy: 'Easy to move quickly.' },\n          { value: 'stable', title: 'Stable feel', copy: 'More control on contact.' },\n          { value: 'not-sure', title: 'Not sure', copy: 'Recommend the safest option.' }\n        ]\n      },\n      {\n        id: 'performance',\n        kicker: 'Step 05',\n        title: 'How much performance do you want?',\n        helper: 'This decides whether we stay safe, step up, or go top tier.',\n        options: [\n          { value: 'easy', title: 'Easy upgrade', copy: 'Better than basic, still easy to use.' },\n          { value: 'serious', title: 'Serious upgrade', copy: 'More performance without going extreme.' },\n          { value: 'top', title: 'Top tier only', copy: 'Show me the best that fits me.' },\n          { value: 'safe', title: 'Safest match', copy: 'Give me the smartest recommendation.' }\n        ]\n      }\n    ];\n\n    var screens = {\n      intro: section.querySelector('[data-quiz-screen=\"intro\"]'),\n      quiz: section.querySelector('[data-quiz-screen=\"quiz\"]'),\n      result: section.querySelector('[data-quiz-screen=\"result\"]')\n    };\n\n    var startBtn = section.querySelector('[data-quiz-start]');\n    var backBtn = section.querySelector('[data-quiz-back]');\n    var restartBtn = section.querySelector('[data-quiz-restart]');\n    var questionEl = section.querySelector('[data-quiz-question]');\n    var helperEl = section.querySelector('[data-quiz-helper]');\n    var kickerEl = section.querySelector('[data-quiz-step-kicker]');\n    var optionsEl = section.querySelector('[data-quiz-options]');\n    var progressEl = section.querySelector('[data-quiz-progress-fill]');\n    var countEl = section.querySelector('[data-quiz-count]');\n    var mainResultEl = section.querySelector('[data-main-result]');\n    var alsoResultsEl = section.querySelector('[data-also-results]');\n    var compareBtn = section.querySelector('[data-open-compare]');\n    var modal = section.querySelector('[data-compare-modal]');\n    var compareGrid = section.querySelector('[data-compare-grid]');\n    var closeBtns = section.querySelectorAll('[data-close-compare]');\n\n    var currentStep = 0;\n    var answers = {};\n    var currentRecommendations = [];\n    var autoCompareOpened = false;\n\n    function escapeHTML(value) {\n      return String(value).replace(/[&<>\"']/g, function (char) {\n        return ({\n          '&': '&amp;',\n          '<': '&lt;',\n          '>': '&gt;',\n          '\"': '&quot;',\n          \"'\": '&#039;'\n        })[char];\n      });\n    }\n\n    function showScreen(name) {\n      Object.keys(screens).forEach(function (key) {\n        var isActive = key === name;\n        screens[key].classList.toggle('is-active', isActive);\n        screens[key].setAttribute('aria-hidden', isActive ? 'false' : 'true');\n      });\n    }\n\n    function renderStep() {\n      var step = steps[currentStep];\n\n      kickerEl.textContent = step.kicker;\n      questionEl.textContent = step.title;\n      helperEl.textContent = step.helper;\n      countEl.textContent = String(currentStep + 1).padStart(2, '0') + ' / ' + String(steps.length).padStart(2, '0');\n      progressEl.style.width = (((currentStep + 1) / steps.length) * 100) + '%';\n\n      optionsEl.innerHTML = step.options.map(function (option) {\n        return '<button class=\"hn-weapon-quiz__option\" type=\"button\" data-option-value=\"' + escapeHTML(option.value) + '\">' +\n          '<strong>' + escapeHTML(option.title) + '</strong>' +\n          '<span>' + escapeHTML(option.copy) + '</span>' +\n        '</button>';\n      }).join('');\n\n      optionsEl.querySelectorAll('[data-option-value]').forEach(function (button) {\n        button.addEventListener('click', function () {\n          var value = button.getAttribute('data-option-value');\n          answers[step.id] = value;\n\n          optionsEl.querySelectorAll('.hn-weapon-quiz__option').forEach(function (item) {\n            item.classList.remove('is-picked');\n          });\n\n          button.classList.add('is-picked');\n\n          window.setTimeout(function () {\n            if (currentStep < steps.length - 1) {\n              currentStep += 1;\n              renderStep();\n            } else {\n              showResults();\n            }\n          }, 220);\n        });\n      });\n    }\n\n    function allowedTiers() {\n      if (answers.level === 'start') return ['prime'];\n      if (answers.level === 'regular') return ['prime', 'evolution'];\n      if (answers.level === 'match') return ['evolution', 'prime', 'pro'];\n      if (answers.level === 'advanced') return ['pro', 'evolution'];\n      return ['prime', 'evolution'];\n    }\n\n    function scoreProduct(product) {\n      var allowed = allowedTiers();\n      if (allowed.indexOf(product.tier) === -1) return -999;\n\n      var score = 0;\n\n      var levelScore = {\n        start: { prime: 8, evolution: 0, pro: -999 },\n        regular: { prime: 4, evolution: 6, pro: -999 },\n        match: { prime: 1, evolution: 7, pro: 4 },\n        advanced: { prime: -999, evolution: 3, pro: 8 }\n      };\n\n      var performanceScore = {\n        easy: { prime: 5, evolution: 2, pro: -2 },\n        serious: { prime: 1, evolution: 5, pro: 2 },\n        top: { prime: -1, evolution: 2, pro: 5 },\n        safe: { prime: 3, evolution: 4, pro: 1 }\n      };\n\n      score += (levelScore[answers.level] && levelScore[answers.level][product.tier]) || 0;\n      score += (performanceScore[answers.performance] && performanceScore[answers.performance][product.tier]) || 0;\n\n      if (answers.style === 'power' && product.family === 'power') score += 7;\n      if (answers.style === 'speed' && product.family === 'speed') score += 7;\n      if (answers.style === 'control' && product.family === 'control') score += 7;\n      if (answers.style === 'balanced') score += 2;\n\n      if (answers.game === 'attack' && product.family === 'power') score += 4;\n      if (answers.game === 'counter' && product.family === 'speed') score += 4;\n      if (answers.game === 'counter' && product.family === 'control') score += 1;\n      if (answers.game === 'placement' && product.family === 'control') score += 4;\n      if (answers.game === 'unsure' && product.tier !== 'pro') score += 3;\n\n      if (answers.feel === 'heavy' && product.family === 'power') score += 4;\n      if (answers.feel === 'fast' && product.family === 'speed') score += 4;\n      if (answers.feel === 'stable' && product.family === 'control') score += 4;\n      if (answers.feel === 'not-sure' && product.tier !== 'pro') score += 2;\n\n      if (answers.performance === 'top' && answers.level === 'regular' && product.tier === 'evolution') score += 4;\n      if (answers.performance === 'top' && answers.level === 'start' && product.tier === 'prime') score += 4;\n\n      return score;\n    }\n\n    function buildWhy(product) {\n      var styleMap = {\n        power: 'power',\n        speed: 'speed',\n        control: 'control',\n        balanced: 'a balanced feel'\n      };\n\n      var styleText = styleMap[answers.style] || 'performance';\n\n      if (product.tier === 'prime') {\n        return 'You picked ' + styleText + ', but your level is better served by something easy to use. This is the safer match before going too advanced.';\n      }\n\n      if (product.tier === 'evolution') {\n        return 'You picked ' + styleText + ' and serious performance. This gives you a clear upgrade without jumping straight into a pro-only frame.';\n      }\n\n      return 'You picked top-tier performance and a sharper playing style. This is built for advanced players who already know what they want from a racket.';\n    }\n\n    function getRecommendations() {\n      var sorted = products\n        .map(function (product) {\n          return {\n            product: product,\n            score: scoreProduct(product)\n          };\n        })\n        .filter(function (item) {\n          return item.score > -500;\n        })\n        .sort(function (a, b) {\n          return b.score - a.score;\n        });\n\n      var first = sorted.slice(0, 4).map(function (item) {\n        return item.product;\n      });\n\n      var unique = [];\n      first.forEach(function (product) {\n        if (!unique.some(function (item) { return item.id === product.id; })) {\n          unique.push(product);\n        }\n      });\n\n      return unique.slice(0, 4);\n    }\n\n    function renderMainResult(product) {\n      mainResultEl.style.setProperty('--result-color', product.color);\n      mainResultEl.style.setProperty('--result-rgb', product.rgb);\n\n      mainResultEl.innerHTML =\n        '<div class=\"hn-weapon-quiz__product-media\">' +\n          '<img src=\"' + escapeHTML(product.image) + '\" alt=\"' + escapeHTML(product.name) + '\" loading=\"lazy\">' +\n        '</div>' +\n        '<div class=\"hn-weapon-quiz__product-info\">' +\n          '<span class=\"hn-weapon-quiz__tier\">' + escapeHTML(product.series) + '</span>' +\n          '<h3>' + escapeHTML(product.name) + '</h3>' +\n          '<p class=\"hn-weapon-quiz__why\">' + escapeHTML(buildWhy(product)) + '</p>' +\n          '<div class=\"hn-weapon-quiz__chips\">' +\n            '<span>' + escapeHTML(product.tag) + '</span>' +\n            '<span>' + escapeHTML(product.feel) + '</span>' +\n            '<span>' + escapeHTML(product.tension) + '</span>' +\n          '</div>' +\n          '<a class=\"hn-weapon-quiz__shop\" href=\"' + escapeHTML(product.link) + '\">' +\n            'Shop ' + escapeHTML(product.name) + ' <span>→</span>' +\n          '</a>' +\n        '</div>';\n    }\n\n    function renderAlso(productsList) {\n      alsoResultsEl.innerHTML = productsList.map(function (product) {\n        return '<article class=\"hn-weapon-quiz__mini\" style=\"--mini-color:' + product.color + '; --mini-rgb:' + product.rgb + ';\">' +\n          '<div class=\"hn-weapon-quiz__mini-img\">' +\n            '<img src=\"' + escapeHTML(product.image) + '\" alt=\"' + escapeHTML(product.name) + '\" loading=\"lazy\">' +\n          '</div>' +\n          '<div>' +\n            '<h4>' + escapeHTML(product.name) + '</h4>' +\n            '<p>' + escapeHTML(product.bestFor) + '</p>' +\n            '<a href=\"' + escapeHTML(product.link) + '\">Shop now →</a>' +\n          '</div>' +\n        '</article>';\n      }).join('');\n    }\n\n    function renderCompare(productsList) {\n      compareGrid.style.setProperty('--compare-count', productsList.length);\n\n      compareGrid.innerHTML = productsList.map(function (product) {\n        return '<article class=\"hn-weapon-quiz__compare-card\" style=\"--compare-color:' + product.color + '; --compare-rgb:' + product.rgb + ';\">' +\n          '<div class=\"hn-weapon-quiz__compare-image\">' +\n            '<img src=\"' + escapeHTML(product.image) + '\" alt=\"' + escapeHTML(product.name) + '\" loading=\"lazy\">' +\n          '</div>' +\n          '<h4>' + escapeHTML(product.name) + '</h4>' +\n          '<p>' + escapeHTML(product.series) + ' · ' + escapeHTML(product.tag) + '</p>' +\n          '<div class=\"hn-weapon-quiz__spec-table\">' +\n            '<div><span>Best For</span><strong>' + escapeHTML(product.bestFor) + '</strong></div>' +\n            '<div><span>Feel</span><strong>' + escapeHTML(product.feel) + '</strong></div>' +\n            '<div><span>Level</span><strong>' + escapeHTML(product.level) + '</strong></div>' +\n            '<div><span>Weight</span><strong>' + escapeHTML(product.weight) + '</strong></div>' +\n            '<div><span>Tension</span><strong>' + escapeHTML(product.tension) + '</strong></div>' +\n            '<div><span>Shaft</span><strong>' + escapeHTML(product.shaft) + '</strong></div>' +\n          '</div>' +\n          '<a class=\"hn-weapon-quiz__compare-shop\" href=\"' + escapeHTML(product.link) + '\">Shop ' + escapeHTML(product.name) + '</a>' +\n        '</article>';\n      }).join('');\n    }\n\n    function openCompare() {\n      if (!currentRecommendations.length) return;\n      renderCompare(currentRecommendations);\n      modal.classList.add('is-open');\n      modal.setAttribute('aria-hidden', 'false');\n      document.documentElement.style.overflow = 'hidden';\n    }\n\n    function closeCompare() {\n      modal.classList.remove('is-open');\n      modal.setAttribute('aria-hidden', 'true');\n      document.documentElement.style.overflow = '';\n    }\n\n    function showResults() {\n      currentRecommendations = getRecommendations();\n\n      if (!currentRecommendations.length) {\n        currentRecommendations = products.slice(0, 3);\n      }\n\n      renderMainResult(currentRecommendations[0]);\n      renderAlso(currentRecommendations.slice(1, 4));\n      showScreen('result');\n\n      if (currentRecommendations.length > 2 && !autoCompareOpened) {\n        autoCompareOpened = true;\n        window.setTimeout(function () {\n          openCompare();\n        }, 850);\n      }\n    }\n\n    function startQuiz() {\n      currentStep = 0;\n      answers = {};\n      autoCompareOpened = false;\n      renderStep();\n      showScreen('quiz');\n    }\n\n    function restartQuiz() {\n      closeCompare();\n      startQuiz();\n    }\n\n    startBtn.addEventListener('click', startQuiz);\n\n    backBtn.addEventListener('click', function () {\n      if (currentStep === 0) {\n        showScreen('intro');\n      } else {\n        currentStep -= 1;\n        renderStep();\n      }\n    });\n\n    restartBtn.addEventListener('click', restartQuiz);\n    compareBtn.addEventListener('click', openCompare);\n\n    closeBtns.forEach(function (button) {\n      button.addEventListener('click', closeCompare);\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape') {\n        closeCompare();\n      }\n    });\n  })();\n</script>\n</section>",
