ation: none;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.02em;\n    transition: transform 260ms ease, background 260ms ease;\n  }\n\n  .hn-evo-final__button:hover {\n    transform: translateY(-2px);\n    background: rgba(255,255,255,0.86);\n  }\n\n  .hn-evo-final__progress {\n    display: grid;\n    grid-template-columns: 24px minmax(160px, 260px) 24px;\n    align-items: center;\n    column-gap: 12px;\n    margin-top: 36px;\n    width: fit-content;\n  }\n\n  .hn-evo-final__progress-current,\n  .hn-evo-final__progress-total {\n    color: rgba(255,255,255,0.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .hn-evo-final__progress-track {\n    position: relative;\n    width: 100%;\n    height: 2px;\n    border-radius: 999px;\n    overflow: hidden;\n    background: rgba(255,255,255,0.18);\n  }\n\n  .hn-evo-final__progress-fill {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n    background: #ffffff;\n    transform-origin: left center;\n    transform: scaleX(var(--hn-evo-progress));\n    will-change: transform;\n  }\n\n  .hn-evo-final__scroll-hint {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 14px;\n    color: rgba(255,255,255,0.58);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    pointer-events: none;\n    transition: opacity 220ms ease, transform 220ms ease;\n  }\n\n  .hn-evo-final__scroll-hint span {\n    width: 18px;\n    height: 18px;\n    display: inline-grid;\n    place-items: center;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.08);\n    color: #ffffff;\n    font-size: 12px;\n    animation: hnEvoFinalDownBlink 1.15s ease-in-out infinite;\n  }\n\n  .hn-evo-final__scroll-hint.is-hidden {\n    opacity: