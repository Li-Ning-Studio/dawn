-custom-evo__cta {\n  margin-top: 1.7rem;\n  background:\n    linear-gradient(#000000, #000000) padding-box,\n    linear-gradient(\n      -225deg,\n      #dba20f 0%,\n      #2d9fa7 52%,\n      #0c8642 80%\n    ) border-box;\n  border: 1.5px solid transparent;\n  font-weight: 700;\n  padding: 1.6rem 3.1rem;\n  border-radius: 500px;\n  cursor: pointer;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: white;\n  text-decoration: none;\n  font-size: 1.5rem;\n  z-index: 1;\n  transition: 0.5s ease;\n}\n\n.main-sec-custom-evo__cta:hover {\n  background:\n    linear-gradient(\n      -225deg,\n      #dba20f 0%,\n      #2d9fa7 52%,\n      #0c8642 80%\n    ) padding-box,\n    linear-gradient(\n      -225deg,\n      #dba20f 0%,\n      #2d9fa7 52%,\n      #0c8642 80%\n    ) border-box;\n  color: #000000;\n}\n</style>",
