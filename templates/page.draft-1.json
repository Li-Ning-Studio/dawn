;\n    cursor: pointer;\n    border-radius: 24px;\n    color: #ffffff;\n    background:\n      linear-gradient(145deg, rgba(255,255,255,0.065), rgba(255,255,255,0.018)),\n      rgba(0,0,0,0.2);\n    border: 1px solid rgba(255,255,255,0.1);\n    overflow: hidden;\n    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;\n  }\n\n  .hn-prime-system__choice::before {\n    content: \"\";\n    position: absolute;\n    left: 22px;\n    top: 50%;\n    width: 34px;\n    height: 34px;\n    transform: translateY(-50%);\n    border-radius: 50%;\n    background: rgba(var(--accent-rgb), 0.22);\n    border: 1px solid rgba(var(--accent-rgb), 0.68);\n    box-shadow: 0 0 24px rgba(var(--accent-rgb), 0.18);\n  }\n\n  .hn-prime-system__choice::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: radial-gradient(circle at 0% 50%, rgba(var(--accent-rgb), 0.18), transparent 42%);\n    opacity: 0;\n    transition: opacity 0.25s ease;\n  }\n\n  .hn-prime-system__choice:hover,\n  .hn-prime-system__choice.is-active {\n    border-color: rgba(var(--accent-rgb), 0.56);\n    background:\n      linear-gradient(145deg, rgba(var(--accent-rgb), 0.13), rgba(255,255,255,0.022)),\n      rgba(0,0,0,0.26);\n    transform: translateX(4px);\n  }\n\n  .hn-prime-system__choice.is-active::after {\n    opacity: 1;\n  }\n\n  .hn-prime-system__choice-count {\n    position: absolute;\n    left: 32px;\n    top: 50%;\n    z-index: 2;\n    transform: translate(-50%, -50%);\n    color: rgba(255,255,255,0.52);\n    font-size: 11px;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n  }\n\n  .hn-prime-system__choice-meta {\n    position: relative;\n    z-index: 2;\n    display: block;\n    color: rgba(var(--accent-rgb), 1);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .hn-prime-system__choice strong {\n    position: relative;\n    z-index: 2