      "settings": {
        "custom_liquid": "<section class=\"hn-fight-video-hero\" id=\"hnFightVideoHero\">\n  <div class=\"hn-fight-video-hero__sticky\">\n\n    <div class=\"hn-fight-video-hero__bg\">\n      <video\n        class=\"hn-fight-video-hero__bg-video js-hn-fight-video\"\n        muted\n        loop\n        playsinline\n        preload=\"none\"\n      ></video>\n\n      <div class=\"hn-fight-video-hero__grade\"></div>\n      <div class=\"hn-fight-video-hero__light-lift\"></div>\n      <div class=\"hn-fight-video-hero__pulse\"></div>\n    </div>\n\n    <div class=\"hn-fight-video-hero__content\">\n      <p class=\"hn-fight-video-hero__kicker\">Hundred Badminton</p>\n\n      <h1 class=\"hn-fight-video-hero__title\">\n        Pick your fight.\n      </h1>\n\n      <p class=\"hn-fight-video-hero__subline\">\n        Attack. Speed. Precision. Whatever your game is, we built the racket for it.\n      </p>\n\n      <div class=\"hn-fight-video-hero__scroll\">\n        Scroll to find your racket ↓\n      </div>\n    </div>\n\n    <div class=\"hn-fight-video-hero__frame\">\n      <video\n        class=\"hn-fight-video-hero__main-video js-hn-fight-video js-hn-main-video\"\n        muted\n        loop\n        playsinline\n        preload=\"none\"\n      ></video>\n\n      <div class=\"hn-fight-video-hero__panels\">\n        <div class=\"hn-fight-video-hero__panel hn-fight-video-hero__panel--left\">\n          <video class=\"js-hn-fight-video\" muted loop playsinline preload=\"none\"></video>\n        </div>\n\n        <div class=\"hn-fight-video-hero__panel hn-fight-video-hero__panel--center\">\n          <video class=\"js-hn-fight-video\" muted loop playsinline preload=\"none\"></video>\n        </div>\n\n        <div class=\"hn-fight-video-hero__panel hn-fight-video-hero__panel--right\">\n          <video class=\"js-hn-fight-video\" muted loop playsinline preload=\"none\"></video>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<section class=\"hn-version-cards\" id=\"hnVersionCards\">\n  <div class=\"hn-version-cards__sticky\">\n    <div class=\"hn-version-cards__inner\">\n\n      <div class=\"hn-version-cards__heading-wrap\">\n        <h2 class=\"hn-version-cards__heading\">\n          Felt that? Now find your version of it.\n        </h2>\n      </div>\n\n      <div class=\"hn-version-cards__grid\">\n\n        <article class=\"hn-version-cards__card hn-version-cards__card--one\">\n          <span class=\"hn-version-cards__number\">01</span>\n\n          <div class=\"hn-version-cards__image\">\n            <!-- Add image later like this:\n            <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Banner_3bb28fc4-a079-4666-acc6-3f17fd65a486.jpg?v=1769775015\" alt=\"\">\n            -->\n          </div>\n\n          <div class=\"hn-version-cards__content\">\n            <h3>Still figuring it out, but I'm not casual anymore.</h3>\n\n            <p>\n              Every week on court. Shots getting sharper. I need a racket that keeps up with me, not one I outgrow in a month.\n            </p>\n\n            <a href=\"/collections/prime-trinity\" class=\"hn-version-cards__button\">\n              Start with Prime Trinity\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n        <article class=\"hn-version-cards__card hn-version-cards__card--two\">\n          <span class=\"hn-version-cards__number\">02</span>\n\n          <div class=\"hn-version-cards__image\">\n            <!-- Add image later like this:\n            <img src=\"YOUR_IMAGE_LINK_HERE\" alt=\"\">\n            -->\n          </div>\n\n          <div class=\"hn-version-cards__content\">\n            <h3>I play to win my matches, not just enjoy the game.</h3>\n\n            <p>\n              Club level, maybe higher soon. I don't need the flagship, I need real tech without flagship pricing.\n            </p>\n\n            <a href=\"/collections/pro-series\" class=\"hn-version-cards__button\">\n              Explore Evolution Series\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n        <article class=\"hn-version-cards__card hn-version-cards__card--three\">\n          <span class=\"hn-version-cards__number\">03</span>\n\n          <div class=\"hn-version-cards__image\">\n            <!-- Add image later like this:\n            <img src=\"YOUR_IMAGE_LINK_HERE\" alt=\"\">\n            -->\n          </div>\n\n          <div class=\"hn-version-cards__content\">\n            <h3>Second place isn't a result.</h3>\n\n            <p>\n              This is what I do. Give me the best Hundred makes. No compromises.\n            </p>\n\n            <a href=\"/collections/pro-series-rackets\" class=\"hn-version-cards__button\">\n              See Pro Series Rackets\n              <span>→</span>\n            </a>\n          </div>\n        </article>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-fight-video-hero,\n  .hn-fight-video-hero *,\n  .hn-fight-video-hero *::before,\n  .hn-fight-video-hero *::after,\n  .hn-version-cards,\n  .hn-version-cards *,\n  .hn-version-cards *::before,\n  .hn-version-cards *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-fight-video-hero {\n    position: relative;\n    width: 100%;\n    height: 150vh;\n    background: #050504;\n    overflow: visible;\n    font-family: inherit;\n  }\n\n  .hn-fight-video-hero__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 640px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    isolation: isolate;\n    background: #050504;\n  }\n\n  .hn-fight-video-hero__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    overflow: hidden;\n    background: #050504;\n  }\n\n  .hn-fight-video-hero__bg-video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(0%) saturate(115%) contrast(1.02) brightness(1.16