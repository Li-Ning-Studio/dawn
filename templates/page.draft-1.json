    "custom_liquid_i3BYKa": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-member-access\" id=\"hnMemberAccess\" aria-label=\"Member access pro series rackets\">\n\n  <div class=\"hn-member-access__sticky\">\n\n    <div class=\"hn-member-access__dark-bg\"></div>\n\n    <div class=\"hn-member-access__gate\">\n      <div class=\"hn-member-access__gate-panel hn-member-access__gate-panel--left\">\n        <span>MEMBER</span>\n      </div>\n\n      <div class=\"hn-member-access__gate-panel hn-member-access__gate-panel--right\">\n        <span>ACCESS</span>\n      </div>\n\n      <div class=\"hn-member-access__gate-line\"></div>\n      <div class=\"hn-member-access__gate-light\"></div>\n\n      <div class=\"hn-member-access__lock\">\n        <div class=\"hn-member-access__lock-mark\">\n          <span></span>\n        </div>\n\n        <p>Top Tier Detected</p>\n        <h3>You’ve reached the top tier.</h3>\n\n        <button type=\"button\" class=\"hn-member-access__mobile-unlock\">\n          Touch to Unlock\n        </button>\n      </div>\n    </div>\n\n    <div class=\"hn-member-access__content\">\n\n      <header class=\"hn-member-access__header\">\n        <p class=\"hn-member-access__eyebrow\">Access Granted</p>\n\n        <h2>\n          You’ve reached<br>\n          the top tier.\n        </h2>\n\n        <p class=\"hn-member-access__copy\">\n          No warm-up rackets here. Just professional frames built for players who already know how they win.\n        </p>\n      </header>\n\n      <div class=\"hn-member-access__cards\">\n\n        <!-- VENOM - GREEN -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#19b84a; --accent-rgb:25,184,74; --card-show:var(--card-1);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Attack Access</p>\n            <span>01</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Venom.png?v=1753182756\"\n              alt=\"Nitrix 70 Venom badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Nitrix 70 Venom</h3>\n            <h4>Violence, refined.</h4>\n            <p>\n              Head-heavy pressure with a razor-thin 6.1mm shaft. Built for players who finish rallies before they get comfortable.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>6.1MM</span>\n            <span>ATTACK</span>\n          </div>\n\n          <a href=\"/products/nitrix-70-venom\" class=\"hn-member-access__cta\">\n            Enter Venom\n            <span>→</span>\n          </a>\n        </article>\n\n        <!-- VOLTA - BLUE -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#1f7ed8; --accent-rgb:31,126,216; --card-show:var(--card-2);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Power Access</p>\n            <span>02</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Volta.png?v=1753182756\"\n              alt=\"Nitrix 70 Volta badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Nitrix 70 Volta</h3>\n            <h4>Power with a cleaner cut.</h4>\n            <p>\n              Fast frame response, hard contact, and enough bite to turn half chances into winners.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>7.0MM</span>\n            <span>POWER</span>\n          </div>\n\n          <a href=\"/products/nitrix-70-volta\" class=\"hn-member-access__cta\">\n            Enter Volta\n            <span>→</span>\n          </a>\n        </article>\n\n        <!-- HYFONIC - PURPLE -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#6f42d8; --accent-rgb:111,66,216; --card-show:var(--card-3);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Precision Access</p>\n            <span>03</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Hyfonic.png?v=1753182756\"\n              alt=\"Hyfonic 7 badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Hyfonic 7</h3>\n            <h4>Control that refuses to wobble.</h4>\n            <p>\n              Stable, precise, and calm at match speed. For players who see the line before the shuttle moves.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>7.0MM</span>\n            <span>CONTROL</span>\n          </div>\n\n          <a href=\"/products/hyfonic-7-4u\" class=\"hn-member-access__cta\">\n            Enter Hyfonic\n            <span>→</span>\n          </a>\n        </article>\n\n        <!-- FLAREON - RED / ORANGE -->\n        <article\n          class=\"hn-member-access__card\"\n          style=\"--accent:#ff3b24; --accent-rgb:255,59,36; --card-show:var(--card-4);\"\n        >\n          <div class=\"hn-member-access__card-top\">\n            <p>Speed Access</p>\n            <span>04</span>\n          </div>\n\n          <div class=\"hn-member-access__media\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Flareon.png?v=1753182756\"\n              alt=\"Flareon 700 badminton racket\"\n              loading=\"lazy\"\n              width=\"900\"\n              height=\"900\"\n            >\n          </div>\n\n          <div class=\"hn-member-access__card-body\">\n            <h3>Flareon 700</h3>\n            <h4>Fast hands get rewarded.</h4>\n            <p>\n              Quick hands, sharper counters, and zero wasted movement. Built for players who arrive early.\n            </p>\n          </div>\n\n          <div class=\"hn-member-access__specs\">\n            <span>32 LBS</span>\n            <span>7.0MM</span>\n            <span>SPEED</span>\n          </div>\n\n          <a href=\"/products/flareon-700\" class=\"hn-member-access__cta\">\n            Enter Flareon\n            <span>→</span>\n          </a>\n        </article>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hn-member-access,\n  .hn-member-access *,\n  .hn-member-access *::before,\n  .hn-member-access *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-member-access {\n    --unlock: 0;\n    --reveal: 0;\n    --card-1: 0;\n    --card-2: 0;\n    --card-3: 0;\n    --card-4: 0;\n\n    position: relative;\n    width: 100%;\n    height: 245vh;\n    background: #000000;\n    color: #ffffff;\n    overflow: clip;\n    font-family: inherit;\n    z-index: 2;\n  }\n\n  .hn-member-access__sticky {\n    position: sticky;\n    top: 0;\n    width: 100%;\n    height: 100vh;\n    min-height: 780px;\n    overflow: hidden;\n    isolation: isolate;\n    background: #000000;\n  }\n\n  .hn-member-access__dark-bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(circle at 50% -12%, rgba(255,255,255,0.03), transparent 30%),\n      radial-gradient(circle at 14% 20%, rgba(25,184,74,0.045), transparent 26%),\n      radial-gradient(circle at 86% 18%, rgba(31,126,216,0.045), transparent 28%),\n      linear-gradient(180deg, #000000 0%, #010101 52%, #000000 100%);\n  }\n\n  .hn-member-access__gate {\n    position: absolute;\n    inset: 0;\n    z-index: 40;\n    pointer-events: none;\n    opacity: calc(1 - (var(--reveal) * 0.9));\n    visibility: visible;\n    background: #000000;\n  }\n\n  .hn-member-access__gate-panel {\n    position: absolute;\n    top: 0;\n    width: 50.1%;\n    height: 100%;\n    overflow: hidden;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.018), transparent 24%, rgba(255,255,255,0.008)),\n      #000000;\n    box-shadow:\n      inset 0 0 0 1px rgba(255,255,255,0.035),\n      inset 0 0 90px rgba(255,255,255,0.012),\n      0 0 90px rgba(0,0,0,0.96);\n    will-change: transform;\n  }\n\n  .hn-member-access__gate-panel::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: 0.06;\n    background:\n      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);\n    background-size: 64px 64px;\n  }\n\n  .hn-member-access__gate-panel::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.015), transparent 54%);\n  }\n\n  .hn-member-access__gate-panel span {\n    position: absolute;\n    top: 50%;\n    color: rgba(255,255,255,0.05);\n    font-size: clamp(78px, 13vw, 200px);\n    line-height: 0.8;\n    font-weight: 950;\n    letter-spacing: -0.08em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    filter: blur(0.2px);\n    pointer-events: none;\n  }\n\n  .hn-member-access__gate-panel--left {\n    left: 0;\n    transform: translateX(calc(var(--unlock) * -104%));\n    border-right: 1px solid rgba(255,255,255,0.06);\n  }\n\n  .hn-member-access__gate-panel--right {\n    right: 0;\n    transform: translateX(calc(var(--unlock) * 104%));\n    border-left: 1px solid rgba(255,255,255,0.06);\n  }\n\n  .hn-member-access__gate-panel--left span {\n    right: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-panel--right span {\n    left: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-line {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%) scaleY(calc(1 - (var(--unlock) * 0.92)));\n    transform-origin: center;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(255,255,255,0.12),\n      #19b84a,\n      #1f7ed8,\n      #6f42d8,\n      #ff3b24,\n      rgba(255,255,255,0.12),\n      transparent\n    );\n    box-shadow:\n      0 0 18px rgba(255,255,255,0.12),\n      0 0 44px rgba(31,126,216,0.16);\n  }\n\n  .hn-member-access__gate-light {\n    position: absolute;\n    z-index: 8;\n    left: -28%;\n    top: 0;\n    width: 24%;\n    height: 100%;\n    transform: translateX(calc(var(--unlock) * 530%)) skewX(-15deg);\n    opacity: calc(0.015 + (var(--unlock) * 0.3));\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);\n    filter: blur(12px);\n  }\n\n  .hn-member-access__lock {\n    position: absolute;\n    z-index: 12;\n    left: 50%;\n    top: 50%;\n    width: min(480px, calc(100% - 44px));\n    transform: translate(-50%, -50%) scale(calc(1 - (var(--unlock) * 0.14)));\n    opacity: calc(1 - (var(--unlock) * 1.15));\n    text-align: center;\n    pointer-events: auto;\n  }\n\n  .hn-member-access__lock-mark {\n    position: relative;\n    width: 112px;\n    height: 112px;\n    margin: 0 auto 24px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.12);\n    background:\n      radial-gradient(circle, rgba(255,255,255,0.055), transparent 44%),\n      #000000;\n    box-shadow:\n      0 0 36px rgba(255,255,255,0.04),\n      inset 0 0 0 1px rgba(255,255,255,0.035);\n  }\n\n  .hn-member-access__lock-mark::before,\n  .hn-member-access__lock-mark::after {\n    content: \"\";\n    position: absolute;\n    border-radius: 999px;\n    pointer-events: none;\n  }\n\n  .hn-member-access__lock-mark::before {\n    inset: 12px;\n    border: 1px solid transparent;\n    border-top-color: #19b84a;\n    border-right-color: #1f7ed8;\n    animation: hnMemberSpin 4.2s linear infinite;\n  }\n\n  .hn-member-access__lock-mark::after {\n    inset: 30px;\n    border: 1px solid transparent;\n    border-left-color: #6f42d8;\n    border-bottom-color: #ff3b24;\n    animation: hnMemberSpinReverse 2.8s linear infinite;\n  }\n\n  .hn-member-access__lock-mark span {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 13px;\n    height: 13px;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: #fff;\n    box-shadow:\n      0 0 16px rgba(255,255,255,0.35),\n      0 0 32px rgba(31,126,216,0.18);\n    animation: hnMemberPulseDot 1.6s ease-in-out infinite;\n  }\n\n  .hn-member-access__lock p {\n    margin: 0 0 14px;\n    color: rgba(255,255,255,0.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-member-access__lock h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(36px, 5vw, 72px);\n    line-height: 0.9;\n    font-weight: 950;\n    letter-spacing: -0.075em;\n    text-shadow: 0 18px 50px rgba(0,0,0,0.92);\n  }\n\n  .hn-member-access__mobile-unlock {\n    display: none;\n  }\n\n  .hn-member-access__content {\n    position: relative;\n    z-index: 10;\n    width: min(1480px, 100%);\n    height: 100%;\n    margin: 0 auto;\n    padding: clamp(58px, 7vh, 86px) clamp(18px, 2.6vw, 38px) clamp(38px, 5vh, 60px);\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: clamp(34px, 4.4vh, 56px);\n    opacity: var(--reveal);\n    transform: translateY(calc((1 - var(--reveal)) * 46px));\n    will-change: opacity, transform;\n  }\n\n  .hn-member-access__header {\n    text-align: center;\n  }\n\n  .hn-member-access__eyebrow {\n    margin: 0 0 16px;\n    color: rgba(255,255,255,0.7);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-member-access__header h2 {\n    margin: 0;\n    font-size: clamp(48px, 7vw, 104px);\n    line-height: 0.86;\n    font-weight: 950;\n    letter-spacing: -0.08em;\n    background-image: linear-gradient(\n      90deg,\n      #ffffff 0%,\n      #19b84a 28%,\n      #1f7ed8 52%,\n      #6f42d8 76%,\n      #ff3b24 100%\n    );\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    text-shadow: 0 20px 54px rgba(0,0,0,0.84);\n  }\n\n  .hn-member-access__copy {\n    width: min(680px, 100%);\n    margin: 22px auto 0;\n    color: rgba(255,255,255,0.86);\n    font-size: clamp(15px, 1.12vw, 18px);\n    line-height: 1.55;\n    font-weight: 650;\n    letter-spacing: -0.018em;\n    text-shadow: 0 10px 34px rgba(0,0,0,0.82);\n  }\n\n  .hn-member-access__cards {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: clamp(16px, 1.5vw, 22px);\n    width: 100%;\n    align-items: stretch;\n  }\n\n  .hn-member-access__card {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    overflow: hidden;\n    border-radius: 32px;\n    padding: 20px;\n    isolation: isolate;\n    border: 1px solid rgba(255,255,255,0.13);\n    background:\n      radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb),0.18), transparent 30%),\n      linear-gradient(180deg, rgba(255,255,255,0.065), rgba(255,255,255,0.018)),\n      #030303;\n    box-shadow:\n      0 28px 90px rgba(0,0,0,0.56),\n      inset 0 0 0 1px rgba(255,255,255,0.04);\n    opacity: var(--card-show);\n    transform: translateY(calc((1 - var(--card-show)) * 48px)) scale(calc(0.94 + (var(--card-show) * 0.06)));\n    will-change: opacity, transform;\n  }\n\n  .hn-member-access__card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.045), transparent 28%, rgba(0,0,0,0.18) 100%);\n  }\n\n  .hn-member-access__card-top,\n  .hn-member-access__media,\n  .hn-member-access__card-body,\n  .hn-member-access__specs,\n  .hn-member-access__cta {\n    position: relative;\n    z-index: 3;\n  }\n\n  .hn-member-access__card-top {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n\n  .hn-member-access__card-top p {\n    margin: 0;\n    color: var(--accent);\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    text-shadow: 0 0 18px rgba(var(--accent-rgb),0.38);\n  }\n\n  .hn-member-access__card-top span {\n    color: rgba(255,255,255,0.42);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: 0.12em;\n  }\n\n  .hn-member-access__media {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 24px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 22px;\n    background:\n      radial-gradient(circle at 50% 44%, rgba(var(--accent-rgb),0.18), transparent 44%),\n      linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.08)),\n      #050505;\n    border: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .hn-member-access__media img {\n    display: block;\n    width: auto;\n    height: 104%;\n    max-width: 90%;\n    object-fit: contain;\n    transform: rotate(-9deg);\n    filter: saturate(1.12) contrast(1.05) drop-shadow(0 22px 30px rgba(0,0,0,0.74));\n  }\n\n  .hn-member-access__card-body {\n    padding: 0 2px;\n    display: flex;\n    flex-direction: column;\n    min-height: 170px;\n    flex: 1 1 auto;\n  }\n\n  .hn-member-access__card-body h3 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(25px, 2.05vw, 34px);\n    line-height: 0.95;\n    font-