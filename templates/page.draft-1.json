ound: radial-gradient(circle, rgba(33, 220, 165, 0.24), rgba(219, 162, 15, 0.12) 38%, transparent 70%);\n    filter: blur(34px);\n    opacity: 0.9;\n    z-index: 4;\n    animation: hnFightPulse 4.5s ease-in-out infinite;\n    pointer-events: none;\n  }\n\n  .hn-fight-video-hero__content {\n    position: relative;\n    z-index: 6;\n    width: min(1100px, calc(100% - 32px));\n    text-align: center;\n    color: #fff;\n    transform: translateY(-2vh);\n    will-change: opacity, transform;\n  }\n\n  .hn-fight-video-hero__kicker {\n    margin: 0 0 12px;\n    color: rgba(255,255,255,0.95);\n    font-size: clamp(13px, 1.2vw, 17px);\n    line-height: 1.2;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    text-shadow: 0 3px 18px rgba(0,0,0,0.55);\n  }\n\n  .hn-fight-video-hero__title {\n    margin: 0;\n    font-size: clamp(54px, 8vw, 110px);\n    line-height: 0.95;\n    font-weight: 900;\n    letter-spacing: -0.065em;\n    background-image: linear-gradient(\n      90deg,\n      #dba20f 0%,\n      #9fb562 27%,\n      #39b7b4 55%,\n      #11c88b 78%,\n      #0c9649 100%\n    );\n    background-size: 120% 100%;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    filter: drop-shadow(0 16px 34px rgba(0,0,0,0.46));\n  }\n\n  .hn-fight-video-hero__subline {\n    width: min(760px, 100%);\n    margin: 18px auto 0;\n    color: rgba(255,255,255,0.94);\n    font-size: clamp(15px, 1.35vw, 19px);\n    line-height: 1.45;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n    text-shadow: 0 3px 18px rgba(0,0,0,0.58);\n  }\n\n  .hn-fight-video-hero__scroll {\n    margin-top: 42px;\n    color: rgba(255,255,255,0.9);\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    animation: hnFightScroll 1.25s ease-in-out infinite;\n    text-shadow: 0 3px 16px rgba(0,0,0,0.55);\n  }\n\n  .hn-fight-video-hero__frame {\n    position: absolute;\n    z-index: 8;\n    left: 50%;\n    top: 50%;\n    width: min(1380px, calc(100% - 28px));\n    aspect-ratio: 21 / 9;\n    transform: translate(-50%, -50%) scale(1.12);\n    opacity: 0;\n    overflow: hidden;\n    border-radius: 28px;\n    border: 1.5px solid rgba(255,255,255,0.42);\n    background: #000;\n    box-shadow:\n      0 34px 100px rgba(0,0,0,0.38),\n      inset 0 0 0 1px rgba(255,255,255,0.16);\n    will-change: opacity, transform;\n    pointer-events: none;\n  }\n\n  .hn-fight-video-hero__frame::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 8;\n    pointer-events: none;\n    border-radius: inherit;\n    background:\n      linear-gradient(to bottom, rgba(255,255,255,0.1), transparent 22%, rgba(0,0,0,0.03) 100%);\n  }\n\n  .hn-fight-video-hero__main-video {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(0%) saturate(118%) contrast(1.02) brightness(1.12);\n    opacity: 0;\n    will-change: opacity;\n  }\n\n  .hn-fight-video-hero__panels {\n    position: absolute;\n    inset: 0;\n    z-index: 3;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n    overflow: visible;\n    will-change: opacity;\n  }\n\n  .hn-fight-video-hero__panel {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #000;\n    border-radius: 22px;\n    box-shadow: 0 24px 70px rgba(0,0,0,0.28);\n    will-change: transform, border-radius;\n  }\n\n  .hn-fight-video-hero__panel video {\n    position: absolute;\n    top: 0;\n    height: 100%;\n    width: 300%;\n    object-fit: cover;\n    filter: grayscale(0%) saturate(115%) contrast(1.02) brightness(1.08);\n  }\n\n  .hn-fight-video-hero__panel--left video {\n    left: 0;\n  }\n\n  .hn-fight-video-hero__panel--center video {\n    left: -100%;\n  }\n\n  .hn-fight-video-hero__panel--right video {\n    left: -200%;\n  }\n\n  @keyframes hnFightPulse {\n    0%, 100% {\n      opacity: 0.65;\n      transform: translate(-50%, -50%) scale(0.94);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.08);\n    }\n  }\n\n  @keyframes hnFightScroll {\n    0%, 100% {\n      transform: translateY(0);\n      opacity: 0.72;\n    }\n\n    50% {\n      transform: translateY(7px);\n      opacity: 1;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-fight-video-hero {\n      height: 140vh;\n    }\n\n    .hn-fight-video-hero__sticky {\n      min-height: 620px;\n    }\n\n    .hn-fight-video-hero__content {\n      width: min(100%, calc(100% - 24px));\n    }\n\n    .hn-fight-video-hero__kicker {\n      font-size: 13px;\n      margin-bottom: 10px;\n    }\n\n    .hn-fight-video-hero__title {\n      font-size: clamp(48px, 15vw, 76px);\n      letter-spacing: -0.06em;\n    }\n\n    .hn-fight-video-hero__subline {\n      max-width: 340px;\n      font-size: 15px;\n    }\n\n    .hn-fight-video-hero__scroll {\n      margin-top: 34px;\n      font-size: 11px;\n    }\n\n    .hn-fight-video-hero__frame {\n      width: min(390px, calc(100% - 34px));\n      aspect-ratio: 9 / 16;\n      border-radius: 22px;\n    }\n\n    .hn-fight-video-hero__panels {\n      gap: 8px;\n    }\n\n    .hn-fight-video-hero__panel {\n      border-radius: 14px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var section = document.getElementById('hnFightVideoHero');\n    if (!section) return;\n\n    var desktopVideo = 'https://cdn.shopify.com/videos/c/o/v/ce41e89287c0430e9d9c2d5d1d105beb.mp4';\n    var mobileVideo = 'https://cdn.shopify.com/videos/c/o/v/04e8c483b0904cc1bfd6c5ce8645d553.mp4';\n\n    var content = section.querySelector('.hn-fight-video-hero__content');\n    var bgVideo = section.querySelector('.hn-fight-video-hero__bg-video');\n    var frame = section.querySelector('.hn-fight-video-hero__frame');\n    var mainVideo = section.querySelector('.hn-fight-video-hero__main-video');\n    var panelsWrap = section.querySelector('.hn-fight-video-hero__panels');\n    var panels = section.querySelectorAll('.hn-fight-video-hero__panel');\n    var allVideos = section.querySelectorAll('.js-hn-fight-video');\n\n    var currentSrc = '';\n    var videosLoaded = false;\n    var ticking = false;\n\n    function getVideoSrc() {\n      return window.matchMedia('(max-width: 749px)').matches ? mobileVideo : desktopVideo;\n    }\n\n    function loadVideosOnlyAfterScroll() {\n      if (videosLoaded) return;\n\n      var rect = section.getBoundingClientRect();\n      var sectionIsNear = rect.top < window.innerHeight * 1.15 && rect.bottom > -window.innerHeight * 0.25;\n      var userHasScrolled = window.scrollY > 20 || window.pageYOffset > 20;\n\n      if (!sectionIsNear || !userHasScrolled) return;\n\n      videosLoaded = true;\n      currentSrc = getVideoSrc();\n\n      allVideos.forEach(function (video) {\n        video.src = currentSrc;\n        video.muted = true;\n        video.loop = true;\n        video.playsInline = true;\n        video.preload = 'auto';\n        video.load();\n\n        var playPromise = video.play();\n        if (playPromise && typeof playPromise.catch === 'function') {\n          playPromise.catch(function () {});\n        }\n      });\n    }\n\n    function updateVideoSourceOnResize() {\n      if (!videosLoaded) return;\n\n      var nextSrc = getVideoSrc();\n      if (nextSrc === currentSrc) return;\n\n      currentSrc = nextSrc;\n\n      allVideos.forEach(function (video) {\n        var oldTime = video.currentTime || 0;\n\n        video.src = currentSrc;\n        video.load();\n\n        video.addEventListener('loadedmetadata', function setTimeOnce() {\n          video.removeEventListener('loadedmetadata', setTimeOnce);\n\n          try {\n            video.currentTime = oldTime;\n          } catch (e) {}\n\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        });\n      });\n    }\n\n    function syncVideos() {\n      if (!videosLoaded || !mainVideo || !mainVideo.duration) return;\n\n      allVideos.forEach(function (video) {\n        if (video === mainVideo) return;\n        if (!video.duration) return;\n\n        var diff = Math.abs(video.currentTime - mainVideo.currentTime);\n\n        if (diff > 0.18) {\n          try {\n            video.currentTime = mainVideo.currentTime;\n          } catch (e) {}\n        }\n\n        if (video.paused) {\n          var playPromise = video.play();\n          if (playPromise && typeof playPromise.catch === 'function') {\n            playPromise.catch(function () {});\n          }\n        }\n      });\n    }\n\n    function clamp(value, min, max) {\n      return Math.min(Math.max(value, min), max);\n    }\n\n    function easeOutCubic(x) {\n      return 1 - Math.pow(1 - x, 3);\n    }\n\n    function updateHero() {\n      loadVideosOnlyAfterScroll();\n\n      var rect = section.getBoundingClientRect();\n      var total = section.offsetHeight - window.innerHeight;\n      var progress = total > 0 ? clamp(-rect.top / total, 0, 1) : 0;\n\n      var textFade = easeOutCubic(clamp(progress / 0.28, 0, 1));\n      var frameIn = easeOutCubic(clamp((progress - 0.16) / 0.24, 0, 1));\n      var merge = easeOutCubic(clamp((progress - 0.42) / 0.34, 0, 1));\n      var finalVideo = easeOutCubic(clamp((progress - 0.66) / 0.18, 0, 1));\n\n      if (content) {\n        content.style.opacity = 1 - textFade;\n        content.style.transform =\n          'translateY(' + (-2 - textFade * 9) + 'vh) scale(' + (1 - textFade * 0.035) + ')';\n      }\n\n      if (bgVideo) {\n        bgVideo.style.opacity = 1 - frameIn * 0.5;\n        bgVideo.style.transform = 'scale(' + (1.08 + progress * 0.08) + ')';\n      }\n\n      if (frame) {\n        frame.style.opacity = frameIn;\n        frame.style.transform =\n          'translate(-50%, -50%) scale(' + (1.12 - frameIn * 0.12) + ')';\n      }\n\n      if (panelsWrap) {\n        panelsWrap.style.gap = (18 - merge * 18) + 'px';\n        panelsWrap.style.opacity = 1 - finalVideo;\n      }\n\n      if (mainVideo) {\n        mainVideo.style.opacity = finalVideo;\n      }\n\n      if (panels.length) {\n        var isMobile = window.matchMedia('(max-width: 749px)').matches;\n        var startMove = isMobile ? 12 : 18;\n        var sideMove = startMove - merge * startMove;\n        var centerDrop = 10 - merge * 10;\n        var radius = isMobile ? 14 - merge * 14 : 22 - merge * 22;\n\n        panels[0].style.transform = 'translateX(-' + sideMove + 'vw)';\n        panels[1].style.transform = 'translateY(' + centerDrop + 'vh)';\n        panels[2].style.transform = 'translateX(' + sideMove + 'vw)';\n\n        panels.forEach(function (panel) {\n          panel.style.borderRadius = radius + 'px';\n        });\n      }\n\n      ticking = false;\n    }\n\n    function requestTick() {\n      if (!ticking) {\n        window.requestAnimationFrame(updateHero);\n        ticking = true;\n      }\n    }\n\n    window.addEventListener('scroll', requestTick, { passive: true });\n\n    window.addEventListener('resize', function () {\n      updateVideoSourceOnResize();\n      requestTick();\n    });\n\n    setInterval(syncVideos, 900);\n\n    updateHero();\n  })();\n</script>",
