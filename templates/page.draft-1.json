rm: translateX(-130%);\n    transition: transform 520ms cubic-bezier(.2,.8,.2,1);\n  }\n\n  .hn-closing-cta__button:hover::after {\n    transform: translateX(130%);\n  }\n\n  @keyframes hnClosingReveal {\n    from {\n      opacity: 0;\n      transform: translateY(16px);\n    }\n\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes hnClosingGlow {\n    0%, 100% {\n      transform: translate3d(0, 0, 0) scale(0.94);\n      opacity: 0.28;\n    }\n\n    50% {\n      transform: translate3d(3vw, -2vw, 0) scale(1.08);\n      opacity: 0.42;\n    }\n  }\n\n\n  @media screen and (max-width: 749px) {\n    .hn-closing-cta {\n      min-height: 82vh;\n      padding: 76px 14px;\n    }\n\n    .hn-closing-cta__inner {\n      padding: 34px 20px;\n      border-radius: 30px;\n    }\n\n\n    .hn-closing-cta__title {\n      font-size: clamp(42px, 12vw, 58px);\n      letter-spacing: -0.07em;\n    }\n\n    .hn-closing-cta__text {\n      margin-top: 20px;\n      font-size: 16px;\n    }\n\n    .hn-closing-cta__button {\n      width: 100%;\n      justify-content: center;\n      min-height: 56px;\n      margin-top: 30px;\n      font-size: 14px;\n    }\n\n    .hn-closing-cta__button-icon {\n      width: 40px;\n      height: 40px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-closing-cta__glow {\n      animation: none !important;\n    }\n\n    .hn-closing-cta__eyebrow,\n    .hn-closing-cta__title,\n    .hn-closing-cta__text,\n    .hn-closing-cta__button,\n    .hn-closing-cta__button::before,\n    .hn-closing-cta__button::after,\n    .hn-closing-cta__note,\n    .hn-closing-cta__arrow {\n      transition: none !important;\n    }\n  }\n</style>\n<style>\n  /* Closing CTA size reduction */\n  .hn-closing-cta {\n    min-height: 72vh !important;\n    padding: clamp(68px, 7vw, 110px) 20px !important;\n  }\n\n  .hn-closing-cta__inner {\n    width: min(820px, 100%) !important;\n    padding: clamp(28px, 4vw, 48px) !important;\n  }\n\n\n  .hn-closing-cta__title {\n    max-width: 720px !important;\n    font-size: clamp(34px, 4.8vw, 68px) !important;\n    line-height: 0.95 !important;\n    letter-spacing: -0.06em !important;\n  }\n\n  .hn-closing-cta__text {\n    width: min(560px, 100%) !important;\n    margin-top: 18px !important;\n    font-size: clamp(15px, 1.15vw, 18px) !important;\n    line-height: 1.45 !important;\n  }\n\n  .hn-closing-cta__button {\n    min-height: 52px !important;\n    margin-top: 28px !important;\n    font-size: 14px !important;\n    padding: 7px 16px 7px 7px !important;\n  }\n\n  .hn-closing-cta__button-icon {\n    width: 38px !important;\n    height: 38px !important;\n  }\n\n  .hn-closing-cta__note {\n    margin-top: 14px !important;\n    font-size: 12px !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    .hn-closing-cta {\n      min-height: 70vh !important;\n      padding: 58px 14px !important;\n    }\n\n    .hn-closing-cta__inner {\n      padding: 28px 18px !important;\n      border-radius: 26px !important;\n    }\n\n\n    .hn-closing-cta__title {\n      font-size: clamp(32px, 9.5vw, 44px) !important;\n      line-height: 0.98 !important;\n    }\n\n    .hn-closing-cta__text {\n      margin-top: 16px !important;\n      font-size: 14px !important;\n      line-height: 1.42 !important;\n    }\n\n    .hn-closing-cta__button {\n      margin-top: 24px !important;\n      min-height: 50px !important;\n      font-size: 13px !important;\n    }\n  }\n</style>\n<style>\n  /* Typography style like the screenshot */\n  .hn-closing-cta {\n    font-family: inherit !important;\n  }\n\n  .hn-closing-cta__eyebrow {\n    font-size: 12px !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.12em !important;\n  }\n\n  .hn-closing-cta__title {\n    font-size: clamp(26px, 3vw, 42px) !important;\n    line-height: 1.12 !important;\n    font-weight: 750 !important;\n    letter-spacing: -0.035em !important;\n  }\n\n  .hn-closing-cta__text {\n    font-size: clamp(15px, 1.2vw, 17px) !im