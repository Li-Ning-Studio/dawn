      "settings": {
        "custom_liquid": "<section class=\"hn-duel-upgrade\" id=\"hnDuelUpgrade\" aria-label=\"Prime Trinity to Evolution Series upgrade comparison\">\n\n  <div class=\"hn-duel-upgrade__intro\">\n    <p class=\"hn-duel-upgrade__eyebrow\">Prime Trinity → Evolution Series</p>\n    <h2 class=\"hn-duel-upgrade__main-title\">Same game. New gear ceiling.</h2>\n    <p class=\"hn-duel-upgrade__main-copy\">\n      Three familiar playing styles, rebuilt with sharper speed, heavier response, and cleaner control.\n    </p>\n  </div>\n\n  <article\n    class=\"hn-duel-upgrade__scene hn-duel-upgrade__scene--attack\"\n    data-duel-scene\n    style=\"\n      --accent: #dba20f;\n      --accent-rgb: 219, 162, 15;\n      --side-glow: rgba(219, 162, 15, 0.26);\n    \"\n  >\n    <div class=\"hn-duel-upgrade__sticky\">\n      <div class=\"hn-duel-upgrade__bg\"></div>\n\n      <div class=\"hn-duel-upgrade__split\">\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--prime\">\n          <div class=\"hn-duel-upgrade__label\">\n            <span>Prime Trinity</span>\n            <strong>Nitrix 10</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--prime\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_fe068018-61b0-4d27-a662-e5df945e4492.png?v=1769778461&width=1200\"\n            alt=\"Nitrix 10 racket\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1200\"\n          >\n        </div>\n\n        <div class=\"hn-duel-upgrade__side hn-duel-upgrade__side--evo\">\n          <div class=\"hn-duel-upgrade__label hn-duel-upgrade__label--right\">\n            <span>Evolution Series</span>\n            <strong>Nitrix Thunder</strong>\n          </div>\n\n          <img\n            class=\"hn-duel-upgrade__racket hn-duel-upgrade__racket--evo\"\n            src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1200\"\n            alt=