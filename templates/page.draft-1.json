    "custom_liquid_hQRmh8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hn-weapon-quiz\" id=\"hnWeaponQuiz\" aria-label=\"HNDRD racket finder quiz\">\n  <div class=\"hn-weapon-quiz__bg\">\n    <span class=\"hn-weapon-quiz__orb hn-weapon-quiz__orb--one\"></span>\n    <span class=\"hn-weapon-quiz__orb hn-weapon-quiz__orb--two\"></span>\n    <span class=\"hn-weapon-quiz__grid\"></span>\n  </div>\n\n  <div class=\"hn-weapon-quiz__wrap\">\n\n    <div class=\"hn-weapon-quiz__intro is-active\" data-quiz-screen=\"intro\">\n      <p class=\"hn-weapon-quiz__eyebrow\">HNDRD Racket Finder</p>\n\n      <h2>\n        Find Your<br>\n        Weapon.\n      </h2>\n\n      <p class=\"hn-weapon-quiz__intro-copy\">\n        Answer a few quick questions. We’ll match you with the rackets that fit the way you play.\n      </p>\n\n      <button class=\"hn-weapon-quiz__start\" type=\"button\" data-quiz-start>\n        <span>Start Match</span>\n        <b>+</b>\n      </button>\n\n      <div class=\"hn-weapon-quiz__series-line\">\n        <span>Prime Trinity</span>\n        <span>Evolution Series</span>\n        <span>Pro Series</span>\n      </div>\n    </div>\n\n    <div class=\"hn-weapon-quiz__quiz\" data-quiz-screen=\"quiz\" aria-hidden=\"true\">\n      <div class=\"hn-weapon-quiz__topbar\">\n        <button class=\"hn-weapon-quiz__back\" type=\"button\" data-quiz-back>\n          ← Back\n        </button>\n\n        <div class=\"hn-weapon-quiz__progress\">\n          <span data-quiz-progress-fill></span>\n        </div>\n\n        <p data-quiz-count>01 / 05</p>\n      </div>\n\n      <div class=\"hn-weapon-quiz__step-shell\">\n        <article class=\"hn-weapon-quiz__step-card\" data-quiz-step-card>\n          <p class=\"hn-weapon-quiz__step-kicker\" data-quiz-step-kicker>Step 01</p>\n\n          <h3 data-quiz-question>\n            How often do you play?\n          </h3>\n\n          <p class=\"hn-weapon-quiz__step-copy\" data-quiz-helper>\n            This helps us pick the right level. No overkill. No underpowered picks.\n          </p>\n\n          <div class=\"hn-weapon-quiz__options\" data-quiz-options></div>\n        </article>\n      </div>\n    </div>\n\n    <div class=\"hn-weapon-quiz__result\" data-quiz-screen=\"result\" aria-hidden=\"true\">\n      <div class=\"hn-weapon-quiz__result-head\">\n        <p class=\"hn-weapon-quiz__eyebrow\">Your Match Is Ready</p>\n\n        <h2>\n          Built for<br>\n          your game.\n        </h2>\n\n        <p>\n          We picked the strongest match first, then added two close alternatives worth checking.\n        </p>\n      </div>\n\n      <div class=\"hn-weapon-quiz__result-grid\">\n        <article class=\"hn-weapon-quiz__main-result\" data-main-result></article>\n\n        <aside class=\"hn-weapon-quiz__side-results\">\n          <div class=\"hn-weapon-quiz__result-actions\">\n            <button type=\"button\" class=\"hn-weapon-quiz__compare-btn\" data-open-compare>\n              Compare Matches\n              <span>+</span>\n            </button>\n\n            <button type=\"button\" class=\"hn-weapon-quiz__restart\" data-quiz-restart>\n              Retake Quiz\n            </button>\n          </div>\n\n          <div class=\"hn-weapon-quiz__also\" data-also-results></div>\n        </aside>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"hn-weapon-quiz__modal\" data-compare-modal aria-hidden=\"true\">\n    <button type=\"button\" class=\"hn-weapon-quiz__modal-bg\" data-close-compare aria-label=\"Close comparison\"></button>\n\n    <div class=\"hn-weapon-quiz__modal-panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Compare recommended rackets\">\n      <div class=\"hn-weapon-quiz__modal-head\">\n        <div>\n          <p>Compare Your Matches</p>\n          <h3>Pick the one that feels right.</h3>\n        </div>\n\n        <button type=\"button\" data-close-compare>\n          Close\n        </button>\n      </div>\n\n      <div class=\"hn-weapon-quiz__compare-grid\" data-compare-grid></div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-weapon-quiz,\n  .hn-weapon-quiz *,\n  .hn-weapon-quiz *::before,\n  .hn-weapon-quiz *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-weapon-quiz {\n    position: relative;\n    width: 100%;\n    min-height: 100vh;\n    overflow: hidden;\n    background: #000;\n    color: #fff;\n    font-family: inherit;\n    isolation: isolate;\n  }\n\n  .hn-weapon-quiz__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 50% -12%, rgba(255,255,255,.075), transparent 32%),\n      radial-gradient(circle at 18% 22%, rgba(146,254,157,.12), transparent 30%),\n      radial-gradient(circle at 82% 20%, rgba(0,201,255,.11), transparent 32%),\n      linear-gradient(180deg, #000 0%, #030303 48%, #000 100%);\n  }\n\n  .hn-weapon-quiz__grid {\n    position: absolute;\n    inset: 0;\n    opacity: .09;\n    background:\n      linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);\n    background-size: 58px 58px;\n    mask-image: radial-gradient(circle at 50% 42%, #000 0%, transparent 72%);\n  }\n\n  .hn-weapon-quiz__orb {\n    position: absolute;\n    width: 44vw;\n    height: 44vw;\n    min-width: 420px;\n    min-height: 420px;\n    border-radius: 999px;\n    filter: blur(60px);\n    opacity: .42;\n    pointer-events: none;\n    animation: hnWeaponFloat 7s ease-in-out infinite;\n  }\n\n  .hn-weapon-quiz__orb--one {\n    left: -14%;\n    top: 20%;\n    background: radial-gradient(circle, rgba(146,254,157,.24), transparent 66%);\n  }\n\n  .hn-weapon-quiz__orb--two {\n    right: -16%;\n    top: 10%;\n    background: radial-gradient(circle, rgba(0,201,255,.24), transparent 66%);\n    animation-delay: -2.4s;\n  }\n\n  .hn-weapon-quiz__wrap {\n    position: relative;\n    z-index: 2;\n    width: min(1280px, 100%);\n    min-height: 100vh;\n    margin: 0 auto;\n    padding: clamp(70px, 9vh, 110px) 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .hn-weapon-quiz__intro,\n  .hn-weapon-quiz__quiz,\n  .hn-weapon-quiz__result {\n    display: none;\n    width: 100%;\n  }\n\n  .hn-weapon-quiz__intro.is-active,\n  .hn-weapon-quiz__quiz.is-active,\n  .hn-weapon-quiz__result.is-active {\n    display: block;\n    animation: hnWeaponScreenIn .52s cubic-bezier(.2,.8,.2,1) both;\n  }\n\n  .hn-weapon-quiz__intro {\n    text-align: center;\n    max-width: 980px;\n    margin: 0 auto;\n  }\n\n  .hn-weapon-quiz__eyebrow,\n  .hn-weapon-quiz__step-kicker {\n    margin: 0 0 16px;\n    color: rgba(255,255,255,.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .hn-weapon-quiz__intro h2,\n  .hn-weapon-quiz__result-head h2 {\n    margin: 0;\n    font-size: clamp(56px, 9vw, 132px);\n    line-height: .82;\n    font-weight: 950;\n    letter-spacing: -.085em;\n    background-image: linear-gradient(to right, #92fe9d 0%, #00c9ff 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    text-shadow: 0 22px 60px rgba(0,0,0,.9);\n  }\n\n  .hn-weapon-quiz__intro-copy,\n  .hn-weapon-quiz__result-head p {\n    width: min(660px, 100%);\n    margin: 24px auto 0;\n    color: rgba(255,255,255,.84);\n    font-size: clamp(15px, 1.25vw, 19px);\n    line-height: 1.55;\n    font-weight: 650;\n    letter-spacing: -.018em;\n    text-shadow: 0 12px 34px rgba(0,0,0,.82);\n  }\n\n  .hn-weapon-quiz__start {\n    margin: 38px auto 0;\n    min-height: 58px;\n    padding: 0 18px 0 30px;\n    border: 1.5px solid transparent;\n    border-radius: 999px;\n    background:\n      linear-gradient(#050505, #050505) padding-box,\n      linear-gradient(90deg, #92fe9d, #00c9ff) border-box;\n    color: #fff;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 950;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    cursor: pointer;\n    box-shadow:\n      0 0 30px rgba(0,201,255,.18),\n      0 0 24px rgba(146,254,157,.12);\n    transition: transform .25s ease, box-shadow .25s ease;\n  }\n\n  .hn-weapon-quiz__start b {\n    width: 38px;\n    height: 38px;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(135deg, #92fe9d, #00c9ff);\n    color: #000;\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 900;\n    transition: transform .25s ease;\n  }\n\n  .hn-weapon-quiz__start:hover {\n    transform: translateY(-3px);\n    box-shadow:\n      0 0 42px rgba(0,201,255,.32),\n      0 0 32px rgba(146,254,157,.24);\n  }\n\n  .hn-weapon-quiz__start:hover b {\n    transform: rotate(90deg);\n  }\n\n  .hn-weapon-quiz__series-line {\n    width: min(720px, 100%);\n    margin: 34px auto 0;\n    display: flex;\n    justify-content: center;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .hn-weapon-quiz__series-line span {\n    min-height: 32px;\n    padding: 0 13px;\n    border-radius: 999px;\n    background: rgba(255,255,255,.06);\n    border: 1px solid rgba(255,255,255,.08);\n    color: rgba(255,255,255,.72);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .hn-weapon-quiz__quiz {\n    max-width: 1060px;\n    margin: 0 auto;\n  }\n\n  .hn-weapon-quiz__topbar {\n    width: 100%;\n    display: grid;\n    grid-template-columns: 100px 1fr 82px;\n    align-items: center;\n    gap: 16px;\n    margin-bottom: 28px;\n  }\n\n  .hn-weapon-quiz__back {\n    min-height: 38px;\n    border: 1px solid rgba(255,255,255,.1);\n    border-radius: 999px;\n    background: rgba(255,255,255,.04);\n    color: rgba(255,255,255,.72);\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    cursor: pointer;\n  }\n\n  .hn-weapon-quiz__progress {\n    position: relative;\n    height: 3px;\n    border-radius: 999px;\n    overflow: hidden;\n    background: rgba(255,255,255,.09);\n  }\n\n  .hn-weapon-quiz__progress span {\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 20%;\n    border-radius: inherit;\n    background: linear-gradient(90deg, #92fe9d, #00c9ff);\n    box-shadow: 0 0 18px rgba(0,201,255,.42);\n    transition: width .38s ease;\n  }\n\n  .hn-weapon-quiz__topbar p {\n    margin: 0;\n    text-align: right;\n    color: rgba(255,255,255,.62);\n    font-size: 11px;\n    font-weight: 950;\n    letter-spacing: .12em;\n  }\n\n  .hn-weapon-quiz__step-card {\n    position: relative;\n    overflow: hidden;\n    border-radius: 42px;\n    padding: clamp(30px, 5vw, 58px);\n    min-height: 560px;\n    background:\n      radial-gradient(circle at 72% 18%, rgba(0,201,255,.13), transparent 30%),\n      radial-gradient(circle at 24% 20%, rgba(146,254,157,.12), transparent 30%),\n      linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.018)),\n      rgba(3,3,3,.94);\n    border: 1px solid rgba(255,255,255,.12);\n    box-shadow:\n      0 34px 110px rgba(0,0,0,.62),\n      inset 0 0 0 1px rgba(255,255,255,.035);\n    isolation: isolate;\n  }\n\n  .hn-weapon-quiz__step-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    background:\n      linear-gradient(115deg, transparent 0%, transparent 40%, rgba(255,255,255,.1) 50%, transparent 60%, transparent 100%);\n    transform: translateX(-120%);\n    animation: hnWeaponSweep 4.8s ease-in-out infinite;\n  }\n\n  .hn-weapon-quiz__step-card h3 {\n    margin: 0;\n    max-width: 780px;\n    color: #fff;\n    font-size: clamp(38px, 5.2vw, 82px);\n    line-height: .9;\n    font-weight: 950;\n    letter-spacing: -.0