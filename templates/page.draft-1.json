    "custom_liquid_bEGzbp": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  HNDRD MATCH-POINT COUNTDOWN\n  Paste this complete block inside a Shopify Custom Liquid section.\n\n  Concept:\n  - Opens mid-rally\n  - A single glowing shuttle follows a curved trajectory\n  - The landing point determines the winning series\n  - The winning series expands to take over the screen\n  - Refresh randomizes which series wins first\n{% endcomment %}\n\n{% assign hmp_id = section.id | default: 'hndrd-match-point' %}\n\n<section id=\"hmp-{{ hmp_id }}\" class=\"hmp\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hmp__court\" aria-hidden=\"true\">\n    <span class=\"hmp__court-line hmp__court-line--v\"></span>\n    <span class=\"hmp__court-line hmp__court-line--h1\"></span>\n    <span class=\"hmp__court-line hmp__court-line--h2\"></span>\n  </div>\n\n  <div class=\"hmp__topbar\">\n    <span>HNDRD MATCH POINT</span>\n    <span class=\"hmp__status\">RALLY IN PLAY</span>\n  </div>\n\n  <div class=\"hmp__score\" aria-hidden=\"true\">\n    <span class=\"hmp__score-label\">MATCH POINT</span>\n    <span class=\"hmp__score-number\">03</span>\n  </div>\n\n  <div class=\"hmp__rally\" aria-hidden=\"true\">\n    <svg class=\"hmp__trajectory\" viewBox=\"0 0 1600 900\" preserveAspectRatio=\"none\">\n      <path class=\"hmp__trajectory-path\" d=\"M 120 620 C 420 120, 1050 120, 1470 610\"></path>\n    </svg>\n\n    <div class=\"hmp__shuttle\">\n      <span class=\"hmp__shuttle-head\"></span>\n      <span class=\"hmp__shuttle-feather hmp__shuttle-feather--1\"></span>\n      <span class=\"hmp__shuttle-feather hmp__shuttle-feather--2\"></span>\n      <span class=\"hmp__shuttle-feather hmp__shuttle-feather--3\"></span>\n    </div>\n\n    <div class=\"hmp__impact\"></div>\n  </div>\n\n  <div class=\"hmp__series-grid\">\n    <article\n      class=\"hmp__series\"\n      data-series=\"0\"\n      data-label=\"PRO SERIES\"\n      data-kicker=\"Built for the highest level\"\n      data-tag=\"PERFORMANCE\"\n      data-link=\"https://in.hndrd.co/pages/pro-series-rackets\"\n      data-cta=\"Explore Pro Series\"\n      data-rackets=\"Nitrix 70 Venom|Nitrix 70 Volta|Hyfonic 7|Flareon 700\"\n      style=\"--tone:255,102,0;\"\n    >\n      <span class=\"hmp__series-index\">01</span>\n      <h2>PRO<br>SERIES</h2>\n      <span class=\"hmp__series-note\">POWER SYSTEM</span>\n    </article>\n\n    <article\n      class=\"hmp__series\"\n      data-series=\"1\"\n      data-label=\"PRIME TRINITY\"\n      data-kicker=\"One game. Three expressions.\"\n      data-tag=\"THREE PERSONALITIES\"\n      data-link=\"https://in.hndrd.co/pages/the-prime-trinity\"\n      data-cta=\"Explore Prime Trinity\"\n      data-rackets=\"Nitrix 10|Flareon 100|Hyfonic 1\"\n      style=\"--tone:214,255,34;\"\n    >\n      <span class=\"hmp__series-index\">02</span>\n      <h2>PRIME<br>TRINITY</h2>\n      <span class=\"hmp__series-note\">THREE EXPRESSIONS</span>\n    </article>\n\n    <article\n      class=\"hmp__series\"\n      data-series=\"2\"\n      data-label=\"EVOLUTION SERIES\"\n      data-kicker=\"Attack. Speed. Precision.\"\n      data-tag=\"EVOLUTION SYSTEM\"\n      data-link=\"https://in.hndrd.co/pages/pro-series\"\n      data-cta=\"Explore Evolution Series\"\n      data-rackets=\"Nitrix Thunder|Flareon Typhoon|Hyfonic Lazer\"\n      style=\"--tone:88,223,255;\"\n    >\n      <span class=\"hmp__series-index\">03</span>\n      <h2>EVOLUTION<br>SERIES</h2>\n      <span class=\"hmp__series-note\">ATTACK. SPEED. PRECISION.</span>\n    </article>\n  </div>\n\n  <div class=\"hmp__winner\" aria-live=\"polite\">\n    <div class=\"hmp__winner-wash\"></div>\n\n    <div class=\"hmp__winner-top\">\n      <span class=\"hmp__winner-count\">01 / 03</span>\n      <span class=\"hmp__winner-tag\">PERFORMANCE</span>\n    </div>\n\n    <div class=\"hmp__winner-copy\">\n      <p class=\"hmp__winner-kicker\">Built for the highest level</p>\n      <h2 class=\"hmp__winner-title\">PRO SERIES</h2>\n\n      <ul class=\"hmp__winner-list\">\n        <li>Nitrix 70 Venom</li>\n        <li>Nitrix 70 Volta</li>\n        <li>Hyfonic 7</li>\n        <li>Flareon 700</li>\n      </ul>\n\n      <a class=\"hmp__winner-cta\" href=\"https://in.hndrd.co/pages/pro-series-rackets\">\n        <span>Explore Pro Series</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M5 12h13M13 6l6 6-6 6\"/>\n        </svg>\n      </a>\n    </div>\n\n    <button class=\"hmp__replay\" type=\"button\">\n      <span>Replay Rally</span>\n    </button>\n\n    <div class=\"hmp__winner-ghost\" aria-hidden=\"true\">01</div>\n  </div>\n</section>\n\n<style>\n  #hmp-{{ hmp_id }} {\n    --bg:#050505;\n    --line:rgba(255,255,255,.1);\n    --muted:rgba(255,255,255,.48);\n    --ease:cubic-bezier(.2,.76,.2,1);\n    position:relative;\n    min-height:min(860px,94vh);\n    overflow:hidden;\n    background:\n      radial-gradient(circle at 50% 46%,rgba(255,255,255,.035),transparent 34%),\n      linear-gradient(180deg,#070707,#020202);\n    color:#fff;\n    font-family:Figtree,Arial,sans-serif;\n  }\n\n  #hmp-{{ hmp_id }} *,\n  #hmp-{{ hmp_id }} *::before,\n  #hmp-{{ hmp_id }} *::after {\n    box-sizing:border-box;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court {\n    position:absolute;\n    inset:0;\n    pointer-events:none;\n    opacity:.5;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court::before,\n  #hmp-{{ hmp_id }} .hmp__court::after {\n    content:\"\";\n    position:absolute;\n    inset:14% 7%;\n    border:1px solid rgba(255,255,255,.055);\n    transform:perspective(900px) rotateX(64deg);\n    transform-origin:center bottom;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court::after {\n    inset:24% 19%;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court-line {\n    position:absolute;\n    background:rgba(255,255,255,.04);\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court-line--v {\n    top:16%;\n    bottom:12%;\n    left:50%;\n    width:1px;\n  }\n\n  #hmp-{{ hmp_id }} .hmp__court-line--h1 {\n    left:10%;\n    right:10%;\n    top:44%;\n    height:1px;\n  }\n\n 