    "custom_liquid_CXTRQN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD EVOLUTION SERIES - STATIC GRID -->\n<section class=\"hn-evo-series\" aria-label=\"The Evolution Series\">\n  <div class=\"hn-evo-series__inner\">\n\n    <header class=\"hn-evo-series__header\">\n      <p class=\"hn-evo-series__eyebrow\">HNDRD RACKETS</p>\n      <h2 class=\"hn-evo-series__title\">The Evolution Series.</h2>\n      <p class=\"hn-evo-series__subline\">Same DNA. Built to go further.</p>\n    </header>\n\n    <div class=\"hn-evo-series__grid\">\n\n      <article class=\"hn-evo-card\" style=\"--delay: 0ms;\">\n        <a class=\"hn-evo-card__media\" href=\"https://in.hndrd.co/products/nitrix-thunder\" aria-label=\"Shop Nitrix Thunder\">\n          <img\n            src=\"https://in.hndrd.co/cdn/shop/files/1_61438e45-47d6-44b0-8d8d-443a3e768a2c.png?v=1761638113&width=1200\"\n            alt=\"Nitrix Thunder badminton racket\"\n            loading=\"lazy\"\n          >\n          <div class=\"hn-evo-card__scrim\"></div>\n\n          <div class=\"hn-evo-card__content\">\n            <p class=\"hn-evo-card__tag\">ATTACK</p>\n            <h3 class=\"hn-evo-card__headline\">Power that ends rallies.</h3>\n            <div class=\"hn-evo-card__meta\">\n              <span>₹3,990</span>\n              <span class=\"hn-evo-card__divider\">/</span>\n              <span class=\"hn-evo-card__link\">Shop Nitrix Thunder →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n      <article class=\"hn-evo-card\" style=\"--delay: 80ms;\">\n        <a class=\"hn-evo-card__media\" href=\"https://in.hndrd.co/products/flareon-typhoon\" aria-label=\"Shop Flareon Typhoon\">\n          <img\n            src=\"https://in.hndrd.co/cdn/shop/files/1_bf94516d-de42-4e92-aeca-3b435760c245.png?v=1761634762&width=1200\"\n            alt=\"Flareon Typhoon badminton racket\"\n            loading=\"lazy\"\n          >\n          <div class=\"hn-evo-card__scrim\"></div>\n\n          <div class=\"hn-evo-card__content\">\n            <p class=\"hn-evo-card__tag\">SPEED</p>\n            <h3 class=\"hn-evo-card__headline\">Speed that gets there first.</h3>\n            <div class=\"hn-evo-card__meta\">\n              <span>₹3,490</span>\n              <span class=\"hn-evo-card__divider\">/</span>\n              <span class=\"hn-evo-card__link\">Shop Flareon Typhoon →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n      <article class=\"hn-evo-card\" style=\"--delay: 160ms;\">\n        <a class=\"hn-evo-card__media\" href=\"https://in.hndrd.co/products/hyfonic-lazer-4u\" aria-label=\"Shop Hyfonic Lazer\">\n          <img\n            src=\"https://in.hndrd.co/cdn/shop/files/1_4e02ab1d-f883-4e7b-aa23-f35a0808d797.png?v=1761629738&width=1200\"\n            alt=\"Hyfonic Lazer badminton racket\"\n            loading=\"lazy\"\n          >\n          <div class=\"hn-evo-card__scrim\"></div>\n\n          <div class=\"hn-evo-card__content\">\n            <p class=\"hn-evo-card__tag\">PRECISION</p>\n            <h3 class=\"hn-evo-card__headline\">Precision that stays composed.</h3>\n            <div class=\"hn-evo-card__meta\">\n              <span>₹3,490</span>\n              <span class=\"hn-evo-card__divider\">/</span>\n              <span class=\"hn-evo-card__link\">Shop Hyfonic Lazer →</span>\n            </div>\n          </div>\n        </a>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .hn-evo-series,\n  .hn-evo-series *,\n  .hn-evo-series *::before,\n  .hn-evo-series *::after {\n    box-sizing: border-box;\n  }\n\n  .hn-evo-series {\n    width: 100%;\n    background: #0D0D0D;\n    color: #FFFFFF;\n    padding: clamp(72px, 8vw, 120px) 20px;\n    overflow: hidden;\n  }\n\n  .hn-evo-series__inner {\n    width: min(1440px, 100%);\n    margin: 0 auto;\n  }\n\n  .hn-evo-series__header {\n    max-width: 760px;\n    margin: 0 0 clamp(32px, 4vw, 56px);\n  }\n\n  .hn-evo-series__eyebrow {\n    margin: 0 0 14px;\n    color: #F5A400;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .hn-evo-series__title {\n    margin: 0;\n    color: #FFFFFF;\n    font-size: clamp(42px, 5.2vw, 78px);\n    line-height: 0.95;\n    font-weight: 760;\n    letter-spacing: -0.055em;\n  }\n\n  .hn-evo-series__subline {\n    margin: 18px 0 0;\n    color: rgba(255, 255, 255, 0.62);\n    font-size: clamp(17px, 1.5vw, 22px);\n    line-height: 1.45;\n    font-weight: 400;\n    letter-spacing: -0.02em;\n  }\n\n  .hn-evo-series__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: clamp(14px, 1.6vw, 22px);\n  }\n\n  .hn-evo-card {\n    min-width: 0;\n    opacity: 0;\n    transform: translateY(20px);\n    transition:\n      opacity 720ms ease,\n      transform 720ms ease;\n    transition-delay: var(--delay, 0ms);\n    will-change: opacity, transform;\n  }\n\n  .hn-evo-card.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .hn-evo-card__media {\n    position: relative;\n    display: block;\n    width: 100%;\n    min-height: clamp(560px, 76vh, 760px);\n    overflow: hidden;\n    background: #111111;\n    text-decoration: none;\n    color: inherit;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .hn-evo-card__media img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: center;\n    padding: clamp(28px, 4vw, 54px);\n    pointer-events: none;\n  }\n\n  .hn-evo-card__scrim {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 42%;\n    background: linear-gradient(\n      to top,\n      rgba(0, 0, 0, 0.86) 0%,\n      rgba(0, 0, 0, 0.56) 42%,\n      rgba(0, 0, 0, 0) 100%\n    );\n    pointer-events: none;\n  }\n\n  .hn-evo-card__content {\n    position: absolute;\n    left: clamp(20px, 2.2vw, 32px);\n    right: clamp(20px, 2.2vw, 32px);\n    bottom: clamp(22px, 2.6vw, 36px);\n    z-index: 2;\n  }\n\n  .hn-evo-card__tag {\n    margin: 0 0 12px;\n    color: #F5A400;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .hn-evo-card__headline {\n    margin: 0;\n    color: #FFFFFF;\n    font-size: clamp(28px, 2.35vw, 32px);\n    line-height: 1.02;\n    font-weight: 720;\n    letter-spacing: -0.045em;\n    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.42);\n    white-space: nowrap;\n  }\n\n  .hn-evo-card__meta {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    margin-top: 18px;\n    color: rgba(255, 255, 255, 0.88);\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 560;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-evo-card__divider {\n    color: rgba(255, 255, 255, 0.3);\n  }\n\n  .hn-evo-card__link {\n    color: #FFFFFF;\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 5px;\n    text-decoration-color: transparent;\n    transition: text-decoration-color 220ms ease;\n  }\n\n  .hn-evo-card__media:hover .hn-evo-card__link {\n    text-decoration-color: rgba(255, 255, 255, 0.9);\n  }\n\n  @media (max-width: 1100px) {\n    .hn-evo-series__grid {\n      grid-template-columns: 1fr;\n    }\n\n    .hn-evo-card__media {\n      min-height: 72vh;\n    }\n\n    .hn-evo-card__media img {\n      padding: clamp(24px, 7vw, 64px);\n    }\n\n    .hn-evo-card__headline {\n      white-space: normal;\n      max-width: 14ch;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .hn-evo-series {\n      padding: 64px 14px;\n    }\n\n    .hn-evo-series__header {\n      margin-bottom: 28px;\n    }\n\n    .hn-evo-card__media {\n      min-height: 620px;\n    }\n\n    .hn-evo-card__content {\n      left: 20px;\n      right: 20px;\n      bottom: 24px;\n    }\n\n    .hn-evo-card__headline {\n      font-size: 30px;\n      max-width: 12ch;\n    }\n\n    .hn-evo-card__meta {\n      flex-wrap: wrap;\n      row-gap: 10px;\n      font-size: 13px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-evo-card {\n      opacity: 1;\n      transform: none;\n      transition: none;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const cards = document.querySelectorAll('.hn-evo-card');\n\n    if (!cards.length) return;\n\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      cards.forEach((card) => card.classList.add('is-visible'));\n      return;\n    }\n\n    const observer = new IntersectionObserver((entries, activeObserver) => {\n      entries.forEach((entry) => {\n        if (!entry.isIntersecting) return;\n\n        entry.target.classList.add('is-visible');\n        activeObserver.unobserve(entry.target);\n      });\n    }, {\n      threshold: 0.18,\n      rootMargin: '0px 0px -12% 0px'\n    });\n\n    cards.forEach((card) => observer.observe(card));\n  })();\n</script>",
