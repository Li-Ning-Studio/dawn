spect-ratio: 1;\n    transform: translate(-50%, -50%);\n    border-radius: 999px;\n    background: radial-gradient(circle, rgba(var(--accent-rgb),0.34), transparent 68%);\n    filter: blur(24px);\n    opacity: 0.86;\n    animation: hnEvoFinalGlow 4.8s ease-in-out infinite;\n  }\n\n  .hn-evo-final-card__ring {\n    position: absolute;\n    left: 50%;\n    top: 34%;\n    width: 72%;\n    aspect-ratio: 1;\n    transform: translate(-50%, -50%) rotate(-16deg);\n    border: 1px solid rgba(255,255,255,0.10);\n    border-radius: 999px;\n    opacity: 0.85;\n  }\n\n  .hn-evo-final-card__media img {\n    position: relative;\n    z-index: 2;\n    display: block;\n    width: min(88%, 360px);\n    height: auto;\n    object-fit: contain;\n    transform: rotate(-8deg) translateY(8px) scale(1.08);\n    filter:\n      drop-shadow(0 24px 32px rgba(0,0,0,0.48))\n      drop-shadow(0 0 24px rgba(var(--accent-rgb),0.12));\n    animation: hnEvoFinalFloat 5s ease-in-out infinite;\n  }\n\n  .hn-evo-final-card__scrim {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 52%;\n    z-index: 3;\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,0.88) 0%,\n        rgba(0,0,0,0.70) 38%,\n        rgba(0,0,0,0.26) 72%,\n        rgba(0,0,0,0) 100%\n      );\n    pointer-events: none;\n  }\n\n  .hn-evo-final-card__content {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 4;\n    padding: 0 22px 24px;\n  }\n\n  .hn-evo-final-card__chip {\n    display: inline-flex;\n    align-items: center;\n    width: fit-content;\n    min-height: 24px;\n    padding: 0 9px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.92);\n    color: #080808;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 900;\n    letter-spacing: 0.11em;\n  }\n\n  .hn-evo-final-card__content h3 {\n    margin: 14px 0 0;\n    color: #ffffff;\n    font-size: 34px;\n    line-height: 0.94;\n    font-weight: 900;\n    letter-spacing: -0.06em;\n  }\n\n  .hn-evo-final-card__content p {\n    margin: 10px 0 0;\n    max-width: 300px;\n    color: rgba(255,255,255,0.76);\n    font-size: 14px;\n    line-height: 1.35;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n  }\n\n  .hn-evo-final-card__meta {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: 18px;\n    color: rgba(255,255,255,0.95);\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.01em;\n  }\n\n  .hn-evo-final-card__meta span:last-child {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 5px;\n    text-decoration-color: rgba(255,255,255,0);\n    transition: text-decoration-color 220ms ease;\n  }\n\n  .hn-evo-final-card:hover .hn-evo-final-card__meta span:last-child {\n    text-decoration-color: rgba(255,255,255,0.9);\n  }\n\n  @keyframes hnEvoFinalGlow {\n    0%, 100% {\n      opacity: 0.68;\n      transform: translate(-50%, -50%) scale(0.96);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translate(-50%, -50%) scale(1.06);\n    }\n  }\n\n  @keyframes hnEvoFinalFloat {\n    0%, 100% {\n      translate: 0 0;\n    }\n\n    50% {\n      translate: 0 -10px;\n    }\n  }\n\n  @keyframes hnEvoFinalDownBlink {\n    0%, 100% {\n      opacity: 0.45;\n      transform: translateY(0);\n    }\n\n    50% {\n      opacity: 1;\n      transform: translateY(5px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .hn-evo-final {\n      height: 300vh;\n    }\n\n    .hn-evo-final__sticky {\n      height: 100svh;\n      min-height: 700px;\n      align-items: center;\n    }\n\n    .hn-evo-final__inner {\n      width: min(520px, calc(100% - 28px));\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .hn-evo-final__copy {\n      max-width: none;\n    }\n\n    .hn-evo-final__pill {\n      margin-bottom: 14px;\n      padding: 7px 11px 7px 8px;\n      font-