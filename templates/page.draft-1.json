bility: hidden;\n      pointer-events: none;\n      transition: opacity 0.45s ease, visibility 0.45s ease;\n      transition-delay: 0.72s;\n    }\n\n    .hn-member-access__gate-panel {\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.01), transparent 24%, rgba(255,255,255,0.006)),\n        #000000;\n      transition: transform 0.85s cubic-bezier(.2,.8,.2,1);\n    }\n\n    .hn-member-access__gate-panel span {\n      font-size: clamp(54px, 16vw, 98px);\n      color: rgba(255,255,255,0.045);\n    }\n\n    .hn-member-access__gate-panel--left span {\n      right: -6vw;\n    }\n\n    .hn-member-access__gate-panel--right span {\n      left: -6vw;\n    }\n\n    .hn-member-access__lock {\n      top: 47%;\n      width: min(310px, calc(100% - 28px));\n      transform: translate(-50%, -50%);\n    }\n\n    .hn-member-access__lock-mark {\n      width: 76px;\n      height: 76px;\n      margin-bottom: 18px;\n    }\n\n    .hn-member-access__lock-mark::before {\n      inset: 10px;\n    }\n\n    .hn-member-access__lock-mark::after {\n      inset: 21px;\n    }\n\n    .hn-member-access__lock h3 {\n      font-size: clamp(28px, 9vw, 44px);\n      line-height: 0.94;\n      max-width: 280px;\n      margin-left: auto;\n      margin-right: auto;\n    }\n\n    .hn-member-access__lock p {\n      font-size: 10px;\n      margin-bottom: 12px;\n    }\n\n    .hn-member-access__mobile-unlock {\n      margin: 22px auto 0;\n      min-height: 46px;\n      padding: 0 24px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 999px;\n      border: 1.5px solid transparent;\n      background:\n        linear-gradient(#000000, #000000) padding-box,\n        linear-gradient(90deg, #19b84a, #1f7ed8, #6f42d8, #ff3b24) border-box;\n      color: #fff;\n      font-size: 11px;\n      line-height: 1;\n      font-weight: 950;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      cursor: pointer;\n      box-shadow: 0 0 18