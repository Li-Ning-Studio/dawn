s: none;\n    opacity: calc(1 - (var(--reveal) * 0.9));\n    visibility: visible;\n    background: #000000;\n  }\n\n  .hn-member-access__gate-panel {\n    position: absolute;\n    top: 0;\n    width: 50.1%;\n    height: 100%;\n    overflow: hidden;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.018), transparent 24%, rgba(255,255,255,0.008)),\n      #000000;\n    box-shadow:\n      inset 0 0 0 1px rgba(255,255,255,0.035),\n      inset 0 0 90px rgba(255,255,255,0.012),\n      0 0 90px rgba(0,0,0,0.96);\n    will-change: transform;\n  }\n\n  .hn-member-access__gate-panel::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    opacity: 0.06;\n    background:\n      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);\n    background-size: 64px 64px;\n  }\n\n  .hn-member-access__gate-panel::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.015), transparent 54%);\n  }\n\n  .hn-member-access__gate-panel span {\n    position: absolute;\n    top: 50%;\n    color: rgba(255,255,255,0.05);\n    font-size: clamp(78px, 13vw, 200px);\n    line-height: 0.8;\n    font-weight: 950;\n    letter-spacing: -0.08em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    filter: blur(0.2px);\n    pointer-events: none;\n  }\n\n  .hn-member-access__gate-panel--left {\n    left: 0;\n    transform: translateX(calc(var(--unlock) * -104%));\n    border-right: 1px solid rgba(255,255,255,0.06);\n  }\n\n  .hn-member-access__gate-panel--right {\n    right: 0;\n    transform: translateX(calc(var(--unlock) * 104%));\n    border-left: 1px solid rgba(255,255,255,0.06);\n  }\n\n  .hn-member-access__gate-panel--left span {\n    right: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-panel--right span {\n    left: -2.5vw;\n    transform: translateY(-50%);\n  }\n\n  .hn-member-access__gate-line {\n    position: absolute;\n    left: 50%;\n    top: 0;\n    width: 1px;\n    height: 100%;\n    transform: translateX(-50%) scaleY(calc(1 - (var(--unlock) * 0.92)));\n    transform-origin: center;\n    background: linear-gradient(\n      180deg,\n      transparent,\n      rgba(255,255,255,0.12),\n      #dba20f,\n      #2d9fa7,\n      #0c8642,\n      rgba(255,255,255,0.12),\n      transparent\n    );\n    box-shadow:\n      0 0 18px rgba(255,255,255,0.12),\n      0 0 44px rgba(45,159,167,0.16);\n  }\n\n  .hn-member-access__gate-light {\n    position: absolute;\n    z-index: 8;\n    left: -28%;\n    top: 0;\n    width: 24%;\n    height: 100%;\n    transform: translateX(calc(var(--unlock) * 530%)) skewX(-15deg);\n    opacity: calc(0.015 + (var(--unlock) * 0.3));\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);\n    filter: blur(12px);\n  }\n\n  .hn-member-access__lock {\n    position: absolute;\n    z-index: 12;\n    left: 50%;\n    top: 50%;\n    width: min(480px, calc(100% - 44px));\n    transform: translate(-50%, -50%) scale(calc(1 - (var(--unlock) * 0.14)));\n    opacity: calc(1 - (var(--unlock) * 1.15));\n    text-align: center;\n    pointer-events: auto;\n  }\n\n  .hn-member-access__lock-mark {\n    position: relative;\n    width: 112px;\n    height: 112px;\n    margin: 0 auto 24px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.12);\n    background:\n      radial-gradient(circle, rgba(255,255,255,0.055), transparent 44%),\n      #000000;\n    box-shadow:\n      0 0 36px rgba(255,255,255,0.04),\n      inset 0 0 0 1px rgba(255,255,255,0.035);\n  }\n\n  .hn-member-access__lock-mark::before,\n  .hn-member-access__lock-mark::after {\n    content: \"\";\n    position: absolute;\n    border-radius: 999px;\n    pointer-events: none;\n  }\n\n  .hn-member-access__lock-mark::before {\n    inset: 12px;\n    border: 1px solid transparent;\n    border-top-color: #dba20f;\n    b