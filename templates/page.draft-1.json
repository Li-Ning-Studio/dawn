      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign hsr_id = section.id | default: 'hndrd-horizontal-series-rail' %}\n<section id=\"hsr-{{ hsr_id }}\" class=\"hsr\" aria-label=\"Explore HNDRD racket series\">\n  <div class=\"hsr__topbar\"><span>HNDRD RACKET SERIES</span><span class=\"hsr__hint\">DRAG OR SCROLL</span></div>\n  <div class=\"hsr__rail\" data-rail>\n    <article class=\"hsr__scene is-active\" data-scene=\"0\" style=\"--wash:#22120a;--accent:#ff6a00;\">\n      <div class=\"hsr__wash\"></div><div class=\"hsr__scene-inner\"><div class=\"hsr__meta\"><span>01</span><span>PERFORMANCE</span></div>\n      <div class=\"hsr__hero\"><p class=\"hsr__kicker\">Built for the highest level</p><h2>PRO<br>SERIES</h2>\n      <ul class=\"hsr__models\"><li>Nitrix 70 Venom</li><li>Nitrix 70 Volta</li><li>Hyfonic 7</li><li>Flareon 700</li></ul>\n      <a class=\"hsr__cta\" href=\"https://in.hndrd.co/pages/pro-series-rackets\"><span>Explore Pro Series</span><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h13M13 6l6 6-6 6\"/></svg></a></div><div class=\"hsr__ghost\">PRO</div></div>\n    </article>\n    <article class=\"hsr__scene\" data-scene=\"1\" style=\"--wash:#182108;--accent:#d8ff22;\">\n      <div class=\"hsr__wash\"></div><div class=\"hsr__scene-inner\"><div class=\"hsr__meta\"><span>02</span><span>THREE PERSONALITIES</span></div>\n      <div class=\"hsr__hero\"><p class=\"hsr__kicker\">One game. Three expressions.</p><h2>PRIME<br>TRINITY</h2>\n      <ul class=\"hsr__models\"><li>Nitrix 10</li><li>Flareon 100</li><li>Hyfonic 1</li></ul>\n      <a class=\"hsr__cta\" href=\"https://in.hndrd.co/pages/the-prime-trinity\"><span>Explore Prime Trinity</span><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h13M13 6l6 6-6 6\"/></svg></a></div><div class=\"hsr__ghost\">III</div></div>\n    </article>\n    <article class=\"hsr__scene\" data-scene=\"2\" style=\"--wash:#071c22;--accent:#58dfff;\">\n      <div class=\"hsr__wash\"></div><div class=\"hsr__scene-inner\"><div class=\"hsr__meta\"><span>03</span><span>ATTACK. SPEED. PRECISION.</span></div>\n      <div class=\"hsr__hero\"><p class=\"hsr__kicker\">Three distinct expressions</p><h2>EVOLUTION<br>SERIES</h2>\n      <ul class=\"hsr__models\"><li>Nitrix Thunder</li><li>Flareon Typhoon</li><li>Hyfonic Lazer</li></ul>\n      <a class=\"hsr__cta\" href=\"https://in.hndrd.co/pages/pro-series\"><span>Explore Evolution Series</span><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h13M13 6l6 6-6 6\"/></svg></a></div><div class=\"hsr__ghost\">EVO</div></div>\n    </article>\n  </div>\n  <div class=\"hsr__progress\"><button class=\"hsr__progress-item is-active\" data-go=\"0\"><span>01</span></button><button class=\"hsr__progress-item\" data-go=\"1\"><span>02</span></button><button class=\"hsr__progress-item\" data-go=\"2\"><span>03</span></button></div>\n</section>\n<style>\n#hsr-{{ hsr_id }}{--bg:#050505;--line:rgba(255,255,255,.14);--muted:rgba(255,255,255,.5);--ease:cubic-bezier(.2,.75,.2,1);position:relative;height:min(860px,92vh);min-height:640px;overflow:hidden;background:var(--bg);color:#fff;font-family:Figtree,Arial,sans-serif}#hsr-{{ hsr_id }} *,#hsr-{{ hsr_id }} *:before,#hsr-{{ hsr_id }} *:after{box-sizing:border-box}.hsr__topbar{position:absolute;inset:0 0 auto;z-index:5;display:flex;justify-content:space-between;padding:24px clamp(20px,4vw,64px);border-bottom:1px solid var(--line);font-size:10px;font-weight:700;letter-spacing:.18em}.hsr__hint{color:var(--muted)}.hsr__rail{display:flex;width:100%;height:100%;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain;cursor:grab}.hsr__rail::-webkit-scrollbar{display:none}.hsr__rail.is-dragging{cursor:grabbing;scroll-behavior:auto;user-select:none}.hsr__scene{position:relative;flex:0 0 100%;height:100%;scroll-snap-align:start;scroll-snap-stop:always;overflow:hidden;isolation:isolate;background:#060606}.hsr__wash{position:absolute;inset:0;z-index:-2;background:radial-gradient(circle at 76% 28%,color-mix(in srgb,var(--accent) 14%,transparent),transparent 28%),radial-gradient(circle at 18% 78%,color-mix(in srgb,var(--wash) 72%,transparent),transparent 34%),linear-gradient(135deg,var(--wash),#070707 58%,#030303);transform:scale(1.04);transition:transform 1.1s var(--ease)}.hsr__scene.is-active .hsr__wash{transform:scale(1)}.hsr__scene-inner{position:relative;display:flex;flex-direction:column;justify-content:center;height:100%;padding:96px clamp(24px,6vw,96px) 94px}.hsr__meta{position:absolute;top:104px;left:clamp(24px,6vw,96px);right:clamp(24px,6vw,96px);display:flex;justify-content:space-between;font-size:9px;font-weight:700;letter-spacing:.17em;color:var(--muted)}.hsr__hero{position:relative;z-index:2;width:min(960px,82vw);margin:auto;text-align:center}.hsr__kicker{margin:0 0 14px;color:var(--accent);font-size:10px;font-weight:700;letter-spacing:.17em;text-transform:uppercase}.hsr__hero h2{margin:0;font-size:clamp(76px,12vw,190px);line-height:.75;letter-spacing:-.075em;font-weight:760}.hsr__models{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px;margin:30px 0 28px;padding:0;list-style:none}.hsr__models li{position:relative;padding-left:13px;font-size:13px;color:rgba(255,255,255,.74)}.hsr__models li:before{content:\"\";position:absolute;left:0;top:.55em;width:5px;height:5px;border-radius:50%;background:var(--accent)}.hsr__cta{display:inline-flex;align-items:center;gap:18px;min-height:48px;padding:0 8px 0 20px;border:1px solid rgba(255,255,255,.38);border-radius:999px;color:#fff;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.hsr__cta svg{width:32px;height:32px;padding:8px;border-radius:50%;background:var(--accent);color:#050505}.hsr__cta path{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.hsr__ghost{position:absolute;right:-1.5vw;bottom:-4vw;font-size:clamp(180px,28vw,450px);line-height:.7;font-weight:800;letter-spacing:-.1em;color:rgba(255,255,255,.025)}.hsr__progress{position:absolute;left:50%;bottom:28px;z-index:6;display:grid;grid-template-columns:repeat(3,1fr);width:min(420px,calc(100% - 40px));transform:translateX(-50%)}.hsr__progress-item{position:relative;height:26px;padding:0;border:0;background:transparent;color:rgba(255,255,255,.35);cursor:pointer;font-size:9px;font-weight:700}.hsr__progress-item:before,.hsr__progress-item:after{content:\"\";position:absolute;left:0;right:0;top:0;height:1px}.hsr__progress-item:before{background:rgba(255,255,255,.18)}.hsr__progress-item:after{background:#fff;transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}.hsr__progress-item.is-active{color:#fff}.hsr__progress-item.is-active:after{transform:scaleX(1)}.hsr__progress-item span{position:absolute;top:8px;left:0}@media(max-width:989px){#hsr-{{ hsr_id }}{height:min(760px,90svh);min-height:600px}.hsr__topbar{padding:20px}.hsr__hint{font-size:0}.hsr__hint:after{content:\"SWIPE\";font-size:10px}.hsr__scene-inner{padding:84px 20px 86px}.hsr__meta{top:82px;left:20px;right:20px}.hsr__hero{width:100%}.hsr__hero h2{font-size:clamp(64px,16vw,110px)}.hsr__models{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-width:520px;margin:26px auto;text-align:left}.hsr__ghost{right:-18px;bottom:-12px;font-size:48vw}}@media(max-width:560px){#hsr-{{ hsr_id }}{height:690px;min-height:690px}.hsr__hero h2{font-size:clamp(52px,17vw,78px)}.hsr__models{grid-template-columns:1fr;gap:9px;max-width:260px;margin:22px auto 24px}.hsr__cta{width:100%;justify-content:space-between}.hsr__progress{bottom:22px}}\n</style>\n<script>\n(()=>{const root=document.getElementById('hsr-{{ hsr_id }}');if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';const rail=root.querySelector('[data-rail]'),scenes=[...root.querySelectorAll('[data-scene]')],items=[...root.querySelectorAll('[data-go]')];let current=0,drag=false,startX=0,startScroll=0,lock=false,timer;const width=()=>rail.clientWidth;const active=i=>{current=Math.max(0,Math.min(i,scenes.length-1));scenes.forEach((s,x)=>s.classList.toggle('is-active',x===current));items.forEach((b,x)=>b.classList.toggle('is-active',x===current))};const go=(i,behavior='smooth')=>{i=Math.max(0,Math.min(i,scenes.length-1));rail.scrollTo({left:width()*i,behavior});active(i)};items.forEach(b=>b.addEventListener('click',()=>go(+b.dataset.go)));rail.addEventListener('scroll',()=>{clearTimeout(timer);timer=setTimeout(()=>active(Math.round(rail.scrollLeft/width())),80)},{passive:true});rail.addEventListener('wheel',e=>{if(innerWidth<990||Math.abs(e.deltaY)<=Math.abs(e.deltaX))return;e.preventDefault();if(lock)return;lock=true;go(current+(e.deltaY>0?1:-1));setTimeout(()=>lock=false,700)},{passive:false});rail.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;drag=true;startX=e.clientX;startScroll=rail.scrollLeft;rail.classList.add('is-dragging')});rail.addEventListener('pointermove',e=>{if(drag)rail.scrollLeft=startScroll-(e.clientX-startX)});const stop=()=>{if(!drag)return;drag=false;rail.classList.remove('is-dragging');go(Math.round(rail.scrollLeft/width()))};rail.addEventListener('pointerup',stop);rail.addEventListener('pointercancel',stop);rail.addEventListener('pointerleave',stop);addEventListener('resize',()=>go(current,'auto'))})();\n</script>",
