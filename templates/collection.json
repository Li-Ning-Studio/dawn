    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Signature Sold Out */\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  isolation: isolate;\n  overflow: hidden !important;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n\n  background: rgba(20,20,20,.94) !important;\n  color: #fff !important;\n  border: none !important;\n  border-radius: 999px !important;\n  outline: none !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .105em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  -webkit-backdrop-filter: blur(12px);\n  backdrop-filter: blur(12px);\n\n  animation: hnBadgeEnter .55s\n    cubic-bezier(.22,1,.36,1) both;\n\n  transition: background .3s ease !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255,255,255,.16) 50%,\n    transparent 75%\n  );\n\n  transform: translateX(-150%);\n  transition: transform .7s\n    cubic-bezier(.22,1,.36,1);\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@keyframes hnBadgeEnter {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover\n  .hn-soldout {\n    background: #101010 !important;\n  }\n\n  #product-grid .card-wrapper:hover\n  .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media (max-width:749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n    letter-spacing: .08em !important;\n  }\n}\n\n@media (prefers-reduced-motion:reduce) {\n  #product-grid .hn-soldout {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  #product-grid .hn-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  if (window.HNDRDPriorityV7) return;\n  window.HNDRDPriorityV7 = true;\n\n  /* ==================================\n     HNDRD COLLECTION SORTING\n\n     1. In-stock New Arrivals\n     2. In-stock Best Sellers\n     3. Sold Out\n\n     Automatically reads Shopify tags.\n     No product handles required.\n  ================================== */\n\n  const NEW_TAGS = [\n    \"new arrival\",\n    \"new arrivals\",\n    \"newarrival\",\n    \"newarrivals\"\n  ];\n\n  const SOLD_REGEX =\n    /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n\n  const NEW_REGEX =\n    /\\bnew[\\s_-]*arrivals?\\b/i;\n\n  const productCache = new Map();\n  const pageStates = new Map();\n\n  let working = false;\n  let rendering = false;\n  let managedGrid = null;\n  let managedKey = \"\";\n  let version = 0;\n  let observer;\n\n  /* ----------------------------------\n     Product and tag helpers\n  ---------------------------------- */\n\n  function normalize(value) {\n    return String(value || \"\")\n      .toLowerCase()\n      .trim()\n      .replace(/[\\s_-]+/g, \" \");\n  }\n\n  function isNewTag(tag) {\n    return NEW_TAGS.some(\n      name => normalize(name) === normalize(tag)\n    );\n  }\n\n  function getHandle(card) {\n    const link = card.querySelector(\n      'a[href*=\"/products/\"]'\n    );\n\n    if (!link) return \"\";\n\n    try {\n      const path = new URL(\n        link.href, location.origin\n      ).pathname;\n\n      const match = path.match(\n        /\\/products\\/([^/]+)/\n      );\n\n      return match\n        ? decodeURIComponent(match[1])\n        : \"\";\n    } catch (_) {\n      return \"\";\n    }\n  }\n\n  function visibleNew(card) {\n    if (\n      card.dataset.newArrival === \"true\" ||\n      card.dataset.hndrdNew === \"true\" ||\n      card.querySelector(\n        '[data-new-arrival=\"true\"],' +\n        '[data-hndrd-new=\"true\"]'\n      )\n    ) return true;\n\n    const badges = card.querySelectorAll(\n      \".badge,.product-label,\" +\n      \"[data-tags],[data-product-tags]\"\n    );\n\n    return Array.from(badges).some(el => {\n      return NEW_REGEX.test([\n        el.textContent,\n        el.dataset.tags,\n        el.dataset.productTags\n      ].join(\" \"));\n    });\n  }\n\n  function visibleSold(card) {\n    if (\n      card.dataset.available === \"false\" ||\n      card.matches(\n        \".sold-out,.out-of-stock,.card--sold-out\"\n      ) ||\n      card.querySelector(\n        '[data-sold-out=\"true\"]'\n      )\n    ) return true;\n\n    const badges = card.querySelectorAll(\n      \".card__badge .badge\"\n    );\n\n    for (const badge of badges) {\n      if (SOLD_REGEX.test(badge.textContent)) {\n        return true;\n      }\n    }\n\n    return SOLD_REGEX.test(\n      card.textContent || \"\"\n    );\n  }\n\n  /* ----------------------------------\n     Shopify Product JSON\n\n     Reads actual tags and availability.\n  ---------------------------------- */\n\n  function getProduct(handle) {\n    if (!handle) return Promise.resolve(null);\n\n    if (productCache.has(handle)) {\n      return productCache.get(handle);\n    }\n\n    const root =\n      window.Shopify?.routes?.root || \"/\";\n\n    const url =\n      root.replace(/\\/?$/, \"/\") +\n      \"products/\" +\n      encodeURIComponent(handle) +\n      \".js\";\n\n    const request = fetch(url, {\n      credentials: \"same-origin\"\n    })\n    .then(response => {\n      if (!response.ok) {\n        throw new Error(\n          \"Product request failed\"\n        );\n      }\n\n      return response.json();\n    })\n    .catch(() => {\n      productCache.delete(handle);\n      return null;\n    });\n\n    productCache.set(handle, request);\n\n    return request;\n  }\n\n  /* ----------------------------------\n     Premium Sold Out Badge\n  ---------------------------------- */\n\n  function decorateCard(card) {\n    card.querySelectorAll(\n      \".card__badge .badge\"\n    ).forEach(badge => {\n      const sold = SOLD_REGEX.test(\n        badge.textContent.trim()\n      );\n\n      badge.classList.toggle(\n        \"hn-soldout\", sold\n      );\n    });\n  }\n\n  function decorateGrid(grid) {\n    if (!grid) return;\n\n    grid.querySelectorAll(\".grid__item\")\n      .forEach(decorateCard);\n  }\n\n  /* ----------------------------------\n     Identify all products concurrently\n  ---------------------------------- */\n\n  async function prepareProducts(cards) {\n    const handles = [\n      ...new Set(\n        cards.map(getHandle).filter(Boolean)\n      )\n    ];\n\n    let index = 0;\n\n    async function worker() {\n      while (index < handles.length) {\n        const handle = handles[index++];\n        await getProduct(handle);\n      }\n    }\n\n    const workers = Array.from(\n      {length: Math.min(8, handles.length)},\n      () => worker()\n    );\n\n    await Promise.all(workers);\n  }\n\n  /* ----------------------------------\n     Final priority\n\n     0 = New Arrival + Available\n     1 = Other Available\n     2 = Sold Out\n  ---------------------------------- */\n\n  async function sortProducts(cards) {\n    await prepareProducts(cards);\n\n    const groups = [[], [], []];\n\n    for (const card of cards) {\n      card.style.display = \"\";\n      decorateCard(card);\n\n      const handle = getHandle(card);\n      const product = handle\n        ? await getProduct(handle)\n        : null;\n\n      const sold = product\n        ? product.available === false\n        : visibleSold(card);\n\n      let isNew = visibleNew(card);\n\n      if (product && product.tags) {\n        const tags = Array.isArray(product.tags)\n          ? product.tags\n          : String(product.tags).split(\",\");\n\n        isNew = isNew || tags.some(isNewTag);\n      }\n\n      if (sold) {\n        groups[2].push(card);\n      } else if (isNew) {\n        groups[0].push(card);\n      } else {\n        groups[1].push(card);\n      }\n    }\n\n    return groups.flat();\n  }\n\n  /* ----------------------------------\n     URLs and pagination\n  ---------------------------------- */\n\n  function currentPage() {\n    const p = parseInt(\n      new URLSearchParams(location.search)\n        .get(\"page\") || \"1\", 10\n    );\n\n    return p > 0 ? p : 1;\n  }\n\n  function stateKey() {\n    const url = new URL(location.href);\n    url.searchParams.delete(\"page\");\n    url.searchParams.delete(\"sort_by\");\n    url.searchParams.sort();\n\n    return url.pathname + url.search;\n  }\n\n  function pageURL(page, bestSelling = false) {\n    const url = new URL(location.href);\n\n    if (page <= 1) {\n      url.searchParams.delete(\"page\");\n    } else {\n      url.searchParams.set(\"page\", page);\n    }\n\n    if (bestSelling) {\n      url.searchParams.set(\n        \"sort_by\", \"best-selling\"\n      );\n    }\n\n    return url.toString();\n  }\n\n  function pageRange(current, total) {\n    if (total <= 7) {\n      return Array.from(\n        {length: total},\n        (_, i) => i + 1\n      );\n    }\n\n    if (current <= 4) {\n      return [1,2,3,4,5,\"...\",total];\n    }\n\n    if (current >= total - 3) {\n      return [\n        1,\"...\",total-4,total-3,\n        total-2,total-1,total\n      ];\n    }\n\n    return [\n      1,\"...\",current-1,current,\n      current+1,\"...\",total\n    ];\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll(\n      \".pagination-wrapper,nav.pagination\"\n    );\n\n    if (total <= 1) {\n      wrappers.forEach(el => {\n        el.style.display = \"none\";\n      });\n      return;\n    }\n\n    const link = (page, label, aria) =>\n      '<li><a href=\"' + pageURL(page) +\n      '\" data-hn-page=\"' + page +\n      '\" class=\"pagination__item link\" ' +\n      'aria-label=\"' + aria + '\">' +\n      label + '</a></li>';\n\n    let html = \"\";\n\n    if (current > 1) {\n      html += link(\n        current - 1, \"&lsaquo;\",\n        \"Previous page\"\n      );\n    }\n\n    pageRange(current, total).forEach(p => {\n      if (p === \"...\") {\n        html +=\n          '<li><span class=\"pagination__item\">' +\n          \"&hellip;</span></li>\";\n      } else if (p === current) {\n        html +=\n          '<li><span class=\"pagination__item ' +\n          'pagination__item--current light\" ' +\n          'aria-current=\"page\">' +\n          p + \"</span></li>\";\n      } else {\n        html += link(p, p, \"Page \" + p);\n      }\n    });\n\n    if (current < total) {\n      html += link(\n        current + 1, \"&rsaquo;\",\n        \"Next page\"\n      );\n    }\n\n    document.querySelectorAll(\n      \".pagination__list\"\n    ).forEach(list => {\n      list.innerHTML = html;\n    });\n\n    wrappers.forEach(el => {\n      el.style.display = \"\";\n    });\n  }\n\n  /* ----------------------------------\n     Display sorted products\n  ---------------------------------- */\n\n  function display(grid, state, requested) {\n    const perPage = Math.max(\n      1, state.perPage\n    );\n\n    const total = Math.max(\n      1,\n      Math.ceil(state.cards.length / perPage)\n    );\n\n    const page = Math.min(\n      Math.max(1, requested), total\n    );\n\n    const html = state.cards.slice(\n      (page - 1) * perPage,\n      page * perPage\n    ).join(\"\");\n\n    rendering = true;\n\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n\n      decorateGrid(grid);\n      renderPagination(page, total);\n\n      grid.dataset.hnManaged = \"1\";\n      managedGrid = grid;\n      managedKey = stateKey();\n\n      if (page !== requested) {\n        history.replaceState(\n          {hnPage: page}, \"\",\n          pageURL(page)\n        );\n      }\n\n      /* Clear self-generated mutations */\n      if (observer) observer.takeRecords();\n\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ----------------------------------\n     Fetch collection pages in\n     Shopify Best Selling order\n  ---------------------------------- */\n\n  async function fetchPage(page, sectionId) {\n    const url = new URL(\n      pageURL(page, true)\n    );\n\n    if (sectionId) {\n      url.searchParams.set(\n        \"section_id\", sectionId\n      );\n    }\n\n    let response = await fetch(url, {\n      credentials: \"same-origin\"\n    });\n\n    if (!response.ok && sectionId) {\n      response = await fetch(\n        pageURL(page, true),\n        {credentials: \"same-origin\"}\n      );\n    }\n\n    if (!response.ok) {\n      throw new Error(\n        \"Collection fetch failed\"\n      );\n    }\n\n    const doc = new DOMParser()\n      .parseFromString(\n        await response.text(),\n        \"text/html\"\n      );\n\n    const grid = doc.getElementById(\n      \"product-grid\"\n    );\n\n    if (!grid) {\n      throw new Error(\n        \"Collection grid missing\"\n      );\n    }\n\n    return {\n      cards: Array.from(\n        grid.querySelectorAll(\".grid__item\")\n      ),\n      doc: doc\n    };\n  }\n\n  function lastPageFrom(doc) {\n    let last = 1;\n\n    doc.querySelectorAll(\n      '.pagination a[href*=\"page=\"]'\n    ).forEach(link => {\n      try {\n        const page = parseInt(\n          new URL(\n            link.href, location.origin\n          ).searchParams.get(\"page\"),\n          10\n        );\n\n        if (page > last) last = page;\n      } catch (_) {}\n    });\n\n    return last;\n  }\n\n  /* ----------------------------------\n     Full collection rebuild\n  ---------------------------------- */\n\n  async function rebuild() {\n    const grid = document.getElementById(\n      \"product-grid\"\n    );\n\n    if (!grid || working) return;\n\n    working = true;\n    const run = ++version;\n    const key = stateKey();\n\n    try {\n      decorateGrid(grid);\n\n      const cached = pageStates.get(key);\n\n      if (cached) {\n        display(grid, cached, currentPage());\n        return;\n      }\n\n      const section = grid.closest(\n        '[id^=\"shopify-section-\"]'\n      );\n\n      const sectionId = section\n        ? section.id.replace(\n            \"shopify-section-\", \"\"\n          )\n        : null;\n\n      /* Fetch first Best Selling page */\n\n      const first = await fetchPage(\n        1, sectionId\n      );\n\n      const last = lastPageFrom(first.doc);\n\n      const pages = new Map();\n      pages.set(1, first.cards);\n\n      /* Fetch other pages with limited\n         concurrency, no artificial delays */\n\n      let nextPage = 2;\n\n      async function pageWorker() {\n        while (nextPage <= last) {\n          const p = nextPage++;\n          const result = await fetchPage(\n            p, sectionId\n          );\n\n          pages.set(p, result.cards);\n        }\n      }\n\n      await Promise.all(\n        Array.from(\n          {length: Math.min(6, last - 1)},\n          () => pageWorker()\n        )\n      );\n\n      if (\n        run !== version ||\n        key !== stateKey()\n      ) return;\n\n      const allCards = [];\n\n      for (let p = 1; p <= last; p++) {\n        (pages.get(p) || []).forEach(card => {\n          allCards.push(card);\n        });\n      }\n\n      /* Read tags and reorder */\n\n      const sorted = await sortProducts(\n        allCards\n      );\n\n      if (\n        run !== version ||\n        key !== stateKey()\n      ) return;\n\n      const state = {\n        perPage: Math.max(\n          1, first.cards.length\n        ),\n        cards: sorted.map(\n          card => card.outerHTML\n        )\n      };\n\n      pageStates.set(key, state);\n\n      const activeGrid =\n        document.getElementById(\n          \"product-grid\"\n        );\n\n      if (activeGrid) {\n        display(\n          activeGrid, state, currentPage()\n        );\n      }\n\n    } catch (error) {\n      console.error(\n        \"HNDRD collection sorting:\",\n        error\n      );\n\n    } finally {\n      working = false;\n    }\n  }\n\n  /* ----------------------------------\n     Instant page switching\n  ---------------------------------- */\n\n  document.addEventListener(\n    \"click\",\n    function (event) {\n      const link = event.target.closest(\n        \"a[data-hn-page]\"\n      );\n\n      if (!link) return;\n\n      const grid = document.getElementById(\n        \"product-grid\"\n      );\n\n      const state = pageStates.get(\n        stateKey()\n      );\n\n      if (!grid || !state) return;\n\n      event.preventDefault();\n\n      const page = parseInt(\n        link.dataset.hnPage, 10\n      );\n\n      history.pushState(\n        {hnPage: page},\n        \"\",\n        pageURL(page)\n      );\n\n      display(grid, state, page);\n\n      (\n        document.getElementById(\n          \"ProductGridContainer\"\n        ) || grid\n      ).scrollIntoView({\n        behavior: \"smooth\",\n        block: \"start\"\n      });\n    }\n  );\n\n  /* ----------------------------------\n     Browser navigation\n  ---------------------------------- */\n\n  window.addEventListener(\n    \"popstate\",\n    function () {\n      const grid = document.getElementById(\n        \"product-grid\"\n      );\n\n      const state = pageStates.get(\n        stateKey()\n      );\n\n      if (grid && state) {\n        display(\n          grid, state, currentPage()\n        );\n      } else {\n        rebuild();\n      }\n    }\n  );\n\n  /* ----------------------------------\n     Shopify filters / DOM updates\n  ---------------------------------- */\n\n  let scheduled = false;\n\n  function scheduleRebuild() {\n    if (scheduled || rendering) return;\n\n    scheduled = true;\n\n    requestAnimationFrame(() => {\n      scheduled = false;\n\n      if (working) return;\n\n      const grid = document.getElementById(\n        \"product-grid\"\n      );\n\n      if (!grid) return;\n\n      const key = stateKey();\n\n      if (\n        grid !== managedGrid ||\n        key !== managedKey ||\n        grid.dataset.hnManaged !== \"1\"\n      ) {\n        /* Clear old state for AJAX updates */\n        pageStates.delete(key);\n        rebuild();\n      }\n    });\n  }\n\n  observer = new MutationObserver(\n    scheduleRebuild\n  );\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  /* ----------------------------------\n     Start immediately\n  ---------------------------------- */\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\n      \"DOMContentLoaded\", rebuild\n    );\n  } else {\n    rebuild();\n  }\n\n})();\n</script>",
