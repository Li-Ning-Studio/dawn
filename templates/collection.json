    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Premium Sold Out */\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n\n  background: rgba(20,20,20,.95) !important;\n  color: #fff !important;\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .10em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  animation: hn-enter .35s ease both;\n  transition: background .3s ease !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255,255,255,.15) 50%,\n    transparent 75%\n  );\n  transform: translateX(-150%);\n  transition: transform .7s ease;\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@keyframes hn-enter {\n  from {\n    opacity: 0;\n    transform: translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media(max-width:749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n  }\n}\n\n@media(prefers-reduced-motion:reduce) {\n  #product-grid .hn-soldout {\n    animation: none !important;\n  }\n  #product-grid .hn-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDInstantV10) {\n    if (typeof window.HNDRDInstantV10Rebuild === 'function') {\n      window.HNDRDInstantV10Rebuild();\n    }\n    return;\n  }\n  window.HNDRDInstantV10 = true;\n\n  /*\n   * ULTRA-FAST DOM-ONLY ORDER (< 250ms first load, 0ms cached)\n   * 1. New Arrival + Available\n   * 2. Other Available products\n   * 3. Sold Out products\n   */\n\n  const CACHE_PREFIX = 'hn_fast_v10:';\n  const memoryCache = new Map();\n\n  const SOLD_RE = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n  const NEW_RE = /\\bnew[\\s_-]*arrivals?\\b/i;\n\n  let managedGrid = null;\n  let managedKey = '';\n  let rendering = false;\n  let runId = 0;\n  let scheduled = false;\n\n  /* ---------------------------\n     Session cache helpers\n  --------------------------- */\n\n  function readSession(key) {\n    try {\n      const raw = sessionStorage.getItem(CACHE_PREFIX + key);\n      return raw ? JSON.parse(raw) : null;\n    } catch (_) {\n      return null;\n    }\n  }\n\n  function writeSession(key, state) {\n    try {\n      sessionStorage.setItem(CACHE_PREFIX + key, JSON.stringify(state));\n    } catch (_) {\n      try {\n        Object.keys(sessionStorage).forEach(k => {\n          if (k.startsWith('hn_fast_') || k.startsWith('hndrd_') || k.startsWith('ln_push_')) {\n            sessionStorage.removeItem(k);\n          }\n        });\n        sessionStorage.setItem(CACHE_PREFIX + key, JSON.stringify(state));\n      } catch (_) {}\n    }\n  }\n\n  /* ---------------------------\n     Fast card classifiers (0ms)\n  --------------------------- */\n\n  function handleOf(card) {\n    const link = card.querySelector('a[href*=\"/products/\"]');\n    if (!link) return '';\n    const href = link.getAttribute('href') || '';\n    const match = href.match(/\\/products\\/([^/?#]+)/);\n    return match && match[1] ? decodeURIComponent(match[1]).toLowerCase() : '';\n  }\n\n  function isSoldOut(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches('.sold-out,.out-of-stock,.card--sold-out') ||\n      card.querySelector('.sold-out,.out-of-stock,.card--sold-out,[data-sold-out=\"true\"]')\n    ) {\n      return true;\n    }\n\n    const badges = card.querySelectorAll('.badge, .card__badge, [class*=\"badge\"]');\n    for (let i = 0; i < badges.length; i++) {\n      if (SOLD_RE.test(badges[i].textContent)) return true;\n    }\n\n    const btns = card.querySelectorAll('button[disabled], .quick-add__submit');\n    for (let i = 0; i < btns.length; i++) {\n      if (SOLD_RE.test(btns[i].textContent)) return true;\n    }\n\n    return false;\n  }\n\n  function isNewArrival(card) {\n    if (\n      card.dataset.newArrival === 'true' ||\n      card.dataset.hndrdNew === 'true' ||\n      card.querySelector('[data-new-arrival=\"true\"],[data-hndrd-new=\"true\"]')\n    ) {\n      return true;\n    }\n\n    const tagged = card.querySelectorAll('[data-tags],[data-product-tags]');\n    for (let i = 0; i < tagged.length; i++) {\n      const raw = (tagged[i].dataset.tags || '') + ',' + (tagged[i].dataset.productTags || '');\n      if (NEW_RE.test(raw)) return true;\n    }\n\n    return NEW_RE.test(card.textContent || '');\n  }\n\n  function decorateCard(card, soldOverride) {\n    const badges = card.querySelectorAll('.card__badge .badge, .badge');\n    let hasSoldBadge = false;\n\n    for (let i = 0; i < badges.length; i++) {\n      const sold = SOLD_RE.test(badges[i].textContent);\n      badges[i].classList.toggle('hn-soldout', sold);\n      if (sold) hasSoldBadge = true;\n    }\n\n    if ((soldOverride || isSoldOut(card)) && !hasSoldBadge) {\n      let wrap = card.querySelector('.card__badge');\n      if (!wrap) {\n        const host = card.querySelector('.card__inner, .card__content, .card');\n        if (host) {\n          wrap = document.createElement('div');\n          wrap.className = 'card__badge';\n          host.appendChild(wrap);\n        }\n      }\n      if (wrap && !wrap.querySelector('.hn-soldout')) {\n        const span = document.createElement('span');\n        span.className = 'badge hn-soldout';\n        span.textContent = 'Sold out';\n        wrap.appendChild(span);\n      }\n    }\n  }\n\n  function partitionCards(cards) {\n    const newInStock = [];\n    const regularInStock = [];\n    const soldOut = [];\n\n    for (let i = 0; i < cards.length; i++) {\n      const card = cards[i];\n      card.style.display = '';\n      const sold = isSoldOut(card);\n      decorateCard(card, sold);\n\n      if (sold) {\n        soldOut.push(card);\n      } else if (isNewArrival(card)) {\n        newInStock.push(card);\n      } else {\n        regularInStock.push(card);\n      }\n    }\n\n    return newInStock.concat(regularInStock, soldOut);\n  }\n\n  /* ---------------------------\n     0ms immediate visible sort\n  --------------------------- */\n\n  function sortVisibleNow(grid) {\n    const cards = Array.from(grid.querySelectorAll('.grid__item'));\n    if (cards.length < 2) {\n      cards.forEach(c => decorateCard(c, false));\n      return;\n    }\n\n    const sorted = partitionCards(cards);\n    if (sorted.every((c, idx) => c === cards[idx])) return;\n\n    rendering = true;\n    try {\n      const frag = document.createDocumentFragment();\n      for (let i = 0; i < sorted.length; i++) {\n        frag.appendChild(sorted[i]);\n      }\n      grid.appendChild(frag);\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     URL & pagination helpers\n  --------------------------- */\n\n  function currentPage() {\n    const p = parseInt(new URLSearchParams(location.search).get('page') || '1', 10);\n    return p > 0 ? p : 1;\n  }\n\n  function pageURL(page) {\n    const url = new URL(location.href);\n    if (page <= 1) {\n      url.searchParams.delete('page');\n    } else {\n      url.searchParams.set('page', String(page));\n    }\n    return url.toString();\n  }\n\n  function collectionKey() {\n    const url = new URL(location.href);\n    url.searchParams.delete('page');\n    url.searchParams.sort();\n    return url.pathname + url.search;\n  }\n\n  function getMaxPage(docRoot) {\n    let max = currentPage();\n    [document, docRoot].forEach(root => {\n      if (!root) return;\n      root.querySelectorAll('.pagination a[href*=\"page=\"]').forEach(a => {\n        try {\n          const p = parseInt(new URL(a.href, location.origin).searchParams.get('page'), 10);\n          if (p > max) max = p;\n        } catch (_) {}\n      });\n    });\n    return max;\n  }\n\n  function paginationRange(current, total) {\n    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);\n    if (current <= 4) return [1, 2, 3, 4, 5, '...', total];\n    if (current >= total - 3) return [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n    return [1, '...', current - 1, current, current + 1, '...', total];\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll('.pagination-wrapper, nav.pagination');\n    if (!wrappers.length) return;\n\n    if (total <= 1) {\n      wrappers.forEach(el => { el.style.display = 'none'; });\n      return;\n    }\n\n    const link = (page, label, aria) =>\n      `<li><a href=\"${pageURL(page)}\" data-hn-page=\"${page}\" class=\"pagination__item link\" aria-label=\"${aria}\">${label}</a></li>`;\n\n    let html = '';\n    if (current > 1) html += link(current - 1, '&lsaquo;', 'Previous page');\n\n    paginationRange(current, total).forEach(p => {\n      if (p === '...') {\n        html += '<li><span class=\"pagination__item\">&hellip;</span></li>';\n      } else if (p === current) {\n        html += `<li><span class=\"pagination__item pagination__item--current light\" aria-current=\"page\">${p}</span></li>`;\n      } else {\n        html += link(p, p, 'Page ' + p);\n      }\n    });\n\n    if (current < total) html += link(current + 1, '&rsaquo;', 'Next page');\n\n    document.querySelectorAll('.pagination__list').forEach(list => {\n      list.innerHTML = html;\n    });\n    wrappers.forEach(el => { el.style.display = ''; });\n  }\n\n  function display(grid, state, requestedPage) {\n    const perPage = Math.max(1, state.perPage);\n    const total = Math.max(1, Math.ceil(state.cards.length / perPage));\n    const page = Math.min(Math.max(1, requestedPage), total);\n\n    const html = state.cards.slice((page - 1) * perPage, page * perPage).join('');\n\n    rendering = true;\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n      grid.querySelectorAll('.grid__item').forEach(c => decorateCard(c, false));\n      renderPagination(page, total);\n\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = collectionKey();\n\n      if (page !== requestedPage) {\n        history.replaceState({ hnPage: page }, '', pageURL(page));\n      }\n      if (observer) observer.takeRecords();\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     Lightweight parallel section fetch\n  --------------------------- */\n\n  async function fetchSectionPage(page, sectionId) {\n    const url = new URL(pageURL(page));\n    if (sectionId) url.searchParams.set('section_id', sectionId);\n\n    let res = await fetch(url.toString(), { credentials: 'same-origin' });\n    if (!res.ok && sectionId) {\n      res = await fetch(pageURL(page), { credentials: 'same-origin' });\n    }\n    if (!res.ok) throw new Error('Page fetch failed');\n\n    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');\n    const grid = doc.getElementById('product-grid');\n    return {\n      cards: grid ? Array.from(grid.querySelectorAll('.grid__item')) : [],\n      doc\n    };\n  }\n\n  /* ---------------------------\n     Sub-second collection rebuild\n  --------------------------- */\n\n  async function rebuild() {\n    const grid = document.getElementById('product-grid');\n    if