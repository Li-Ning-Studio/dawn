    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Premium Sold Out + Force Instant Card Visibility */\n#product-grid .grid__item {\n  opacity: 1 !important;\n  transform: none !important;\n  visibility: visible !important;\n}\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n  background: rgba(20, 20, 20, 0.95) !important;\n  color: #fff !important;\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: 0.10em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255, 255, 255, 0.16) 50%,\n    transparent 75%\n  );\n  transform: translateX(-150%);\n  transition: transform 0.65s ease;\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@media (hover: hover) {\n  #product-grid .card-wrapper:hover .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media (max-width: 749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  // Wipe broken older caches immediately\n  try {\n    Object.keys(sessionStorage).forEach(function (k) {\n      if (k.indexOf('hn_zero_') === 0 || k.indexOf('hn_fast_') === 0) {\n        sessionStorage.removeItem(k);\n      }\n    });\n  } catch (_) {}\n\n  const CACHE_PREFIX = 'hn_safe_v12:';\n  const mem = new Map();\n  const SOLD_RE = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n  const NEW_RE = /\\bnew[\\s_-]*arrivals?\\b/i;\n\n  let isRendering = false;\n  let activeRun = 0;\n\n  function handleOf(card) {\n    const a = card.querySelector('a[href*=\"/products/\"]');\n    if (!a) return '';\n    const m = (a.getAttribute('href') || '').match(/\\/products\\/([^/?#]+)/);\n    return m && m[1] ? decodeURIComponent(m[1]).toLowerCase() : '';\n  }\n\n  function isSoldOut(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches('.sold-out, .out-of-stock, .card--sold-out') ||\n      card.querySelector('.sold-out, .out-of-stock, .card--sold-out, [data-sold-out=\"true\"]')\n    ) {\n      return true;\n    }\n    const badges = card.querySelectorAll('.badge, .card__badge, [class*=\"badge\"]');\n    for (let i = 0; i < badges.length; i++) {\n      if (SOLD_RE.test(badges[i].textContent)) return true;\n    }\n    const btns = card.querySelectorAll('button[disabled], .quick-add__submit');\n    for (let i = 0; i < btns.length; i++) {\n      if (SOLD_RE.test(btns[i].textContent)) return true;\n    }\n    return false;\n  }\n\n  function isNewArrival(card) {\n    if (\n      card.dataset.newArrival === 'true' ||\n      card.querySelector('[data-new-arrival=\"true\"]')\n    ) {\n      return true;\n    }\n    return NEW_RE.test(card.textContent || '');\n  }\n\n  function styleSoldBadge(card) {\n    const badges = card.querySelectorAll('.card__badge .badge, .badge');\n    for (let i = 0; i < badges.length; i++) {\n      const match = SOLD_RE.test(badges[i].textContent);\n      badges[i].classList.toggle('hn-soldout', match);\n    }\n  }\n\n  function bucketSort(cards) {\n    const gNew = [];\n    const gReg = [];\n    const gSold = [];\n\n    for (let i = 0; i < cards.length; i++) {\n      const c = cards[i];\n      c.style.display = '';\n      c.classList.remove('scroll-trigger', 'animate--slide-in');\n      styleSoldBadge(c);\n\n      if (isSoldOut(c)) {\n        gSold.push(c);\n      } else if (isNewArrival(c)) {\n        gNew.push(c);\n      } else {\n        gReg.push(c);\n      }\n    }\n    return gNew.concat(gReg, gSold);\n  }\n\n  function curPage() {\n    const p = parseInt(new URLSearchParams(location.search).get('page') || '1', 10);\n    return p > 0 ? p : 1;\n  }\n\n  function pageURL(p) {\n    const u = new URL(location.href);\n    if (p <= 1) u.searchParams.delete('page');\n    else u.searchParams.set('page', String(p));\n    return u.toString();\n  }\n\n  function colKey() {\n    const u = new URL(location.href);\n    u.searchParams.delete('page');\n    u.searchParams.sort();\n    return u.pathname + u.search;\n  }\n\n  function getCache(k) {\n    if (mem.has(k)) return mem.get(k);\n    try {\n      const raw = sessionStorage.getItem(CACHE_PREFIX + k);\n      if (!raw) return null;\n      const parsed = JSON.parse(raw);\n      if (parsed && Array.isArray(parsed.cards) && parsed.cards.length > 0) {\n        mem.set(k, parsed);\n        return parsed;\n      }\n    } catch (_) {}\n    return null;\n  }\n\n  function setCache(k, val) {\n    if (!val || !Array.isArray(val.cards) || val.cards.length === 0) return;\n    mem.set(k, val);\n    try {\n      sessionStorage.setItem(CACHE_PREFIX + k, JSON.stringify(val));\n    } catch (_) {}\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll('.pagination-wrapper, nav.pagination');\n    if (!wrappers.length) return;\n    if (total <= 1) {\n      wrappers.forEach(w => { w.style.display = 'none'; });\n      return;\n    }\n\n    let pages;\n    if (total <= 7) pages = Array.from({ length: total }, (_, i) => i + 1);\n    else if (current <= 4) pages = [1, 2, 3, 4, 5, '...', total];\n    else if (current >= total - 3) pages = [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n    else pages = [1, '...', current - 1, current, current + 1, '...', total];\n\n    const mk = (p, lbl, aria) =>\n      `<li><a href=\"${pageURL(p)}\" data-hn-page=\"${p}\" class=\"pagination__item link\" aria-label=\"${aria}\">${lbl}</a></li>`;\n\n    let html = current > 1 ? mk(current - 1, '&lsaquo;', 'Previous page') : '';\n    pages.forEach(p => {\n      if (p === '...') html += '<li><span class=\"pagination__item\">&hellip;</span></li>';\n      else if (p === current) html += `<li><span class=\"pagination__item pagination__item--current light\" aria-current=\"page\">${p}</span></li>`;\n      else html += mk(p, p, 'Page ' + p);\n    });\n    if (current < total) html += mk(current + 1, '&rsaquo;', 'Next page');\n\n    document.querySelectorAll('.pagination__list').forEach(l => { l.innerHTML = html; });\n    wrappers.forEach(w => { w.style.display = ''; });\n  }\n\n  function renderState(grid, state, reqPage) {\n    if (!state || !state.cards || state.cards.length === 0) return;\n\n    const perPage = Math.max(1, state.perPage);\n    const total = Math.max(1, Math.ceil(state.cards.length / perPage));\n    const page = Math.min(Math.max(1, reqPage), total);\n    const nextHtml = state.cards.slice((page - 1) * perPage, page * perPage).join('');\n\n    if (!nextHtml) return; // Never blank out the grid\n\n    isRendering = true;\n    try {\n      if (grid.innerHTML !== nextHtml) {\n        grid.innerHTML = nextHtml;\n      }\n      grid.querySelectorAll('.grid__item').forEach(c => {\n        c.style.display = '';\n        c.classList.remove('scroll-trigger', 'animate--slide-in');\n        styleSoldBadge(c);\n      });\n      grid.dataset.hnReady = '1';\n      renderPagination(page, total);\n    } finally {\n      isRendering = false;\n    }\n  }\n\n  async function initGrid() {\n    const grid = document.getElementById('product-grid');\n    if (!grid || grid.dataset.hnBusy === '1') return;\n\n    const initialCards = Array.from(grid.querySelectorAll('.grid__item'));\n    if (initialCards.length === 0) return; // Never overwrite if Dawn hasn't rendered cards yet\n\n    const key = colKey();\n    const pageNow = curPage();\n\n    // 1. Instant 0ms cache hit\n    const cached = getCache(key);\n    if (cached) {\n      renderState(grid, cached, pageNow);\n      return;\n    }\n\n    // 2. 0ms synchronous sort of visible cards on screen right now\n    const clonedCurrent = initialCards.map(c => c.cloneNode(true));\n    const sortedVisible = bucketSort(initialCards);\n    if (!sortedVisible.every((n, idx) => n === initialCards[idx])) {\n      isRendering = true;\n      try {\n        const frag = document.createDocumentFragment();\n        sortedVisible.forEach(n => frag.appendChild(n));\n        grid.appendChild(frag);\n      } finally {\n        isRendering = false;\n      }\n    }\n\n    // Check pagination count\n    let maxPage = pageNow;\n    document.querySelectorAll('.pagination a[href*=\"page=\"]').forEach(a => {\n      try {\n        const p = parseInt(new URL(a.href, location.origin).searchParams.get('page'), 10);\n        if (p > maxPage) maxPage = p;\n      } catch (_) {}\n    });\n\n    if (maxPage <= 1) {\n      const singleSorted = bucketSort(clonedCurrent);\n      const state = {\n        perPage: singleSorted.length,\n        cards: singleSorted.map(c => c.outerHTML)\n      };\n      setCache(key, state);\n      grid.dataset.hnReady = '1';\n      return;\n    }\n\n    // 3. Parallel lightweight fetch of other pages\n    grid.dataset.hnBusy = '1';\n    const myRun = ++activeRun;\n    const sec = grid.closest('[id^=\"shopify-section-\"]');\n    const secId = sec ? sec.id.replace('shopify-section-', '') : null;\n\n    try {\n      const pagesMap = new Map();\n      pagesMap.set(pageNow, clonedCurrent);\n\n      const tasks = [];\n      for (let p = 1; p <= maxPage; p++) {\n        if (p === pageNow) continue;\n        const u = new URL(pageURL(p));\n        if (secId) u.searchParams.set('section_id', secId);\n\n        tasks.push(\n          fetch(u.toString(), { credentials: 'same-origin' })\n            .then(r => r.text())\n            .then(html => {\n              const doc = new DOMParser().parseFromString(html, 'text/html');\n              const found = Array.from(doc.querySelectorAll('#product-grid .grid__item'));\n              if (found.length > 0) pagesMap.set(p, found);\n            })\n            .catch(() => {})\n        );\n      }\n\n      await Promise.all(tasks);\n      if (myRun !== activeRun || key !== colKey()) return;\n\n      const seen = new Set();\n      const all = [];\n      for (let p = 1; p <= maxPage; p++) {\n        (pagesMap.get(p) || []).forEach(c => {\n          const h = handleOf(c);\n          if (h) {\n            if (seen.has(h)) return;\n            seen.add(h);\n          }\n          all.push(c);\n        });\n      }\n\n      if (all.length === 0) return;\n\n      const p1 = pagesMap.get(1) || clonedCurrent;\n      const sortedAll = bucketSort(all);\n      const state = {\n        perPage: Math.max(1, p1.length),\n        cards: sortedAll.map(c => c.outerHTML)\n      };\n\n      setCache(key, state);\n\n      const liveGrid = document.getElementById('product-grid');\n      if (liveGrid) renderState(liveGrid, state, curPage());\n    } finally {\n      const liveGrid = document.getElementById('product-grid');\n      if (liveGrid) liveGrid.dataset.hnBusy = '0';\n    }\n  }\n\n  // 0ms page click switching\n  document.addEventListener('click', function (e) {\n    const a = e.target.closest('a[data-hn-page]');\n    if (!a) return;\n    const grid = document.getElementById('product-grid');\n    const state = getCache(colKey());\n    if (!grid || !state) return;\n\n    e.preventDefault();\n    const p = parseInt(a.dataset.hnPage, 10);\n    history.pushState({ hnPage: p }, '', pageURL(p));\n    renderState(grid, state, p);\n    (document.getElementById('ProductGridContainer') || grid).scrollIntoView({ block: 'start' });\n  });\n\n  window.addEventListener('popstate', function () {\n    const grid = document.getElementById('product-grid');\n    const state = getCache(colKey());\n    if (grid && state) renderState(grid, state, curPage());\n    else initGrid();\n  });\n\n  const observer = new MutationObserver(function () {\n    if (isRendering) return;\n    const grid = document.getElementById('product-grid');\n    if (grid && grid.dataset.hnReady !== '1' && grid.dataset.hnBusy !== '1') {\n      initGrid();\n    }\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n\n  initGrid();\n})();\n</script>",
