        "custom_liquid": "<script>\n(function () {\n  const PER_ROUND = 3;\n  const MAX_PAGES_FETCH = 15;\n  const SHOWCASE_VALUE = '__showcase__';\n  const SHOWCASE_LABEL = 'Recommended';\n\n  // Store-wide category priority order:\n  // 1. Rackets -> 2. Shoes -> 3. Bags/Backpacks -> 4. Strings -> 5. Grips\n  // -> 6. Shuttlecocks -> 7. Clothing -> 8. Socks -> 9. Insoles -> 10. Rest all categories\n  const MASTER_CATEGORY_ORDER = [\n    // 1. Rackets\n    'Badminton Racket',\n\n    // 2. Shoes\n    'Badminton Shoes',\n\n    // 3. Bags or Backpacks\n    'Badminton Bag',\n    'Badminton Kit Bag',\n    'Racket Bag',\n    'Backpack',\n\n    // 4. Strings\n    'Badminton String',\n\n    // 5. Grips\n    'Badminton Grip',\n\n    // 6. Shuttlecocks\n    'Shuttlecock',\n\n    // 7. Clothing\n    'T-Shirts',\n    'T-Shirts and Polos',\n    'Polos',\n    'Jerseys',\n    'Shorts',\n    'Shorts and Pants',\n    'Pants',\n    'Hoodies',\n    'Hoodies and Jackets',\n    'Jackets',\n    'Clothing',\n    'Apparels',\n\n    // 8. Socks\n    'Socks',\n\n    // 9. Insoles\n    'Insole',\n\n    // 10. Rest all categories\n    'Badminton Net',\n    'Pickleball Paddle',\n    'Wrist Band',\n    'Towels',\n    'Water Bottle',\n    'Badminton Off-Court Slippers',\n    'Key Chain'\n  ];\n\n  function isShowcaseMode() {\n    const params = new URLSearchParams(window.location.search);\n    const hasFilters = Array.from(params.keys()).some(k => k.startsWith('filter.'));\n    const sortBy = params.get('sort_by');\n    return !hasFilters && (!sortBy || sortBy === SHOWCASE_VALUE);\n  }\n\n  function syncSortDropdowns(selectRecommended) {\n    document.querySelectorAll('select[name=\"sort_by\"]').forEach(select => {\n      let opt = select.querySelector(`option[value=\"${SHOWCASE_VALUE}\"]`);\n      if (!opt) {\n        opt = document.createElement('option');\n        opt.value = SHOWCASE_VALUE;\n        opt.textContent = SHOWCASE_LABEL;\n        select.insertBefore(opt, select.firstChild);\n      }\n      if (selectRecommended) {\n        select.value = SHOWCASE_VALUE;\n      }\n    });\n  }\n\n  function isSoldOut(card) {\n    const text = (card.innerText || card.textContent || '');\n    return /sold\\s*out/i.test(text) || !!card.querySelector('.price--sold-out');\n  }\n\n  function isNewArrival(card) {\n    const text = (card.innerText || card.textContent || '');\n    return /new\\s*arrival/i.test(text);\n  }\n\n  function getProductKey(card) {\n    const link = card.querySelector('.card__heading a, a[href*=\"/products/\"]');\n    if (!link) return null;\n    try {\n      return new URL(link.getAttribute('href'), window.location.origin).pathname;\n    } catch (e) {\n      return link.getAttribute('href');\n    }\n  }\n\n  function normalizeType(raw) {\n    const clean = raw.trim();\n    const lower = clean.toLowerCase();\n\n    if (lower === 'racket' || lower === 'rackets' || lower === 'badminton rackets') return 'Badminton Racket';\n    if (lower === 'shoe' || lower === 'shoes') return 'Badminton Shoes';\n    if (lower === 'bags' || lower === 'badminton bags') return 'Badminton Bag';\n    if (lower === 'badminton kit bags' || lower === 'kit bag' || lower === 'kit bags') return 'Badminton Kit Bag';\n    if (lower === 'racket bags') return 'Racket Bag';\n    if (lower === 'backpacks') return 'Backpack';\n    if (lower === 'string' || lower === 'strings' || lower === 'badminton strings') return 'Badminton String';\n    if (lower === 'grip' || lower === 'grips' || lower === 'badminton grips') return 'Badminton Grip';\n    if (lower === 'shuttlecocks') return 'Shuttlecock';\n    if (lower === 'sock') return 'Socks';\n    if (lower === 'insoles') return 'Insole';\n    if (lower === 'badminton nets') return 'Badminton Net';\n    if (lower === 'paddles' || lower === 'pickleball paddles') return 'Pickleball Paddle';\n\n    const canonical = MASTER_CATEGORY_ORDER.find(c => c.toLowerCase() === lower);\n    return canonical || clean;\n  }\n\n  function detectCategory(card) {\n    // 1. Read \"X colors • Product Type\" directly from card text\n    const cardText = (card.innerText || card.textContent || '');\n    const bulletMatch = cardText.match(/•\\s*([^\\n\\r₹•]+)/);\n    if (bulletMatch && bulletMatch[1]) {\n      const rawType = bulletMatch[1].trim();\n      if (rawType) return normalizeType(rawType);\n    }\n\n    // 2. Fallback from product title/URL if Product Type is blank\n    const link = card.querySelector('.card__heading a, a[href*=\"/products/\"]');\n    const label = ((link ? link.textContent : '') + ' ' + (link ? link.getAttribute('href') : '')).toLowerCase();\n\n    if (label.includes('racket') || label.includes('racquet')) return 'Badminton Racket';\n    if (label.includes('shoe')) return 'Badminton Shoes';\n    if (label.includes('kit-bag') || label.includes('kit bag')) return 'Badminton Kit Bag';\n    if (label.includes('backpack')) return 'Backpack';\n    if (label.includes('cover') || label.includes('bag')) return 'Badminton Bag';\n    if (label.includes('string') || label.includes('/products/n68')) return 'Badminton String';\n    if (label.includes('grip')) return 'Badminton Grip';\n    if (label.includes('shuttle')) return 'Shuttlecock';\n    if (label.includes('t-shirt') || label.includes('tshirt')) return 'T-Shirts';\n    if (label.includes('polo')) return 'Polos';\n    if (label.includes('jersey')) return 'Jerseys';\n    if (label.includes('short')) return 'Shorts';\n    if (label.includes('pant') || label.includes('track')) return 'Pants';\n    if (label.includes('hoodie')) return 'Hoodies';\n    if (label.includes('jacket')) return 'Jackets';\n    if (label.includes('sock')) return 'Socks';\n    if (label.includes('insole')) return 'Insole';\n    if (label.includes('net')) return 'Badminton Net';\n    if (label.includes('paddle')) return 'Pickleball Paddle';\n    if (label.includes('wrist')) return 'Wrist Band';\n    if (label.includes('towel')) return 'Towels';\n    if (label.includes('bottle')) return 'Water Bottle';\n    if (label.includes('slipper')) return 'Badminton Off-Court Slippers';\n\n    return 'Other';\n  }\n\n  function getTotalPages(currentPage, itemsPerPage) {\n    let maxPage = currentPage;\n\n    document.querySelectorAll('.pagination__list a, .pagination__list span').forEach(el => {\n      const n = parseInt(el.textContent.trim(), 10);\n      if (!isNaN(n) && n > maxPage) maxPage = n;\n    });\n\n    const countEl = document.querySelector('#ProductCountDesktop, #ProductCount, .product-count__text');\n    if (countEl) {\n      const countMatch = countEl.textContent.match(/(\\d+)\\s*products?/i);\n      if (countMatch) {\n        const totalProducts = parseInt(countMatch[1], 10);\n        const calcPages = Math.ceil(totalProducts / itemsPerPage);\n        if (calcPages > maxPage) maxPage = calcPages;\n      }\n    }\n\n    return Math.min(maxPage, MAX_PAGES_FETCH);\n  }\n\n  function getCategorySequence(discoveredCategories) {\n    return discoveredCategories.sort((a, b) => {\n      if (a === 'Other') return 1;\n      if (b === 'Other') return -1;\n\n      const idxA = MASTER_CATEGORY_ORDER.findIndex(c => c.toLowerCase() === a.toLowerCase());\n      const idxB = MASTER_CATEGORY_ORDER.findIndex(c => c.toLowerCase() === b.toLowerCase());\n\n      if (idxA !== -1 && idxB !== -1) return idxA - idxB;\n      if (idxA !== -1) return -1;\n      if (idxB !== -1) return 1;\n      return 0;\n    });\n  }\n\n  function buildStrictShowcaseOrder(cards) {\n    const buckets = new Map();\n\n    cards.forEach(card => {\n      const cat = detectCategory(card);\n      if (!buckets.has(cat)) {\n        buckets.set(cat, { newArrivals: [], regular: [] });\n      }\n      if (isNewArrival(card)) {\n        buckets.get(cat).newArrivals.push(card);\n      } else {\n        buckets.get(cat).regular.push(card);\n      }\n    });\n\n    const mergedBuckets = new Map();\n    buckets.forEach((group, cat) => {\n      mergedBuckets.set(cat, [...group.newArrivals, ...group.regular]);\n    });\n\n    const categorySequence = getCategorySequence(Array.from(mergedBuckets.keys()));\n    const strictRows = [];\n\n    // 1. Strict 3-product rows per category\n    let hasFullRow = true;\n    while (hasFullRow) {\n      hasFullRow = false;\n      for (const cat of categorySequence) {\n        const list = mergedBuckets.get(cat);\n        if (list && list.length >= PER_ROUND) {\n          strictRows.push(...list.splice(0, PER_ROUND));\n          if (list.length >= PER_ROUND) hasFullRow = true;\n        }\n      }\n    }\n\n    // 2. Categories with 1-2 items (or 1-2 remainders) follow in the same category order\n    const shortRemainders = [];\n    for (const cat of categorySequence) {\n      const list = mergedBuckets.get(cat);\n      if (list && list.length > 0) {\n        shortRemainders.push(...list);\n      }\n    }\n\n    return [...strictRows, ...shortRemainders];\n  }\n\n  async function arrangeShowcaseGrid(force) {\n    if (!isShowcaseMode()) {\n      syncSortDropdowns(false);\n      return;\n    }\n\n    syncSortDropdowns(true);\n\n    const grid = document.querySelector('#product-grid, .product-grid');\n    if (!grid) return;\n    if (!force && grid.dataset.showcaseSorted === 'true') return;\n    grid.dataset.showcaseSorted = 'true';\n\n    const params = new URLSearchParams(window.location.search);\n    const currentPage = parseInt(params.get('page') || '1', 10);\n    const currentItems = Array.from(grid.querySelectorAll(':scope > li.grid__item'));\n    const itemsPerPage = currentPage === 1 && currentItems.length > 0 ? currentItems.length : 24;\n    const totalPages = getTotalPages(currentPage, itemsPerPage);\n\n    if (totalPages <= 1 && currentItems.length === 0) return;\n\n    grid.style.opacity = '0.35';\n    grid.style.transition = 'opacity 0.2s ease';\n\n    try {\n      const pageMap = new Map();\n      pageMap.set(currentPage, currentItems);\n\n      const fetches = [];\n      for (let p = 1; p <= totalPages; p++) {\n        if (p === currentPage) continue;\n        const url = new URL(window.location.pathname, window.location.origin);\n        url.searchParams.set('page', p);\n        fetches.push(\n          fetch(url.toString())\n            .then(r => r.text())\n            .then(html => {\n              const doc = new DOMParser().parseFromString(html, 'text/html');\n              pageMap.set(\n                p,\n                Array.from(doc.querySelectorAll('#product-grid > li.grid__item, .product-grid > li.grid__item'))\n              );\n            })\n        );\n      }\n\n      await Promise.all(fetches);\n\n      const seenProducts = new Set();\n      const inStockCards = [];\n      const soldOutCards = [];\n\n      for (let p = 1; p <= totalPages; p++) {\n        const cards = pageMap.get(p) || [];\n        for (const card of cards) {\n          const key = getProductKey(card);\n          if (key && seenProducts.has(key)) continue;\n          if (key) seenProducts.add(key);\n\n          if (isSoldOut(card)) {\n            soldOutCards.push(card);\n          } else {\n            inStockCards.push(card);\n          }\n        }\n      }\n\n      const orderedInStock = buildStrictShowcaseOrder(inStockCards);\n      const orderedSoldOut = buildStrictShowcaseOrder(soldOutCards);\n      const finalOrder = [...orderedInStock, ...orderedSoldOut];\n\n      const start = (currentPage - 1) * itemsPerPage;\n      const slice = finalOrder.slice(start, start + itemsPerPage);\n\n      grid.innerHTML = '';\n      slice.forEach(card => {\n        card.classList.remove('scroll-trigger--offscreen');\n        grid.appendChild(card);\n      });\n    } finally {\n      grid.style.opacity = '1';\n    }\n  }\n\n  function init() {\n    // If shopper explicitly switches Sort By back to \"Recommended\", restore showcase immediately\n    document.addEventListener(\n      'change',\n      function (e) {\n        if (e.target && e.target.matches('select[name=\"sort_by\"]') && e.target.value === SHOWCASE_VALUE) {\n          e.stopImmediatePropagation();\n          const url = new URL(window.location.href);\n          url.searchParams.delete('sort_by');\n          window.location.href = url.toString();\n        }\n      },\n      true\n    );\n\n    arrangeShowcaseGrid(false);\n\n    const container = document.getElementById('ProductGridContainer') || document.body;\n    let timer;\n    const observer = new MutationObserver(() => {\n      clearTimeout(timer);\n      timer = setTimeout(() => arrangeShowcaseGrid(false), 50);\n    });\n    observer.observe(container, { childList: true, subtree: true });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>",
