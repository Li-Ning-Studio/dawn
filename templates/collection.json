    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Premium Sold Out */\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n\n  background: rgba(20,20,20,.95) !important;\n  color: #fff !important;\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .10em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  animation: hn-enter .5s ease both;\n  transition: background .3s ease !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255,255,255,.15) 50%,\n    transparent 75%\n  );\n  transform: translateX(-150%);\n  transition: transform .7s ease;\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@keyframes hn-enter {\n  from {\n    opacity: 0;\n    transform: translateY(5px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover\n  .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media(max-width:749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n  }\n}\n\n@media(prefers-reduced-motion:reduce) {\n  #product-grid .hn-soldout {\n    animation: none !important;\n  }\n  #product-grid .hn-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDNewFirstV8) return;\n  window.HNDRDNewFirstV8 = true;\n\n  /*\n   * FINAL ORDER\n   *\n   * 1. New Arrival tagged + Available\n   * 2. Other available products\n   * 3. Sold Out products\n   *\n   * No Best Selling override.\n   * No artificial delays.\n   */\n\n  const productCache = new Map();\n  const collectionCache = new Map();\n\n  const SOLD =\n    /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n\n  const NEW =\n    /\\bnew[\\s_-]*arrivals?!?\\b/i;\n\n  let managedGrid = null;\n  let managedKey = '';\n  let rendering = false;\n  let run = 0;\n  let scheduled = false;\n\n  /* ---------------------------\n     Tag normalisation\n  --------------------------- */\n\n  function normalize(tag) {\n    return String(tag || '')\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, ' ')\n      .trim()\n      .replace(/\\s+/g, ' ');\n  }\n\n  function isNewTag(tag) {\n    const value = normalize(tag);\n\n    return (\n      value === 'new arrival' ||\n      value === 'new arrivals'\n    );\n  }\n\n  /* ---------------------------\n     Product handle\n  --------------------------- */\n\n  function handleOf(card) {\n    const link = card.querySelector(\n      'a[href*=\"/products/\"]'\n    );\n\n    if (!link) return '';\n\n    try {\n      const match = new URL(\n        link.href, location.origin\n      ).pathname.match(\n        /\\/products\\/([^/]+)/\n      );\n\n      return match\n        ? decodeURIComponent(match[1])\n        : '';\n    } catch (_) {\n      return '';\n    }\n  }\n\n  /* ---------------------------\n     Available / Sold Out\n  --------------------------- */\n\n  function visibleSold(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches(\n        '.sold-out,.out-of-stock,.card--sold-out'\n      ) ||\n      card.querySelector(\n        '[data-sold-out=\"true\"]'\n      )\n    ) return true;\n\n    return Array.from(\n      card.querySelectorAll(\n        '.card__badge .badge'\n      )\n    ).some(badge =>\n      SOLD.test(badge.textContent)\n    );\n  }\n\n  function visibleNew(card) {\n    if (\n      card.dataset.newArrival === 'true' ||\n      card.dataset.hndrdNew === 'true' ||\n      card.querySelector(\n        '[data-new-arrival=\"true\"],' +\n        '[data-hndrd-new=\"true\"]'\n      )\n    ) return true;\n\n    return Array.from(\n      card.querySelectorAll(\n        '.badge,[data-tags],' +\n        '[data-product-tags],.product-label'\n      )\n    ).some(el => {\n      const text = [\n        el.textContent || '',\n        el.dataset.tags || '',\n        el.dataset.productTags || ''\n      ].join(' ');\n\n      return text.split(/[,|]/).some(\n        part => isNewTag(part)\n      ) || /\\bnew[\\s_-]*arrivals?\\b/i.test(text);\n    });\n  }\n\n  /* ---------------------------\n     Shopify product data\n  --------------------------- */\n\n  function getProduct(handle) {\n    if (!handle) {\n      return Promise.resolve(null);\n    }\n\n    if (productCache.has(handle)) {\n      return productCache.get(handle);\n    }\n\n    const root =\n      window.Shopify?.routes?.root || '/';\n\n    const url =\n      root.replace(/\\/?$/, '/') +\n      'products/' +\n      encodeURIComponent(handle) +\n      '.js';\n\n    const request = fetch(url, {\n      credentials: 'same-origin'\n    })\n    .then(response => {\n      if (!response.ok) {\n        throw new Error('Product fetch failed');\n      }\n\n      return response.json();\n    })\n    .catch(() => {\n      productCache.delete(handle);\n      return null;\n    });\n\n    productCache.set(handle, request);\n\n    return request;\n  }\n\n  /* ---------------------------\n     Badge styling\n  --------------------------- */\n\n  function decorate(card) {\n    card.querySelectorAll(\n      '.card__badge .badge'\n    ).forEach(badge => {\n      const sold = SOLD.test(\n        badge.textContent.trim()\n      );\n\n      badge.classList.toggle(\n        'hn-soldout', sold\n      );\n    });\n  }\n\n  function decorateGrid(grid) {\n    if (!grid) return;\n\n    grid.querySelectorAll('.grid__item')\n      .forEach(decorate);\n  }\n\n  /* ---------------------------\n     Fast visible-first sorting\n\n     This is provisional until\n     all product tags are loaded.\n  --------------------------- */\n\n  function sortVisible(grid) {\n    const cards = Array.from(\n      grid.querySelectorAll('.grid__item')\n    );\n\n    const groups = [[], [], []];\n\n    cards.forEach(card => {\n      decorate(card);\n\n      if (visibleSold(card)) {\n        groups[2].push(card);\n      } else if (visibleNew(card)) {\n        groups[0].push(card);\n      } else {\n        groups[1].push(card);\n      }\n    });\n\n    const sorted = groups.flat();\n\n    if (sorted.every(\n      (card, index) => card === cards[index]\n    )) return;\n\n    rendering = true;\n\n    try {\n      const fragment =\n        document.createDocumentFragment();\n\n      sorted.forEach(card =>\n        fragment.appendChild(card)\n      );\n\n      grid.appendChild(fragment);\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     Final tag-based sorting\n  --------------------------- */\n\n  async function sortAll(cards) {\n    const handles = [\n      ...new Set(\n        cards.map(handleOf).filter(Boolean)\n      )\n    ];\n\n    let index = 0;\n\n    async function worker() {\n      while (index < handles.length) {\n        await getProduct(handles[index++]);\n      }\n    }\n\n    await Promise.all(\n      Array.from(\n        {length: Math.min(12, handles.length)},\n        () => worker()\n      )\n    );\n\n    const groups = [[], [], []];\n\n    for (const card of cards) {\n      card.style.display = '';\n      decorate(card);\n\n      const handle = handleOf(card);\n      const product = handle\n        ? await getProduct(handle)\n        : null;\n\n      const sold = product\n        ? product.available === false\n        : visibleSold(card);\n\n      let isNew = visibleNew(card);\n\n      if (product && product.tags != null) {\n        const tags = Array.isArray(product.tags)\n          ? product.tags\n          : String(product.tags).split(',');\n\n        isNew = (\n          isNew ||\n          tags.some(isNewTag)\n        );\n      }\n\n      /* Sold Out always last */\n      if (sold) {\n        groups[2].push(card);\n      }\n\n      /* All tagged New Arrivals first */\n      else if (isNew) {\n        groups[0].push(card);\n      }\n\n      /* Everything else in original order */\n      else {\n        groups[1].push(card);\n      }\n    }\n\n    return groups.flat();\n  }\n\n  /* ---------------------------\n     Collection URL helpers\n  --------------------------- */\n\n  function currentPage() {\n    const page = parseInt(\n      new URLSearchParams(location.search)\n        .get('page') || '1', 10\n    );\n\n    return page > 0 ? page : 1;\n  }\n\n  function pageURL(page) {\n    const url = new URL(location.href);\n\n    if (page <= 1) {\n      url.searchParams.delete('page');\n    } else {\n      url.searchParams.set(\n        'page', String(page)\n      );\n    }\n\n    return url.toString();\n  }\n\n  function collectionKey() {\n    const url = new URL(location.href);\n\n    url.searchParams.delete('page');\n    url.searchParams.sort();\n\n    return url.pathname + url.search;\n  }\n\n  /* ---------------------------\n     Pagination\n  --------------------------- */\n\n  function range(current, total) {\n    if (total <= 7) {\n      return Array.from(\n        {length: total},\n        (_, i) => i + 1\n      );\n    }\n\n    if (current <= 4) {\n      return [1,2,3,4,5,'...',total];\n    }\n\n    if (current >= total - 3) {\n      return [\n        1,'...',total-4,total-3,\n        total-2,total-1,total\n      ];\n    }\n\n    return [\n      1,'...',current-1,current,\n      current+1,'...',total\n    ];\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll(\n      '.pagination-wrapper,nav.pagination'\n    );\n\n    if (total <= 1) {\n      wrappers.forEach(el => {\n        el.style.display = 'none';\n      });\n      return;\n    }\n\n    const link = (page, label, aria) =>\n      '<li><a href=\"' + pageURL(page) +\n      '\" data-hn-page=\"' + page +\n      '\" class=\"pagination__item link\" ' +\n      'aria-label=\"' + aria + '\">' +\n      label + '</a></li>';\n\n    let html = '';\n\n    if (current > 1) {\n      html += link(\n        current - 1, '&lsaquo;',\n        'Previous page'\n      );\n    }\n\n    range(current, total).forEach(p => {\n      if (p === '...') {\n        html +=\n          '<li><span class=\"pagination__item\">' +\n          '&hellip;</span></li>';\n      } else if (p === current) {\n        html +=\n          '<li><span class=\"pagination__item ' +\n          'pagination__item--current light\" ' +\n          'aria-current=\"page\">' +\n          p + '</span></li>';\n      } else {\n        html += link(\n          p, p, 'Page ' + p\n        );\n      }\n    });\n\n    if (current < total) {\n      html += link(\n        current + 1, '&rsaquo;',\n        'Next page'\n      );\n    }\n\n    document.querySelectorAll(\n      '.pagination__list'\n    ).forEach(list => {\n      list.innerHTML = html;\n    });\n\n    wrappers.forEach(el => {\n      el.style.display = '';\n    });\n  }\n\n  /* ---------------------------\n     Render selected page\n  --------------------------- */\n\n  function display(grid, state, requested) {\n    const perPage = Math.max(\n      1, state.perPage\n    );\n\n    const total = Math.max(\n      1,\n      Math.ceil(state.cards.length / perPage)\n    );\n\n    const page = Math.min(\n      Math.max(1, requested),\n      total\n    );\n\n    const html = state.cards.slice(\n      (page - 1) * perPage,\n      page * perPage\n    ).join('');\n\n    rendering = true;\n\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n\n      decorateGrid(grid);\n      renderPagination(page, total);\n\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = collectionKey();\n\n      if (page !== requested) {\n        history.replaceState(\n          {hnPage: page},\n          '',\n          pageURL(page)\n        );\n      }\n\n      if (observer) observer.takeRecords();\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     Fetch collection pages\n     Preserve Shopify original order\n  --------------------------- */\n\n  async function fetchPage(page, sectionId) {\n    const url = new URL(pageURL(page));\n\n    if (sectionId) {\n      url.searchParams.set(\n        'section_id', sectionId\n      );\n    }\n\n    let response = await fetch(url, {\n      credentials: 'same-origin'\n    });\n\n    if (!response.ok && sectionId) {\n      response = await fetch(pageURL(page), {\n        credentials: 'same-origin'\n      });\n    }\n\n    if (!response.ok) {\n      throw new Error(\n        'Collection fetch failed'\n      );\n    }\n\n    const doc = new DOMParser()\n      .parseFromString(\n        await response.text(),\n        'text/html'\n      );\n\n    const grid = doc.getElementById(\n      'product-grid'\n    );\n\n    if (!grid) {\n      throw new Error(\n        'Product grid missing'\n      );\n    }\n\n    return {\n      cards: Array.from(\n        grid.querySelectorAll('.grid__item')\n      ),\n      doc\n    };\n  }\n\n  function lastPage(doc) {\n    let last = 1;\n\n    doc.querySelectorAll(\n      '.pagination a[href*=\"page=\"]'\n    ).forEach(link => {\n      try {\n        const page = parseInt(\n          new URL(\n            link.href, location.origin\n          ).searchParams.get('page'),\n          10\n        );\n\n        if (page > last) last = page;\n      } catch (_) {}\n    });\n\n    return last;\n  }\n\n  /* ---------------------------\n     Rebuild entire collection\n  --------------------------- */\n\n  async function rebuild() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n\n    if (!grid) return;\n\n    const id = ++run;\n    const key = collectionKey();\n\n    decorateGrid(grid);\n\n    const cached = collectionCache.get(key);\n\n    if (cached) {\n      display(grid, cached, currentPage());\n      return;\n    }\n\n    /* Immediately prioritise visible tags */\n    sortVisible(grid);\n\n    const section = grid.closest(\n      '[id^=\"shopify-section-\"]'\n    );\n\n    const sectionId = section\n      ? section.id.replace(\n          'shopify-section-', ''\n        )\n      : null;\n\n    try {\n      /* Fetch original first page */\n      const first = await fetchPage(\n        1, sectionId\n      );\n\n      const count = lastPage(first.doc);\n      const pages = new Map();\n\n      pages.set(1, first.cards);\n\n      /* Fetch all pages concurrently,\n         with no artificial delays */\n\n      let next = 2;\n\n      async function pageWorker() {\n        while (next <= count) {\n          const p = next++;\n\n          const result = await fetchPage(\n            p, sectionId\n          );\n\n          pages.set(p, result.cards);\n        }\n      }\n\n      await Promise.all(\n        Array.from(\n          {length: Math.min(8, count - 1)},\n          () => pageWorker()\n        )\n      );\n\n      if (\n        id !== run ||\n        key !== collectionKey()\n      ) return;\n\n      const allCards = [];\n\n      for (let p = 1; p <= count; p++) {\n        (pages.get(p) || [])\n          .forEach(card => {\n            allCards.push(card);\n          });\n      }\n\n      /* Actual Shopify tag priority */\n      const sorted = await sortAll(allCards);\n\n      if (\n        id !== run ||\n        key !== collectionKey()\n      ) return;\n\n      const state = {\n        perPage: Math.max(\n          1, first.cards.length\n        ),\n        cards: sorted.map(\n          card => card.outerHTML\n        )\n      };\n\n      collectionCache.set(key, state);\n\n      const active = document.getElementById(\n        'product-grid'\n      );\n\n      if (active) {\n        display(\n          active, state, currentPage()\n        );\n      }\n\n    } catch (error) {\n      console.error(\n        'HNDRD priority sorting:',\n        error\n      );\n    }\n  }\n\n  /* ---------------------------\n     Instant pagination\n  --------------------------- */\n\n  document.addEventListener(\n    'click',\n    function (event) {\n      const link = event.target.closest(\n        'a[data-hn-page]'\n      );\n\n      if (!link) return;\n\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      const state = collectionCache.get(\n        collectionKey()\n      );\n\n      if (!grid || !state) return;\n\n      event.preventDefault();\n\n      const page = parseInt(\n        link.dataset.hnPage, 10\n      );\n\n      history.pushState(\n        {hnPage: page},\n        '',\n        pageURL(page)\n      );\n\n      display(grid, state, page);\n\n      (\n        document.getElementById(\n          'ProductGridContainer'\n        ) || grid\n      ).scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    }\n  );\n\n  /* ---------------------------\n     Back / Forward navigation\n  --------------------------- */\n\n  window.addEventListener(\n    'popstate',\n    function () {\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      const state = collectionCache.get(\n        collectionKey()\n      );\n\n      if (grid && state) {\n        display(\n          grid, state, currentPage()\n        );\n      } else {\n        rebuild();\n      }\n    }\n  );\n\n  /* ---------------------------\n     Shopify AJAX filter support\n  --------------------------- */\n\n  let observer;\n\n  function scheduleCheck() {\n    if (scheduled || rendering) return;\n\n    scheduled = true;\n\n    requestAnimationFrame(() => {\n      scheduled = false;\n\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      if (!grid) return;\n\n      if (\n        grid !== managedGrid ||\n        collectionKey() !== managedKey ||\n        grid.dataset.hnManaged !== '1'\n      ) {\n        rebuild();\n      }\n    });\n  }\n\n  observer = new MutationObserver(\n    scheduleCheck\n  );\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  /* ---------------------------\n     Start\n  --------------------------- */\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded',\n      rebuild\n    );\n  } else {\n    rebuild();\n  }\n\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
