    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Premium Sold Out */\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n\n  background: rgba(20,20,20,.95) !important;\n  color: #fff !important;\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .10em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  animation: hn-enter .5s ease both;\n  transition: background .3s ease !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255,255,255,.15) 50%,\n    transparent 75%\n  );\n  transform: translateX(-150%);\n  transition: transform .7s ease;\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@keyframes hn-enter {\n  from {\n    opacity: 0;\n    transform: translateY(5px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover\n  .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media(max-width:749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n  }\n}\n\n@media(prefers-reduced-motion:reduce) {\n  #product-grid .hn-soldout {\n    animation: none !important;\n  }\n  #product-grid .hn-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDNewFirstV9) {\n    if (typeof window.HNDRDNewFirstV9Rebuild === 'function') {\n      window.HNDRDNewFirstV9Rebuild();\n    }\n    return;\n  }\n  window.HNDRDNewFirstV9 = true;\n\n  /*\n   * FINAL ORDER\n   *\n   * 1. New Arrival tagged / labelled + Available\n   * 2. Other available products\n   * 3. Sold Out products\n   */\n\n  const productCache = new Map();\n  const collectionProductsLoaded = new Set();\n  const collectionCache = new Map();\n\n  const SOLD = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n  const NEW_TEXT_REGEX = /\\bnew[\\s_-]*arrivals?\\b/i;\n\n  let managedGrid = null;\n  let managedKey = '';\n  let rendering = false;\n  let run = 0;\n  let scheduled = false;\n\n  /* ---------------------------\n     Tag normalisation\n  --------------------------- */\n\n  function normalize(tag) {\n    return String(tag || '')\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, ' ')\n      .trim()\n      .replace(/\\s+/g, ' ');\n  }\n\n  function isNewTag(tag) {\n    const raw = String(tag || '');\n    const value = normalize(raw);\n\n    if (!value) return false;\n\n    return (\n      value === 'new arrival' ||\n      value === 'new arrivals' ||\n      value === 'new' ||\n      value === 'new in' ||\n      value === 'new launch' ||\n      /\\bnew\\s+arrivals?\\b/.test(value) ||\n      NEW_TEXT_REGEX.test(raw)\n    );\n  }\n\n  /* ---------------------------\n     Product handle & Collection handle\n  --------------------------- */\n\n  function handleOf(card) {\n    const links = card.querySelectorAll('a[href*=\"/products/\"]');\n    for (let i = 0; i < links.length; i++) {\n      try {\n        const pathname = new URL(links[i].href, location.origin).pathname;\n        const match = pathname.match(/\\/products\\/([^/?#]+)/);\n        if (match && match[1]) {\n          return decodeURIComponent(match[1]).toLowerCase();\n        }\n      } catch (_) {}\n    }\n    return '';\n  }\n\n  function currentCollectionHandle() {\n    const match = location.pathname.match(/\\/collections\\/([^/?#]+)/);\n    return match && match[1] ? decodeURIComponent(match[1]) : '';\n  }\n\n  /* ---------------------------\n     Available / Sold Out / Visible New\n  --------------------------- */\n\n  function visibleSold(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches('.sold-out,.out-of-stock,.card--sold-out') ||\n      card.querySelector('.sold-out,.out-of-stock,.card--sold-out,[data-sold-out=\"true\"]')\n    ) {\n      return true;\n    }\n\n    const badges = card.querySelectorAll('.badge, .card__badge, [class*=\"badge\"]');\n    for (let i = 0; i < badges.length; i++) {\n      if (SOLD.test(badges[i].textContent)) return true;\n    }\n\n    const disabledBtns = card.querySelectorAll('button[disabled], .quick-add__submit');\n    for (let i = 0; i < disabledBtns.length; i++) {\n      if (SOLD.test(disabledBtns[i].textContent)) return true;\n    }\n\n    return false;\n  }\n\n  function visibleNew(card) {\n    if (\n      card.dataset.newArrival === 'true' ||\n      card.dataset.hndrdNew === 'true' ||\n      card.querySelector('[data-new-arrival=\"true\"],[data-hndrd-new=\"true\"]')\n    ) {\n      return true;\n    }\n\n    /* Check data attributes first */\n    const taggedNodes = card.querySelectorAll('[data-tags],[data-product-tags]');\n    for (let i = 0; i < taggedNodes.length; i++) {\n      const raw = [\n        taggedNodes[i].dataset.tags || '',\n        taggedNodes[i].dataset.productTags || ''\n      ].join(',');\n      if (raw.split(/[,|]/).some(isNewTag)) return true;\n    }\n\n    /* Check entire visible card text (catches red \"New Arrival!\" text in .card__information, em, span, badges, etc.) */\n    return NEW_TEXT_REGEX.test(card.textContent || '');\n  }\n\n  /* ---------------------------\n     Bulk Collection JSON + Fallback Product JS\n  --------------------------- */\n\n  async function preloadCollectionProducts() {\n    const colHandle = currentCollectionHandle();\n    if (!colHandle || collectionProductsLoaded.has(colHandle)) return;\n\n    const root = (window.Shopify?.routes?.root || '/').replace(/\\/?$/, '/');\n\n    try {\n      let page = 1;\n      while (page <= 4) {\n        const url = `${root}collections/${encodeURIComponent(colHandle)}/products.json?limit=250&page=${page}`;\n        const res = await fetch(url, { credentials: 'same-origin' });\n        if (!res.ok) break;\n\n        const data = await res.json();\n        const products = data && Array.isArray(data.products) ? data.products : [];\n        if (!products.length) break;\n\n        products.forEach(prod => {\n          if (!prod || !prod.handle) return;\n          const h = String(prod.handle).toLowerCase();\n          const hasAvailableVariant = Array.isArray(prod.variants)\n            ? prod.variants.some(v => v && v.available === true)\n            : true;\n\n          const normalizedProd = {\n            handle: h,\n            available: typeof prod.available === 'boolean' ? prod.available : hasAvailableVariant,\n            tags: Array.isArray(prod.tags)\n              ? prod.tags\n              : String(prod.tags || '').split(',').map(t => t.trim()).filter(Boolean)\n          };\n\n          productCache.set(h, Promise.resolve(normalizedProd));\n        });\n\n        if (products.length < 250) break;\n        page++;\n      }\n\n      collectionProductsLoaded.add(colHandle);\n    } catch (_) {\n      /* Fallback to per-product .js if collection products.json is restricted */\n    }\n  }\n\n  function getProduct(handle) {\n    if (!handle) return Promise.resolve(null);\n\n    const key = handle.toLowerCase();\n    if (productCache.has(key)) {\n      return productCache.get(key);\n    }\n\n    const root = (window.Shopify?.routes?.root || '/').replace(/\\/?$/, '/');\n    const url = `${root}products/${encodeURIComponent(key)}.js`;\n\n    const request = fetch(url, { credentials: 'same-origin' })\n      .then(response => {\n        if (!response.ok) throw new Error('Product fetch failed');\n        return response.json();\n      })\n      .then(prod => {\n        if (!prod) return null;\n        return {\n          handle: key,\n          available: prod.available !== false,\n          tags: Array.isArray(prod.tags)\n            ? prod.tags\n            : String(prod.tags || '').split(',').map(t => t.trim()).filter(Boolean)\n        };\n      })\n      .catch(() => {\n        productCache.delete(key);\n        return null;\n      });\n\n    productCache.set(key, request);\n    return request;\n  }\n\n  /* ---------------------------\n     Badge styling\n  --------------------------- */\n\n  function decorate(card, forceSold) {\n    const badges = card.querySelectorAll('.card__badge .badge, .badge');\n    let foundSoldBadge = false;\n\n    badges.forEach(badge => {\n      const sold = SOLD.test(badge.textContent.trim());\n      badge.classList.toggle('hn-soldout', sold);\n      if (sold) foundSoldBadge = true;\n    });\n\n    /* If product is sold out via JSON/JS data and theme hid the badge, inject .badge.hn-soldout */\n    if ((forceSold || visibleSold(card)) && !foundSoldBadge) {\n      let badgeWrap = card.querySelector('.card__badge');\n      if (!badgeWrap) {\n        const inner = card.querySelector('.card__inner, .card__content, .card');\n        if (inner) {\n          badgeWrap = document.createElement('div');\n          badgeWrap.className = 'card__badge';\n          inner.appendChild(badgeWrap);\n        }\n      }\n      if (badgeWrap && !badgeWrap.querySelector('.hn-soldout')) {\n        const span = document.createElement('span');\n        span.className = 'badge hn-soldout';\n        span.textContent = 'Sold out';\n        badgeWrap.appendChild(span);\n      }\n    }\n  }\n\n  function decorateGrid(grid) {\n    if (!grid) return;\n    grid.querySelectorAll('.grid__item').forEach(card => decorate(card, false));\n  }\n\n  /* ---------------------------\n     Fast visible-first sorting\n  --------------------------- */\n\n  function sortVisible(grid) {\n    const cards = Array.from(grid.querySelectorAll('.grid__item'));\n    if (cards.length < 2) return;\n\n    const groups = [[], [], []];\n\n    cards.forEach(card => {\n      decorate(card, false);\n\n      if (visibleSold(card)) {\n        groups[2].push(card);\n      } else if (visibleNew(card)) {\n        groups[0].push(card);\n      } else {\n        groups[1].push(card);\n      }\n    });\n\n    const sorted = groups.flat();\n    if (sorted.every((card, index) => card === cards[index])) return;\n\n    rendering = true;\n    try {\n      const fragment = document.createDocumentFragment();\n      sorted.forEach(card => fragment.appendChild(card));\n      grid.appendChild(fragment);\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     Final tag-based sorting\n  --------------------------- */\n\n  async function sortAll(cards) {\n    /* 1. Preload entire collection tags & availability in one shot */\n    await preloadCollectionProducts();\n\n    /* 2. Fetch any remaining uncached handles (e.g., filtered views or /collections/all) with safe concurrency */\n    const missingHandles = [\n      ...new Set(\n        cards\n          .map(handleOf)\n          .filter(h => h && !productCache.has(h))\n      )\n    ];\n\n    if (missingHandles.length > 0) {\n      let index = 0;\n      async function worker() {\n        while (index < missingHandles.length) {\n          await getProduct(missingHandles[index++]);\n        }\n      }\n      await Promise.all(\n        Array.from({ length: Math.min(6, missingHandles.length) }, () => worker())\n      );\n    }\n\n    const groups = [[], [], []];\n\n    for (const card of cards) {\n      card.style.display = '';\n\n      const handle = handleOf(card);\n      const product = handle ? await getProduct(handle) : null;\n\n      const sold = product\n        ? product.available === false\n        : visibleSold(card);\n\n      decorate(card, sold);\n\n      let isNew = visibleNew(card);\n\n      if (!isNew && product && Array.isArray(product.tags)) {\n        isNew = product.tags.some(isNewTag);\n      }\n\n      if (sold) {\n        groups[2].push(card);\n      } else if (isNew) {\n        groups[0].push(card);\n      } else {\n        groups[1].push(card);\n      }\n    }\n\n    return groups.flat();\n  }\n\n  /* ---------------------------\n     Collection URL helpers\n  --------------------------- */\n\n  function currentPage() {\n    const page = parseInt(\n      new URLSearchParams(location.search).get('page') || '1',\n      10\n    );\n    return page > 0 ? page : 1;\n  }\n\n  function pageURL(page) {\n    const url = new URL(location.href);\n    if (page <= 1) {\n      url.searchParams.delete('page');\n    } else {\n      url.searchParams.set('page', String(page));\n    }\n    return url.toString();\n  }\n\n  function collectionKey() {\n    const url = new URL(location.href);\n    url.searchParams.delete('page');\n    url.searchParams.sort();\n    return url.pathname + url.search;\n  }\n\n  /* ---------------------------\n     Pagination\n  --------------------------- */\n\n  function range(current, total) {\n    if (total <= 7) {\n      return Array.from({ length: total }, (_, i) => i + 1);\n    }\n    if (current <= 4) {\n      return [1, 2, 3, 4, 5, '...', total];\n    }\n    if (current >= total - 3) {\n      return [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n    }\n    return [1, '...', current - 1, current, current + 1, '...', total];\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll('.pagination-wrapper,nav.pagination');\n\n    if (total <= 1) {\n      wrappers.forEach(el => {\n        el.style.display = 'none';\n      });\n      return;\n    }\n\n    const link = (page, label, aria) =>\n      '<li><a href=\"' + pageURL(page) +\n      '\" data-hn-page=\"' + page +\n      '\" class=\"pagination__item link\" ' +\n      'aria-label=\"' + aria + '\">' +\n      label + '</a></li>';\n\n    let html = '';\n\n    if (current > 1) {\n      html += link(current - 1, '&lsaquo;', 'Previous page');\n    }\n\n    range(current, total).forEach(p => {\n      if (p === '...') {\n        html += '<li><span class=\"pagination__item\">&hellip;</span></li>';\n      } else if (p === current) {\n        html +=\n          '<li><span class=\"pagination__item pagination__item--current light\" aria-current=\"page\">' +\n          p + '</span></li>';\n      } else {\n        html += link(p, p, 'Page ' + p);\n      }\n    });\n\n    if (current < total) {\n      html += link(current + 1, '&rsaquo;', 'Next page');\n    }\n\n    document.querySelectorAll('.pagination__list').forEach(list => {\n      list.innerHTML = html;\n    });\n\n    wrappers.forEach(el => {\n      el.style.display = '';\n    });\n  }\n\n  /* ---------------------------\n     Render selected page\n  --------------------------- */\n\n  function display(grid, state, requested) {\n    const perPage = Math.max(1, state.perPage);\n    const total = Math.max(1, Math.ceil(state.cards.length / perPage));\n    const page = Math.min(Math.max(1, requested), total);\n\n    const html = state.cards\n      .slice((page - 1) * perPage, page * perPage)\n      .join('');\n\n    rendering = true;\n\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n\n      decorateGrid(grid);\n      renderPagination(page, total);\n\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = collectionKey();\n\n      if (page !== requested) {\n        history.replaceState({ hnPage: page }, '', pageURL(page));\n      }\n\n      if (observer) observer.takeRecords();\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ---------------------------\n     Fetch collection pages\n  --------------------------- */\n\n  async function fetchPage(page, sectionId) {\n    const url = new URL(pageURL(page));\n\n    if (sectionId) {\n      url.searchParams.set('section_id', sectionId);\n    }\n\n    let response = await fetch(url, { credentials: 'same-origin' });\n\n    if (!response.ok && sectionId) {\n      response = await fetch(pageURL(page), { credentials: 'same-origin' });\n    }\n\n    if (!response.ok) {\n      throw new Error('Collection fetch failed');\n    }\n\n    const doc = new DOMParser().parseFromString(\n      await response.text(),\n      'text/html'\n    );\n\n    const grid = doc.getElementById('product-grid');\n\n    if (!grid) {\n      throw new Error('Product grid missing');\n    }\n\n    return {\n      cards: Array.from(grid.querySelectorAll('.grid__item')),\n      doc\n    };\n  }\n\n  function lastPage(doc) {\n    let last = 1;\n\n    [document, doc].forEach(rootNode => {\n      if (!rootNode) return;\n      rootNode.querySelectorAll('.pagination a[href*=\"page=\"]').forEach(link => {\n        try {\n          const page = parseInt(\n            new URL(link.href, location.origin).searchParams.get('page'),\n            10\n          );\n          if (page > last) last = page;\n        } catch (_) {}\n      });\n    });\n\n    return last;\n  }\n\n  /* ---------------------------\n     Rebuild entire collection\n  --------------------------- */\n\n  async function rebuild() {\n    const grid = document.getElementById('product-grid');\n    if (!grid) return;\n\n    const id = ++run;\n    const key = collectionKey();\n\n    decorateGrid(grid);\n\n    const cached = collectionCache.get(key);\n    if (cached) {\n      display(grid, cached, currentPage());\n      return;\n    }\n\n    /* Immediately prioritise visible tags on current page */\n    sortVisible(grid);\n\n    const section = grid.closest('[id^=\"shopify-section-\"]');\n    const sectionId = section\n      ? section.id.replace('shopify-section-', '')\n      : null;\n\n    try {\n      /* Fetch original first page & preload collection JSON concurrently */\n      const [first] = await Promise.all([\n        fetchPage(1, sectionId),\n        preloadCollectionProducts()\n      ]);\n\n      const count = lastPage(first.doc);\n      const pages = new Map();\n      pages.set(1, first.cards);\n\n      let next = 2;\n      async function pageWorker() {\n        while (next <= count) {\n          const p = next++;\n          const result = await fetchPage(p, sectionId);\n          pages.set(p, result.cards);\n        }\n      }\n\n      if (count > 1) {\n        await Promise.all(\n          Array.from({ length: Math.min(8, count - 1) }, () => pageWorker())\n        );\n      }\n\n      if (id !== run || key !== collectionKey()) return;\n\n      /* Deduplicate cards by handle across pages just in case */\n      const seenHandles = new Set();\n      const allCards = [];\n\n      for (let p = 1; p <= count; p++) {\n        (pages.get(p) || []).forEach(card => {\n          const h = handleOf(card);\n          if (h) {\n            if (seenHandles.has(h)) return;\n            seenHandles.add(h);\n          }\n          allCards.push(card);\n        });\n      }\n\n      const sorted = await sortAll(allCards);\n\n      if (id !== run || key !== collectionKey()) return;\n\n      const state = {\n        perPage: Math.max(1, first.cards.length),\n        cards: sorted.map(card => card.outerHTML)\n      };\n\n      collectionCache.set(key, state);\n\n      const active = document.getElementById('product-grid');\n      if (active) {\n        display(active, state, currentPage());\n      }\n    } catch (error) {\n      console.error('HNDRD priority sorting:', error);\n    }\n  }\n\n  window.HNDRDNewFirstV9Rebuild = function () {\n    collectionCache.clear();\n    rebuild();\n  };\n\n  /* ---------------------------\n     Instant pagination\n  --------------------------- */\n\n  document.addEventListener('click', function (event) {\n    const link = event.target.closest('a[data-hn-page]');\n    if (!link) return;\n\n    const grid = document.getElementById('product-grid');\n    const state = collectionCache.get(collectionKey());\n    if (!grid || !state) return;\n\n    event.preventDefault();\n\n    const page = parseInt(link.dataset.hnPage, 10);\n    history.pushState({ hnPage: page }, '', pageURL(page));\n    display(grid, state, page);\n\n    (document.getElementById('ProductGridContainer') || grid).scrollIntoView({\n      behavior: 'smooth',\n      block: 'start'\n    });\n  });\n\n  /* ---------------------------\n     Back / Forward navigation\n  --------------------------- */\n\n  window.addEventListener('popstate', function () {\n    const grid = document.getElementById('product-grid');\n    const state = collectionCache.get(collectionKey());\n\n    if (grid && state) {\n      display(grid, state, currentPage());\n    } else {\n      rebuild();\n    }\n  });\n\n  /* ---------------------------\n     Shopify AJAX filter & Theme Editor support\n  --------------------------- */\n\n  let observer;\n\n  function scheduleCheck() {\n    if (scheduled || rendering) return;\n\n    scheduled = true;\n\n    requestAnimationFrame(() => {\n      scheduled = false;\n\n      const grid = document.getElementById('product-grid');\n      if (!grid) return;\n\n      if (\n        grid !== managedGrid ||\n        collectionKey() !== managedKey ||\n        grid.dataset.hnManaged !== '1'\n      ) {\n        rebuild();\n      }\n    });\n  }\n\n  observer = new MutationObserver(scheduleCheck);\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  document.addEventListener('shopify:section:load', function () {\n    collectionCache.clear();\n    rebuild();\n  });\n\n  /* ---------------------------\n     Start\n  --------------------------- */\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', rebuild);\n  } else {\n    rebuild();\n  }\n})();\n</script>",
