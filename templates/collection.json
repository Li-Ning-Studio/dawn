      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD Signature Sold Out */\n\n#product-grid .badge.hndrd-signature {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 11px !important;\n  padding: 9px 15px 9px 10px !important;\n  width: max-content !important;\n  min-width: 0 !important;\n  overflow: hidden !important;\n\n  background: #101010 !important;\n  color: #fff !important;\n  border: 0 !important;\n  border-radius: 3px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  letter-spacing: .12em !important;\n  line-height: 1.2 !important;\n  white-space: nowrap !important;\n  text-transform: uppercase !important;\n}\n\n/* Logo container */\n.hndrd-signature .hndrd-mark {\n  position: relative;\n  display: block;\n  width: 31px;\n  height: 17px;\n  overflow: hidden;\n  flex-shrink: 0;\n  animation: hndrd-mark-in .65s ease-out both;\n}\n\n/* Crop uploaded screenshot to logo */\n.hndrd-signature .hndrd-mark img {\n  position: absolute;\n  width: 54px;\n  max-width: none;\n  height: auto;\n  top: -6.4px;\n  left: -8px;\n  mix-blend-mode: screen;\n}\n\n/* Fine divider */\n.hndrd-signature .hndrd-rule {\n  width: 1px;\n  height: 16px;\n  background: #444;\n  flex-shrink: 0;\n}\n\n/* Text */\n.hndrd-signature .hndrd-status {\n  position: relative;\n  z-index: 1;\n}\n\n/* Orange precision line */\n#product-grid .badge.hndrd-signature::after {\n  content: \"\";\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background: #FFA300;\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform .45s cubic-bezier(.2,.8,.2,1);\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover\n  .badge.hndrd-signature::after {\n    transform: scaleX(1);\n  }\n}\n\n@keyframes hndrd-mark-in {\n  from {\n    clip-path: inset(0 100% 0 0);\n    opacity: .5;\n  }\n  to {\n    clip-path: inset(0 0 0 0);\n    opacity: 1;\n  }\n}\n\n@media(max-width:749px) {\n  #product-grid .badge.hndrd-signature {\n    padding: 8px 11px 8px 8px !important;\n    font-size: 9px !important;\n    gap: 8px !important;\n  }\n}\n\n@media(prefers-reduced-motion:reduce) {\n  .hndrd-signature .hndrd-mark {\n    animation: none;\n  }\n  #product-grid .badge.hndrd-signature::after {\n    transition: none;\n  }\n}\n</style>\n\n<script>\n(function() {\n  if (window.HNDRDSignatureBadgeLoaded) return;\n  window.HNDRDSignatureBadgeLoaded = true;\n\n  const LOGO_URL = 'PASTE_HNDRD_LOGO_URL_HERE';\n  const pattern = /^(sold\\s*out|out\\s*of\\s*stock)$/i;\n\n  function updateBadges() {\n    const grid = document.getElementById('product-grid');\n    if (!grid) return;\n\n    grid.querySelectorAll(\n      '.card__badge .badge'\n    ).forEach(function(badge) {\n      if (badge.classList.contains('hndrd-signature')) {\n        return;\n      }\n\n      if (!pattern.test(badge.textContent.trim())) {\n        return;\n      }\n\n      badge.classList.add('hndrd-signature');\n      badge.textContent = '';\n\n      const mark = document.createElement('span');\n      mark.className = 'hndrd-mark';\n\n      const img = document.createElement('img');\n      img.src = LOGO_URL;\n      img.alt = '';\n      img.loading = 'eager';\n\n      mark.appendChild(img);\n\n      const rule = document.createElement('span');\n      rule.className = 'hndrd-rule';\n\n      const label = document.createElement('span');\n      label.className = 'hndrd-status';\n      label.textContent = 'SOLD OUT';\n\n      badge.append(mark, rule, label);\n    });\n  }\n\n  function init() {\n    const grid = document.getElementById('product-grid');\n    if (!grid) return;\n\n    updateBadges();\n\n    new MutationObserver(updateBadges).observe(grid, {\n      childList: true,\n      subtree: true\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>",
