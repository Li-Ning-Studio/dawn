    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* ======================================\n   HNDRD | PREMIUM SOLD OUT BADGE\n====================================== */\n\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  isolation: isolate;\n  overflow: hidden !important;\n\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  margin: 0 !important;\n  padding: 9px 16px !important;\n\n  background: rgba(20,20,20,.94) !important;\n  color: #fff !important;\n\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .105em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n\n  animation: hnBadgeIn .6s\n    cubic-bezier(.22,1,.36,1) both;\n\n  transition:\n    background .35s ease,\n    scale .35s ease !important;\n}\n\n/* Subtle glass reflection */\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n\n  background: linear-gradient(\n    110deg,\n    transparent 27%,\n    rgba(255,255,255,.16) 49%,\n    transparent 73%\n  );\n\n  transform: translateX(-150%);\n  transition: transform .75s\n    cubic-bezier(.22,1,.36,1);\n\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@keyframes hnBadgeIn {\n  from {\n    opacity: 0;\n    transform: translateY(7px) scale(.96);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover .hn-soldout {\n    background: #101010 !important;\n    scale: .98;\n  }\n\n  #product-grid .card-wrapper:hover\n  .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media (max-width:749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n    letter-spacing: .08em !important;\n  }\n}\n\n@media (prefers-reduced-motion:reduce) {\n  #product-grid .hn-soldout {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  #product-grid .hn-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDCollectionFinalV5) return;\n  window.HNDRDCollectionFinalV5 = true;\n\n  /* ======================================\n     HNDRD PRODUCT SORTING\n\n     1. NEW ARRIVALS + IN STOCK\n     2. OTHER IN-STOCK (BEST SELLING)\n     3. SOLD OUT\n\n     Shopify collection must use:\n     Sort by Best Selling\n  ====================================== */\n\n  const CACHE_PREFIX = 'hndrd_final_v5:';\n\n  const NEW_TAGS = [\n    'new arrival',\n    'new arrivals',\n    'new-arrival',\n    'new-arrivals',\n    'newarrival',\n    'newarrivals'\n  ];\n\n  const SOLD_REGEX =\n    /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n\n  const NEW_REGEX =\n    /\\bnew[\\s-]*arrivals?\\b/i;\n\n  const cache = new Map();\n  const tagCache = new Map();\n\n  let rendering = false;\n  let processing = false;\n  let managedGrid = null;\n  let managedKey = '';\n  let generation = 0;\n\n  /* ======================================\n     PRODUCT HELPERS\n  ====================================== */\n\n  function getHandle(card) {\n    const link = card.querySelector(\n      'a[href*=\"/products/\"]'\n    );\n\n    if (!link) return '';\n\n    try {\n      const url = new URL(\n        link.href,\n        location.origin\n      );\n\n      const match = url.pathname.match(\n        /\\/products\\/([^/]+)/\n      );\n\n      return match\n        ? decodeURIComponent(match[1])\n        : '';\n\n    } catch (_) {\n      return '';\n    }\n  }\n\n  function isSoldOut(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches(\n        '.sold-out,.out-of-stock,.card--sold-out'\n      ) ||\n      card.querySelector(\n        '[data-sold-out=\"true\"],' +\n        '.card--sold-out'\n      )\n    ) {\n      return true;\n    }\n\n    const badges = card.querySelectorAll(\n      '.card__badge .badge'\n    );\n\n    for (const badge of badges) {\n      if (SOLD_REGEX.test(badge.textContent)) {\n        return true;\n      }\n    }\n\n    const buttons = card.querySelectorAll(\n      'button[disabled],.quick-add__submit'\n    );\n\n    for (const button of buttons) {\n      if (SOLD_REGEX.test(button.textContent)) {\n        return true;\n      }\n    }\n\n    return SOLD_REGEX.test(\n      card.textContent || ''\n    );\n  }\n\n  /* ======================================\n     SOLD OUT BADGE DESIGN\n  ====================================== */\n\n  function decorate(card) {\n    const sold = isSoldOut(card);\n\n    card.querySelectorAll(\n      '.card__badge .badge'\n    ).forEach(function (badge) {\n      const match = SOLD_REGEX.test(\n        badge.textContent.trim()\n      );\n\n      badge.classList.toggle(\n        'hn-soldout',\n        match\n      );\n    });\n\n    return sold;\n  }\n\n  function decorateGrid(grid) {\n    if (!grid) return;\n\n    grid.querySelectorAll('.grid__item')\n      .forEach(decorate);\n  }\n\n  /* ======================================\n     NEW ARRIVAL DETECTION\n  ====================================== */\n\n  function normalizeTag(tag) {\n    return String(tag || '')\n      .toLowerCase()\n      .trim()\n      .replace(/[_\\s-]+/g, ' ');\n  }\n\n  function hasNewTag(tags) {\n    return tags.some(function (tag) {\n      return NEW_TAGS.some(function (name) {\n        return normalizeTag(tag) ===\n          normalizeTag(name);\n      });\n    });\n  }\n\n  function visibleNewArrival(card) {\n    if (\n      card.dataset.hndrdNew === 'true' ||\n      card.dataset.newArrival === 'true' ||\n      card.dataset.collectionPriority === 'new' ||\n      card.querySelector(\n        '[data-hndrd-new=\"true\"],' +\n        '[data-new-arrival=\"true\"]'\n      )\n    ) {\n      return true;\n    }\n\n    const labels = card.querySelectorAll(\n      '.badge,.product-label,' +\n      '[data-tags],[data-product-tags]'\n    );\n\n    for (const label of labels) {\n      const value = [\n        label.textContent || '',\n        label.dataset.tags || '',\n        label.dataset.productTags || ''\n      ].join(' ');\n\n      if (NEW_REGEX.test(value)) {\n        return true;\n      }\n    }\n\n    return false;\n  }\n\n  /* Read Shopify product tags directly\n     without modifying theme files. */\n\n  async function getProductTags(handle) {\n    if (!handle) return [];\n\n    if (tagCache.has(handle)) {\n      return tagCache.get(handle);\n    }\n\n    const task = (async function () {\n      try {\n        const root =\n          window.Shopify &&\n          window.Shopify.routes &&\n          window.Shopify.routes.root\n            ? window.Shopify.routes.root\n            : '/';\n\n        const url =\n          root.replace(/\\/?$/, '/') +\n          'products/' +\n          encodeURIComponent(handle) +\n          '.js';\n\n        const response = await fetch(url, {\n          credentials: 'same-origin'\n        });\n\n        if (!response.ok) return [];\n\n        const product = await response.json();\n\n        if (Array.isArray(product.tags)) {\n          return product.tags;\n        }\n\n        if (typeof product.tags === 'string') {\n          return product.tags.split(',');\n        }\n\n        return [];\n\n      } catch (error) {\n        return [];\n      }\n    })();\n\n    tagCache.set(handle, task);\n\n    return task;\n  }\n\n  /* ======================================\n     DETERMINE NEW ARRIVAL STATUS\n  ====================================== */\n\n  async function identifyNewArrivals(cards) {\n    const handles = [];\n    const unique = new Set();\n\n    cards.forEach(function (card) {\n      if (isSoldOut(card)) return;\n      if (visibleNewArrival(card)) return;\n\n      const handle = getHandle(card);\n\n      if (handle && !unique.has(handle)) {\n        unique.add(handle);\n        handles.push(handle);\n      }\n    });\n\n    /* Limit concurrent product requests */\n\n    let index = 0;\n    const workers = [];\n\n    async function worker() {\n      while (index < handles.length) {\n        const handle = handles[index++];\n\n        await getProductTags(handle);\n      }\n    }\n\n    const count = Math.min(6, handles.length);\n\n    for (let i = 0; i < count; i++) {\n      workers.push(worker());\n    }\n\n    await Promise.all(workers);\n  }\n\n  async function isNewArrival(card) {\n    if (visibleNewArrival(card)) {\n      return true;\n    }\n\n    const handle = getHandle(card);\n\n    if (!handle) return false;\n\n    const tags = await getProductTags(handle);\n\n    return hasNewTag(tags);\n  }\n\n  /* ======================================\n     PRIORITY SORTING\n  ====================================== */\n\n  async function sortCards(cards) {\n    const newArrivals = [];\n    const inStock = [];\n    const soldOut = [];\n\n    await identifyNewArrivals(cards);\n\n    for (const card of cards) {\n      card.style.display = '';\n\n      decorate(card);\n\n      if (isSoldOut(card)) {\n        soldOut.push(card);\n        continue;\n      }\n\n      if (await isNewArrival(card)) {\n        newArrivals.push(card);\n      } else {\n        inStock.push(card);\n      }\n    }\n\n    return newArrivals\n      .concat(inStock)\n      .concat(soldOut);\n  }\n\n  /* ======================================\n     PAGE UTILITIES\n  ====================================== */\n\n  function currentPage() {\n    const number = parseInt(\n      new URLSearchParams(location.search)\n        .get('page') || '1',\n      10\n    );\n\n    return number > 0 ? number : 1;\n  }\n\n  function pageURL(page) {\n    const url = new URL(location.href);\n\n    if (page <= 1) {\n      url.searchParams.delete('page');\n    } else {\n      url.searchParams.set(\n        'page',\n        String(page)\n      );\n    }\n\n    return url.toString();\n  }\n\n  function collectionKey() {\n    const url = new URL(location.href);\n\n    url.searchParams.delete('page');\n    url.searchParams.sort();\n\n    return url.pathname + url.search;\n  }\n\n  function readCache(key) {\n    try {\n      const raw = sessionStorage.getItem(\n        CACHE_PREFIX + key\n      );\n\n      return raw ? JSON.parse(raw) : null;\n    } catch (_) {\n      return null;\n    }\n  }\n\n  function saveCache(key, state) {\n    try {\n      sessionStorage.setItem(\n        CACHE_PREFIX + key,\n        JSON.stringify(state)\n      );\n    } catch (_) {}\n  }\n\n  /* ======================================\n     PAGINATION\n  ====================================== */\n\n  function pageRange(current, total) {\n    if (total <= 7) {\n      return Array.from(\n        { length: total },\n        (_, i) => i + 1\n      );\n    }\n\n    if (current <= 4) {\n      return [\n        1,2,3,4,5,'...',total\n      ];\n    }\n\n    if (current >= total - 3) {\n      return [\n        1,'...',\n        total-4,total-3,total-2,\n        total-1,total\n      ];\n    }\n\n    return [\n      1,'...',\n      current-1,current,\n      current+1,'...',total\n    ];\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll(\n      '.pagination-wrapper,nav.pagination'\n    );\n\n    if (total <= 1) {\n      wrappers.forEach(function (element) {\n        element.style.display = 'none';\n      });\n\n      return;\n    }\n\n    const link = function (page, label, aria) {\n      return (\n        '<li><a href=\"' +\n        pageURL(page) +\n        '\" data-hn-page=\"' +\n        page +\n        '\" class=\"pagination__item link\" ' +\n        'aria-label=\"' +\n        aria +\n        '\">' +\n        label +\n        '</a></li>'\n      );\n    };\n\n    let html = '';\n\n    if (current > 1) {\n      html += link(\n        current - 1,\n        '&lsaquo;',\n        'Previous page'\n      );\n    }\n\n    pageRange(current, total).forEach(\n      function (page) {\n        if (page === '...') {\n          html +=\n            '<li><span class=\"pagination__item\">' +\n            '&hellip;</span></li>';\n\n        } else if (page === current) {\n          html +=\n            '<li><span class=\"pagination__item ' +\n            'pagination__item--current light\" ' +\n            'aria-current=\"page\">' +\n            page +\n            '</span></li>';\n\n        } else {\n          html += link(\n            page,\n            page,\n            'Page ' + page\n          );\n        }\n      }\n    );\n\n    if (current < total) {\n      html += link(\n        current + 1,\n        '&rsaquo;',\n        'Next page'\n      );\n    }\n\n    document.querySelectorAll(\n      '.pagination__list'\n    ).forEach(function (list) {\n      list.innerHTML = html;\n    });\n\n    wrappers.forEach(function (element) {\n      element.style.display = '';\n    });\n  }\n\n  /* ======================================\n     RENDER SORTED PRODUCTS\n  ====================================== */\n\n  function displayPage(\n    grid,\n    state,\n    requestedPage,\n    updateURL\n  ) {\n    const perPage = Math.max(\n      1,\n      state.perPage\n    );\n\n    const totalPages = Math.max(\n      1,\n      Math.ceil(\n        state.cards.length / perPage\n      )\n    );\n\n    const page = Math.min(\n      Math.max(1, requestedPage),\n      totalPages\n    );\n\n    if (updateURL && requestedPage !== page) {\n      history.replaceState(\n        { hnPage: page },\n        '',\n        pageURL(page)\n      );\n    }\n\n    const start = (page - 1) * perPage;\n\n    const html = state.cards\n      .slice(start, start + perPage)\n      .join('');\n\n    rendering = true;\n\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n\n      decorateGrid(grid);\n      renderPagination(page, totalPages);\n\n      grid.dataset.hnManaged = '1';\n\n      managedGrid = grid;\n      managedKey = collectionKey();\n\n    } finally {\n      rendering = false;\n    }\n  }\n\n  /* ======================================\n     FETCH ALL COLLECTION PAGES\n  ====================================== */\n\n  async function fetchPageCards(\n    page,\n    sectionId\n  ) {\n    const url = new URL(pageURL(page));\n\n    if (sectionId) {\n      url.searchParams.set(\n        'section_id',\n        sectionId\n      );\n    }\n\n    let response = await fetch(url.toString(), {\n      credentials: 'same-origin'\n    });\n\n    if (!response.ok && sectionId) {\n      response = await fetch(\n        pageURL(page),\n        { credentials: 'same-origin' }\n      );\n    }\n\n    if (!response.ok) {\n      throw new Error(\n        'Failed to fetch collection page'\n      );\n    }\n\n    const html = await response.text();\n\n    const doc = new DOMParser()\n      .parseFromString(\n        html,\n        'text/html'\n      );\n\n    const grid = doc.getElementById(\n      'product-grid'\n    );\n\n    if (!grid) {\n      throw new Error(\n        'Product grid missing on fetched page'\n      );\n    }\n\n    return Array.from(\n      grid.querySelectorAll('.grid__item')\n    );\n  }\n\n  /* ======================================\n     MAIN COLLECTION SORTING\n  ====================================== */\n\n  async function reorderCollection() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n\n    if (!grid || processing) return;\n\n    processing = true;\n\n    const run = ++generation;\n    const key = collectionKey();\n    const page = currentPage();\n\n    try {\n      const cached =\n        cache.get(key) ||\n        readCache(key);\n\n      if (cached && cached.cards) {\n        cache.set(key, cached);\n\n        displayPage(\n          grid,\n          cached,\n          page,\n          false\n        );\n\n        return;\n      }\n\n      /* Determine collection page count */\n\n      let lastPage = page;\n\n      document.querySelectorAll(\n        '.pagination a[href*=\"page=\"]'\n      ).forEach(function (link) {\n        try {\n          const number = parseInt(\n            new URL(\n              link.href,\n              location.origin\n            ).searchParams.get('page'),\n            10\n          );\n\n          if (number > lastPage) {\n            lastPage = number;\n          }\n\n        } catch (_) {}\n      });\n\n      /* Original visible products */\n\n      const original = Array.from(\n        grid.querySelectorAll('.grid__item')\n      );\n\n      /* Apply badge immediately */\n\n      decorateGrid(grid);\n\n      const section = grid.closest(\n        '[id^=\"shopify-section-\"]'\n      );\n\n      const sectionId = section\n        ? section.id.replace(\n            'shopify-section-',\n            ''\n          )\n        : null;\n\n      const pages = new Map();\n\n      pages.set(page, original);\n\n      const requests = [];\n\n      /* Fetch every remaining page */\n\n      for (\n        let number = 1;\n        number <= lastPage;\n        number++\n      ) {\n        if (!pages.has(number)) {\n          requests.push(\n            fetchPageCards(\n              number,\n              sectionId\n            ).then(function (cards) {\n              pages.set(number, cards);\n            })\n          );\n        }\n      }\n\n      await Promise.all(requests);\n\n      if (\n        run !== generation ||\n        key !== collectionKey()\n      ) {\n        return;\n      }\n\n      /* Collect in Shopify source order */\n\n      const allCards = [];\n\n      for (\n        let number = 1;\n        number <= lastPage;\n        number++\n      ) {\n        const cards = pages.get(number) || [];\n\n        cards.forEach(function (card) {\n          allCards.push(card);\n        });\n      }\n\n      /* Apply final product priority */\n\n      const sorted = await sortCards(allCards);\n\n      if (\n        run !== generation ||\n        key !== collectionKey()\n      ) {\n        return;\n      }\n\n      const state = {\n        perPage: Math.max(\n          1,\n          (pages.get(1) || original).length\n        ),\n        cards: sorted.map(function (card) {\n          return card.outerHTML;\n        })\n      };\n\n      cache.set(key, state);\n      saveCache(key, state);\n\n      const activeGrid =\n        document.getElementById(\n          'product-grid'\n        );\n\n      if (activeGrid) {\n        displayPage(\n          activeGrid,\n          state,\n          currentPage(),\n          true\n        );\n      }\n\n    } catch (error) {\n      console.error(\n        'HNDRD sorting error:',\n        error\n      );\n\n    } finally {\n      processing = false;\n    }\n  }\n\n  /* ======================================\n     INSTANT PAGE SWITCHING\n  ====================================== */\n\n  document.addEventListener(\n    'click',\n    function (event) {\n      const link = event.target.closest(\n        'a[data-hn-page]'\n      );\n\n      if (!link) return;\n\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      const state = cache.get(\n        collectionKey()\n      );\n\n      if (!grid || !state) return;\n\n      event.preventDefault();\n\n      const page = parseInt(\n        link.dataset.hnPage,\n        10\n      );\n\n      history.pushState(\n        { hnPage: page },\n        '',\n        pageURL(page)\n      );\n\n      displayPage(\n        grid,\n        state,\n        page,\n        true\n      );\n\n      const container =\n        document.getElementById(\n          'ProductGridContainer'\n        ) || grid;\n\n      container.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    }\n  );\n\n  /* ======================================\n     BACK / FORWARD NAVIGATION\n  ====================================== */\n\n  window.addEventListener(\n    'popstate',\n    function () {\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      const key = collectionKey();\n\n      const state =\n        cache.get(key) ||\n        readCache(key);\n\n      if (grid && state) {\n        cache.set(key, state);\n\n        displayPage(\n          grid,\n          state,\n          currentPage(),\n          false\n        );\n\n      } else {\n        reorderCollection();\n      }\n    }\n  );\n\n  /* ======================================\n     SHOPIFY AJAX FILTER SUPPORT\n  ====================================== */\n\n  const observer = new MutationObserver(\n    function () {\n      if (rendering || processing) return;\n\n      const grid = document.getElementById(\n        'product-grid'\n      );\n\n      if (!grid) return;\n\n      const key = collectionKey();\n\n      if (\n        grid !== managedGrid ||\n        key !== managedKey ||\n        grid.dataset.hnManaged !== '1'\n      ) {\n        reorderCollection();\n      }\n    }\n  );\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  /* ======================================\n     INITIALIZE\n  ====================================== */\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded',\n      reorderCollection\n    );\n  } else {\n    reorderCollection();\n  }\n\n})();\n</script>",
