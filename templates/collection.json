      "custom_css": [],
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Signature Sold Out Pill */\n\n#product-grid .badge.hndrd-soldout {\n  position: relative !important;\n  isolation: isolate;\n  overflow: hidden !important;\n  display: inline-flex !important;\n  align-items: center;\n  justify-content: center;\n\n  width: fit-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n\n  background: #171717 !important;\n  color: #f8f8f8 !important;\n  border: 1px solid #343434 !important;\n  border-radius: 100px !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 650 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .11em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.12),\n    0 3px 10px rgba(0,0,0,.10) !important;\n\n  transition:\n    transform .3s ease,\n    box-shadow .3s ease !important;\n}\n\n/* One-time satin sheen */\n#product-grid .badge.hndrd-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255,255,255,.18) 48%,\n    transparent 70%\n  );\n  transform: translateX(-150%);\n  animation: hndrd-sheen 3.6s ease-in-out 1 forwards;\n  pointer-events: none;\n}\n\n/* Subtle hover */\n@media (hover: hover) {\n  #product-grid .card-wrapper:hover\n  .badge.hndrd-soldout {\n    transform: translateY(-2px);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.15),\n      0 7px 16px rgba(0,0,0,.17) !important;\n  }\n}\n\n@keyframes hndrd-sheen {\n  0%, 18% {\n    transform: translateX(-150%);\n  }\n  65%, 100% {\n    transform: translateX(150%);\n  }\n}\n\n/* Mobile */\n@media (max-width: 749px) {\n  #product-grid .badge.hndrd-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n    letter-spacing: .08em !important;\n  }\n}\n\n/* Accessibility */\n@media (prefers-reduced-motion: reduce) {\n  #product-grid .badge.hndrd-soldout,\n  #product-grid .badge.hndrd-soldout::before {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  if (window.hndrdBadgeEffectLoaded) return;\n  window.hndrdBadgeEffectLoaded = true;\n\n  const soldOutPattern =\n    /^(sold\\s*out|out\\s*of\\s*stock)$/i;\n\n  function updateBadges() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n    if (!grid) return;\n\n    grid.querySelectorAll(\n      '.card__badge .badge'\n    ).forEach(function (badge) {\n      const soldOut = soldOutPattern.test(\n        badge.textContent.trim()\n      );\n\n      if (soldOut) {\n        badge.classList.add('hndrd-soldout');\n      } else {\n        badge.classList.remove('hndrd-soldout');\n      }\n    });\n  }\n\n  function init() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n\n    if (!grid) return;\n\n    updateBadges();\n\n    const observer = new MutationObserver(\n      updateBadges\n    );\n\n    observer.observe(grid, {\n      childList: true,\n      subtree: true\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded', init\n    );\n  } else {\n    init();\n  }\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
