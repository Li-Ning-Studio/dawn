    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================\n   HNDRD | SIGNATURE SOLD OUT\n   ================================== */\n\n#product-grid .hndrd-soldout {\n  position: relative !important;\n  isolation: isolate !important;\n  overflow: hidden !important;\n\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n\n  background: rgba(22,22,22,.92) !important;\n  background-color: #161616 !important;\n  color: #ffffff !important;\n\n  border: none !important;\n  outline: none !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 600 !important;\n  letter-spacing: .105em !important;\n  line-height: 1.2 !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n  white-space: nowrap !important;\n\n  opacity: 1 !important;\n\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n\n  animation: hndrdBadgeIn .55s\n    cubic-bezier(.22,1,.36,1) both;\n\n  transition:\n    background-color .3s ease !important;\n}\n\n/* Very subtle glass reflection */\n#product-grid .hndrd-soldout::before {\n  content: \"\" !important;\n  position: absolute !important;\n  inset: 0;\n  border-radius: inherit;\n\n  background: linear-gradient(\n    105deg,\n    transparent 25%,\n    rgba(255,255,255,.12) 50%,\n    transparent 75%\n  );\n\n  transform: translateX(-150%);\n  transition: transform .75s\n    cubic-bezier(.22,1,.36,1);\n\n  pointer-events: none;\n}\n\n/* Remove unwanted theme decorations */\n#product-grid .hndrd-soldout::after {\n  content: none !important;\n}\n\n/* Entrance animation */\n@keyframes hndrdBadgeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Product hover */\n@media (hover: hover) {\n  #product-grid .card-wrapper:hover\n  .hndrd-soldout {\n    background-color: #101010 !important;\n  }\n\n  #product-grid .card-wrapper:hover\n  .hndrd-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n/* Mobile */\n@media (max-width:749px) {\n  #product-grid .hndrd-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n    letter-spacing: .075em !important;\n  }\n}\n\n/* Reduced motion */\n@media (prefers-reduced-motion:reduce) {\n  #product-grid .hndrd-soldout {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  #product-grid .hndrd-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDStatusFixV4) return;\n  window.HNDRDStatusFixV4 = true;\n\n  const pattern =\n    /^(sold\\s*out|out\\s*of\\s*stock)$/i;\n\n  function styleBadges() {\n    const grid =\n      document.getElementById('product-grid');\n\n    if (!grid) return;\n\n    grid.querySelectorAll(\n      '.card__badge'\n    ).forEach(function (container) {\n\n      let candidates = container.querySelectorAll(\n        '.badge, span, .card__badge-item'\n      );\n\n      if (!candidates.length) {\n        candidates = [container];\n      }\n\n      candidates.forEach(function (badge) {\n        const text = badge.textContent.trim();\n\n        /* Ignore containers with nested badges */\n        if (\n          badge !== container &&\n          badge.querySelector('.badge')\n        ) return;\n\n        const soldOut = pattern.test(text);\n\n        badge.classList.toggle(\n          'hndrd-soldout',\n          soldOut\n        );\n\n        if (soldOut && badge.textContent !== 'SOLD OUT') {\n          badge.textContent = 'SOLD OUT';\n        }\n      });\n    });\n  }\n\n  let scheduled = false;\n\n  function scheduleUpdate() {\n    if (scheduled) return;\n\n    scheduled = true;\n\n    requestAnimationFrame(function () {\n      scheduled = false;\n      styleBadges();\n    });\n  }\n\n  function init() {\n    styleBadges();\n\n    const grid =\n      document.getElementById('product-grid');\n\n    if (!grid) return;\n\n    const observer = new MutationObserver(\n      scheduleUpdate\n    );\n\n    observer.observe(grid, {\n      childList: true,\n      subtree: true\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded',\n      init\n    );\n  } else {\n    init();\n  }\n})();\n</script>",
