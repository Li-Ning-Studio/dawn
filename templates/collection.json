      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Premium Sold Out (0ms GPU-ready, zero layout shift) */\n#product-grid .badge.hn-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  margin: 0 !important;\n  background: rgba(20, 20, 20, 0.95) !important;\n  color: #fff !important;\n  border: 0 !important;\n  outline: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: 0.10em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n}\n\n#product-grid .hn-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(255, 255, 255, 0.16) 50%,\n    transparent 75%\n  );\n  transform: translateX(-150%);\n  transition: transform 0.65s ease;\n  pointer-events: none;\n}\n\n#product-grid .hn-soldout::after {\n  content: none !important;\n}\n\n@media (hover: hover) {\n  #product-grid .card-wrapper:hover .hn-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media (max-width: 749px) {\n  #product-grid .badge.hn-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n  }\n}\n</style>\n\n{%- if collection and collection.products_count > 0 -%}\n<script id=\"hn-liquid-priority\" type=\"application/json\">\n{\n  \"collection\": {{ collection.handle | json }},\n  \"total\": {{ collection.products_count | json }},\n  \"order\": [\n    {%- assign first_item = true -%}\n    {%- paginate collection.products by 250 -%}\n      {%- for p in collection.products -%}\n        {%- assign p_tags = p.tags | join: '||' | downcase -%}\n        {%- assign is_new = false -%}\n        {%- if p_tags contains 'new arrival' or p_tags contains 'new-arrival' or p_tags contains 'new_arrival' or p_tags contains 'new launch' -%}\n          {%- assign is_new = true -%}\n        {%- endif -%}\n        {%- if p.available and is_new -%}\n          {%- unless first_item -%},{%- endunless -%}{{ p.handle | json }}{%- assign first_item = false -%}\n        {%- endif -%}\n      {%- endfor -%}\n      {%- for p in collection.products -%}\n        {%- assign p_tags = p.tags | join: '||' | downcase -%}\n        {%- assign is_new = false -%}\n        {%- if p_tags contains 'new arrival' or p_tags contains 'new-arrival' or p_tags contains 'new_arrival' or p_tags contains 'new launch' -%}\n          {%- assign is_new = true -%}\n        {%- endif -%}\n        {%- if p.available and is_new == false -%}\n          {%- unless first_item -%},{%- endunless -%}{{ p.handle | json }}{%- assign first_item = false -%}\n        {%- endif -%}\n      {%- endfor -%}\n      {%- for p in collection.products -%}\n        {%- unless p.available -%}\n          {%- unless first_item -%},{%- endunless -%}{{ p.handle | json }}{%- assign first_item = false -%}\n        {%- endunless -%}\n      {%- endfor -%}\n    {%- endpaginate -%}\n  ],\n  \"sold\": {\n    {%- assign first_sold = true -%}\n    {%- paginate collection.products by 250 -%}\n      {%- for p in collection.products -%}\n        {%- unless p.available -%}\n          {%- unless first_sold -%},{%- endunless -%}{{ p.handle | json }}:1{%- assign first_sold = false -%}\n        {%- endunless -%}\n      {%- endfor -%}\n    {%- endpaginate -%}\n  }\n}\n</script>\n{%- endif -%}\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDZeroDelayV11) {\n    if (typeof window.HNDRDZeroDelayV11Run === 'function') {\n      window.HNDRDZeroDelayV11Run();\n    }\n    return;\n  }\n  window.HNDRDZeroDelayV11 = true;\n\n  const CACHE_PREFIX = 'hn_zero_v11:';\n  const memStore = new Map();\n  const domNodePool = new Map(); // Preserves live <li> nodes so images NEVER reload or blink\n\n  const SOLD_RE = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n  const NEW_RE = /\\bnew[\\s_-]*arrivals?\\b/i;\n\n  let rendering = false;\n  let managedGrid = null;\n  let managedKey = '';\n  let activeRun = 0;\n\n  /* 1. Read 0ms Server-Side Liquid Priority Map */\n  function getLiquidMeta() {\n    try {\n      const el = document.getElementById('hn-liquid-priority');\n      if (!el) return null;\n      const data = JSON.parse(el.textContent);\n      const rank = new Map();\n      (data.order || []).forEach((h, i) => rank.set(String(h).toLowerCase(), i));\n      return { rank, sold: data.sold || {}, total: data.total || 0 };\n    } catch (_) {\n      return null;\n    }\n  }\n\n  function handleOf(card) {\n    if (card.dataset.hnHandle) return card.dataset.hnHandle;\n    const a = card.querySelector('a[href*=\"/products/\"]');\n    if (!a) return '';\n    const m = (a.getAttribute('href') || '').match(/\\/products\\/([^/?#]+)/);\n    const h = m && m[1] ? decodeURIComponent(m[1]).toLowerCase() : '';\n    if (h) card.dataset.hnHandle = h;\n    return h;\n  }\n\n  function isSoldCard(card, meta) {\n    const h = handleOf(card);\n    if (meta && h && meta.sold[h]) return true;\n    if (\n      card.dataset.available === 'false' ||\n      card.matches('.sold-out,.out-of-stock,.card--sold-out') ||\n      card.querySelector('.sold-out,.out-of-stock,.card--sold-out,[data-sold-out=\"true\"]')\n    ) return true;\n\n    const badges = card.querySelectorAll('.badge, .card__badge');\n    for (let i = 0; i < badges.length; i++) {\n      if (SOLD_RE.test(badges[i].textContent)) return true;\n    }\n    return false;\n  }\n\n  function decorateCard(card, meta) {\n    const sold = isSoldCard(card, meta);\n    const badges = card.querySelectorAll('.card__badge .badge, .badge');\n    let found = false;\n\n    for (let i = 0; i < badges.length; i++) {\n      const match = SOLD_RE.test(badges[i].textContent);\n      badges[i].classList.toggle('hn-soldout', match);\n      if (match) found = true;\n    }\n\n    if (sold && !found) {\n      let wrap = card.querySelector('.card__badge');\n      if (!wrap) {\n        const inner = card.querySelector('.card__inner, .card__content, .card');\n        if (inner) {\n          wrap = document.createElement('div');\n          wrap.className = 'card__badge';\n          inner.appendChild(wrap);\n        }\n      }\n      if (wrap && !wrap.querySelector('.hn-soldout')) {\n        const s = document.createElement('span');\n        s.className = 'badge hn-soldout';\n        s.textContent = 'Sold out';\n        wrap.appendChild(s);\n      }\n    }\n    return sold;\n  }\n\n  function sortCards(cards, meta) {\n    if (meta && meta.rank.size > 0 && !location.search.includes('filter.')) {\n      return cards.slice().sort((a, b) => {\n        const ra = meta.rank.has(handleOf(a)) ? meta.rank.get(handleOf(a)) : 99999;\n        const rb = meta.rank.has(handleOf(b)) ? meta.rank.get(handleOf(b)) : 99999;\n        return ra - rb;\n      });\n    }\n\n    const g0 = [], g1 = [], g2 = [];\n    for (let i = 0; i < cards.length; i++) {\n      const c = cards[i];\n      if (isSoldCard(c, meta)) g2.push(c);\n      else if (NEW_RE.test(c.textContent || '')) g0.push(c);\n      else g1.push(c);\n    }\n    return g0.concat(g1, g2);\n  }\n\n  function currentPage() {\n    const p = parseInt(new URLSearchParams(location.search).get('page') || '1', 10);\n    return p > 0 ? p : 1;\n  }\n\n  function pageURL(p) {\n    const u = new URL(location.href);\n    if (p <= 1) u.searchParams.delete('page');\n    else u.searchParams.set('page', String(p));\n    return u.toString();\n  }\n\n  function collectionKey() {\n    const u = new URL(location.href);\n    u.searchParams.delete('page');\n    u.searchParams.sort();\n    return u.pathname + u.search;\n  }\n\n  function readCache(k) {\n    try {\n      const r = sessionStorage.getItem(CACHE_PREFIX + k);\n      return r ? JSON.parse(r) : null;\n    } catch (_) { return null; }\n  }\n\n  function writeCache(k, v) {\n    try {\n      sessionStorage.setItem(CACHE_PREFIX + k, JSON.stringify(v));\n    } catch (_) {\n      try { sessionStorage.clear(); sessionStorage.setItem(CACHE_PREFIX + k, JSON.stringify(v)); } catch (_) {}\n    }\n  }\n\n  /* Smart DOM patch: moves existing <li> nodes without resetting <img> elements! */\n  function mountPageCards(grid, htmlList, meta) {\n    const temp = document.createElement('ul');\n    const frag = document.createDocumentFragment();\n\n    // Index currently mounted live nodes so images stay painted in 0ms\n    grid.querySelectorAll('.grid__item').forEach(node => {\n      const h = handleOf(node);\n      if (h) domNodePool.set(h, node);\n    });\n\n    const targetNodes = [];\n    for (let i = 0; i < htmlList.length; i++) {\n      const item = htmlList[i];\n      let liveNode = item.h ? domNodePool.get(item.h) : null;\n      if (!liveNode) {\n        temp.innerHTML = item.html;\n        liveNode = temp.firstElementChild;\n        if (liveNode && item.h) domNodePool.set(item.h, liveNode);\n      }\n      if (liveNode) {\n        liveNode.style.display = '';\n        // Strip Dawn scroll-trigger fade-in delay so swapped cards appear in 0ms\n        liveNode.classList.remove('scroll-trigger', 'animate--slide-in');\n        decorateCard(liveNode, meta);\n        targetNodes.push(liveNode);\n      }\n    }\n\n    const currentChildren = Array.from(grid.querySelectorAll(':scope > .grid__item'));\n    const identical =\n      currentChildren.length === targetNodes.length &&\n      targetNodes.every((n, idx) => n === currentChildren[idx]);\n\n    if (!identical) {\n      targetNodes.forEach(n => frag.appendChild(n));\n      grid.innerHTML = '';\n      grid.appendChild(frag);\n    }\n  }\n\n  function renderPagination(current, total) {\n    const wrappers = document.querySelectorAll('.pagination-wrapper, nav.pagination');\n    if (!wrappers.length) return;\n    if (total <= 1) {\n      wrappers.forEach(w => { w.style.display = 'none'; });\n      return;\n    }\n\n    let pages;\n    if (total <= 7) pages = Array.from({ length: total }, (_, i) => i + 1);\n    else if (current <= 4) pages = [1, 2, 3, 4, 5, '...', total];\n    else if (current >= total - 3) pages = [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n    else pages = [1, '...', current - 1, current, current + 1, '...', total];\n\n    const mk = (p, lbl, aria) =>\n      `<li><a href=\"${pageURL(p)}\" data-hn-page=\"${p}\" class=\"pagination__item link\" aria-label=\"${aria}\">${lbl}</a></li>`;\n\n    let html = current > 1 ? mk(current - 1, '&lsaquo;', 'Previous page') : '';\n    pages.forEach(p => {\n      if (p === '...') html += '<li><span class=\"pagination__item\">&hellip;</span></li>';\n      else if (p === current) html += `<li><span class=\"pagination__item pagination__item--current light\" aria-current=\"page\">${p}</span></li>`;\n      else html += mk(p, p, 'Page ' + p);\n    });\n    if (current < total) html += mk(current + 1, '&rsaquo;', 'Next page');\n\n    document.querySelectorAll('.pagination__list').forEach(l => { l.innerHTML = html; });\n    wrappers.forEach(w => { w.style.display = ''; });\n  }\n\n  function applyState(grid, state, reqPage, meta) {\n    const perPage = Math.max(1, state.perPage);\n    const total = Math.max(1, Math.ceil(state.items.length / perPage));\n    const page = Math.min(Math.max(1, reqPage), total);\n    const slice = state.items.slice((page - 1) * perPage, page * perPage);\n\n    rendering = true;\n    try {\n      mountPageCards(grid, slice, meta);\n      renderPagination(page, total);\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = collectionKey();\n    } finally {\n      rendering = false;\n    }\n  }\n\n  async function run() {\n    const grid = document.getElementById('product-grid');\n    if (!grid) return;\n\n    const myRun = ++activeRun;\n    const key = collectionKey();\n    const curPage = currentPage();\n    const meta = getLiquidMeta();\n\n    /* STEP 1: Synchronous 0ms sort of visible DOM before browser even paints next frame */\n    const liveCards = Array.from(grid.querySelectorAll(':scope > .grid__item'));\n    liveCards.forEach(c => {\n      c.classList.remove('scroll-trigger', 'animate--slide-in');\n      const h = handleOf(c);\n      if (h) domNodePool.set(h, c);\n      decorateCard(c, meta);\n    });\n\n    const cached = memStore.get(key) || readCache(key);\n    if (cached) {\n      memStore.set(key, cached);\n      applyState(grid, cached, curPage, meta);\n      return;\n    }\n\n    // Reorder current visible page in 0.0ms synchronously (zero blink!)\n    if (liveCards.length > 1) {\n      const instantSorted = sortCards(liveCards, meta);\n      if (!instantSorted.every((n, i) => n === liveCards[i])) {\n        rendering = true;\n        try {\n          const f = document.createDocumentFragment();\n          instantSorted.forEach(n => f.appendChild(n));\n          grid.appendChild(f);\n        } finally {\n          rendering = false;\n        }\n      }\n    }\n\n    /* Check total pages */\n    let maxPage = curPage;\n    document.querySelectorAll('.pagination a[href*=\"page=\"]').forEach(a => {\n      try {\n        const p = parseInt(new URL(a.href, location.origin).searchParams.get('page'), 10);\n        if (p > maxPage) maxPage = p;\n      } catch (_) {}\n    });\n\n    if (maxPage <= 1) {\n      const sorted = sortCards(liveCards, meta);\n      const state = {\n        perPage: Math.max(1, sorted.length),\n        items: sorted.map(c => ({ h: handleOf(c), html: c.outerHTML }))\n      };\n      memStore.set(key, state);\n      writeCache(key, state);\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = key;\n      return;\n    }\n\n    /* STEP 2: Fetch remaining pages in parallel using section_id, preserving live DOM nodes */\n    const sec = grid.closest('[id^=\"shopify-section-\"]');\n    const secId = sec ? sec.id.replace('shopify-section-', '') : null;\n\n    const pagesMap = new Map();\n    pagesMap.set(curPage, liveCards);\n\n    const jobs = [];\n    for (let p = 1; p <= maxPage; p++) {\n      if (p === curPage) continue;\n      const u = new URL(pageURL(p));\n      if (secId) u.searchParams.set('section_id', secId);\n\n      jobs.push(\n        fetch(u.toString(), { credentials: 'same-origin', priority: 'high' })\n          .then(r => r.text())\n          .then(txt => {\n            const doc = new DOMParser().parseFromString(txt, 'text/html');\n            const g = doc.getElementById('product-grid');\n            const parsed = g ? Array.from(g.querySelectorAll(':scope > .grid__item')) : [];\n            parsed.forEach(c => {\n              c.classList.remove('scroll-trigger', 'animate--slide-in');\n              const h = handleOf(c);\n              if (h && !domNodePool.has(h)) domNodePool.set(h, c);\n            });\n            pagesMap.set(p, parsed);\n          })\n          .catch(() => {})\n      );\n    }\n\n    await Promise.all(jobs);\n    if (myRun !== activeRun || key !== collectionKey()) return;\n\n    const seen = new Set();\n    const all = [];\n    for (let p = 1; p <= maxPage; p++) {\n      (pagesMap.get(p) || []).forEach(c => {\n        const h = handleOf(c);\n        if (h) {\n          if (seen.has(h)) return;\n          seen.add(h);\n        }\n        all.push(c);\n      });\n    }\n\n    const p1 = pagesMap.get(1) || liveCards;\n    const finalSorted = sortCards(all, meta);\n    const state = {\n      perPage: Math.max(1, p1.length),\n      items: finalSorted.map(c => ({ h: handleOf(c), html: c.outerHTML }))\n    };\n\n    memStore.set(key, state);\n    writeCache(key, state);\n\n    const activeGrid = document.getElementById('product-grid');\n    if (activeGrid) applyState(activeGrid, state, currentPage(), meta);\n  }\n\n  window.HNDRDZeroDelayV11Run = function () {\n    memStore.clear();\n    domNodePool.clear();\n    run();\n  };\n\n  /* Instant 0ms pagination clicks */\n  document.addEventListener('click', function (e) {\n    const a = e.target.closest('a[data-hn-page]');\n    if (!a) return;\n    const grid = document.getElementById('product-grid');\n    const state = memStore.get(collectionKey()) || readCache(collectionKey());\n    if (!grid || !state) return;\n\n    e.preventDefault();\n    const p = parseInt(a.dataset.hnPage, 10);\n    history.pushState({ hnPage: p }, '', pageURL(p));\n    applyState(grid, state, p, getLiquidMeta());\n    (document.getElementById('ProductGridContainer') || grid).scrollIntoView({ block: 'start' });\n  });\n\n  window.addEventListener('popstate', function () {\n    const grid = document.getElementById('product-grid');\n    const state = memStore.get(collectionKey()) || readCache(collectionKey());\n    if (grid && state) applyState(grid, state, currentPage(), getLiquidMeta());\n    else run();\n  });\n\n  /* Watch Dawn AJAX facet filter updates */\n  let rafPending = false;\n  const obs = new MutationObserver(() => {\n    if (rendering || rafPending) return;\n    rafPending = true;\n    requestAnimationFrame(() => {\n      rafPending = false;\n      const g = document.getElementById('product-grid');\n      if (g && (g !== managedGrid || collectionKey() !== managedKey || g.dataset.hnManaged !== '1')) {\n        run();\n      }\n    });\n  });\n  obs.observe(document.body, { childList: true, subtree: true });\n\n  /* Execute IMMEDIATELY without waiting for DOMContentLoaded since Custom Liquid sits after Product Grid! */\n  run();\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', run, { once: true });\n  }\n})();\n</script>",
