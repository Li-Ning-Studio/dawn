        "custom_liquid": "<script>\n  (function () {\n    const SOLD_OUT_REGEX = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n    const BATCH_SIZE = 4; // Fetches pages in safe parallel batches\n    let isReflowing = false;\n\n    function isCardSoldOut(card) {\n      if (\n        card.classList.contains('sold-out') ||\n        card.classList.contains('out-of-stock') ||\n        card.querySelector('.sold-out, .out-of-stock, .card--sold-out')\n      ) {\n        return true;\n      }\n\n      const badges = card.querySelectorAll('.badge, .card__badge, [class*=\"badge\"]');\n      for (const badge of badges) {\n        if (SOLD_OUT_REGEX.test(badge.textContent)) return true;\n      }\n\n      const buttons = card.querySelectorAll('button[disabled], .quick-add__submit');\n      for (const btn of buttons) {\n        if (SOLD_OUT_REGEX.test(btn.textContent)) return true;\n      }\n\n      return SOLD_OUT_REGEX.test(card.textContent);\n    }\n\n    function hideSoldOutImmediately(root = document) {\n      root.querySelectorAll('#product-grid .grid__item').forEach((card) => {\n        if (isCardSoldOut(card)) {\n          card.style.display = 'none';\n        }\n      });\n    }\n\n    function buildPageUrl(pageNum) {\n      const url = new URL(window.location.href);\n      if (pageNum <= 1) {\n        url.searchParams.delete('page');\n      } else {\n        url.searchParams.set('page', pageNum);\n      }\n      return url.toString();\n    }\n\n    function getPaginationRange(current, total) {\n      if (total <= 7) {\n        return Array.from({ length: total }, (_, i) => i + 1);\n      }\n      if (current <= 4) {\n        return [1, 2, 3, 4, 5, '...', total];\n      }\n      if (current >= total - 3) {\n        return [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n      }\n      return [1, '...', current - 1, current, current + 1, '...', total];\n    }\n\n    function renderPagination(currentPage, totalPages) {\n      const wrappers = document.querySelectorAll('.pagination-wrapper, nav.pagination');\n      if (!wrappers.length) return;\n\n      if (totalPages <= 1) {\n        wrappers.forEach((el) => (el.style.display = 'none'));\n        return;\n      }\n\n      const pages = getPaginationRange(currentPage, totalPages);\n      const prevHtml =\n        currentPage > 1\n          ? `<li><a href=\"${buildPageUrl(currentPage - 1)}\" class=\"pagination__item pagination__item--next pagination__item-arrow link motion-reduce\" aria-label=\"Previous page\">&lsaquo;</a></li>`\n          : '';\n      const nextHtml =\n        currentPage < totalPages\n          ? `<li><a href=\"${buildPageUrl(currentPage + 1)}\" class=\"pagination__item pagination__item--prev pagination__item-arrow link motion-reduce\" aria-label=\"Next page\">&rsaquo;</a></li>`\n          : '';\n\n      const itemsHtml = pages\n        .map((p) => {\n          if (p === '...') {\n            return `<li><span class=\"pagination__item\">&hellip;</span></li>`;\n          }\n          if (p === currentPage) {\n            return `<li><a role=\"link\" aria-disabled=\"true\" class=\"pagination__item pagination__item--current light\" aria-current=\"page\">${p}</a></li>`;\n          }\n          return `<li><a href=\"${buildPageUrl(p)}\" class=\"pagination__item link\">${p}</a></li>`;\n        })\n        .join('');\n\n      document.querySelectorAll('.pagination__list').forEach((list) => {\n        list.innerHTML = prevHtml + itemsHtml + nextHtml;\n      });\n\n      wrappers.forEach((el) => (el.style.display = ''));\n    }\n\n    function updateProductCount(totalInStock) {\n      const label = `${totalInStock} ${totalInStock === 1 ? 'product' : 'products'}`;\n      document.querySelectorAll('#ProductCount, #ProductCountDesktop').forEach((el) => {\n        el.textContent = label;\n      });\n    }\n\n    async function fetchPageCards(pageNum) {\n      const res = await fetch(buildPageUrl(pageNum), { credentials: 'same-origin' });\n      const html = await res.text();\n      const doc = new DOMParser().parseFromString(html, 'text/html');\n      return Array.from(doc.querySelectorAll('#product-grid .grid__item'));\n    }\n\n    async function reflowCollection() {\n      const grid = document.getElementById('product-grid');\n      if (!grid || isReflowing) return;\n\n      const reflowKey = window.location.pathname + window.location.search;\n      if (grid.dataset.reflowKey === reflowKey) return;\n\n      isReflowing = true;\n      hideSoldOutImmediately(grid);\n\n      try {\n        const urlParams = new URLSearchParams(window.location.search);\n        const currentPage = Math.max(1, parseInt(urlParams.get('page') || '1', 10));\n\n        // Detect highest page number currently shown in pagination\n        let maxPage = currentPage;\n        document.querySelectorAll('.pagination a[href*=\"page=\"]').forEach((link) => {\n          try {\n            const p = parseInt(new URL(link.href, window.location.origin).searchParams.get('page'), 10);\n            if (!isNaN(p) && p > maxPage) maxPage = p;\n          } catch (_) {}\n        });\n\n        const currentCards = Array.from(grid.querySelectorAll('.grid__item'));\n\n        // Single-page collection: just hide sold-out items & hide pagination\n        if (maxPage <= 1) {\n          const inStock = currentCards.filter((c) => !isCardSoldOut(c));\n          inStock.forEach((c) => (c.style.display = ''));\n          renderPagination(1, 1);\n          updateProductCount(inStock.length);\n          grid.dataset.reflowKey = reflowKey;\n          return;\n        }\n\n        // Multi-page collection: gather all pages so in-stock items pull forward\n        const pagesMap = new Map();\n        pagesMap.set(currentPage, currentCards);\n\n        const pagesToFetch = [];\n        for (let p = 1; p <= maxPage; p++) {\n          if (p !== currentPage) pagesToFetch.push(p);\n        }\n\n        for (let i = 0; i < pagesToFetch.length; i += BATCH_SIZE) {\n          const batch = pagesToFetch.slice(i, i + BATCH_SIZE);\n          const results = await Promise.all(\n            batch.map(async (p) => ({ page: p, cards: await fetchPageCards(p) }))\n          );\n          results.forEach(({ page, cards }) => pagesMap.set(page, cards));\n        }\n\n        // Determine standard items per page from Page 1\n        const page1Cards = pagesMap.get(1) || currentCards;\n        const itemsPerPage = Math.max(1, page1Cards.length);\n\n        // Collect all in-stock cards in exact collection sort order\n        const allInStockCards = [];\n        for (let p = 1; p <= maxPage; p++) {\n          const cards = pagesMap.get(p) || [];\n          cards.forEach((card) => {\n            if (!isCardSoldOut(card)) {\n              card.style.display = '';\n              allInStockCards.push(card);\n            }\n          });\n        }\n\n        const totalInStock = allInStockCards.length;\n        const newTotalPages = Math.max(1, Math.ceil(totalInStock / itemsPerPage));\n\n        // If user is on an empty trailing page (e.g., page 5 when only 3 have stock), redirect to last valid page\n        if (currentPage > newTotalPages) {\n          window.location.replace(buildPageUrl(newTotalPages));\n          return;\n        }\n\n        // Slice the exact products that belong on the current page\n        const startIdx = (currentPage - 1) * itemsPerPage;\n        const pageSlice = allInStockCards.slice(startIdx, startIdx + itemsPerPage);\n\n        grid.innerHTML = '';\n        pageSlice.forEach((card) => {\n          const node = card.ownerDocument === document ? card : document.importNode(card, true);\n          node.style.display = '';\n          grid.appendChild(node);\n        });\n\n        renderPagination(currentPage, newTotalPages);\n        updateProductCount(totalInStock);\n        grid.dataset.reflowKey = reflowKey;\n      } catch (err) {\n        console.error('Collection reflow error:', err);\n      } finally {\n        isReflowing = false;\n      }\n    }\n\n    // Run immediately on load\n    hideSoldOutImmediately();\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', reflowCollection);\n    } else {\n      reflowCollection();\n    }\n\n    // Re-run automatically when Dawn's AJAX filters or sorting replace the product grid\n    const observer = new MutationObserver(() => {\n      if (isReflowing) return;\n      hideSoldOutImmediately();\n      reflowCollection();\n    });\n    observer.observe(document.body, { childList: true, subtree: true });\n  })();\n</script>",
