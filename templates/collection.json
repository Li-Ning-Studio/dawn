        "custom_liquid": "<script>\n(function () {\n  if (window.__liningShowcaseInit) return;\n  window.__liningShowcaseInit = true;\n\n  const PER_ROW = 3;\n  const MAX_PAGES_FETCH = 15;\n  const SHOWCASE_VALUE = '__showcase__';\n  const SHOWCASE_LABEL = 'Recommended';\n  const CACHE_TTL_MS = 5 * 60 * 1000;\n\n  // Store-wide category priority order:\n  // 1. Rackets -> 2. Shoes -> 3. Bags/Backpacks -> 4. Strings -> 5. Grips -> 6. Shuttlecocks\n  // -> 7. T-Shirts -> 8. Shorts -> 9. Pants -> 10. Hoodies -> 11. Jackets -> 12. Skirts\n  // -> 13. Socks -> 14. Insoles -> 15. Rest all categories\n  const MASTER_CATEGORY_ORDER = [\n    'Badminton Racket',\n    'Badminton Shoes',\n    'Badminton Bag',\n    'Badminton Kit Bag',\n    'Racket Bag',\n    'Backpack',\n    'Badminton String',\n    'Badminton Grip',\n    'Shuttlecock',\n    'T-Shirt',\n    'Polo',\n    'Jersey',\n    'Shorts',\n    'Pant',\n    'Track Pant',\n    'Hoodie',\n    'Jacket',\n    'Skirt',\n    'Socks',\n    'Insole',\n    'Badminton Net',\n    'Pickleball Paddle',\n    'Wrist Band',\n    'Towels',\n    'Water Bottle',\n    'Badminton Off-Court Slippers',\n    'Key Chain'\n  ];\n\n  const CATEGORY_RANK = new Map(\n    MASTER_CATEGORY_ORDER.map((cat, idx) => [cat.toLowerCase(), idx])\n  );\n\n  let isApplying = false;\n  let activeFetchKey = null;\n  const inFlightPrefetches = new Set();\n\n  function isShowcaseMode() {\n    const search = window.location.search;\n    if (!search) return true;\n    const params = new URLSearchParams(search);\n    for (const k of params.keys()) {\n      if (k.startsWith('filter.')) return false;\n    }\n    const sortBy = params.get('sort_by');\n    return !sortBy || sortBy === SHOWCASE_VALUE;\n  }\n\n  function syncSortDropdowns(selectRecommended) {\n    const selects = document.querySelectorAll('select[name=\"sort_by\"]');\n    for (let i = 0; i < selects.length; i++) {\n      const select = selects[i];\n      let opt = select.querySelector(`option[value=\"${SHOWCASE_VALUE}\"]`);\n      if (!opt) {\n        opt = document.createElement('option');\n        opt.value = SHOWCASE_VALUE;\n        opt.textContent = SHOWCASE_LABEL;\n        select.insertBefore(opt, select.firstChild);\n      }\n      if (selectRecommended && select.value !== SHOWCASE_VALUE) {\n        select.value = SHOWCASE_VALUE;\n      }\n    }\n  }\n\n  function isSoldOut(card) {\n    if (card.querySelector('.price--sold-out')) return true;\n    return /sold\\s*out/i.test(card.textContent || '');\n  }\n\n  function isNewArrival(card) {\n    return /new\\s*arrival/i.test(card.textContent || '');\n  }\n\n  function getProductKey(card) {\n    const link = card.querySelector('.card__heading a, a[href*=\"/products/\"]');\n    if (!link) return null;\n    const href = link.getAttribute('href') || '';\n    const qIdx = href.indexOf('?');\n    return qIdx !== -1 ? href.slice(0, qIdx) : href;\n  }\n\n  function normalizeType(raw) {\n    const clean = raw.trim();\n    const lower = clean.toLowerCase();\n\n    if (lower === 'racket' || lower === 'rackets' || lower === 'badminton rackets') return 'Badminton Racket';\n    if (lower === 'shoe' || lower === 'shoes') return 'Badminton Shoes';\n    if (lower === 'bags' || lower === 'badminton bags') return 'Badminton Bag';\n    if (lower === 'badminton kit bags' || lower === 'kit bag' || lower === 'kit bags') return 'Badminton Kit Bag';\n    if (lower === 'racket bags') return 'Racket Bag';\n    if (lower === 'backpacks') return 'Backpack';\n    if (lower === 'string' || lower === 'strings' || lower === 'badminton strings') return 'Badminton String';\n    if (lower === 'grip' || lower === 'grips' || lower === 'badminton grips') return 'Badminton Grip';\n    if (lower === 'shuttlecocks') return 'Shuttlecock';\n    if (lower === 't-shirt' || lower === 't-shirts' || lower === 'tshirt' || lower === 'tshirts') return 'T-Shirt';\n    if (lower === 'polo' || lower === 'polos') return 'Polo';\n    if (lower === 'jersey' || lower === 'jerseys') return 'Jersey';\n    if (lower === 'short' || lower === 'shorts') return 'Shorts';\n    if (lower === 'pant' || lower === 'pants') return 'Pant';\n    if (lower === 'track pant' || lower === 'track pants') return 'Track Pant';\n    if (lower === 'hoodie' || lower === 'hoodies') return 'Hoodie';\n    if (lower === 'jacket' || lower === 'jackets') return 'Jacket';\n    if (lower === 'skirt' || lower === 'skirts') return 'Skirt';\n    if (lower === 'sock' || lower === 'socks') return 'Socks';\n    if (lower === 'insole' || lower === 'insoles') return 'Insole';\n    if (lower === 'badminton net' || lower === 'badminton nets') return 'Badminton Net';\n    if (lower === 'paddle' || lower === 'paddles' || lower === 'pickleball paddles') return 'Pickleball Paddle';\n\n    const idx = CATEGORY_RANK.get(lower);\n    return idx !== undefined ? MASTER_CATEGORY_ORDER[idx] : clean;\n  }\n\n  function detectCategory(card) {\n    const cardText = card.textContent || '';\n    const bulletIdx = cardText.indexOf('•');\n    if (bulletIdx !== -1) {\n      const afterBullet = cardText.slice(bulletIdx + 1);\n      const endMatch = afterBullet.match(/^([^\\n\\r₹•]+)/);\n      if (endMatch && endMatch[1]) {\n        const rawType = endMatch[1].trim();\n        if (rawType) return normalizeType(rawType);\n      }\n    }\n\n    const link = card.querySelector('.card__heading a, a[href*=\"/products/\"]');\n    const label = ((link ? link.textContent : '') + ' ' + (link ? link.getAttribute('href') : '')).toLowerCase();\n\n    if (label.includes('racket') || label.includes('racquet')) return 'Badminton Racket';\n    if (label.includes('shoe')) return 'Badminton Shoes';\n    if (label.includes('kit-bag') || label.includes('kit bag')) return 'Badminton Kit Bag';\n    if (label.includes('backpack')) return 'Backpack';\n    if (label.includes('cover') || label.includes('bag')) return 'Badminton Bag';\n    if (label.includes('string') || label.includes('/products/n68')) return 'Badminton String';\n    if (label.includes('grip')) return 'Badminton Grip';\n    if (label.includes('shuttle')) return 'Shuttlecock';\n    if (label.includes('t-shirt') || label.includes('tshirt') || label.includes('tee')) return 'T-Shirt';\n    if (label.includes('polo')) return 'Polo';\n    if (label.includes('jersey')) return 'Jersey';\n    if (label.includes('short')) return 'Shorts';\n    if (label.includes('track-pant') || label.includes('track pant')) return 'Track Pant';\n    if (label.includes('pant') || label.includes('jogger')) return 'Pant';\n    if (label.includes('hoodie')) return 'Hoodie';\n    if (label.includes('jacket')) return 'Jacket';\n    if (label.includes('skirt')) return 'Skirt';\n    if (label.includes('sock')) return 'Socks';\n    if (label.includes('insole')) return 'Insole';\n    if (label.includes('net')) return 'Badminton Net';\n    if (label.includes('paddle')) return 'Pickleball Paddle';\n    if (label.includes('wrist')) return 'Wrist Band';\n    if (label.includes('towel')) return 'Towels';\n    if (label.includes('bottle')) return 'Water Bottle';\n    if (label.includes('slipper')) return 'Badminton Off-Court Slippers';\n\n    return 'Other';\n  }\n\n  function getGridSectionId() {\n    const wrapper = document.querySelector('[id^=\"shopify-section-\"][id*=\"product-grid\"]');\n    return wrapper ? wrapper.id.replace('shopify-section-', '') : null;\n  }\n\n  function getTotalPages(doc, currentPage, itemsPerPage) {\n    let maxPage = currentPage;\n\n    doc.querySelectorAll('.pagination__list a, .pagination__list span').forEach(el => {\n      const n = parseInt(el.textContent.trim(), 10);\n      if (!isNaN(n) && n > maxPage) maxPage = n;\n    });\n\n    const countEl = doc.querySelector('#ProductCountDesktop, #ProductCount, .product-count__text');\n    if (countEl) {\n      const countMatch = countEl.textContent.match(/(\\d+)\\s*products?/i);\n      if (countMatch) {\n        const totalProducts = parseInt(countMatch[1], 10);\n        const calcPages = Math.ceil(totalProducts / itemsPerPage);\n        if (calcPages > maxPage) maxPage = calcPages;\n      }\n    }\n\n    return Math.min(maxPage, MAX_PAGES_FETCH);\n  }\n\n  function getCategorySequence(discoveredCategories) {\n    return discoveredCategories.sort((a, b) => {\n      if (a === 'Other') return 1;\n      if (b === 'Other') return -1;\n\n      const idxA = CATEGORY_RANK.get(a.toLowerCase());\n      const idxB = CATEGORY_RANK.get(b.toLowerCase());\n\n      if (idxA !== undefined && idxB !== undefined) return idxA - idxB;\n      if (idxA !== undefined) return -1;\n      if (idxB !== undefined) return 1;\n      return 0;\n    });\n  }\n\n  function groupCardsByCategory(cards) {\n    const buckets = new Map();\n\n    for (let i = 0; i < cards.length; i++) {\n      const card = cards[i];\n      const cat = detectCategory(card);\n      let group = buckets.get(cat);\n      if (!group) {\n        group = { newArrivals: [], regular: [] };\n        buckets.set(cat, group);\n      }\n      if (isNewArrival(card)) {\n        group.newArrivals.push(card);\n      } else {\n        group.regular.push(card);\n      }\n    }\n\n    const mergedBuckets = new Map();\n    buckets.forEach((group, cat) => {\n      mergedBuckets.set(cat, group.newArrivals.concat(group.regular));\n    });\n\n    return mergedBuckets;\n  }\n\n  // 1. IN-STOCK SHOWCASE:\n  // Rotates in rows of 3 by category (New Arrivals first, topped up with older products).\n  // If a category leaves 1 or 2 slots open in a row, the next category fills those slots\n  // plus a full row of 3 below it so there are zero empty spaces.\n  function buildInStockShowcaseOrder(cards) {\n    const mergedBuckets = groupCardsByCategory(cards);\n    const categorySequence = getCategorySequence(Array.from(mergedBuckets.keys()));\n    const result = [];\n\n    let hasMore = true;\n    while (hasMore) {\n      hasMore = false;\n      for (let c = 0; c < categorySequence.length; c++) {\n        const list = mergedBuckets.get(categorySequence[c]);\n        if (list && list.length > 0) {\n          const col = result.length % PER_ROW;\n          const takeCount = col === 0 ? PER_ROW : (PER_ROW - col) + PER_ROW;\n          const taken = list.splice(0, takeCount);\n          for (let t = 0; t < taken.length; t++) {\n            result.push(taken[t]);\n          }\n          if (list.length > 0) hasMore = true;\n        }\n      }\n    }\n\n    return result;\n  }\n\n  // 2. SOLD-OUT BLOCKS (NO MIX & MATCH):\n  // Groups all out-of-stock products cleanly by category in full sequential blocks\n  // following the exact same category priority order.\n  function buildSoldOutBlockOrder(cards) {\n    const mergedBuckets = groupCardsByCategory(cards);\n    const categorySequence = getCategorySequence(Array.from(mergedBuckets.keys()));\n    const result = [];\n\n    for (let c = 0; c < categorySequence.length; c++) {\n      const list = mergedBuckets.get(categorySequence[c]);\n      if (list && list.length > 0) {\n        for (let i = 0; i < list.length; i++) {\n          result.push(list[i]);\n        }\n      }\n    }\n\n    return result;\n  }\n\n  function renderOrderedSlice(grid, pageMap, totalPages, currentPage, itemsPerPage) {\n    const seenProducts = new Set();\n    const inStockCards = [];\n    const soldOutCards = [];\n\n    for (let p = 1; p <= totalPages; p++) {\n      const cards = pageMap.get(p) || [];\n      for (let i = 0; i < cards.length; i++) {\n        const card = cards[i];\n        const key = getProductKey(card);\n        if (key && seenProducts.has(key)) continue;\n        if (key) seenProducts.add(key);\n\n        if (isSoldOut(card)) {\n          soldOutCards.push(card);\n        } else {\n          inStockCards.push(card);\n        }\n      }\n    }\n\n    const finalOrder = buildInStockShowcaseOrder(inStockCards).concat(\n      buildSoldOutBlockOrder(soldOutCards)\n    );\n    const start = (currentPage - 1) * itemsPerPage;\n    const slice = finalOrder.slice(start, start + itemsPerPage);\n\n    isApplying = true;\n    try {\n      const fragment = document.createDocumentFragment();\n      for (let i = 0; i < slice.length; i++) {\n        const card = slice[i];\n        card.classList.remove('scroll-trigger--offscreen');\n        fragment.appendChild(card);\n      }\n      grid.replaceChildren(fragment);\n      grid.dataset.showcaseSorted = 'true';\n      grid.style.opacity = '1';\n    } finally {\n      isApplying = false;\n    }\n  }\n\n  function readCachedPages(cacheKey) {\n    try {\n      const raw = sessionStorage.getItem(cacheKey);\n      if (!raw) return null;\n      const parsed = JSON.parse(raw);\n      if (Date.now() - parsed.ts > CACHE_TTL_MS) {\n        sessionStorage.removeItem(cacheKey);\n        return null;\n      }\n      return parsed.pages;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function writeCachedPages(cacheKey, pageHtmlMap) {\n    try {\n      sessionStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), pages: pageHtmlMap }));\n    } catch (e) {}\n  }\n\n  function parseCardsFromHtml(htmlString) {\n    const doc = new DOMParser().parseFromString(htmlString, 'text/html');\n    return Array.from(\n      doc.querySelectorAll('#product-grid > li.grid__item, .product-grid > li.grid__item')\n    );\n  }\n\n  async function fetchCollectionPage(pathname, pageNum, sectionId) {\n    const url = new URL(pathname, window.location.origin);\n    url.searchParams.set('page', pageNum);\n    if (sectionId) url.searchParams.set('section_id', sectionId);\n\n    const res = await fetch(url.toString(), { credentials: 'same-origin' });\n    const html = await res.text();\n    const cards = parseCardsFromHtml(html);\n\n    if (cards.length > 0 || !sectionId) return cards;\n\n    // Fallback to full page URL if section_id returned empty\n    const fallbackUrl = new URL(pathname, window.location.origin);\n    fallbackUrl.searchParams.set('page', pageNum);\n    const fallbackRes = await fetch(fallbackUrl.toString(), { credentials: 'same-origin' });\n    return parseCardsFromHtml(await fallbackRes.text());\n  }\n\n  async function arrangeShowcaseGrid() {\n    if (isApplying) return;\n\n    if (!isShowcaseMode()) {\n      syncSortDropdowns(false);\n      return;\n    }\n\n    syncSortDropdowns(true);\n\n    const grid = document.querySelector('#product-grid, .product-grid');\n    if (!grid || grid.dataset.showcaseSorted === 'true') return;\n\n    const params = new URLSearchParams(window.location.search);\n    const currentPage = parseInt(params.get('page') || '1', 10);\n    const currentItems = Array.from(grid.querySelectorAll(':scope > li.grid__item'));\n    if (currentItems.length === 0) return;\n\n    const itemsPerPage = currentPage === 1 && currentItems.length >= 12 ? currentItems.length : 24;\n    const totalPages = getTotalPages(document, currentPage, itemsPerPage);\n    const cacheKey = `lining_showcase_v6_${window.location.pathname}_${totalPages}`;\n\n    const pageMap = new Map();\n    pageMap.set(currentPage, currentItems);\n\n    // 1. Single-page collection: 0ms instant synchronous render\n    if (totalPages <= 1) {\n      renderOrderedSlice(grid, pageMap, 1, 1, itemsPerPage);\n      return;\n    }\n\n    // 2. Warm cache: 0ms instant synchronous render (initial load, pagination, and Back button)\n    const cached = readCachedPages(cacheKey);\n    if (cached) {\n      for (let p = 1; p <= totalPages; p++) {\n        if (p !== currentPage && cached[p]) {\n          pageMap.set(p, parseCardsFromHtml(cached[p]));\n        }\n      }\n      renderOrderedSlice(grid, pageMap, totalPages, currentPage, itemsPerPage);\n      return;\n    }\n\n    // 3. Cold cache: hold grid once and render ONE single atomic update when all pages arrive\n    // (prevents double-jumping or reverting!)\n    const fetchToken = `${cacheKey}_${currentPage}`;\n    if (activeFetchKey === fetchToken) return;\n    activeFetchKey = fetchToken;\n    grid.style.opacity = '0';\n\n    try {\n      const sectionId = getGridSectionId();\n      const htmlToCache = {};\n      htmlToCache[currentPage] = `<ul>${currentItems.map(el => el.outerHTML).join('')}</ul>`;\n\n      const fetches = [];\n      for (let p = 1; p <= totalPages; p++) {\n        if (p === currentPage) continue;\n        fetches.push(\n          fetchCollectionPage(window.location.pathname, p, sectionId).then(cards => {\n            pageMap.set(p, cards);\n            htmlToCache[p] = `<ul>${cards.map(el => el.outerHTML).join('')}</ul>`;\n          })\n        );\n      }\n\n      await Promise.all(fetches);\n      writeCachedPages(cacheKey, htmlToCache);\n\n      if (!isShowcaseMode()) {\n        syncSortDropdowns(false);\n        const liveGrid = document.querySelector('#product-grid, .product-grid');\n        if (liveGrid) liveGrid.style.opacity = '1';\n        return;\n      }\n\n      const activeGrid = document.querySelector('#product-grid, .product-grid');\n      if (activeGrid) {\n        renderOrderedSlice(activeGrid, pageMap, totalPages, currentPage, itemsPerPage);\n      }\n    } finally {\n      activeFetchKey = null;\n      const liveGrid = document.querySelector('#product-grid, .product-grid');\n      if (liveGrid) liveGrid.style.opacity = '1';\n    }\n  }\n\n  function prefetchCollection(href) {\n    try {\n      const url = new URL(href, window.location.origin);\n      if (url.origin !== window.location.origin) return;\n      if (!url.pathname.startsWith('/collections/')) return;\n      if (url.search && url.search.includes('filter.')) return;\n      if (inFlightPrefetches.has(url.pathname)) return;\n\n      inFlightPrefetches.add(url.pathname);\n      const sectionId = getGridSectionId();\n      const firstUrl = new URL(url.pathname, window.location.origin);\n      firstUrl.searchParams.set('page', '1');\n      if (sectionId) firstUrl.searchParams.set('section_id', sectionId);\n\n      fetch(firstUrl.toString(), { credentials: 'same-origin' })\n        .then(r => r.text())\n        .then(async html => {\n          const doc = new DOMParser().parseFromString(html, 'text/html');\n          const p1Cards = Array.from(doc.querySelectorAll('#product-grid > li.grid__item, .product-grid > li.grid__item'));\n          if (!p1Cards.length) return;\n          const totalPages = getTotalPages(doc, 1, p1Cards.length);\n          const cacheKey = `lining_showcase_v6_${url.pathname}_${totalPages}`;\n          if (readCachedPages(cacheKey)) return;\n\n          const htmlToCache = { 1: `<ul>${p1Cards.map(el => el.outerHTML).join('')}</ul>` };\n          const fetches = [];\n          for (let p = 2; p <= totalPages; p++) {\n            fetches.push(\n              fetchCollectionPage(url.pathname, p, sectionId).then(cards => {\n                htmlToCache[p] = `<ul>${cards.map(el => el.outerHTML).join('')}</ul>`;\n              })\n            );\n          }\n          await Promise.all(fetches);\n          writeCachedPages(cacheKey, htmlToCache);\n        })\n        .catch(() => {});\n    } catch (e) {}\n  }\n\n  // 1. Run synchronously before first paint\n  arrangeShowcaseGrid();\n\n  // 2. When user explicitly switches Sort By back to \"Recommended\", load clean showcase URL\n  document.addEventListener(\n    'change',\n    function (e) {\n      if (e.target && e.target.matches('select[name=\"sort_by\"]') && e.target.value === SHOWCASE_VALUE) {\n        e.stopImmediatePropagation();\n        const url = new URL(window.location.href);\n        url.searchParams.delete('sort_by');\n        window.location.href = url.toString();\n      }\n    },\n    true\n  );\n\n  // 3. Pre-warm cache on hover AND silently pre-warm top menu collections when idle\n  document.addEventListener(\n    'pointerenter',\n    function (e) {\n      const link = e.target && e.target.closest ? e.target.closest('a[href*=\"/collections/\"]') : null;\n      if (link) prefetchCollection(link.href);\n    },\n    true\n  );\n\n  const scheduleIdle = window.requestIdleCallback || function (cb) { setTimeout(cb, 400); };\n  scheduleIdle(() => {\n    document.querySelectorAll('header a[href*=\"/collections/\"], nav a[href*=\"/collections/\"]').forEach(a => {\n      prefetchCollection(a.href);\n    });\n  });\n\n  // 4. Re-apply in 0ms on browser Back/Forward, history.pushState, or Dawn AJAX container swaps\n  window.addEventListener('popstate', arrangeShowcaseGrid);\n  window.addEventListener('pageshow', arrangeShowcaseGrid);\n\n  const origPushState = history.pushState;\n  history.pushState = function () {\n    const ret = origPushState.apply(this, arguments);\n    arrangeShowcaseGrid();\n    return ret;\n  };\n\n  const observer = new MutationObserver(() => {\n    if (isApplying) return;\n    const grid = document.querySelector('#product-grid, .product-grid');\n    if (grid && grid.dataset.showcaseSorted !== 'true') {\n      arrangeShowcaseGrid();\n    }\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n})();\n</script>",
