    "custom_liquid_N4WdYD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* HNDRD | Signature Sold Out */\n\n#product-grid .badge.hndrd-soldout {\n  position: relative !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  isolation: isolate;\n  width: max-content !important;\n  min-width: 0 !important;\n  padding: 9px 16px !important;\n  background: #181818 !important;\n  color: #fff !important;\n  border: 0 !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n  font-family: inherit !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  line-height: 1.2 !important;\n  letter-spacing: .105em !important;\n  text-transform: uppercase !important;\n  white-space: nowrap !important;\n  animation: hnBadgeIn .55s ease both;\n  transition: background .3s ease !important;\n}\n\n#product-grid .badge.hndrd-soldout::before {\n  content: \"\" !important;\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(\n    105deg,\n    transparent 30%,\n    rgba(255,255,255,.15) 50%,\n    transparent 70%\n  );\n  transform: translateX(-150%);\n  transition: transform .75s ease;\n  pointer-events: none;\n}\n\n#product-grid .badge.hndrd-soldout::after {\n  content: none !important;\n}\n\n@keyframes hnBadgeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (hover:hover) {\n  #product-grid .card-wrapper:hover\n  .badge.hndrd-soldout {\n    background: #101010 !important;\n  }\n\n  #product-grid .card-wrapper:hover\n  .badge.hndrd-soldout::before {\n    transform: translateX(150%);\n  }\n}\n\n@media (max-width:749px) {\n  #product-grid .badge.hndrd-soldout {\n    padding: 7px 12px !important;\n    font-size: 9px !important;\n    letter-spacing: .08em !important;\n  }\n}\n\n@media (prefers-reduced-motion:reduce) {\n  #product-grid .badge.hndrd-soldout {\n    animation: none !important;\n    transition: none !important;\n  }\n  #product-grid .badge.hndrd-soldout::before {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.HNDRDPriorityCombinedV2) return;\n  window.HNDRDPriorityCombinedV2 = true;\n\n  const CACHE = 'hndrd_priority_combined_v2:';\n  const memory = new Map();\n\n  const SOLD = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n  const EXACT_SOLD =\n    /^(sold\\s*out|out\\s*of\\s*stock)$/i;\n  const NEW =\n    /\\b(new\\s*arrivals?|new\\s*launch|just\\s*launched)\\b/i;\n\n  // Optional fallback if product tags are not\n  // rendered in your card's HTML.\n  const NEW_ARRIVAL_HANDLES = [];\n\n  let rendering = false;\n  let running = false;\n  let managedGrid = null;\n  let managedKey = '';\n  let runId = 0;\n\n  function getHandle(card) {\n    const link = card.querySelector(\n      'a[href*=\"/products/\"]'\n    );\n    if (!link) return '';\n\n    try {\n      return (\n        new URL(link.href, location.origin)\n          .pathname.match(/\\/products\\/([^/]+)/) || []\n      )[1] || '';\n    } catch (_) {\n      return '';\n    }\n  }\n\n  function isSold(card) {\n    if (\n      card.dataset.available === 'false' ||\n      card.matches(\n        '.sold-out,.out-of-stock,.card--sold-out'\n      ) ||\n      card.querySelector(\n        '.sold-out,.out-of-stock,' +\n        '.card--sold-out,[data-sold-out=\"true\"]'\n      )\n    ) return true;\n\n    const badges = card.querySelectorAll(\n      '.card__badge .badge'\n    );\n\n    for (const badge of badges) {\n      if (SOLD.test(badge.textContent)) return true;\n    }\n\n    const buttons = card.querySelectorAll(\n      'button[disabled],.quick-add__submit'\n    );\n\n    for (const button of buttons) {\n      if (SOLD.test(button.textContent)) return true;\n    }\n\n    return SOLD.test(card.textContent || '');\n  }\n\n  function isNew(card) {\n    if (\n      card.dataset.newArrival === 'true' ||\n      card.dataset.collectionPriority === 'new'\n    ) return true;\n\n    if (\n      NEW_ARRIVAL_HANDLES.includes(getHandle(card))\n    ) return true;\n\n    const elements = card.querySelectorAll(\n      '.badge,.product-label,' +\n      '[data-product-tags],[data-tags]'\n    );\n\n    for (const el of elements) {\n      const text = [\n        el.textContent || '',\n        el.dataset.productTags || '',\n        el.dataset.tags || ''\n      ].join(' ');\n\n      if (NEW.test(text)) return true;\n    }\n\n    return false;\n  }\n\n  /* Apply premium badge styling */\n\n  function decorate(card) {\n    card.querySelectorAll(\n      '.card__badge .badge'\n    ).forEach(function (badge) {\n      const sold = EXACT_SOLD.test(\n        badge.textContent.trim()\n      );\n\n      badge.classList.toggle(\n        'hndrd-soldout', sold\n      );\n    });\n  }\n\n  function decorateGrid(grid) {\n    grid.querySelectorAll('.grid__item')\n      .forEach(decorate);\n  }\n\n  /* Priority:\n     0 New arrivals in stock\n     1 Other products in stock (best selling)\n     2 Sold out\n  */\n\n  function priority(card) {\n    if (isSold(card)) return 2;\n    if (isNew(card)) return 0;\n    return 1;\n  }\n\n  function sortCards(cards) {\n    const groups = [[], [], []];\n\n    cards.forEach(function (card) {\n      card.style.display = '';\n      decorate(card);\n      groups[priority(card)].push(card);\n    });\n\n    return groups.flat();\n  }\n\n  function sortVisible(grid) {\n    const cards = Array.from(\n      grid.querySelectorAll('.grid__item')\n    );\n\n    if (cards.length < 2) {\n      decorateGrid(grid);\n      return;\n    }\n\n    const sorted = sortCards(cards);\n\n    if (sorted.every(\n      (card, i) => card === cards[i]\n    )) return;\n\n    rendering = true;\n\n    try {\n      const fragment =\n        document.createDocumentFragment();\n\n      sorted.forEach(card => {\n        fragment.appendChild(card);\n      });\n\n      grid.appendChild(fragment);\n    } finally {\n      rendering = false;\n    }\n  }\n\n  function currentPage() {\n    const p = parseInt(\n      new URLSearchParams(location.search)\n        .get('page') || '1', 10\n    );\n    return p > 0 ? p : 1;\n  }\n\n  function pageURL(page) {\n    const url = new URL(location.href);\n\n    if (page <= 1) {\n      url.searchParams.delete('page');\n    } else {\n      url.searchParams.set('page', page);\n    }\n\n    return url.toString();\n  }\n\n  function key() {\n    const url = new URL(location.href);\n    url.searchParams.delete('page');\n    url.searchParams.sort();\n    return url.pathname + url.search;\n  }\n\n  function getCache(k) {\n    try {\n      const raw = sessionStorage.getItem(CACHE + k);\n      return raw ? JSON.parse(raw) : null;\n    } catch (_) {\n      return null;\n    }\n  }\n\n  function saveCache(k, state) {\n    try {\n      sessionStorage.setItem(\n        CACHE + k,\n        JSON.stringify(state)\n      );\n    } catch (_) {}\n  }\n\n  function range(current, total) {\n    if (total <= 7)\n      return Array.from(\n        {length:total}, (_,i) => i+1\n      );\n\n    if (current <= 4)\n      return [1,2,3,4,5,'...',total];\n\n    if (current >= total-3)\n      return [\n        1,'...',total-4,total-3,\n        total-2,total-1,total\n      ];\n\n    return [\n      1,'...',current-1,current,\n      current+1,'...',total\n    ];\n  }\n\n  function pagination(current, total) {\n    const wrappers = document.querySelectorAll(\n      '.pagination-wrapper,nav.pagination'\n    );\n\n    if (total <= 1) {\n      wrappers.forEach(el => {\n        el.style.display = 'none';\n      });\n      return;\n    }\n\n    const link = (page, label, aria) =>\n      '<li><a href=\"' + pageURL(page) +\n      '\" data-hn-page=\"' + page +\n      '\" class=\"pagination__item link\" ' +\n      'aria-label=\"' + aria + '\">' +\n      label + '</a></li>';\n\n    let html = '';\n\n    if (current > 1)\n      html += link(\n        current-1,'&lsaquo;','Previous page'\n      );\n\n    range(current,total).forEach(p => {\n      if (p === '...') {\n        html += '<li><span class=\"pagination__item\">' +\n          '&hellip;</span></li>';\n      } else if (p === current) {\n        html += '<li><span class=\"pagination__item ' +\n          'pagination__item--current light\" ' +\n          'aria-current=\"page\">' + p +\n          '</span></li>';\n      } else {\n        html += link(p,p,'Page '+p);\n      }\n    });\n\n    if (current < total)\n      html += link(\n        current+1,'&rsaquo;','Next page'\n      );\n\n    document.querySelectorAll(\n      '.pagination__list'\n    ).forEach(list => {\n      list.innerHTML = html;\n    });\n\n    wrappers.forEach(el => {\n      el.style.display = '';\n    });\n  }\n\n  function display(grid, state, requested, clamp) {\n    const perPage = Math.max(\n      1,state.perPage\n    );\n    const total = Math.max(\n      1,Math.ceil(state.cards.length/perPage)\n    );\n    const page = Math.min(\n      Math.max(1,requested),total\n    );\n\n    if (clamp && requested !== page) {\n      history.replaceState(\n        {hnPage:page},'',pageURL(page)\n      );\n    }\n\n    const start = (page-1)*perPage;\n    const html = state.cards.slice(\n      start,start+perPage\n    ).join('');\n\n    rendering = true;\n\n    try {\n      if (grid.innerHTML !== html) {\n        grid.innerHTML = html;\n      }\n\n      decorateGrid(grid);\n      pagination(page,total);\n\n      grid.dataset.hnManaged = '1';\n      managedGrid = grid;\n      managedKey = key();\n    } finally {\n      rendering = false;\n    }\n  }\n\n  async function fetchCards(page, sectionId) {\n    const url = new URL(pageURL(page));\n\n    if (sectionId)\n      url.searchParams.set(\n        'section_id',sectionId\n      );\n\n    let res = await fetch(url.toString(),{\n      credentials:'same-origin'\n    });\n\n    if (!res.ok && sectionId) {\n      res = await fetch(pageURL(page),{\n        credentials:'same-origin'\n      });\n    }\n\n    if (!res.ok)\n      throw new Error('Collection page fetch failed');\n\n    const doc = new DOMParser().parseFromString(\n      await res.text(),'text/html'\n    );\n\n    return Array.from(\n      doc.querySelectorAll(\n        '#product-grid .grid__item'\n      )\n    );\n  }\n\n  async function reorder() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n\n    if (!grid || running) return;\n\n    running = true;\n    const run = ++runId;\n    const k = key();\n    const page = currentPage();\n\n    try {\n      const cached = memory.get(k) || getCache(k);\n\n      if (cached && cached.cards) {\n        memory.set(k,cached);\n        display(grid,cached,page,false);\n        return;\n      }\n\n      let last = page;\n\n      document.querySelectorAll(\n        '.pagination a[href*=\"page=\"]'\n      ).forEach(link => {\n        try {\n          const p = parseInt(\n            new URL(link.href,location.origin)\n              .searchParams.get('page'),10\n          );\n          if (p > last) last = p;\n        } catch (_) {}\n      });\n\n      const original = Array.from(\n        grid.querySelectorAll('.grid__item')\n      );\n\n      sortVisible(grid);\n\n      const section = grid.closest(\n        '[id^=\"shopify-section-\"]'\n      );\n      const sectionId = section\n        ? section.id.replace('shopify-section-','')\n        : null;\n\n      const pages = new Map();\n      pages.set(page,original);\n\n      const requests = [];\n\n      for (let p=1;p<=last;p++) {\n        if (!pages.has(p)) {\n          requests.push(\n            fetchCards(p,sectionId).then(cards => {\n              pages.set(p,cards);\n            })\n          );\n        }\n      }\n\n      await Promise.all(requests);\n\n      if (run !== runId || k !== key()) return;\n\n      const all = [];\n\n      for (let p=1;p<=last;p++) {\n        (pages.get(p)||[]).forEach(card => {\n          all.push(card);\n        });\n      }\n\n      const ordered = sortCards(all);\n\n      const state = {\n        perPage:Math.max(\n          1,(pages.get(1)||original).length\n        ),\n        cards:ordered.map(card => card.outerHTML)\n      };\n\n      memory.set(k,state);\n      saveCache(k,state);\n\n      const active = document.getElementById(\n        'product-grid'\n      );\n\n      if (active) {\n        display(\n          active,state,currentPage(),true\n        );\n      }\n\n    } catch (error) {\n      console.error(\n        'HNDRD collection priority:',error\n      );\n    } finally {\n      running = false;\n    }\n  }\n\n  document.addEventListener('click',function(e) {\n    const link = e.target.closest(\n      'a[data-hn-page]'\n    );\n\n    if (!link) return;\n\n    const grid = document.getElementById(\n      'product-grid'\n    );\n    const state = memory.get(key());\n\n    if (!grid || !state) return;\n\n    e.preventDefault();\n\n    const page = parseInt(\n      link.dataset.hnPage,10\n    );\n\n    history.pushState(\n      {hnPage:page},'',pageURL(page)\n    );\n\n    display(grid,state,page,true);\n\n    const container = document.getElementById(\n      'ProductGridContainer'\n    ) || grid;\n\n    container.scrollIntoView({\n      behavior:'smooth',block:'start'\n    });\n  });\n\n  window.addEventListener('popstate',function() {\n    const grid = document.getElementById(\n      'product-grid'\n    );\n    const state = memory.get(key()) || getCache(key());\n\n    if (grid && state) {\n      memory.set(key(),state);\n      display(\n        grid,state,currentPage(),false\n      );\n    } else {\n      reorder();\n    }\n  });\n\n  const observer = new MutationObserver(function() {\n    if (rendering || running) return;\n\n    const grid = document.getElementById(\n      'product-grid'\n    );\n    if (!grid) return;\n\n    if (\n      grid !== managedGrid ||\n      key() !== managedKey ||\n      grid.dataset.hnManaged !== '1'\n    ) {\n      reorder();\n    }\n  });\n\n  observer.observe(document.body,{\n    childList:true,\n    subtree:true\n  });\n\n  if (document.readyState === 'loading') {\n    document.addEventListener(\n      'DOMContentLoaded',reorder\n    );\n  } else {\n    reorder();\n  }\n})();\n</script>",
