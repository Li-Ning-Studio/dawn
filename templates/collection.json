    "custom_liquid_UMw3zR": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<script>\n  (function () {\n    const SOLD_OUT_REGEX = /\\b(sold\\s*out|out\\s*of\\s*stock)\\b/i;\n    const CACHE_PREFIX = 'ln_push_soldout_v1:';\n    const collectionStore = new Map();\n    let isRendering = false;\n\n    function isCardSoldOut(card) {\n      if (\n        card.dataset.available === 'false' ||\n        card.matches('.sold-out, .out-of-stock, .card--sold-out') ||\n        card.querySelector('.sold-out, .out-of-stock, .card--sold-out, [data-sold-out=\"true\"]')\n      ) {\n        return true;\n      }\n\n      const badges = card.querySelectorAll('.badge, .card__badge, [class*=\"badge\"]');\n      for (const badge of badges) {\n        if (SOLD_OUT_REGEX.test(badge.textContent)) return true;\n      }\n\n      const buttons = card.querySelectorAll('button[disabled], .quick-add__submit');\n      for (const btn of buttons) {\n        if (SOLD_OUT_REGEX.test(btn.textContent)) return true;\n      }\n\n      return SOLD_OUT_REGEX.test(card.textContent);\n    }\n\n    // 0ms local sort on the currently visible grid before background pages finish loading\n    function sortGridInPlace(grid) {\n      if (!grid) return;\n      const cards = Array.from(grid.querySelectorAll('.grid__item'));\n      if (cards.length < 2) return;\n\n      const inStock = [];\n      const soldOut = [];\n      for (let i = 0; i < cards.length; i++) {\n        cards[i].style.display = '';\n        if (isCardSoldOut(cards[i])) {\n          soldOut.push(cards[i]);\n        } else {\n          inStock.push(cards[i]);\n        }\n      }\n\n      if (soldOut.length === 0 || inStock.length === 0) return;\n\n      const sorted = inStock.concat(soldOut);\n      const alreadySorted = sorted.every((node, idx) => node === cards[idx]);\n      if (alreadySorted) return;\n\n      isRendering = true;\n      try {\n        const frag = document.createDocumentFragment();\n        sorted.forEach((node) => frag.appendChild(node));\n        grid.appendChild(frag);\n      } finally {\n        isRendering = false;\n      }\n    }\n\n    function getCurrentPage() {\n      const p = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);\n      return isNaN(p) || p < 1 ? 1 : p;\n    }\n\n    function buildPageUrl(pageNum) {\n      const url = new URL(window.location.href);\n      if (pageNum <= 1) {\n        url.searchParams.delete('page');\n      } else {\n        url.searchParams.set('page', String(pageNum));\n      }\n      return url.toString();\n    }\n\n    function getCollectionKey() {\n      const url = new URL(window.location.href);\n      url.searchParams.delete('page');\n      url.searchParams.sort();\n      return url.pathname + url.search;\n    }\n\n    function readCache(collectionKey) {\n      try {\n        const raw = sessionStorage.getItem(CACHE_PREFIX + collectionKey);\n        return raw ? JSON.parse(raw) : null;\n      } catch (_) {\n        return null;\n      }\n    }\n\n    function writeCache(collectionKey, data) {\n      try {\n        sessionStorage.setItem(CACHE_PREFIX + collectionKey, JSON.stringify(data));\n      } catch (_) {\n        try {\n          Object.keys(sessionStorage)\n            .filter((k) => k.startsWith(CACHE_PREFIX))\n            .forEach((k) => sessionStorage.removeItem(k));\n          sessionStorage.setItem(CACHE_PREFIX + collectionKey, JSON.stringify(data));\n        } catch (_) {}\n      }\n    }\n\n    function getPaginationRange(current, total) {\n      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);\n      if (current <= 4) return [1, 2, 3, 4, 5, '...', total];\n      if (current >= total - 3) return [1, '...', total - 4, total - 3, total - 2, total - 1, total];\n      return [1, '...', current - 1, current, current + 1, '...', total];\n    }\n\n    function renderPagination(currentPage, totalPages) {\n      const wrappers = document.querySelectorAll('.pagination-wrapper, nav.pagination');\n      if (!wrappers.length) return;\n\n      if (totalPages <= 1) {\n        wrappers.forEach((el) => (el.style.display = 'none'));\n        return;\n      }\n\n      const pages = getPaginationRange(currentPage, totalPages);\n      const prevHtml =\n        currentPage > 1\n          ? `<li><a href=\"${buildPageUrl(currentPage - 1)}\" data-ln-page=\"${currentPage - 1}\" class=\"pagination__item pagination__item--next pagination__item-arrow link motion-reduce\" aria-label=\"Previous page\">&lsaquo;</a></li>`\n          : '';\n      const nextHtml =\n        currentPage < totalPages\n          ? `<li><a href=\"${buildPageUrl(currentPage + 1)}\" data-ln-page=\"${currentPage + 1}\" class=\"pagination__item pagination__item--prev pagination__item-arrow link motion-reduce\" aria-label=\"Next page\">&rsaquo;</a></li>`\n          : '';\n\n      const itemsHtml = pages\n        .map((p) => {\n          if (p === '...') return `<li><span class=\"pagination__item\">&hellip;</span></li>`;\n          if (p === currentPage) {\n            return `<li><a role=\"link\" aria-disabled=\"true\" class=\"pagination__item pagination__item--current light\" aria-current=\"page\">${p}</a></li>`;\n          }\n          return `<li><a href=\"${buildPageUrl(p)}\" data-ln-page=\"${p}\" class=\"pagination__item link\">${p}</a></li>`;\n        })\n        .join('');\n\n      document.querySelectorAll('.pagination__list').forEach((list) => {\n        list.innerHTML = prevHtml + itemsHtml + nextHtml;\n      });\n      wrappers.forEach((el) => (el.style.display = ''));\n    }\n\n    function applyState(grid, state, requestedPage, updateUrlIfClamped) {\n      const { itemsPerPage, cardsHtml } = state;\n      const totalItems = cardsHtml.length;\n      const totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));\n      const targetPage = Math.min(Math.max(1, requestedPage), totalPages);\n\n      if (updateUrlIfClamped && targetPage !== requestedPage) {\n        window.history.replaceState({ lnPage: targetPage }, '', buildPageUrl(targetPage));\n      }\n\n      const startIdx = (targetPage - 1) * itemsPerPage;\n      const nextGridHtml = cardsHtml.slice(startIdx, startIdx + itemsPerPage).join('');\n\n      isRendering = true;\n      try {\n        if (grid.innerHTML !== nextGridHtml) {\n          grid.innerHTML = nextGridHtml;\n        }\n        grid.querySelectorAll('.grid__item').forEach((c) => (c.style.display = ''));\n        grid.dataset.lnManaged = '1';\n        renderPagination(targetPage, totalPages);\n      } finally {\n        isRendering = false;\n      }\n    }\n\n    async function fetchPageCards(pageNum, sectionId) {\n      const url = new URL(buildPageUrl(pageNum));\n      if (sectionId) url.searchParams.set('section_id', sectionId);\n\n      let res = await fetch(url.toString(), { credentials: 'same-origin' });\n      if (!res.ok && sectionId) {\n        res = await fetch(buildPageUrl(pageNum), { credentials: 'same-origin' });\n      }\n      const html = await res.text();\n      const doc = new DOMParser().parseFromString(html, 'text/html');\n      return Array.from(doc.querySelectorAll('#product-grid .grid__item')).map((card) => {\n        card.style.display = '';\n        return card;\n      });\n    }\n\n    async function reorderCollection() {\n      const grid = document.getElementById('product-grid');\n      if (!grid || grid.dataset.lnWorking === '1') return;\n\n      grid.dataset.lnWorking = '1';\n\n      const collectionKey = getCollectionKey();\n      const currentPage = getCurrentPage();\n\n      // 1. Instant 0ms render from cache if available; otherwise sort visible cards immediately\n      const cached = collectionStore.get(collectionKey) || readCache(collectionKey);\n      if (cached) {\n        collectionStore.set(collectionKey, cached);\n        applyState(grid, cached, currentPage, false);\n      } else {\n        sortGridInPlace(grid);\n      }\n\n      try {\n        let maxPage = currentPage;\n        document.querySelectorAll('.pagination a[href*=\"page=\"]').forEach((link) => {\n          try {\n            const p = parseInt(new URL(link.href, window.location.origin).searchParams.get('page'), 10);\n            if (!isNaN(p) && p > maxPage) maxPage = p;\n          } catch (_) {}\n        });\n\n        const currentCards = Array.from(grid.querySelectorAll('.grid__item'));\n\n        // Single-page collection: already sorted in 0ms, zero network calls needed\n        if (maxPage <= 1 && !cached) {\n          const inStockHtml = [];\n          const soldOutHtml = [];\n          currentCards.forEach((c) => {\n            c.style.display = '';\n            if (isCardSoldOut(c)) {\n              soldOutHtml.push(c.outerHTML);\n            } else {\n              inStockHtml.push(c.outerHTML);\n            }\n          });\n          const state = {\n            itemsPerPage: Math.max(1, currentCards.length),\n            cardsHtml: inStockHtml.concat(soldOutHtml),\n          };\n          collectionStore.set(collectionKey, state);\n          writeCache(collectionKey, state);\n          applyState(grid, state, 1, true);\n          return;\n        }\n\n        // Multi-page collection: fetch all pages in parallel using lightweight section_id\n        const sectionWrapper = grid.closest('[id^=\"shopify-section-\"]');\n        const sectionId = sectionWrapper ? sectionWrapper.id.replace('shopify-section-', '') : null;\n\n        const pagesMap = new Map();\n        if (!cached) {\n          pagesMap.set(currentPage, currentCards);\n        }\n\n        const pagePromises = [];\n        for (let p = 1; p <= maxPage; p++) {\n          if (!pagesMap.has(p)) {\n            pagePromises.push(\n              fetchPageCards(p, sectionId).then((cards) => {\n                pagesMap.set(p, cards);\n              })\n            );\n          }\n        }\n        await Promise.all(pagePromises);\n\n        const page1Cards = pagesMap.get(1) || currentCards;\n        const itemsPerPage = Math.max(1, page1Cards.length);\n        const allInStockHtml = [];\n        const allSoldOutHtml = [];\n\n        for (let p = 1; p <= maxPage; p++) {\n          const cards = pagesMap.get(p) || [];\n          for (let i = 0; i < cards.length; i++) {\n            cards[i].style.display = '';\n            if (isCardSoldOut(cards[i])) {\n              allSoldOutHtml.push(cards[i].outerHTML);\n            } else {\n              allInStockHtml.push(cards[i].outerHTML);\n            }\n          }\n        }\n\n        // In-stock items pack the front pages; sold-out items move to the last pages\n        const freshState = {\n          itemsPerPage,\n          cardsHtml: allInStockHtml.concat(allSoldOutHtml),\n        };\n        collectionStore.set(collectionKey, freshState);\n        writeCache(collectionKey, freshState);\n\n        const activeGrid = document.getElementById('product-grid');\n        if (activeGrid) {\n          applyState(activeGrid, freshState, getCurrentPage(), true);\n        }\n      } catch (err) {\n        console.error('Collection reorder error:', err);\n      } finally {\n        const activeGrid = document.getElementById('product-grid');\n        if (activeGrid) activeGrid.dataset.lnWorking = '0';\n      }\n    }\n\n    // 0ms client-side page switching when clicking page numbers, Next, or Prev\n    document.addEventListener('click', (e) => {\n      const link = e.target.closest('.pagination__list a[data-ln-page]');\n      if (!link) return;\n\n      const collectionKey = getCollectionKey();\n      const state = collectionStore.get(collectionKey);\n      const grid = document.getElementById('product-grid');\n      if (!state || !grid) return;\n\n      e.preventDefault();\n      const targetPage = parseInt(link.dataset.lnPage, 10);\n      window.history.pushState({ lnPage: targetPage }, '', buildPageUrl(targetPage));\n      applyState(grid, state, targetPage, true);\n\n      const container = document.getElementById('ProductGridContainer') || grid;\n      container.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    });\n\n    // Support browser Back / Forward buttons in 0ms\n    window.addEventListener('popstate', () => {\n      const collectionKey = getCollectionKey();\n      const state = collectionStore.get(collectionKey);\n      const grid = document.getElementById('product-grid');\n      if (state && grid) {\n        applyState(grid, state, getCurrentPage(), false);\n      }\n    });\n\n    // Run immediately\n    reorderCollection();\n\n    // Re-run automatically when Dawn AJAX filters or Sort By update the grid\n    const observer = new MutationObserver(() => {\n      if (isRendering) return;\n      const grid = document.getElementById('product-grid');\n      if (grid && grid.dataset.lnManaged !== '1' && grid.dataset.lnWorking !== '1') {\n        reorderCollection();\n      }\n    });\n    observer.observe(document.body, { childList: true, subtree: true });\n  })();\n</script>",
