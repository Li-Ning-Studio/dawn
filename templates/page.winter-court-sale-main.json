% for i in (1..16) %}\n\n        {% assign x = i | times: 37 | modulo: 100 %}\n        {% assign s = i | modulo: 3 | plus: 1 %}\n        {% assign duration = i | modulo: 9 | plus: 12 %}\n        {% assign delay = i | times: 13 | modulo: 19 %}\n\n        <i style=\"\n          --x:{{ x }}%;\n          --s:{{ s }}px;\n          --duration:{{ duration }}s;\n          --delay:-{{ delay }}s;\n        \"></i>\n\n      {% endfor %}\n\n    </div>\n\n  </div>\n\n  <!-- CATEGORY GRID -->\n\n  <div class=\"lncc-inner\">\n\n    <div class=\"lncc-grid\">\n\n      {% for i in (1..5) %}\n\n        {% case i %}\n\n          {% when 1 %}\n            {% assign card_image = racket_image %}\n            {% assign card_link = racket_link %}\n            {% assign card_name = 'Rackets' %}\n\n          {% when 2 %}\n            {% assign card_image = shoe_image %}\n            {% assign card_link = shoe_link %}\n            {% assign card_name = 'Shoes' %}\n\n          {% when 3 %}\n            {% assign card_image = bag_image %}\n            {% assign card_link = bag_link %}\n            {% assign card_name = 'Kitbags and Backpacks' %}\n\n          {% when 4 %}\n            {% assign card_image = apparel_image %}\n            {% assign card_link = apparel_link %}\n            {% assign card_name = 'Apparels' %}\n\n          {% when 5 %}\n            {% assign card_image = arrival_image %}\n            {% assign card_link = arrival_link %}\n            {% assign card_name = 'New Arrivals' %}\n\n        {% endcase %}\n\n        <a\n          class=\"lncc-card lncc-card-{{ i }}\"\n          href=\"{{ card_link | escape }}\"\n          aria-label=\"Explore {{ card_name | escape }}\"\n          style=\"--index:{{ forloop.index0 }}\"\n        >\n\n          <div class=\"lncc-frame\">\n\n            <div class=\"lncc-artwork\">\n\n              <img\n                src=\"{{ card_image | escape }}&width=640\"\n\n                srcset=\"\n                  {{ card_image | escape }}&width=240 240w,\n                  {{ card_image | escape }}&width=360 360w,\n                  {{ card_image | escape }}&width=480 480w,\n                  {{ card_image | escape }}&width=640 640w,\n                  {{ card_image | escape }}&width=800 800w,\n                  {{ card_image | escape }}&width=1000 1000w\n                \"\n\n                sizes=\"\n                  (max-width: 749px) 33vw,\n                  (max-width: 1920px) 20vw,\n                  380px\n                \"\n\n                alt=\"{{ card_name | escape }} Christmas sale offers\"\n\n                loading=\"eager\"\n                decoding=\"async\"\n              >\n\n            </div>\n\n            <div\n              class=\"lncc-ice-border\"\n              aria-hidden=\"true\"\n            ></div>\n\n            <div\n              class=\"lncc-shine\"\n              aria-hidden=\"true\"\n            ></div>\n\n          </div>\n\n        </a>\n\n      {% endfor %}\n\n    </div>\n\n  </div>\n\n</section>\n\n<style>\n\n/* ==========================================\n   SECTION FOUNDATION\n========================================== */\n\n#ln-christmas-categories-{{ section.id }}{\n\n  --lncc-gap:16px;\n  --lncc-radius:18px;\n  --lncc-snow-travel:500px;\n\n  position:relative;\n  isolation:isolate;\n\n  width:100%;\n  max-width:none;\n\n  margin:0!important;\n  padding:36px 28px 36px!important;\n\n  overflow:hidden;\n\n  background:linear-gradient(\n    90deg,\n    #082638 0%,\n    #164765 48%,\n    #24395e 100%\n  );\n\n  font-family:inherit;\n}\n\n.lncc *,\n.lncc *::before,\n.lncc *::after{\n  box-sizing:border-box;\n}\n\n#shopify-section-{{ section.id }}{\n  margin-top:0!important;\n  margin-bottom:0!important;\n}\n\n/* ==========================================\n   CHRISTMAS BACKGROUND\n========================================== */\n\n.lncc .lncc-atmosphere{\n\n  position:absolute;\n  inset:0;\n\n  overflow:hidden;\n  pointer-events:none;\n\n  z-index:0;\n\n  contain:layout paint;\n}\n\n.lncc .lncc-aurora{\n\n  position:absolute;\n  inset:-8%;\n\n  background:\n    radial-gradient(\n      ellipse at 25% 45%,\n      rgba(100,195,255,.16),\n      transparent 48%\n    ),\n    radial-gradient(\n      ellipse at 80% 40%,\n      rgba(142,160,255,.13),\n      transparent 45%\n    );\n\n  animation:lnccAurora 22s\n    ease-in-out infinite alternate;\n}\n\n@keyframes lnccAurora{\n\n  from{\n    transform:translate3d(-3%,-2%,0);\n    opacity:.55;\n  }\n\n  to{\n    transform:translate3d(3%,2%,0);\n    opacity:1;\n  }\n\n}\n\n.lncc .lncc-mist{\n\n  position:absolute;\n\n  left:-10%;\n  bottom:-30%;\n\n  width:120%;\n  height:70%;\n\n  background:radial-gradient(\n    ellipse,\n    rgba(207,240,255,.12),\n    transparent 70%\n  );\n\n  animation:lnccMist 24s\n    ease-in-out infinite alternate;\n}\n\n@keyframes lnccMist{\n\n  from{\n    transform:translate3d(-4%,0,0);\n    opacity:.4;\n  }\n\n  to{\n    transform:translate3d(4%,0,0);\n    opacity:.85;\n  }\n\n}\n\n/* ==========================================\n   FLOATING ICE CRYSTALS\n========================================== */\n\n.lncc .lncc-crystal{\n\n  position:absolute;\n\n  width:65px;\n  height:65px;\n\n  color:#d8f4ff;\n  opacity:.2;\n\n  pointer-events:none;\n\n  animation:lnccCrystalFloat 12s\n    ease-in-out infinite alternate;\n}\n\n.lncc .lncc-crystal-1{\n  top:8px;\n  left:-15px;\n}\n\n.lncc .lncc-crystal-2{\n\n  top:12px;\n  right:-15px;\n\n  width:80px;\n  height:80px;\n\n  animation-delay:-4s;\n}\n\n.lncc .lncc-crystal-3{\n\n  bottom:5px;\n  left:28%;\n\n  width:32px;\n  height:32px;\n\n  animation-delay:-7s;\n}\n\n.lncc .lncc-crystal-4{\n\n  bottom:4px;\n  right:24%;\n\n  width:40px;\n  height:40px;\n\n  animation-delay:-2s;\n}\n\n@keyframes lnccCrystalFloat{\n\n  from{\n    transform:translate3d(0,-4px,0)\n      rotate(-10deg);\n\n    opacity:.12;\n  }\n\n  to{\n    transform:translate3d(0,12px,0)\n      rotate(10deg);\n\n    opacity:.3;\n  }\n\n}\n\n/* ==========================================\n   SEAMLESS SNOWFALL\n========================================== */\n\n.lncc .lncc-snow{\n\n  position:absolute;\n  inset:0;\n\n  overflow:hidden;\n  pointer-events:none;\n}\n\n.lncc .lncc-snow i{\n\n  position:absolute;\n\n  top:-10px;\n  left:var(--x);\n\n  width:var(--s);\n  height:var(--s);\n\n  border-radius:50%;\n\n  background:#edfaff;\n\n  opacity:0;\n\n  animation:lnccSnowfall\n    var(--duration)\n    linear\n    var(--delay)\n    infinite;\n}\n\n@keyframes lnccSnowfall{\n\n  0%{\n    transform:translate3d(0,0,0);\n    opacity:0;\n  }\n\n  12%{\n    opacity:.6;\n  }\n\n  85%{\n    opacity:.45;\n  }\n\n  100%{\n    transform:translate3d(\n      18px,\n      var(--lncc-snow-travel),\n      0\n    );\n\n    opacity:0;\n  }\n\n}\n\n/* ==========================================\n   DESKTOP GRID\n   FIVE LARGE FULL WIDTH CARDS\n========================================== */\n\n#ln-christmas-categories-{{ section.id }}\n.lncc-inner{\n\n  position:relative;\n  z-index:2;\n\n  width:100%;\n  max-width:1920px;\n\n  margin:0 auto;\n}\n\n#ln-christmas-categories-{{ section.id }}\n.lncc-grid{\n\n  display:grid;\n\n  grid-template-columns:\n    repeat(5,minmax(0,1fr));\n\n  align-items:start;\n\n  gap:var(--lncc-gap);\n\n  width:100%;\n\n  margin:0 auto;\n}\n\n.lncc .lncc-card{\n\n  position:relative;\n\n  display:block;\n\n  grid-column:auto;\n\n  width:100%;\n  min-width:0;\n\n  text-decoration:none!important;\n  color:inherit;\n\n  border-radius:var(--lncc-radius);\n\n  touch-action:manipulation;\n}\n\n/* ==========================================\n   PREMIUM FROSTED FRAME\n========================================== */\n\n.lncc .lncc-frame{\n\n  position:relative;\n\n  isolation:isolate;\n  overflow:hidden;\n\n  width:100%;\n  height:auto;\n\n  padding:1px;\n\n  border-radius:var(--lncc-radius);\n\n  border:1px solid rgba(224,247,255,.48);\n\n  background:rgba(215,240,255,.08);\n\n  box-shadow:\n    0 3px 0 rgba(216,239,255,.07),\n    0 6px 16px rgba(0,19,38,.18);\n\n  transition:transform .28s\n    cubic-bezier(.2,.75,.25,1);\n}\n\n/* ==========================================\n   ORIGINAL ARTWORK\n   NO DISTORTION OR CROPPING\n========================================== */\n\n.lncc .lncc-artwork{\n\n  position:relative;\n\n  width:100%;\n  height:auto;\n\n  overflow:hidden;\n\n  border-radius:calc(\n    var(--lncc-radius) - 2px\n  );\n\n  background:#244b70;\n}\n\n.lncc .lncc-artwork img{\n\n  display:block;\n\n  width:100%!important;\n  max-width:100%!important;\n  height:auto!important;\n\n  aspect-ratio:auto;\n\n  margin:0!important;\n  padding:0!important;\n\n  object-fit:contain;\n\n  border-radius:inherit;\n\n  opacity:1!important;\n\n  filter:none!important;\n  transform:none!important;\n  animation:none!important;\n}\n\n/* ==========================================\n   SUBTLE ANIMATED ICE BORDER\n========================================== */\n\n.lncc .lncc-ice-border{\n\n  position:absolute;\n  inset:0;\n\n  z-index:3;\n\n  border-radius:inherit;\n\n  pointer-events:none;\n\n  box-shadow:\n    inset 0 0 2px #ffffffaa,\n    inset 0 0 4px #dcf6ff44;\n\n  animation:lnccIceGlow 7s\n    ease-in-out infinite;\n\n  animation-delay:calc(var(--index) * -.7s);\n}\n\n@keyframes lnccIceGlow{\n\n  0%,100%{opacity:.35}\n\n  50%{opacity:.95}\n\n}\n\n/* ==========================================\n   DESKTOP HOVER REFLECTION\n========================================== */\n\n.lncc .lncc-shine{\n\n  position:absolute;\n\n  top:-60%;\n  left:-80%;\n\n  width:35%;\n  height:220%;\n\n  z-index:4;\n\n  pointer-events:none;\n\n  opacity:0;\n\n  background:linear-gradient(\n    90deg,\n    transparent,\n    #ffffff0d,\n    #ffffff25,\n    transparent\n  );\n\n  transform:rotate(25deg);\n}\n\n@media(hover:hover) and (pointer:fine){\n\n  .lncc .lncc-card:hover .lncc-frame{\n\n    transform:translate3d(0,-4px,0);\n\n  }\n\n  .lncc .lncc-card:hover .lncc-shine{\n\n    animation:lnccShine .75s\n      ease-in-out both;\n\n  }\n\n}\n\n@keyframes lnccShine{\n\n  0%{\n    opacity:0;\n    transform:translate3d(0,0,0)\n      rotate(25deg);\n  }\n\n  20%{opacity:1}\n\n  80%{opacity:1}\n\n  100%{\n    opacity:0;\n\n    transform:translate3d(650%,0,0)\n      rotate(25deg);\n  }\n\n}\n\n.lncc .lncc-card:active .lncc-frame{\n\n  transform:scale(.985);\n\n  transition-duration:.12s;\n}\n\n.lncc .lncc-card:focus-visible{\n\n  outline:2px solid #fff;\n  outline-offset:3px;\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media(min-width:750px) and (max-width:1100px){\n\n  #ln-christmas-categories-{{ section.id }}{\n\n    --lncc-gap:10px;\n    --lncc-radius:14px;\n\n    padding:28px 16px!important;\n  }\n\n}\n\n/* ==========================================\n   MOBILE\n   THREE TOP + TWO CENTERED BELOW\n========================================== */\n\n@media(max-width:749px){\n\n  #ln-christmas-categories-{{ section.id }}{\n\n    --lncc-gap:6px;\n    --lncc-radius:10px;\n\n    padding:24px 6px 24px!important;\n  }\n\n  #ln-christmas-categories-{{ section.id }}\n  .lncc-inner{\n\n    width:100%;\n    max-width:none;\n  }\n\n  #ln-christmas-categories-{{ section.id }}\n  .lncc-grid{\n\n    grid-template-columns:\n      repeat(6,minmax(0,1fr));\n\n    gap:8px var(--lncc-gap);\n\n    width:100%;\n    max-width:none;\n\n    margin:0 auto;\n  }\n\n  /* ALL FIVE CARDS HAVE EQUAL WIDTH */\n\n  .lncc .lncc-card{\n\n    grid-column:span 2;\n\n    width:100%;\n    min-width:0;\n  }\n\n  /* CENTER THE SECOND ROW */\n\n  .lncc .lncc-card-4{\n\n    grid-column:2 / span 2;\n    grid-row:2;\n  }\n\n  .lncc .lncc-card-5{\n\n    grid-column:4 / span 2;\n    grid-row:2;\n  }\n\n  /* MINIMAL BORDER FOR MAXIMUM\n     ARTWORK AND TEXT VISIBILITY */\n\n  .lncc .lncc-frame{\n\n    padding:0;\n\n    border-width:1px;\n\n    box-shadow:\n      0 3px 7px rgba(0,19,38,.12);\n  }\n\n  .lncc .lncc-artwork{\n\n    border-radius:calc(\n      var(--lncc-radius) - 1px\n    );\n\n  }\n\n  .lncc .lncc-artwork img{\n\n    width:100%!important;\n    height:auto!important;\n\n    image-rendering:auto;\n  }\n\n  .lncc .lncc-ice-border{\n\n    box-shadow:\n      inset 0 0 2px #ffffff88;\n\n    animation-duration:8s;\n  }\n\n  /* LIGHTWEIGHT MOBILE DECORATIONS */\n\n  .lncc .lncc-crystal-1,\n  .lncc .lncc-crystal-2{\n\n    width:42px;\n    height:42px;\n  }\n\n  .lncc .lncc-crystal-3,\n  .lncc .lncc-crystal-4{\n\n    width:24px;\n    height:24px;\n  }\n\n  .lncc .lncc-snow i:nth-child(n+9){\n\n    display:none;\n  }\n\n  .lncc .lncc-shine{\n\n    display:none;\n  }\n\n  .lncc .lncc-aurora{\n\n    animation-duration:28s;\n  }\n\n}\n\n/* ==========================================\n   SMALL MOBILE DEVICES\n========================================== */\n\n@media(max-width:350px){\n\n  #ln-christmas-categories-{{ section.id }}{\n\n    --lncc-gap:4px;\n    --lncc-radius:8px;\n\n    padding:20px 4px!important;\n  }\n\n}\n\n/* ==========================================\n   PAUSE OFFSCREEN ANIMATIONS\n========================================== */\n\n.lncc.lncc-paused *,\n.lncc.lncc-paused *::before,\n.lncc.lncc-paused *::after{\n\n  animation-play-state:paused!important;\n}\n\n/* ACCESSIBILITY */\n\n@media(prefers-reduced-motion:reduce){\n\n  .lncc *,\n  .lncc *::before,\n  .lncc *::after{\n\n    animation:none!important;\n    transition:none!important;\n  }\n\n  .lncc .lncc-ice-border{\n\n    opacity:.7;\n  }\n\n  .lncc .lncc-snow{\n\n    display:none;\n  }\n\n}\n\n</style>\n\n<script>\n(()=>{\n  'use strict';\n\n  const root=document.getElementById(\n    'ln-christmas-categories-{{ section.id }}'\n  );\n\n  if(!root||root.dataset.initialized)return;\n\n  root.dataset.initialized='true';\n\n  let visible=true;\n  let observer=null;\n  let resizeObserver=null;\n\n  /* PAUSE ANIMATIONS WHEN NOT VISIBLE */\n\n  function update(){\n\n    root.classList.toggle(\n      'lncc-paused',\n      document.hidden || !visible\n    );\n\n  }\n\n  if('IntersectionObserver' in window){\n\n    observer=new IntersectionObserver(\n      entries=>{\n\n        visible=entries[0].isIntersecting;\n\n        update();\n\n      },\n      {\n        rootMargin:'150px 0px',\n        threshold:0\n      }\n    );\n\n    observer.observe(root);\n\n  }\n\n  document.addEventListener(\n    'visibilitychange',\n    update\n  );\n\n  /* MATCH SNOWFALL TO ACTUAL SECTION HEIGHT */\n\n  function updateSnow(){\n\n    const height=root.clientHeight+30;\n\n    root.style.setProperty(\n      '--lncc-snow-travel',\n      height+'px'\n    );\n\n  }\n\n  if('ResizeObserver' in window){\n\n    resizeObserver=new ResizeObserver(\n      updateSnow\n    );\n\n    resizeObserver.observe(root);\n\n  }\n\n  updateSnow();\n\n  /* SMOOTH CATEGORY NAVIGATION */\n\n  function navigate(event){\n\n    const link=event.target.closest(\n      'a[href^=\"#\"]'\n    );\n\n    if(!link||!root.contains(link))return;\n\n    const target=document.getElementById(\n      link.getAttribute('href').slice(1)\n    );\n\n    if(!target)return;\n\n    event.preventDefault();\n\n    const header=document.querySelector(\n      '.section-header'\n    );\n\n    const offset=header\n      ?header.getBoundingClientRect().height+12\n      :12;\n\n    const top=\n      target.getBoundingClientRect().top+\n      window.scrollY-offset;\n\n    const reduced=window.matchMedia(\n      '(prefers-reduced-motion:reduce)'\n    ).matches;\n\n    window.scrollTo({\n      top:Math.max(0,top),\n      behavior:reduced?'auto':'smooth'\n    });\n\n  }\n\n  root.addEventListener(\n    'click',\n    navigate\n  );\n\n  /* SHOPIFY THEME EDITOR CLEANUP */\n\n  function cleanup(event){\n\n    if(!event.target.contains(root))return;\n\n    observer?.disconnect();\n    resizeObserver?.disconnect();\n\n    root.removeEventListener(\n      'click',\n      navigate\n    );\n\n    document.removeEventListener(\n      'visibilitychange',\n      update\n    );\n\n    document.removeEventListener(\n      'shopify:section:unload',\n      cleanup\n    );\n\n    delete root.dataset.initialized;\n\n  }\n\n  document.addEventListener(\n    'shopify:section:unload',\n    cleanup\n  );\n\n  update();\n\n})();\n</script>",
