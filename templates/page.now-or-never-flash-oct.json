      "settings": {
        "custom_liquid": "<!-- HNDRD NOW OR NEVER — FLASH SALE COUNTDOWN (animated) -->\n<section class=\"hn-flash-countdown\" id=\"hn-flash-countdown\">\n  <div class=\"hn-noise\"></div>\n  <div class=\"hn-beam\"></div>\n  <div class=\"hn-glow hn-glow-1\"></div>\n  <div class=\"hn-glow hn-glow-2\"></div>\n\n  <div class=\"hn-speed-lines hn-speed-lines-left\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"hn-speed-lines hn-speed-lines-right\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"hn-flash-inner\">\n\n    <!-- TOP LABEL -->\n    <div class=\"hn-status\" data-r style=\"--d:0\">\n      <span class=\"hn-status-dot\"></span>\n      <span class=\"hn-status-text\">FLASH SALE INCOMING</span>\n    </div>\n\n    <!-- HEADING -->\n    <h2 class=\"hn-flash-heading\">\n      <span class=\"hn-line\" style=\"--d:120\"><span class=\"hn-line-inner\">THE CLOCK IS</span></span>\n      <span class=\"hn-line hn-accent\" style=\"--d:240\"><span class=\"hn-line-inner\">RUNNING.</span></span>\n    </h2>\n\n    <p class=\"hn-flash-sub\" data-r style=\"--d:380\">\n      NOW OR NEVER goes live on 3rd October.\n    </p>\n\n    <!-- COUNTDOWN -->\n    <div class=\"hn-timer\" role=\"timer\" aria-live=\"off\" aria-label=\"Countdown to flash sale\">\n\n      <div class=\"hn-time-block\" data-r style=\"--d:480\">\n        <div class=\"hn-time-value\" id=\"hn-days\">\n          <span class=\"hn-digits\" aria-hidden=\"true\">00</span>\n          <i class=\"hn-spot\"></i>\n        </div>\n        <div class=\"hn-time-label\">DAYS</div>\n      </div>\n\n      <div class=\"hn-separator\" data-r style=\"--d:560\" aria-hidden=\"true\"><span>:</span></div>\n\n      <div class=\"hn-time-block\" data-r style=\"--d:600\">\n        <div class=\"hn-time-value\" id=\"hn-hours\">\n          <span class=\"hn-digits\" aria-hidden=\"true\">00</span>\n          <i class=\"hn-spot\"></i>\n        </div>\n        <div class=\"hn-time-label\">HOURS</div>\n      </div>\n\n      <div class=\"hn-separator\" data-r style=\"--d:680\" aria-hidden=\"true\"><span>:</span></div>\n\n      <div class=\"hn-time-block\" data-r style=\"--d:720\">\n        <div class=\"hn-time-value\" id=\"hn-minutes\">\n          <span class=\"hn-digits\" aria-hidden=\"true\">00</span>\n          <i class=\"hn-spot\"></i>\n        </div>\n        <div class=\"hn-time-label\">MINUTES</div>\n      </div>\n\n      <div class=\"hn-separator\" data-r style=\"--d:800\" aria-hidden=\"true\"><span>:</span></div>\n\n      <div class=\"hn-time-block\" data-r style=\"--d:840\">\n        <div class=\"hn-time-value hn-seconds\" id=\"hn-seconds\">\n          <span class=\"hn-digits\" aria-hidden=\"true\">00</span>\n          <i class=\"hn-spot\"></i>\n          <i class=\"hn-ring\"></i>\n        </div>\n        <div class=\"hn-time-label\">SECONDS</div>\n      </div>\n\n    </div>\n\n    <!-- BOTTOM -->\n    <div class=\"hn-sale-date\" data-r style=\"--d:1000\">\n      <span>03</span>\n      <i></i>\n      <span>OCT</span>\n      <i></i>\n      <span>2026</span>\n    </div>\n\n    <div class=\"hn-bottom-line\" data-r style=\"--d:1100\">\n      <span class=\"hn-bl hn-bl-l\"></span>\n      <p>48 HOURS ONLY</p>\n      <span class=\"hn-bl hn-bl-r\"></span>\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n/* =========================================\n   HNDRD FLASH SALE COUNTDOWN\n   ========================================= */\n\n@property --hn-angle {\n  syntax: \"<angle>\";\n  inherits: false;\n  initial-value: 0deg;\n}\n\n.hn-flash-countdown {\n  --purple: #9d16d6;\n  --purple-bright: #c525ff;\n  --pink: #d927ff;\n  --yellow: #ffe600;\n  --navy: #070b5d;\n  --deep-purple: #24002e;\n  --ease-out: cubic-bezier(.16, 1, .3, 1);\n\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  isolation: isolate;\n  background:\n    radial-gradient(\n      circle at 50% -20%,\n      rgba(224, 58, 255, 0.95) 0%,\n      rgba(177, 28, 226, 0.9) 30%,\n      rgba(117, 16, 158, 0.95) 65%,\n      #4c075f 100%\n    );\n\n  color: #fff;\n  font-family: Arial, Helvetica, sans-serif;\n}\n\n/* Pause every ambient loop while the section is off-screen */\n.hn-flash-countdown:not(.hn-visible) *,\n.hn-flash-countdown:not(.hn-visible) *::before,\n.hn-flash-countdown:not(.hn-visible) *::after {\n  animation-play-state: paused !important;\n}\n\n\n/* =========================================\n   BACKGROUND LAYERS\n   ========================================= */\n\n/* halftone texture */\n.hn-noise {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  opacity: .18;\n\n  background-image: radial-gradient(rgba(255,255,255,.7) 1px, transparent 1px);\n  background-size: 12px 12px;\n\n  mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);\n  -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);\n}\n\n/* slow rotating light beam behind the timer */\n.hn-beam {\n  position: absolute;\n  left: 50%;\n  top: 52%;\n  width: min(1500px, 170%);\n  aspect-ratio: 1;\n  z-index: -1;\n  pointer-events: none;\n  will-change: transform;\n\n  background: conic-gradient(\n    from 0deg,\n    transparent 0deg,\n    rgba(255,255,255,.10) 24deg,\n    transparent 52deg,\n    transparent 180deg,\n    rgba(255,230,0,.07) 206deg,\n    transparent 236deg,\n    transparent 360deg\n  );\n\n  -webkit-mask-image: radial-gradient(circle, #000 0%, transparent 62%);\n  mask-image: radial-gradient(circle, #000 0%, transparent 62%);\n\n  transform: translate(-50%, -50%) rotate(0deg);\n  animation: hnSpin 32s linear infinite;\n}\n\n@keyframes hnSpin {\n  to { transform: translate(-50%, -50%) rotate(360deg); }\n}\n\n/* GLOWS — slow drift */\n.hn-glow {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(100px);\n  pointer-events: none;\n  z-index: -1;\n  will-change: transform;\n}\n\n.hn-glow-1 {\n  width: 500px;\n  height: 500px;\n  background: rgba(230, 44, 255, .35);\n  top: -280px;\n  left: 50%;\n  transform: translateX(-50%);\n  animation: hnDriftA 16s ease-in-out infinite alternate;\n}\n\n.hn-glow-2 {\n  width: 350px;\n  height: 350px;\n  background: rgba(99, 0, 255, .32);\n  bottom: -250px;\n  left: 50%;\n  transform: translateX(-50%);\n  animation: hnDriftB 20s ease-in-out infinite alternate;\n}\n\n@keyframes hnDriftA {\n  from { transform: translate(-50%, 0) scale(1); }\n  to   { transform: translate(-40%, 34px) scale(1.18); }\n}\n\n@keyframes hnDriftB {\n  from { transform: translate(-50%, 0) scale(1); }\n  to   { transform: translate(-62%, -28px) scale(1.22); }\n}\n\n\n/* =========================================\n   ENTRANCE SEQUENCE (one orchestrated moment)\n   Only active when JS has loaded (.hn-js)\n   ========================================= */\n\n.hn-js [data-r] {\n  opacity: 0;\n  transform: translate3d(0, 26px, 0) scale(.98);\n  filter: blur(10px);\n}\n\n.hn-js.hn-in [data-r] {\n  opacity: 1;\n  transform: none;\n  filter: none;\n  transition:\n    opacity .9s var(--ease-out) calc(var(--d, 0) * 1ms),\n    transform 1.1s var(--ease-out) calc(var(--d, 0) * 1ms),\n    filter .9s var(--ease-out) calc(var(--d, 0) * 1ms);\n}\n\n.hn-js .hn-line-inner {\n  transform: translateY(115%) rotate(3deg);\n}\n\n.hn-js.hn-in .hn-line-inner {\n  transform: none;\n  transition: transform 1.1s var(--ease-out) calc(var(--d, 0) * 1ms);\n}\n\n\n/* MAIN CONTAINER */\n\n.hn-flash-inner {\n  width: min(1200px, 92%);\n  margin: auto;\n  padding: 90px 20px 82px;\n  text-align: center;\n  position: relative;\n}\n\n\n/* LIVE STATUS */\n\n.hn-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n\n  padding: 9px 16px;\n\n  border: 1px solid rgba(255,255,255,.28);\n  border-radius: 100px;\n\n  background: rgba(30,0,56,.25);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 2.4px;\n\n  margin-bottom: 25px;\n}\n\n.hn-status-dot {\n  position: relative;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--yellow);\n  box-shadow: 0 0 15px rgba(255,230,0,.8);\n}\n\n/* sonar ping around the dot */\n.hn-status-dot::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: var(--yellow);\n  animation: hnPing 1.9s cubic-bezier(0, 0, .2, 1) infinite;\n}\n\n@keyframes hnPing {\n  0%   { transform: scale(1);   opacity: .7; }\n  75%, 100% { transform: scale(3.6); opacity: 0; }\n}\n\n\n/* HEADING */\n\n.hn-flash-heading {\n  margin: 0;\n\n  color: #fff;\n\n  font-size: clamp(40px, 5vw, 74px);\n  line-height: .93;\n  letter-spacing: -3px;\n  font-weight: 950;\n  text-transform: uppercase;\n}\n\n/* each line is a mask so the text rises out of it */\n.hn-line {\n  display: block;\n  overflow: hidden;\n  padding: .06em .1em .14em;\n  margin: -.06em -.1em -.14em;\n}\n\n.hn-line-inner {\n  display: inline-block;\n  transform-origin: 0 100%;\n  will-change: transform;\n}\n\n.hn-accent .hn-line-inner {\n  color: var(--yellow);\n  filter: drop-shadow(4px 5px 0 var(--navy));\n}\n\n/* light sweep across the yellow line */\n@supports ((-webkit-background-clip: text) or (background-clip: text)) {\n  .hn-accent .hn-line-inner {\n    background: linear-gradient(\n      100deg,\n      var(--yellow) 0%,\n      var(--yellow) 40%,\n      #fffbd1 50%,\n      var(--yellow) 60%,\n      var(--yellow) 100%\n    );\n    background-size: 250% 100%;\n    background-position: 100% 0;\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n    animation: hnShine 6s ease-in-out 1.6s infinite;\n  }\n}\n\n@keyframes hnShine {\n  0%   { background-position: 100% 0; }\n  40%  { background-position: 0% 0; }\n  100% { background-position: 0% 0; }\n}\n\n.hn-flash-sub {\n  margin: 22px auto 0;\n\n  font-size: 15px;\n  line-height: 1.6;\n  color: rgba(255,255,255,.74);\n  letter-spacing: .2px;\n}\n\n\n/* =========================================\n   TIMER\n   ========================================= */\n\n.hn-timer {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n\n  gap: 14px;\n\n  margin: 52px auto 0;\n\n  transition: transform .7s var(--ease-out);\n  will-change: transform;\n}\n\n.hn-time-block {\n  width: 160px;\n}\n\n.hn-time-value {\n  position: relative;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  height: 150px;\n\n  border-radius: 17px;\n\n  background:\n    linear-gradient(180deg, rgba(255,255,255,.08), transparent 48%),\n    linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.035));\n\n  border: 1px solid rgba(255,255,255,.25);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.22),\n    0 18px 45px rgba(27,0,51,.25),\n    0 0 0 0 rgba(255,230,0,0);\n\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n\n  color: #fff;\n\n  font-size: clamp(54px, 6vw, 88px);\n  font-weight: 900;\n  line-height: 1;\n  font-variant-numeric: tabular-nums;\n\n  overflow: hidden;\n  transition: border-color .5s ease;\n}\n\n.hn-seconds {\n  color: var(--yellow);\n\n  border-color: rgba(255,230,0,.45);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.2),\n    0 0 35px rgba(255,230,0,.12),\n    0 18px 45px rgba(27,0,51,.25),\n    0 0 0 0 rgba(255,230,0,0);\n}\n\n.hn-time-label {\n  margin-top: 13px;\n\n  color: rgba(255,255,255,.58);\n\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2.8px;\n}\n\n.hn-separator {\n  color: rgba(255,255,255,.55);\n\n  font-size: 50px;\n  font-weight: 300;\n}\n\n.hn-separator span {\n  display: block;\n  transform: translateY(-12px);\n  animation: hnBlink 1s infinite;\n}\n\n@keyframes hnBlink {\n  0%, 45%, 100% { opacity: .7; }\n  50%, 95%      { opacity: .18; }\n}\n\n\n/* ---------- ROLLING DIGITS ---------- */\n\n.hn-digits {\n  position: relative;\n  z-index: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  text-shadow: 0 6px 24px rgba(20,0,40,.35);\n}\n\n.hn-digit {\n  display: inline-grid;\n  align-items: center;\n  height: 1.12em;\n  overflow: hidden;\n\n  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);\n  mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);\n}\n\n.hn-digit + .hn-digit {\n  margin-left: -.05em;\n}\n\n.hn-d {\n  grid-area: 1 / 1;\n  display: block;\n  line-height: 1.12;\n  text-align: center;\n  will-change: transform, opacity, filter;\n}\n\n\n/* ---------- CURSOR SPOTLIGHT ---------- */\n\n.hn-spot {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity .5s ease;\n\n  background: radial-gradient(\n    240px circle at var(--mx, 50%) var(--my, 50%),\n    rgba(255,255,255,.2),\n    transparent 62%\n  );\n}\n\n@media (hover: hover) and (pointer: fine) {\n  .hn-flash-countdown:hover .hn-spot { opacity: 1; }\n}\n\n\n/* ---------- SECONDS: COMET RING ---------- */\n\n.hn-ring {\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  padding: 1.5px;\n  pointer-events: none;\n\n  background: conic-gradient(\n    from var(--hn-angle),\n    transparent 0deg,\n    transparent 240deg,\n    rgba(255,230,0,.0) 255deg,\n    rgba(255,230,0,.85) 338deg,\n    #fff 358deg,\n    transparent 360deg\n  );\n\n  -webkit-mask:\n    linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0);\n  -webkit-mask-composite: xor;\n  mask:\n    linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0);\n  mask-composite: exclude;\n\n  animation: hnRing 4.4s linear infinite;\n  transition: opacity .6s ease;\n}\n\n@keyframes hnRing {\n  to { --hn-angle: 360deg; }\n}\n\n/* SALE DATE */\n\n.hn-sale-date {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n\n  margin-top: 42px;\n\n  color: rgba(255,255,255,.82);\n\n  font-size: 12px;\n  font-weight: 900;\n  letter-spacing: 3px;\n}\n\n.hn-sale-date i {\n  display: block;\n\n  width: 4px;\n  height: 4px;\n\n  border-radius: 50%;\n\n  background: var(--yellow);\n}\n\n\n/* BOTTOM DIVIDER */\n\n.hn-bottom-line {\n  width: min(520px, 90%);\n\n  display: flex;\n  align-items: center;\n  gap: 18px;\n\n  margin: 26px auto 0;\n}\n\n.hn-bl {\n  flex: 1;\n  height: 1px;\n}\n\n.hn-bl-l {\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.3));\n  transform-origin: right center;\n}\n\n.hn-bl-r {\n  background: linear-gradient(270deg, transparent, rgba(255,255,255,.3));\n  transform-origin: left center;\n}\n\n/* lines draw outward from the text */\n.hn-js .hn-bl { transform: scaleX(0); }\n\n.hn-js.hn-in .hn-bl {\n  transform: none;\n  transition: transform 1.3s var(--ease-out) 1.25s;\n}\n\n.hn-bottom-line p {\n  margin: 0;\n\n  color: var(--yellow);\n\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2.3px;\n\n  white-space: nowrap;\n}\n\n\n/* SPEED LINES — light streaks */\n\n.hn-speed-lines {\n  position: absolute;\n  width: 280px;\n  height: 200px;\n\n  pointer-events: none;\n  opacity: .3;\n}\n\n.hn-speed-lines-left {\n  left: -60px;\n  top: 30%;\n}\n\n.hn-speed-lines-right {\n  right: -60px;\n  top: 30%;\n  transform: scaleX(-1);\n}\n\n.hn-speed-lines span {\n  position: absolute;\n  left: 0;\n\n  height: 2px;\n\n  background: linear-gradient(90deg, transparent, var(--navy));\n\n  opacity: 0;\n  transform: rotate(10deg);\n  animation: hnStreak 5s ease-in-out infinite;\n}\n\n.hn-speed-lines span:nth-child(1) { width: 220px; top: 20px; }\n.hn-speed-lines span:nth-child(2) { width: 160px; top: 90px; left: 35px; animation-delay: 1.4s; }\n.hn-speed-lines span:nth-child(3) { width: 260px; top: 155px; animation-delay: 2.7s; }\n\n@keyframes hnStreak {\n  0%   { opacity: 0; transform: rotate(10deg) translateX(-36px); }\n  35%  { opacity: 1; }\n  100% { opacity: 0; transform: rotate(10deg) translateX(44px); }\n}\n\n\n/* =========================================\n   LIVE STATE\n   ========================================= */\n\n.hn-is-live .hn-ring { opacity: 0; }\n\n.hn-is-live .hn-time-value { border-color: rgba(255,230,0,.4); }\n\n.hn-burst,\n.hn-burst-flash {\n  position: absolute;\n  pointer-events: none;\n  z-index: 3;\n}\n\n.hn-burst {\n  left: 50%;\n  top: 56%;\n  width: 260px;\n  height: 260px;\n  margin: -130px 0 0 -130px;\n  border-radius: 50%;\n  border: 2px solid var(--yellow);\n  box-shadow: 0 0 50px rgba(255,230,0,.55), inset 0 0 50px rgba(255,230,0,.3);\n  opacity: 0;\n  animation: hnBurst 1.7s var(--ease-out) forwards;\n}\n\n@keyframes hnBurst {\n  0%   { transform: scale(.2); opacity: .95; }\n  100% { transform: scale(7);  opacity: 0; }\n}\n\n.hn-burst-flash {\n  inset: 0;\n  background: radial-gradient(circle at 50% 56%, rgba(255,255,255,.55), transparent 60%);\n  opacity: 0;\n  animation: hnFlash 1.1s ease-out forwards;\n}\n\n@keyframes hnFlash {\n  0%   { opacity: 1; }\n  100% { opacity: 0; }\n}\n\n\n/* =========================================\n   MOBILE\n   ========================================= */\n\n@media (max-width: 750px) {\n\n  .hn-flash-inner {\n    width: 100%;\n    padding: 65px 16px 58px;\n  }\n\n  .hn-status {\n    font-size: 9px;\n    letter-spacing: 1.7px;\n    margin-bottom: 20px;\n  }\n\n  .hn-flash-heading {\n    font-size: 42px;\n    line-height: .95;\n    letter-spacing: -2px;\n  }\n\n  .hn-accent .hn-line-inner {\n    filter: drop-shadow(3px 4px 0 var(--navy));\n  }\n\n  .hn-flash-sub {\n    font-size: 13px;\n    margin-top: 18px;\n  }\n\n  .hn-timer {\n    width: 100%;\n\n    gap: 5px;\n\n    margin-top: 38px;\n  }\n\n  .hn-time-block {\n    flex: 1;\n    width: auto;\n    min-width: 0;\n  }\n\n  .hn-time-value {\n    height: 88px;\n\n    border-radius: 10px;\n\n    font-size: clamp(35px, 11vw, 48px);\n  }\n\n  .hn-time-label {\n    margin-top: 9px;\n\n    font-size: 7px;\n    letter-spacing: 1px;\n  }\n\n  .hn-separator {\n    width: 8px;\n\n    font-size: 26px;\n  }\n\n  .hn-separator span {\n    transform: translateY(-9px);\n  }\n\n  .hn-sale-date {\n    margin-top: 32px;\n\n    font-size: 9px;\n    letter-spacing: 2px;\n    gap: 11px;\n  }\n\n  .hn-bottom-line {\n    margin-top: 21px;\n    gap: 10px;\n  }\n\n  .hn-bottom-line p {\n    font-size: 8px;\n    letter-spacing: 1.5px;\n  }\n\n  .hn-speed-lines {\n    opacity: .15;\n  }\n}\n\n\n/* VERY SMALL MOBILE */\n\n@media (max-width: 390px) {\n\n  .hn-flash-heading {\n    font-size: 37px;\n  }\n\n  .hn-time-value {\n    height: 78px;\n    font-size: 36px;\n  }\n\n  .hn-timer {\n    gap: 3px;\n  }\n\n  .hn-separator {\n    width: 5px;\n    font-size: 20px;\n  }\n}\n\n\n/* REDUCED MOTION — everything static, content fully visible */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-flash-countdown *,\n  .hn-flash-countdown *::before,\n  .hn-flash-countdown *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .hn-js [data-r] { opacity: 1; transform: none; filter: none; }\n  .hn-js .hn-line-inner { transform: none; }\n  .hn-js .hn-bl { transform: none; }\n  .hn-ring, .hn-beam { display: none; }\n  .hn-separator span { opacity: .6; }\n  .hn-accent .hn-line-inner { background-position: 50% 0; }\n}\n\n</style>\n\n\n<script>\n(function () {\n  \"use strict\";\n\n  /*\n   * FLASH SALE START:\n   * 3 OCTOBER 2026, 12:00 AM INDIA STANDARD TIME\n   *\n   * +05:30 ensures every visitor counts down to the SAME\n   * moment, regardless of their own timezone.\n   */\n  var SALE_START = new Date(\"2026-10-03T00:00:00+05:30\").getTime();\n\n  var section = document.getElementById(\"hn-flash-countdown\");\n  if (!section) return;\n\n  var reduceMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  var EASE_OUT = \"cubic-bezier(.16, 1, .3, 1)\";\n\n  section.classList.add(\"hn-js\");\n\n  var timerEl = section.querySelector(\".hn-timer\");\n  var units = [\"days\", \"hours\", \"minutes\", \"seconds\"].map(function (name) {\n    var el = section.querySelector(\"#hn-\" + name);\n    return { el: el, digits: el.querySelector(\".hn-digits\"), slots: [], str: \"\" };\n  });\n  var secondsCard = units[3].el;\n\n\n  /* ---------- helpers ---------- */\n\n  function pad(n) { return String(n).padStart(2, \"0\"); }\n\n  function buildSlots(unit, str) {\n    unit.digits.textContent = \"\";\n    unit.slots = [];\n    for (var i = 0; i < str.length; i++) {\n      var slot = document.createElement(\"span\");\n      slot.className = \"hn-digit\";\n      var d = document.createElement(\"span\");\n      d.className = \"hn-d\";\n      d.textContent = str[i];\n      slot.appendChild(d);\n      unit.digits.appendChild(slot);\n      unit.slots.push(slot);\n    }\n    unit.str = str;\n  }\n\n  /* One digit rolls up and out, the next rolls in from below */\n  function roll(slot, ch, animate) {\n    while (slot.children.length > 1) slot.firstElementChild.remove();\n    var old = slot.firstElementChild;\n\n    if (!animate || !old.animate) {\n      old.textContent = ch;\n      return;\n    }\n\n    var next = document.createElement(\"span\");\n    next.className = \"hn-d\";\n    next.textContent = ch;\n    slot.appendChild(next);\n\n    var opts = { duration: 640, easing: \"cubic-bezier(.22, 1, .36, 1)\" };\n\n    next.animate([\n      { transform: \"translateY(68%)\", opacity: 0, filter: \"blur(5px)\" },\n      { transform: \"translateY(0)\",   opacity: 1, filter: \"blur(0)\" }\n    ], Object.assign({ fill: \"backwards\" }, opts));\n\n    old.animate([\n      { transform: \"translateY(0)\",    opacity: 1, filter: \"blur(0)\" },\n      { transform: \"translateY(-68%)\", opacity: 0, filter: \"blur(5px)\" }\n    ], Object.assign({ fill: \"forwards\" }, opts)).onfinish = function () { old.remove(); };\n  }\n\n  function setUnit(unit, str, animate) {\n    if (str === unit.str) return;\n    if (unit.slots.length !== str.length) { buildSlots(unit, str); return; }\n    for (var i = 0; i < str.length; i++) {\n      if (unit.str[i] !== str[i]) roll(unit.slots[i], str[i], animate);\n    }\n    unit.str = str;\n  }\n\n\n  /* ---------- seconds: tick ping ---------- */\n\n  var PING_BASE = \"inset 0 1px 0 rgba(255,255,255,.2), 0 0 35px rgba(255,230,0,.12), 0 18px 45px rgba(27,0,51,.25)\";\n\n  function ping() {\n    if (reduceMotion || !secondsCard.animate) return;\n    secondsCard.animate([\n      { boxShadow: PING_BASE + \", 0 0 0 0 rgba(255,230,0,.30)\" },\n      { boxShadow: PING_BASE + \", 0 0 0 10px rgba(255,230,0,0)\" }\n    ], { duration: 760, easing: \"cubic-bezier(.2, .6, .3, 1)\" });\n  }\n\n\n  /* ---------- clock ---------- */\n\n  var first = true;\n  var live = false;\n  var timeoutId = null;\n  var lastMinuteLabel = \"\";\n\n  function tick() {\n    var distance = SALE_START - Date.now();\n\n    if (distance <= 0) { goLive(!first); return; }\n\n    var total = Math.ceil(distance / 1000);\n    var d = Math.floor(total / 86400);\n    var h = Math.floor((total % 86400) / 3600);\n    var m = Math.floor((total % 3600) / 60);\n    var s = total % 60;\n\n    var animate = !first && !document.hidden && !reduceMotion;\n\n    setUnit(units[0], pad(d), animate);\n    setUnit(units[1], pad(h), animate);\n    setUnit(units[2], pad(m), animate);\n    setUnit(units[3], pad(s), animate);\n\n    if (animate) ping();\n\n    var label = d + \" days \" + h + \" hours \" + m + \" minutes until the flash sale\";\n    if (label !== lastMinuteLabel) {\n      timerEl.setAttribute(\"aria-label\", label);\n      lastMinuteLabel = label;\n    }\n\n    first = false;\n\n    // align next tick to the wall-clock second so the digits never drift\n    timeoutId = setTimeout(tick, 1000 - (Date.now() % 1000) + 8);\n  }\n\n  function lines(a, b) {\n    return '<span class=\"hn-line\" style=\"--d:120\"><span class=\"hn-line-inner\">' + a + '</span></span>' +\n           '<span class=\"hn-line hn-accent\" style=\"--d:240\"><span class=\"hn-line-inner\">' + b + '</span></span>';\n  }\n\n  function goLive(withBurst) {\n    if (live) return;\n    live = true;\n    clearTimeout(timeoutId);\n\n    var animate = withBurst && !reduceMotion;\n    units.forEach(function (u) { setUnit(u, \"00\", animate); });\n\n    section.classList.add(\"hn-is-live\");\n    timerEl.setAttribute(\"aria-label\", \"Flash sale is live\");\n\n    var statusText = section.querySelector(\".hn-status-text\");\n    var heading = section.querySelector(\".hn-flash-heading\");\n    var sub = section.querySelector(\".hn-flash-sub\");\n\n    if (statusText) statusText.textContent = \"FLASH SALE IS LIVE\";\n    if (heading) heading.innerHTML = lines(\"NOW OR\", \"NEVER.\");\n    if (sub) sub.textContent = \"The wait is over. The sale is live.\";\n\n    if (!animate) return;\n\n    // re-play the headline reveal\n    if (heading) {\n      heading.querySelectorAll(\".hn-line-inner\").forEach(function (el, i) {\n        if (!el.animate) return;\n        el.animate([\n          { transform: \"translateY(115%) rotate(3deg)\" },\n          { transform: \"none\" }\n        ], { duration: 1000, delay: 120 + i * 110, easing: EASE_OUT, fill: \"backwards\" });\n      });\n    }\n\n    if (sub && sub.animate) {\n      sub.animate([\n        { opacity: 0, transform: \"translateY(10px)\" },\n        { opacity: 1, transform: \"none\" }\n      ], { duration: 800, delay: 420, easing: EASE_OUT, fill: \"backwards\" });\n    }\n\n    // one-time shockwave from the timer\n    [\"hn-burst\", \"hn-burst-flash\"].forEach(function (cls) {\n      var node = document.createElement(\"div\");\n      node.className = cls;\n      node.addEventListener(\"animationend\", function () { node.remove(); });\n      section.appendChild(node);\n    });\n  }\n\n\n  /* ---------- reveal + pause when off-screen ---------- */\n\n  if (\"IntersectionObserver\" in window) {\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        section.classList.toggle(\"hn-visible\", entry.isIntersecting);\n        if (entry.isIntersecting) section.classList.add(\"hn-in\");\n      });\n    }, { threshold: 0.2 });\n    io.observe(section);\n  } else {\n    section.classList.add(\"hn-visible\", \"hn-in\");\n  }\n\n\n  /* ---------- pointer: soft tilt + card spotlight (desktop only) ---------- */\n\n  if (!reduceMotion && window.matchMedia(\"(hover: hover) and (pointer: fine)\").matches) {\n    var cards = Array.prototype.slice.call(section.querySelectorAll(\".hn-time-value\"));\n    var pending = null;\n    var raf = 0;\n\n    function applyPointer() {\n      raf = 0;\n      if (!pending) return;\n\n      var sr = section.getBoundingClientRect();\n      var nx = ((pending.x - sr.left) / sr.width - 0.5) * 2;\n      var ny = ((pending.y - sr.top) / sr.height - 0.5) * 2;\n\n      timerEl.style.transform =\n        \"perspective(1400px) rotateX(\" + (-ny * 2.6).toFixed(2) + \"deg) rotateY(\" + (nx * 3.6).toFixed(2) + \"deg)\";\n\n      cards.forEach(function (card) {\n        var cr = card.getBoundingClientRect();\n        card.style.setProperty(\"--mx\", (pending.x - cr.left) + \"px\");\n        card.style.setProperty(\"--my\", (pending.y - cr.top) + \"px\");\n      });\n    }\n\n    section.addEventListener(\"pointermove\", function (e) {\n      pending = { x: e.clientX, y: e.clientY };\n      if (!raf) raf = requestAnimationFrame(applyPointer);\n    }, { passive: true });\n\n    section.addEventListener(\"pointerleave\", function () {\n      pending = null;\n      timerEl.style.transform = \"\";\n    });\n  }\n\n\n  /* ---------- go ---------- */\n\n  tick();\n\n  // re-sync instantly when the tab becomes active again\n  document.addEventListener(\"visibilitychange\", function () {\n    if (!document.hidden && !live) {\n      clearTimeout(timeoutId);\n      tick();\n    }\n  });\n\n})();\n</script>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_jXBTEG": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD NOW OR NEVER — FLASH SALE COUNTDOWN -->\n<section class=\"hn-flash-countdown\" id=\"hn-flash-countdown\">\n  <div class=\"hn-noise\" aria-hidden=\"true\"></div>\n  <div class=\"hn-glow hn-glow-1\" aria-hidden=\"true\"></div>\n  <div class=\"hn-glow hn-glow-2\" aria-hidden=\"true\"></div>\n\n  <div class=\"hn-speed-lines hn-speed-lines-left\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"hn-speed-lines hn-speed-lines-right\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"hn-flash-inner\">\n\n    <!-- TOP LABEL -->\n    <div class=\"hn-status\">\n      <span class=\"hn-status-dot\"></span>\n      FLASH SALE INCOMING\n    </div>\n\n    <!-- HEADING -->\n    <h2 class=\"hn-flash-heading\">\n      THE CLOCK IS\n      <span>RUNNING.</span>\n    </h2>\n\n    <p class=\"hn-flash-sub\">\n      NOW OR NEVER goes live on 3rd October.\n    </p>\n\n    <!-- COUNTDOWN -->\n    <div class=\"hn-timer\" aria-label=\"Countdown to flash sale\">\n\n      <div class=\"hn-time-block\">\n        <div class=\"hn-time-value\" id=\"hn-days\">00</div>\n        <div class=\"hn-time-label\">DAYS</div>\n      </div>\n\n      <div class=\"hn-separator\">:</div>\n\n      <div class=\"hn-time-block\">\n        <div class=\"hn-time-value\" id=\"hn-hours\">00</div>\n        <div class=\"hn-time-label\">HOURS</div>\n      </div>\n\n      <div class=\"hn-separator\">:</div>\n\n      <div class=\"hn-time-block\">\n        <div class=\"hn-time-value\" id=\"hn-minutes\">00</div>\n        <div class=\"hn-time-label\">MINUTES</div>\n      </div>\n\n      <div class=\"hn-separator\">:</div>\n\n      <div class=\"hn-time-block\">\n        <div class=\"hn-time-value hn-seconds\" id=\"hn-seconds\">00</div>\n        <div class=\"hn-time-label\">SECONDS</div>\n      </div>\n\n    </div>\n\n    <!-- BOTTOM -->\n    <div class=\"hn-sale-date\">\n      <span>03</span>\n      <i></i>\n      <span>OCT</span>\n      <i></i>\n      <span>2026</span>\n    </div>\n\n    <div class=\"hn-bottom-line\">\n      <span></span>\n      <p>48 HOURS ONLY</p>\n      <span></span>\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n/* =========================================\n   HNDRD FLASH SALE COUNTDOWN\n   ========================================= */\n\n.hn-flash-countdown {\n  --purple: #9d16d6;\n  --purple-bright: #c525ff;\n  --pink: #d927ff;\n  --yellow: #ffe600;\n  --navy: #070b5d;\n  --deep-purple: #24002e;\n\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  isolation: isolate;\n  background:\n    radial-gradient(\n      circle at 50% -20%,\n      rgba(224, 58, 255, 0.95) 0%,\n      rgba(177, 28, 226, 0.9) 30%,\n      rgba(117, 16, 158, 0.95) 65%,\n      #4c075f 100%\n    );\n\n  color: #fff;\n  font-family: Arial, Helvetica, sans-serif;\n}\n\n/* subtle halftone texture */\n.hn-noise {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  opacity: .18;\n\n  background-image:\n    radial-gradient(\n      rgba(255,255,255,.7) 1px,\n      transparent 1px\n    );\n\n  background-size: 12px 12px;\n\n  mask-image:\n    radial-gradient(\n      ellipse at center,\n      black 0%,\n      transparent 70%\n    );\n\n  -webkit-mask-image:\n    radial-gradient(\n      ellipse at center,\n      black 0%,\n      transparent 70%\n    );\n}\n\n/* GLOWS */\n\n.hn-glow {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(100px);\n  pointer-events: none;\n  z-index: -1;\n}\n\n.hn-glow-1 {\n  width: 500px;\n  height: 500px;\n  background: rgba(230, 44, 255, .35);\n  top: -280px;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.hn-glow-2 {\n  width: 350px;\n  height: 350px;\n  background: rgba(99, 0, 255, .32);\n  bottom: -250px;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n\n/* MAIN CONTAINER */\n\n.hn-flash-inner {\n  width: min(1200px, 92%);\n  margin: auto;\n  padding: 90px 20px 82px;\n  text-align: center;\n  position: relative;\n}\n\n\n/* LIVE STATUS */\n\n.hn-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n\n  padding: 9px 16px;\n\n  border: 1px solid rgba(255,255,255,.28);\n  border-radius: 100px;\n\n  background: rgba(30,0,56,.25);\n  backdrop-filter: blur(10px);\n\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 2.4px;\n\n  margin-bottom: 25px;\n}\n\n.hn-status-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--yellow);\n\n  box-shadow:\n    0 0 0 4px rgba(255,230,0,.12),\n    0 0 15px rgba(255,230,0,.8);\n\n  animation: hnPulse 1.4s infinite;\n}\n\n@keyframes hnPulse {\n  0%, 100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  50% {\n    opacity: .45;\n    transform: scale(.75);\n  }\n}\n\n\n/* HEADING */\n\n.hn-flash-heading {\n  margin: 0;\n\n  color: #fff;\n\n  font-size: clamp(40px, 5vw, 74px);\n  line-height: .93;\n  letter-spacing: -3px;\n  font-weight: 950;\n  text-transform: uppercase;\n}\n\n.hn-flash-heading span {\n  display: block;\n  color: var(--yellow);\n\n  text-shadow:\n    4px 5px 0 var(--navy);\n}\n\n.hn-flash-sub {\n  margin: 22px auto 0;\n\n  font-size: 15px;\n  line-height: 1.6;\n  color: rgba(255,255,255,.74);\n  letter-spacing: .2px;\n}\n\n\n/* TIMER */\n\n.hn-timer {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n\n  gap: 14px;\n\n  margin: 52px auto 0;\n}\n\n.hn-time-block {\n  width: 160px;\n}\n\n.hn-time-value {\n  position: relative;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  height: 150px;\n\n  border-radius: 17px;\n\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255,255,255,.14),\n      rgba(255,255,255,.035)\n    );\n\n  border: 1px solid rgba(255,255,255,.25);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.22),\n    0 18px 45px rgba(27,0,51,.25);\n\n  backdrop-filter: blur(14px);\n\n  color: #fff;\n\n  font-size: clamp(54px, 6vw, 88px);\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: -5px;\n\n  overflow: hidden;\n}\n\n/* glass shine */\n\n.hn-time-value::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0;\n\n  width: 100%;\n  height: 48%;\n\n  background:\n    linear-gradient(\n      to bottom,\n      rgba(255,255,255,.08),\n      transparent\n    );\n\n  pointer-events: none;\n}\n\n/* center split */\n\n.hn-time-value::after {\n  content: \"\";\n  position: absolute;\n  left: 8%;\n  right: 8%;\n  top: 50%;\n\n  height: 1px;\n\n  background: rgba(0,0,0,.13);\n}\n\n.hn-seconds {\n  color: var(--yellow);\n\n  border-color: rgba(255,230,0,.45);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.2),\n    0 0 35px rgba(255,230,0,.12),\n    0 18px 45px rgba(27,0,51,.25);\n}\n\n.hn-time-label {\n  margin-top: 13px;\n\n  color: rgba(255,255,255,.58);\n\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2.8px;\n}\n\n.hn-separator {\n  color: rgba(255,255,255,.55);\n\n  font-size: 50px;\n  font-weight: 300;\n\n  transform: translateY(-12px);\n\n  animation: hnBlink 1s infinite;\n}\n\n@keyframes hnBlink {\n  0%, 45%, 100% {\n    opacity: .7;\n  }\n\n  50%, 95% {\n    opacity: .18;\n  }\n}\n\n\n/* SALE DATE */\n\n.hn-sale-date {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n\n  margin-top: 42px;\n\n  color: rgba(255,255,255,.82);\n\n  font-size: 12px;\n  font-weight: 900;\n  letter-spacing: 3px;\n}\n\n.hn-sale-date i {\n  display: block;\n\n  width: 4px;\n  height: 4px;\n\n  border-radius: 50%;\n\n  background: var(--yellow);\n}\n\n\n/* BOTTOM DIVIDER */\n\n.hn-bottom-line {\n  width: min(520px, 90%);\n\n  display: flex;\n  align-items: center;\n  gap: 18px;\n\n  margin: 26px auto 0;\n}\n\n.hn-bottom-line span {\n  flex: 1;\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.3)\n    );\n}\n\n.hn-bottom-line span:last-child {\n  transform: rotate(180deg);\n}\n\n.hn-bottom-line p {\n  margin: 0;\n\n  color: var(--yellow);\n\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2.3px;\n\n  white-space: nowrap;\n}\n\n\n/* SPEED LINES */\n\n.hn-speed-lines {\n  position: absolute;\n  width: 280px;\n  height: 200px;\n\n  pointer-events: none;\n  opacity: .25;\n}\n\n.hn-speed-lines-left {\n  left: -60px;\n  top: 30%;\n}\n\n.hn-speed-lines-right {\n  right: -60px;\n  top: 30%;\n  transform: scaleX(-1);\n}\n\n.hn-speed-lines span {\n  position: absolute;\n  left: 0;\n\n  height: 2px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      var(--navy)\n    );\n\n  transform: rotate(10deg);\n}\n\n.hn-speed-lines span:nth-child(1) {\n  width: 220px;\n  top: 20px;\n}\n\n.hn-speed-lines span:nth-child(2) {\n  width: 160px;\n  top: 90px;\n  left: 35px;\n}\n\n.hn-speed-lines span:nth-child(3) {\n  width: 260px;\n  top: 155px;\n}\n\n\n/* =========================================\n   MOBILE\n   ========================================= */\n\n@media (max-width: 750px) {\n\n  .hn-flash-inner {\n    width: 100%;\n    padding: 65px 16px 58px;\n  }\n\n  .hn-status {\n    font-size: 9px;\n    letter-spacing: 1.7px;\n    margin-bottom: 20px;\n  }\n\n  .hn-flash-heading {\n    font-size: 42px;\n    line-height: .95;\n    letter-spacing: -2px;\n  }\n\n  .hn-flash-heading span {\n    text-shadow:\n      3px 4px 0 var(--navy);\n  }\n\n  .hn-flash-sub {\n    font-size: 13px;\n    margin-top: 18px;\n  }\n\n  .hn-timer {\n    width: 100%;\n\n    gap: 5px;\n\n    margin-top: 38px;\n  }\n\n  .hn-time-block {\n    flex: 1;\n    width: auto;\n    min-width: 0;\n  }\n\n  .hn-time-value {\n    height: 88px;\n\n    border-radius: 10px;\n\n    font-size: clamp(35px, 11vw, 48px);\n    letter-spacing: -3px;\n  }\n\n  .hn-time-label {\n    margin-top: 9px;\n\n    font-size: 7px;\n    letter-spacing: 1px;\n  }\n\n  .hn-separator {\n    width: 8px;\n\n    font-size: 26px;\n\n    transform: translateY(-9px);\n  }\n\n  .hn-sale-date {\n    margin-top: 32px;\n\n    font-size: 9px;\n    letter-spacing: 2px;\n    gap: 11px;\n  }\n\n  .hn-bottom-line {\n    margin-top: 21px;\n    gap: 10px;\n  }\n\n  .hn-bottom-line p {\n    font-size: 8px;\n    letter-spacing: 1.5px;\n  }\n\n  .hn-speed-lines {\n    opacity: .12;\n  }\n}\n\n\n/* VERY SMALL MOBILE */\n\n@media (max-width: 390px) {\n\n  .hn-flash-heading {\n    font-size: 37px;\n  }\n\n  .hn-time-value {\n    height: 78px;\n    font-size: 36px;\n  }\n\n  .hn-timer {\n    gap: 3px;\n  }\n\n  .hn-separator {\n    width: 5px;\n    font-size: 20px;\n  }\n}\n\n\n/* REDUCED MOTION */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-status-dot,\n  .hn-separator {\n    animation: none;\n  }\n}\n\n\n/* PREMIUM FINISH — scoped to this countdown */\n#hn-flash-countdown { background: radial-gradient(ellipse at 50% 0%, #53106d 0%, #21072f 48%, #0e0818 100%); }\n#hn-flash-countdown, #hn-flash-countdown * { box-sizing: border-box; }\n#hn-flash-countdown::before { content: \"\"; position: absolute; inset: 0; pointer-events: none; border-block: 1px solid rgba(224,185,255,.2); background: linear-gradient(115deg,transparent 24%,rgba(207,155,255,.035) 24.1%,transparent 45%); }\n#hn-flash-countdown .hn-flash-inner { padding: 76px 20px 62px; }\n#hn-flash-countdown .hn-noise { opacity: .12; background-size: 7px 7px; }\n#hn-flash-countdown .hn-glow { filter: blur(65px); animation: hnPremiumDrift 14s ease-in-out infinite alternate; }\n#hn-flash-countdown .hn-glow-1 { top: -290px; width: 680px; height: 520px; background: rgba(197,37,255,.35); }\n#hn-flash-countdown .hn-glow-2 { bottom: -320px; width: 600px; height: 430px; background: rgba(122,62,237,.28); animation-delay: -7s; }\n#hn-flash-countdown .hn-status { color: #eee2f5; font-size: 10px; font-weight: 700; letter-spacing: 2.6px; padding: 11px 18px; border-color: rgba(229,193,255,.23); background: rgba(239,208,255,.045); box-shadow: inset 0 1px 0 rgba(255,255,255,.06); }\n#hn-flash-countdown .hn-status-dot { animation: hnPremiumPulse 3s ease-in-out infinite; }\n#hn-flash-countdown .hn-flash-heading { font-size: clamp(44px,6.3vw,84px); line-height: .98; letter-spacing: -.055em; font-weight: 900; }\n#hn-flash-countdown .hn-flash-heading span { margin-top: 5px; color: #ffe960; background: linear-gradient(105deg,#dfb934 12%,#fff4a2 37%,#ffe65b 53%,#cf9d23 77%,#ffe777 92%); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; text-shadow: none; animation: hnPremiumGold 9s ease-in-out infinite; }\n#hn-flash-countdown .hn-flash-sub { color: #cbbad6; font-size: 14px; margin-top: 21px; }\n#hn-flash-countdown .hn-timer { gap: 16px; margin-top: 40px; }\n#hn-flash-countdown .hn-time-block { width: 142px; transition: transform .35s ease; }\n#hn-flash-countdown .hn-time-value { height: 136px; border-radius: 16px; font-size: clamp(52px,6vw,76px); font-weight: 700; letter-spacing: -.055em; font-variant-numeric: tabular-nums; background: linear-gradient(145deg,rgba(218,184,244,.12),rgba(55,27,75,.18)); border-color: rgba(219,181,246,.23); box-shadow: inset 0 1px 0 rgba(255,255,255,.13),0 15px 32px rgba(0,0,0,.2); transition: border-color .35s,box-shadow .35s; }\n#hn-flash-countdown .hn-time-value::before { top: -35%; left: -85%; height: 170%; width: 65%; background: linear-gradient(90deg,transparent,rgba(255,255,255,.065),transparent); transform: skewX(-22deg); animation: hnPremiumSheen 11s ease-in-out infinite; }\n#hn-flash-countdown .hn-time-block:nth-child(3) .hn-time-value::before { animation-delay: .2s; }\n#hn-flash-countdown .hn-time-block:nth-child(5) .hn-time-value::before { animation-delay: .4s; }\n#hn-flash-countdown .hn-time-block:nth-child(7) .hn-time-value::before { animation-delay: .6s; }\n#hn-flash-countdown .hn-time-value::after { left: 0; right: 0; background: rgba(9,3,17,.3); box-shadow: 0 1px 0 rgba(255,255,255,.025); }\n#hn-flash-countdown .hn-seconds { color: #ffe777; border-color: rgba(255,220,94,.38); background: linear-gradient(145deg,rgba(225,189,63,.105),rgba(55,27,75,.14)); box-shadow: inset 0 1px 0 rgba(255,244,177,.1),0 0 32px rgba(255,210,56,.035),0 15px 32px rgba(0,0,0,.2); }\n#hn-flash-countdown .hn-time-label { color: #baa6ca; font-size: 9px; letter-spacing: 2.7px; margin-top: 16px; }\n#hn-flash-countdown .hn-separator { font-size: 30px; color: #a18baF; animation: none; opacity: .55; }\n#hn-flash-countdown .hn-sale-date { margin-top: 34px; color: #ddcee6; font-size: 10px; letter-spacing: 3px; }\n#hn-flash-countdown .hn-sale-date i { width: 3px; height: 3px; background: #d2ae52; }\n#hn-flash-countdown .hn-bottom-line { width: min(400px,90%); }\n#hn-flash-countdown .hn-bottom-line p { color: #e5ce7b; font-size: 9px; letter-spacing: 3px; }\n#hn-flash-countdown .hn-bottom-line span { background: linear-gradient(90deg,transparent,rgba(225,190,88,.32)); }\n#hn-flash-countdown .hn-speed-lines { opacity: .28; top: 36%; }\n#hn-flash-countdown .hn-speed-lines span { height: 1px; background: linear-gradient(90deg,transparent,#c47de3,transparent); animation: hnPremiumStreak 8s ease-in-out infinite; }\n#hn-flash-countdown .hn-speed-lines span:nth-child(2) { animation-delay: -2s; }\n#hn-flash-countdown .hn-speed-lines span:nth-child(3) { animation-delay: -5s; }\n#hn-flash-countdown .hn-flash-inner > * { animation: hnPremiumEntrance .85s ease both; }\n#hn-flash-countdown .hn-flash-inner > :nth-child(2) { animation-delay: .08s; }\n#hn-flash-countdown .hn-flash-inner > :nth-child(3) { animation-delay: .16s; }\n#hn-flash-countdown .hn-flash-inner > :nth-child(4) { animation-delay: .24s; }\n#hn-flash-countdown .hn-flash-inner > :nth-child(n+5) { animation-delay: .32s; }\n@media (hover:hover) and (pointer:fine) {\n #hn-flash-countdown .hn-time-block:hover { transform: translateY(-5px); }\n #hn-flash-countdown .hn-time-block:hover .hn-time-value { border-color: rgba(242,216,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.2),0 20px 40px rgba(0,0,0,.3); }\n}\n@keyframes hnPremiumEntrance { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }\n@keyframes hnPremiumDrift { from { transform: translateX(-56%) scale(.95); } to { transform: translateX(-44%) scale(1.08); } }\n@keyframes hnPremiumGold { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }\n@keyframes hnPremiumPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .65; transform: scale(.85); } }\n@keyframes hnPremiumSheen { 0%,65% { left: -85%; } 90%,100% { left: 145%; } }\n@keyframes hnPremiumStreak { 0%,100% { opacity: .12; transform: translateX(-25px) rotate(-12deg); } 50% { opacity: .7; transform: translateX(25px) rotate(-12deg); } }\n@media (max-width:750px) {\n #hn-flash-countdown .hn-flash-inner { padding: 56px 16px 44px; }\n #hn-flash-countdown .hn-status { font-size: 8px; letter-spacing: 1.9px; }\n #hn-flash-countdown .hn-flash-heading { font-size: clamp(39px,9vw,62px); }\n #hn-flash-countdown .hn-flash-sub { font-size: 12px; }\n #hn-flash-countdown .hn-timer { gap: 6px; margin-top: 32px; max-width: 480px; }\n #hn-flash-countdown .hn-time-block { width: auto; }\n #hn-flash-countdown .hn-time-value { height: clamp(76px,21vw,108px); font-size: clamp(34px,10vw,56px); border-radius: 11px; }\n #hn-flash-countdown .hn-time-label { font-size: 7px; letter-spacing: 1px; margin-top: 11px; }\n #hn-flash-countdown .hn-separator { width: 5px; font-size: 22px; }\n #hn-flash-countdown .hn-speed-lines { opacity: .12; }\n}\n@media (prefers-reduced-motion:reduce) {\n #hn-flash-countdown *, #hn-flash-countdown *::before, #hn-flash-countdown *::after { animation: none !important; transition: none !important; }\n}\n\n</style>\n\n\n<script>\n(function () {\n\n  /*\n   * FLASH SALE START:\n   * 3 OCTOBER 2026\n   * 12:00 AM INDIA STANDARD TIME\n   *\n   * +05:30 ensures every visitor sees\n   * the countdown to the SAME moment,\n   * regardless of their own timezone.\n   */\n\n  const saleStart =\n    new Date(\"2026-10-03T00:00:00+05:30\").getTime();\n\n  const section =\n    document.getElementById(\"hn-flash-countdown\");\n\n  if (!section) return;\n\n  const daysEl =\n    section.querySelector(\"#hn-days\");\n\n  const hoursEl =\n    section.querySelector(\"#hn-hours\");\n\n  const minutesEl =\n    section.querySelector(\"#hn-minutes\");\n\n  const secondsEl =\n    section.querySelector(\"#hn-seconds\");\n\n\n  let timerInterval;\n  const reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n\n  function setValue(element, value) {\n    if (element.textContent === value) return;\n    const previous = element.querySelector(\"span\");\n    const digit = document.createElement(\"span\");\n    digit.textContent = value;\n    element.replaceChildren(digit);\n    if (previous && !reducedMotion.matches && digit.animate) {\n      digit.animate([{opacity: .35, transform: \"translateY(7px)\"}, {opacity: 1, transform: \"translateY(0)\"}], {duration: 300, easing: \"ease-out\"});\n    }\n  }\n\n  function pad(number) {\n    return String(number).padStart(2, \"0\");\n  }\n\n\n  function updateTimer() {\n\n    const now = Date.now();\n\n    let distance = saleStart - now;\n\n\n    /* SALE HAS STARTED */\n\n    if (distance <= 0) {\n\n      daysEl.textContent = \"00\";\n      hoursEl.textContent = \"00\";\n      minutesEl.textContent = \"00\";\n      secondsEl.textContent = \"00\";\n\n      const status =\n        section.querySelector(\".hn-status\");\n\n      const heading =\n        section.querySelector(\".hn-flash-heading\");\n\n      const subtitle =\n        section.querySelector(\".hn-flash-sub\");\n\n\n      if (status) {\n        status.innerHTML =\n          '<span class=\"hn-status-dot\"></span> FLASH SALE IS LIVE';\n      }\n\n      if (heading) {\n        heading.innerHTML =\n          'NOW OR <span>NEVER.</span>';\n      }\n\n      if (subtitle) {\n        subtitle.textContent =\n          \"The wait is over. The sale is live.\";\n      }\n\n      clearInterval(timerInterval);\n\n      return;\n    }\n\n\n    const day =\n      1000 * 60 * 60 * 24;\n\n    const hour =\n      1000 * 60 * 60;\n\n    const minute =\n      1000 * 60;\n\n\n    const days =\n      Math.floor(distance / day);\n\n    const hours =\n      Math.floor((distance % day) / hour);\n\n    const minutes =\n      Math.floor((distance % hour) / minute);\n\n    const seconds =\n      Math.floor((distance % minute) / 1000);\n\n\n    setValue(daysEl, pad(days));\n\n    setValue(hoursEl, pad(hours));\n\n    setValue(minutesEl, pad(minutes));\n\n    setValue(secondsEl, pad(seconds));\n  }\n\n\n  updateTimer();\n\n  if (Date.now() < saleStart) {\n    timerInterval = setInterval(function () {\n      if (!section.isConnected) { clearInterval(timerInterval); return; }\n      if (!document.hidden) updateTimer();\n    }, 1000);\n  }\n\n})();\n</script>",
