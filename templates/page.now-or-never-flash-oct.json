      "settings": {
        "custom_liquid": "<!-- HNDRD — Section 8: Combo Kits / Buy More Save More. Paste into a Shopify \"Custom Liquid\" section. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  .hb-combo{\n    --orange-1:#ff5a1f; --orange-2:#ff8a1f; --orange-3:#ffc61f;\n    --blue-1:#0a3fb0; --blue-2:#1f6bff; --sky:#8fd7ff;\n    --ink:#0b0b0c; --white:#ffffff;\n    background:var(--ink); padding:90px 24px 20px; font-family:'Inter',sans-serif; box-sizing:border-box;\n    position:relative; overflow:hidden;\n  }\n  .hb-combo *{box-sizing:border-box;}\n  .hb-combo-inner{max-width:1200px; margin:0 auto; position:relative; z-index:2;}\n\n  /* ---- text header (replaces banner) ---- */\n  .hb-combo-header{\n    text-align:center;\n    max-width:640px;\n    margin:0 auto 56px;\n  }\n  .hb-combo-eyebrow{\n    display:inline-flex; align-items:center; gap:8px;\n    font-size:12px; font-weight:800; letter-spacing:2px; text-transform:uppercase;\n    color:var(--orange-2); margin-bottom:18px;\n  }\n  .hb-combo-eyebrow .hb-dot{\n    width:7px; height:7px; border-radius:50%; background:var(--orange-1);\n    box-shadow:0 0 0 4px rgba(255,90,31,.22);\n    animation:hb-combo-pulse 1.6s ease-in-out infinite;\n  }\n  @keyframes hb-combo-pulse{ 0%,100%{ box-shadow:0 0 0 4px rgba(255,90,31,.22);} 50%{ box-shadow:0 0 0 8px rgba(255,90,31,.06);} }\n\n  .hb-combo-heading{\n    font-family:'Anton',sans-serif; text-transform:uppercase; line-height:1.2;\n    font-size:clamp(38px,5.5vw,66px); margin:0;\n  }\n  .hb-combo-heading .hb-l1{\n    background:linear-gradient(180deg,#eaf6ff, #ffffff 55%, #cfe9ff);\n    -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n  .hb-combo-heading .hb-l2{\n    background:linear-gradient(180deg,#ff8a1f, #ff5a1f 60%, #ffc61f);\n    -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n  .hb-combo-sub{margin-top:18px; color:#a9a9ad; font-weight:600; font-size:15px; line-height:1.5;}\n  .hb-combo-sub b{color:var(--white); font-weight:800;}\n\n  /* ---- step guide ---- */\n  .hb-steps{\n    display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;\n    margin-bottom:48px;\n  }\n  .hb-step{\n    display:flex; align-items:center; gap:10px;\n    background:#151517; border:1px solid #232326; border-radius:40px;\n    padding:10px 18px 10px 10px;\n  }\n  .hb-step .hb-num{\n    width:26px; height:26px; border-radius:50%; background:var(--orange-1); color:#fff;\n    font-family:'Anton',sans-serif; font-size:13px; display:flex; align-items:center; justify-content:center;\n  }\n  .hb-step p{font-size:13px; font-weight:700; color:#d8d8db; margin:0;}\n  .hb-step p b{color:var(--orange-2);}\n  .hb-step-arrow{color:#3d3d40; font-size:16px;}\n\n \n</style>\n\n<section class=\"hb-combo\">\n  <div class=\"hb-combo-inner\">\n\n    <!-- Text header -->\n    <div class=\"hb-combo-header\">\n      <div class=\"hb-combo-eyebrow\"><span class=\"hb-dot\"></span>Combo Offers</div>\n      <h2 class=\"hb-combo-heading\">\n        <span class=\"hb-l1\">Buy More.</span> <span class=\"hb-l2\">Save More.</span>\n      </h2>\n      <p class=\"hb-combo-sub\">Pick 2 products for exclusive savings. <b>Add a 3rd for even bigger discounts.</b> Mix rackets, shoes &amp; kit bags across 3 combo tiers.</p>\n    </div>\n\n    <!-- Step guide -->\n    <div class=\"hb-steps\">\n      <div class=\"hb-step\"><span class=\"hb-num\">1</span><p>Pick a <b>combo tier</b></p></div>\n      <span class=\"hb-step-arrow\">→</span>\n      <div class=\"hb-step\"><span class=\"hb-num\">2</span><p>Add <b>2 products</b> for the base discount</p></div>\n      <span class=\"hb-step-arrow\">→</span>\n      <div class=\"hb-step\"><span class=\"hb-num\">3</span><p>Add a <b>3rd</b> for +2% extra off</p></div>\n    </div>\n\n   </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
