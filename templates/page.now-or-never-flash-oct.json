        "custom_liquid": "<section class=\"bth-cats1\">\n  <style>\n    .bth-cats1 {\n      background: #110900;\n      padding: 26px 20px;\n      padding-bottom: 70px;\n    }\n .bth-cats-inner {\n      max-width: 1000px;\n      margin: 0;\n      text-align: center;\n    }\n    .bth-section-tag {\n      display: inline-block;\n      font-family: 'Inter', sans-serif;\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: #FF5500;\n      border: 1px solid rgba(255,85,0,0.35);\n      border-radius: 100px;\n      padding: 4px 14px;\n      margin-bottom: 18px;\n    }\n    .bth-section-heading {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: clamp(30px, 5.5vw, 52px);\n      font-weight: 900;\n      color: #ffffff;\n      text-transform: uppercase;\n      letter-spacing: 0.02em;\n      line-height: 1.05;\n    }\n    \n    .bth-cats-inner {\n      max-width: 1000px;\n      margin: 0 auto;\n    }\n    .bth-cats-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 14px;\n    }\n    @media (max-width: 768px) {\n      .bth-cats-grid { grid-template-columns: repeat(2, 1fr); }\n    }\n    @media (max-width: 400px) {\n      .bth-cats-grid { grid-template-columns: repeat(2, 1fr); }\n    }\n    .bth-cat-card {\n      position: relative;\n    \n      transition: transform 0.25s ease;\n    }\n    .bth-cat-card:hover {\n      transform: translateY(-4px);\n    }\n    .bth-cat-card img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      object-position: center top;\n      display: block;\n      transition: transform 0.4s ease;\n    }\n    .bth-cat-card:hover img {\n      transform: scale(1.05);\n    }\n  </style>\n<div class=\"bth-cats-inner\">\n    <span class=\"bth-section-tag\">What's On Sale</span>\n    <h2 class=\"bth-section-heading\">Drops Across Every Sport</h2>\n\n    <div class=\"bth-cats-grid\">\n\n      <div class=\"bth-cat-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_d51aaf71-cc64-4161-b223-46a5d1ff27ae.jpg?v=1782733742&width=535\" alt=\"Rackets\" loading=\"lazy\">\n      </div>\n\n      <div class=\"bth-cat-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_2_66bcee79-1432-4364-a1fb-c6bebd046a69.jpg?v=1782733742&width=535\" alt=\"Shoes\" loading=\"lazy\">\n      </div>\n\n      <div class=\"bth-cat-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_3_fc9641fb-1fee-4528-88c0-7a7f11311a9b.jpg?v=1782733742&width=535\" alt=\"Kit Bags\" loading=\"lazy\">\n      </div>\n\n      <div class=\"bth-cat-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_4_dac4ebaf-3d3f-4dca-be61-305182916e18.jpg?v=1782733742&width=535\" alt=\"Paddles\" loading=\"lazy\">\n      </div>\n\n    </div>\n  </div>\n</section>",
