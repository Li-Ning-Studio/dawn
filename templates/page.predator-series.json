      "settings": {
        "custom_liquid": "{% liquid\n  assign hero_eyebrow = 'Predator Extreme Series'\n  assign hero_heading = 'Unleash Every Attack'\n  assign hero_description = 'Explosive shaft power and an aerodynamic frame for fast, stable attacks.'\n  assign hero_button = 'SHOP PREDATOR EXTREME'\n  assign hero_link = 'https://in.hndrd.co/collections/predator-extreme'\n%}\n\n<section class=\"hn-orange-hero\" aria-label=\"{{ hero_eyebrow | escape }}\">\n  <div class=\"hn-orange-hero__inner\">\n    <p class=\"hn-orange-hero__eyebrow\">\n      {{ hero_eyebrow | escape }}\n    </p>\n\n    <h2 class=\"hn-orange-hero__heading\">\n      {{ hero_heading | escape }}\n    </h2>\n\n    <p class=\"hn-orange-hero__description\">\n      {{ hero_description | escape }}\n    </p>\n\n    {% if hero_link != blank %}\n      <a class=\"hn-orange-hero__button\" href=\"{{ hero_link | escape }}\">\n        {{ hero_button | escape }}\n      </a>\n    {% elsif request.design_mode %}\n      <span class=\"hn-orange-hero__button\" aria-disabled=\"true\">\n        {{ hero_button | escape }}\n      </span>\n    {% endif %}\n  </div>\n</section>\n\n<style>\n.hn-orange-hero {\n  --hn-orange: linear-gradient(\n    105deg,\n    #ffdbad 0%,\n    #ffbc78 28%,\n    #ff983e 55%,\n    #f57b26 78%,\n    #ffc18a 100%\n  );\n  box-sizing: border-box;\n  width: 100%;\n  background: #050505;\n  color: #f6f5f2;\n  padding: clamp(10px, 9vw, 13px) 24px;\n  text-align: center;\n  isolation: isolate;\n}\n\n.hn-orange-hero * {\n  box-sizing: border-box;\n}\n\n.hn-orange-hero__inner {\n  max-width: 1320px;\n  margin-inline: auto;\n}\n\n.hn-orange-hero .hn-orange-hero__eyebrow {\n  margin: 0 0 22px;\n  color: #a9a7a3;\n  font-family: inherit;\n  font-size: 14px;\n  line-height: 1.6;\n  letter-spacing: .025em;\n}\n\n.hn-orange-hero .hn-orange-hero__heading {\n  width: fit-content;\n  max-width: 100%;\n  margin: 0 auto;\n  padding-bottom: .08em;\n  font-family: var(--font-heading-family, inherit);\n  font-size: clamp(42px, 6.2vw, 88px);\n  font-weight: 750;\n  line-height: 1.08;\n  letter-spacing: -.045em;\n  text-transform: none;\n  text-wrap: balance;\n  color: #ffbc78;\n}\n\n@supports ((background-clip: text) or (-webkit-background-clip: text)) {\n  .hn-orange-hero .hn-orange-hero__heading {\n    background-image: var(--hn-orange);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n}\n\n.hn-orange-hero .hn-orange-hero__description {\n  max-width: 780px;\n  margin: 24px auto 0;\n  font-family: inherit;\n  font-size: clamp(15px, 1.35vw, 18px);\n  font-weight: 400;\n  line-height: 1.75;\n  letter-spacing: 0;\n  color: #aaa9a6;\n  text-wrap: pretty;\n}\n\n.hn-orange-hero .hn-orange-hero__button {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 54px;\n  max-width: 100%;\n  margin-top: 38px;\n  padding: 16px 36px;\n  border: 1px solid transparent;\n  border-radius: 100px;\n  background:\n    linear-gradient(#050505, #050505) padding-box,\n    var(--hn-orange) border-box;\n  color: #f6f5f2;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .12em;\n  line-height: 1.5;\n  text-decoration: none;\n  transition: transform .2s ease, box-shadow .2s ease;\n}\n\n.hn-orange-hero a.hn-orange-hero__button:hover {\n  color: #fff;\n  transform: translateY(-2px);\n  box-shadow: 0 5px 25px rgb(255 152 62 / 16%);\n}\n\n.hn-orange-hero a.hn-orange-hero__button:focus-visible {\n  outline: 2px solid #ffbc78;\n  outline-offset: 5px;\n}\n\n@media (max-width: 600px) {\n  .hn-orange-hero {\n    padding: 72px 22px;\n  }\n\n  .hn-orange-hero .hn-orange-hero__eyebrow {\n    font-size: 12px;\n    margin-bottom: 20px;\n  }\n\n  .hn-orange-hero .hn-orange-hero__heading {\n    font-size: clamp(38px, 10.5vw, 60px);\n    line-height: 1.12;\n  }\n\n  .hn-orange-hero .hn-orange-hero__description {\n    margin-top: 20px;\n    max-width: 360px;\n  }\n\n  .hn-orange-hero .hn-orange-hero__button {\n    margin-top: 28px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-orange-hero .hn-orange-hero__button {\n    transition: none;\n  }\n\n  .hn-orange-hero a.hn-orange-hero__button:hover {\n    transform: none;\n  }\n}\n</style>",
