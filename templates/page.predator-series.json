        "custom_liquid": "{% liquid\n  assign hero_eyebrow = 'Predator Pro Series'\n  assign hero_heading = 'Precision Meets Power'\n  assign hero_description = 'Fast swings, powerful attacks, and a forgiving sweet spot for confident play.'\n  assign hero_button = 'SHOP PREDATOR PRO'\n  assign hero_link = 'https://in.hndrd.co/collections/predator-pro-series'\n%}\n\n<section class=\"hn-predator-blue\" aria-label=\"{{ hero_eyebrow | escape }}\">\n  <div class=\"hn-predator-blue__inner\">\n    <p class=\"hn-predator-blue__eyebrow\">\n      {{ hero_eyebrow | escape }}\n    </p>\n\n    <h2 class=\"hn-predator-blue__heading\">\n      {{ hero_heading | escape }}\n    </h2>\n\n    <p class=\"hn-predator-blue__description\">\n      {{ hero_description | escape }}\n    </p>\n\n    {% if hero_link != blank %}\n      <a class=\"hn-predator-blue__button\" href=\"{{ hero_link | escape }}\">\n        {{ hero_button | escape }}\n      </a>\n    {% elsif request.design_mode %}\n      <span class=\"hn-predator-blue__button\" aria-disabled=\"true\">\n        {{ hero_button | escape }}\n      </span>\n    {% endif %}\n  </div>\n</section>\n\n<style>\n.hn-predator-blue {\n  --hn-blue: linear-gradient(\n    105deg,\n    #c5efff 0%,\n    #98d9f5 28%,\n    #70bbed 55%,\n    #5999de 78%,\n    #a5d8f5 100%\n  );\n  box-sizing: border-box;\n  width: 100%;\n  background: #050505;\n  color: #f6f5f2;\n  padding: clamp(10px, 9vw, 13px) 24px;\n  text-align: center;\n  isolation: isolate;\n}\n\n.hn-predator-blue * {\n  box-sizing: border-box;\n}\n\n.hn-predator-blue__inner {\n  max-width: 1320px;\n  margin-inline: auto;\n}\n\n.hn-predator-blue .hn-predator-blue__eyebrow {\n  margin: 0 0 22px;\n  color: #a9a7a3;\n  font-family: inherit;\n  font-size: 14px;\n  line-height: 1.6;\n  letter-spacing: .025em;\n}\n\n.hn-predator-blue .hn-predator-blue__heading {\n  width: fit-content;\n  max-width: 100%;\n  margin: 0 auto;\n  padding-bottom: .08em;\n  font-family: var(--font-heading-family, inherit);\n  font-size: clamp(42px, 6.2vw, 88px);\n  font-weight: 750;\n  line-height: 1.08;\n  letter-spacing: -.045em;\n  text-transform: none;\n  text-wrap: balance;\n  color: #98d9f5;\n}\n\n@supports ((background-clip: text) or (-webkit-background-clip: text)) {\n  .hn-predator-blue .hn-predator-blue__heading {\n    background-image: var(--hn-blue);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n}\n\n.hn-predator-blue .hn-predator-blue__description {\n  max-width: 780px;\n  margin: 24px auto 0;\n  font-family: inherit;\n  font-size: clamp(15px, 1.35vw, 18px);\n  font-weight: 400;\n  line-height: 1.75;\n  letter-spacing: 0;\n  color: #aaa9a6;\n  text-wrap: pretty;\n}\n\n.hn-predator-blue .hn-predator-blue__button {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 54px;\n  max-width: 100%;\n  margin-top: 38px;\n  padding: 16px 36px;\n  border: 1px solid transparent;\n  border-radius: 100px;\n  background:\n    linear-gradient(#050505, #050505) padding-box,\n    var(--hn-blue) border-box;\n  color: #f6f5f2;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .12em;\n  line-height: 1.5;\n  text-decoration: none;\n  transition: transform .2s ease, box-shadow .2s ease;\n}\n\n.hn-predator-blue a.hn-predator-blue__button:hover {\n  color: #fff;\n  transform: translateY(-2px);\n  box-shadow: 0 5px 25px rgb(112 187 237 / 16%);\n}\n\n.hn-predator-blue a.hn-predator-blue__button:focus-visible {\n  outline: 2px solid #98d9f5;\n  outline-offset: 5px;\n}\n\n@media (max-width: 600px) {\n  .hn-predator-blue {\n    padding: 72px 22px;\n  }\n\n  .hn-predator-blue .hn-predator-blue__eyebrow {\n    font-size: 12px;\n    margin-bottom: 20px;\n  }\n\n  .hn-predator-blue .hn-predator-blue__heading {\n    font-size: clamp(38px, 10.5vw, 60px);\n    line-height: 1.12;\n  }\n\n  .hn-predator-blue .hn-predator-blue__description {\n    margin-top: 20px;\n    max-width: 360px;\n  }\n\n  .hn-predator-blue .hn-predator-blue__button {\n    margin-top: 28px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-predator-blue .hn-predator-blue__button {\n    transition: none;\n  }\n\n  .hn-predator-blue a.hn-predator-blue__button:hover {\n    transform: none;\n  }\n}\n</style>",
