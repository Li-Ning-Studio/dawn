  margin-bottom: 24px;\n    }\n\n    .hn-predator-shop__features li {\n      font-size: 14px;\n      gap: 10px;\n    }\n\n    .hn-predator-shop__desc {\n      font-size: 14px;\n      line-height: 1.55;\n    }\n\n    .hn-predator-shop__button {\n      min-height: 48px;\n      font-size: 14px;\n      border-width: 1.5px;\n    }\n\n    .hn-predator-shop__nav {\n      width: 40px;\n      height: 40px;\n      border: 1px solid #ffffff;\n      border-radius: 999px;\n      background: rgba(0, 0, 0, 0.22);\n      color: #ffffff;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      position: absolute;\n      top: 132px;\n      z-index: 5;\n      cursor: pointer;\n      backdrop-filter: blur(2px);\n      touch-action: manipulation;\n    }\n\n    .hn-predator-shop__nav svg {\n      width: 22px;\n      height: 22px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 2;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    .hn-predator-shop__nav--prev {\n      left: 10px;\n    }\n\n    .hn-predator-shop__nav--next {\n      right: 10px;\n    }\n\n    .hn-predator-shop__nav.is-disabled {\n      opacity: 0.28;\n      pointer-events: none;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-predator-shop__inner {\n      padding: 0 16px;\n    }\n\n    .hn-predator-shop__grid {\n      padding-right: 54px;\n    }\n\n    .hn-predator-shop__card {\n      flex-basis: calc(100vw - 110px);\n      width: calc(100vw - 110px);\n      max-width: 326px;\n      min-height: 772px;\n    }\n\n    .hn-predator-shop__image {\n      height: 260px;\n    }\n\n    .hn-predator-shop__title {\n      font-size: 18px;\n    }\n\n    .hn-predator-shop__price {\n      font-size: 18px;\n      margin-bottom: 27px;\n    }\n\n    .hn-predator-shop__icon,\n    .hn-predator-shop__icon svg {\n      width: 20px;\n      height: 20px;\n      flex-basis: 20px;\n    }\n\n    .hn-predator-shop__nav {\n      top: 124px;\n    }\n  }\n<style>\n  /* ONLY FIXES: remove Best For rows + equal card height */\n\n  .hn-predator-shop__grid {\n    align-items: stretch !important;\n  }\n\n  .hn-predator-shop__card {\n    height: 100% !important;\n    min-height: 820px !important;\n  }\n\n  .hn-predator-shop__content {\n    height: 100% !important;\n  }\n\n  .hn-predator-shop__features {\n    min-height: 150px !important;\n  }\n\n  .hn-predator-shop__desc {\n    min-height: 130px !important;\n  }\n\n  .hn-predator-shop__button {\n    margin-top: auto !important;\n  }\n\n  @media screen and (max-width: 1280px) {\n    .hn-predator-shop__card {\n      min-height: 800px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 140px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 125px !important;\n    }\n  }\n\n  @media screen and (max-width: 990px) {\n    .hn-predator-shop__card {\n      min-height: 740px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 132px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 118px !important;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .hn-predator-shop__card {\n      min-height: 730px !important;\n    }\n\n    .hn-predator-shop__features {\n      min-height: 128px !important;\n    }\n\n    .hn-predator-shop__desc {\n      min-height: 112px !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function removeBestForRows() {\n      document.querySelectorAll('.hn-predator-shop__features li').forEach(function (item) {\n        var text = item.textContent.trim().toLowerCase();\n\n        if (\n          text.includes('best for serious attackers') ||\n          text.includes('best for full attack players') ||\n          text.includes('best for sweet spot') ||\n          text.includes('best for first upgrade')\n        ) {\n          item.remove();\n        }\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', removeBestForRows);\n    } else {\n      removeBestForRows();\n    }\n\n    document.addEventListener('shopify:section:load', removeBestForRows);\n  })();\n</script>\n</style>\n\n<script>\n  (function() {\n    function initPredatorShop(root) {\n      if (!root || root.dataset.predatorShopReady === 'true') return;\n\n      var track = root.querySelector('[data-predator-track]');\n      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-product-card]'));\n      var prev = root.querySelector('[data-predator-prev]');\n      var next = root.querySelector('[data-predator-next]');\n\n      if (!track || !cards.length) return;\n\n      root.dataset.predatorShopReady = 'true';\n\n      function activeIndex() {\n        var trackLeft = track.getBoundingClientRect().left;\n        var closestIndex = 0;\n        var closestDistance = Infinity;\n\n        cards.forEach(function(card, index) {\n          var distance = Math.abs(card.getBoundingClientRect().left - trackLeft);\n\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closestIndex = index;\n          }\n        });\n\n        return closestIndex;\n      }\n\n      function updateNav(index) {\n        var current = typeof index === 'number' ? index : activeIndex();\n\n        if (prev) prev.classList.toggle('is-disabled', current <= 0);\n        if (next) next.classList.toggle('is-disabled', current >= cards.length - 1);\n      }\n\n      function scrollToIndex(index) {\n        if (!cards[index]) return;\n\n        var scrollLeft = cards[index].offsetLeft;\n\n        if ('requestAnimationFrame' in window) {\n          requestAnimationFrame(function() {\n            track.scrollTo({\n              left: scrollLeft,\n              behavior: 'smooth'\n            });\n          });\n        } else {\n          track.scrollLeft = scrollLeft;\n        }\n\n        updateNav(index);\n      }\n\n      var scrollTimer;\n\n      track.addEventListener('scroll', function() {\n        window.clearTimeout(scrollTimer);\n        scrollTimer = window.setTimeout(function() {\n          updateNav();\n        }, 80);\n      }, { passive: true });\n\n      if (prev) {\n        prev.addEventListener('click', function() {\n          scrollToIndex(Math.max(activeIndex() - 1, 0));\n        });\n      }\n\n      if (next) {\n        next.addEventListener('click', function() {\n          scrollToIndex(Math.min(activeIndex() + 1, cards.length - 1));\n        });\n      }\n\n      window.addEventListener('resize', function() {\n        updateNav();\n      }, { passive: true });\n\n      updateNav(0);\n    }\n\n    function initAllPredatorShopSections() {\n      document.querySelectorAll('[data-hn-predator-shop]').forEach(initPredatorShop);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAllPredatorShopSections);\n    } else {\n      initAllPredatorShopSections();\n    }\n\n    document.addEventListener('shopify:section:load', initAllPredatorShopSections);\n  })();\n</script>",
