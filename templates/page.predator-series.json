padding: 40px 0 54px;\n    }\n\n    .hn-predator-rally__inner {\n      padding: 0 14px;\n    }\n\n    .hn-predator-rally__heading-wrap {\n      margin-bottom: 22px;\n    }\n\n    .hn-predator-rally__headline {\n      font-size: clamp(30px, 8.6vw, 42px);\n    }\n\n    .hn-predator-rally__content-wrap {\n      padding: 26px 18px;\n    }\n\n    .hn-predator-rally__body,\n    .hn-predator-rally__point {\n      font-size: 14.5px;\n    }\n\n    .hn-predator-rally__trust-row {\n      gap: 12px;\n    }\n\n    .hn-predator-rally__stars {\n      font-size: 15px;\n      letter-spacing: 0.8px;\n    }\n\n    .hn-predator-rally__rating-text {\n      font-size: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hn-tech-marquee__track {\n      animation-duration: 80s;\n    }\n  }\n/* CTA GRADIENT BUTTON FIX */\n\n.hn-predator-rally__cta {\n  border: 2px solid transparent !important;\n  background:\n    linear-gradient(#000000, #000000) padding-box,\n    linear-gradient(\n      90deg,\n      #008a36 0%,\n      #008a36 30%,\n      #3f8724 42%,\n      #8c7214 52%,\n      #d85f07 66%,\n      #ff5c00 100%\n    ) border-box !important;\n\n  color: #ffffff !important;\n  box-shadow:\n    0 0 16px rgba(255, 92, 0, 0.18),\n    0 0 14px rgba(0, 138, 54, 0.12) !important;\n}\n\n.hn-predator-rally__cta:hover {\n  background:\n    linear-gradient(#000000, #000000) padding-box,\n    linear-gradient(\n      90deg,\n      #008a36 0%,\n      #008a36 30%,\n      #3f8724 42%,\n      #8c7214 52%,\n      #d85f07 66%,\n      #ff5c00 100%\n    ) border-box !important;\n\n  color: #ffffff !important;\n  transform: translateY(-2px) !important;\n  box-shadow:\n    0 0 24px rgba(255, 92, 0, 0.34),\n    0 0 18px rgba(0, 138, 54, 0.22) !important;\n}\n/* MARQUEE ROUNDED END FIX */\n\n.hn-tech-marquee {\n  border: 1.5px solid #d7d7d7 !important;\n  border-radius: 999px !important;\n  overflow: hidden !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  width: min