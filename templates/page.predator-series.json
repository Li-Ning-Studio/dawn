      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% liquid\n  assign carousel_heading = 'Every Detail'\n  assign carousel_label = ''\n  assign image_1 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_2_f87545fd-9d65-4109-a85d-96afb17d1fe1.jpg?v=1791353945'\n  assign title_1 = 'Vapor Shaft Technology'\n  assign description_1 = 'An aerodynamic shaft optimized for speed, torque resistance and flex delivers maximum attacking power.'\n  assign image_2 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_1_fe253be9-797d-4c89-8c98-a9a667f15644.jpg?v=1791353945'\n  assign title_2 = 'Japanese Graphite Carbon'\n  assign description_2 ='Made from premium Japanese graphite carbon for an ultra-light yet strong frame that handles tensions up to 38 lbs.'\n  assign image_3 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/A_3_2d0af395-06cc-4efe-b740-2fa4887d68e2.jpg?v=1791353945'\n  assign title_3 = 'Curve² Sweet Spot'\n  assign description_3 = 'Hundred’s patented Curve² technology creates an extra-large sweet spot for forgiveness and precision on off-center hits.'\n%}\n<aplus-scroll class=\"aplus-scroll\" role=\"region\" aria-label=\"{{ carousel_heading | escape }}\">\n  <div class=\"aplus-scroll__header\">\n    <div><p class=\"aplus-scroll__eyebrow\">{{ carousel_label | escape }}</p><h2>{{ carousel_heading | escape }}</h2></div>\n    <div class=\"aplus-scroll__arrows\" hidden>\n      <button type=\"button\" data-step=\"-1\" aria-label=\"Previous slide\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 6-6 6 6 6M8 12h12\"/></svg></button>\n      <button type=\"button\" data-step=\"1\" aria-label=\"Next slide\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m10 6 6 6-6 6M16 12H4\"/></svg></button>\n    </div>\n  </div>\n  <div class=\"aplus-scroll__track\" tabindex=\"0\" role=\"group\" aria-label=\"Product feature slides\">\n    {% for i in (1..3) %}\n      {% liquid\n        case i\n          when 1\n            assign slide_image = image_1\n            assign slide_title = title_1\n            assign slide_description = description_1\n          when 2\n            assign slide_image = image_2\n            assign slide_title = title_2\n            assign slide_description = description_2\n          when 3\n            assign slide_image = image_3\n            assign slide_title = title_3\n            assign slide_description = description_3\n        endcase\n      %}\n      <article class=\"aplus-scroll__slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"{{ i }} of 3\">\n        <div class=\"aplus-scroll__media\">\n          {% if slide_image != blank %}\n            <img src=\"{{ slide_image | escape }}\" alt=\"{{ slide_title | escape }}\" width=\"1200\" height=\"1560\" loading=\"lazy\" decoding=\"async\">\n          {% else %}\n            <div class=\"aplus-scroll__placeholder\"><small>Add your feature image</small></div>\n          {% endif %}\n        </div>\n        <div class=\"aplus-scroll__copy\"><div><h3>{{ slide_title | escape }}</h3><p>{{ slide_description | escape | newline_to_br }}</p></div></div>\n      </article>\n    {% endfor %}\n  </div>\n  <div class=\"aplus-scroll__footer\"><span>SCROLL TO EXPLORE</span><div class=\"aplus-scroll__dots\" hidden>{% for i in (1..3) %}<button type=\"button\" data-index=\"{{ forloop.index0 }}\" aria-label=\"Go to slide {{ i }}\" {% if forloop.first %}aria-current=\"true\"{% endif %}></button>{% endfor %}</div></div>\n</aplus-scroll>\n<style>\n  .aplus-scroll{--aplus-inset:clamp(20px,5vw,88px);display:block;background:#080808;color:#f5f3ef;padding:clamp(36px,6vw,80px) 0;overflow:hidden;text-align:left;font-family:inherit;color-scheme:dark}\n  .aplus-scroll *{box-sizing:border-box}\n  .aplus-scroll [hidden]{display:none!important}\n  .aplus-scroll__header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:0 var(--aplus-inset);margin-bottom:32px}\n  .aplus-scroll__eyebrow{color:#aaa79f;font-size:11px;letter-spacing:.2em;margin:0 0 14px;line-height:1.5}\n  .aplus-scroll h2{color:inherit;font:inherit;font-size:clamp(30px,4vw,54px);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:0}\n  .aplus-scroll__arrows{display:flex;gap:10px}\n  .aplus-scroll button{appearance:none;cursor:pointer;touch-action:manipulation}\n  .aplus-scroll__arrows button{display:grid;place-items:center;width:48px;height:48px;border:1px solid #55534f;border-radius:50%;background:transparent;color:inherit;padding:0;transition:background .2s,opacity .2s}\n  .aplus-scroll__arrows button:hover{background:#282724}\n  .aplus-scroll__arrows button:disabled{opacity:.3;cursor:default}\n  .aplus-scroll__arrows svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.3}\n  .aplus-scroll__track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--aplus-inset);padding:0 var(--aplus-inset) 14px;scrollbar-width:thin;scrollbar-color:#6b675e #20201d;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}\n  .aplus-scroll__slide{flex:0 0 44%;min-width:0;scroll-snap-align:start}\n  .aplus-scroll__track::after{content:\"\";flex:0 0 calc(56% - 24px)}\n  .aplus-scroll__media{aspect-ratio:10/13;overflow:hidden;border-radius:18px;background:#151513}\n  .aplus-scroll__media img{display:block;width:100%;height:100%;object-fit:cover}\n  .aplus-scroll__placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:radial-gradient(ellipse at 50% 100%,#373329 0%,#151513 65%);color:#c2bcaf}\n  .aplus-scroll__placeholder small{font-size:12px;letter-spacing:.08em}\n  .aplus-scroll__copy{display:flex;align-items:baseline;gap:24px;padding:24px 0 12px}\n  .aplus-scroll h3{font:inherit;font-size:clamp(22px,2.5vw,32px);font-weight:500;line-height:1.2;letter-spacing:-.025em;color:inherit;margin:0 0 12px}\n  .aplus-scroll__copy p{font-size:15px;line-height:1.75;color:#b7b5af;margin:0;max-width:650px;overflow-wrap:anywhere}\n  .aplus-scroll__footer{margin:22px var(--aplus-inset) 0;display:flex;align-items:center;justify-content:space-between;gap:14px;color:#b7b5af;font-size:10px;letter-spacing:.12em}\n  .aplus-scroll__dots{display:flex;gap:4px}\n  .aplus-scroll__dots button{position:relative;width:44px;height:44px;border:0;background:transparent;padding:0}\n  .aplus-scroll__dots button::after{content:\"\";position:absolute;left:8px;right:8px;top:21px;height:2px;background:#55534f;transition:background .2s}\n  .aplus-scroll__dots button[aria-current=\"true\"]::after{background:#f5f3ef}\n  .aplus-scroll :focus-visible{outline:2px solid #f5f3ef;outline-offset:-3px}\n  @media(max-width:749px){.aplus-scroll__header{margin-bottom:24px}.aplus-scroll__track{gap:16px}.aplus-scroll__slide{flex-basis:90%}.aplus-scroll__track::after{flex-basis:calc(10% - 16px)}.aplus-scroll__copy{gap:14px;padding-top:20px}.aplus-scroll__arrows{gap:6px}.aplus-scroll__arrows button{width:44px;height:44px}.aplus-scroll__copy p{font-size:14px}.aplus-scroll__footer{letter-spacing:.04em}.aplus-scroll__dots{gap:0}}\n  @media(prefers-reduced-motion:reduce){.aplus-scroll *{transition:none!important;scroll-behavior:auto!important}}\n</style>\n<script>\nif(!customElements.get('aplus-scroll')){\n  customElements.define('aplus-scroll',class extends HTMLElement{\n    connectedCallback(){\n      if(this.cleanup)return;\n      const track=this.querySelector('.aplus-scroll__track');\n      if(!track)return;\n      const slides=Array.from(this.querySelectorAll('.aplus-scroll__slide'));\n      const dots=Array.from(this.querySelectorAll('[data-index]'));\n      const previous=this.querySelector('[data-step=\"-1\"]');\n      const next=this.querySelector('[data-step=\"1\"]');\n      let active=0,frame=0;\n      const go=index=>{\n        index=Math.max(0,Math.min(slides.length-1,index));\n        const inset=parseFloat(getComputedStyle(track).paddingLeft);\n        const delta=slides[index].getBoundingClientRect().left-track.getBoundingClientRect().left-inset;\n        track.scrollBy({left:delta,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});\n      };\n      const update=()=>{\n        const start=track.getBoundingClientRect().left+parseFloat(getComputedStyle(track).paddingLeft);\n        active=slides.reduce((best,slide,i)=>Math.abs(slide.getBoundingClientRect().left-start)<Math.abs(slides[best].getBoundingClientRect().left-start)?i:best,0);\n        dots.forEach((dot,i)=>i===active?dot.setAttribute('aria-current','true'):dot.removeAttribute('aria-current'));\n        previous.disabled=active===0;next.disabled=active===slides.length-1;\n      };\n      const onScroll=()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(update)};\n      const onClick=e=>{const button=e.target.closest('button');if(!button)return;if(button.hasAttribute('data-index'))go(Number(button.dataset.index));if(button.hasAttribute('data-step'))go(active+Number(button.dataset.step))};\n      const onKey=e=>{if(e.target!==track)return;const targets={ArrowRight:active+1,ArrowLeft:active-1,Home:0,End:slides.length-1};if(e.key in targets){e.preventDefault();go(targets[e.key])}};\n      track.addEventListener('scroll',onScroll,{passive:true});this.addEventListener('click',onClick);track.addEventListener('keydown',onKey);\n      const observer=new ResizeObserver(onScroll);observer.observe(track);\n      this.querySelector('.aplus-scroll__arrows').hidden=false;this.querySelector('.aplus-scroll__dots').hidden=false;\n      update();\n      this.cleanup=()=>{cancelAnimationFrame(frame);observer.disconnect();track.removeEventListener('scroll',onScroll);this.removeEventListener('click',onClick);track.removeEventListener('keydown',onKey)};\n    }\n    disconnectedCallback(){if(this.cleanup){this.cleanup();this.cleanup=null}}\n  });\n}\n</script>",
