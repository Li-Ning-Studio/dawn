    padding: 56px 18px 62px;\n    }\n\n    .hn-predator-trust__heading {\n      max-width: 560px;\n      font-size: clamp(34px, 10vw, 52px);\n      line-height: 1.08;\n      letter-spacing: -0.06em;\n    }\n\n    .hn-predator-trust__copy {\n      max-width: 520px;\n      margin-top: 26px;\n      font-size: clamp(18px, 5.3vw, 25px);\n      line-height: 1.42;\n      letter-spacing: -0.045em;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .hn-predator-trust {\n      padding: 48px 16px 54px;\n    }\n\n    .hn-predator-trust__heading {\n      font-size: clamp(31px, 9.4vw, 40px);\n      letter-spacing: -0.055em;\n    }\n\n    .hn-predator-trust__copy {\n      font-size: clamp(17px, 5vw, 21px);\n      line-height: 1.45;\n    }\n  }\n</style>",
