    "collapsible_content_cd6RAe": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_gtA3yR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes the Predator different from other rackets?",
            "icon": "question_mark",
            "row_content": "<p>Every Predator is built with Japan Made Graphite, Vapour Shaft technology, and head heavy balance, engineered specifically for attacking players who want more speed, more power, and more control from every swing.</p>",
            "page": ""
          }
        },
        "collapsible_row_bFEgaH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which Predator is right for my level?",
            "icon": "question_mark",
            "row_content": "<p><br/>The 79 and 82 Extra Strong are built for intermediate players stepping up their game. The 82 and 84 Extreme are for advanced players who attack first and defend later.</p>",
            "page": ""
          }
        },
        "collapsible_row_8HhiYb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I customise my racket's string tension?",
            "icon": "question_mark",
            "row_content": "<p><br/>Yes, use our Hundred Pro Stringing service at checkout to choose your preferred string and tension, recommended for optimal performance based on your playing style.</p>",
            "page": ""
          }
        },
        "collapsible_row_BerD6Q": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is Vapour Shaft Technology?",
            "icon": "question_mark",
            "row_content": "<p><br/>Vapour Shaft is our engineered flex system that loads energy during your backswing and releases it at the exact point of impact giving you more shuttle speed without swinging harder.</p>",
            "page": ""
          }
        },
        "collapsible_row_qCJbM4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How fast will I receive my order?",
            "icon": "question_mark",
            "row_content": "<p><br/>Express Shipping across India. Order now and get playing within the week wherever you are.</p>",
            "page": ""
          }
        },
        "collapsible_row_Fzd9bq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is EMI available?",
            "icon": "question_mark",
            "row_content": "<p>Yes, pay a small amount now and split the rest into 3 easy instalments via HNDRD Pay Later, powered by Snapmint. Zero interest, zero hassle.</p>",
            "page": ""
          }
        }
      },
