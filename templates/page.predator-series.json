ce;\n  color: #dbe6c5;\n}\n@supports ((background-clip: text) or (-webkit-background-clip: text)) {\n  .hn-pastel-hero .hn-pastel-hero__heading {\n    background-image: var(--hn-pastel);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n}\n.hn-pastel-hero .hn-pastel-hero__description {\n  max-width: 780px;\n  margin: 24px auto 0;\n  font-family: inherit;\n  font-size: clamp(15px, 1.35vw, 18px);\n  font-weight: 400;\n  line-height: 1.75;\n  letter-spacing: 0;\n  color: #aaa9a6;\n  text-wrap: pretty;\n}\n.hn-pastel-hero .hn-pastel-hero__button {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 54px;\n  max-width: 100%;\n  margin-top: 38px;\n  padding: 16px 36px;\n  border: 1px solid transparent;\n  border-radius: 100px;\n  background: linear-gradient(#050505, #050505) padding-box, var(--hn-pastel) border-box;\n  color: #f6f5f2;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .12em;\n  line-height: 1.5;\n  text-decoration: none;\n  transition: transform .2s ease, box-shadow .2s ease;\n}\n.hn-pastel-hero a.hn-pastel-hero__button:hover {\n  color: #fff;\n  transform: translateY(-2px);\n  box-shadow: 0 5px 25px rgb(188 216 245 / 10%);\n}\n.hn-pastel-hero a.hn-pastel-hero__button:focus-visible { outline: 2px solid #bcd8f5; outline-offset: 5px; }\n@media (max-width: 600px) {\n  .hn-pastel-hero { padding: 72px 22px; }\n  .hn-pastel-hero .hn-pastel-hero__eyebrow { font-size: 12px; margin-bottom: 20px; }\n  .hn-pastel-hero .hn-pastel-hero__heading { font-size: clamp(38px, 10.5vw, 60px); line-height: 1.12; }\n  .hn-pastel-hero .hn-pastel-hero__description { margin-top: 20px; max-width: 360px; }\n  .hn-pastel-hero .hn-pastel-hero__button { margin-top: 28px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .hn-pastel-hero .hn-pastel-hero__button { transition: none; }\n  .hn-pastel-hero a.hn-pastel-hero__button:hover { transform: none; }\n}\n</style>",
