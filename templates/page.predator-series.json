    "custom_liquid_rXPfaY": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% liquid\n  assign carousel_heading = 'Power Within.'\n  assign carousel_label = ''\n  assign image_1 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_1_998a3f2d-5530-4285-95d3-49ca40540b2c.jpg?v=1791353982'\n  assign title_1 = 'Vaporshaft 7.0mm'\n  assign description_1 = 'A whip-like 7.0mm Vaporshaft stores energy on the backswing and releases it with a powerful snap for attacking shots.'\n  assign image_2 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_2_fdb1828f-c498-4368-bce7-e904e80a7f05.jpg?v=1791353983'\n  assign title_2 = 'Nano Frame System'\n  assign description_2 = 'Predator 84’s aerodynamic Nano Frame System delivers faster swings, sharper attacks, and rock-solid stability.'\n  assign image_3 = 'https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Artboard_3_f2b5dc60-781e-4295-9404-e18b9905ac1f.jpg?v=1791353983'\n  assign title_3 = 'Japan Made Graphite'\n  assign description_3 = 'High-quality graphite from Graphite Lab delivers durability, impact absorption, and strong tension retention.'\n%}\n<aplus-landscape-v2 class=\"aplus-landscape-v2\" role=\"region\" aria-label=\"{{ carousel_heading | escape }}\">\n  <div class=\"aplus-landscape-v2__header\">\n    <div><p class=\"aplus-landscape-v2__eyebrow\">{{ carousel_label | escape }}</p><h2>{{ carousel_heading | escape }}</h2></div>\n    <div class=\"aplus-landscape-v2__arrows\" hidden>\n      <button type=\"button\" data-step=\"-1\" aria-label=\"Previous slide\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 6-6 6 6 6M8 12h12\"/></svg></button>\n      <button type=\"button\" data-step=\"1\" aria-label=\"Next slide\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m10 6 6 6-6 6M16 12H4\"/></svg></button>\n    </div>\n  </div>\n  <div class=\"aplus-landscape-v2__track\" tabindex=\"0\" role=\"group\" aria-label=\"Product feature slides\">\n    {% for i in (1..3) %}\n      {% liquid\n        case i\n          when 1\n            assign slide_image = image_1\n            assign slide_title = title_1\n            assign slide_description = description_1\n          when 2\n            assign slide_image = image_2\n            assign slide_title = title_2\n            assign slide_description = description_2\n          when 3\n            assign slide_image = image_3\n            assign slide_title = title_3\n            assign slide_description = description_3\n        endcase\n      %}\n      <article class=\"aplus-landscape-v2__slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"{{ slide_title | escape }}\">\n        <div class=\"aplus-landscape-v2__media\">\n          {% if slide_image != blank %}\n            <img src=\"{{ slide_image | escape }}\" alt=\"{{ slide_title | escape }}\" width=\"1600\" height=\"1000\" loading=\"lazy\" decoding=\"async\">\n          {% else %}\n            <div class=\"aplus-landscape-v2__placeholder\"><small>Add your feature image</small></div>\n          {% endif %}\n        </div>\n        <div class=\"aplus-landscape-v2__copy\"><div><h3>{{ slide_title | escape }}</h3><p>{{ slide_description | escape | newline_to_br }}</p></div></div>\n      </article>\n    {% endfor %}\n  </div>\n  <div class=\"aplus-landscape-v2__footer\"><span>SCROLL TO EXPLORE</span><div class=\"aplus-landscape-v2__dots\" hidden>{% for i in (1..3) %}<button type=\"button\" data-index=\"{{ forloop.index0 }}\" aria-label=\"{% case i %}{% when 1 %}{{ title_1 | escape }}{% when 2 %}{{ title_2 | escape }}{% when 3 %}{{ title_3 | escape }}{% endcase %}\" {% if forloop.first %}aria-current=\"true\"{% endif %}></button>{% endfor %}</div></div>\n</aplus-landscape-v2>\n<style>\n  .aplus-landscape-v2{--aplus-inset:clamp(20px,5vw,88px);display:block;background:#080808;color:#f5f3ef;padding:clamp(36px,6vw,80px) 0;overflow:hidden;text-align:left;font-family:inherit;color-scheme:dark}\n  .aplus-landscape-v2 *{box-sizing:border-box}\n  .aplus-landscape-v2 [hidden]{display:none!important}\n  .aplus-landscape-v2__header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:0 var(--aplus-inset);margin-bottom:32px}\n  .aplus-landscape-v2__eyebrow{color:#aaa79f;font-size:11px;letter-spacing:.2em;margin:0 0 14px;line-height:1.5}\n  .aplus-landscape-v2 h2{color:inherit;font:inherit;font-size:clamp(30px,4vw,54px);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:0}\n  .aplus-landscape-v2__arrows{display:flex;gap:10px}\n  .aplus-landscape-v2 button{appearance:none;cursor:pointer;touch-action:manipulation}\n  .aplus-landscape-v2__arrows button{display:grid;place-items:center;width:48px;height:48px;border:1px solid #55534f;border-radius:50%;background:transparent;color:inherit;padding:0;transition:background .2s,opacity .2s}\n  .aplus-landscape-v2__arrows button:hover{background:#282724}\n  .aplus-landscape-v2__arrows button:disabled{opacity:.3;cursor:default}\n  .aplus-landscape-v2__arrows svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.3}\n  .aplus-landscape-v2__track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--aplus-inset);padding:0 var(--aplus-inset) 14px;scrollbar-width:thin;scrollbar-color:#6b675e #20201d;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}\n  .aplus-landscape-v2__slide{flex:0 0 76%;min-width:0;scroll-snap-align:start}\n  .aplus-landscape-v2__track::after{content:\"\";flex:0 0 calc(24% - 24px)}\n  .aplus-landscape-v2__media{width:100%;height:auto;aspect-ratio:16/10!important;overflow:hidden;border-radius:20px;background:#151513}\n  .aplus-landscape-v2__media img{display:block;width:100%;height:100%;max-height:none;object-fit:cover}\n  .aplus-landscape-v2__placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:radial-gradient(ellipse at 50% 100%,#373329 0%,#151513 65%);color:#c2bcaf}\n  .aplus-landscape-v2__placeholder small{font-size:12px;letter-spacing:.08em}\n  .aplus-landscape-v2__copy{display:flex;align-items:baseline;gap:24px;padding:24px 0 12px}\n  .aplus-landscape-v2 h3{font:inherit;font-size:clamp(22px,2.5vw,32px);font-weight:500;line-height:1.2;letter-spacing:-.025em;color:inherit;margin:0 0 12px}\n  .aplus-landscape-v2__copy p{font-size:15px;line-height:1.75;color:#b7b5af;margin:0;max-width:650px;overflow-wrap:anywhere}\n  .aplus-landscape-v2__footer{margin:22px var(--aplus-inset) 0;display:flex;align-items:center;justify-content:space-between;gap:14px;color:#b7b5af;font-size:10px;letter-spacing:.12em}\n  .aplus-landscape-v2__dots{display:flex;gap:4px}\n  .aplus-landscape-v2__dots button{position:relative;width:44px;height:44px;border:0;background:transparent;padding:0}\n  .aplus-landscape-v2__dots button::after{content:\"\";position:absolute;left:8px;right:8px;top:21px;height:2px;background:#55534f;transition:background .2s}\n  .aplus-landscape-v2__dots button[aria-current=\"true\"]::after{background:#f5f3ef}\n  .aplus-landscape-v2 :focus-visible{outline:2px solid #f5f3ef;outline-offset:-3px}\n  @media(max-width:749px){.aplus-landscape-v2__header{margin-bottom:24px}.aplus-landscape-v2__track{gap:16px}.aplus-landscape-v2__slide{flex-basis:90%}.aplus-landscape-v2__track::after{flex-basis:calc(10% - 16px)}.aplus-landscape-v2__copy{gap:14px;padding-top:20px}.aplus-landscape-v2__arrows{gap:6px}.aplus-landscape-v2__arrows button{width:44px;height:44px}.aplus-landscape-v2__copy p{font-size:14px}.aplus-landscape-v2__footer{letter-spacing:.04em}.aplus-landscape-v2__dots{gap:0}}\n  @media(prefers-reduced-motion:reduce){.aplus-landscape-v2 *{transition:none!important;scroll-behavior:auto!important}}\n</style>\n<script>\nif(!customElements.get('aplus-landscape-v2')){\n  customElements.define('aplus-landscape-v2',class extends HTMLElement{\n    connectedCallback(){\n      if(this.cleanup)return;\n      const track=this.querySelector('.aplus-landscape-v2__track');\n      if(!track)return;\n      const slides=Array.from(this.querySelectorAll('.aplus-landscape-v2__slide'));\n      const dots=Array.from(this.querySelectorAll('[data-index]'));\n      const previous=this.querySelector('[data-step=\"-1\"]');\n      const next=this.querySelector('[data-step=\"1\"]');\n      let active=0,frame=0;\n      const go=index=>{\n        index=Math.max(0,Math.min(slides.length-1,index));\n        const inset=parseFloat(getComputedStyle(track).paddingLeft);\n        const delta=slides[index].getBoundingClientRect().left-track.getBoundingClientRect().left-inset;\n        track.scrollBy({left:delta,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});\n      };\n      const update=()=>{\n        const start=track.getBoundingClientRect().left+parseFloat(getComputedStyle(track).paddingLeft);\n        active=slides.reduce((best,slide,i)=>Math.abs(slide.getBoundingClientRect().left-start)<Math.abs(slides[best].getBoundingClientRect().left-start)?i:best,0);\n        dots.forEach((dot,i)=>i===active?dot.setAttribute('aria-current','true'):dot.removeAttribute('aria-current'));\n        previous.disabled=active===0;next.disabled=active===slides.length-1;\n      };\n      const onScroll=()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(update)};\n      const onClick=e=>{const button=e.target.closest('button');if(!button)return;if(button.hasAttribute('data-index'))go(Number(button.dataset.index));if(button.hasAttribute('data-step'))go(active+Number(button.dataset.step))};\n      const onKey=e=>{if(e.target!==track)return;const targets={ArrowRight:active+1,ArrowLeft:active-1,Home:0,End:slides.length-1};if(e.key in targets){e.preventDefault();go(targets[e.key])}};\n      track.addEventListener('scroll',onScroll,{passive:true});this.addEventListener('click',onClick);track.addEventListener('keydown',onKey);\n      const observer=new ResizeObserver(onScroll);observer.observe(track);\n      this.querySelector('.aplus-landscape-v2__arrows').hidden=false;this.querySelector('.aplus-landscape-v2__dots').hidden=false;\n      update();\n      this.cleanup=()=>{cancelAnimationFrame(frame);observer.disconnect();track.removeEventListener('scroll',onScroll);this.removeEventListener('click',onClick);track.removeEventListener('keydown',onKey)};\n    }\n    disconnectedCallback(){if(this.cleanup){this.cleanup();this.cleanup=null}}\n  });\n}\n</script>",
        "color_scheme": "scheme-4",
