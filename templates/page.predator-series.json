ar(--font-heading-family, inherit);\n  font-size: clamp(42px, 6.2vw, 88px);\n  font-weight: 750;\n  line-height: 1.08;\n  letter-spacing: -.045em;\n  text-transform: none;\n  text-wrap: balance;\n  color: #9ae65c;\n}\n\n@supports ((background-clip: text) or (-webkit-background-clip: text)) {\n  .hn-predator-green .hn-predator-green__heading {\n    background-image: var(--hn-green);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: transparent;\n  }\n}\n\n.hn-predator-green .hn-predator-green__description {\n  max-width: 780px;\n  margin: 24px auto 0;\n  font-family: inherit;\n  font-size: clamp(15px, 1.35vw, 18px);\n  font-weight: 400;\n  line-height: 1.75;\n  letter-spacing: 0;\n  color: #aaa9a6;\n  text-wrap: pretty;\n}\n\n.hn-predator-green .hn-predator-green__button {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 54px;\n  max-width: 100%;\n  margin-top: 38px;\n  padding: 16px 36px;\n  border: 1px solid transparent;\n  border-radius: 100px;\n  background:\n    linear-gradient(#050505, #050505) padding-box,\n    var(--hn-green) border-box;\n  color: #f6f5f2;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .12em;\n  line-height: 1.5;\n  text-decoration: none;\n  transition: transform .2s ease, box-shadow .2s ease;\n}\n\n.hn-predator-green a.hn-predator-green__button:hover {\n  color: #fff;\n  transform: translateY(-2px);\n  box-shadow: 0 5px 25px rgb(110 211 42 / 16%);\n}\n\n.hn-predator-green a.hn-predator-green__button:focus-visible {\n  outline: 2px solid #9ae65c;\n  outline-offset: 5px;\n}\n\n@media (max-width: 600px) {\n  .hn-predator-green {\n    padding: 72px 22px;\n  }\n\n  .hn-predator-green .hn-predator-green__eyebrow {\n    font-size: 12px;\n    margin-bottom: 20px;\n  }\n\n  .hn-predator-green .hn-predator-green__heading {\n    font-size: clamp(38px, 10.5vw, 60px);\n    line-height: 1.12;\n  }\n\n  .hn-predator-green .hn-predator-green__description {\n    margin-top: 20px;\n    max-width: 360px;\n  }\n\n  .hn-predator-green .hn-predator-green__button {\n    margin-top: 28px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-predator-green .hn-predator-green__button {\n    transition: none;\n  }\n\n  .hn-predator-green a.hn-predator-green__button:hover {\n    transform: none;\n  }\n}\n</style>",
