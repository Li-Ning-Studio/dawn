    "custom_liquid_Q7yc9E": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- HNDRD PREDATOR - PRODUCT COMPARISON / REDIRECT BUTTON SECTION -->\n<section class=\"hn-predator-shop\" data-hn-predator-shop aria-label=\"Predator product comparison\">\n  <div class=\"hn-predator-shop__inner\">\n\n    <div class=\"hn-predator-shop__carousel-wrap\">\n\n      <button class=\"hn-predator-shop__nav hn-predator-shop__nav--prev\" type=\"button\" aria-label=\"Previous product\" data-predator-prev>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M15 5 8 12l7 7\"></path>\n        </svg>\n      </button>\n\n      <div class=\"hn-predator-shop__grid\" data-predator-track>\n\n        <!-- CARD 1 - 84 EXTREME -->\n        <article class=\"hn-predator-shop__card\" data-product-card>\n          <a class=\"hn-predator-shop__image-link\" href=\"https://in.hndrd.co/products/predator-84-extreme\" aria-label=\"View Predator 84 Extreme\">\n            <img\n              class=\"hn-predator-shop__image\"\n              src=\"https://cdn.shopify.com/s/files/1/0933/9378/1029/files/Template-01_b765cb55-1b33-45f4-b848-9bd0e0aa57da.png?v=1782888944\"\n              alt=\"Predator 84 Extreme badminton racket\"\n              loading=\"lazy\"\n              width=\"500\"\n              height=\"500\"\n            >\n          </a>\n\n          <div class=\"hn-predator-shop__content\">\n            <h3 class=\"hn-predator-shop__title\">Predator 84 Extreme</h3>\n            <p class=\"hn-predator-shop__price\">₹3,449</p>\n\n            <ul class=\"hn-predator-shop__features\" role=\"list\">\n              <li>\n                <span class=\"hn-predator-shop__icon hn-predator-shop__icon--orange hn-predator-shop__icon--line\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 24 24\">\n                    <path d=\"M4 9v6\"></path>\n                    <path d=\"M7 6v12\"></path>\n                    <path d=\"M10 9v6\"></path>\n                    <path d=\"M14 9v6\"></path>\n                    <path d=\"M17