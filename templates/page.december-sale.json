      "settings": {
        "custom_liquid": "{% comment %}\n  Li-Ning Summer Sale Category Grid - Clean Image-Only Version\n  Maps to image cards: 2.1.jpg, 2.2.jpg, 2.3.jpg\n{% endcomment %}\n\n<div class=\"lining-summer-categories\" id=\"section-summer-sale\">\n  <div class=\"lining-container\">\n    <div class=\"category-grid\">\n      \n      <!-- Card 1: Rackets -->\n      <a href=\"/collections/summer-sale-rackets\" class=\"category-card\" aria-label=\"Shop Rackets\">\n        <div class=\"image-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/2.1.jpg?v=1781843190&width=750\" onerror=\"this.onerror=null; this.src='2.1.jpg';\" alt=\"Rackets Sale\" loading=\"lazy\">\n        </div>\n      </a>\n\n      <!-- Card 2: Shoes -->\n      <a href=\"/collections/summer-sale-shoes\" class=\"category-card\" aria-label=\"Shop Shoes\">\n        <div class=\"image-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/2.2.jpg?v=1781843190&width=750\" onerror=\"this.onerror=null; this.src='2.2.jpg';\" alt=\"Shoes Sale\" loading=\"lazy\">\n        </div>\n      </a>\n\n      <!-- Card 3: Kitbags -->\n      <a href=\"/collections/summer-sale-bags\" class=\"category-card\" aria-label=\"Shop Kitbags\">\n        <div class=\"image-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0707/5836/7332/files/2.3.jpg?v=1781843190&width=750\" onerror=\"this.onerror=null; this.src='2.3.jpg';\" alt=\"Kitbags Sale\" loading=\"lazy\">\n        </div>\n      </a>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  #section-summer-sale {\n    padding: 30px 0 60px 0;\n    /* Soft summer mint/cyan background that blends perfectly with the bottom of the banners */\n    background-color: #e3f7f2; \n  }\n  \n  .lining-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n  \n  .category-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n  \n  .category-card {\n    position: relative;\n    display: block;\n    border-radius: 12px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.06);\n    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease;\n    background: #fff;\n  }\n  \n  /* Micro-interaction on hover to make it feel premium without visual clutter */\n  .category-card:hover {\n    transform: translateY(-6px);\n    box-shadow: 0 16px 36px rgba(0,0,0,0.12);\n  }\n  \n  .image-wrapper {\n    position: relative;\n    width: 100%;\n    padding-bottom: 100%; /* Keeps a clean 1:1 ratio box */\n    overflow: hidden;\n  }\n  \n  .image-wrapper img {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  /* Responsive Scaling */\n  @media (max-width: 991px) {\n    .category-grid {\n      gap: 16px;\n    }\n  }\n  \n  @media (max-width: 767px) {\n    #section-summer-sale {\n      padding: 20px 0 40px 0;\n    }\n    .category-grid {\n      grid-template-columns: 1fr; /* Clean single column layout on mobile */\n      gap: 20px;\n    }\n  }\n</style>",
