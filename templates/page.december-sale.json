      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Li-Ning Clean & Premium Summer Sale Typography Block + Minimalist CTA\n  Sits seamlessly between image_636869.jpg and image_598b1d.jpg\n{% endcomment %}\n\n<div class=\"lining-premium-headline\" id=\"headline-{{ section.id }}\">\n  <div class=\"headline-container\">\n    \n    <!-- Clean, tracked-out mini baseline -->\n    <p class=\"premium-sub-style\">SERVE YOUR GAME</p>\n    \n    <!-- Balanced, non-italicized main title with clean typography weight -->\n    <h2 class=\"premium-main-title\">\n      SMASH THE <span class=\"clean-accent\">DEALS</span>\n    </h2>\n\n    <!-- Minimalist Precision CTA Button -->\n    <div class=\"cta-action-wrapper\">\n      <a href=\"/collections/all\" class=\"premium-clean-cta\">\n        <span class=\"cta-text\">EXPLORE ALL GEAR</span>\n        <svg class=\"cta-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M5 12H19M19 12L13 6M19 12L13 18\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n    \n  </div>\n</div>\n\n<style>\n  .lining-premium-headline {\n    /* Soft summer background that blends perfectly into the category grid */\n    background-color: #e3f7f2; \n    padding: 60px 20px 50px 20px;\n    text-align: center;\n  }\n\n  .headline-container {\n    max-width: 800px;\n    margin: 0 auto;\n  }\n\n  /* Ultra-clean sans-serif subhead with wide letter-spacing */\n  .premium-sub-style {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    font-size: 0.95rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 6px;\n    color: #002349; /* Deep Li-Ning Banner Navy */\n    margin: 0 0 16px 0;\n    opacity: 0.85;\n  }\n\n  /* Main title: Clean, upright, lighter font weight for a premium look */\n  .premium-main-title {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    font-size: 3.2rem;\n    font-weight: 400; /* Light/Regular feel for sophisticated execution */\n    font-style: normal; /* Completely upright */\n    line-height: 1.2;\n    letter-spacing: 2px;\n    color: #002349;\n    text-transform: uppercase;\n    margin: 0 0 35px 0;\n  }\n\n  /* The clean orange-to-red summer theme gradient, but restrained and smooth */\n  .clean-accent {\n    font-weight: 800; /* Only bolding the accent word for graphic contrast */\n    background: linear-gradient(180deg, #ffb700 0%, #ff3b00 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    color: #ff3b00;\n    display: inline-block;\n  }\n\n  /* ==========================================\n     ✨ CLEAN & MINIMALIST PREMIUM CTA\n     ========================================== */\n  .cta-action-wrapper {\n    display: block;\n  }\n\n  .premium-clean-cta {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 14px 36px;\n    text-decoration: none;\n    \n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    font-size: 0.95rem;\n    font-weight: 700;\n    font-style: normal;\n    letter-spacing: 2px;\n    \n    /* Clean, high-contrast dark border */\n    color: #002349;\n    background: transparent;\n    border: 2px solid #002349;\n    border-radius: 4px;\n    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n    cursor: pointer;\n  }\n\n  .cta-arrow {\n    transition: transform 0.3s ease;\n  }\n\n  /* Sophisticated Hover: Fills cleanly and slides the arrow forward */\n  .premium-clean-cta:hover {\n    color: #ffffff;\n    background: #002349;\n    box-shadow: 0 8px 20px rgba(0, 35, 73, 0.15);\n  }\n\n  .premium-clean-cta:hover .cta-arrow {\n    transform: translateX(4px);\n  }\n\n  /* Responsive Adjustments */\n  @media (max-width: 991px) {\n    .premium-main-title { font-size: 2.6rem; }\n  }\n\n  @media (max-width: 767px) {\n    .lining-premium-headline { padding: 45px 15px 40px 15px; }\n    .premium-sub-style { font-size: 0.85rem; letter-spacing: 4px; margin-bottom: 12px; }\n    .premium-main-title { font-size: 1.85rem; margin-bottom: 25px; letter-spacing: 1px; }\n    .premium-clean-cta { font-size: 0.85rem; padding: 12px 28px; width: auto; }\n  }\n</style>",
