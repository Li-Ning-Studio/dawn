      "settings": {
        "custom_liquid": "<!-- ============================================================\n  Sticky Bottom Offer Marquee — Li-Ning Summer Sale\n  Paste this block just before the closing </body> tag in\n  theme.liquid (Shopify Admin → Online Store → Edit code).\n  Self-contained: no external dependencies, no fonts to load.\n============================================================ -->\n<div id=\"lns-sticky-offer\" role=\"region\" aria-label=\"Summer sale offer\">\n  <div class=\"lns-glow\" aria-hidden=\"true\"></div>\n\n  <div class=\"lns-marquee-track\">\n    <div class=\"lns-marquee-content\">\n      <span class=\"lns-msg\">\n        <svg class=\"lns-icon\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M4 3h7l9 9-8 8-9-9V3z\" fill=\"#FAF7F8\"/>\n          <circle cx=\"8.5\" cy=\"7.5\" r=\"1.6\" fill=\"#E90128\"/>\n        </svg>\n        <span class=\"lns-headline\">Buy shoes&thinsp;&mdash;&thinsp;get socks free</span>\n        <span class=\"lns-dot\">&#9670;</span>\n        Flat &#8377;150 Off on 3000+\n        <span class=\"lns-sep\">&#9670;</span>\n      Flat &#8377;250 Off on 5000+\n        <span class=\"lns-sep\">&#9670;</span>\n       Flat &#8377;400 Off on &#8377;8000+\n        <span class=\"lns-sep\">&#9670;</span>\n        Flat &#8377;700 Off on &#8377;10000+\n        <span class=\"lns-sep\">&#9670;</span>\n       Flat &#8377;1050&nbsp; Off on &#8377;13000+ orders\n      </span>\n      <span class=\"lns-msg\" aria-hidden=\"true\">\n        <svg class=\"lns-icon\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M4 3h7l9 9-8 8-9-9V3z\" fill=\"#FAF7F8\"/>\n          <circle cx=\"8.5\" cy=\"7.5\" r=\"1.6\" fill=\"#E90128\"/>\n        </svg>\n        <span class=\"lns-headline\">Buy shoes&thinsp;&mdash;&thinsp;get socks free</span>\n        <span class=\"lns-dot\">&#9670;</span>\n        Flat &nbsp;&#8377;150 Off on &#8377;3000+\n        <span class=\"lns-sep\">&#9670;</span>\n        Flat &#8377;250 Off on &#8377;5000+\n        <span class=\"lns-sep\">&#9670;</span>\n        Flat &#8377;400 Off on &#8377;8000+\n        <span class=\"lns-sep\">&#9670;</span>\n        Flat &#8377;700 Off on &#8377;10000+\n        <span class=\"lns-sep\">&#9670;</span>\n        Flat &#8377;1050 Off on &#8377;13000+ orders\n      </span>\n    </div>\n  </div>\n</div>\n\n<style>\n  #lns-sticky-offer{\n    --red:#E90128;\n    --cream:#FAF7F8;\n    position:fixed;\n    left:0;\n    right:0;\n    bottom:0;\n    z-index:9999;\n    display:flex;\n    align-items:stretch;\n    height:46px;\n    background:var(--red);\n    box-shadow:0 -4px 18px rgba(0,0,0,.35);\n    overflow:hidden;\n   font-family: 'Impact', 'Arial Black', sans-serif;\n  }\n\n  #lns-sticky-offer .lns-glow{\n    position:absolute;\n    inset:0;\n    background:radial-gradient(ellipse 70% 160% at 50% 50%,rgba(250,247,248,.14),transparent 75%);\n    animation:lns-pulse 3s ease-in-out infinite;\n    pointer-events:none;\n  }\n\n  #lns-sticky-offer .lns-marquee-track{\n    position:relative;\n    z-index:2;\n    flex:1 1 auto;\n    overflow:hidden;\n    display:flex;\n    align-items:center;\n    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%);\n            mask-image:linear-gradient(90deg,transparent 0,#000 24px,#000 calc(100% - 24px),transparent 100%);\n  }\n\n  #lns-sticky-offer .lns-marquee-content{\n    display:flex;\n    align-items:center;\n    white-space:nowrap;\n    animation:lns-scroll 19s linear infinite;\n    will-change:transform;\n  }\n\n  #lns-sticky-offer:hover .lns-marquee-content{\n    animation-play-state:paused;\n  }\n\n  #lns-sticky-offer .lns-msg{\n    display:inline-flex;\n    align-items:center;\n    padding-right:46px;\n    font-size:13px;\n    letter-spacing:.01em;\n    color:var(--cream);\n  }\n\n  #lns-sticky-offer .lns-icon{\n    width:16px;\n    height:16px;\n    flex:0 0 auto;\n    margin-right:8px;\n  }\n\n  #lns-sticky-offer .lns-headline{\n    font-weight:500;\n    text-transform:uppercase;\n    letter-spacing:.04em;\n    margin-right:14px;\n    font-size:13.5px;\n    color:var(--cream);\n  }\n\n  #lns-sticky-offer .lns-msg b{\n    font-weight:500;\n    color:#fff;\n  }\n\n  #lns-sticky-offer .lns-dot{\n    margin:0 14px;\n    font-size:7px;\n    opacity:.6;\n    position:relative;\n    top:-1px;\n    color:var(--cream);\n  }\n\n  #lns-sticky-offer .lns-sep{\n    margin:0 9px;\n    font-size:5px;\n    opacity:.45;\n    position:relative;\n    top:-1px;\n    color:var(--cream);\n  }\n\n  @keyframes lns-scroll{\n    from{ transform:translateX(0); }\n    to{ transform:translateX(-50%); }\n  }\n\n  @keyframes lns-pulse{\n    0%, 100%{ opacity:.6; }\n    50%{ opacity:1; }\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    #lns-sticky-offer .lns-marquee-content{ animation:none; }\n    #lns-sticky-offer .lns-glow{ animation:none; opacity:.4; }\n    #lns-sticky-offer .lns-msg:nth-child(2){ display:none; }\n  }\n\n  @media (max-width:480px){\n    #lns-sticky-offer{ height:42px; }\n    #lns-sticky-offer .lns-msg{ font-size:11.5px; padding-right:34px; }\n    #lns-sticky-offer .lns-icon{ width:14px; height:14px; margin-right:6px; }\n    #lns-sticky-offer .lns-headline{ font-size:12px; }\n    #lns-sticky-offer .lns-dot,\n    #lns-sticky-offer .lns-sep{ margin:0 7px; }\n  }\n\n  /* Push page content up so the bar never covers the footer's bottom-most controls */\n  body{\n    padding-bottom:46px;\n  }\n  @media (max-width:480px){\n    body{ padding-bottom:42px; }\n  }\n</style>",
