      "settings": {
        "custom_liquid": "{% comment %}\n  HYPERARMOUR HERO BANNER\n  Hyperarmour hero with gradient headline\n  and teal outline CTA.\n{% endcomment %}\n\n{% assign hyperarmour_product = all_products['hyperarmour'] %}\n\n<style>\n\n  #hah-hero,\n  #hah-hero * {\n    box-sizing: border-box;\n  }\n\n\n  #hah-hero {\n    width: 100%;\n    padding: clamp(64px, 9vw, 128px) 20px;\n    background: #000;\n    color: #fff;\n    font-family: inherit;\n    text-align: center;\n  }\n\n\n  #hah-hero * {\n    font-family: inherit;\n  }\n\n\n  .hah-inner {\n    width: 100%;\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n\n  /* KICKER */\n\n  .hah-kicker {\n    margin: 0 0 14px;\n\n    color: rgba(255,255,255,.55);\n\n    font-size: clamp(13px, 1.2vw, 15px);\n\n    font-weight: 500;\n\n    letter-spacing: .01em;\n  }\n\n\n  /* HEADLINE */\n\n  .hah-headline {\n    margin: 0;\n\n    font-size: clamp(38px, 6.2vw, 76px);\n\n    line-height: 1.02;\n\n    font-weight: 800;\n\n    letter-spacing: -.03em;\n\n    background: linear-gradient(\n      92deg,\n      #c9f24d 0%,\n      #6fe6a8 32%,\n      #2fe0c2 55%,\n      #35c2e0 72%,\n      #ff8a3d 100%\n    );\n\n    -webkit-background-clip: text;\n\n    background-clip: text;\n\n    -webkit-text-fill-color: transparent;\n\n    color: transparent;\n  }\n\n\n  /* SUBHEAD */\n\n  .hah-subhead {\n    max-width: 620px;\n\n    margin: 20px auto 0;\n\n    color: rgba(255,255,255,.62);\n\n    font-size: clamp(14px, 1.5vw, 18px);\n\n    line-height: 1.5;\n\n    font-weight: 450;\n  }\n\n\n  /* CTA */\n\n  .hah-cta {\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    margin-top: clamp(28px, 3.4vw, 40px);\n\n    padding: 15px 40px;\n\n    border: 1.5px solid #2fe0c2;\n\n    border-radius: 999px;\n\n    background: transparent;\n\n    color: #fff;\n\n    font-size: 13px;\n\n    font-weight: 700;\n\n    letter-spacing: .12em;\n\n    text-transform: uppercase;\n\n    text-decoration: none;\n\n    transition:\n      border-color .2s ease,\n      transform .2s ease,\n      box-shadow .2s ease;\n  }\n\n\n  /* CTA HOVER - STAYS OUTLINE */\n\n  .hah-cta:hover {\n    background: transparent;\n\n    border-color: #2fe0c2;\n\n    color: #fff;\n\n    transform: translateY(-1px);\n  }\n\n\n  /* COLORWAYS */\n\n  .hah-colorways {\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    gap: 10px;\n\n    margin-top: clamp(26px, 3vw, 36px);\n  }\n\n\n  .hah-swatch {\n    width: 16px;\n\n    height: 16px;\n\n    border-radius: 50%;\n\n    border: 1px solid rgba(255,255,255,.25);\n  }\n\n\n  .hah-swatch--black {\n    background: linear-gradient(\n      135deg,\n      #111 50%,\n      #c9f24d 50%\n    );\n  }\n\n\n  .hah-swatch--white {\n    background: linear-gradient(\n      135deg,\n      #f2f2f2 50%,\n      #35c2e0 50%\n    );\n  }\n\n\n  .hah-swatch--blue {\n    background: linear-gradient(\n      135deg,\n      #2f6fe0 50%,\n      #0b1d4d 50%\n    );\n  }\n\n\n  .hah-colorways-label {\n    color: rgba(255,255,255,.4);\n\n    font-size: 11px;\n\n    font-weight: 600;\n\n    letter-spacing: .06em;\n\n    text-transform: uppercase;\n  }\n\n\n  /* MOBILE */\n\n  @media screen and (max-width: 560px) {\n\n    #hah-hero {\n      padding: 64px 20px;\n    }\n\n\n    .hah-cta {\n      padding: 13px 34px;\n\n      font-size: 12px;\n    }\n\n  }\n\n</style>\n\n\n<section id=\"hah-hero\">\n\n  <div class=\"hah-inner\">\n\n\n    <p class=\"hah-kicker\">\n      Introducing, Hyperarmour\n    </p>\n\n\n    <h1 class=\"hah-headline\">\n      The Last One Standing\n    </h1>\n\n\n    <p class=\"hah-subhead\">\n      The badminton shoe built to outlast the match — carbon-plated,\n      honeycomb-gripped, and cushioned to hold up through every rally\n      of every game, by HNDRD.\n    </p>\n\n\n    <a\n      class=\"hah-cta\"\n      href=\"{% if hyperarmour_product != blank %}{{ hyperarmour_product.url }}{% else %}#{% endif %}\"\n    >\n      Get Yours\n    </a>\n\n\n  </div>\n\n</section>",
