tem\">\n    <span class=\"sv-qf__label\">Venue</span>\n    <span class=\"sv-qf__value\">Feather Touch Sports Arena, JP Nagar 7th Phase</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Reporting</span>\n    <span class=\"sv-qf__value\">03:30 PM</span>\n  </div>\n  <div class=\"sv-qf__item\">\n    <span class=\"sv-qf__label\">Duration</span>\n    <span class=\"sv-qf__value\">2 HOURS</span>\n  </div>\n  <div class=\"sv-qf__item\">\n  <span class=\"sv-qf__label\">Entry Fee</span>\n  <span class=\"sv-qf__value\">₹100 (*Per Player)</span>\n \n</div>\n</div>",
