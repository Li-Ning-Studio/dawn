      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign streaks_registration_url = 'https://www.swiggy.com/scenes/sports/Hndrd-Streaks/Bangalore/100103014?source_caller=ui&af_xp=qr&deep_link_value=swiggydiners%3A%2F%2Fentity%2FDINEOUT_EVENT%2F100103014&pid=perf_scenes_dineout_partner_100103014&af_dp=swiggydiners%3A%2F%2Fentity%2FDINEOUT_EVENT%2F100103014&c=perf_scenes_dineout_partner_100103014&deep_link_sub1=swiggydiners%3A%2F%2Fentity%2FDINEOUT_EVENT%2F100103014&shortlink=ylbrxcu8' %}\n\n<section class=\"streaks-register\" aria-labelledby=\"streaks-register-title\">\n\n  <div class=\"streaks-register__graphic\" aria-hidden=\"true\">\n    <span></span>\n    <span></span>\n    <span></span>\n  </div>\n\n  <div class=\"streaks-register__inner\">\n\n    <div class=\"streaks-register__date\">\n      <span>26 JULY 2026</span>\n      <i></i>\n      <span>BANGALORE</span>\n    </div>\n\n    <h2 id=\"streaks-register-title\" class=\"streaks-register__title\">\n      Register For\n      <strong>₹100</strong>\n      <strong><small>*PER PLAYER</strong>\n    </h2>\n\n    <p class=\"streaks-register__intro\">\n      8 teams. Every round, a new opponent.<br>\n      Win your matches and climb the leaderboard.\n    </p>\n\n    <div class=\"streaks-register__details\">\n\n      <div class=\"streaks-register__detail\">\n        <span>REPORTING</span>\n        <strong>03:30 PM</strong>\n      </div>\n\n      <div class=\"streaks-register__detail\">\n        <span>DURATION</span>\n        <strong>2 HOURS</strong>\n      </div>\n\n      <div class=\"streaks-register__detail streaks-register__detail--venue\">\n        <span>VENUE</span>\n        <strong>FEATHER TOUCH SPORTS ARENA</strong>\n        <small>JP Nagar 7th Phase, Bangalore</small>\n      </div>\n\n    </div>\n\n    <a\n      href=\"{{ streaks_registration_url }}\"\n      class=\"streaks-register__booking\"\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      aria-label=\"Register for HNDRD Streaks\"\n    >\n\n      <span class=\"streaks-register__booking-left\">\n\n        <span class=\"streaks-register__mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 30 38\">\n            <path d=\"M16.5 1C17.7 7 13.8 9.5 12 13c-1.3 2.7-.8 5.3 1.1 7.3-.1-4 2.5-5.9 5.1-8.1.4 4 4.7 6.4 4.7 12.3 0 6.1-3.9 11-10.4 11C6 35.5 2 30.8 2 25c0-6.7 4.5-10 7.9-13.8C12.5 8.3 14.8 5.2 16.5 1Z\"/>\n            <path d=\"M13.8 21c.2 3-2.1 3.9-2.1 7 0 2.1 1.4 3.9 3.7 3.9 2.6 0 4-1.8 4-4.2 0-2.1-1.1-3.9-3.1-6 .1 1.9-.9 3.1-1.9 4 .2-1.7-.2-3.1-.6-4.7Z\"/>\n          </svg>\n        </span>\n\n        <span class=\"streaks-register__booking-copy\">\n          <small>OFFICIAL REGISTRATION</small>\n          <strong>HNDRD STREAKS</strong>\n        </span>\n\n      </span>\n\n      <span class=\"streaks-register__button\">\n        REGISTER NOW\n\n        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n          <path d=\"M4 10h11\"></path>\n          <path d=\"m11 6 4 4-4 4\"></path>\n        </svg>\n      </span>\n\n    </a>\n\n    <div class=\"streaks-register__availability\">\n\n      <svg viewBox=\"0 0 18 24\" aria-hidden=\"true\">\n        <path d=\"M11.1 0 1 13.2h6.4L5.9 24 17 9.3h-6.2L11.1 0Z\"/>\n      </svg>\n\n      <span>8 TEAMS</span>\n      <i></i>\n      <span>LIMITED ENTRIES</span>\n      <i></i>\n      <span>FIRST COME, FIRST SERVED</span>\n\n    </div>\n\n    <p class=\"streaks-register__terms\">\n      Registration is confirmed only after successful payment. Match schedules,\n      opponent rotations and timings may be adjusted by the organizers.\n      Misconduct may result in disqualification without refund. Decisions made\n      by the event organizers are final.\n    </p>\n\n  </div>\n</section>\n\n<style>\n  .streaks-register {\n    --st-black: #000000;\n    --st-gold: #e5a72c;\n    --st-orange: #ed8b37;\n    --st-purple: #1a0541;\n    --st-white: #f2f2f2;\n    --st-grey: #818181;\n    --st-border: rgba(229, 167, 44, 0.34);\n\n    position: relative;\n    isolation: isolate;\n    width: 100%;\n    min-height: 680px;\n    padding: clamp(76px, 8vw, 118px) 24px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    background: var(--st-black);\n    color: var(--st-white);\n    font-family:\n      Figtree,\n      var(--font-body-family),\n      Arial,\n      sans-serif;\n  }\n\n  .streaks-register *,\n  .streaks-register *::before,\n  .streaks-register *::after {\n    box-sizing: border-box;\n  }\n\n  .streaks-register__inner {\n    position: relative;\n    z-index: 2;\n    width: min(100%, 660px);\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .streaks-register__graphic {\n    position: absolute;\n    z-index: 0;\n    right: -100px;\n    bottom: -20px;\n    width: min(75vw, 1050px);\n    height: 300px;\n    opacity: 0.38;\n    pointer-events: none;\n    transform: rotate(-7deg);\n  }\n\n  .streaks-register__graphic span {\n    position: absolute;\n    right: 0;\n    display: block;\n    height: 2px;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(237, 139, 55, 0.08),\n      var(--st-orange),\n      transparent\n    );\n  }\n\n  .streaks-register__graphic span:nth-child(1) {\n    bottom: 50px;\n    width: 100%;\n  }\n\n  .streaks-register__graphic span:nth-child(2) {\n    right: 10%;\n    bottom: 125px;\n    width: 78%;\n  }\n\n  .streaks-register__graphic span:nth-child(3) {\n    right: 21%;\n    bottom: 200px;\n    width: 57%;\n  }\n\n  .streaks-register__date {\n    width: fit-content;\n    max-width: 100%;\n    min-height: 42px;\n    margin: 0 auto 24px;\n    padding: 10px 18px;\n    border: 1px solid var(--st-gold);\n    border-radius: 999px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 11px;\n    color: var(--st-gold);\n    background: var(--st-black);\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.16em;\n    white-space: nowrap;\n  }\n\n  .streaks-register__date i {\n    width: 4px;\n    height: 4px;\n    flex: 0 0 auto;\n    border-radius: 50%;\n    background: currentColor;\n  }\n\n  .streaks-register__title {\n    margin: 0;\n    color: var(--st-white);\n    font-size: clamp(48px, 6vw, 72px);\n    font-weight: 800;\n    line-height: 0.92;\n    letter-spacing: -0.055em;\n    text-transform: uppercase;\n  }\n\n  .streaks-register__title strong {\n    display: block;\n    margin-top: 9px;\n    color: var(--st-orange);\n    font-size: clamp(74px, 9vw, 108px);\n    font-weight: 900;\n    line-height: 0.82;\n    letter-spacing: -0.075em;\n  }\n\n  .streaks-register__title small {\n    display: block;\n    margin-top: 18px;\n    color: var(--st-gold);\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.17em;\n  }\n\n  .streaks-register__intro {\n    max-width: 570px;\n    margin: 28px auto 0;\n    color: var(--st-grey);\n    font-size: 14px;\n    font-weight: 550;\n    line-height: 1.65;\n  }\n\n  .streaks-register__intro::first-line {\n    color: var(--st-white);\n  }\n\n  .streaks-register__details {\n    margin: 32px 0 18px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    overflow: hidden;\n    border: 1px solid var(--st-border);\n    border-radius: 12px;\n    background: var(--st-black);\n  }\n\n  .streaks-register__detail {\n    min-width: 0;\n    padding: 18px 20px;\n    text-align: left;\n  }\n\n  .streaks-register__detail:first-child {\n    border-right: 1px solid var(--st-border);\n  }\n\n  .streaks-register__detail--venue {\n    grid-column: 1 / -1;\n    border-top: 1px solid var(--st-border);\n  }\n\n  .streaks-register__detail span {\n    display: block;\n    margin-bottom: 6px;\n    color: var(--st-gold);\n    font-size: 10px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.17em;\n  }\n\n  .streaks-register__detail strong {\n    display: block;\n    color: var(--st-white);\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.3;\n  }\n\n  .streaks-register__detail small {\n    display: block;\n    margin-top: 4px;\n    color: var(--st-grey);\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  .streaks-register__booking {\n    position: relative;\n    width: 100%;\n    min-height: 88px;\n    padding: 16px;\n    border: 1px solid var(--st-gold);\n    border-radius: 13px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 18px;\n    overflow: hidden;\n    color: var(--st-purple);\n    background: var(--st-gold);\n    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.48);\n    text-decoration: none;\n    transition:\n      transform 200ms ease,\n      background 200ms ease;\n  }\n\n  .streaks-register__booking::after {\n    content: \"\";\n    position: absolute;\n    top: -130%;\n    left: -35%;\n    width: 24%;\n    height: 360%;\n    background: linear-gradient(\n      90deg,\n      transparent,\n      rgba(255, 255, 255, 0.3),\n      transparent\n    );\n    transform: rotate(22deg);\n    transition: left 520ms ease;\n    pointer-events: none;\n  }\n\n  .streaks-register__booking:hover {\n    transform: translateY(-3px);\n    background: #ecae30;\n  }\n\n  .streaks-register__booking:hover::after {\n    left: 120%;\n  }\n\n  .streaks-register__booking:focus-visible {\n    outline: 3px solid var(--st-orange);\n    outline-offset: 4px;\n  }\n\n  .streaks-register__booking-left {\n    position: relative;\n    z-index: 2;\n    min-width: 0;\n    display: flex;\n    align-items: center;\n    gap: 15px;\n    text-align: left;\n  }\n\n  .streaks-register__mark {\n    width: 38px;\n    height: 45px;\n    flex: 0 0 auto;\n    display: grid;\n    place-items: center;\n  }\n\n  .streaks-register__mark svg {\n    width: 28px;\n    height: auto;\n    fill: var(--st-purple);\n  }\n\n  .streaks-register__booking-copy {\n    min-width: 0;\n    display: block;\n  }\n\n  .streaks-register__booking-copy small {\n    display: block;\n    margin-bottom: 5px;\n    color: rgba(26, 5, 65, 0.7);\n    font-size: 10px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.13em;\n  }\n\n  .streaks-register__booking-copy strong {\n    display: block;\n    overflow: hidden;\n    color: var(--st-purple);\n    font-size: clamp(19px, 3vw, 25px);\n    font-weight: 900;\n    line-height: 1;\n    letter-spacing: -0.02em;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n\n  .streaks-register__button {\n    position: relative;\n    z-index: 2;\n    min-height: 48px;\n    padding: 0 18px;\n    border-radius: 8px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    color: var(--st-white);\n    background: var(--st-purple);\n    font-size: 12px;\n    font-weight: 850;\n    line-height: 1;\n    letter-spacing: 0.05em;\n    white-space: nowrap;\n  }\n\n  .streaks-register__button svg {\n    width: 17px;\n    height: 17px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    transition: transform 180ms ease;\n  }\n\n  .streaks-register__booking:hover\n  .streaks-register__button svg {\n    transform: translateX(3px);\n  }\n\n  .streaks-register__availability {\n    margin-top: 27px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 10px;\n    color: var(--st-gold);\n    font-size: 11px;\n    font-weight: 850;\n    line-height: 1.35;\n    letter-spacing: 0.16em;\n  }\n\n  .streaks-register__availability > svg {\n    width: 13px;\n    height: 18px;\n    flex: 0 0 auto;\n    fill: var(--st-orange);\n  }\n\n  .streaks-register__availability i {\n    width: 4px;\n    height: 4px;\n    flex: 0 0 auto;\n    border-radius: 50%;\n    background: currentColor;\n  }\n\n  .streaks-register__terms {\n    max-width: 590px;\n    margin: 30px auto 0;\n    color: rgba(129, 129, 129, 0.72);\n    font-size: 10px;\n    font-weight: 450;\n    line-height: 1.65;\n  }\n\n  @media screen and (max-width: 749px) {\n    .streaks-register {\n      min-height: auto;\n      padding: 68px 18px 72px;\n    }\n\n    .streaks-register__graphic {\n      right: -330px;\n      bottom: -40px;\n      width: 720px;\n      opacity: 0.25;\n    }\n\n    .streaks-register__date {\n      min-height: 38px;\n      margin-bottom: 21px;\n      padding: 9px 14px;\n      gap: 8px;\n      font-size: 10px;\n      letter-spacing: 0.12em;\n    }\n\n    .streaks-register__title {\n      font-size: clamp(44px, 14vw, 62px);\n    }\n\n    .streaks-register__title strong {\n      margin-top: 10px;\n      font-size: clamp(70px, 22vw, 94px);\n    }\n\n    .streaks-register__title small {\n      margin-top: 17px;\n      font-size: 13px;\n    }\n\n    .streaks-register__intro {\n      margin-top: 25px;\n      font-size: 13px;\n      line-height: 1.6;\n    }\n\n    .streaks-register__details {\n      margin-top: 28px;\n      border-radius: 10px;\n    }\n\n    .streaks-register__detail {\n      padding: 15px 13px;\n    }\n\n    .streaks-register__detail span {\n      font-size: 9px;\n    }\n\n    .streaks-register__detail strong {\n      font-size: 12px;\n    }\n\n    .streaks-register__booking {\n      min-height: auto;\n      padding: 14px;\n      grid-template-columns: 1fr;\n      gap: 14px;\n      border-radius: 11px;\n    }\n\n    .streaks-register__booking-left {\n      padding: 3px;\n    }\n\n    .streaks-register__booking-copy strong {\n      font-size: 20px;\n    }\n\n    .streaks-register__button {\n      width: 100%;\n      min-height: 50px;\n    }\n\n    .streaks-register__availability {\n      margin-top: 24px;\n      gap: 8px;\n      font-size: 9px;\n      letter-spacing: 0.11em;\n    }\n\n    .streaks-register__terms {\n      margin-top: 26px;\n      font-size: 9px;\n      line-height: 1.6;\n    }\n  }\n\n  @media screen and (max-width: 370px) {\n    .streaks-register {\n      padding-inline: 14px;\n    }\n\n    .streaks-register__date {\n      font-size: 9px;\n      letter-spacing: 0.08em;\n    }\n\n    .streaks-register__detail {\n      padding-inline: 10px;\n    }\n\n    .streaks-register__availability {\n      letter-spacing: 0.08em;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .streaks-register__booking,\n    .streaks-register__booking::after,\n    .streaks-register__button svg {\n      transition: none;\n    }\n  }\n</style>",
