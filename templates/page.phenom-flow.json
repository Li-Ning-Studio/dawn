ne-height: 1.15 !important;\n  }\n\n  .hnbb-v2 .hnbb-v2-description {\n    font-size: 15px !important;\n    line-height: 1.6 !important;\n  }\n\n  .hnbb-v2 .hnbb-v2-cta,\n  .hnbb-v2 .hnbb-v2-cta:visited {\n    min-height: 44px;\n    margin-top: 24px;\n    padding: 10px 20px;\n    font-size: 13px !important;\n  }\n}\n\n/* ====================================\n   SMALL MOBILE\n==================================== */\n\n@media (max-width: 400px) {\n  .hnbb-v2-content {\n    padding: 46px 22px 52px;\n  }\n\n  .hnbb-v2 .hnbb-v2-title {\n    font-size: 24px !important;\n  }\n\n  .hnbb-v2 .hnbb-v2-description {\n    font-size: 15px !important;\n  }\n}\n\n/* ====================================\n   REDUCED MOTION\n==================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .hnbb-v2 .hnbb-v2-cta,\n  .hnbb-v2 .hnbb-v2-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hnbb-v2\">\n  <div class=\"hnbb-v2-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hnbb-v2-content\">\n      <div class=\"hnbb-v2-inner\">\n\n        <!-- LABEL -->\n        <p class=\"hnbb-v2-label\">\n        </p>\n\n        <!-- HEADING -->\n        <h2 class=\"hnbb-v2-title\">\n          BALANCED AND BREATHING\n        </h2>\n\n        <!-- DESCRIPTION -->\n        <p class=\"hnbb-v2-description\">\n          The carbon kinetic plate resists twisting\n          and keeps air moving beneath your foot\n          through built-in vents.\n        </p>\n\n        <!-- CTA -->\n        <a\n          class=\"hnbb-v2-cta\"\n          href=\"https://in.hndrd.co/products/phenom-flow\"\n          aria-label=\"Explore HNDRD Phenom Flow\"\n        >\n          EXPLORE PHENOM FLOW\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              st