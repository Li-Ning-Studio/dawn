        "custom_liquid": "{% comment %}\n  HNDRD PHENOM FLOW\n  Premium Introduction Section\n  Original Shopify Theme Fonts\n  Solid Pink Accent: #F00C6D\n  Pure Black Background\n{% endcomment %}\n\n<style>\n/* ==========================================\n   BASE\n========================================== */\n\n.hn-pf-premium,\n.hn-pf-premium * {\n  box-sizing: border-box;\n}\n\n.hn-pf-premium {\n  position: relative;\n  isolation: isolate;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-height: 360px;\n  margin: 0;\n  padding: 75px 28px;\n  overflow: hidden;\n\n  background: #000000 !important;\n  background-color: #000000 !important;\n  background-image: none !important;\n\n  color: #ffffff;\n  font-family: var(--font-body-family);\n}\n\n/* ==========================================\n   CONTENT WRAPPER\n========================================== */\n\n.hn-pf-premium__inner {\n  position: relative;\n  z-index: 1;\n\n  width: 100%;\n  max-width: 1100px;\n\n  margin: 0 auto;\n  text-align: center;\n}\n\n/* ==========================================\n   EYEBROW\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__eyebrow {\n  display: block;\n\n  margin: 0 0 18px;\n  padding: 0;\n\n  font-family: var(--font-body-family) !important;\n  font-size: 15px !important;\n  font-weight: 600 !important;\n  font-style: normal !important;\n\n  letter-spacing: .12em !important;\n  line-height: 1.5 !important;\n\n  text-align: center !important;\n  text-transform: uppercase !important;\n\n  color: #b9b9b9 !important;\n}\n\n/* ==========================================\n   MAIN HEADING\n   SOLID PINK\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__title {\n  display: block;\n\n  width: 100%;\n  max-width: 1000px;\n\n  margin: 0 auto 20px;\n  padding: 0;\n\n  font-family: var(--font-heading-family) !important;\n\n  font-size: clamp(34px, 4vw, 55px) !important;\n  font-weight: 700 !important;\n  font-style: normal !important;\n\n  letter-spacing: -.035em !important;\n  line-height: 1.12 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n  overflow-wrap: break-word;\n\n  background: none !important;\n  background-image: none !important;\n\n  color: #F00C6D !important;\n  -webkit-text-fill-color: #F00C6D !important;\n}\n\n/* ==========================================\n   DESCRIPTION\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__description {\n  display: block;\n\n  width: 100%;\n  max-width: 720px;\n\n  margin: 0 auto;\n  padding: 0;\n\n  font-family: var(--font-body-family) !important;\n  font-size: 18px !important;\n  font-weight: 400 !important;\n  font-style: normal !important;\n\n  letter-spacing: 0 !important;\n  line-height: 1.65 !important;\n\n  text-align: center !important;\n  text-transform: none !important;\n\n  color: #d6d6d6 !important;\n}\n\n/* ==========================================\n   PREMIUM CTA\n   SOLID PINK OUTLINE\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__cta,\n.hn-pf-premium .hn-pf-premium__cta:visited {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 28px;\n\n  min-height: 62px;\n  max-width: 100%;\n\n  margin-top: 36px;\n  padding: 8px 9px 8px 28px;\n\n  border: 2px solid #F00C6D !important;\n  border-radius: 999px;\n\n  background: #000000 !important;\n  background-image: none !important;\n\n  color: #ffffff !important;\n\n  font-family: var(--font-body-family) !important;\n  font-size: 15px !important;\n  font-weight: 600 !important;\n  font-style: normal !important;\n\n  letter-spacing: .025em !important;\n  line-height: 1.3 !important;\n\n  text-align: center;\n  text-transform: none !important;\n  text-decoration: none !important;\n\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n\n  transition:\n    background .3s ease,\n    border-color .3s ease,\n    transform .3s ease,\n    box-shadow .3s ease;\n}\n\n/* ==========================================\n   CTA TEXT\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__cta-text {\n  display: inline-block;\n\n  font-family: inherit !important;\n  font-size: inherit !important;\n  font-weight: inherit !important;\n  font-style: inherit !important;\n\n  line-height: inherit !important;\n  letter-spacing: inherit !important;\n\n  text-transform: none !important;\n  white-space: nowrap;\n\n  color: #ffffff !important;\n}\n\n/* ==========================================\n   WHITE CIRCULAR ARROW\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__arrow {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 44px;\n  height: 44px;\n  flex: 0 0 44px;\n\n  border-radius: 50%;\n\n  background: #ffffff !important;\n  color: #101010 !important;\n\n  transition:\n    transform .3s ease,\n    background .3s ease,\n    color .3s ease;\n}\n\n.hn-pf-premium .hn-pf-premium__arrow svg {\n  display: block;\n  width: 21px;\n  height: 21px;\n}\n\n/* ==========================================\n   CTA HOVER\n========================================== */\n\n@media (hover: hover) {\n  .hn-pf-premium .hn-pf-premium__cta:hover {\n    background: rgba(240,12,109,.08) !important;\n    border-color: #F00C6D !important;\n\n    transform: translateY(-3px);\n\n    box-shadow:\n      0 8px 28px rgba(240,12,109,.20);\n  }\n\n  .hn-pf-premium\n  .hn-pf-premium__cta:hover\n  .hn-pf-premium__arrow {\n    transform: translateX(3px);\n  }\n}\n\n/* ==========================================\n   KEYBOARD FOCUS\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__cta:focus-visible {\n  outline: 2px solid #F00C6D;\n  outline-offset: 5px;\n}\n\n/* ==========================================\n   TABLET\n========================================== */\n\n@media (min-width: 769px) and (max-width: 1100px) {\n  .hn-pf-premium {\n    min-height: 340px;\n    padding: 65px 28px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: clamp(30px, 4vw, 46px) !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 15px !important;\n  }\n}\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 768px) {\n  .hn-pf-premium {\n    min-height: 300px;\n    padding: 55px 22px;\n  }\n\n  .hn-pf-premium__inner {\n    max-width: 480px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__eyebrow {\n    margin-bottom: 14px;\n    font-size: 10px !important;\n    letter-spacing: .1em !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: clamp(27px, 7vw, 36px) !important;\n    margin-bottom: 16px;\n    line-height: 1.14 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__description {\n    font-size: 14px !important;\n    line-height: 1.55 !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__cta,\n  .hn-pf-premium .hn-pf-premium__cta:visited {\n    min-height: 56px;\n\n    margin-top: 30px;\n    padding: 7px 8px 7px 22px;\n\n    gap: 18px;\n\n    font-size: 14px !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__arrow {\n    width: 40px;\n    height: 40px;\n    flex-basis: 40px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__arrow svg {\n    width: 19px;\n    height: 19px;\n  }\n}\n\n/* ==========================================\n   SMALL MOBILE\n========================================== */\n\n@media (max-width: 400px) {\n  .hn-pf-premium {\n    padding: 48px 18px;\n  }\n\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: 27px !important;\n  }\n\n  .hn-pf-premium .hn-pf-premium__cta {\n    gap: 12px;\n    padding-left: 18px;\n    font-size: 13px !important;\n  }\n}\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .hn-pf-premium .hn-pf-premium__cta,\n  .hn-pf-premium .hn-pf-premium__arrow {\n    transition: none !important;\n  }\n}\n\n/* ==========================================\n   MAIN HEADING\n   EXACT REFERENCE FONT STYLING\n========================================== */\n\n.hn-pf-premium .hn-pf-premium__title {\n  display: block;\n\n  width: 100%;\n  max-width: 1100px;\n\n  margin: 0 auto 20px;\n  padding: 0;\n\n  /* INHERIT ORIGINAL SHOPIFY FONT */\n  font-family: inherit !important;\n\n  /* EXACT REFERENCE STYLING */\n  font-size: 3.3rem !important;\n  font-weight: 900 !important;\n  font-style: normal !important;\n  letter-spacing: -1.5px !important;\n\n  line-height: 1.12 !important;\n  text-align: center !important;\n  text-transform: none !important;\n  overflow-wrap: break-word;\n\n  background: none !important;\n  background-image: none !important;\n\n  color: #F00C6D !important;\n  -webkit-text-fill-color: #F00C6D !important;\n}\n\n/* DESKTOP - EXACT REFERENCE SIZE */\n@media screen and (min-width: 750px) {\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: 5rem !important;\n  }\n}\n\n/* MOBILE */\n@media screen and (max-width: 749px) {\n  .hn-pf-premium .hn-pf-premium__title {\n    font-size: 3.3rem !important;\n  }\n}\n\n</style>\n\n<section class=\"hn-pf-premium\">\n  <div class=\"hn-pf-premium__inner\">\n\n    <!-- EYEBROW -->\n    <p class=\"hn-pf-premium__eyebrow\">\n      PHENOM FLOW\n    </p>\n\n    <!-- HEADING -->\n    <h2 class=\"hn-pf-premium__title\">\n      Breath of Innovation.\n    </h2>\n\n    <!-- DESCRIPTION -->\n    <p class=\"hn-pf-premium__description\">\n      HNDRD's precision-crafted shoe for badminton.\n    </p>\n\n    <!-- PREMIUM CTA -->\n    <a\n      class=\"hn-pf-premium__cta\"\n      href=\"https://in.hndrd.co/products/phenom-flow\"\n      aria-label=\"Explore Phenom Flow\"\n    >\n      <span class=\"hn-pf-premium__cta-text\">\nEXPLORE PHENOM FLOW      </span>\n\n      <span\n        class=\"hn-pf-premium__arrow\"\n        aria-hidden=\"true\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path\n            d=\"M5 12h14m-6-6 6 6-6 6\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.8\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </span>\n    </a>\n\n  </div>\n</section>",
