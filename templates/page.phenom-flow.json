        "custom_liquid": "{% comment %}\n  HNDRD PHENOM FLOW | Scroll-controlled video\n  Desktop: original video layout and 360vh scrub\n  Mobile: more compact video stage and 220vh scrub\n  Heading: 5rem desktop, 3.3rem mobile, weight 900\n  No paragraph below the shoe\n{% endcomment %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap\" rel=\"stylesheet\">\n\n<style>\n.pfx {\n  --pfx-scroll: 360vh;\n  --pfx-offset: 0px;\n  --pfx-white: #f5f5f7;\n  --pfx-grey: #86868b;\n  --pfx-font: \"SF Pro Display\", \"SF Pro Text\", -apple-system, BlinkMacSystemFont, \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\n  --pfx-ease: cubic-bezier(.28, .11, .32, 1);\n  position: relative;\n  width: 100vw;\n  max-width: 100vw;\n  margin-left: calc(50% - 50vw);\n  background: #000 !important;\n  color: var(--pfx-white);\n  font-family: var(--pfx-font);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n.pfx *, .pfx *::before, .pfx *::after { box-sizing: border-box; }\n.pfx h2, .pfx span {\n  font-family: var(--pfx-font) !important;\n  text-transform: none !important;\n  -webkit-text-fill-color: currentColor !important;\n  background: none !important;\n  margin: 0;\n  padding: 0;\n}\n\n/* PINNED VIDEO */\n.pfx-track { position: relative; height: var(--pfx-scroll); }\n.pfx-stage {\n  position: sticky;\n  top: var(--pfx-offset);\n  height: calc(100vh - var(--pfx-offset));\n  height: calc(100svh - var(--pfx-offset));\n  overflow: hidden;\n  background: #000;\n}\n.pfx-video {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: 50% 50%;\n  background: #000;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 1.2s var(--pfx-ease);\n  will-change: opacity;\n}\n.pfx.is-ready .pfx-video { opacity: 1; }\n.pfx-stage::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 22%;\n  background: linear-gradient(180deg, rgba(0,0,0,0), #000);\n  pointer-events: none;\n  z-index: 1;\n}\n\n/* HEADLINE */\n.pfx-hero {\n  position: absolute;\n  z-index: 2;\n  left: 0;\n  right: 0;\n  top: clamp(44px, 9vh, 110px);\n  padding: 0 24px;\n  text-align: center;\n  pointer-events: none;\n  will-change: transform, opacity;\n}\n.pfx .pfx-headline {\n  display: block;\n  font-size: 5rem !important;\n  font-weight: 700 !important;\n  line-height: 1.08 !important;\n  letter-spacing: -1.5px !important;\n  color: var(--pfx-white) !important;\n}\n.pfx-anim .pfx-headline {\n  opacity: 0;\n  transform: translate3d(0, 20px, 0);\n  transition: opacity 1s var(--pfx-ease), transform 1s var(--pfx-ease);\n}\n.pfx-anim.is-in .pfx-headline { opacity: 1; transform: none; }\n\n/* MOBILE: LESS EMPTY VERTICAL SPACE */\n@media (max-width: 749px) {\n  .pfx-stage {\n    height: calc(68svh - var(--pfx-offset));\n  }\n  .pfx-video {\n    object-fit: cover;\n    object-position: center 35%;\n  }\n  .pfx-stage::after { height: 14%; }\n  .pfx-hero {\n    top: clamp(28px, 5svh, 56px);\n    padding: 0 16px;\n  }\n  .pfx .pfx-headline {\n    font-size: 3.3rem !important;\n    font-weight: 700 !important;\n    line-height: 1.12 !important;\n    letter-spacing: -1.5px !important;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .pfx-track { height: auto !important; }\n  .pfx-stage { position: relative; height: 100svh; }\n  .pfx-anim .pfx-headline {\n    opacity: 1 !important;\n    transform: none !important;\n    transition: none !important;\n  }\n  @media (max-width: 749px) {\n    .pfx-stage { height: 68svh; }\n  }\n}\n</style>\n\n<section\n  class=\"pfx\"\n  data-scroll=\"360\"\n  data-mobile-scroll=\"220\"\n  data-offset=\"auto\"\n  data-desktop=\"https://cdn.shopify.com/videos/c/o/v/8f741d9015554854aeb2e745f94253d2.mp4\"\n  data-mobile=\"https://cdn.shopify.com/videos/c/o/v/bfecfc6ddd1e4f2694844d45b82872be.mp4\"\n>\n  <div class=\"pfx-track\">\n    <div class=\"pfx-stage\">\n      <video\n        class=\"pfx-video\"\n        muted\n        playsinline\n        webkit-playsinline\n        preload=\"auto\"\n        disablepictureinpicture\n        disableremoteplayback\n        aria-hidden=\"true\"\n      ></video>\n      <div class=\"pfx-hero\">\n        <h2 class=\"pfx-headline\">FEEL THE FLOW.</h2>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  function initPFX(section) {\n    if (section.dataset.initialized === 'true') return;\n    section.dataset.initialized = 'true';\n    var track = section.querySelector('.pfx-track');\n    var video = section.querySelector('.pfx-video');\n    var hero = section.querySelector('.pfx-hero');\n    var mobileQuery = window.matchMedia('(max-width: 749px)');\n    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n    section.classList.add('pfx-anim');\n\n    var mem = navigator.deviceMemory || 4;\n    var cores = navigator.hardwareConcurrency || 4;\n    var lowEnd = mem <= 2 || cores <= 4;\n    var EASE = lowEnd ? 0.30 : 0.25;\n\n    var ready = false, visible = false, rafId = 0;\n    var current = 0, target = 0, lastT = 0;\n    var activeSrc = '', blobUrl = '', token = 0;\n    var top0 = 0, range = 1;\n\n    function clamp(n, a, b) { return n < a ? a : n > b ? b : n; }\n\n    function setScrollLength() {\n      var n = mobileQuery.matches\n        ? parseFloat(section.dataset.mobileScroll) || 220\n        : parseFloat(section.dataset.scroll) || 360;\n      section.style.setProperty('--pfx-scroll', n + 'vh');\n    }\n\n    function fixStickyAncestors() {\n      var p = section.parentElement;\n      while (p && p !== document.documentElement) {\n        var cs = getComputedStyle(p);\n        if (cs.overflowX === 'hidden' || cs.overflowY === 'hidden') {\n          p.style.overflowY = 'visible';\n          p.style.overflowX = 'clip';\n        }\n        p = p.parentElement;\n      }\n    }\n\n    function applyOffset() {\n      var o = section.dataset.offset, px = 0;\n      if (o === 'auto') {\n        var h = document.querySelector('.shopify-section-header-sticky, .section-header, header');\n        if (h) {\n          var pos = getComputedStyle(h).position;\n          if (pos === 'sticky' || pos === 'fixed') px = Math.round(h.getBoundingClientRect().height);\n        }\n      } else {\n        px = parseFloat(o) || 0;\n      }\n      section.style.setProperty('--pfx-offset', px + 'px');\n    }\n\n    function measure() {\n      var rect = track.getBoundingClientRect();\n      top0 = rect.top + window.pageYOffset;\n      range = Math.max(1, track.offsetHeight - section.querySelector('.pfx-stage').offsetHeight);\n    }\n\n    function progress() { return clamp((window.pageYOffset - top0) / range, 0, 1); }\n\n    function updateHero(p) {\n      if (reducedMotion.matches) return;\n      var t = clamp(p / 0.15, 0, 1);\n      var e = t * t * (3 - 2 * t);\n      hero.style.opacity = 1 - e;\n      hero.style.transform = 'translate3d(0,' + (-120 * e) + 'px,0)';\n      hero.style.visibility = t >= 1 ? 'hidden' : 'visible';\n    }\n\n    function seek(t) {\n      if (!ready || video.seeking) return;\n      var d = video.duration;\n      if (!isFinite(d)) return;\n      t = clamp(t, 0, Math.max(0, d - 0.04));\n      if (Math.abs(video.currentTime - t) > 0.02) {\n        try { video.currentTime = t; } catch (e) {}\n      }\n    }\n\n    function frame(now) {\n      rafId = 0;\n      var dt = lastT ? clamp((now - lastT) / 16.667, 0.5, 3) : 1;\n      lastT = now;\n      var p = progress();\n      updateHero(p);\n      if (ready) {\n        target = p * video.duration;\n        current += (target - current) * (1 - Math.pow(1 - EASE, dt));\n        if (Math.abs(target - current) < 0.005) current = target;\n        seek(current);\n      }\n      if (visible && (!ready || Math.abs(current - target) > 0.005)) start();\n    }\n\n    function start() {\n      if (!rafId && visible) rafId = requestAnimationFrame(frame);\n    }\n\n    function markReady() {\n      if (ready) return;\n      ready = true;\n      current = target = progress() * video.duration;\n      seek(current);\n      section.classList.add('is-ready');\n      setTimeout(function () { section.classList.add('is-in'); }, 250);\n      start();\n    }\n\n    function prime() {\n      var pr;\n      try { pr = video.play(); } catch (e) {}\n      if (pr && pr.then) pr.then(function () { video.pause(); markReady(); }).catch(markReady);\n      else { video.pause(); markReady(); }\n    }\n\n    function attach(src) { video.src = src; video.load(); }\n\n    function loadVideo() {\n      var src = mobileQuery.matches ? section.dataset.mobile : section.dataset.desktop;\n      if (!src || src === activeSrc) return;\n      activeSrc = src;\n      ready = false;\n      section.classList.remove('is-ready');\n      var my = ++token;\n      video.pause();\n      if (!window.fetch || mem <= 1) { attach(src); return; }\n      fetch(src, { mode: 'cors' })\n        .then(function (r) { if (!r.ok) throw 0; return r.blob(); })\n        .then(function (b) {\n          if (my !== token) return;\n          if (blobUrl) URL.revokeObjectURL(blobUrl);\n          blobUrl = URL.createObjectURL(b);\n          attach(blobUrl);\n        })\n        .catch(function () { if (my === token) attach(src); });\n    }\n\n    video.addEventListener('loadeddata', function () {\n      if (isFinite(video.duration)) prime();\n    });\n    video.addEventListener('seeked', start);\n    video.addEventListener('error', function () {\n      if (video.src.indexOf('blob:') === 0) { attach(activeSrc); return; }\n      video.loop = true;\n      section.classList.add('is-ready');\n      video.play().catch(function () {});\n    });\n\n    window.addEventListener('touchstart', function () {\n      if (!ready) return;\n      var pr = video.play();\n      if (pr && pr.then) pr.then(function () { video.pause(); seek(current); }).catch(function () {});\n    }, { once: true, passive: true });\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function (entries) {\n        visible = entries[0].isIntersecting;\n        if (visible) { lastT = 0; start(); }\n        else if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }\n      }, { rootMargin: '100px 0px' }).observe(track);\n    } else {\n      visible = true;\n      section.classList.remove('pfx-anim');\n    }\n\n    var resizeT;\n    function onResize() {\n      clearTimeout(resizeT);\n      resizeT = setTimeout(function () {\n        setScrollLength(); applyOffset(); measure(); start();\n      }, 150);\n    }\n    window.addEventListener('scroll', start, { passive: true });\n    window.addEventListener('resize', onResize, { passive: true });\n    window.addEventListener('load', onResize);\n\n    function onDeviceChange() {\n      setScrollLength();\n      loadVideo();\n      measure();\n      start();\n    }\n    if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', onDeviceChange);\n    else mobileQuery.addListener(onDeviceChange);\n\n    fixStickyAncestors();\n    setScrollLength();\n    applyOffset();\n    measure();\n    loadVideo();\n    updateHero(progress());\n    setTimeout(function () { section.classList.add('is-in'); }, 4000);\n  }\n\n  function boot() { document.querySelectorAll('.pfx').forEach(initPFX); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n  document.addEventListener('shopify:section:load', boot);\n})();\n</script>",
