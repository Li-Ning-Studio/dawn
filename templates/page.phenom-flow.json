on .hnpf-traction-cta:hover {\n    background: #ffffff !important;\n    color: #000000!important;\n\n    transform: translateY(-2px);\n\n    box-shadow:\n      0 10px 28px rgba(255,255,255,.12);\n  }\n\n  .hnpf-traction .hnpf-traction-cta:hover svg {\n    transform: translateX(3px);\n  }\n}\n\n/* =====================================\n   KEYBOARD FOCUS\n===================================== */\n\n.hnpf-traction .hnpf-traction-cta:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* =====================================\n   TABLET\n===================================== */\n\n@media (min-width: 769px) and (max-width: 1024px) {\n  .hnpf-traction-content {\n    padding: 45px 25px;\n  }\n\n  .hnpf-traction .hnpf-traction-title {\n    font-size: clamp(26px, 3vw, 36px) !important;\n  }\n\n  .hnpf-traction .hnpf-traction-description {\n    font-size: 14px !important;\n  }\n}\n\n/* =====================================\n   MOBILE\n===================================== */\n\n@media (max-width: 768px) {\n  .hnpf-traction-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  /* IMAGE FIRST */\n  .hnpf-traction-media {\n    order: -1;\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .hnpf-traction-media img {\n    width: 100% !important;\n    height: auto !important;\n    object-fit: contain !important;\n  }\n\n  /* CONTENT BELOW */\n  .hnpf-traction-content {\n    order: 1;\n    padding: 52px 28px 58px;\n  }\n\n  .hnpf-traction-inner {\n    max-width: 460px;\n  }\n\n  .hnpf-traction .hnpf-traction-label {\n    margin-bottom: 14px;\n    font-size: 10px !important;\n  }\n\n  .hnpf-traction .hnpf-traction-title {\n    margin-bottom: 16px;\n    font-size: clamp(24px, 6.2vw, 32px) !important;\n    line-height: 1.15 !important;\n  }\n\n  .hnpf-traction .hnpf-traction-description {\n    font-size: 15px !important;\n    line-height: 1.6 !important;\n  }\n\n  .hnpf-traction .hnpf-traction-cta,\n  .hnpf-traction .hnpf-traction-cta:visited {\n    min-height: 44px;\n    margin-top: 24px;\n    padding: 10px 20px;\n    font-size: 13px !important;\n  }\n}\n\n/* =====================================\n   SMALL MOBILE\n===================================== */\n\n@media (max-width: 400px) {\n  .hnpf-traction-content {\n    padding: 46px 22px 52px;\n  }\n\n  .hnpf-traction .hnpf-traction-title {\n    font-size: 24px !important;\n  }\n\n  .hnpf-traction .hnpf-traction-description {\n    font-size: 15px !important;\n  }\n}\n\n/* =====================================\n   REDUCED MOTION\n===================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .hnpf-traction .hnpf-traction-cta,\n  .hnpf-traction .hnpf-traction-cta svg {\n    transition: none !important;\n  }\n}\n</style>\n\n<section class=\"hnpf-traction\">\n  <div class=\"hnpf-traction-grid\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"hnpf-traction-content\">\n      <div class=\"hnpf-traction-inner\">\n\n        <!-- LABEL -->\n        <p class=\"hnpf-traction-label\">\n        </p>\n\n        <!-- HEADING -->\n        <h2 class=\"hnpf-traction-title\">\nJUST BREATHE\n        </h2>\n\n        <!-- DESCRIPTION -->\n        <p class=\"hnpf-traction-description\">\n          Air moves through the insole, the plate and the upper, keeping every layer of the shoe cool and comfortable.\n\n\n        </p>\n\n        <!-- CTA -->\n        <a\n          class=\"hnpf-traction-cta\"\n          href=\"https://in.hndrd.co/products/phenom-flow\"\n          aria-label=\"Explore HNDRD Phenom Flow\"\n        >\n          EXPLORE PHENOM FLOW\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M5 12h14m-6-6 6 6-6 6\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </a>\