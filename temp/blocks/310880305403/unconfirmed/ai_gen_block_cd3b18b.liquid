{% doc %}
  @prompt
    lav en blok under som jeg kan lave om til hvad jeg vil ved at redigere koden i det 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-custom-code-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
  }

  .ai-custom-code-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-custom-code-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding }}px;
    }
  }
{% endstyle %}

<div
  class="ai-custom-code-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "Custom code",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code",
      "default": "<h2>Indsæt din egen kode her</h2><p>Redigér dette felt for at tilpasse indholdet.</p>"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#334FB4"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Desktop padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom code"
    }
  ],
  "tag": null,
  "class": "custom-code-block"
}
{% endschema %}