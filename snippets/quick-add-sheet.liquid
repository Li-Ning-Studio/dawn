{% comment %}
  Quick-add sheet: a small panel that slides up to pick a variant and add it to the cart without
  leaving the page. Behaviour and styles: assets/quick-add-sheet.js, assets/quick-add-sheet.css
  (both loaded globally in layout/theme.liquid, so sheets rendered later by AJAX still work).

  Usage (any product card, drawer row, etc.):
    {%- capture customisations -%}{% render 'product-customisations', product: product %}{%- endcapture -%}
    {%- if customisations != blank -%}
      link to product.url (customisable products are customised on the PDP, never quick-added)
    {%- elsif product.variants.size == 1 -%}
      add directly (e.g. QuickAddSheet.addVariant(variantId, button) in JS)
    {%- else -%}
      <button type="button" data-quick-add-sheet aria-haspopup="dialog" aria-expanded="false" aria-controls="QuickAddSheet-{{ product.id }}">…</button>
      {% render 'quick-add-sheet', product: product %}
    {%- endif -%}
  The opener can live anywhere on the page; it finds the sheet by id. Render a product's sheet
  once per page (the id is per product).

  Accepts:
  - product: {Object} Product with more than one variant (single-variant products should add directly).

  Behaviour:
  - One option (colour-only, size-only): tapping an available chip adds that variant at once.
  - Several options (e.g. shoe colour + size): one chip per option, then "Add to Bag". Nothing is
    preselected, so a size is never guessed. Chips with no available matching variant are disabled.
  - While open it is moved into <body>: full-width bottom sheet on mobile, centred dialog on
    desktop, above the cart drawer.
{% endcomment %}
{%- assign quick_add_title = 'sections.cart.upsell.quick_add_title' | t: title: product.title -%}
<quick-add-sheet
  id="QuickAddSheet-{{ product.id }}"
  class="quick-add-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="{{ quick_add_title }}"
  data-adding-label="{{ 'sections.cart.upsell.adding' | t | escape }}"
  hidden
>
  <span class="quick-add-sheet__backdrop" data-quick-add-close aria-hidden="true"></span>
  <div class="quick-add-sheet__panel">
    <div class="quick-add-sheet__head">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 240
          | image_tag: class: 'quick-add-sheet__image', alt: '', loading: 'lazy', width: 96, height: 96
        }}
      {%- endif -%}
      <div class="quick-add-sheet__info">
        <span class="quick-add-sheet__title">{{ quick_add_title }}</span>
        <span class="quick-add-sheet__price">
          {%- comment -%} Updated to the chosen variant's price by quick-add-sheet.js once all options are picked. {%- endcomment -%}
          {%- if product.price_varies -%}
            {%- assign lowest_price = product.price | money -%}
            {{- 'products.product.price.from_price_html' | t: price: lowest_price -}}
          {%- else -%}
            {{- product.price | money -}}
          {%- endif -%}
        </span>
      </div>
      <button
        type="button"
        class="quick-add-sheet__close"
        data-quick-add-close
        aria-label="{{ 'accessibility.close' | t | escape }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>
    {%- for option in product.options_with_values -%}
      <div class="quick-add-sheet__option" role="group" aria-label="{{ option.name | escape }}">
        <span class="quick-add-sheet__option-name">{{ option.name | escape }}</span>
        <div class="quick-add-sheet__chips" data-option-index="{{ forloop.index0 }}">
          {%- for value in option.values -%}
            {%- comment -%}
              One option + varying prices: a tap adds at once, so the chip shows that variant's price.
            {%- endcomment -%}
            {%- assign chip_variant = null -%}
            {%- if product.options.size == 1 and product.price_varies -%}
              {%- assign chip_variant = product.variants | where: 'option1', value | first -%}
            {%- endif -%}
            <button type="button" class="quick-add-sheet__chip" data-value="{{ value | escape }}" aria-pressed="false">
              {{- value | escape -}}
              {%- if chip_variant %} · {{ chip_variant.price | money }}{% endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
    {%- if product.options.size > 1 -%}
      <button type="button" class="quick-add-sheet__add button" disabled>
        {{- 'products.product.add_to_cart' | t -}}
      </button>
    {%- endif -%}
    <script type="application/json" data-variants>
      [
        {%- for variant in product.variants -%}
          {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }}}
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    </script>
  </div>
</quick-add-sheet>
