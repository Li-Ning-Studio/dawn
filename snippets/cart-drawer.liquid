{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'cart-drawer-trending', collection: settings.cart_drawer_collection %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div style="margin: 1rem 2rem;" class="drawer__header">
        <h2 class="drawer__heading">
          {{ 'sections.cart.title' | t -}}
          {%- if cart.item_count > 0 %}
            <span class="drawer__count">({{ cart.item_count }})</span>
          {%- endif -%}
        </h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        {%- comment -%}
          Rewards progress bar (Kaching-style). DISPLAY ONLY: the real rewards come from
          Shopify discounts the merchant creates (free shipping, % off at a minimum, gift).
          Milestone amounts in theme settings (Cart → Rewards progress bar) must be kept in
          sync with those discounts by hand. Amounts are in shop currency major units and
          entered in ascending order. Progress uses cart.items_subtotal_price (after line
          discounts, before cart-level discounts). Lives inside <cart-drawer-items> so every
          drawer re-render path (cart-drawer.js, cart.js) refreshes it without extra JS.
        {%- endcomment -%}
        {%- if settings.cart_progress_enabled and cart != empty -%}
          {%- liquid
            assign subtotal = cart.items_subtotal_price
            assign ms_count = 0
            assign max_threshold = 0
            assign last_reached_label = ''
            assign next_label = ''
            assign next_threshold = 0
            for n in (1..3)
              assign amount_key = 'cart_milestone_' | append: n | append: '_amount'
              assign label_key = 'cart_milestone_' | append: n | append: '_label'
              assign amount = settings[amount_key] | default: 0
              assign label = settings[label_key]
              if amount > 0 and label != blank
                assign threshold = amount | times: 100
                assign ms_count = ms_count | plus: 1
                assign max_threshold = threshold
                if subtotal >= threshold
                  assign last_reached_label = label
                  assign last_reached_n = n
                  assign unlocked_key = 'cart_milestone_' | append: n | append: '_unlocked'
                  assign last_reached_text = settings[unlocked_key]
                elsif next_label == blank
                  assign next_label = label
                  assign next_threshold = threshold
                endif
              endif
            endfor
            # Per-milestone "Unlocked text" setting; empty = "Eligible for <label>" (sections.cart.progress.unlocked).
            # default filter, not if/else: this file sits at the Theme Check complexity limit.
            assign unlocked_fallback = 'sections.cart.progress.unlocked' | t: reward: last_reached_label
            assign unlocked_text = last_reached_text | default: unlocked_fallback | escape
          -%}
          {%- if ms_count > 0 -%}
            {%- assign fill = subtotal | times: 100 | divided_by: max_threshold | at_most: 100 -%}
            <div class="cart-progress" role="status">
              <p class="cart-progress__message">
                {%- if next_label == blank -%}
                  {%- liquid
                    # Everything reached: a tinted banner with the last (highest) reward's icon and name.
                    assign icon_key = 'cart_milestone_' | append: last_reached_n | append: '_icon'
                    # Empty = gift icon. No "contains <svg" branch here (complexity limit): stray
                    # non-SVG text is hidden by font-size: 0 on .cart-progress__banner-icon instead.
                    assign icon_fallback = 'icon-gift.svg' | inline_asset_content
                    assign icon = settings[icon_key] | default: icon_fallback
                  -%}
                  <span class="cart-progress__banner-icon" aria-hidden="true">{{ icon }}</span>
                  <span>{{ unlocked_text }}</span>
                {%- else -%}
                  {%- if last_reached_label != blank -%}
                    {{ unlocked_text }}
                  {% endif -%}
                  {%- assign remaining = next_threshold | minus: subtotal | money -%}
                  {{ 'sections.cart.progress.add_to_unlock_html' | t: amount: remaining, reward: next_label }}
                {%- endif -%}
              </p>
              <div class="cart-progress__track meter">
                <div class="cart-progress__fill meter__fill" style="width: {{ fill }}%;"></div>
                {%- for n in (1..3) -%}
                  {%- liquid
                    assign amount_key = 'cart_milestone_' | append: n | append: '_amount'
                    assign label_key = 'cart_milestone_' | append: n | append: '_label'
                    assign icon_key = 'cart_milestone_' | append: n | append: '_icon'
                    assign amount = settings[amount_key] | default: 0
                    assign label = settings[label_key]
                  -%}
                  {%- if amount > 0 and label != blank -%}
                    {%- liquid
                      assign threshold = amount | times: 100
                      assign left = threshold | times: 100 | divided_by: max_threshold
                      # Merchant-pasted SVG (same pattern as product-highlight icons); gift icon fallback.
                      assign icon = settings[icon_key]
                      # Non-SVG text (e.g. old select values like "shipping") also falls back.
                      unless icon contains '<svg'
                        assign icon = 'icon-gift.svg' | inline_asset_content
                      endunless
                    -%}
                    <div
                      class="cart-progress__milestone{% if subtotal >= threshold %} is-reached{% endif %}"
                      style="--left: {{ left }}%;"
                    >
                      <span class="cart-progress__marker" aria-hidden="true">
                        {{- icon -}}
                      </span>
                      <span class="cart-progress__label">
                        {%- if subtotal >= threshold -%}
                          {{- 'icon-checkmark.svg' | inline_asset_content -}}
                        {%- endif -%}
                        {{- label | escape -}}
                      </span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
        <form
          style="padding: 1rem 2rem;"
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <bxgy-notice role="status" hidden></bxgy-notice>
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  {%- # Column headings stay for screen readers only; the row layout makes them obvious. -%}
                  <thead class="visually-hidden" role="rowgroup">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      {%- liquid
                        # Keep every Shopify cart line in the DOM. The native relationship
                        # controls grouping; _customisationId is never used as structure.
                        assign nested_parent = item.parent_relationship.parent
                        assign has_nested_children = false
                        assign has_customisation_group = false
                        assign is_customised_parent = false
                        assign grouped_original_line_price = item.original_line_price
                        assign grouped_final_line_price = item.final_line_price
                        # Strung racket: the stringing service child line (assets/product-form.js
                        # getStringingSelection) carries _tension ("26lbs"). The string name already
                        # shows under "Show bundle", so only the tension sits next to the options.
                        assign strung_tension = blank

                        if nested_parent == blank and item.properties._customisationId != blank
                          assign is_customised_parent = true
                        endif

                        if nested_parent == blank
                          for candidate in cart.items
                            if candidate.parent_relationship.parent.key == item.key
                              assign has_nested_children = true
                              assign grouped_original_line_price = grouped_original_line_price | plus: candidate.original_line_price
                              assign grouped_final_line_price = grouped_final_line_price | plus: candidate.final_line_price
                              if candidate.properties._tension != blank
                                assign strung_tension = candidate.properties._tension | replace: 'lbs', ' lbs'
                              endif
                            endif
                          endfor
                        endif

                        if item.item_components.size > 0 or has_nested_children
                          assign has_customisation_group = true
                        endif
                      -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item"
                        data-milestone-gift="{{ item.properties._milestoneGift }}"
                        role="row"
                        {% if nested_parent != blank %}
                          hidden
                        {% endif %}
                      >
                        <td class="cart-item__media" role="cell" headers="CartDrawer-ColumnProductImage">
                          {% assign image = item.image %}
                          {% if item.item_components.size > 0 %}
                            {% assign main_product = null %}
                            {% for component in item.item_components %}
                              {% if component.properties._bundleRole == 'main' %}
                                {% assign main_product = component %}
                                {% break %}
                              {% endif %}
                            {% endfor %}
                            {% if main_product %}
                              {% assign image = main_product.image %}
                            {% endif %}
                          {% endif %}
                          {% if image %}
                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ image | image_url: width: 300 }}"
                              alt="{{ image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          {% if item.item_components.size > 0 %}
                            <div
                              style="margin-bottom: 3px;"
                              class="cart-item__name{% if is_customised_parent %} cart-item__name--customised{% endif %} h4 break"
                            >
                              {{ item.title }}
                              {% if is_customised_parent %}
                                <img
                                  class="cart-item__customisation-icon"
                                  src="{{ 'icon-spark.svg' | asset_url }}"
                                  alt=""
                                  width="16"
                                  height="16"
                                  aria-hidden="true"
                                >
                              {% endif %}
                            </div>
                          {% else %}
                            <a
                              style="margin-bottom: 3px;"
                              href="{{ item.url }}"
                              class="cart-item__name{% if is_customised_parent %} cart-item__name--customised{% endif %} h4 break"
                            >
                              {{ item.product.title | escape }}
                              {% if is_customised_parent %}
                                <img
                                  class="cart-item__customisation-icon"
                                  src="{{ 'icon-spark.svg' | asset_url }}"
                                  alt=""
                                  width="16"
                                  height="16"
                                  aria-hidden="true"
                                >
                              {% endif %}
                            </a>
                          {% endif %}

                          {% comment %}
                            {%- if item.original_price != item.final_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price product-option">
                                  {{- item.original_price | money -}}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <strong class="cart-item__final-price product-option">
                                  {{ item.final_price | money }}
                                </strong>
                              </div>
                            {%- else -%}
                              <div class="product-option">
                                {{ item.original_price | money }}
                              </div>
                            {%- endif -%}
                          {% endcomment %}

                          {% if item.item_components.size > 0 %}
                            <dl style="display: none; justify-content: space-between; align-items: center; margin-top: 1rem">
                              <div
                                class="cart-item__name"
                                style="
                                  background: linear-gradient(white, white) padding-box, linear-gradient(45deg, #333, #777) border-box;
                                  border: 1px solid transparent;
                                  border-radius: 27px;
                                  padding: 0.5rem 1rem;
                                  display: inline-flex;
                                  align-items: center;
                                  gap: 0.5rem;
                                "
                              >
                                <svg
                                  width="20px"
                                  height="20px"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  xmlns="http://www.w3.org/2333/svg"
                                  stroke-width="1.8"
                                  style="fill: url(#gradient); stroke: url(#gradient);"
                                >
                                  <defs>
                                    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                      <stop offset="0%" style="stop-color:#333"/>
                                      <stop offset="50%" style="stop-color:#777"/>
                                      <stop offset="100%" style="stop-color:#333"/>
                                    </linearGradient>
                                  </defs>
                                  <path d="M8 15C12.8747 15 15 12.949 15 8C15 12.949 17.1104 15 22 15C17.1104 15 15 17.1104 15 22C15 17.1104 12.8747 15 8 15Z" stroke-linejoin="round"></path>
                                  <path d="M2 6.5C5.13376 6.5 6.5 5.18153 6.5 2C6.5 5.18153 7.85669 6.5 11 6.5C7.85669 6.5 6.5 7.85669 6.5 11C6.5 7.85669 5.13376 6.5 2 6.5Z" stroke-linejoin="round"></path>
                                </svg>
                                <span
                                  style="
                                    background: linear-gradient(45deg, #333, #777);
                                    -webkit-background-clip: text;
                                    background-clip: text;
                                    -webkit-text-fill-color: transparent;
                                    color: transparent;
                                  "
                                >
                                  Customisation
                                </span>
                              </div>

                              <div>
                                <cart-remove-button
                                  id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                  <button
                                    type="button"
                                    class="button button--tertiary cart-remove-button"
                                    aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                    data-variant-id="{{ item.variant.id }}"
                                  >
                                    <span class="svg-wrapper">
                                      {{- 'icon-remove.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </cart-remove-button>
                              </div>
                            </dl>
                          {% endif %}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    {% comment %} <dt>{{ option.name }}:</dt> {% endcomment %}
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                                {%- if strung_tension != blank -%}
                                  <div class="product-option">
                                    <dd>&middot; {{ strung_tension }}</dd>
                                  </div>
                                {%- endif -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          {%- if has_customisation_group -%}
                            {%- assign item_position = item.index | plus: 1 -%}
                            {%- assign bundle_items_id = 'CartDrawerBundleItems-' | append: item_position -%}
                            <button
                              type="button"
                              class="bundle-toggle product-option"
                              data-bundle-toggle
                              data-show-label="{{ 'sections.cart.show_bundle' | t | escape }}"
                              data-hide-label="{{ 'sections.cart.hide_bundle' | t | escape }}"
                              aria-controls="{{ bundle_items_id }}"
                              aria-expanded="false"
                            >
                              {{- 'sections.cart.show_bundle' | t -}}
                            </button>

                            <div id="{{ bundle_items_id }}" class="bundle-items" aria-hidden="true">
                              {%- for component in item.item_components -%}
                                <div>
                                  <span class="bundle-item__name product-option">
                                    {{ component.product.title | escape }} -
                                  </span>
                                  <span class="bundle-item__price product-option">
                                    {%- if component.original_price == 0 -%}
                                      {{ 'sections.cart.free' | t }}
                                    {%- else -%}
                                      {{ component.original_price | money }}
                                    {%- endif -%}
                                  </span>
                                </div>
                              {%- endfor -%}
                              {%- if has_nested_children -%}
                                {%- for candidate in cart.items -%}
                                  {%- if candidate.parent_relationship.parent.key == item.key -%}
                                    <div>
                                      <span class="bundle-item__name product-option">
                                        {{ candidate.product.title | escape }} -
                                      </span>
                                      <span class="bundle-item__price product-option">
                                        {%- if candidate.final_line_price == 0 -%}
                                          {{ 'sections.cart.free' | t }}
                                        {%- else -%}
                                          {{ candidate.final_line_price | money }}
                                        {%- endif -%}
                                      </span>
                                    </div>
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                            </div>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>

                        <td
                          class="cart-item__totals right"
                          role="cell"
                          headers="CartDrawer-ColumnTotal"
                        >
                          {%- render 'loading-spinner' -%}
                          <div class="cart-item__price-wrapper">
                            {%- if grouped_original_line_price != grouped_final_line_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price price price--end">
                                  {{ grouped_original_line_price | money }}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <span class="price price--end">
                                  {%- # A ₹0 line (e.g. BXGY free string) reads FREE instead of ₹0. -%}
                                  {%- if grouped_final_line_price == 0 -%}
                                    {{ 'sections.cart.free' | t }}
                                  {%- else -%}
                                    {{ grouped_final_line_price | money }}
                                  {%- endif -%}
                                </span>
                              </div>
                            {%- else -%}
                              <span class="price price--end">
                                {{ grouped_original_line_price | money }}
                              </span>
                            {%- endif -%}

                            {%- if item.variant.available and item.unit_price_measurement -%}
                              <div class="unit-price caption">
                                <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                                {{ item.unit_price | money }}
                                <span aria-hidden="true">/</span>
                                <span class="visually-hidden"
                                  >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                                >
                                {%- if item.unit_price_measurement.reference_value != 1 -%}
                                  {{- item.unit_price_measurement.reference_value -}}
                                {%- endif -%}
                                {{ item.unit_price_measurement.reference_unit }}
                              </div>
                            {%- endif -%}
                          </div>
                        </td>
                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif

                          assign can_update_quantity = true
                          if item.instructions and item.instructions.can_update_quantity == false
                            assign can_update_quantity = false
                          endif
                          if has_customisation_group
                            assign can_update_quantity = false
                          endif

                          assign can_remove = true
                          if item.instructions and item.instructions.can_remove == false
                            assign can_remove = false
                          endif
                        -%}
                        <td
                          class="cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                          role="cell"
                          headers="CartDrawer-ColumnQuantity"
                        >
                          <quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              {%- # Shown only on milestone gift rows (data-milestone-gift); stepper and Remove are hidden there. -%}
                              <span class="cart-item__gift-tag">{{ 'sections.cart.milestone_gift' | t }}</span>
                              <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                <quantity-input class="quantity cart-quantity">
                                  <button
                                    {% unless can_update_quantity %}
                                      disabled
                                    {% endunless %}
                                    class="quantity__button"
                                    name="minus"
                                    type="button"
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.decrease'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {%- # Drawn on the same 24px grid as icon-plus.svg so − and + match in size and weight. -%}
                                      <svg class="icon icon-minus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M6 12H18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                      </svg>
                                    </span>
                                  </button>
                                  <input
                                    {% unless can_update_quantity %}
                                      disabled
                                    {% endunless %}
                                    class="quantity__input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    name="updates[{{ item.key | escape }}]"
                                    value="{{ item.quantity }}"
                                    {% # theme-check-disable %}
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="{{ item.variant.quantity_rule.min }}"
                                    {% if item.variant.quantity_rule.max != null %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    {% # theme-check-enable %}
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                  >
                                  <button
                                    {% unless can_update_quantity %}
                                      disabled
                                    {% endunless %}
                                    class="quantity__button"
                                    name="plus"
                                    type="button"
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.increase'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </quantity-input>
                              </div>
                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% unless can_remove %}
                                  class="hidden"
                                {% endunless %}
                              >
                                <button
                                  type="button"
                                  class="button button--tertiary cart-remove-button"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                >
                                  {{- 'sections.cart.remove' | t -}}
                                </button>
                              </cart-remove-button>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>{{ price_break.price | money_with_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
          <!-- Cart Recommendations -->

          {%- if cart != empty -%}
            {%- assign upsell_heading = 'sections.cart.upsell.heading' | t -%}
            {%- render 'cart-recommendations', limit: 5, heading: upsell_heading, layout: 'list' -%}
          {%- endif -%}
        </form>
      </cart-drawer-items>
      <div style="padding: 2rem;" class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <!-- Start blocks -->
        <!-- Subtotals -->

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          <div class="totals" role="status">
            <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
            <p class="">{{ cart.total_price | money_with_currency }}</p>
          </div>

          {%- liquid
            # Total savings = what every line would cost at its compare-at price (or regular
            # price when there's no higher compare-at) minus what the customer actually pays.
            # Covers sale prices plus all discounts (line-level and cart-level, e.g. BXGY free
            # strings). `at_least` picks the higher price without an extra condition.
            assign list_total = 0
            for item in cart.items
              assign unit_list_price = item.variant.compare_at_price | default: 0 | at_least: item.original_price
              assign line_list_price = unit_list_price | times: item.quantity
              assign list_total = list_total | plus: line_list_price
            endfor
            assign total_savings = list_total | minus: cart.total_price
          -%}
          {%- if total_savings > 0 -%}
            <div class="cart-drawer__savings">
              <span>{{ 'sections.cart.total_savings' | t }}</span>
              <span class="cart-drawer__savings-amount">{{ total_savings | money }}</span>
            </div>
          {%- endif -%}

          <small class="tax-note caption-large rte">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- endif -%}
          </small>
        </div>

        <!-- CTAs -->

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          {% if settings.is_gokwik_enabled == true %}
            {% render 'gokwik-checkout-button' %}
          {% else %}
            <button
              style="padding: 2.5rem 0"
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button"
              name="checkout"
              form="CartDrawer-Form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              {{ 'sections.cart.checkout' | t }}
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
