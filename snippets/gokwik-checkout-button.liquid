<div class="gokwik-checkout">
  <button
    style="padding: 3rem 0rem;"
    {% if cart == empty %}
      disabled
    {% endif %}
    type="button"
    class="button"
    onclick="initiateLogin()"
  >
    <span class="btn-text">
      <span> {{ 'sections.cart.checkout' | t }}</span>
    </span>
  </button>
</div>
