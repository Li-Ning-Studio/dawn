{% comment %}
  Renders a list of product's price (regular, sale)

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - placeholder: {Boolean} Renders a placeholder price (optional)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - price_class: {String} Adds a price class to the price element (optional)
  - show_compare_at_price: {Boolean} Renders the compare at price if the product matches the condition (optional)
  - show_tax_note: {Boolean} Renders the tax-included note when the theme setting is enabled (optional)

  Usage:
  {% render 'price', product: product %}
{% endcomment %}

{%- comment -%}
  Explicit flag to show savings percent text next to price.
  Default is false so cards/sections don't render it unless opted in.
{%- endcomment -%}
{% if show_savings_percent == null %}{% assign show_savings_percent = false %}{% endif %}
{% if show_tax_note == null %}{% assign show_tax_note = false %}{% endif %}

{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  elsif placeholder
    assign target = null
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign price_min = product.price_min
  assign price_max = product.price_max
  assign available = target.available | default: false
  assign money_price = price | money
  assign money_price_min = price_min | money
  assign money_price_max = price_max | money
  assign saving_percentage = 0
  assign show_savings_badge = false
  assign has_compare_at_price = false
  assign should_show_compare_at_price = false
  assign should_suppress_compare_at_price = false
  if compare_at_price > price
    assign has_compare_at_price = true
  endif
  if target == product and product.price_varies == false and product.compare_at_price_varies
    assign should_suppress_compare_at_price = true
  endif
  if show_compare_at_price and has_compare_at_price and should_suppress_compare_at_price == false
    assign should_show_compare_at_price = true
  endif
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
  endif

  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  if show_savings_percent and available and shop.currency != 'AED' and should_show_compare_at_price and price > 0
    assign saving_percentage = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | round
    if saving_percentage > 0
      assign show_savings_badge = true
    endif
  endif
-%}

{%- unless target == null and placeholder == null -%}
  <div
    class="
      price
      {%- if price_class %} {{ price_class }}{% endif -%}
      {%- if available == false %} price--sold-out{% endif -%}
      {%- if has_compare_at_price and product.quantity_price_breaks_configured? != true %} price--on-sale{% endif -%}
      {%- if should_suppress_compare_at_price %} price--no-compare{% endif -%}
    "
  >
    <div class="price__top-row">
      <div class="price__container s3_paragraph">
        {%- comment -%}
          Explanation of description list:
            - div.price__regular: Displayed when there are no variants on sale
            - div.price__sale: Displayed when a variant is a sale
        {%- endcomment -%}
        <div class="price__regular">
          {%- if product.quantity_price_breaks_configured? -%}
            {%- if should_show_compare_at_price -%}
              <span class="visually-hidden visually-hidden--inline">
                {{- 'products.product.price.regular_price' | t -}}
              </span>
              <span>
                <s class="price-item price-item--regular variant-item__old-price">
                  {% if settings.currency_code_enabled %}
                    {{ compare_at_price | money_with_currency }}
                  {% else %}
                    {{ compare_at_price | money }}
                  {% endif %}
                </s>
              </span>
            {%- endif -%}
            <span class="visually-hidden visually-hidden--inline">
              {{- 'products.product.price.regular_price' | t -}}
            </span>
            <span class="price-item price-item--regular">
              {{-
                'products.product.volume_pricing.price_range'
                | t: minimum: money_price_min, maximum: money_price_max
              -}}
            </span>
          {%- else -%}
            <span class="visually-hidden visually-hidden--inline">
              {{- 'products.product.price.regular_price' | t -}}
            </span>
            <span class="price-item price-item--regular">
              {{ money_price }}
            </span>
          {%- endif -%}
        </div>
        <div class="price__sale">
          <span class="price-item price-item--sale">
            {{ money_price }}
          </span>
          <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
          {% if should_show_compare_at_price %}
            <span>
              <s class="price-item price-item--regular price-item--last">
                {% if settings.currency_code_enabled -%}
                  {{ compare_at_price | money_with_currency }}
                {% else %}
                  {{ compare_at_price | money }}
                {% endif %}
              </s>
            </span>
            <span class="visually-hidden visually-hidden--inline">
              {{- 'products.product.price.regular_price' | t -}}
            </span>
          {% endif %}
        </div>
        {% if show_tax_note and settings.show_prices_incl_taxes_message %}
          <small class="price-item price__tax-note--inline s3_paragraph">
            {{ 'products.product.all_prices_incl_taxes' | t }}
          </small>
        {% endif %}
        <small class="unit-price caption{% if target.unit_price_measurement == nil %} hidden{% endif %}">
          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
          <span class="price-item price-item--last">
            <span>{{- target.unit_price | money -}}</span>
            <span aria-hidden="true">/</span>
            <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
            <span>
              {%- if target.unit_price_measurement.reference_value != 1 -%}
                {{- target.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ target.unit_price_measurement.reference_unit }}
            </span>
          </span>
        </small>
      </div>
      {%- if show_savings_badge -%}
        <span
          style="overflow: hidden;"
          id="PriceSavingsBadge-{{ section_id | default: section.id }}"
          class="price__savings badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
        >
          {{ saving_percentage }}% OFF
        </span>
      {% endif %}
    </div>
  </div>
{% endunless %}
