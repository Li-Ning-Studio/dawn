{% comment %}
  Renders a product media gallery with only media for the selected variant.
  When a variant is selected, only shows media associated with that variant.

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - limit: {Number} (optional) When passed, limits the number of media items to render

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant

  if section.settings.hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif

  if limit == 1
    assign single_media_visible = true
  endif

  if selected_variant.metafields.custom_but_hidden.media.value != blank
    assign variant_media_references = selected_variant.metafields.custom_but_hidden.media.value
  else
    assign selected_option_1 = selected_variant.options.first | downcase
    for variant in product.variants
      assign current_option_1 = variant.options.first | downcase

      if selected_option_1 == current_option_1 and variant.metafields.custom_but_hidden.media.value != blank
        assign variant_media_references = variant.metafields.custom_but_hidden.media.value
        break
      endif
    endfor
  endif

  if variant_media_references == blank and selected_variant.featured_media != blank
    assign media_references = product.media | where: 'id', selected_variant.featured_media.id
  elsif variant_media_references != blank
    assign media_references = variant_media_references
  else
    assign media_references = product.media
  endif

  assign media_count = media_references.size

  if media_count < 1 and selected_variant.featured_media != blank
    assign media_count = 1
  endif

  if section.settings.media_size == 'large'
    assign media_width = 0.65
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.55
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif

  assign key_highlights_metafield = product.metafields.custom_but_hidden.key_highlights
  if key_highlights_metafield and key_highlights_metafield.value != blank
    assign key_highlight_keys = key_highlights_metafield.value
  endif

  assign highlight_image = product.media | where: 'media_type', 'image' | first
  assign key_highlights_count = 0

  if key_highlight_keys != blank
    for highlight_key in key_highlight_keys
      assign highlight_key_normalized = highlight_key | strip | downcase | replace: ' ', '_' | replace: '-', '_'
      assign highlight_metafield = product.metafields.custom[highlight_key_normalized] | default: product.metafields.custom[highlight_key]

      if highlight_metafield and highlight_metafield.value != blank
        assign key_highlights_count = key_highlights_count | plus: 1
      endif
    endfor
  endif

  if highlight_image != blank and key_highlights_count > 0
    assign should_render_highlights_slide = true
  endif

  assign show_thumbnails = false
  if section.settings.gallery_layout contains 'thumbnail'
    assign show_thumbnails = true
  endif
  if section.settings.mobile_thumbnails == 'show'
    assign show_thumbnails = true
  endif

  assign has_active_media = false
  assign has_active_thumb = false
-%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  {% if section.settings.enable_sticky_info %}
    class="product__column-sticky"
  {% endif %}
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-desktop-layout="{{ section.settings.gallery_layout }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <slider-component
    id="GalleryViewer-{{ section.id }}"
    class="slider-mobile-gutter"
    data-gallery-counter-target="#ProductGalleryCounter-{{ section.id }}"
  >
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>
    <ul
      id="Slider-Gallery-{{ section.id }}"
      class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile"
      role="list"
    >
      {%- if selected_variant.featured_media != null -%}
        {%- assign featured_media = selected_variant.featured_media -%}
        <li
          id="Slide-{{ section.id }}-{{ featured_media.id }}"
          class="product__media-item grid__item slider__slide is-active{% if single_media_visible %} product__media-item--single{% endif %}{% if featured_media.media_type != 'image' %} product__media-item--full{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
          data-media-id="{{ section.id }}-{{ featured_media.id }}"
        >
          {%- assign media_position = 1 -%}
          {%- assign has_active_media = true -%}
          {% render 'product-thumbnail',
            media: featured_media,
            media_count: media_count,
            position: media_position,
            desktop_layout: section.settings.gallery_layout,
            mobile_layout: section.settings.mobile_thumbnails,
            loop: section.settings.enable_video_looping,
            modal_id: section.id,
            xr_button: true,
            media_width: media_width,
            media_fit: section.settings.media_fit,
            constrain_to_viewport: section.settings.constrain_to_viewport,
            lazy_load: false
          %}
        </li>
      {%- endif -%}

      {% for media in media_references %}
        {%- unless media == empty -%}
          {% assign media_object = product.media | where: 'id', media.id | first %}
          {%- if media_object != null and media_object.id != selected_variant.featured_media.id -%}
            {%- liquid
              assign media_position = media_position | default: 0 | plus: 1
              assign lazy_load = false
              if media_position > 1
                assign lazy_load = true
              endif
            -%}
            <li
              id="Slide-{{ section.id }}-{{ media_object.id }}"
              class="product__media-item grid__item slider__slide{% unless has_active_media %} is-active{% endunless %}{% if single_media_visible %} product__media-item--single{% endif %}{% if media_object.media_type != 'image' %} product__media-item--full{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
              data-media-id="{{ section.id }}-{{ media_object.id }}"
            >
              {%- assign has_active_media = true -%}
              {% render 'product-thumbnail',
                media: media_object,
                media_count: media_count,
                position: media_position,
                desktop_layout: section.settings.gallery_layout,
                mobile_layout: section.settings.mobile_thumbnails,
                loop: section.settings.enable_video_looping,
                modal_id: section.id,
                xr_button: true,
                media_width: media_width,
                media_fit: section.settings.media_fit,
                constrain_to_viewport: section.settings.constrain_to_viewport,
                lazy_load: lazy_load
              %}
            </li>
          {%- endif -%}
        {%- endunless -%}
      {% endfor %}

      {%- if should_render_highlights_slide -%}
        {%- liquid
          assign media_position = media_position | default: 0 | plus: 1
        -%}
        <li
          id="Slide-{{ section.id }}-key-highlights"
          class="product__media-item grid__item slider__slide product__media-item--highlights{% unless has_active_media %} is-active{% endunless %}{% if single_media_visible %} product__media-item--single{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
          data-media-id="{{ section.id }}-key-highlights"
        >
          {%- assign has_active_media = true -%}
          {% render 'product-thumbnail',
            media: highlight_image,
            media_count: media_count,
            position: media_position,
            desktop_layout: section.settings.gallery_layout,
            mobile_layout: section.settings.mobile_thumbnails,
            loop: section.settings.enable_video_looping,
            modal_id: section.id,
            xr_button: true,
            media_width: media_width,
            media_fit: section.settings.media_fit,
            constrain_to_viewport: section.settings.constrain_to_viewport,
            lazy_load: true
          %}
          <div class="product__media-highlights">
            <div class="product__media-highlights__body">
              <p class="product__media-highlights__title">{{ 'products.product.key_highlights' | t }}</p>
              <ul class="product__media-highlights__list">
                {% for highlight_key in key_highlight_keys %}
                  {%- assign highlight_key_normalized = highlight_key
                    | strip
                    | downcase
                    | replace: ' ', '_'
                    | replace: '-', '_'
                  -%}
                  {%- assign highlight_metafield = product.metafields.custom[highlight_key_normalized]
                    | default: product.metafields.custom[highlight_key]
                  -%}
                  {% if highlight_metafield and highlight_metafield.value != blank %}
                    {%- assign highlight_label = highlight_metafield.definition.name
                      | default: highlight_key_normalized
                      | replace: '_', ' '
                      | capitalize
                    -%}
                    <li class="product__media-highlights__item">
                      <span class="product__media-highlights__label">{{ highlight_label }}</span>
                      <span class="product__media-highlights__value">{{ highlight_metafield | metafield_text }}</span>
                      <hr class="product__media-highlights__divider">
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        </li>
      {%- endif -%}
    </ul>
    <div class="slider-buttons product__media-slider-buttons quick-add-hidden">
      <button
        style="opacity: 0; visibility: hidden"
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <button
        style="opacity: 0; visibility: hidden"
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  </slider-component>

  {%- if show_thumbnails and single_media_visible != true and media_count > 1 -%}
    <slider-component
      id="GalleryThumbnails-{{ section.id }}"
      class="thumbnail-slider slider-mobile-gutter quick-add-hidden{% if section.settings.mobile_thumbnails != 'show' %} small-hide{% endif %}"
    >
      <button
        type="button"
        class="slider-button slider-button--prev small-hide"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
        aria-controls="Slider-Thumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <ul
        id="Slider-Thumbnails-{{ section.id }}"
        class="thumbnail-list list-unstyled slider slider--mobile"
      >
        {%- assign thumb_position = 0 -%}

        {%- if selected_variant.featured_media != null -%}
          {%- assign thumb_position = thumb_position | plus: 1 -%}
          <li
            id="Slide-Thumbnails-{{ section.id }}-{{ thumb_position }}"
            class="thumbnail-list__item slider__slide"
            data-target="{{ section.id }}-{{ selected_variant.featured_media.id }}"
            data-media-position="{{ thumb_position }}"
          >
            {%- assign has_active_thumb = true -%}
            <button
              class="thumbnail global-media-settings global-media-settings--no-shadow"
              aria-label="{{ 'products.product.media.load_image' | t: index: thumb_position }}"
              aria-current="true"
              aria-controls="GalleryViewer-{{ section.id }}"
            >
              {{
                selected_variant.featured_media.preview_image
                | image_url: width: 416
                | image_tag: loading: 'lazy', widths: '54,74,104,162,208,324,416'
              }}
            </button>
          </li>
        {%- endif -%}

        {% for media in media_references %}
          {%- unless media == empty -%}
            {% assign media_object = product.media | where: 'id', media.id | first %}
            {%- if media_object != null and media_object.id != selected_variant.featured_media.id -%}
              {%- assign thumb_position = thumb_position | plus: 1 -%}
              <li
                id="Slide-Thumbnails-{{ section.id }}-{{ thumb_position }}"
                class="thumbnail-list__item slider__slide"
                data-target="{{ section.id }}-{{ media_object.id }}"
                data-media-position="{{ thumb_position }}"
              >
                <button
                  class="thumbnail global-media-settings global-media-settings--no-shadow"
                  aria-label="{{ 'products.product.media.load_image' | t: index: thumb_position }}"
                  {% unless has_active_thumb %}
                    aria-current="true"
                  {% endunless %}
                  aria-controls="GalleryViewer-{{ section.id }}"
                >
                  {%- assign has_active_thumb = true -%}
                  {{
                    media_object.preview_image
                    | image_url: width: 416
                    | image_tag: loading: 'lazy', widths: '54,74,104,162,208,324,416'
                  }}
                </button>
              </li>
            {%- endif -%}
          {%- endunless -%}
        {% endfor %}

        {%- if should_render_highlights_slide -%}
          {%- assign thumb_position = thumb_position | plus: 1 -%}
          <li
            id="Slide-Thumbnails-{{ section.id }}-{{ thumb_position }}"
            class="thumbnail-list__item slider__slide"
            data-target="{{ section.id }}-key-highlights"
            data-media-position="{{ thumb_position }}"
          >
            <button
              class="thumbnail global-media-settings global-media-settings--no-shadow"
              aria-label="{{ 'products.product.media.load_image' | t: index: thumb_position }}"
              aria-controls="GalleryViewer-{{ section.id }}"
            >
              {{
                highlight_image.preview_image
                | image_url: width: 416
                | image_tag: loading: 'lazy', widths: '54,74,104,162,208,324,416'
              }}
            </button>
          </li>
        {%- endif -%}
      </ul>
      <button
        type="button"
        class="slider-button slider-button--next small-hide"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
        aria-controls="Slider-Thumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </slider-component>
  {%- endif -%}
</media-gallery>

<script src="{{ 'thumbnail-gallery.js' | asset_url }}" defer="defer"></script>