{%- assign hm_prefix = routes.root_url -%}{%- if hm_prefix == '/' -%}{%- assign hm_prefix = '' -%}{%- endif -%}{%- assign hm_rest = request.path -%}{%- if hm_prefix != '' -%}{%- assign hm_rest = request.path | remove_first: hm_prefix -%}{%- endif -%}{%- if hm_rest == '/' -%}{%- assign hm_rest = '' -%}{%- endif -%}{%- assign hm_eu = hm_rest | default: '/' -%}{%- case request.locale.iso_code -%}{%- when 'da' -%}{%- assign hm_t = 'Sprog og valuta' -%}{%- when 'sv' -%}{%- assign hm_t = 'Språk och valuta' -%}{%- when 'de' -%}{%- assign hm_t = 'Sprache & Währung' -%}{%- when 'fr' -%}{%- assign hm_t = 'Langue & devise' -%}{%- else -%}{%- assign hm_t = 'Language & currency' -%}{%- endcase -%}{%- capture hm_dk -%}<svg class="hm-flag" viewBox="0 0 37 28" aria-hidden="true"><rect width="37" height="28" fill="#c8102e"/><rect x="12" width="4" height="28" fill="#fff"/><rect y="12" width="37" height="4" fill="#fff"/></svg>{%- endcapture -%}{%- capture hm_se -%}<svg class="hm-flag" viewBox="0 0 37 28" aria-hidden="true"><rect width="37" height="28" fill="#006aa7"/><rect x="12" width="4" height="28" fill="#fecc00"/><rect y="12" width="37" height="4" fill="#fecc00"/></svg>{%- endcapture -%}{%- capture hm_de -%}<svg class="hm-flag" viewBox="0 0 37 28" aria-hidden="true"><rect width="37" height="9.4" fill="#000"/><rect y="9.3" width="37" height="9.4" fill="#dd0000"/><rect y="18.6" width="37" height="9.4" fill="#ffce00"/></svg>{%- endcapture -%}{%- capture hm_fr -%}<svg class="hm-flag" viewBox="0 0 37 28" aria-hidden="true"><rect width="12.4" height="28" fill="#002654"/><rect x="12.3" width="12.4" height="28" fill="#fff"/><rect x="24.6" width="12.4" height="28" fill="#ce1126"/></svg>{%- endcapture -%}{%- capture hm_euf -%}<svg class="hm-flag" viewBox="0 0 37 28" aria-hidden="true"><rect width="37" height="28" fill="#003399"/><g fill="#ffcc00"><circle cx="18.5" cy="6.0" r="1.2"/><circle cx="22.5" cy="7.1" r="1.2"/><circle cx="25.4" cy="10.0" r="1.2"/><circle cx="26.5" cy="14.0" r="1.2"/><circle cx="25.4" cy="18.0" r="1.2"/><circle cx="22.5" cy="20.9" r="1.2"/><circle cx="18.5" cy="22.0" r="1.2"/><circle cx="14.5" cy="20.9" r="1.2"/><circle cx="11.6" cy="18.0" r="1.2"/><circle cx="10.5" cy="14.0" r="1.2"/><circle cx="11.6" cy="10.0" r="1.2"/><circle cx="14.5" cy="7.1" r="1.2"/></g></svg>{%- endcapture -%}{%- if hm_prefix contains '-dk' -%}{%- assign hm_cur = hm_dk -%}{%- elsif hm_prefix contains '-se' -%}{%- assign hm_cur = hm_se -%}{%- elsif hm_prefix contains '-de' -%}{%- assign hm_cur = hm_de -%}{%- elsif hm_prefix contains '-fr' -%}{%- assign hm_cur = hm_fr -%}{%- else -%}{%- assign hm_cur = hm_euf -%}{%- endif -%}{%- capture hm_list -%}<ul class="hm-list"><li><a href="/da-dk{{ hm_rest }}" lang="da"{% if hm_prefix contains '-dk' %} aria-current="true"{% endif %}>{{ hm_dk }}<span class="hm-tx"><span class="hm-c">Danmark</span><span class="hm-m">Dansk · DKK</span></span></a></li><li><a href="/sv-se{{ hm_rest }}" lang="sv"{% if hm_prefix contains '-se' %} aria-current="true"{% endif %}>{{ hm_se }}<span class="hm-tx"><span class="hm-c">Sverige</span><span class="hm-m">Svenska · SEK</span></span></a></li><li><a href="/de-de{{ hm_rest }}" lang="de"{% if hm_prefix contains '-de' %} aria-current="true"{% endif %}>{{ hm_de }}<span class="hm-tx"><span class="hm-c">Deutsch</span><span class="hm-m">EUR</span></span></a></li><li><a href="/fr-fr{{ hm_rest }}" lang="fr"{% if hm_prefix contains '-fr' %} aria-current="true"{% endif %}>{{ hm_fr }}<span class="hm-tx"><span class="hm-c">Français</span><span class="hm-m">EUR</span></span></a></li><li><a href="{{ hm_eu }}" lang="en"{% if hm_prefix == '' %} aria-current="true"{% endif %}>{{ hm_euf }}<span class="hm-tx"><span class="hm-c">Europe</span><span class="hm-m">English · EUR</span></span></a></li></ul>{%- endcapture -%}<style>.hm-dd{position:relative}.hm-btn{list-style:none;cursor:pointer;display:flex;align-items:center;gap:.8rem;font-size:1.3rem;letter-spacing:.08em;color:rgb(var(--color-foreground));padding:.8rem .4rem;white-space:nowrap}.hm-btn::-webkit-details-marker{display:none}.hm-flag{width:2.2rem;height:1.65rem;border-radius:.3rem;flex:none;box-shadow:0 0 0 1px rgba(255,255,255,.15)}.hm-panel{position:absolute;right:0;top:calc(100% + .8rem);width:26rem;background:#111;border:1px solid rgba(255,255,255,.12);border-radius:1.2rem;padding:.6rem;z-index:30;box-shadow:0 16px 40px rgba(0,0,0,.45)}.hm-list{list-style:none;margin:0;padding:0}.hm-list a{display:flex;align-items:center;gap:1.4rem;padding:1.1rem 1.4rem;border-radius:.8rem;color:#fff;text-decoration:none;font-size:1.5rem;line-height:1.3}.hm-list a .hm-flag{width:2.8rem;height:2.1rem}.hm-tx{display:flex;flex-direction:column;gap:.2rem}.hm-list a:hover{background:rgba(255,255,255,.08)}.hm-list a[aria-current]{background:rgba(245,166,35,.14)}.hm-list a[aria-current] .hm-c{color:#f5a623}.hm-m{opacity:.6;font-size:1.25rem;letter-spacing:.04em}.hm-title{font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;opacity:.55;margin:0 0 .4rem;padding:0 1.4rem}.hm-switch--mobile{padding:1.6rem 0 .8rem;border-top:1px solid rgba(255,255,255,.1);margin-top:.8rem}.hm-switch--mobile .hm-list a{padding:1.2rem 1.4rem}@media screen and (max-width:989px){.hm-switch--desktop{display:none}}</style>{%- if variant == 'desktop' -%}<div class="hm-switch hm-switch--desktop"><details class="hm-dd"><summary class="hm-btn" aria-label="{{ hm_t }}">{{ hm_cur }}<span>{{ request.locale.iso_code | upcase }} · {{ cart.currency.iso_code }}</span></summary><div class="hm-panel"><p class="hm-title">{{ hm_t }}</p>{{ hm_list }}</div></details></div><script>document.addEventListener('click',function(e){document.querySelectorAll('.hm-dd[open]').forEach(function(d){if(!d.contains(e.target))d.removeAttribute('open')})});</script>{%- else -%}<div class="hm-switch hm-switch--mobile"><p class="hm-title">{{ hm_t }}</p>{{ hm_list }}</div>{%- endif -%}