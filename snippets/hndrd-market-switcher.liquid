{%- assign hm_prefix = routes.root_url -%}{%- if hm_prefix == '/' -%}{%- assign hm_prefix = '' -%}{%- endif -%}{%- assign hm_rest = request.path -%}{%- if hm_prefix != '' -%}{%- assign hm_rest = request.path | remove_first: hm_prefix -%}{%- endif -%}{%- if hm_rest == '/' -%}{%- assign hm_rest = '' -%}{%- endif -%}{%- assign hm_eu = hm_rest | default: '/' -%}{%- case request.locale.iso_code -%}{%- when 'da' -%}{%- assign hm_t = 'Land og sprog' -%}{%- when 'sv' -%}{%- assign hm_t = 'Land och språk' -%}{%- when 'de' -%}{%- assign hm_t = 'Land & Sprache' -%}{%- when 'fr' -%}{%- assign hm_t = 'Pays & langue' -%}{%- else -%}{%- assign hm_t = 'Country & language' -%}{%- endcase -%}{%- capture hm_list -%}<ul class="hm-list"><li><a href="/da-dk{{ hm_rest }}" lang="da"{% if hm_prefix contains '-dk' %} aria-current="true"{% endif %}><span class="hm-c">Danmark</span><span class="hm-m">Dansk · DKK</span></a></li><li><a href="/sv-se{{ hm_rest }}" lang="sv"{% if hm_prefix contains '-se' %} aria-current="true"{% endif %}><span class="hm-c">Sverige</span><span class="hm-m">Svenska · SEK</span></a></li><li><a href="/de-de{{ hm_rest }}" lang="de"{% if hm_prefix contains '-de' %} aria-current="true"{% endif %}><span class="hm-c">Deutschland · Österreich</span><span class="hm-m">Deutsch · EUR</span></a></li><li><a href="/fr-fr{{ hm_rest }}" lang="fr"{% if hm_prefix contains '-fr' %} aria-current="true"{% endif %}><span class="hm-c">France · Belgique · Luxembourg</span><span class="hm-m">Français · EUR</span></a></li><li><a href="{{ hm_eu }}" lang="en"{% if hm_prefix == '' %} aria-current="true"{% endif %}><span class="hm-c">Europe</span><span class="hm-m">English · EUR</span></a></li></ul>{%- endcapture -%}<style>.hm-dd{position:relative}.hm-btn{list-style:none;cursor:pointer;display:flex;align-items:center;gap:.6rem;font-size:1.3rem;letter-spacing:.08em;color:rgb(var(--color-foreground));padding:.8rem .4rem;white-space:nowrap}.hm-btn::-webkit-details-marker{display:none}.hm-btn svg{width:1.8rem;height:1.8rem;flex:none}.hm-panel{position:absolute;right:0;top:calc(100% + .8rem);width:32rem;background:#111;border:1px solid rgba(255,255,255,.12);border-radius:1.2rem;padding:.6rem;z-index:30;box-shadow:0 16px 40px rgba(0,0,0,.45)}.hm-list{list-style:none;margin:0;padding:0}.hm-list a{display:flex;flex-direction:column;gap:.2rem;padding:1.1rem 1.4rem;border-radius:.8rem;color:#fff;text-decoration:none;font-size:1.5rem;line-height:1.3}.hm-list a:hover{background:rgba(255,255,255,.08)}.hm-list a[aria-current]{background:rgba(245,166,35,.14)}.hm-list a[aria-current] .hm-c{color:#f5a623}.hm-m{opacity:.6;font-size:1.25rem;letter-spacing:.04em}.hm-title{font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;opacity:.55;margin:0 0 .4rem;padding:0 1.4rem}.hm-switch--mobile{padding:1.6rem 0 .8rem;border-top:1px solid rgba(255,255,255,.1);margin-top:.8rem}.hm-switch--mobile .hm-list a{padding:1.2rem 1.4rem}@media screen and (max-width:989px){.hm-switch--desktop{display:none}}</style>{%- if variant == 'desktop' -%}<div class="hm-switch hm-switch--desktop"><details class="hm-dd"><summary class="hm-btn" aria-label="{{ hm_t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg><span>{{ request.locale.iso_code | upcase }} · {{ cart.currency.iso_code }}</span></summary><div class="hm-panel"><p class="hm-title">{{ hm_t }}</p>{{ hm_list }}</div></details></div><script>document.addEventListener('click',function(e){document.querySelectorAll('.hm-dd[open]').forEach(function(d){if(!d.contains(e.target))d.removeAttribute('open')})});</script>{%- else -%}<div class="hm-switch hm-switch--mobile"><p class="hm-title">{{ hm_t }}</p>{{ hm_list }}</div>{%- endif -%}