{{ 'services.css' | asset_url | stylesheet_tag }}
{% assign gripping_trigger_id = 'gripping-trigger-' | append: section.id %}

<section class="gripping-container service-container">
  {% comment %} <hr style="margin: 1.9rem 0;"> {% endcomment %}
  <div
    id="{{ gripping_trigger_id }}"
    class="service-card s3_paragraph"
    role="button"
    tabindex="0"
  >
    <div class="service-card__content">
      <div class="service-card__title-row">
        <span>{{ 'studio.gripping.form_labels.grip_service' | t }}</span>
        <span class="service-card__price">
          {%- if all_products['studio-gripping-service'].price == 0 -%}
            {{ 'studio.gripping.labels.free' | t }}
          {%- else -%}
            +{{ all_products['studio-gripping-service'].price | money }}
          {%- endif -%}
        </span>
      </div>
      <p class="service-card__description" id="gripping-description">
        {{ 'studio.gripping.description.grip_service' | t }}
      </p>
      <p class="service-card__selection" id="gripping-current-selection">
        <span>{{ 'studio.gripping.labels.current_selection' | t }}</span>
        <span aria-hidden="true">—</span>
        <span>{{ 'studio.gripping.form_labels.no_grip' | t }}</span>
      </p>
    </div>
    <div class="service-card__cta">
      <span class="service-card__cta-text" id="gripping-cta-label">{{ 'studio.gripping.actions.add' | t }}</span>
      <span class="service-card__cta-icon">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </div>
  </div>
</section>

<section
  id="gripping-root"
  style="display: none;"
  data-gripping-collection-id="{{ settings.gripping_collection_id | default: '' }}"
  data-gripping-cost="{{ all_products['studio-gripping-service'].price | money }}"
  data-label-choose-grip="{{ 'studio.gripping.headings.choose_grip' | t }}"
  data-label-select-color="{{ 'studio.gripping.headings.select_color' | t }}"
  data-label-summary="{{ 'studio.gripping.headings.summary' | t }}"
  data-label-service-cost="{{ 'studio.gripping.labels.service_cost' | t }}"
  data-label-variant-price="{{ 'studio.gripping.labels.variant_price' | t }}"
  data-label-no-grip="{{ 'studio.gripping.form_labels.no_grip' | t }}"
  data-label-free="{{ 'studio.gripping.labels.free' | t }}"
  data-description-no-grip="{{ 'studio.gripping.description.no_grip' | t }}"
  data-description-application-note="{{ 'studio.gripping.description.grip_application_note' | t }}"
  data-factory-grip-image="{% if settings.factory_grip_image != blank %}{{ settings.factory_grip_image | image_url: width: 140 }}{% endif %}"
  data-message-empty="{{ 'studio.gripping.messages.empty' | t }}"
  data-message-loading="{{ 'studio.gripping.messages.loading' | t }}"
  data-message-error="{{ 'studio.gripping.errors.load_failed' | t }}"
  data-error-missing-product="{{ 'studio.gripping.errors.missing_product' | t }}"
  data-error-missing-variant="{{ 'studio.gripping.errors.missing_variant' | t }}"
  data-action-add="{{ 'studio.gripping.actions.add' | t }}"
  data-action-selected="{{ 'studio.gripping.actions.selected' | t }}"
  data-action-change="{{ 'studio.gripping.actions.change' | t }}"
  data-action-next="{{ 'studio.gripping.actions.next' | t }}"
  data-action-back="{{ 'studio.gripping.actions.back' | t }}"
  data-action-submit="{{ 'studio.gripping.actions.submit' | t }}"
  data-action-close="{{ 'studio.gripping.actions.close' | t }}"
  data-action-remove="{{ 'studio.gripping.actions.remove' | t }}"
  data-close-confirm-message="{{ 'studio.modal_close_guard.message' | t }}"
  data-close-confirm-keep-editing="{{ 'studio.modal_close_guard.keep_editing' | t }}"
  data-close-confirm-discard="{{ 'studio.modal_close_guard.discard' | t }}"
></section>

<script defer="defer" src="{{ 'service-modal-trigger.js' | asset_url }}"></script>
<script defer="defer">
  document.addEventListener('DOMContentLoaded', () => {
    const grippingTrigger = document.getElementById('{{ gripping_trigger_id }}');
    const root = document.getElementById('gripping-root');
    const cardDescription = document.getElementById('gripping-description');

    window.s3_gripping_service_variant_id = '{{ all_products['studio-gripping-service'].variants.first.id }}';

    if (!grippingTrigger || !root || !window.s3_initServiceModalTrigger) return;

    window.s3_initServiceModalTrigger({
      serviceKey: 'gripping',
      triggerEl: grippingTrigger,
      scriptSrc: "{{ 'vx-gripping.js' | asset_url }}",
      controllerPath: 's3_gripping_modal_controller',
      errorTarget: cardDescription,
      errorMessage: root.dataset.messageError || '',
      idlePreload: true,
      enableKeyboard: true,
    });
  });
</script>
