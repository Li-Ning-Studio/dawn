<style>.search-modal .modal-overlay{background:rgba(0,0,0,.6)}.search-modal__panel{background:#111;color:#fff}.search-modal__content{padding:0}.search-modal__header-row{padding:1.4rem 1.6rem;gap:1rem;border-bottom:1px solid rgba(255,255,255,.08);width:auto;box-sizing:border-box}.search-modal .search__input.field__input{font-size:1.8rem}.search-modal .predictive-search{position:static;border:0;box-shadow:none;background:transparent;max-height:none;width:100%;transform:none}.hs-grid{display:flex;flex-direction:column}.hs-main{order:-1;padding:.8rem}.hs-side{padding:1.2rem 1.6rem 1.6rem;display:flex;flex-direction:column;gap:1.6rem;border-top:1px solid rgba(255,255,255,.08)}.hs-h{font-size:1.1rem;letter-spacing:.14em;text-transform:uppercase;color:#a0a0a0;margin:0 0 .8rem;font-weight:500;font-family:inherit}.hs-main .hs-h{padding:.8rem .8rem 0}.hs-links{display:flex;flex-wrap:wrap;gap:.8rem;margin:0;padding:0}.hs-links li{margin:0}.hs-link{display:block;padding:.9rem 1.4rem;border-radius:2rem;background:#1e1e1e;color:#fff;font-size:1.4rem;text-decoration:none;line-height:1.2}.hs-link mark{background:none;color:#f5a623;font-weight:600}.hs-products{margin:0;padding:0}.hs-products li{margin:0}.hs-prod{display:flex;align-items:center;gap:1.4rem;padding:1rem .8rem;border-radius:1rem;color:#fff;text-decoration:none}.hs-prod:hover,[aria-selected="true"]>.hs-prod,[aria-selected="true"]>.hs-link{background:rgba(245,166,35,.14)}.hs-thumb{width:8rem;height:8rem;border-radius:.8rem;background:#f1f1f1;flex:none;overflow:hidden;display:flex;align-items:center;justify-content:center}.hs-thumb img{width:100%;height:100%;object-fit:contain}.hs-info{flex:1;display:flex;flex-direction:column;gap:.3rem;min-width:0}.hs-type{font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#a0a0a0}.hs-title{font-size:1.5rem;font-weight:500;line-height:1.3}.hs-price{font-size:1.5rem;font-weight:600;white-space:nowrap;color:#f5a623}.predictive-search__search-for-button .hs-all{display:flex