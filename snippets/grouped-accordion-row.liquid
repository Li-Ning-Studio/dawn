{%- comment -%}
  One FAQ row (accordion) for sections/grouped-accordions.liquid. Shared by its two block types
  (Liquid "Row" and metaobject "Product FAQs"), so both render identical markup.

  Accepts:
  - row_id: {String} Unique within the section (block id or "faq-<metaobject handle>")
  - section_id: {String} section.id
  - question: {String} Heading HTML (already escaped or merchant Liquid output)
  - answer: {String} Answer HTML
  - open: {Boolean} Open by default
  - attributes: {String} Theme editor attributes (block.shopify_attributes); empty for rows that
    shouldn't claim the block, so one editor block maps to one element.
{%- endcomment -%}
<div class="grouped-accordions__item accordion" {{ attributes }}>
  <details
    id="Details-{{ row_id }}-{{ section_id }}"
    {% if open %}
      open
    {% endif %}
  >
    <summary id="Summary-{{ row_id }}-{{ section_id }}">
      <div class="summary__title">
        <h3 class="accordion__title inline-richtext s3_subtitle">
          {{ question }}
        </h3>
      </div>
      <span class="accordion__toggle-icons" aria-hidden="true">
        <span class="accordion__toggle-icon accordion__toggle-icon--plus">
          {{- 'icon-accordion-plus.svg' | inline_asset_content -}}
        </span>
        <span class="accordion__toggle-icon accordion__toggle-icon--minus">
          {{- 'icon-accordion-minus.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="accordion__content s3_paragraph rte"
      id="GroupedAccordion-{{ row_id }}-{{ section_id }}"
      role="region"
      aria-labelledby="Summary-{{ row_id }}-{{ section_id }}"
    >
      {{ answer }}
    </div>
  </details>
</div>
